@model Omnichannel.Application.DTOs.Security.PermissionMatrixViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ma Trận Phân Quyền Hạt Nhân Động (PBAC Security Matrix)";

    var targetRoles = Model.Roles
        .Where(r => r.Name != "Customer")
        .OrderBy(r => r.Id)
        .ToList();

    var rolePermMap = ViewBag.RolePermissionMap as Dictionary<int, HashSet<int>> ?? new Dictionary<int, HashSet<int>>();
    bool HasPerm(int roleId, int permId, string roleName)
    {
        if (roleName.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase)) return true;
        return rolePermMap.ContainsKey(roleId) && rolePermMap[roleId].Contains(permId);
    }
}

<style>
    .perm-table-row:hover {
        background-color: rgba(248, 250, 252, 0.8);
    }
    .dark .perm-table-row:hover {
        background-color: rgba(30, 41, 59, 0.5);
    }
    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 20;
    }
</style>

<div class="mb-8" style="zoom: 0.82;">
    <!-- =========================================================================
         1. TIÊU ĐỀ & THANH ĐIỀU HÀNH BẢO MẬT PBAC
         ========================================================================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-3 mb-1.5 flex-wrap">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-rose-500"></i>
                    <span>Ma Trận Phân Quyền Hạt Nhân Động (PBAC Security Matrix)</span>
                </h1>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 shadow-sm">
                    <i class="fa-solid fa-key"></i> 51 Quyền Hạt Nhân
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-sm">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> L1 Cache-Aside TTL 30 Phút
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-sm">
                Cơ chế phân giải quyền động ba tầng: Cookie Claims &rarr; L1 Cache &rarr; Database SQL Server kết hợp luật cấm/tước quyền ưu tiên tuyệt đối (Deny Overrides).
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button" onclick="alert('Đã đồng bộ và làm sạch Cache phân quyền (IMemoryCache TTL 30m) toàn cụm Web Nodes!');" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 shadow-sm transition active:scale-95">
                <i class="fa-solid fa-rotate text-rose-500"></i> Xóa Cache L1
            </button>
            <button type="button" onclick="alert('Đã cập nhật cấu hình Ma trận Phân quyền PBAC thành công!');" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-500 hover:from-rose-700 hover:to-pink-600 shadow-md shadow-rose-500/25 transition active:scale-95">
                <i class="fa-solid fa-floppy-disk"></i> Lưu Thay Đổi Ma Trận
            </button>
        </div>
    </div>

    <!-- =========================================================================
         2. CÁC THẺ TỔNG QUAN VỀ KIẾN TRÚC PHÂN QUYỀN PBAC
         ========================================================================= -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 my-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">5 Vai Trò Quản Trị</div>
                <div class="text-sm font-extrabold text-slate-900 dark:text-white">RBAC + PBAC Hybrid</div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">51 Quyền Hạt Nhân</div>
                <div class="text-sm font-extrabold text-slate-900 dark:text-white">9 Phân Hệ Nghiệp Vụ</div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Hiệu Năng Phân Giải</div>
                <div class="text-sm font-extrabold text-slate-900 dark:text-white">&lt; 1ms (MemoryCache HIT)</div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-ban"></i>
            </div>
            <div>
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Luật Bảo Mật Tối Cao</div>
                <div class="text-sm font-extrabold text-slate-900 dark:text-white">Deny Luôn Thắng Grant</div>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         3. LƯỚI MA TRẬN PHÂN QUYỀN PBAC 2D (5 CỘT VAI TRÒ x 51 QUYỀN HẠT NHÂN)
         ========================================================================= -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <i class="fa-solid fa-table-cells text-rose-500"></i>
                    <span>Ma Trận Cấp Phép Quyền Theo Vai Trò (Role - Permission Matrix)</span>
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">Lưới phân quyền trực quan cho phép bật/tắt quyền tức thì, tự động kích hoạt Cache Invalidation.</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Đã cấp quyền (Checked)
                </span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-400">
                    <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600"></span> Không có quyền (Unchecked)
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead class="sticky-header bg-slate-100/90 dark:bg-slate-800/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-extrabold uppercase tracking-wider text-[11px]">
                    <tr>
                        <th class="py-3.5 px-5 w-80">Phân Hệ & Quyền Hạt Nhân</th>
                        <th class="py-3.5 px-3 w-44 font-mono">Mã Quyền (Code)</th>
                        
                        <!-- 5 Cột Vai Trò Yêu Cầu Trong Luận Văn -->
                        <th class="py-3.5 px-3 text-center w-36 bg-purple-50/60 dark:bg-purple-950/30 border-l border-r border-purple-200/50 dark:border-purple-800/40">
                            <div class="flex flex-col items-center">
                                <span class="text-purple-700 dark:text-purple-300 font-extrabold">SuperAdmin</span>
                                <span class="text-[9px] font-normal text-purple-600/70 lowercase">toàn quyền</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-3 text-center w-36 bg-blue-50/60 dark:bg-blue-950/30 border-r border-blue-200/50 dark:border-blue-800/40">
                            <div class="flex flex-col items-center">
                                <span class="text-blue-700 dark:text-blue-300 font-extrabold">StoreManager</span>
                                <span class="text-[9px] font-normal text-blue-600/70 lowercase">quản lý shop</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-3 text-center w-36 bg-pink-50/60 dark:bg-pink-950/30 border-r border-pink-200/50 dark:border-pink-800/40">
                            <div class="flex flex-col items-center">
                                <span class="text-pink-700 dark:text-pink-300 font-extrabold">Cashier</span>
                                <span class="text-[9px] font-normal text-pink-600/70 lowercase">thu ngân pos</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-3 text-center w-36 bg-amber-50/60 dark:bg-amber-950/30 border-r border-amber-200/50 dark:border-amber-800/40">
                            <div class="flex flex-col items-center">
                                <span class="text-amber-700 dark:text-amber-300 font-extrabold">WarehouseStaff</span>
                                <span class="text-[9px] font-normal text-amber-600/70 lowercase">thủ kho fefo</span>
                            </div>
                        </th>
                        <th class="py-3.5 px-3 text-center w-36 bg-emerald-50/60 dark:bg-emerald-950/30 border-r border-emerald-200/50 dark:border-emerald-800/40">
                            <div class="flex flex-col items-center">
                                <span class="text-emerald-700 dark:text-emerald-300 font-extrabold">ContentEditor</span>
                                <span class="text-[9px] font-normal text-emerald-600/70 lowercase">biên tập viên</span>
                            </div>
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    @foreach (var group in Model.ModuleGroups)
                    {
                        <!-- Dòng Header Phân Hệ Chức Năng -->
                        <tr class="bg-slate-50 dark:bg-slate-800/80 font-bold text-slate-800 dark:text-slate-200">
                            <td colspan="7" class="py-2.5 px-5">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                                    <span class="uppercase tracking-wider text-[11px] font-extrabold text-slate-900 dark:text-white">@group.ModuleName</span>
                                    <span class="font-mono text-[10px] text-slate-400 font-normal">(@group.Permissions.Count quyền hạt nhân)</span>
                                </div>
                            </td>
                        </tr>

                        @foreach (var perm in group.Permissions)
                        {
                            <tr class="perm-table-row transition-colors">
                                <td class="py-2.5 px-5">
                                    <div class="font-semibold text-slate-800 dark:text-slate-200">@perm.Name</div>
                                    @if (!string.IsNullOrEmpty(perm.Description))
                                    {
                                        <div class="text-[10px] text-slate-400 leading-tight">@perm.Description</div>
                                    }
                                </td>
                                <td class="py-2.5 px-3 font-mono text-[11px] text-slate-500 dark:text-slate-400">
                                    <span class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">@perm.Code</span>
                                </td>

                                <!-- Checkbox 5 Vai Trò -->
                                @foreach (var role in targetRoles)
                                {
                                    var isChecked = HasPerm(role.Id, perm.Id, role.Name);
                                    var isSuper = role.Name == "SuperAdmin";
                                    <td class="py-2.5 px-3 text-center border-l border-r border-slate-100 dark:border-slate-800/40">
                                        <input type="checkbox" 
                                               class="w-4 h-4 rounded text-rose-600 focus:ring-rose-500 dark:focus:ring-rose-600 dark:ring-offset-slate-800 focus:ring-1 cursor-pointer transition @(isSuper ? "opacity-90 cursor-not-allowed" : "")"
                                               @(isChecked ? "checked" : "")
                                               @(isSuper ? "disabled" : "")
                                               title="@role.Name: @perm.Name (@(isChecked ? "Cho phép" : "Chặn"))" />
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
            <div>
                Tổng cộng: <strong class="text-slate-800 dark:text-white font-mono">51 Quyền Hạt Nhân</strong> trên <strong class="text-slate-800 dark:text-white font-mono">5 Vai Trò Quản Trị</strong>
            </div>
            <div class="font-mono text-[11px]">
                <i class="fa-solid fa-lock text-rose-500 me-1"></i> Security Level: PBAC Dynamic Policy Resolution
            </div>
        </div>
    </div>
</div>
