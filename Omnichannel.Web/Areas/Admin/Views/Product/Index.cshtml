@model IEnumerable<Omnichannel.Application.DTOs.Inventory.ProductItemViewModel>
@{
    ViewData["Title"] = "Danh mục Sản phẩm SKU";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Danh mục Mỹ phẩm & SKU</h4>
        <p class="text-muted small mb-0">Quản lý mã vạch EAN-13, giá bán lẻ niêm yết và thông số định mức an toàn</p>
    </div>
    <a href="/Admin/Product/Create" class="btn btn-primary-gradient px-3">
        <i class="fa-solid fa-plus me-1"></i>Thêm Mới Sản Phẩm
    </a>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="beauty-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="keyword" class="form-control bg-light border-0 small" placeholder="Tìm theo tên sản phẩm, mã SKU hoặc Barcode..." value="@ViewBag.Keyword" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" asp-items="ViewBag.Categories" class="form-select rounded-3">
                <option value="">-- Tất cả danh mục ngành hàng --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-soft-purple px-3 w-100">
                <i class="fa-solid fa-filter me-1"></i>Lọc Dữ Liệu
            </button>
            <a href="/Admin/Product" class="btn btn-light rounded-3 px-3">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </div>
    </form>
</div>

<!-- Bảng danh sách sản phẩm -->
<div class="beauty-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="py-3 px-4">Mã SKU / Barcode</th>
                    <th class="py-3">Tên sản phẩm</th>
                    <th class="py-3">Ngành hàng</th>
                    <th class="py-3">Nhà cung cấp</th>
                    <th class="py-3 text-end">Giá vốn</th>
                    <th class="py-3 text-end">Giá bán niêm yết</th>
                    <th class="py-3 text-center">Tồn an toàn</th>
                    <th class="py-3">Trạng thái</th>
                    <th class="py-3 px-4 text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="px-4">
                            <div class="fw-bold text-dark">@p.ProductId</div>
                            <div class="text-muted font-monospace" style="font-size: 11px;"><i class="fa-solid fa-barcode me-1"></i>@p.Barcode</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@p.ProductName</div>
                            <div class="text-muted" style="font-size: 11px;">ĐVT: @p.Unit</div>
                        </td>
                        <td>
                            <span class="badge" style="background: var(--primary-purple-light); color: var(--primary-purple);">@p.CategoryName</span>
                        </td>
                        <td class="small text-secondary">@p.SupplierName</td>
                        <td class="text-end small font-monospace">@p.CostPrice.ToString("N0") đ</td>
                        <td class="text-end fw-bold font-monospace" style="color: var(--accent-pink);">@p.SellingPrice.ToString("N0") đ</td>
                        <td class="text-center small fw-semibold">@p.SafetyStock</td>
                        <td>
                            @if (p.Status == 1)
                            {
                                <span class="badge-active">Đang mở bán</span>
                            }
                            else
                            {
                                <span class="badge-locked">Tạm ngưng</span>
                            }
                        </td>
                        <td class="px-4 text-end">
                            <form asp-action="ToggleStatus" asp-route-id="@p.ProductId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3" title="@(p.Status == 1 ? "Tạm ngưng bán" : "Mở bán lại")">
                                    <i class="fa-solid @(p.Status == 1 ? "fa-ban" : "fa-check")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
