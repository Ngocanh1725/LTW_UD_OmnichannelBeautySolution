@model Omnichannel.Application.DTOs.Inventory.CreateProductViewModel
@{
    ViewData["Title"] = "Thêm Mới Mỹ Phẩm SKU";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">Thêm Mới Sản Phẩm SKU</h4>
                <p class="text-muted small mb-0">Thiết lập mã sản phẩm, mã vạch quét POS và bảng giá niêm yết</p>
            </div>
            <a href="/Admin/Product" class="btn btn-outline-secondary btn-sm rounded-3">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
            </a>
        </div>

        <div class="beauty-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ProductId" class="form-label small fw-semibold"></label>
                        <input asp-for="ProductId" class="form-control rounded-3 font-monospace text-uppercase" placeholder="vd: SKU-SERUM-B5-30ML" autofocus />
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Barcode" class="form-label small fw-semibold"></label>
                        <input asp-for="Barcode" class="form-control rounded-3 font-monospace" placeholder="vd: 8935001234567" />
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="ProductName" class="form-label small fw-semibold"></label>
                        <input asp-for="ProductName" id="prodName" class="form-control rounded-3" placeholder="vd: Serum Phục Hồi Hàng Rào Da Hyaluronic Acid B5" onkeyup="generateSlug(this.value)" />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label small fw-semibold"></label>
                        <input asp-for="Unit" class="form-control rounded-3" placeholder="Hộp, Chai, Tuýp..." />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Slug" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted small">/san-pham/</span>
                            <input asp-for="Slug" id="prodSlug" class="form-control" placeholder="serum-phuc-hoi-hang-rao-da-b5" />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label small fw-semibold"></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select rounded-3">
                            <option value="">-- Chọn danh mục ngành hàng --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SupplierId" class="form-label small fw-semibold"></label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select rounded-3">
                            <option value="">-- Chọn nhà cung cấp phân phối --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CostPrice" class="form-label small fw-semibold"></label>
                        <input asp-for="CostPrice" type="number" step="1000" class="form-control rounded-3 font-monospace" placeholder="150000" />
                        <span asp-validation-for="CostPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SellingPrice" class="form-label small fw-semibold"></label>
                        <input asp-for="SellingPrice" type="number" step="1000" class="form-control rounded-3 font-monospace" placeholder="320000" />
                        <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SafetyStock" class="form-label small fw-semibold"></label>
                        <input asp-for="SafetyStock" type="number" class="form-control rounded-3" placeholder="10" />
                        <span asp-validation-for="SafetyStock" class="text-danger small"></span>
                    </div>

                    <div class="col-12 text-end mt-4">
                        <a href="/Admin/Product" class="btn btn-light rounded-3 px-4 me-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary-gradient px-4">
                            <i class="fa-solid fa-check me-1"></i>Lưu Sản Phẩm
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function generateSlug(text) {
            if (!text) {
                document.getElementById('prodSlug').value = '';
                return;
            }

            let slug = text.toLowerCase().trim();
            slug = slug.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            slug = slug.replace(/[đĐ]/g, 'd');
            slug = slug.replace(/[^a-z0-9\s-]/g, '');
            slug = slug.replace(/\s+/g, '-');
            slug = slug.replace(/-+/g, '-');
            slug = slug.replace(/^-+|-+$/g, '');

            document.getElementById('prodSlug').value = slug;
        }
    </script>
}