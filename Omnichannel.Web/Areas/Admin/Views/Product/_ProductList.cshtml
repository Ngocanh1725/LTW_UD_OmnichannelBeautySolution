@model Omnichannel.Application.DTOs.Inventory.ProductListPagedViewModel
@using System.Text.Encodings.Web

@if (!Model.Items.Any())
{
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-12 text-center my-4">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-50 dark:bg-rose-950/40 text-rose-500 dark:text-rose-400 mb-4 ring-8 ring-rose-50/50 dark:ring-rose-950/20">
            <i class="fa-solid fa-wand-magic-sparkles text-3xl"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">Không tìm thấy sản phẩm nào</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mt-1 mb-6">
            Không có sản phẩm mỹ phẩm nào phù hợp với từ khóa hoặc tiêu chí bộ lọc hiện tại. Hãy thử thay đổi từ khóa hoặc đặt lại bộ lọc.
        </p>
        <div class="flex items-center justify-center gap-3">
            <button type="button" 
                    onclick="resetProductFilters()" 
                    class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-xl text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                <i class="fa-solid fa-rotate-left mr-2"></i>Đặt lại bộ lọc
            </button>
            <a href="/Admin/Product/Create" 
               class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-xl text-white bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 shadow-md shadow-rose-500/20 transition">
                <i class="fa-solid fa-plus mr-2"></i>Thêm sản phẩm mới
            </a>
        </div>
    </div>
}
else
{
    <!-- Desktop Responsive Table View (Hidden on mobile) -->
    <div class="hidden md:block overflow-hidden bg-white dark:bg-slate-900 shadow-sm border border-slate-200/80 dark:border-slate-800 rounded-2xl">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300">
                <tr>
                    <th scope="col" class="py-3.5 pl-6 pr-3 text-left text-xs font-bold uppercase tracking-wider">
                        Sản phẩm / Mã vạch
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-bold uppercase tracking-wider">
                        Danh mục & Thương hiệu
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-right text-xs font-bold uppercase tracking-wider">
                        Giá bán niêm yết
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-center text-xs font-bold uppercase tracking-wider">
                        Tổng tồn kho
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-center text-xs font-bold uppercase tracking-wider">
                        Trạng thái
                    </th>
                    <th scope="col" class="py-3.5 pl-3 pr-6 text-right text-xs font-bold uppercase tracking-wider">
                        Hành động
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                @foreach (var p in Model.Items)
                {
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <!-- Product thumbnail + Name + SKU -->
                        <td class="py-4 pl-6 pr-3">
                            <div class="flex items-center gap-3.5">
                                <div class="relative flex-shrink-0 w-12 h-12 rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
                                    <img src="@ProductImageResolver.GetThumbnailImageUrl(p.ThumbnailUrl, p.Sku, p.Slug, p.ProductName)" 
                                         alt="@ProductImageResolver.GetAltText(p.ProductName, null, p.CategoryName, p.Sku, p.Slug)" 
                                         width="48"
                                         height="48"
                                         loading="lazy"
                                         decoding="async"
                                         class="w-full h-full object-cover"
                                         onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';" />
                                    @if (p.HasVariants)
                                    {
                                        <span class="absolute bottom-0 right-0 px-1 py-0.5 bg-rose-500 text-[9px] font-bold text-white rounded-tl-md">
                                            @p.VariantCount VM
                                        </span>
                                    }
                                </div>
                                <div class="min-w-0 flex-1">
                                    <a href="/Admin/Product/Details/@p.Id" class="text-sm font-semibold text-slate-800 dark:text-slate-100 hover:text-rose-600 dark:hover:text-rose-400 line-clamp-1 transition">
                                        @p.ProductName
                                    </a>
                                    <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500 dark:text-slate-400 font-mono">
                                        <span class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-slate-700 dark:text-slate-300 font-medium">@p.Sku</span>
                                        <span class="flex items-center text-slate-400">
                                            <i class="fa-solid fa-barcode mr-1"></i>@p.Barcode
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- Category & Supplier -->
                        <td class="px-3 py-4 text-sm">
                            <div class="font-medium text-slate-800 dark:text-slate-200">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200/60 dark:border-rose-900/40">
                                    <i class="fa-solid fa-tag text-[10px] mr-1 text-rose-500"></i>
                                    @p.CategoryName
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(p.SupplierName))
                            {
                                <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-building text-[10px] text-slate-400"></i>
                                    @p.SupplierName
                                </div>
                            }
                        </td>

                        <!-- Selling Price / Discount Price -->
                        <td class="px-3 py-4 text-sm text-right font-mono">
                            <div class="font-bold text-slate-900 dark:text-slate-100">
                                @p.SellingPrice.ToString("N0") <span class="text-xs font-normal text-slate-500">đ</span>
                            </div>
                            @if (p.DiscountPrice.HasValue && p.DiscountPrice.Value > 0 && p.DiscountPrice.Value < p.SellingPrice)
                            {
                                <div class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">
                                    KM: @p.DiscountPrice.Value.ToString("N0") đ
                                </div>
                            }
                            <div class="text-[11px] text-slate-400 dark:text-slate-500">
                                Vốn: @p.CostPrice.ToString("N0") đ
                            </div>
                        </td>

                        <!-- Total Stock (Aggregated FEFO) -->
                        <td class="px-3 py-4 text-sm text-center">
                            @if (p.TotalStock > 10)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                    Còn @p.TotalStock @p.Unit
                                </span>
                            }
                            else if (p.TotalStock > 0)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                    Sắp hết (@p.TotalStock @p.Unit)
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>
                                    Hết hàng
                                </span>
                            }
                        </td>

                        <!-- Status badge + Quick toggle -->
                        <td class="px-3 py-4 text-sm text-center">
                            <button type="button"
                                    hx-post="/Admin/Product/ToggleStatus/@p.Id"
                                    hx-headers='{"RequestVerificationToken": document.querySelector("input[name=__RequestVerificationToken]") ? document.querySelector("input[name=__RequestVerificationToken]").value : ""}'
                                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold transition cursor-pointer @(p.Status == 1 ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 border border-emerald-200 dark:border-emerald-800" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700")"
                                    title="Nhấn để @(p.Status == 1 ? "tạm ngừng kinh doanh" : "mở bán lại")">
                                <i class="fa-solid @(p.Status == 1 ? "fa-circle-check text-emerald-500" : "fa-ban text-slate-400") mr-1.5 text-xs"></i>
                                @(p.Status == 1 ? "Đang bán" : "Tạm ngưng")
                            </button>
                        </td>

                        <!-- Actions -->
                        <td class="py-4 pl-3 pr-6 text-right text-sm">
                            <div class="inline-flex items-center gap-1.5">
                                <a href="/Admin/Product/Details/@p.Id" 
                                   class="p-2 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:text-slate-400 dark:hover:text-rose-400 dark:hover:bg-rose-950/50 transition" 
                                   title="Xem chi tiết & quản lý lô FEFO">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </a>
                                <a href="/Admin/Product/Edit/@p.Id" 
                                   class="p-2 rounded-lg text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 dark:text-slate-400 dark:hover:text-indigo-400 dark:hover:bg-indigo-950/50 transition" 
                                   title="Chỉnh sửa sản phẩm">
                                    <i class="fa-solid fa-pen-to-square text-sm"></i>
                                </a>
                                <button type="button" 
                                        onclick="confirmDeleteProduct(@p.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(p.ProductName))')"
                                        class="p-2 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:text-slate-400 dark:hover:text-rose-400 dark:hover:bg-rose-950/50 transition" 
                                        title="Xóa mềm sản phẩm">
                                    <i class="fa-solid fa-trash-can text-sm"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View (Visible on mobile only) -->
    <div class="block md:hidden space-y-3">
        @foreach (var p in Model.Items)
        {
            <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 shadow-sm border border-slate-200/80 dark:border-slate-800">
                <div class="flex items-start gap-3">
                    <img src="@ProductImageResolver.GetThumbnailImageUrl(p.ThumbnailUrl, p.Sku, p.Slug, p.ProductName)" 
                         alt="@ProductImageResolver.GetAltText(p.ProductName, null, p.CategoryName, p.Sku, p.Slug)" 
                         width="64"
                         height="64"
                         loading="lazy"
                         decoding="async"
                         class="w-16 h-16 rounded-xl object-cover border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 flex-shrink-0"
                         onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-mono font-medium text-slate-500 dark:text-slate-400">@p.Sku</span>
                            @if (p.Status == 1)
                            {
                                <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">Đang bán</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 text-[11px] font-semibold rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400">Tạm ngưng</span>
                            }
                        </div>
                        <a href="/Admin/Product/Details/@p.Id" class="block font-semibold text-slate-900 dark:text-slate-100 text-sm mt-0.5 line-clamp-2">
                            @p.ProductName
                        </a>
                        <div class="text-xs text-rose-600 dark:text-rose-400 font-medium mt-1">
                            @p.CategoryName
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-3 mt-3 text-xs">
                    <div>
                        <div class="text-slate-400">Giá bán</div>
                        <div class="font-bold text-slate-900 dark:text-slate-100 font-mono text-sm">
                            @p.SellingPrice.ToString("N0") đ
                        </div>
                    </div>
                    <div class="text-center">
                        <div class="text-slate-400">Tồn kho</div>
                        <div class="font-semibold @(p.TotalStock > 10 ? "text-emerald-600 dark:text-emerald-400" : p.TotalStock > 0 ? "text-amber-600 dark:text-amber-400" : "text-rose-600 dark:text-rose-400")">
                            @p.TotalStock @p.Unit
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <a href="/Admin/Product/Details/@p.Id" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300" title="Chi tiết">
                            <i class="fa-solid fa-eye text-xs"></i>
                        </a>
                        <a href="/Admin/Product/Edit/@p.Id" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400" title="Sửa">
                            <i class="fa-solid fa-pen-to-square text-xs"></i>
                        </a>
                        <button type="button" 
                                onclick="confirmDeleteProduct(@p.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(p.ProductName))')"
                                class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-rose-600 dark:text-rose-400" title="Xóa">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination & Summary Footer -->
    <div class="bg-white dark:bg-slate-900 px-4 py-3 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 mt-4">
        <div class="text-xs text-slate-500 dark:text-slate-400">
            Hiển thị <span class="font-semibold text-slate-700 dark:text-slate-200">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> đến 
            <span class="font-semibold text-slate-700 dark:text-slate-200">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)</span> 
            trên tổng số <span class="font-bold text-rose-600 dark:text-rose-400">@Model.TotalItems</span> sản phẩm
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="inline-flex items-center gap-1">
                <!-- First Page -->
                <button type="button" 
                        onclick="goToProductPage(1)"
                        disabled="@(Model.CurrentPage == 1)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang đầu">
                    <i class="fa-solid fa-angles-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" 
                        onclick="goToProductPage(@(Model.CurrentPage - 1))"
                        disabled="@(!Model.HasPreviousPage)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang trước">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <!-- Page numbers -->
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    int pageNum = i;
                    <button type="button" 
                            onclick="goToProductPage(@pageNum)"
                            class="min-w-[32px] h-8 rounded-xl text-xs font-semibold transition @(pageNum == Model.CurrentPage ? "bg-rose-500 text-white shadow-sm shadow-rose-500/30" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")">
                        @pageNum
                    </button>
                }

                <!-- Next Page -->
                <button type="button" 
                        onclick="goToProductPage(@(Model.CurrentPage + 1))"
                        disabled="@(!Model.HasNextPage)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang tiếp">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" 
                        onclick="goToProductPage(@Model.TotalPages)"
                        disabled="@(Model.CurrentPage == Model.TotalPages)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang cuối">
                    <i class="fa-solid fa-angles-right"></i>
                </button>
            </div>
        }
    </div>
}
