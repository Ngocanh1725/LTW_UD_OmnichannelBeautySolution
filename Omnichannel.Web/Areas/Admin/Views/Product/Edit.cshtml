@model Omnichannel.Application.DTOs.Inventory.ProductFormViewModel
@using Omnichannel.Domain.Entities
@{
    ViewData["Title"] = "Chỉnh Sửa Mỹ Phẩm: " + Model.ProductName;
    Layout = "_AdminLayout";
    var skinTypes = ViewBag.SkinTypes as List<SkinType> ?? new List<SkinType>();
    var ingredients = ViewBag.Ingredients as List<ActiveIngredient> ?? new List<ActiveIngredient>();
}

<div class="max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-rose-600 dark:text-rose-400 font-semibold uppercase tracking-wider">
                <a href="/Admin/Product" class="hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Danh sách sản phẩm</span>
                </a>
                <span>/</span>
                <a href="/Admin/Product/Details/@Model.Id" class="hover:underline">Chi tiết</a>
                <span>/</span>
                <span>Chỉnh sửa</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mt-1 line-clamp-1">
                @Model.ProductName
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 font-mono">
                Mã SKU: <span class="font-bold text-slate-800 dark:text-slate-200">@Model.Sku</span> • Barcode: @Model.Barcode
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Admin/Product/Details/@Model.Id" 
               class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition flex items-center gap-1.5">
                <i class="fa-solid fa-eye text-xs"></i>
                <span>Xem chi tiết</span>
            </a>
            <button type="submit" 
                    form="editProductForm"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-rose-500 to-pink-600 hover:from-rose-600 hover:to-pink-700 text-white font-semibold text-sm shadow-md shadow-rose-500/25 transition">
                <i class="fa-solid fa-floppy-disk mr-2"></i>Lưu Thay Đổi
            </button>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-sm">
            <div class="font-bold flex items-center gap-2 mb-1">
                <i class="fa-solid fa-circle-exclamation"></i>
                Vui lòng kiểm tra lại thông tin:
            </div>
            <div asp-validation-summary="All" class="text-xs list-disc list-inside space-y-1"></div>
        </div>
    }

    <!-- Form -->
    <form id="editProductForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: Details (8 cols) -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Section 1: Thông tin cơ bản -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-circle-info text-rose-500"></i>
                        Thông Tin Cơ Bản
                    </h2>

                    <!-- Tên sản phẩm -->
                    <div>
                        <label asp-for="ProductName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Tên mỹ phẩm <span class="text-rose-500">*</span>
                        </label>
                        <input asp-for="ProductName" 
                               id="prodName"
                               placeholder="vd: Serum Phục Hồi Hàng Rào Da Hyaluronic Acid B5" 
                               class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        <span asp-validation-for="ProductName" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- SKU & Barcode -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Sku" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Mã SKU <span class="text-rose-500">*</span>
                            </label>
                            <input asp-for="Sku" 
                                   id="prodSku"
                                   placeholder="vd: SKU-SERUM-B5-30ML" 
                                   class="w-full px-3.5 py-2.5 text-sm font-mono uppercase rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                            <span asp-validation-for="Sku" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Barcode" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Mã vạch EAN-13 <span class="text-rose-500">*</span>
                            </label>
                            <input asp-for="Barcode" 
                                   id="prodBarcode"
                                   placeholder="vd: 8935001234567" 
                                   class="w-full px-3.5 py-2.5 text-sm font-mono rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                            <span asp-validation-for="Barcode" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Danh mục, Brand & Đơn vị tính -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="CategoryId" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Ngành hàng <span class="text-rose-500">*</span>
                            </label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="SupplierId" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Thương hiệu / Brand
                            </label>
                            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition">
                                <option value="">-- Chọn thương hiệu --</option>
                            </select>
                        </div>

                        <div>
                            <label asp-for="Unit" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Đơn vị tính <span class="text-rose-500">*</span>
                            </label>
                            <input asp-for="Unit" 
                                   id="prodUnit"
                                   placeholder="vd: Chai, Hộp, Thỏi" 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>
                    </div>
                </div>

                <!-- Section 2: Giá & Doanh thu -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-coins text-amber-500"></i>
                        Thiết Lập Giá Bán & Lợi Nhuận
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="CostPrice" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Giá vốn nhập kho (VNĐ) <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <input asp-for="CostPrice" 
                                       type="number" 
                                       step="1000" 
                                       id="costPriceInput" 
                                       oninput="calculateProfitMargin()"
                                       class="w-full px-3.5 py-2.5 text-sm font-mono rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                                <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-mono">đ</span>
                            </div>
                            <span asp-validation-for="CostPrice" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="SellingPrice" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Giá bán niêm yết (VNĐ) <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <input asp-for="SellingPrice" 
                                       type="number" 
                                       step="1000" 
                                       id="sellingPriceInput" 
                                       oninput="calculateProfitMargin()"
                                       class="w-full px-3.5 py-2.5 text-sm font-mono rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                                <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-mono">đ</span>
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="DiscountPrice" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Giá khuyến mãi (VNĐ)
                            </label>
                            <div class="relative">
                                <input asp-for="DiscountPrice" 
                                       type="number" 
                                       step="1000" 
                                       class="w-full px-3.5 py-2.5 text-sm font-mono rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                                <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-mono">đ</span>
                            </div>
                        </div>
                    </div>

                    <!-- Margin preview badge -->
                    <div id="marginPreviewCard" class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Tỷ suất lợi nhuận gộp ước tính:</span>
                        <span id="marginValue" class="font-bold font-mono text-emerald-600 dark:text-emerald-400">0.0%</span>
                    </div>
                </div>

                <!-- Section 3: Đặc tính da liễu & Thành phần -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-droplet text-pink-500"></i>
                        Đặc Tính Mỹ Phẩm & Da Liễu
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Volume" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Dung tích / Khối lượng
                            </label>
                            <input asp-for="Volume" 
                                   placeholder="vd: 30ml, 50ml, 4.5g" 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>

                        <div>
                            <label asp-for="Formulation" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Kết cấu / Dạng bào chế
                            </label>
                            <input asp-for="Formulation" 
                                   placeholder="vd: Tinh chất Serum, Dạng kem (Cream), Lotion" 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>
                    </div>

                    <!-- Skin types multi-select -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Loại da phù hợp (chọn nhiều)
                        </label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var st in skinTypes)
                            {
                                bool isChecked = Model.SelectedSkinTypeIds.Contains(st.Id);
                                <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-medium cursor-pointer transition select-none has-[:checked]:bg-rose-50 has-[:checked]:border-rose-500 has-[:checked]:text-rose-700 dark:has-[:checked]:bg-rose-950/40 dark:has-[:checked]:border-rose-700 dark:has-[:checked]:text-rose-300 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400">
                                    <input type="checkbox" name="SelectedSkinTypeIds" value="@st.Id" checked="@isChecked" class="rounded text-rose-600 focus:ring-rose-500" />
                                    <span>@st.Name</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Ingredients multi-select -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Thành phần hoạt tính nổi bật
                        </label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var ing in ingredients)
                            {
                                bool isChecked = Model.SelectedIngredientIds.Contains(ing.Id);
                                <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-medium cursor-pointer transition select-none has-[:checked]:bg-pink-50 has-[:checked]:border-pink-500 has-[:checked]:text-pink-700 dark:has-[:checked]:bg-pink-950/40 dark:has-[:checked]:border-pink-700 dark:has-[:checked]:text-pink-300 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400">
                                    <input type="checkbox" name="SelectedIngredientIds" value="@ing.Id" checked="@isChecked" class="rounded text-pink-600 focus:ring-pink-500" />
                                    <span>@ing.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Section 4: Mô tả & SEO -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-magnifying-glass-chart text-indigo-500"></i>
                        Mô Tả & Tối Ưu Hóa SEO
                    </h2>

                    <!-- Slug -->
                    <div>
                        <label asp-for="Slug" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Đường dẫn tĩnh SEO (Slug) <span class="text-rose-500">*</span>
                        </label>
                        <div class="flex rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700">
                            <span class="inline-flex items-center px-3 bg-slate-100 dark:bg-slate-800 text-slate-500 text-xs font-mono border-r border-slate-200 dark:border-slate-700">
                                /san-pham/
                            </span>
                            <input asp-for="Slug" 
                                   id="prodSlug"
                                   placeholder="serum-phuc-hoi-hang-rao-da-b5" 
                                   class="w-full px-3.5 py-2.5 text-sm font-mono bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none" />
                        </div>
                        <span asp-validation-for="Slug" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Short description -->
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label asp-for="ShortDescription" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                                Mô tả ngắn (Meta Description SEO)
                            </label>
                            <span id="shortDescCount" class="text-[11px] text-slate-400">@(Model.ShortDescription?.Length ?? 0)/500</span>
                        </div>
                        <textarea asp-for="ShortDescription" 
                                  id="shortDescInput"
                                  rows="2" 
                                  oninput="document.getElementById('shortDescCount').textContent = this.value.length + '/500'"
                                  placeholder="Mô tả vắn tắt 1-2 câu về công dụng chính..."
                                  class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition"></textarea>
                    </div>

                    <!-- Detailed description -->
                    <div>
                        <label asp-for="Description" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Mô tả chi tiết & Hướng dẫn sử dụng
                        </label>
                        <textarea asp-for="Description" 
                                  rows="5" 
                                  placeholder="Chi tiết công dụng, cách dùng sáng/tối, bảng thành phần đầy đủ..."
                                  class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition"></textarea>
                    </div>
                </div>

                <!-- Section 5: Pháp lý & Xuất xứ -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-file-shield text-emerald-500"></i>
                        Thông Tin Pháp Lý & Nguồn Gốc
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="CosmeticNotificationNumber" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Số công bố BYT
                            </label>
                            <input asp-for="CosmeticNotificationNumber" 
                                   placeholder="vd: 123456/21/CBMP-QLD" 
                                   class="w-full px-3.5 py-2.5 text-sm font-mono rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>

                        <div>
                            <label asp-for="CountryOfOrigin" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Nước xuất xứ
                            </label>
                            <input asp-for="CountryOfOrigin" 
                                   placeholder="vd: Pháp, Hàn Quốc, Nhật Bản" 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>

                        <div>
                            <label asp-for="ManufacturerName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Nhà sản xuất
                            </label>
                            <input asp-for="ManufacturerName" 
                                   placeholder="vd: Cosmax Co., Ltd." 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>

                        <div>
                            <label asp-for="ImporterName" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                                Đơn vị nhập khẩu
                            </label>
                            <input asp-for="ImporterName" 
                                   placeholder="vd: Công ty TNHH Omnichannel Beauty" 
                                   class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Thumbnail, Publish & Status (4 cols) -->
            <div class="lg:col-span-4 space-y-6">
                <!-- Thumbnail Box -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-image text-rose-500"></i>
                        Ảnh Đại Diện Sản Phẩm
                    </h2>

                    <!-- Image preview box -->
                    <div id="imagePreviewContainer" class="relative w-full aspect-square rounded-2xl overflow-hidden border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 flex flex-col items-center justify-center p-4 group">
                        <img id="imagePreview" 
                             src="@(Model.ThumbnailMediaId.HasValue ? $"/media/{Model.ThumbnailMediaId}" : (string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? "/images/product-placeholder.svg" : Model.ThumbnailUrl))" 
                             alt="Preview" 
                             class="w-full h-full object-contain rounded-xl transition group-hover:scale-105"
                             onerror="this.onerror=null;this.src='/images/product-placeholder.svg';" />
                    </div>

                    <!-- Hidden Media Id from DB -->
                    <input type="hidden" asp-for="ThumbnailMediaId" id="ThumbnailMediaId" />

                    <!-- Button Select from DB Media -->
                    <button type="button" class="btn-select-media w-full py-2.5 px-3 bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 text-white text-xs font-semibold rounded-xl shadow transition flex items-center justify-center gap-2"
                            data-input="#ThumbnailMediaId" data-preview="#imagePreview" data-category="PRODUCT">
                        <i class="fa-solid fa-photo-film"></i>
                        Chọn Ảnh Từ CSDL
                    </button>

                    <!-- Alternative: direct URL -->
                    <div>
                        <label asp-for="ThumbnailUrl" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Hoặc nhập URL ảnh ngoài
                        </label>
                        <input asp-for="ThumbnailUrl" 
                               id="thumbnailUrlInput"
                               oninput="handleUrlImageChange(this.value)"
                               placeholder="https://example.com/photo.jpg" 
                               class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition" />
                    </div>
                </div>

                <!-- Status & Publish card -->
                <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
                    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
                        <i class="fa-solid fa-sliders text-indigo-500"></i>
                        Trạng Thái Kinh Doanh
                    </h2>

                    <!-- IsActive Toggle -->
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">Đang kinh doanh</div>
                            <div class="text-[11px] text-slate-400">Hiển thị bán hàng trên POS & Website</div>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" asp-for="IsActive" class="sr-only peer" />
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-500"></div>
                        </label>
                    </div>

                    <!-- IsFeatured Toggle -->
                    <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-3">
                        <div>
                            <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">Sản phẩm nổi bật</div>
                            <div class="text-[11px] text-slate-400">Ghim tại trang chủ Storefront</div>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" asp-for="IsFeatured" class="sr-only peer" />
                            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                        </label>
                    </div>

                    <!-- Product Type -->
                    <div class="border-t border-slate-100 dark:border-slate-800 pt-3">
                        <label asp-for="ProductType" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                            Phân loại hàng
                        </label>
                        <select asp-for="ProductType" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition">
                            <option value="STANDARD">STANDARD - Hàng bán thương mại</option>
                            <option value="TESTER">TESTER - Hàng thử tại quầy POS</option>
                            <option value="SAMPLE">SAMPLE - Hàng mẫu dùng thử</option>
                            <option value="GWP">GWP - Quà tặng kèm đơn hàng</option>
                        </select>
                    </div>
                </div>

                <!-- Submit / Cancel block -->
                <div class="space-y-2">
                    <button type="submit" 
                            class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-rose-500 to-pink-600 hover:from-rose-600 hover:to-pink-700 text-white font-bold text-sm shadow-md shadow-rose-500/25 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Lưu Thay Đổi</span>
                    </button>
                    <a href="/Admin/Product/Details/@Model.Id" 
                       class="w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-xs hover:bg-slate-50 dark:hover:bg-slate-700 transition flex items-center justify-center">
                        Hủy bỏ & Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_MediaPickerModal" />
    <script src="~/js/admin-media-picker.js"></script>
    <script>
        // Live Calculate Profit Margin
        function calculateProfitMargin() {
            const cost = parseFloat(document.getElementById('costPriceInput')?.value || 0);
            const sell = parseFloat(document.getElementById('sellingPriceInput')?.value || 0);
            const marginVal = document.getElementById('marginValue');

            if (sell > 0) {
                const margin = ((sell - cost) / sell) * 100;
                marginVal.textContent = margin.toFixed(1) + '%';
                if (margin < 15) {
                    marginVal.className = 'font-bold font-mono text-rose-500';
                } else if (margin < 30) {
                    marginVal.className = 'font-bold font-mono text-amber-500';
                } else {
                    marginVal.className = 'font-bold font-mono text-emerald-500';
                }
            } else {
                marginVal.textContent = '0.0%';
                marginVal.className = 'font-bold font-mono text-slate-500';
            }
        }

        // Handle Image upload preview
        function handleThumbnailSelect(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imagePreview');
                    if (img) img.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function handleUrlImageChange(val) {
            const img = document.getElementById('imagePreview');
            if (img && val.trim().length > 5) {
                img.src = val.trim();
            }
        }

        // Initial margin calculation
        calculateProfitMargin();
    </script>
}
