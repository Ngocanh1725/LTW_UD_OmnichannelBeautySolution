@model IEnumerable<Omnichannel.Application.DTOs.Cms.BannerItemViewModel>
@{
    ViewData["Title"] = "Quản lý Banners & Quảng cáo";
    Layout = "_AdminLayout";
    var currentStatus = (ViewBag.CurrentStatus as string) ?? "all";
    int totalCount = ViewBag.TotalCount ?? 0;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int hiddenCount = ViewBag.HiddenCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Chiến dịch Banner & Quảng Cáo</h4>
        <p class="text-muted small mb-0">Quản lý slider đầu trang chủ, popup khuyến mại và banner danh mục sản phẩm</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/" target="_blank" class="btn btn-outline-secondary px-3">
            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Xem Hero Slider
        </a>
        <a href="/Admin/Banner/Create" class="btn btn-primary-gradient px-3">
            <i class="fa-solid fa-plus me-1"></i>Tạo Mới Banner
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4 shadow-xs" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (hiddenCount > 0)
{
    <div class="alert alert-warning border-amber-300 bg-amber-50 text-amber-900 rounded-3 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-xs">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-eye-slash fs-5 text-amber-600"></i>
            <div>
                <strong>Có @hiddenCount Banner đang được tạm ẩn</strong>
                <div class="small text-amber-800">Các banner này không xuất hiện ngoài trang chủ/storefront nhưng vẫn được lưu đầy đủ cấu hình.</div>
            </div>
        </div>
        <form asp-action="RestoreAllHidden" method="post" class="d-inline m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-success text-white px-3 py-1.5 rounded-2 shadow-xs fw-semibold">
                <i class="fa-solid fa-eye me-1"></i>Hiện Lại Tất Cả (@hiddenCount Banner)
            </button>
        </form>
    </div>
}

<!-- Navigation Filter Tabs -->
<div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-2">
    <a href="/Admin/Banner?status=all" class="btn btn-sm @(currentStatus == "all" ? "btn-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3">
        <i class="fa-solid fa-list me-1"></i>Tất cả <span class="badge @(currentStatus == "all" ? "bg-light text-dark" : "bg-secondary text-white") ms-1">@totalCount</span>
    </a>
    <a href="/Admin/Banner?status=active" class="btn btn-sm @(currentStatus == "active" ? "btn-success fw-bold text-white" : "btn-outline-secondary") rounded-pill px-3">
        <i class="fa-solid fa-circle-check me-1"></i>Đang hiển thị <span class="badge @(currentStatus == "active" ? "bg-white text-success" : "bg-success-subtle text-success") ms-1">@activeCount</span>
    </a>
    <a href="/Admin/Banner?status=hidden" class="btn btn-sm @(currentStatus == "hidden" ? "btn-warning fw-bold text-dark" : "btn-outline-secondary") rounded-pill px-3">
        <i class="fa-solid fa-eye-slash me-1"></i>Đã tạm ẩn <span class="badge @(currentStatus == "hidden" ? "bg-dark text-white" : "bg-warning text-dark") ms-1">@hiddenCount</span>
    </a>
</div>

<div class="beauty-card overflow-hidden border shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="py-3 px-4" style="width: 140px;">Hình ảnh</th>
                    <th class="py-3">Chiến dịch & Vị trí</th>
                    <th class="py-3">Thứ tự</th>
                    <th class="py-3">Thời gian hiệu lực</th>
                    <th class="py-3 text-center">Lượt Click</th>
                    <th class="py-3 text-center">Trạng thái</th>
                    <th class="py-3 px-4 text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-regular fa-images fs-1 text-muted opacity-50 mb-2"></i>
                            @if (currentStatus == "hidden")
                            {
                                <div>Không có banner nào đang bị tạm ẩn.</div>
                            }
                            else if (currentStatus == "active")
                            {
                                <div>Không có banner nào đang hiển thị. Hãy bấm <a href="/Admin/Banner?status=hidden" class="text-primary fw-bold">Hiện lại banner đã ẩn</a> hoặc tạo mới.</div>
                            }
                            else
                            {
                                <div>Chưa có banner nào. Nhấn <strong>"Tạo Mới Banner"</strong> để thêm banner cho trang chủ!</div>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model)
                    {
                        <tr class="@(!b.IsActive ? "bg-warning-subtle" : "")" style="@(!b.IsActive ? "background-color: #fffbeb !important;" : "")">
                            <td class="px-4">
                                <div class="position-relative d-inline-block">
                                    <img src="@b.DesktopImageUrl" alt="@b.Title" class="rounded-3 shadow-sm border" style="width: 120px; height: 55px; object-fit: cover;" onerror="this.src='/images/banners/hero-banner-summer-beauty.jpg'" />
                                    @if (!string.IsNullOrEmpty(b.MobileImageUrl))
                                    {
                                        <span class="position-absolute bottom-0 end-0 badge bg-dark text-white p-1" style="font-size: 8px;" title="Có ảnh Mobile riêng">
                                            <i class="fa-solid fa-mobile-screen"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-1.5">
                                    <span>@b.Title</span>
                                    @if (!b.IsActive)
                                    {
                                        <span class="badge bg-warning text-dark border" style="font-size: 10px;">ĐANG ẨN</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(b.Subtitle))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 340px;">@b.Subtitle</div>
                                }
                                <span class="badge" style="background: var(--primary-purple-light); color: var(--primary-purple); font-size: 11px;">@b.PositionName</span>
                                @if (!string.IsNullOrEmpty(b.LinkUrl))
                                {
                                    <div class="text-muted font-monospace" style="font-size: 11px;">URL: @b.LinkUrl</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">#@b.DisplayOrder</span>
                            </td>
                            <td class="small">
                                <div>Từ: <strong>@b.ValidFrom.ToString("dd/MM/yyyy")</strong></div>
                                <div class="text-muted">Đến: @b.ValidTo.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-center font-monospace fw-bold text-secondary">
                                <i class="fa-solid fa-arrow-pointer text-muted me-1"></i>@b.TrackingClickCount
                            </td>
                            <td class="text-center">
                                @if (!b.IsActive)
                                {
                                    <span class="badge bg-secondary text-white px-2.5 py-1.5 rounded-pill shadow-xs">
                                        <i class="fa-solid fa-eye-slash me-1"></i>Đã tạm ẩn
                                    </span>
                                }
                                else if (b.IsExpired)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill border border-danger-subtle">
                                        <i class="fa-solid fa-clock-rotate-left me-1"></i>Hết hạn
                                    </span>
                                }
                                else if (b.IsUpcoming)
                                {
                                    <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 rounded-pill border border-warning-subtle">
                                        <i class="fa-solid fa-calendar-day me-1"></i>Sắp chạy
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill border border-success-subtle">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đang hiển thị
                                    </span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <div class="d-inline-flex gap-1.5 align-items-center">
                                    @if (!b.IsActive)
                                    {
                                        <form asp-action="ToggleStatus" asp-route-id="@b.BannerId" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success text-white rounded-3 px-2.5 py-1 shadow-xs fw-semibold" title="Bật hiển thị lại banner này">
                                                <i class="fa-solid fa-eye me-1"></i>Hiện lại
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleStatus" asp-route-id="@b.BannerId" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3" title="Tạm ẩn banner này">
                                                <i class="fa-solid fa-eye-slash me-1"></i>Tạm ẩn
                                            </button>
                                        </form>
                                    }
                                    <a href="/Admin/Banner/Edit/@b.BannerId" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa Banner">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@b.BannerId" method="post" class="d-inline m-0" onsubmit="return confirm('Bạn có chắc muốn xóa vĩnh viễn banner này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa banner">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
