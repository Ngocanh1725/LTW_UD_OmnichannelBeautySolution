@model Omnichannel.Application.DTOs.Cms.CreateBannerViewModel
@{
    ViewData["Title"] = "Thêm Mới Banner";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">Thêm Mới Banner Chiến Dịch</h4>
                <p class="text-muted small mb-0">Cấu hình hình ảnh và vị trí banner trên website</p>
            </div>
            <a href="/Admin/Banner" class="btn btn-outline-secondary btn-sm rounded-3">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
            </a>
        </div>

        <div class="beauty-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Title" class="form-label small fw-semibold"></label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="vd: Siêu Sale Mỹ Phẩm Hè 2026" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Position" class="form-label small fw-semibold"></label>
                        <select asp-for="Position" class="form-select rounded-3">
                            <option value="1">1. Hero Slider (Đầu trang chủ)</option>
                            <option value="2">2. Popup Khuyến mãi (Giữa trang)</option>
                            <option value="3">3. Banner Danh mục (Catalog Top)</option>
                            <option value="4">4. Footer Strip (Chân trang)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="DesktopImageUrl" class="form-label small fw-semibold"></label>
                        <input asp-for="DesktopImageUrl" class="form-control rounded-3" placeholder="https://domain.com/images/banner-summer.webp" />
                        <span asp-validation-for="DesktopImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MobileImageUrl" class="form-label small fw-semibold"></label>
                        <input asp-for="MobileImageUrl" class="form-control rounded-3" placeholder="https://domain.com/images/banner-mobile.webp" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LinkUrl" class="form-label small fw-semibold"></label>
                        <input asp-for="LinkUrl" class="form-control rounded-3" placeholder="/danh-muc/khuyen-mai-he" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DisplayOrder" class="form-label small fw-semibold"></label>
                        <input asp-for="DisplayOrder" type="number" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ValidFrom" class="form-label small fw-semibold"></label>
                        <input asp-for="ValidFrom" type="datetime-local" class="form-control rounded-3" />
                        <span asp-validation-for="ValidFrom" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ValidTo" class="form-label small fw-semibold"></label>
                        <input asp-for="ValidTo" type="datetime-local" class="form-control rounded-3" />
                        <span asp-validation-for="ValidTo" class="text-danger small"></span>
                    </div>

                    <div class="col-12 text-end mt-4">
                        <a href="/Admin/Banner" class="btn btn-light rounded-3 px-4 me-2">Hủy</a>
                        <button type="submit" class="btn btn-primary-gradient px-4">Tạo Banner</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
