@{
    string activeFolder = (ViewBag.Folder as string ?? "inbox").ToLowerInvariant();
    int unreadCount = ViewBag.UnreadCount != null ? (int)ViewBag.UnreadCount : (Model is Omnichannel.Application.DTOs.Messages.MessageFolderDto f ? f.UnreadCount : 0);
}

<div class="w-full md:w-64 flex-shrink-0 space-y-4">
    <!-- Nút Soạn thư mới (Gmail / Outlook style) -->
    <a href="/Admin/Messages/Compose" 
       class="w-full flex items-center justify-center gap-2.5 px-5 py-3 rounded-2xl bg-gradient-to-r from-rose-500 via-pink-500 to-indigo-600 hover:from-rose-600 hover:to-indigo-700 text-white font-bold text-sm shadow-lg shadow-pink-500/25 transition transform hover:-translate-y-0.5 active:translate-y-0">
        <i class="fa-solid fa-pen-to-square text-base"></i>
        <span>Soạn Thư Mới</span>
    </a>

    <!-- Menu Thư mục -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-2 space-y-1 shadow-sm">
        <a href="/Admin/Messages/Inbox" 
           class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition @(activeFolder == "inbox" ? "bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60")">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-inbox text-sm @(activeFolder == "inbox" ? "text-rose-500" : "text-slate-400")"></i>
                <span>Hộp Thư Đến</span>
            </div>
            @if (unreadCount > 0)
            {
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500 text-white shadow-sm @(activeFolder == "inbox" ? "animate-pulse" : "")">
                    @unreadCount
                </span>
            }
        </a>

        <a href="/Admin/Messages/Sent" 
           class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition @(activeFolder == "sent" ? "bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold" : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/60")">
            <div class="flex items-center gap-2.5">
                <i class="fa-solid fa-paper-plane text-sm @(activeFolder == "sent" ? "text-rose-500" : "text-slate-400")"></i>
                <span>Đã Gửi</span>
            </div>
        </a>
    </div>

    <!-- Hộp thông tin hướng dẫn nhanh -->
    <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-50/50 to-pink-50/30 dark:from-slate-800/50 dark:to-slate-800/20 border border-indigo-100/60 dark:border-slate-800 text-xs">
        <div class="flex items-center gap-2 font-bold text-slate-800 dark:text-slate-200 mb-1.5">
            <i class="fa-solid fa-shield-halved text-indigo-500"></i>
            <span>Bảo Mật Nội Bộ</span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
            Hộp thư trao đổi công việc nội bộ chỉ lưu hành trong nhân sự hệ thống. Realtime thông báo qua SignalR.
        </p>
    </div>
</div>
