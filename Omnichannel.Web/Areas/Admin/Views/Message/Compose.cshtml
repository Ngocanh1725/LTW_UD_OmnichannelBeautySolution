@model Omnichannel.Application.DTOs.Messages.ComposeMessageDto
@{
    ViewData["Title"] = "Soạn Thư Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var recipients = ViewBag.Recipients as List<Omnichannel.Application.DTOs.Messages.UserRecipientDto> ?? new List<Omnichannel.Application.DTOs.Messages.UserRecipientDto>();
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/Admin/Messages/Inbox" 
               class="h-10 w-10 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-rose-600 transition shadow-sm"
               title="Quay lại">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>
            <div>
                <h1 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    Soạn Thư Mới
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Gửi tin nhắn hoặc thông báo công việc tới nhân viên, quản lý và ban điều hành
                </p>
            </div>
        </div>
    </div>

    <!-- Main Container Layout (Sidebar + Compose Form) -->
    <div class="flex flex-col md:flex-row items-start gap-6">
        <!-- Sidebar -->
        <partial name="_MessageSidebar" />

        <!-- Form Card -->
        <div class="flex-1 w-full bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-pen-fancy text-rose-500 text-sm"></i>
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200">
                        Nội Dung Thư Gửi Đi
                    </span>
                </div>
                <span class="text-[11px] text-slate-400">
                    Gửi tức thời qua SignalR
                </span>
            </div>

            <form asp-action="Compose" asp-controller="Message" asp-area="Admin" method="post" class="p-6 sm:p-8 space-y-6">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-xs"></div>

                <!-- Recipient Dropdown -->
                <div class="space-y-1.5">
                    <label asp-for="ReceiverId" class="block text-xs font-bold text-slate-700 dark:text-slate-200">
                        Người Nhận <span class="text-rose-500">*</span>
                    </label>
                    <select asp-for="ReceiverId" 
                            class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 focus:outline-none focus:border-rose-500 focus:bg-white dark:focus:bg-slate-700 transition">
                        <option value="">-- Chọn nhân viên / người nhận --</option>
                        @foreach (var u in recipients)
                        {
                            <option value="@u.Id" selected="@(Model.ReceiverId == u.Id ? "selected" : null)">
                                @u.FullName (@u.RoleName - @u.StoreName) [@u.Username]
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ReceiverId" class="text-xs text-rose-500"></span>
                </div>

                <!-- Subject -->
                <div class="space-y-1.5">
                    <label asp-for="Subject" class="block text-xs font-bold text-slate-700 dark:text-slate-200">
                        Tiêu Đề Thư <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Subject" 
                           type="text" 
                           placeholder="Ví dụ: Kế hoạch bán hàng tuần mới, Báo cáo tồn kho..." 
                           class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 focus:outline-none focus:border-rose-500 focus:bg-white dark:focus:bg-slate-700 transition" />
                    <span asp-validation-for="Subject" class="text-xs text-rose-500"></span>
                </div>

                <!-- Body -->
                <div class="space-y-1.5">
                    <label asp-for="Body" class="block text-xs font-bold text-slate-700 dark:text-slate-200">
                        Nội Dung Chi Tiết <span class="text-rose-500">*</span>
                    </label>
                    <textarea asp-for="Body" 
                              rows="9" 
                              placeholder="Nhập nội dung trao đổi công việc, phản hồi, chỉ đạo điều hành..." 
                              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-100 focus:outline-none focus:border-rose-500 focus:bg-white dark:focus:bg-slate-700 transition leading-relaxed"></textarea>
                    <span asp-validation-for="Body" class="text-xs text-rose-500"></span>
                </div>

                <!-- Action Buttons -->
                <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <a href="/Admin/Messages/Inbox" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 transition">
                        Hủy Bỏ
                    </a>

                    <button type="submit" 
                            class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-rose-500 via-pink-500 to-indigo-600 hover:from-rose-600 hover:to-indigo-700 text-white font-bold text-xs shadow-lg shadow-pink-500/25 transition flex items-center gap-2 transform hover:-translate-y-0.5 active:translate-y-0">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Gửi Thư Nội Bộ</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
