@model Omnichannel.Application.DTOs.Messages.InternalMessageDto
@{
    ViewData["Title"] = Model.Subject;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string folder = ViewBag.Folder as string ?? "inbox";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <a href="/Admin/Messages/@(folder == "sent" ? "Sent" : "Inbox")" 
               class="h-10 w-10 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-rose-600 transition shadow-sm"
               title="Quay lại danh sách thư">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>
            <div>
                <h1 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    Chi Tiết Thư Nội Bộ
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @(folder == "sent" ? "Thư gửi đi" : "Thư nhận được") • @Model.TimeAgo
                </p>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2">
            @if (folder == "inbox")
            {
                <a href="/Admin/Messages/Compose?replyToUserId=@Model.SenderId&subject=@Uri.EscapeDataString(Model.Subject)" 
                   class="px-4 py-2 rounded-xl bg-gradient-to-r from-rose-500 to-indigo-600 hover:from-rose-600 hover:to-indigo-700 text-white text-xs font-bold transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-reply"></i>
                    <span>Trả Lời</span>
                </a>
            }

            <form asp-action="Delete" asp-route-id="@Model.Id" asp-controller="Message" asp-area="Admin" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thư này?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="folder" value="@folder" />
                <button type="submit" class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-semibold transition flex items-center gap-1.5" title="Xóa thư">
                    <i class="fa-regular fa-trash-can"></i>
                    <span>Xóa</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Main Container Layout (Sidebar + Detail Card) -->
    <div class="flex flex-col md:flex-row items-start gap-6">
        <!-- Sidebar -->
        <partial name="_MessageSidebar" />

        <!-- Detail Card -->
        <div class="flex-1 w-full bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <!-- Mail Header -->
            <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30">
                <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
                    @Model.Subject
                </h2>

                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3.5">
                        @if (!string.IsNullOrEmpty(Model.SenderAvatar))
                        {
                            <img src="@Model.SenderAvatar" class="h-11 w-11 rounded-full object-cover border border-slate-200 dark:border-slate-700" alt="Avatar" />
                        }
                        else
                        {
                            <div class="h-11 w-11 rounded-full bg-gradient-to-tr from-pink-400 to-indigo-600 text-white flex items-center justify-center text-sm font-bold shadow-sm">
                                @Model.SenderInitials
                            </div>
                        }

                        <div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="text-sm font-bold text-slate-900 dark:text-white">@Model.SenderName</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                                    @Model.SenderRole
                                </span>
                            </div>
                            <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                Gửi tới: <span class="font-medium text-slate-700 dark:text-slate-300">@Model.ReceiverName</span> (@Model.ReceiverRole)
                            </div>
                        </div>
                    </div>

                    <div class="text-right text-xs text-slate-400">
                        <div>@Model.SentAt.ToString("HH:mm - dd/MM/yyyy")</div>
                        <div class="text-[11px] text-slate-500">(@Model.TimeAgo)</div>
                    </div>
                </div>
            </div>

            <!-- Mail Body Content -->
            <div class="p-6 sm:p-8 min-h-[300px]">
                <div class="prose dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 text-sm leading-relaxed whitespace-pre-line font-sans">
                    @Model.Body
                </div>
            </div>

            <!-- Footer Action Bar -->
            <div class="p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between">
                <a href="/Admin/Messages/@(folder == "sent" ? "Sent" : "Inbox")" class="text-xs text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 font-semibold flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left text-[10px]"></i> Quay lại @(folder == "sent" ? "hộp thư đã gửi" : "hộp thư đến")
                </a>

                @if (folder == "inbox")
                {
                    <a href="/Admin/Messages/Compose?replyToUserId=@Model.SenderId&subject=@Uri.EscapeDataString(Model.Subject)" 
                       class="text-xs text-rose-600 hover:text-rose-700 dark:text-rose-400 font-bold flex items-center gap-1.5">
                        <i class="fa-solid fa-reply"></i>
                        <span>Soạn thư trả lời @Model.SenderName</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
