@model Omnichannel.Application.DTOs.HR.CustomerUserIndexViewModel
@{
    ViewData["Title"] = "Tài Khoản Khách Hàng (UserType = 1)";
    Layout = "_AdminLayout";
}

<!-- Header & Breadcrumb -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <nav aria-label="breadcrumb" class="mb-1">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Admin/User" class="text-decoration-none text-muted">Quản Lý Nhân Sự</a></li>
                <li class="breadcrumb-item active fw-semibold text-indigo-600" aria-current="page">Tài khoản khách hàng</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-tag text-indigo-600"></i>
            <span>Tài Khoản Khách Hàng Mua Sắm</span>
            <span class="badge rounded-pill font-monospace fw-normal" style="background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe;font-size:0.72rem;">
                UserType = 1
            </span>
        </h4>
        <p class="small text-muted mb-0 mt-1">
            Danh sách tài khoản đăng nhập của khách hàng trên Storefront (tách biệt hoàn toàn với tài khoản quản trị & nhân sự nội bộ).
        </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/Admin/Customer" class="btn btn-primary-gradient text-white btn-sm px-3.5 py-2 fw-semibold rounded-3 shadow-xs">
            <i class="fa-solid fa-address-book me-1.5"></i>Sang Khách Hàng CRM 360°
        </a>
    </div>
</div>

<!-- Tabs Tách Bạch: Nhân Sự Nội Bộ (UserType=2) | Tài Khoản Khách Hàng (UserType=1) -->
<ul class="nav nav-tabs border-bottom mb-4 gap-2" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link fw-bold px-3.5 py-2.5 rounded-top-3 d-flex align-items-center gap-2 text-muted"
           href="/Admin/User" role="tab" aria-selected="false">
            <i class="fa-solid fa-user-shield"></i>
            <span>Nhân sự nội bộ</span>
            <span class="badge rounded-pill bg-slate-100 text-slate-700 border">@Model.TotalInternalStaff</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link active fw-bold px-3.5 py-2.5 rounded-top-3 d-flex align-items-center gap-2"
           href="/Admin/User/Customers" role="tab" aria-selected="true"
           style="color: #4f46e5; border-bottom: 3px solid #4f46e5;">
            <i class="fa-solid fa-bag-shopping"></i>
            <span>Tài khoản khách hàng</span>
            <span class="badge rounded-pill" style="background:#eef2ff;color:#4338ca;">@Model.TotalCustomers</span>
        </a>
    </li>
</ul>

<!-- 3 Thẻ KPI Khách Hàng -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-xs rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Tổng tài khoản khách hàng</div>
                    <div class="fs-4 fw-bolder text-slate-900 dark:text-white mt-0.5">@Model.TotalCustomers</div>
                </div>
                <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background:#eef2ff; color:#4f46e5;">
                    <i class="fa-solid fa-users fs-5"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-xs rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Đang hoạt động</div>
                    <div class="fs-4 fw-bolder text-emerald-600 mt-0.5">@Model.ActiveCustomers</div>
                </div>
                <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background:#ecfdf5; color:#059669;">
                    <i class="fa-solid fa-user-check fs-5"></i>
                </span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-xs rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Đang tạm khóa</div>
                    <div class="fs-4 fw-bolder text-rose-600 mt-0.5">@Model.LockedCustomers</div>
                </div>
                <span class="d-inline-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background:#fff1f2; color:#e11d48;">
                    <i class="fa-solid fa-user-lock fs-5"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Thanh Tìm Kiếm & Lọc Trạng Thái -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white dark:bg-slate-900 p-3">
    <form method="get" action="/Admin/User/Customers" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="Keyword" class="form-control"
                       placeholder="Tìm theo họ tên, username, email hoặc số điện thoại..."
                       value="@Model.Filter.Keyword" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="Status" class="form-select form-select-sm rounded-3">
                <option value="all" selected="@(Model.Filter.Status == "all" ? "selected" : null)">-- Trạng thái: Tất cả --</option>
                <option value="active" selected="@(Model.Filter.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                <option value="locked" selected="@(Model.Filter.Status == "locked" ? "selected" : null)">Đang khóa</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary-gradient btn-sm flex-grow-1 text-white fw-semibold rounded-3">
                <i class="fa-solid fa-filter me-1"></i>Lọc khách hàng
            </button>
            <a href="/Admin/User/Customers" class="btn btn-outline-secondary btn-sm px-3 rounded-3">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Bảng Khách Hàng -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark:bg-slate-900" id="customerTableContainer">
    <partial name="_CustomerTable" model="Model.CustomersPaged" />
</div>
