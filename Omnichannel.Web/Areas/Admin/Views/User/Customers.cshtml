@model Omnichannel.Application.DTOs.HR.CustomerUserIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Tài Khoản Khách Hàng";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted">Hệ thống</a></li>
                <li class="breadcrumb-item active text-dark dark:text-white fw-semibold" aria-current="page">Tài khoản khách hàng</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-tag text-indigo-600"></i>
            <span>Tài Khoản Đăng Nhập Của Khách Hàng (Storefront)</span>
        </h4>
        <p class="small text-muted mb-0 mt-1">Danh sách tài khoản khách hàng đăng ký mua sắm tại Storefront. Để quản lý hồ sơ sắc đẹp và ví điểm Loyalty chi tiết, vui lòng chuyển sang cổng CRM.</p>
    </div>

    <div class="d-flex gap-2">
        <a href="/Admin/Customer" class="btn btn-primary-gradient btn-sm px-3.5 py-2 text-white fw-semibold rounded-3 shadow-xs">
            <i class="fa-solid fa-address-book me-1.5"></i>Mở Phân Hệ CRM 360
        </a>
    </div>
</div>

<!-- Tabs: Nhân sự nội bộ vs Tài khoản khách hàng -->
<div class="border-bottom border-slate-200 dark:border-slate-800 mb-4">
    <ul class="nav nav-tabs border-0" id="userManagementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link text-muted hover:text-dark dark:hover:text-white border-0 py-2.5 px-3.5 d-flex align-items-center gap-2 text-decoration-none" href="/Admin/User">
                <i class="fa-solid fa-user-tie text-muted"></i>
                <span>Nhân Sự Nội Bộ</span>
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-dark dark:text-white border-0 border-bottom border-2 border-indigo-600 bg-transparent py-2.5 px-3.5 d-flex align-items-center gap-2" type="button" role="tab">
                <i class="fa-solid fa-user-tag text-indigo-600"></i>
                <span>Tài Khoản Khách Hàng</span>
                <span class="badge bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 rounded-pill font-monospace" style="font-size: 0.72rem;">@Model.TotalCustomers</span>
            </button>
        </li>
    </ul>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Tổng Khách Hàng</div>
            <h3 class="fw-bolder mb-0 mt-1 text-slate-900 dark:text-white">@Model.TotalCustomers</h3>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Đang Hoạt Động</div>
            <h3 class="fw-bolder mb-0 mt-1 text-success">@Model.ActiveCustomers</h3>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white dark:bg-slate-900">
            <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Đang Tạm Khóa</div>
            <h3 class="fw-bolder mb-0 mt-1 text-danger">@Model.LockedCustomers</h3>
        </div>
    </div>
</div>

<!-- Filter Form -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white dark:bg-slate-900 p-3">
    <form method="get" action="/Admin/User/Customers" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="Keyword" class="form-control" placeholder="Tìm theo tên, username, email, số điện thoại..." value="@Model.Filter.Keyword" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="Status" class="form-select form-select-sm rounded-3">
                <option value="all" selected="@(Model.Filter.Status == "all" ? "selected" : null)">-- Trạng thái: Tất cả --</option>
                <option value="active" selected="@(Model.Filter.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                <option value="locked" selected="@(Model.Filter.Status == "locked" ? "selected" : null)">Đã tạm khóa</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1.5">
            <button type="submit" class="btn btn-primary-gradient btn-sm flex-grow-1 text-white fw-semibold rounded-3">
                <i class="fa-solid fa-filter me-1"></i>Lọc
            </button>
            <a href="/Admin/User/Customers" class="btn btn-outline-secondary btn-sm px-2.5 rounded-3">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Customer Table Container -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark:bg-slate-900">
    <partial name="_CustomerTable" model="Model.CustomersPaged" />
</div>

