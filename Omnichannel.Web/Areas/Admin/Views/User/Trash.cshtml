@model Omnichannel.Application.DTOs.HR.StaffTrashViewModel
@{
    ViewData["Title"] = "Thùng Rác Nhân Sự";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/Admin/User" class="btn btn-sm btn-outline-secondary rounded-3 px-2.5 py-1">
                <i class="fa-solid fa-arrow-left me-1"></i>Danh sách nhân sự
            </a>
            <span class="badge bg-danger text-white px-2.5 py-1 rounded-pill font-monospace">
                Thùng rác (@Model.TrashPaged.TotalItems)
            </span>
        </div>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-regular fa-trash-can text-danger"></i>
            <span>Nhân Sự Đã Xóa Mềm (Thùng Rác)</span>
        </h4>
        <p class="small text-muted mb-0 mt-1">Các tài khoản nhân sự bị xóa mềm vẫn được bảo toàn lịch sử giao dịch và có thể khôi phục lại bất kỳ lúc nào.</p>
    </div>
</div>

<!-- Filter box -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white dark:bg-slate-900 p-3">
    <form method="get" action="/Admin/User/Trash" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="Keyword" class="form-control" placeholder="Tìm theo tên, username, email, mã NV..." value="@Model.Filter.Keyword" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="DepartmentId" class="form-select form-select-sm rounded-3">
                <option value="">-- Tất cả phòng ban --</option>
                @foreach (var d in Model.ScopedDepartments)
                {
                    <option value="@d.Id" selected="@(Model.Filter.DepartmentId == d.Id ? "selected" : null)">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-semibold rounded-3">
                <i class="fa-solid fa-filter me-1"></i>Lọc thùng rác
            </button>
        </div>
        <div class="col-md-2">
            <a href="/Admin/User/Trash" class="btn btn-light btn-sm w-100 rounded-3">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Trash Table Container -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark:bg-slate-900">
    <partial name="_TrashTable" model="Model.TrashPaged" />
</div>

