@model Omnichannel.Application.DTOs.HR.StaffIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Nhân Sự & Phân Quyền";
    Layout = "_AdminLayout";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-1 d-flex align-items-center gap-2">
            <i class="fa-solid fa-users text-rose-600"></i>
            <span>Quản Lý Nhân Sự & Cơ Cấu Tổ Chức</span>
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small text-muted mb-0">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted">@Brand.DisplayName</a></li>
                <li class="breadcrumb-item active text-rose-600 fw-semibold" aria-current="page">Hồ Sơ Nhân Sự</li>
            </ol>
        </nav>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-permission="CUSTOMER_VIEW" href="/Admin/User/Customers" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3">
            <i class="fa-solid fa-user-tag me-1.5 text-indigo-500"></i>Tài Khoản Khách Hàng
        </a>

        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-file-export me-1 text-emerald-600"></i>Kết Xuất
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3">
                <li>
                    <a class="dropdown-item small" href="javascript:void(0)" onclick="triggerExport('xlsx')">
                        <i class="fa-solid fa-file-excel text-success me-2"></i>Xuất Excel (.xlsx)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item small" href="javascript:void(0)" onclick="triggerExport('csv')">
                        <i class="fa-solid fa-file-csv text-primary me-2"></i>Xuất CSV (UTF-8 BOM)
                    </a>
                </li>
            </ul>
        </div>

        <a asp-permission="USER_DELETE" href="/Admin/User/Trash" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold rounded-3 position-relative">
            <i class="fa-regular fa-trash-can me-1"></i>Thùng Rác
            @if (Model.Stats.TrashStaff > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @Model.Stats.TrashStaff
                </span>
            }
        </a>

        @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanCreateUser)
        {
            <a asp-permission="USER_CREATE" href="/Admin/User/Create" class="btn btn-primary-gradient btn-sm px-3 py-2 text-white fw-semibold rounded-3 shadow-xs">
                <i class="fa-solid fa-user-plus me-1"></i>Thêm Mới Nhân Sự
            </a>
        }
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Tổng Nhân Sự (Scope)</span>
                    <h3 class="fw-bolder mb-0 mt-1 text-slate-900 dark:text-white">@Model.Stats.TotalStaff</h3>
                </div>
                <div class="rounded-3 bg-rose-50 text-rose-600 p-2.5">
                    <i class="fa-solid fa-users fs-5"></i>
                </div>
            </div>
            <div class="small text-muted mt-2" style="font-size: 0.72rem;">Nhân sự nội bộ trong phạm vi quản lý</div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Đang Hoạt Động</span>
                    <h3 class="fw-bolder mb-0 mt-1 text-success">@Model.Stats.ActiveStaff</h3>
                </div>
                <div class="rounded-3 bg-success-subtle text-success p-2.5">
                    <i class="fa-solid fa-user-check fs-5"></i>
                </div>
            </div>
            <div class="small text-muted mt-2" style="font-size: 0.72rem;">Tài khoản đăng nhập bình thường</div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Đang Tạm Khóa</span>
                    <h3 class="fw-bolder mb-0 mt-1 text-danger">@Model.Stats.LockedStaff</h3>
                </div>
                <div class="rounded-3 bg-danger-subtle text-danger p-2.5">
                    <i class="fa-solid fa-user-lock fs-5"></i>
                </div>
            </div>
            <div class="small text-muted mt-2" style="font-size: 0.72rem;">Bị khóa tạm thời hoặc đình chỉ</div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white dark:bg-slate-900">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Nhân Sự Mới (30 Ngày)</span>
                    <h3 class="fw-bolder mb-0 mt-1 text-indigo-600">@Model.Stats.NewStaffLast30Days</h3>
                </div>
                <div class="rounded-3 bg-indigo-50 text-indigo-600 p-2.5">
                    <i class="fa-solid fa-user-plus fs-5"></i>
                </div>
            </div>
            <div class="small text-muted mt-2" style="font-size: 0.72rem;">Tuyển dụng hoặc cấp mới gần đây</div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white dark:bg-slate-900">
    <div class="card-body p-3">
        <form id="staffFilterForm" method="get" action="/Admin/User"
              hx-get="/Admin/User"
              hx-target="#staffTableContainer"
              hx-trigger="submit"
              hx-swap="innerHTML"
              class="row g-2 align-items-center">

            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light dark:bg-slate-800 border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="Keyword" class="form-control border-start-0"
                           placeholder="Họ tên, username, email, SĐT, mã NV..."
                           value="@Model.Filter.Keyword"
                           autocorrect="off" autocapitalize="off" spellcheck="false" />
                </div>
            </div>

            <div class="col-md-2">
                <select name="DepartmentId" class="form-select form-select-sm rounded-3">
                    <option value="">-- Tất cả phòng ban --</option>
                    @foreach (var d in Model.ScopedDepartments)
                    {
                        <option value="@d.Id" selected="@(Model.Filter.DepartmentId == d.Id ? "selected" : null)">@d.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="RoleId" class="form-select form-select-sm rounded-3">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var r in Model.AssignableRoles)
                    {
                        <option value="@r.Id" selected="@(Model.Filter.RoleId == r.Id ? "selected" : null)">@r.DisplayName (Lv@r.Level)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="Status" class="form-select form-select-sm rounded-3">
                    <option value="all" selected="@(Model.Filter.Status == "all" ? "selected" : null)">-- Trạng thái: Tất cả --</option>
                    <option value="active" selected="@(Model.Filter.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                    <option value="locked" selected="@(Model.Filter.Status == "locked" ? "selected" : null)">Đã tạm khóa</option>
                </select>
            </div>

            <div class="col-md-1">
                <select name="PageSize" class="form-select form-select-sm rounded-3" title="Số lượng mỗi trang">
                    <option value="10" selected="@(Model.Filter.PageSize == 10 ? "selected" : null)">10/trang</option>
                    <option value="20" selected="@(Model.Filter.PageSize == 20 ? "selected" : null)">20/trang</option>
                    <option value="50" selected="@(Model.Filter.PageSize == 50 ? "selected" : null)">50/trang</option>
                    <option value="100" selected="@(Model.Filter.PageSize == 100 ? "selected" : null)">100/trang</option>
                </select>
            </div>

            <input type="hidden" name="Page" id="staffPageInput" value="@Model.Filter.Page" />
            <input type="hidden" name="SortBy" value="@Model.Filter.SortBy" />
            <input type="hidden" name="SortDir" value="@Model.Filter.SortDir" />

            <div class="col-md-2 d-flex gap-1.5">
                <button type="submit" class="btn btn-primary-gradient btn-sm flex-grow-1 text-white fw-semibold rounded-3 shadow-xs">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a href="/Admin/User" class="btn btn-outline-secondary btn-sm px-2.5 rounded-3" title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bulk Action Toolbar (Floating Bar when checkboxes selected) -->
<div id="bulkActionBar" class="card border-0 shadow-sm rounded-4 mb-3 bg-rose-50 border border-rose-200 dark:bg-slate-800 p-3 d-none">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-rose-600 text-white px-2.5 py-1 rounded-pill" id="selectedStaffCountBadge">0</span>
            <span class="small fw-bold text-dark dark:text-white">nhân sự đang được chọn</span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanEditUser)
            {
                <button type="button" class="btn btn-sm btn-outline-success bg-white rounded-3 fw-semibold" onclick="executeBulkAction('unlock')">
                    <i class="fa-solid fa-lock-open me-1"></i>Mở Khóa
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning bg-white rounded-3 fw-semibold" onclick="executeBulkAction('lock')">
                    <i class="fa-solid fa-user-lock me-1"></i>Tạm Khóa
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary bg-white rounded-3 fw-semibold" onclick="openBulkAssignDeptModal()">
                    <i class="fa-solid fa-building-user me-1"></i>Chuyển Phòng Ban
                </button>
                <button type="button" class="btn btn-sm btn-outline-indigo bg-white rounded-3 fw-semibold" onclick="openBulkAssignRoleModal()">
                    <i class="fa-solid fa-id-badge me-1"></i>Gán Vai Trò
                </button>
            }
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanDeleteUser)
            {
                <button type="button" class="btn btn-sm btn-danger rounded-3 fw-semibold" onclick="executeBulkAction('delete')">
                    <i class="fa-regular fa-trash-can me-1"></i>Xóa Mềm Hàng Loạt
                </button>
            }
        </div>
    </div>
</div>

<!-- Staff Data Table Container (Rendered by partial for HTMX requests) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark:bg-slate-900">
    <div id="staffTableContainer">
        <partial name="_StaffTable" model="Model.StaffPaged" />
    </div>
</div>

<!-- Modal Đặt lại Mật Khẩu -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-amber-500 text-white border-0 rounded-top-4">
                <h6 class="modal-title fw-bold">
                    <i class="fa-solid fa-key me-2"></i>Đặt Lại Mật Khẩu Nhân Sự
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="reset_StaffId" />
                <p class="small text-muted mb-3">
                    Đang đặt lại mật khẩu cho tài khoản: <strong id="reset_StaffName" class="text-dark"></strong>
                </p>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Mật khẩu mới</label>
                    <div class="input-group">
                        <input type="text" id="reset_NewPasswordInput" class="form-control font-monospace" placeholder="Để trống nếu muốn hệ thống tự sinh mật khẩu ngẫu nhiên..." />
                        <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPasswordForModal()" title="Sinh mật khẩu mạnh">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </button>
                    </div>
                    <div class="form-text small" style="font-size: 0.72rem;">Mật khẩu tự sinh đạt độ phức tạp: hoa, thường, số, ký tự đặc biệt.</div>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="reset_RequireChangeCb" checked>
                    <label class="form-check-label small text-dark" for="reset_RequireChangeCb">Yêu cầu đổi mật khẩu ở lần đăng nhập kế tiếp</label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-amber text-white rounded-3 fw-semibold px-4" style="background:#d97706;" onclick="submitResetPassword()">
                    <i class="fa-solid fa-check me-1"></i>Xác Nhận Đổi
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chuyển Phòng Ban Hàng Loạt -->
<div class="modal fade" id="bulkDeptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h6 class="modal-title fw-bold">
                    <i class="fa-solid fa-building-user me-2"></i>Chuyển Phòng Ban Hàng Loạt
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <label class="form-label small fw-bold text-dark">Chọn phòng ban đích</label>
                <select id="bulkTargetDeptSelect" class="form-select rounded-3">
                    <option value="">-- Chọn phòng ban --</option>
                    @foreach (var d in Model.ScopedDepartments)
                    {
                        <option value="@d.Id">@d.Name (@d.Code)</option>
                    }
                </select>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 fw-semibold px-4" onclick="confirmBulkAssignDepartment()">
                    <i class="fa-solid fa-check me-1"></i>Áp Dụng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Gán Vai Trò Hàng Loạt -->
<div class="modal fade" id="bulkRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-indigo-600 text-white border-0 rounded-top-4" style="background:#4f46e5;">
                <h6 class="modal-title fw-bold">
                    <i class="fa-solid fa-id-badge me-2"></i>Gán Thêm Vai Trò Hàng Loạt
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <label class="form-label small fw-bold text-dark">Chọn vai trò cần gán</label>
                <select id="bulkTargetRoleSelect" class="form-select rounded-3">
                    <option value="">-- Chọn vai trò --</option>
                    @foreach (var r in Model.AssignableRoles)
                    {
                        <option value="@r.Id">@r.DisplayName (Cấp bậc: Lv@r.Level)</option>
                    }
                </select>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-indigo text-white rounded-3 fw-semibold px-4" style="background:#4f46e5;" onclick="confirmBulkAssignRole()">
                    <i class="fa-solid fa-check me-1"></i>Gán Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let resetPasswordModalInstance = null;
        let bulkDeptModalInstance = null;
        let bulkRoleModalInstance = null;

        function goToStaffPage(page) {
            document.getElementById('staffPageInput').value = page;
            const form = document.getElementById('staffFilterForm');
            if (window.htmx) {
                htmx.trigger(form, 'submit');
            } else {
                form.submit();
            }
        }

        function triggerExport(format) {
            const form = document.getElementById('staffFilterForm');
            const params = new URLSearchParams(new FormData(form));
            params.set('format', format);
            window.location.href = '/Admin/User/Export?' + params.toString();
        }

        function toggleSelectAllStaff(checked) {
            document.querySelectorAll('.staff-select-cb').forEach(cb => cb.checked = checked);
            updateBulkActionToolbar();
        }

        function updateBulkActionToolbar() {
            const selected = Array.from(document.querySelectorAll('.staff-select-cb:checked')).map(cb => parseInt(cb.value, 10));
            const bar = document.getElementById('bulkActionBar');
            const badge = document.getElementById('selectedStaffCountBadge');
            badge.textContent = selected.length;

            if (selected.length > 0) {
                bar.classList.remove('d-none');
            } else {
                bar.classList.add('d-none');
                const allCb = document.getElementById('selectAllStaffCb');
                if (allCb) allCb.checked = false;
            }
        }

        function getSelectedStaffIds() {
            return Array.from(document.querySelectorAll('.staff-select-cb:checked')).map(cb => parseInt(cb.value, 10));
        }

        async function executeBulkAction(action) {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;

            let actionName = action === 'delete' ? 'xóa mềm (vào thùng rác)' : (action === 'lock' ? 'tạm khóa' : 'mở khóa');
            const confirmRes = await Swal.fire({
                title: `Xác nhận ${actionName} ${ids.length} nhân sự?`,
                icon: action === 'delete' ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: action === 'delete' ? '#dc2626' : '#e11d48',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });
            if (!confirmRes.isConfirmed) return;

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: action,
                staffIds: ids
            });

            if (res && res.success) {
                window.showAdminToast(res.message || 'Thao tác hàng loạt thành công.', 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openBulkAssignDeptModal() {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;
            if (!bulkDeptModalInstance) bulkDeptModalInstance = new bootstrap.Modal(document.getElementById('bulkDeptModal'));
            bulkDeptModalInstance.show();
        }

        async function confirmBulkAssignDepartment() {
            const deptId = parseInt(document.getElementById('bulkTargetDeptSelect').value, 10);
            if (!deptId) {
                window.showAdminToast('Vui lòng chọn phòng ban cần chuyển đến!', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkDeptModalInstance) bulkDeptModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assigndepartment',
                staffIds: ids,
                targetDepartmentId: deptId
            });

            if (res && res.success) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openBulkAssignRoleModal() {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;
            if (!bulkRoleModalInstance) bulkRoleModalInstance = new bootstrap.Modal(document.getElementById('bulkRoleModal'));
            bulkRoleModalInstance.show();
        }

        async function confirmBulkAssignRole() {
            const roleId = parseInt(document.getElementById('bulkTargetRoleSelect').value, 10);
            if (!roleId) {
                window.showAdminToast('Vui lòng chọn vai trò cần gán!', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkRoleModalInstance) bulkRoleModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assignrole',
                staffIds: ids,
                targetRoleId: roleId
            });

            if (res && res.success) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openResetPasswordModal(staffId, fullName, username) {
            document.getElementById('reset_StaffId').value = staffId;
            document.getElementById('reset_StaffName').textContent = `${fullName} (\x40${username})`;
            document.getElementById('reset_NewPasswordInput').value = '';
            if (!resetPasswordModalInstance) resetPasswordModalInstance = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            resetPasswordModalInstance.show();
        }

        function generateRandomPasswordForModal() {
            const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!#$%&*+';
            let pwd = 'Canmake2026!';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('reset_NewPasswordInput').value = pwd;
        }

        async function submitResetPassword() {
            const staffId = parseInt(document.getElementById('reset_StaffId').value, 10);
            const newPassword = (document.getElementById('reset_NewPasswordInput').value || '').trim();
            const requireChange = document.getElementById('reset_RequireChangeCb').checked;

            if (resetPasswordModalInstance) resetPasswordModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/ResetPassword', {
                staffId: staffId,
                newPassword: newPassword,
                requireChangeOnLogin: requireChange
            });

            if (res && res.succeeded) {
                await Swal.fire({
                    title: 'Mật Khẩu Mới Đã Tạo!',
                    html: `<p>Mật khẩu mới của nhân sự là: <strong class="text-rose-600 font-monospace fs-5">${res.data}</strong></p><p class="small text-muted">Vui lòng sao chép và gửi cho nhân sự bảo mật.</p>`,
                    icon: 'success',
                    confirmButtonText: 'Đã sao chép'
                });
            }
        }

        async function confirmDeleteStaff(staffId, fullName, username) {
            const confirmRes = await Swal.fire({
                title: `Xác nhận xóa nhân sự?`,
                html: `Bạn có chắc chắn muốn đưa nhân sự <strong>${fullName}</strong> (<em>@@${username}</em>) vào thùng rác? Dữ liệu lịch sử giao dịch và đơn hàng vẫn được giữ nguyên.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Xóa mềm ngay',
                cancelButtonText: 'Hủy'
            });

            if (!confirmRes.isConfirmed) return;

            const res = await window.adminJsonRequest(`/Admin/User/Delete/${staffId}`, null, 'POST');
            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }
    </script>
}
