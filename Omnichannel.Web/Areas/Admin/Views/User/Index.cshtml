                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 fw-semibold px-4" onclick="confirmBulkAssignDepartment()">
                    <i class="fa-solid fa-check me-1"></i>Áp Dụng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Gán Vai Trò Hàng Loạt -->
<div class="modal fade" id="bulkRoleModal" tabindex="-1" aria-labelledby="bulkRoleModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header text-white border-0 rounded-top-4" style="background:#4f46e5;">
                <h5 class="modal-title h6 fw-bold mb-0" id="bulkRoleModalTitle">
                    <i class="fa-solid fa-id-badge me-2"></i>Gán Vai Trò Hàng Loạt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <label for="bulkTargetRoleSelect" class="form-label small fw-bold text-dark dark:text-white">Chọn vai trò cần gán</label>
                <select id="bulkTargetRoleSelect" class="form-select rounded-3">
                    <option value="">-- Chọn vai trò --</option>
                    @foreach (var r in Model.AssignableRoles)
                    {
                        <option value="@r.Id">@r.DisplayName (Cấp bậc: Lv@r.Level)</option>
                    }
                </select>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn text-white rounded-3 fw-semibold px-4" style="background:#4f46e5;" onclick="confirmBulkAssignRole()">
                    <i class="fa-solid fa-check me-1"></i>Gán Ngay
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let resetPasswordModalInstance = null;
        let bulkDeptModalInstance = null;
        let bulkRoleModalInstance = null;
        let filterDebounceTimer = null;

        function debouncedFilterSubmit() {
            clearTimeout(filterDebounceTimer);
            filterDebounceTimer = setTimeout(() => {
                submitStaffFilterForm();
            }, 400);
        }

        function resetPageBeforeSubmit() {
            renderActiveFilterChips();
        }

        function submitStaffFilterForm(resetPage = true) {
            if (resetPage) {
                document.getElementById('staffPageInput').value = 1;
            }
            renderActiveFilterChips();
            const form = document.getElementById('staffFilterForm');
            if (window.htmx) {
                htmx.trigger(form, 'submit');
            } else {
                form.submit();
            }
        }

        function goToStaffPage(page) {
            document.getElementById('staffPageInput').value = page;
            submitStaffFilterForm(false);
        }

        function changeStaffPageSize(size) {
            document.getElementById('staffPageSizeInput').value = size;
            submitStaffFilterForm(true);
        }

        function sortStaffBy(column) {
            const sortByInput = document.getElementById('staffSortByInput');
            const sortDirInput = document.getElementById('staffSortDirInput');
            if (sortByInput.value.toLowerCase() === column.toLowerCase()) {
                sortDirInput.value = sortDirInput.value.toLowerCase() === 'asc' ? 'desc' : 'asc';
            } else {
                sortByInput.value = column;
                sortDirInput.value = 'asc';
            }
            submitStaffFilterForm(false);
        }

        function switchStaffViewMode(mode) {
            document.getElementById('staffViewModeInput').value = mode;
            ['Table', 'Card', 'Dept'].forEach(k => {
                const btn = document.getElementById('btnView' + k);
                if (!btn) return;
                const target = k === 'Dept' ? 'department' : k.toLowerCase();
                if (target === mode) {
                    btn.className = 'btn btn-dark text-white';
                } else {
                    btn.className = 'btn btn-outline-secondary';
                }
            });
            submitStaffFilterForm(false);
        }

        function applyKpiQuickFilter(type) {
            const statusSelect = document.getElementById('filterStatusSelect');
            const createdFromInput = document.getElementById('filterCreatedFromInput');

            if (type === 'all') {
                statusSelect.value = 'all';
                createdFromInput.value = '';
            } else if (type === 'active') {
                statusSelect.value = 'active';
                createdFromInput.value = '';
            } else if (type === 'locked') {
                statusSelect.value = 'locked';
                createdFromInput.value = '';
            } else if (type === 'new30d') {
                statusSelect.value = 'all';
                const d = new Date();
                d.setDate(d.getDate() - 30);
                createdFromInput.value = d.toISOString().split('T')[0];
            }
            submitStaffFilterForm(true);
        }

        function resetAllStaffFilters() {
            document.getElementById('filterKeywordInput').value = '';
            document.getElementById('filterDepartmentIdSelect').value = '';
            document.getElementById('filterRoleIdSelect').value = '';
            document.getElementById('filterStatusSelect').value = 'all';
            document.getElementById('filterStoreIdSelect').value = '';
            document.getElementById('filterManagerIdSelect').value = '';
            document.getElementById('filterGenderSelect').value = '';
            document.getElementById('filterHireFromInput').value = '';
            document.getElementById('filterHireToInput').value = '';
            document.getElementById('filterCreatedFromInput').value = '';
            submitStaffFilterForm(true);
        }

        function clearSingleFilter(fieldId, defaultVal = '') {
            const el = document.getElementById(fieldId);
            if (el) {
                el.value = defaultVal;
                submitStaffFilterForm(true);
            }
        }

        function renderActiveFilterChips() {
            const list = document.getElementById('activeFilterChipsList');
            const bar = document.getElementById('activeFilterChipsBar');
            if (!list || !bar) return;

            list.innerHTML = '';
            const chips = [];

            const kw = document.getElementById('filterKeywordInput').value.trim();
            if (kw) chips.push({ label: `Từ khóa: "${kw}"`, id: 'filterKeywordInput', def: '' });

            const deptSel = document.getElementById('filterDepartmentIdSelect');
            if (deptSel.value) {
                const txt = deptSel.options[deptSel.selectedIndex]?.getAttribute('data-label') || deptSel.options[deptSel.selectedIndex]?.text;
                chips.push({ label: `Phòng: ${txt.trim()}`, id: 'filterDepartmentIdSelect', def: '' });
            }

            const roleSel = document.getElementById('filterRoleIdSelect');
            if (roleSel.value) {
                const txt = roleSel.options[roleSel.selectedIndex]?.getAttribute('data-label') || roleSel.options[roleSel.selectedIndex]?.text;
                chips.push({ label: `Vai trò: ${txt.trim()}`, id: 'filterRoleIdSelect', def: '' });
            }

            const statusSel = document.getElementById('filterStatusSelect');
            if (statusSel.value && statusSel.value !== 'all') {
                chips.push({ label: `Trạng thái: ${statusSel.value === 'active' ? 'Đang hoạt động' : 'Đang khóa'}`, id: 'filterStatusSelect', def: 'all' });
            }

            const storeSel = document.getElementById('filterStoreIdSelect');
            if (storeSel.value) {
                const txt = storeSel.options[storeSel.selectedIndex]?.getAttribute('data-label') || storeSel.options[storeSel.selectedIndex]?.text;
                chips.push({ label: `Chi nhánh: ${txt.trim()}`, id: 'filterStoreIdSelect', def: '' });
            }

            const mgrSel = document.getElementById('filterManagerIdSelect');
            if (mgrSel.value) {
                const txt = mgrSel.options[mgrSel.selectedIndex]?.getAttribute('data-label') || mgrSel.options[mgrSel.selectedIndex]?.text;
                chips.push({ label: `Quản lý: ${txt.trim()}`, id: 'filterManagerIdSelect', def: '' });
            }

            const genderSel = document.getElementById('filterGenderSelect');
            if (genderSel.value) {
                chips.push({ label: `Giới tính: ${genderSel.value}`, id: 'filterGenderSelect', def: '' });
            }

            const hireFrom = document.getElementById('filterHireFromInput').value;
            if (hireFrom) chips.push({ label: `Vào làm từ: ${hireFrom}`, id: 'filterHireFromInput', def: '' });

            const hireTo = document.getElementById('filterHireToInput').value;
            if (hireTo) chips.push({ label: `Vào làm đến: ${hireTo}`, id: 'filterHireToInput', def: '' });

            const createdFrom = document.getElementById('filterCreatedFromInput').value;
            if (createdFrom) chips.push({ label: `Tạo từ: ${createdFrom}`, id: 'filterCreatedFromInput', def: '' });

            if (chips.length === 0) {
                bar.classList.add('d-none');
                return;
            }

            bar.classList.remove('d-none');
            chips.forEach(c => {
                const span = document.createElement('span');
                span.className = 'badge bg-rose-50 text-rose-700 border border-rose-200 px-2.5 py-1 rounded-pill d-inline-flex align-items-center gap-1.5 fw-semibold';
                span.style.fontSize = '0.72rem';
                span.style.background = '#fff1f2';
                span.style.color = '#be123c';
                span.innerHTML = `<span>${c.label}</span><button type="button" class="btn-close" style="font-size: 0.5rem;" aria-label="Xóa lọc" onclick="clearSingleFilter('${c.id}', '${c.def}')"></button>`;
                list.appendChild(span);
            });
        }

        function copyToClipboard(text, label) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                window.showAdminToast(`Đã sao chép ${label}: ${text}`, 'success');
            });
        }

        function triggerExport(format) {
            const form = document.getElementById('staffFilterForm');
            const params = new URLSearchParams(new FormData(form));
            params.set('format', format);
            window.location.href = '/Admin/User/Export?' + params.toString();
        }

        function exportSelectedStaffRows(format) {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;
            const params = new URLSearchParams();
            params.set('format', format || 'xlsx');
            params.set('Ids', ids.join(','));
            window.location.href = '/Admin/User/Export?' + params.toString();
        }

        function toggleSelectAllStaff(checked) {
            document.querySelectorAll('.staff-select-cb').forEach(cb => cb.checked = checked);
            updateBulkActionToolbar();
        }

        function updateBulkActionToolbar() {
            const selected = getSelectedStaffIds();
            const bar = document.getElementById('bulkActionBar');
            const badge = document.getElementById('selectedStaffCountBadge');
            if (badge) badge.textContent = selected.length;

            if (selected.length > 0) {
                bar.classList.remove('d-none');
            } else {
                bar.classList.add('d-none');
                const allCb = document.getElementById('selectAllStaffCb');
                if (allCb) allCb.checked = false;
            }
        }

        function getSelectedStaffIds() {
            return Array.from(document.querySelectorAll('.staff-select-cb:checked')).map(cb => parseInt(cb.value, 10));
        }

        async function quickToggleStaffStatus(staffId, fullName, currentlyActive, switchEl = null) {
            const actionText = currentlyActive ? 'tạm khóa' : 'mở khóa';
            const confirmRes = await Swal.fire({
                title: `Xác nhận ${actionText} tài khoản?`,
                html: `Bạn có chắc chắn muốn <strong>${actionText}</strong> tài khoản nhân sự <strong>${fullName}</strong>?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: currentlyActive ? '#d97706' : '#059669',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });

            if (!confirmRes.isConfirmed) {
                if (switchEl) switchEl.checked = currentlyActive;
                return;
            }

            const res = await window.adminJsonRequest(`/Admin/User/ToggleStatus/${staffId}`, null, 'POST');
            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                submitStaffFilterForm(false);
            } else if (switchEl) {
                switchEl.checked = currentlyActive;
            }
        }

        async function executeBulkAction(action) {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;

            let actionName = action === 'delete' ? 'xóa mềm (chuyển vào thùng rác)' : (action === 'lock' ? 'tạm khóa' : 'mở khóa');
            const confirmRes = await Swal.fire({
                title: `Xác nhận ${actionName} ${ids.length} nhân sự?`,
                text: 'Các tài khoản ngoài phạm vi hoặc Trưởng phòng sẽ tự động được bảo vệ.',
                icon: action === 'delete' ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: action === 'delete' ? '#dc2626' : '#e11d48',
                confirmButtonText: 'Xác nhận thực hiện',
                cancelButtonText: 'Hủy'
            });
            if (!confirmRes.isConfirmed) return;

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: action,
                staffIds: ids
            });

            if (res && res.success) {
                window.showAdminToast(res.message || 'Thao tác hàng loạt thành công.', 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openBulkAssignDeptModal() {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;
            if (!bulkDeptModalInstance) bulkDeptModalInstance = new bootstrap.Modal(document.getElementById('bulkDeptModal'));
            bulkDeptModalInstance.show();
        }

        async function confirmBulkAssignDepartment() {
            const deptId = parseInt(document.getElementById('bulkTargetDeptSelect').value, 10);
            if (!deptId) {
                window.showAdminToast('Vui lòng chọn phòng ban cần chuyển đến!', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkDeptModalInstance) bulkDeptModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assigndepartment',
                staffIds: ids,
                targetDepartmentId: deptId
            });

            if (res && res.success) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openBulkAssignRoleModal() {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;
            if (!bulkRoleModalInstance) bulkRoleModalInstance = new bootstrap.Modal(document.getElementById('bulkRoleModal'));
            bulkRoleModalInstance.show();
        }

        async function confirmBulkAssignRole() {
            const roleId = parseInt(document.getElementById('bulkTargetRoleSelect').value, 10);
            if (!roleId) {
                window.showAdminToast('Vui lòng chọn vai trò cần gán!', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkRoleModalInstance) bulkRoleModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assignrole',
                staffIds: ids,
                targetRoleId: roleId
            });

            if (res && res.success) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openResetPasswordModal(staffId, fullName, username) {
            document.getElementById('reset_StaffId').value = staffId;
            document.getElementById('reset_StaffName').textContent = `${fullName} (\x40${username})`;
            document.getElementById('reset_NewPasswordInput').value = '';
            if (!resetPasswordModalInstance) resetPasswordModalInstance = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            resetPasswordModalInstance.show();
        }

        function generateRandomPasswordForModal() {
            const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!#$%&*+';
            let pwd = 'Canmake2026!';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('reset_NewPasswordInput').value = pwd;
        }

        async function submitResetPassword() {
            const staffId = parseInt(document.getElementById('reset_StaffId').value, 10);
            const newPassword = (document.getElementById('reset_NewPasswordInput').value || '').trim();
            const requireChange = document.getElementById('reset_RequireChangeCb').checked;

            if (resetPasswordModalInstance) resetPasswordModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/ResetPassword', {
                staffId: staffId,
                newPassword: newPassword,
                requireChangeOnLogin: requireChange
            });

            if (res && res.succeeded) {
                const tempPwd = res.data;
                const modalRes = await Swal.fire({
                    title: 'Mật Khẩu Tạm Đã Cấp!',
                    html: `
                        <p class="small text-muted mb-2">Mật khẩu tạm chỉ hiển thị <strong>1 lần duy nhất</strong>:</p>
                        <div class="p-3 rounded-3 bg-slate-100 border font-monospace fs-5 fw-bold text-rose-600 mb-2">${tempPwd}</div>
                        <p class="small text-muted mb-0">Bấm nút bên dưới để sao chép và gửi bảo mật cho nhân sự.</p>
                    `,
                    icon: 'success',
                    confirmButtonColor: '#e11d48',
                    confirmButtonText: '<i class="fa-regular fa-copy me-1"></i>Sao chép mật khẩu'
                });
                if (modalRes.isConfirmed && navigator.clipboard) {
                    navigator.clipboard.writeText(tempPwd);
                    window.showAdminToast('Đã sao chép mật khẩu tạm vào bộ nhớ tạm!', 'success');
                }
            }
        }

        async function confirmDeleteStaff(staffId, fullName, username) {
            const confirmRes = await Swal.fire({
                title: 'Xác nhận xóa mềm nhân sự?',
                html: `Đưa hồ sơ <strong>${fullName}</strong> (<code>\x40${username}</code>) vào thùng rác?<br/><span class="small text-muted">Toàn bộ lịch sử đơn hàng và kiểm toán vẫn được bảo toàn.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Đưa vào thùng rác',
                cancelButtonText: 'Hủy'
            });

            if (!confirmRes.isConfirmed) return;

            const res = await window.adminJsonRequest(`/Admin/User/Delete/${staffId}`, null, 'POST');
            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderActiveFilterChips();
        });
    </script>
}
