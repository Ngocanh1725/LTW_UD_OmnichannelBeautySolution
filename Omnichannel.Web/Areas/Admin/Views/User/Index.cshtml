@model Omnichannel.Application.DTOs.HR.StaffIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Nhân Sự & Cơ Cấu Tổ Chức";
    Layout = "_AdminLayout";
    string currentViewMode = (Model.Filter.ViewMode ?? "table").ToLowerInvariant();
    bool hasAdvancedFilter = !string.IsNullOrEmpty(Model.Filter.Gender)
        || Model.Filter.HireFrom.HasValue
        || Model.Filter.HireTo.HasValue
        || Model.Filter.CreatedFrom.HasValue
        || Model.Filter.CreatedTo.HasValue
        || Model.Filter.StoreId.HasValue
        || Model.Filter.ManagerId.HasValue;
}

<style>
    .hr-sticky-filter {
        position: sticky;
        top: 64px;
        z-index: 25;
        backdrop-filter: blur(10px);
    }
    .kpi-card-interactive {
        cursor: pointer;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .kpi-card-interactive:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -4px rgba(225, 29, 72, 0.12) !important;
        border-color: #fda4af !important;
    }
    .htmx-indicator-skeleton {
        display: none;
    }
    .htmx-request .htmx-indicator-skeleton {
        display: block;
    }
    .htmx-request #staffTableContent {
        opacity: 0.35;
        pointer-events: none;
        transition: opacity 0.2s ease;
    }
    .skeleton-line {
        height: 14px;
        border-radius: 6px;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: hrSkeletonShimmer 1.4s infinite;
    }
    @@keyframes hrSkeletonShimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

<!-- 1. Page Header & Action Buttons -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small text-muted mb-1">
                <li class="breadcrumb-item">
                    <a href="/Admin/Dashboard" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-house-chimney me-1"></i>@Brand.DisplayName
                    </a>
                </li>
                <li class="breadcrumb-item">Hệ Thống & Nhân Sự</li>
                <li class="breadcrumb-item active text-rose-600 fw-semibold" aria-current="page">Quản Lý Nhân Sự</li>
            </ol>
        </nav>
        <h1 class="h4 fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <span class="rounded-3 bg-rose-50 text-rose-600 p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="fa-solid fa-users-gear"></i>
            </span>
            <span>Quản Lý Nhân Sự</span>
        </h1>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a asp-any-permission="DEPARTMENT_VIEW,DEPARTMENT_MANAGE" href="/Admin/Department"
           class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3 bg-white dark:bg-slate-800">
            <i class="fa-solid fa-sitemap me-1.5 text-indigo-600"></i>Sơ Đồ Tổ Chức
        </a>

        <div class="dropdown" asp-permission="USER_EXPORT">
            <button class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3 dropdown-toggle bg-white dark:bg-slate-800"
                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-file-excel me-1.5 text-emerald-600"></i>Xuất Excel
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 small py-1.5">
                <li>
                    <button type="button" class="dropdown-item py-1.5" onclick="triggerExport('xlsx')">
                        <i class="fa-solid fa-file-excel text-success me-2"></i>Xuất Excel (.xlsx) theo bộ lọc
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item py-1.5" onclick="triggerExport('csv')">
                        <i class="fa-solid fa-file-csv text-primary me-2"></i>Xuất CSV (UTF-8 BOM)
                    </button>
                </li>
            </ul>
        </div>

        @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanDeleteUser)
        {
            <a asp-permission="USER_DELETE" href="/Admin/User/Trash"
               class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold rounded-3 position-relative bg-white dark:bg-slate-800">
                <i class="fa-regular fa-trash-can me-1.5"></i>Thùng Rác
                @if (Model.Stats.TrashStaff > 0)
                {
                    <span class="badge rounded-pill bg-danger ms-1">@Model.Stats.TrashStaff</span>
                }
            </a>
        }

        @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanCreateUser)
        {
            <a asp-permission="USER_CREATE" href="/Admin/User/Create"
               class="btn btn-primary-gradient btn-sm px-3.5 py-2 text-white fw-semibold rounded-3 shadow-xs">
                <i class="fa-solid fa-plus me-1.5"></i>Thêm nhân sự
            </a>
        }
    </div>
</div>

<!-- 2. Navigation Tabs: Nhân sự nội bộ vs Tài khoản khách hàng -->
<div class="border-bottom border-slate-200 dark:border-slate-800 mb-4">
    <ul class="nav nav-tabs border-0 gap-2" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active fw-bold border-0 border-bottom border-3 border-rose-600 text-rose-600 bg-transparent px-3 py-2.5 d-flex align-items-center gap-2"
               href="/Admin/User" aria-current="page">
                <i class="fa-solid fa-user-shield"></i>
                <span>Nhân sự nội bộ</span>
                <span class="badge rounded-pill bg-rose-100 text-rose-700 px-2 py-0.5" style="font-size: 0.72rem;">@Model.Stats.TotalStaff</span>
            </a>
        </li>
        <li class="nav-item" role="presentation" asp-permission="CUSTOMER_VIEW">
            <a class="nav-link fw-semibold border-0 text-muted hover:text-dark bg-transparent px-3 py-2.5 d-flex align-items-center gap-2"
               href="/Admin/User/Customers">
                <i class="fa-solid fa-users-viewfinder text-indigo-500"></i>
                <span>Tài khoản khách hàng</span>
                <span class="badge rounded-pill bg-slate-100 text-slate-700 px-2 py-0.5" style="font-size: 0.72rem;">@Model.Stats.TotalCustomers</span>
            </a>
        </li>
    </ul>
</div>

<!-- 3. 6 Thẻ KPI (Click thẻ = Áp bộ lọc tương ứng) -->
<div class="row g-2.5 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="applyKpiQuickFilter('all')" role="button" tabindex="0" aria-label="Lọc tổng nhân sự">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Tổng Nhân Sự</span>
                <span class="rounded-3 bg-rose-50 text-rose-600 p-1.5 px-2"><i class="fa-solid fa-users"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1 text-slate-900 dark:text-white">@Model.Stats.TotalStaff</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Bấm để xem tất cả</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="applyKpiQuickFilter('active')" role="button" tabindex="0" aria-label="Lọc nhân sự đang hoạt động">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Đang Hoạt Động</span>
                <span class="rounded-3 bg-success-subtle text-success p-1.5 px-2"><i class="fa-solid fa-user-check"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1 text-success">@Model.Stats.ActiveStaff</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Lọc tài khoản Active</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="applyKpiQuickFilter('locked')" role="button" tabindex="0" aria-label="Lọc nhân sự đang khóa">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Đang Khóa</span>
                <span class="rounded-3 bg-danger-subtle text-danger p-1.5 px-2"><i class="fa-solid fa-user-lock"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1 text-danger">@Model.Stats.LockedStaff</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Lọc tài khoản bị khóa</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="applyKpiQuickFilter('new30d')" role="button" tabindex="0" aria-label="Lọc nhân sự mới 30 ngày">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Mới 30 Ngày</span>
                <span class="rounded-3 bg-indigo-50 text-indigo-600 p-1.5 px-2"><i class="fa-solid fa-user-plus"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1 text-indigo-600">@Model.Stats.NewStaffLast30Days</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Tuyển mới 30 ngày qua</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="switchStaffViewMode('department')" role="button" tabindex="0" aria-label="Xem nhóm theo phòng ban">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Số Phòng Ban</span>
                <span class="rounded-3 bg-amber-50 text-amber-600 p-1.5 px-2" style="background:#fffbeb;color:#d97706;"><i class="fa-solid fa-building-user"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1 text-amber-600" style="color:#d97706;">@Model.Stats.DepartmentCount</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Nhóm theo phòng ban</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 p-3 bg-white dark:bg-slate-900 kpi-card-interactive"
             onclick="document.getElementById('filterRoleIdSelect').focus()" role="button" tabindex="0" aria-label="Số admin quản trị">
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-semibold text-uppercase" style="font-size: 0.68rem;">Admin Quản Trị</span>
                <span class="rounded-3 bg-purple-50 text-purple-600 p-1.5 px-2" style="background:#f5f3ff;color:#7c3aed;"><i class="fa-solid fa-user-tie"></i></span>
            </div>
            <div class="h4 fw-bolder mb-0 mt-1" style="color:#7c3aed;">@Model.Stats.AdminCount</div>
            <div class="text-muted mt-1" style="font-size: 0.68rem;">Cấp quản lý (Lv ≥ 50)</div>
        </div>
    </div>
</div>

<!-- 4. Thanh Lọc Sticky + Bộ Lọc Nâng Cao + Chips + Chế Độ Xem -->
<div class="card border border-slate-200/90 dark:border-slate-800 shadow-sm rounded-4 mb-3 bg-white/95 dark:bg-slate-900/95 hr-sticky-filter">
    <div class="card-body p-3">
        <form id="staffFilterForm" method="get" action="/Admin/User"
              hx-get="/Admin/User"
              hx-target="#staffTableContent"
              hx-push-url="true"
              hx-swap="innerHTML show:no-scroll"
              onsubmit="resetPageBeforeSubmit()">

            <div class="row g-2 align-items-center">
                <!-- Tìm kiếm Debounce 400ms -->
                <div class="col-12 col-md-4 col-xl-3">
                    <label for="filterKeywordInput" class="visually-hidden">Tìm kiếm nhân sự</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light dark:bg-slate-800 border-end-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" id="filterKeywordInput" name="Keyword" class="form-control border-start-0"
                               placeholder="Tìm tên, username, email, SĐT, mã NV..."
                               value="@Model.Filter.Keyword"
                               autocorrect="off" autocapitalize="off" spellcheck="false"
                               oninput="debouncedFilterSubmit()" />
                    </div>
                </div>

                <!-- Phòng ban (Dạng cây) -->
                <div class="col-6 col-md-3 col-xl-2">
                    <label for="filterDepartmentIdSelect" class="visually-hidden">Lọc theo phòng ban</label>
                    <select id="filterDepartmentIdSelect" name="DepartmentId" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                        <option value="">-- Phòng ban (Tất cả) --</option>
                        @foreach (var d in Model.ScopedDepartments)
                        {
                            <option value="@d.Id" data-label="@d.Name" selected="@(Model.Filter.DepartmentId == d.Id ? "selected" : null)">
                                @(string.IsNullOrEmpty(d.DisplayTreeName) ? d.Name : d.DisplayTreeName)
                            </option>
                        }
                    </select>
                </div>

                <!-- Vai trò -->
                <div class="col-6 col-md-3 col-xl-2">
                    <label for="filterRoleIdSelect" class="visually-hidden">Lọc theo vai trò</label>
                    <select id="filterRoleIdSelect" name="RoleId" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                        <option value="">-- Vai trò (Tất cả) --</option>
                        @foreach (var r in Model.AssignableRoles)
                        {
                            <option value="@r.Id" data-label="@r.DisplayName" selected="@(Model.Filter.RoleId == r.Id ? "selected" : null)">
                                @r.DisplayName (Lv@r.Level)
                            </option>
                        }
                    </select>
                </div>

                <!-- Trạng thái -->
                <div class="col-6 col-md-2 col-xl-2">
                    <label for="filterStatusSelect" class="visually-hidden">Lọc theo trạng thái</label>
                    <select id="filterStatusSelect" name="Status" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                        <option value="all" selected="@(Model.Filter.Status == "all" || string.IsNullOrEmpty(Model.Filter.Status) ? "selected" : null)">-- Mọi trạng thái --</option>
                        <option value="active" selected="@(Model.Filter.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                        <option value="locked" selected="@(Model.Filter.Status == "locked" ? "selected" : null)">Đang khóa</option>
                    </select>
                </div>

                <!-- Nút Bộ lọc nâng cao & Chế độ xem -->
                <div class="col-6 col-md-12 col-xl-3 d-flex align-items-center justify-content-end gap-1.5">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-3 px-2.5 py-1 fw-semibold"
                            data-bs-toggle="collapse" data-bs-target="#advancedFilterCollapse"
                            aria-expanded="@(hasAdvancedFilter ? "true" : "false")" aria-controls="advancedFilterCollapse">
                        <i class="fa-solid fa-sliders me-1 text-rose-600"></i>Nâng cao
                    </button>

                    <!-- View Mode Switcher: Bảng | Thẻ | Phòng ban -->
                    <div class="btn-group btn-group-sm" role="group" aria-label="Chế độ hiển thị danh sách">
                        <button type="button" id="btnViewTable"
                                class="btn @(currentViewMode == "table" ? "btn-dark text-white" : "btn-outline-secondary")"
                                onclick="switchStaffViewMode('table')" title="Chế độ Bảng">
                            <i class="fa-solid fa-table-list"></i>
                        </button>
                        <button type="button" id="btnViewCard"
                                class="btn @(currentViewMode == "card" ? "btn-dark text-white" : "btn-outline-secondary")"
                                onclick="switchStaffViewMode('card')" title="Chế độ Thẻ (Card)">
                            <i class="fa-solid fa-grip"></i>
                        </button>
                        <button type="button" id="btnViewDept"
                                class="btn @(currentViewMode == "department" ? "btn-dark text-white" : "btn-outline-secondary")"
                                onclick="switchStaffViewMode('department')" title="Nhóm theo Phòng ban">
                            <i class="fa-solid fa-layer-group"></i>
                        </button>
                    </div>

                    <button type="submit" class="btn btn-primary-gradient btn-sm px-2.5 py-1 text-white fw-semibold rounded-3" title="Áp dụng lọc">
                        <i class="fa-solid fa-check"></i>
                    </button>
                </div>
            </div>

            <!-- Khối Bộ lọc nâng cao (Collapse) -->
            <div class="collapse @(hasAdvancedFilter ? "show" : "") mt-2.5 pt-2.5 border-top" id="advancedFilterCollapse">
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3 col-xl-2">
                        <label for="filterStoreIdSelect" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Chi nhánh làm việc</label>
                        <select id="filterStoreIdSelect" name="StoreId" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                            <option value="">-- Tất cả chi nhánh --</option>
                            @foreach (var s in Model.ScopedStores)
                            {
                                <option value="@s.Id" data-label="@s.Name" selected="@(Model.Filter.StoreId == s.Id ? "selected" : null)">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-3 col-xl-2">
                        <label for="filterManagerIdSelect" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Người quản lý trực tiếp</label>
                        <select id="filterManagerIdSelect" name="ManagerId" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                            <option value="">-- Tất cả quản lý --</option>
                            @foreach (var m in Model.PotentialManagers)
                            {
                                <option value="@m.Id" data-label="@m.FullName" selected="@(Model.Filter.ManagerId == m.Id ? "selected" : null)">@m.FullName (@@@m.Username)</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-md-2 col-xl-2">
                        <label for="filterGenderSelect" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Giới tính</label>
                        <select id="filterGenderSelect" name="Gender" class="form-select form-select-sm rounded-3" onchange="submitStaffFilterForm()">
                            <option value="">-- Tất cả --</option>
                            <option value="Nam" selected="@(Model.Filter.Gender == "Nam" ? "selected" : null)">Nam</option>
                            <option value="Nữ" selected="@(Model.Filter.Gender == "Nữ" ? "selected" : null)">Nữ</option>
                            <option value="Khác" selected="@(Model.Filter.Gender == "Khác" ? "selected" : null)">Khác</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2 col-xl-2">
                        <label for="filterHireFromInput" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Vào làm từ ngày</label>
                        <input type="date" id="filterHireFromInput" name="HireFrom" class="form-control form-control-sm rounded-3"
                               value="@(Model.Filter.HireFrom?.ToString("yyyy-MM-dd"))" onchange="submitStaffFilterForm()" />
                    </div>

                    <div class="col-6 col-md-2 col-xl-2">
                        <label for="filterHireToInput" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Đến ngày</label>
                        <input type="date" id="filterHireToInput" name="HireTo" class="form-control form-control-sm rounded-3"
                               value="@(Model.Filter.HireTo?.ToString("yyyy-MM-dd"))" onchange="submitStaffFilterForm()" />
                    </div>

                    <div class="col-6 col-md-2 col-xl-2">
                        <label for="filterCreatedFromInput" class="form-label small text-muted mb-1" style="font-size: 0.72rem;">Tạo từ ngày</label>
                        <input type="date" id="filterCreatedFromInput" name="CreatedFrom" class="form-control form-control-sm rounded-3"
                               value="@(Model.Filter.CreatedFrom?.ToString("yyyy-MM-dd"))" onchange="submitStaffFilterForm()" />
                    </div>
                </div>
            </div>

            <!-- Hidden state inputs -->
            <input type="hidden" name="Page" id="staffPageInput" value="@Model.Filter.Page" />
            <input type="hidden" name="PageSize" id="staffPageSizeInput" value="@Model.Filter.PageSize" />
            <input type="hidden" name="SortBy" id="staffSortByInput" value="@Model.Filter.SortBy" />
            <input type="hidden" name="SortDir" id="staffSortDirInput" value="@Model.Filter.SortDir" />
            <input type="hidden" name="ViewMode" id="staffViewModeInput" value="@currentViewMode" />

            <!-- Active Filter Chips Bar -->
            <div id="activeFilterChipsBar" class="d-flex flex-wrap align-items-center gap-1.5 mt-2.5 pt-2 border-top d-none">
                <span class="small text-muted fw-semibold me-1" style="font-size: 0.72rem;">
                    <i class="fa-solid fa-filter text-rose-500 me-1"></i>Đang lọc:
                </span>
                <div id="activeFilterChipsList" class="d-flex flex-wrap align-items-center gap-1.5"></div>
                <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 ms-2 fw-semibold"
                        style="font-size: 0.74rem;" onclick="resetAllStaffFilters()">
                    <i class="fa-solid fa-xmark me-1"></i>Xóa tất cả
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 5. Thanh Hành Động Hàng Loạt (Floating Bulk Action Bar khi chọn ≥ 1 dòng) -->
<div id="bulkActionBar" class="card border-0 shadow-sm rounded-4 mb-3 bg-rose-50 dark:bg-slate-800 p-3 d-none" style="border: 1px solid #fecdd3 !important;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-rose-600 text-white px-2.5 py-1 rounded-pill" id="selectedStaffCountBadge">0</span>
            <span class="small fw-bold text-dark dark:text-white">nhân sự đang được chọn</span>
            <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none p-0 ms-1" onclick="toggleSelectAllStaff(false)">
                (Bỏ chọn)
            </button>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanEditUser)
            {
                <button asp-permission="USER_EDIT" type="button" class="btn btn-sm btn-outline-success bg-white rounded-3 fw-semibold" onclick="executeBulkAction('unlock')">
                    <i class="fa-solid fa-lock-open me-1"></i>Mở Khóa
                </button>
                <button asp-permission="USER_EDIT" type="button" class="btn btn-sm btn-outline-warning bg-white rounded-3 fw-semibold" onclick="executeBulkAction('lock')">
                    <i class="fa-solid fa-user-lock me-1"></i>Khóa
                </button>
                <button asp-permission="USER_EDIT" type="button" class="btn btn-sm btn-outline-primary bg-white rounded-3 fw-semibold" onclick="openBulkAssignDeptModal()">
                    <i class="fa-solid fa-building-user me-1"></i>Chuyển Phòng Ban
                </button>
            }
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanAssignRole)
            {
                <button asp-any-permission="USER_ASSIGN_ROLE,PERMISSION_DELEGATE" type="button" class="btn btn-sm btn-outline-indigo bg-white rounded-3 fw-semibold" onclick="openBulkAssignRoleModal()">
                    <i class="fa-solid fa-id-badge me-1"></i>Gán Vai Trò
                </button>
            }
            <button asp-permission="USER_EXPORT" type="button" class="btn btn-sm btn-outline-secondary bg-white rounded-3 fw-semibold" onclick="exportSelectedStaffRows('xlsx')">
                <i class="fa-solid fa-file-export text-emerald-600 me-1"></i>Xuất Các Dòng Đã Chọn
            </button>
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanDeleteUser)
            {
                <button asp-permission="USER_DELETE" type="button" class="btn btn-sm btn-danger rounded-3 fw-semibold" onclick="executeBulkAction('delete')">
                    <i class="fa-regular fa-trash-can me-1"></i>Xóa
                </button>
            }
        </div>
    </div>
</div>

<!-- 6. Khung Dữ Liệu Bảng Nhân Sự + Skeleton Loading -->
<div class="card border-0 shadow-sm rounded-4 bg-white dark:bg-slate-900 position-relative" id="staffTableContainer">
    <!-- Skeleton Loading khi HTMX đang tải -->
    <div class="htmx-indicator-skeleton p-4 border-bottom">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="skeleton-line" style="width: 40px; height: 40px; border-radius: 50%;"></div>
            <div class="flex-grow-1">
                <div class="skeleton-line mb-2" style="width: 35%;"></div>
                <div class="skeleton-line" style="width: 20%;"></div>
            </div>
            <div class="skeleton-line" style="width: 15%;"></div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="skeleton-line" style="width: 40px; height: 40px; border-radius: 50%;"></div>
            <div class="flex-grow-1">
                <div class="skeleton-line mb-2" style="width: 45%;"></div>
                <div class="skeleton-line" style="width: 25%;"></div>
            </div>
            <div class="skeleton-line" style="width: 15%;"></div>
        </div>
    </div>

    <div id="staffTableContent">
        <partial name="_StaffTable" model="Model.StaffPaged" />
    </div>
</div>

<!-- Modal Đặt lại Mật Khẩu -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-amber-500 text-white border-0 rounded-top-4" style="background: linear-gradient(135deg, #d97706, #ea580c);">
                <h5 class="modal-title h6 fw-bold mb-0" id="resetPasswordModalTitle">
                    <i class="fa-solid fa-key me-2"></i>Đặt Lại Mật Khẩu Nhân Sự
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="reset_StaffId" />
                <p class="small text-muted mb-3">
                    Đang cấp lại mật khẩu cho nhân sự: <strong id="reset_StaffName" class="text-dark dark:text-white"></strong>
                </p>

                <div class="mb-3">
                    <label for="reset_NewPasswordInput" class="form-label small fw-bold text-dark dark:text-white">Mật khẩu mới (Tùy chọn)</label>
                    <div class="input-group">
                        <input type="text" id="reset_NewPasswordInput" class="form-control font-monospace"
                               placeholder="Để trống để hệ thống tự sinh mật khẩu mạnh..." autocomplete="new-password" />
                        <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPasswordForModal()" title="Tạo mật khẩu ngẫu nhiên">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </button>
                    </div>
                    <div class="form-text small" style="font-size: 0.72rem;">
                        Mật khẩu mới sẽ được hiển thị <strong>1 lần duy nhất</strong> sau khi xác nhận để bạn sao chép.
                    </div>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="reset_RequireChangeCb" checked>
                    <label class="form-check-label small text-dark dark:text-white" for="reset_RequireChangeCb">
                        Bắt buộc đổi mật khẩu ở lần đăng nhập kế tiếp
                    </label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light rounded-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn text-white rounded-3 fw-semibold px-4" style="background:#d97706;" onclick="submitResetPassword()">
                    <i class="fa-solid fa-check me-1"></i>Xác Nhận Cấp Lại
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chuyển Phòng Ban Hàng Loạt -->
<div class="modal fade" id="bulkDeptModal" tabindex="-1" aria-labelledby="bulkDeptModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title h6 fw-bold mb-0" id="bulkDeptModalTitle">
                    <i class="fa-solid fa-building-user me-2"></i>Chuyển Phòng Ban Hàng Loạt
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <label for="bulkTargetDeptSelect" class="form-label small fw-bold text-dark dark:text-white">Chọn phòng ban đích</label>
                <select id="bulkTargetDeptSelect" class="form-select rounded-3">
                    <option value="">-- Chọn phòng ban --</option>
                    @foreach (var d in Model.ScopedDepartments)
                    {
                        <option value="@d.Id">@(string.IsNullOrEmpty(d.DisplayTreeName) ? d.Name : d.DisplayTreeName) (@d.Code)</option>
