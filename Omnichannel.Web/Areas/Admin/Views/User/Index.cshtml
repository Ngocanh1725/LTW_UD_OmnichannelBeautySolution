@model Omnichannel.Application.DTOs.HR.StaffIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Nhân Sự & Phân Quyền";
    Layout = "_AdminLayout";
}

<!-- Header & Action Buttons -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted">Hệ thống</a></li>
                <li class="breadcrumb-item active text-dark dark:text-white fw-semibold" aria-current="page">Quản lý nhân sự</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-users-gear text-rose-600"></i>
            <span>Quản Lý Hồ Sơ Nhân Sự & Cấp Bậc</span>
        </h4>
        <p class="small text-muted mb-0 mt-1">Quản lý đội ngũ nhân viên nội bộ, phân bổ phòng ban, gán vai trò và ủy quyền an toàn.</p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/Admin/Department" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3 shadow-2xs" title="Xem cây phòng ban và sơ đồ tổ chức">
            <i class="fa-solid fa-sitemap me-1.5 text-indigo-600"></i>Sơ Đồ Tổ Chức
        </a>

        <div class="btn-group" asp-permission="USER_EXPORT">
            <button type="button" class="btn btn-outline-success btn-sm px-3 py-2 fw-semibold rounded-3 shadow-2xs dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-file-excel me-1.5 text-success"></i>Xuất Danh Sách
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 text-sm p-1.5">
                <li>
                    <a class="dropdown-item rounded-2 py-1.5" href="/Admin/User/Export?format=xlsx">
                        <i class="fa-regular fa-file-excel text-success me-2"></i>Tải file Excel (.xlsx)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item rounded-2 py-1.5" href="/Admin/User/Export?format=csv">
                        <i class="fa-solid fa-file-csv text-primary me-2"></i>Tải file CSV (UTF-8 BOM)
                    </a>
                </li>
            </ul>
        </div>

        <a asp-permission="USER_DELETE" href="/Admin/User/Trash" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold rounded-3 shadow-2xs position-relative" title="Thùng rác nhân sự đã xóa mềm">
            <i class="fa-regular fa-trash-can me-1"></i>Thùng Rác
            @if (Model.Stats.TrashStaff > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.65rem;">
                    @Model.Stats.TrashStaff
                </span>
            }
        </a>

        <a asp-permission="USER_CREATE" href="/Admin/User/Create" class="btn btn-primary-gradient btn-sm px-3.5 py-2 text-white fw-semibold rounded-3 shadow-xs">
            <i class="fa-solid fa-user-plus me-1.5"></i>Thêm Nhân Sự Mới
        </a>
    </div>
</div>

<!-- Tabs: Nhân sự nội bộ vs Tài khoản khách hàng -->
<div class="border-bottom border-slate-200 dark:border-slate-800 mb-4">
    <ul class="nav nav-tabs border-0" id="userManagementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-dark dark:text-white border-0 border-bottom border-2 border-rose-600 bg-transparent py-2.5 px-3.5 d-flex align-items-center gap-2" type="button" role="tab">
                <i class="fa-solid fa-user-tie text-rose-600"></i>
                <span>Nhân Sự Nội Bộ</span>
                <span class="badge bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300 rounded-pill font-monospace" style="font-size: 0.72rem;">@Model.Stats.TotalStaff</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link text-muted hover:text-dark dark:hover:text-white border-0 py-2.5 px-3.5 d-flex align-items-center gap-2 text-decoration-none" href="/Admin/User/Customers">
                <i class="fa-solid fa-user-tag text-indigo-500"></i>
                <span>Tài Khoản Khách Hàng</span>
                <span class="badge bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 rounded-pill font-monospace" style="font-size: 0.72rem;">@Model.CustomerCount</span>
            </a>
        </li>
    </ul>
</div>

<!-- 6 Thẻ KPI Tương Tác (Click để áp nhanh bộ lọc) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-rose-300 hover:shadow-xs transition kpi-card" onclick="applyQuickKpiFilter('all')" title="Xem tất cả nhân sự">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Tổng Nhân Sự</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-rose-50 text-rose-600 dark:bg-rose-950/40">
                    <i class="fa-solid fa-users" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-slate-900 dark:text-white">@Model.Stats.TotalStaff</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Trong phạm vi quản lý</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-emerald-300 hover:shadow-xs transition kpi-card" onclick="applyQuickKpiFilter('active')" title="Lọc nhân sự đang hoạt động">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Đang Hoạt Động</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40">
                    <i class="fa-solid fa-user-check" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-emerald-600">@Model.Stats.ActiveStaff</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Tài khoản sẵn sàng</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-amber-300 hover:shadow-xs transition kpi-card" onclick="applyQuickKpiFilter('locked')" title="Lọc nhân sự đang bị khóa">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Đang Tạm Khóa</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-amber-50 text-amber-600 dark:bg-amber-950/40">
                    <i class="fa-solid fa-user-lock" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-amber-600">@Model.Stats.LockedStaff</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Ngừng đăng nhập</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-indigo-300 hover:shadow-xs transition kpi-card" onclick="applyQuickKpiFilter('new30')" title="Nhân viên mới tuyển trong 30 ngày qua">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Mới 30 Ngày</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-indigo-50 text-indigo-600 dark:bg-indigo-950/40">
                    <i class="fa-solid fa-user-plus" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-indigo-600">@Model.Stats.NewStaffLast30Days</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Gia nhập gần đây</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-purple-300 hover:shadow-xs transition kpi-card" onclick="openDepartmentFocus()" title="Số phòng ban trực thuộc">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Phòng Ban</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-purple-50 text-purple-600 dark:bg-purple-950/40">
                    <i class="fa-solid fa-sitemap" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-purple-600">@Model.TotalDepartments</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Đang hoạt động</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="card border-0 shadow-2xs rounded-4 p-3 bg-white dark:bg-slate-900 cursor-pointer hover:border-cyan-300 hover:shadow-xs transition kpi-card" onclick="applyQuickKpiFilter('admin')" title="Nhân sự giữ vai trò quản trị / trưởng phòng">
            <div class="d-flex align-items-center justify-content-between mb-1.5">
                <span class="small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Quản Trị Viên</span>
                <div class="d-inline-flex p-1.5 rounded-3 bg-cyan-50 text-cyan-600 dark:bg-cyan-950/40">
                    <i class="fa-solid fa-shield-halved" style="font-size: 13px;"></i>
                </div>
            </div>
            <h3 class="fw-bolder mb-0 text-cyan-600">@Model.TotalAdmins</h3>
            <div class="text-muted" style="font-size: 0.68rem;">Cấp trưởng/Admin</div>
        </div>
    </div>
</div>

<!-- Thanh Lọc Sticky & Điều Khiển Chế Độ Xem (Sticky Filter Bar) -->
<div class="card border-0 shadow-sm rounded-4 mb-3 bg-white dark:bg-slate-900 p-3 sticky-top" style="top: 70px; z-index: 1020;">
    <form id="staffFilterForm" method="get" action="/Admin/User"
          hx-get="/Admin/User"
          hx-target="#staffTableContainer"
          hx-indicator="#tableLoadingSpinner"
          hx-push-url="true"
          class="m-0">

        <!-- Hidden sort and paging values -->
        <input type="hidden" name="SortBy" id="filterSortBy" value="@Model.Filter.SortBy" />
        <input type="hidden" name="SortDir" id="filterSortDir" value="@Model.Filter.SortDir" />
        <input type="hidden" name="Page" id="filterPage" value="@Model.Filter.Page" />
        <input type="hidden" name="PageSize" id="filterPageSize" value="@Model.Filter.PageSize" />

        <div class="row g-2 align-items-center">
            <!-- Ô tìm kiếm Debounce 400ms -->
            <div class="col-12 col-md-4 col-xl-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="Keyword" id="staffKeywordInput" class="form-control border-start-0"
                           placeholder="Tìm tên, username, email, mã NV..."
                           value="@Model.Filter.Keyword"
                           autocorrect="off" autocapitalize="off" spellcheck="false"
                           oninput="handleKeywordInputDebounced(this.value)" />
                    @if (!string.IsNullOrEmpty(Model.Filter.Keyword))
                    {
                        <button type="button" class="btn btn-light border border-start-0 text-muted" onclick="clearKeywordSearch()" title="Xóa tìm kiếm">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
            </div>

            <!-- Dropdown Phòng ban dạng cây (Hierarchical Tree) -->
            <div class="col-6 col-md-3 col-xl-2">
                <select name="DepartmentId" id="filterDeptSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                    <option value="">-- Tất cả phòng ban --</option>
                    @foreach (var d in Model.ScopedDepartments)
                    {
                        <option value="@d.Id" selected="@(Model.Filter.DepartmentId == d.Id ? "selected" : null)">
                            @(string.IsNullOrEmpty(d.DisplayTreeName) ? d.Name : d.DisplayTreeName)
                        </option>
                    }
                </select>
            </div>

            <!-- Dropdown Vai trò -->
            <div class="col-6 col-md-3 col-xl-2">
                <select name="RoleId" id="filterRoleSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var r in Model.AssignableRoles)
                    {
                        <option value="@r.Id" selected="@(Model.Filter.RoleId == r.Id ? "selected" : null)">
                            @r.DisplayName (Lv@r.Level)
                        </option>
                    }
                </select>
            </div>

            <!-- Dropdown Trạng thái -->
            <div class="col-6 col-md-2 col-xl-2">
                <select name="Status" id="filterStatusSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                    <option value="all" selected="@(Model.Filter.Status == "all" ? "selected" : null)">-- Trạng thái: Tất cả --</option>
                    <option value="active" selected="@(Model.Filter.Status == "active" ? "selected" : null)">Đang hoạt động</option>
                    <option value="locked" selected="@(Model.Filter.Status == "locked" ? "selected" : null)">Đã tạm khóa</option>
                </select>
            </div>

            <!-- Nút Bộ Lọc Nâng Cao & Switch Chế Độ Xem -->
            <div class="col-12 col-xl-3 d-flex align-items-center justify-content-between justify-content-xl-end gap-2 mt-2 mt-xl-0">
                <button type="button" class="btn btn-outline-secondary btn-sm px-2.5 rounded-3 d-flex align-items-center gap-1.5" data-bs-toggle="collapse" data-bs-target="#advancedFilterPanel" aria-expanded="false">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Nâng cao</span>
                    <span id="activeFilterCountBadge" class="badge bg-rose-600 text-white rounded-pill d-none" style="font-size: 0.65rem;">0</span>
                </button>

                <!-- 3 Chế Độ Xem: Bảng / Thẻ / Nhóm Phòng Ban -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Chế độ xem nhân sự">
                    <button type="button" class="btn btn-outline-secondary view-mode-btn active" data-mode="table" onclick="switchHrViewMode('table')" title="Xem dạng bảng chi tiết">
                        <i class="fa-solid fa-table-list"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary view-mode-btn" data-mode="card" onclick="switchHrViewMode('card')" title="Xem dạng thẻ (card grid)">
                        <i class="fa-solid fa-grip"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary view-mode-btn" data-mode="accordion" onclick="switchHrViewMode('accordion')" title="Nhóm theo phòng ban">
                        <i class="fa-solid fa-layer-group"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Khung Bộ Lọc Nâng Cao (Collapsible Panel) -->
        <div class="collapse pt-3 mt-3 border-top border-slate-100 dark:border-slate-800" id="advancedFilterPanel">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Chi nhánh làm việc:</label>
                    <select name="StoreId" id="filterStoreSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                        <option value="">-- Tất cả chi nhánh --</option>
                        @foreach (var s in Model.ScopedStores)
                        {
                            <option value="@s.Id" selected="@(Model.Filter.StoreId == s.Id ? "selected" : null)">
                                @s.Name (@s.Code)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Người quản lý trực tiếp:</label>
                    <select name="ManagerId" id="filterManagerSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                        <option value="">-- Tất cả người quản lý --</option>
                        @foreach (var m in Model.PotentialManagers)
                        {
                            <option value="@m.Id" selected="@(Model.Filter.ManagerId == m.Id ? "selected" : null)">
                                @m.FullName (@m.Username)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Giới tính:</label>
                    <select name="Gender" id="filterGenderSelect" class="form-select form-select-sm rounded-3" onchange="triggerFilterSubmit()">
                        <option value="">-- Tất cả --</option>
                        <option value="Nam" selected="@(Model.Filter.Gender == "Nam" ? "selected" : null)">Nam</option>
                        <option value="Nữ" selected="@(Model.Filter.Gender == "Nữ" ? "selected" : null)">Nữ</option>
                        <option value="Khác" selected="@(Model.Filter.Gender == "Khác" ? "selected" : null)">Khác</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Khoảng ngày vào làm việc:</label>
                    <div class="input-group input-group-sm">
                        <input type="date" name="HireFrom" id="filterHireFrom" class="form-control" value="@(Model.Filter.HireFrom?.ToString("yyyy-MM-dd"))" onchange="triggerFilterSubmit()" />
                        <span class="input-group-text bg-light text-muted">đến</span>
                        <input type="date" name="HireTo" id="filterHireTo" class="form-control" value="@(Model.Filter.HireTo?.ToString("yyyy-MM-dd"))" onchange="triggerFilterSubmit()" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Chips Bar: Hiển thị các tiêu chí lọc đang được chọn -->
        <div id="filterChipsBar" class="d-flex flex-wrap align-items-center gap-1.5 pt-2.5 mt-2.5 border-top border-slate-100 dark:border-slate-800 d-none">
            <span class="small text-muted me-1"><i class="fa-solid fa-filter text-rose-500 me-1"></i>Đang lọc:</span>
            <div id="filterChipsContainer" class="d-flex flex-wrap gap-1.5 align-items-center"></div>
            <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0 ms-2 small fw-semibold" onclick="resetAllFilters()">
                <i class="fa-solid fa-xmark me-1"></i>Xóa tất cả
            </button>
        </div>
    </form>
</div>

<!-- Floating Bulk Action Toolbar (Xuất hiện khi tick chọn ≥ 1 nhân sự) -->
<div id="bulkActionBar" class="card border-0 shadow-sm rounded-4 mb-3 bg-rose-50 border border-rose-200 dark:bg-slate-800 p-3 d-none">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-rose-600 text-white px-2.5 py-1 rounded-pill" id="selectedStaffCountBadge">0</span>
            <span class="small fw-bold text-dark dark:text-white">nhân sự đang được chọn</span>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanEditUser)
            {
                <button type="button" class="btn btn-sm btn-outline-success bg-white rounded-3 fw-semibold shadow-2xs" onclick="executeBulkAction('unlock')">
                    <i class="fa-solid fa-lock-open me-1"></i>Mở Khóa
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning bg-white rounded-3 fw-semibold shadow-2xs" onclick="executeBulkAction('lock')">
                    <i class="fa-solid fa-user-lock me-1"></i>Tạm Khóa
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary bg-white rounded-3 fw-semibold shadow-2xs" onclick="openBulkAssignDeptModal()">
                    <i class="fa-solid fa-building-user me-1"></i>Chuyển Phòng Ban
                </button>
                <button type="button" class="btn btn-sm btn-outline-indigo bg-white rounded-3 fw-semibold shadow-2xs" onclick="openBulkAssignRoleModal()">
                    <i class="fa-solid fa-id-badge me-1"></i>Gán Vai Trò
                </button>
            }
            @if (Model.ActorContext.IsSuperAdmin || Model.ActorContext.CanDeleteUser)
            {
                <button type="button" class="btn btn-sm btn-danger rounded-3 fw-semibold shadow-2xs" onclick="executeBulkAction('delete')">
                    <i class="fa-regular fa-trash-can me-1"></i>Xóa Mềm Hàng Loạt
                </button>
            }
        </div>
    </div>
</div>

<!-- Staff Data Table Container (Rendered by partial _StaffTable for HTMX requests) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white dark:bg-slate-900 position-relative">
    <!-- HTMX Loading Spinner Overlay -->
    <div id="tableLoadingSpinner" class="htmx-indicator position-absolute w-100 h-100 top-0 start-0 d-flex flex-column align-items-center justify-content-center bg-white/80 dark:bg-slate-900/80" style="z-index: 50;">
        <div class="spinner-border text-rose-600 mb-2" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <div class="small fw-semibold text-muted">Đang cập nhật danh sách nhân sự...</div>
    </div>

    <div id="staffTableContainer">
        <partial name="_StaffTable" model="Model.StaffPaged" />
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODALS PHỤ TRỢ (RESET PASSWORD, BULK ACTIONS) -->
<!-- ========================================================================= -->

<!-- Modal 1: Đặt Lại Mật Khẩu -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark dark:text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-key text-amber-500"></i>
                    <span>Đặt Lại Mật Khẩu Nhân Sự</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="small text-muted mb-3">
                    Bạn đang đặt lại mật khẩu cho nhân sự: <strong id="reset_StaffName" class="text-dark dark:text-white"></strong>.
                </p>
                <input type="hidden" id="reset_StaffId" />

                <div class="mb-3">
                    <label class="form-label small fw-bold">Mật khẩu mới (Tối thiểu 8 ký tự):</label>
                    <div class="input-group">
                        <input type="text" id="reset_NewPasswordInput" class="form-control font-monospace" placeholder="Nhập hoặc bấm Tạo ngẫu nhiên" />
                        <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPasswordForModal()" title="Sinh ngẫu nhiên">
                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Tạo ngẫu nhiên
                        </button>
                    </div>
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input cursor-pointer" type="checkbox" id="reset_RequireChangeCb" checked />
                    <label class="form-check-label small" for="reset_RequireChangeCb">Yêu cầu nhân sự đổi mật khẩu ở lần đăng nhập tiếp theo</label>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-3 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-gradient px-4 text-white fw-semibold rounded-3 shadow-xs" onclick="submitResetPassword()">
                    Xác Nhận Đổi Mật Khẩu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Chuyển Phòng Ban Hàng Loạt -->
<div class="modal fade" id="bulkAssignDeptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark dark:text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-building-user text-primary"></i>
                    <span>Chuyển Phòng Ban Cho Nhân Sự Được Chọn</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="small text-muted mb-3">Chọn phòng ban mới để điều chuyển các nhân sự đang được chọn:</p>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Phòng ban đích:</label>
                    <select id="bulkTargetDeptSelect" class="form-select rounded-3">
                        <option value="">-- Chọn phòng ban --</option>
                        @foreach (var d in Model.ScopedDepartments)
                        {
                            <option value="@d.Id">@(string.IsNullOrEmpty(d.DisplayTreeName) ? d.Name : d.DisplayTreeName)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold" onclick="submitBulkAssignDept()">Áp Dụng Điều Chuyển</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Gán Vai Trò Hàng Loạt -->
<div class="modal fade" id="bulkAssignRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark dark:text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-id-badge text-indigo-600"></i>
                    <span>Gán Thêm Vai Trò Cho Nhân Sự Được Chọn</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body pt-3">
                <p class="small text-muted mb-3">Chọn vai trò cần bổ sung cho các nhân sự đang được chọn:</p>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Vai trò bổ sung:</label>
                    <select id="bulkTargetRoleSelect" class="form-select rounded-3">
                        <option value="">-- Chọn vai trò --</option>
                        @foreach (var r in Model.AssignableRoles)
                        {
                            <option value="@r.Id">@r.DisplayName (Cấp bậc Lv@r.Level)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-indigo rounded-3 px-4 fw-semibold text-white" style="background:#4f46e5;" onclick="submitBulkAssignRole()">Gán Vai Trò</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let resetPasswordModalInstance = null;
        let bulkAssignDeptModalInstance = null;
        let bulkAssignRoleModalInstance = null;
        let debounceTimer = null;

        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo chế độ xem từ localStorage
            const savedMode = localStorage.getItem('canmake_hr_view_mode') || 'table';
            switchHrViewMode(savedMode, false);

            // Cập nhật filter chips khi vừa vào trang
            renderActiveFilterChips();
        });

        // 1. Chuyển đổi chế độ xem (Table, Card, Accordion)
        function switchHrViewMode(mode, save = true) {
            document.querySelectorAll('.hr-view-container').forEach(el => el.classList.add('d-none'));
            document.querySelectorAll('.view-mode-btn').forEach(btn => btn.classList.remove('active'));

            const targetView = document.getElementById(mode === 'card' ? 'staffCardView' : mode === 'accordion' ? 'staffAccordionView' : 'staffTableView');
            if (targetView) targetView.classList.remove('d-none');

            const activeBtn = document.querySelector(`.view-mode-btn[data-mode="${mode}"]`);
            if (activeBtn) activeBtn.classList.add('active');

            if (save) {
                localStorage.setItem('canmake_hr_view_mode', mode);
            }
        }

        // 2. Debounce Tìm kiếm từ khóa 400ms
        function handleKeywordInputDebounced(val) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                document.getElementById('filterPage').value = 1;
                triggerFilterSubmit();
            }, 400);
        }

        function clearKeywordSearch() {
            document.getElementById('staffKeywordInput').value = '';
            document.getElementById('filterPage').value = 1;
            triggerFilterSubmit();
        }

        // 3. Trigger submit form qua HTMX
        function triggerFilterSubmit() {
            renderActiveFilterChips();
            const form = document.getElementById('staffFilterForm');
            if (window.htmx) {
                htmx.trigger(form, 'submit');
            } else {
                form.submit();
            }
        }

        // 4. Phân trang & Sort
        function goToStaffPage(page) {
            if (page < 1) return;
            document.getElementById('filterPage').value = page;
            triggerFilterSubmit();
        }

        function changeStaffPageSize(size) {
            document.getElementById('filterPageSize').value = size;
            document.getElementById('filterPage').value = 1;
            triggerFilterSubmit();
        }

        function toggleSortStaff(column) {
            const curCol = document.getElementById('filterSortBy').value;
            const curDir = document.getElementById('filterSortDir').value;
            let newDir = 'asc';
            if (curCol === column && curDir === 'asc') {
                newDir = 'desc';
            }
            document.getElementById('filterSortBy').value = column;
            document.getElementById('filterSortDir').value = newDir;
            triggerFilterSubmit();
        }

        // 5. Áp nhanh bộ lọc từ KPI Cards
        function applyQuickKpiFilter(type) {
            document.getElementById('filterPage').value = 1;
            if (type === 'all') {
                document.getElementById('filterStatusSelect').value = 'all';
            } else if (type === 'active') {
                document.getElementById('filterStatusSelect').value = 'active';
            } else if (type === 'locked') {
                document.getElementById('filterStatusSelect').value = 'locked';
            } else if (type === 'new30') {
                const today = new Date();
                const past = new Date();
                past.setDate(today.getDate() - 30);
                document.getElementById('filterHireFrom').value = past.toISOString().split('T')[0];
                document.getElementById('filterHireTo').value = today.toISOString().split('T')[0];
                const collapse = new bootstrap.Collapse(document.getElementById('advancedFilterPanel'), { toggle: false });
                collapse.show();
            } else if (type === 'admin') {
                // Chọn role đầu tiên có Level >= 50
                const roleSelect = document.getElementById('filterRoleSelect');
                for (let i = 0; i < roleSelect.options.length; i++) {
                    if (roleSelect.options[i].text.includes('Lv50') || roleSelect.options[i].text.includes('Admin')) {
                        roleSelect.selectedIndex = i;
                        break;
                    }
                }
            }
            triggerFilterSubmit();
        }

        function openDepartmentFocus() {
            document.getElementById('filterDeptSelect').focus();
        }

        // 6. Quản lý Filter Chips
        function renderActiveFilterChips() {
            const container = document.getElementById('filterChipsContainer');
            const chipsBar = document.getElementById('filterChipsBar');
            const badge = document.getElementById('activeFilterCountBadge');
            if (!container || !chipsBar) return;

            container.innerHTML = '';
            let count = 0;

            const kw = document.getElementById('staffKeywordInput')?.value.trim();
            if (kw) {
                count++;
                addChip(container, `Từ khóa: "${kw}"`, () => clearKeywordSearch());
            }

            const deptSel = document.getElementById('filterDeptSelect');
            if (deptSel && deptSel.value) {
                count++;
                const text = deptSel.options[deptSel.selectedIndex].text.replace(/^[—\s]+/, '');
                addChip(container, `Phòng ban: ${text}`, () => { deptSel.value = ''; triggerFilterSubmit(); });
            }

            const roleSel = document.getElementById('filterRoleSelect');
            if (roleSel && roleSel.value) {
                count++;
                addChip(container, `Vai trò: ${roleSel.options[roleSel.selectedIndex].text}`, () => { roleSel.value = ''; triggerFilterSubmit(); });
            }

            const statusSel = document.getElementById('filterStatusSelect');
            if (statusSel && statusSel.value && statusSel.value !== 'all') {
                count++;
                const text = statusSel.value === 'active' ? 'Đang hoạt động' : 'Đã tạm khóa';
                addChip(container, `Trạng thái: ${text}`, () => { statusSel.value = 'all'; triggerFilterSubmit(); });
            }

            const storeSel = document.getElementById('filterStoreSelect');
            if (storeSel && storeSel.value) {
                count++;
                addChip(container, `Chi nhánh: ${storeSel.options[storeSel.selectedIndex].text}`, () => { storeSel.value = ''; triggerFilterSubmit(); });
            }

            const mgrSel = document.getElementById('filterManagerSelect');
            if (mgrSel && mgrSel.value) {
                count++;
                addChip(container, `Quản lý: ${mgrSel.options[mgrSel.selectedIndex].text}`, () => { mgrSel.value = ''; triggerFilterSubmit(); });
            }

            const genderSel = document.getElementById('filterGenderSelect');
            if (genderSel && genderSel.value) {
                count++;
                addChip(container, `Giới tính: ${genderSel.value}`, () => { genderSel.value = ''; triggerFilterSubmit(); });
            }

            const hireFrom = document.getElementById('filterHireFrom')?.value;
            const hireTo = document.getElementById('filterHireTo')?.value;
            if (hireFrom || hireTo) {
                count++;
                addChip(container, `Ngày vào làm: ${hireFrom || '...'} -> ${hireTo || '...'}`, () => {
                    document.getElementById('filterHireFrom').value = '';
                    document.getElementById('filterHireTo').value = '';
                    triggerFilterSubmit();
                });
            }

            if (count > 0) {
                chipsBar.classList.remove('d-none');
                badge.textContent = count;
                badge.classList.remove('d-none');
            } else {
                chipsBar.classList.add('d-none');
                badge.classList.add('d-none');
            }
        }

        function addChip(container, text, removeCallback) {
            const chip = document.createElement('span');
            chip.className = 'badge bg-light text-dark border d-inline-flex align-items-center gap-1.5 py-1 px-2.5 rounded-pill small';
            chip.innerHTML = `<span>${text}</span><button type="button" class="btn-close" style="font-size: 8px;" aria-label="Xóa"></button>`;
            chip.querySelector('button').addEventListener('click', removeCallback);
            container.appendChild(chip);
        }

        function resetAllFilters() {
            document.getElementById('staffKeywordInput').value = '';
            document.getElementById('filterDeptSelect').value = '';
            document.getElementById('filterRoleSelect').value = '';
            document.getElementById('filterStatusSelect').value = 'all';
            document.getElementById('filterStoreSelect').value = '';
            document.getElementById('filterManagerSelect').value = '';
            document.getElementById('filterGenderSelect').value = '';
            document.getElementById('filterHireFrom').value = '';
            document.getElementById('filterHireTo').value = '';
            document.getElementById('filterSortBy').value = '';
            document.getElementById('filterSortDir').value = '';
            document.getElementById('filterPage').value = 1;
            triggerFilterSubmit();
        }

        // 7. Checkbox hàng loạt (Bulk selection)
        function toggleSelectAllStaff(checked) {
            document.querySelectorAll('.staff-select-cb').forEach(cb => {
                if (!cb.disabled) cb.checked = checked;
            });
            updateBulkActionToolbar();
        }

        function updateBulkActionToolbar() {
            const selected = document.querySelectorAll('.staff-select-cb:checked');
            const bar = document.getElementById('bulkActionBar');
            const badge = document.getElementById('selectedStaffCountBadge');
            if (selected.length > 0) {
                bar.classList.remove('d-none');
                badge.textContent = selected.length;
            } else {
                bar.classList.add('d-none');
            }
        }

        function getSelectedStaffIds() {
            return Array.from(document.querySelectorAll('.staff-select-cb:checked')).map(cb => parseInt(cb.value, 10));
        }

        // 8. Sao chép 1-click vào clipboard
        function copyTextToClipboard(text, btnElement) {
            if (!navigator.clipboard) {
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            } else {
                navigator.clipboard.writeText(text);
            }
            const icon = btnElement.querySelector('i');
            if (icon) {
                const origClass = icon.className;
                icon.className = 'fa-solid fa-check text-success';
                setTimeout(() => { icon.className = origClass; }, 1200);
            }
        }

        // 9. Thao tác hàng loạt (Bulk actions)
        async function executeBulkAction(action) {
            const ids = getSelectedStaffIds();
            if (ids.length === 0) return;

            let actionTitle = action === 'delete' ? 'Xóa mềm hàng loạt' : action === 'lock' ? 'Tạm khóa hàng loạt' : 'Mở khóa hàng loạt';
            let actionText = `Bạn có chắc muốn thực hiện '${actionTitle}' cho ${ids.length} nhân sự đã chọn?`;

            const confirm = await Swal.fire({
                title: actionTitle,
                text: actionText,
                icon: action === 'delete' ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: action === 'delete' ? '#e11d48' : '#4f46e5',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });

            if (!confirm.isConfirmed) return;

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: action,
                staffIds: ids
            });

            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            } else {
                Swal.fire({
                    title: 'Lỗi thực thi',
                    text: res ? res.message : 'Có lỗi xảy ra khi xử lý.',
                    icon: 'error'
                });
            }
        }

        function openBulkAssignDeptModal() {
            if (getSelectedStaffIds().length === 0) return;
            if (!bulkAssignDeptModalInstance) bulkAssignDeptModalInstance = new bootstrap.Modal(document.getElementById('bulkAssignDeptModal'));
            bulkAssignDeptModalInstance.show();
        }

        async function submitBulkAssignDept() {
            const deptId = parseInt(document.getElementById('bulkTargetDeptSelect').value, 10);
            if (!deptId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn phòng ban đích.', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkAssignDeptModalInstance) bulkAssignDeptModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assigndepartment',
                staffIds: ids,
                targetDepartmentId: deptId
            });

            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        function openBulkAssignRoleModal() {
            if (getSelectedStaffIds().length === 0) return;
            if (!bulkAssignRoleModalInstance) bulkAssignRoleModalInstance = new bootstrap.Modal(document.getElementById('bulkAssignRoleModal'));
            bulkAssignRoleModalInstance.show();
        }

        async function submitBulkAssignRole() {
            const roleId = parseInt(document.getElementById('bulkTargetRoleSelect').value, 10);
            if (!roleId) {
                Swal.fire('Lưu ý', 'Vui lòng chọn vai trò bổ sung.', 'warning');
                return;
            }
            const ids = getSelectedStaffIds();
            if (bulkAssignRoleModalInstance) bulkAssignRoleModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/Bulk', {
                action: 'assignrole',
                staffIds: ids,
                targetRoleId: roleId
            });

            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
                setTimeout(() => window.location.reload(), 600);
            }
        }

        // 10. Modal Đặt lại mật khẩu (Reset Password)
        function openResetPasswordModal(staffId, fullName, username) {
            document.getElementById('reset_StaffId').value = staffId;
            document.getElementById('reset_StaffName').textContent = `${fullName} (\x40${username})`;
            document.getElementById('reset_NewPasswordInput').value = '';
            if (!resetPasswordModalInstance) resetPasswordModalInstance = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            resetPasswordModalInstance.show();
        }

        function generateRandomPasswordForModal() {
            const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!#$%&*+';
            let pwd = 'Canmake2026!';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('reset_NewPasswordInput').value = pwd;
        }

        async function submitResetPassword() {
            const staffId = parseInt(document.getElementById('reset_StaffId').value, 10);
            const newPassword = (document.getElementById('reset_NewPasswordInput').value || '').trim();
            const requireChange = document.getElementById('reset_RequireChangeCb').checked;

            if (resetPasswordModalInstance) resetPasswordModalInstance.hide();

            const res = await window.adminJsonRequest('/Admin/User/ResetPassword', {
                staffId: staffId,
                newPassword: newPassword,
                requireChangeOnLogin: requireChange
            });

            if (res && res.succeeded) {
                await Swal.fire({
                    title: 'Mật Khẩu Mới Đã Tạo!',
                    html: `<p class="mb-2">Mật khẩu mới của nhân sự là: <strong class="text-rose-600 font-monospace fs-5">${res.data}</strong></p><p class="small text-muted">Vui lòng sao chép và gửi cho nhân sự bảo mật.</p>`,
                    icon: 'success',
                    confirmButtonText: 'Đã sao chép & Đóng'
                });
            } else {
                Swal.fire({
                    title: 'Không thể đặt lại mật khẩu',
                    text: res ? res.message : 'Có lỗi xảy ra.',
                    icon: 'error'
                });
            }
        }

        // 11. Bật/Tắt trạng thái nhanh (Quick Toggle Status)
        async function quickToggleStaffStatus(staffId, switchElement) {
            const res = await window.adminJsonRequest(`/Admin/User/ToggleStatus?userId=${staffId}`, {});
            if (res && res.succeeded) {
                window.showAdminToast(res.message, 'success');
            } else {
                switchElement.checked = !switchElement.checked;
                Swal.fire('Lỗi thao tác', res ? res.message : 'Không thể thay đổi trạng thái.', 'error');
            }
        }

        async function confirmToggleStaffStatus(staffId, fullName, isCurrentlyActive) {
            const actionText = isCurrentlyActive ? 'tạm khóa' : 'mở khóa';
            const confirm = await Swal.fire({
                title: `Xác nhận ${actionText}`,
                text: `Bạn có chắc muốn ${actionText} tài khoản của '${fullName}'?`,
                icon: isCurrentlyActive ? 'warning' : 'question',
                showCancelButton: true,
                confirmButtonColor: isCurrentlyActive ? '#f59e0b' : '#10b981',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            });
            if (confirm.isConfirmed) {
                const res = await window.adminJsonRequest(`/Admin/User/ToggleStatus?userId=${staffId}`, {});
                if (res && res.succeeded) {
                    window.showAdminToast(res.message, 'success');
                    setTimeout(() => triggerFilterSubmit(), 400);
                } else {
                    Swal.fire('Lỗi', res ? res.message : 'Không thể cập nhật trạng thái.', 'error');
                }
            }
        }

        // 12. Xóa mềm nhân sự với SweetAlert2
        async function confirmDeleteStaff(staffId, fullName, username) {
            const confirm = await Swal.fire({
                title: 'Chuyển vào thùng rác?',
                html: `Bạn có chắc muốn xóa nhân sự <strong class="text-rose-600">${fullName} (\x40${username})</strong>?<br><small class="text-muted">Nhân sự này sẽ bị khóa và chuyển vào Thùng rác. Bạn có thể khôi phục bất cứ lúc nào.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Chuyển vào thùng rác',
                cancelButtonText: 'Hủy bỏ'
            });

            if (confirm.isConfirmed) {
                const res = await window.adminJsonRequest(`/Admin/User/Delete/${staffId}`, { id: staffId });
                if (res && res.succeeded) {
                    window.showAdminToast(res.message, 'success');
                    setTimeout(() => triggerFilterSubmit(), 400);
                } else {
                    Swal.fire({
                        title: 'Không thể xóa nhân sự',
                        text: res ? res.message : 'Thao tác không được phép.',
                        icon: 'error'
                    });
                }
            }
        }

        // Hook sau khi HTMX cập nhật bảng -> giữ đúng view mode
        document.body.addEventListener('htmx:afterOnLoad', function (evt) {
            if (evt.detail.target.id === 'staffTableContainer') {
                const savedMode = localStorage.getItem('canmake_hr_view_mode') || 'table';
                switchHrViewMode(savedMode, false);
                updateBulkActionToolbar();
            }
        });
    </script>
}
