@model IEnumerable<Omnichannel.Application.DTOs.Account.UserItemViewModel>
@{
    ViewData["Title"] = "Quản lý Nhân sự & Tài khoản";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Danh sách Nhân sự & Tài khoản</h4>
        <p class="text-muted small mb-0">Quản lý hồ sơ nhân viên, phân nhóm vai trò và trạng thái hoạt động</p>
    </div>
    <a href="/Admin/User/Create" class="btn btn-primary-gradient px-4">
        <i class="fa-solid fa-user-plus me-2"></i>Thêm Mới Nhân Sự
    </a>
</div>

<div class="beauty-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="py-3 px-4">Họ và Tên / Tài khoản</th>
                    <th class="py-3">Email & SĐT</th>
                    <th class="py-3">Vai trò phân bổ</th>
                    <th class="py-3">Trạng thái</th>
                    <th class="py-3">Ngày tạo</th>
                    <th class="text-end py-3 px-4">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar-badge" style="width: 38px; height: 38px; font-size: 14px;">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">@user.FullName</div>
                                    <div class="text-muted" style="font-size: 11.5px;"><code>@user.Username</code></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small text-dark">@user.Email</div>
                            <div class="text-muted" style="font-size: 11.5px;">@(user.PhoneNumber ?? "Chưa có SĐT")</div>
                        </td>
                        <td>
                            @foreach (var role in user.AssignedRoles)
                            {
                                <span class="badge-role me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge-active"><i class="fa-solid fa-check me-1"></i>Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge-locked"><i class="fa-solid fa-lock me-1"></i>Đã khóa</span>
                            }
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end px-4">
                            <form asp-action="ToggleStatus" asp-route-userId="@user.UserId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (user.IsActive)
                                {
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3" title="Tạm khóa tài khoản" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?')">
                                        <i class="fa-solid fa-user-lock"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-success btn-sm rounded-3" title="Mở khóa tài khoản">
                                        <i class="fa-solid fa-lock-open"></i>
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
