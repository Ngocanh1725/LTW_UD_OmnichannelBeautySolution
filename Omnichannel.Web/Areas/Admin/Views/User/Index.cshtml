@model IEnumerable<Omnichannel.Application.DTOs.Account.UserItemViewModel>
@{
    ViewData["Title"] = "Quản Lý Nhân Sự & Phân Quyền";
    Layout = "_AdminLayout";
}

<!-- Admin Page Header Component -->
<div class="admin-page-header">
    <div class="admin-page-header__left">
        <h1 class="admin-page-title">
            <i class="fa-solid fa-users text-rose-500"></i>
            Danh Sách Nhân Sự & Tài Khoản
        </h1>
        <ul class="admin-breadcrumb">
            <li><a href="/Admin/Dashboard">Omnichannel Beauty</a></li>
            <li class="admin-breadcrumb-separator"><i class="fa-solid fa-chevron-right"></i></li>
            <li class="text-rose-600 font-semibold">Nhân Sự & Phân Quyền</li>
        </ul>
    </div>
    <div class="admin-page-actions">
        <a href="/Admin/User/Create" class="admin-btn admin-btn--primary">
            <i class="fa-solid fa-user-plus me-1"></i> Thêm Mới Nhân Sự
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <!-- Admin Empty State Component -->
    <div class="admin-empty-state">
        <div class="admin-empty-state__icon">
            <i class="fa-solid fa-user-xmark"></i>
        </div>
        <h3 class="admin-empty-state__title">Chưa Có Nhân Sự Nào</h3>
        <p class="admin-empty-state__description">
            Hệ thống hiện tại chưa ghi nhận hồ sơ nhân sự nào. Bấm nút bên dưới để tạo tài khoản đầu tiên cho chi nhánh hoặc trụ sở.
        </p>
        <a href="/Admin/User/Create" class="admin-btn admin-btn--primary">
            <i class="fa-solid fa-user-plus me-1"></i> Tạo Nhân Sự Đầu Tiên
        </a>
    </div>
}
else
{
    <!-- Admin Data Table Component -->
    <div class="admin-table-container">
        <table class="admin-table admin-table--striped">
            <thead>
                <tr>
                    <th style="width: 280px;">Họ Và Tên / Username</th>
                    <th>Email & Số Điện Thoại</th>
                    <th>Vai Trò Phân Bổ</th>
                    <th>Trạng Thái</th>
                    <th>Ngày Tạo</th>
                    <th class="col-numeric" style="width: 120px;">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar-badge" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; border-radius: var(--radius-lg);">
                                    @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.9375rem;">@user.FullName</div>
                                    <div class="text-muted font-mono-numeric" style="font-size: 12px;">@@@user.Username</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">@user.Email</div>
                            <div class="text-muted" style="font-size: 12px;">@(user.PhoneNumber ?? "Chưa có SĐT")</div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var role in user.AssignedRoles)
                                {
                                    <span class="admin-badge admin-badge--neutral">
                                        <i class="fa-solid fa-id-badge text-rose-500" style="font-size: 10px;"></i>
                                        @role
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="admin-badge admin-badge--success">
                                    <span class="admin-badge__dot"></span> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge--danger">
                                    <span class="admin-badge__dot"></span> Đã khóa
                                </span>
                            }
                        </td>
                        <td class="small text-muted font-mono-numeric">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="col-numeric">
                            <form asp-action="ToggleStatus" asp-route-userId="@user.UserId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                @if (user.IsActive)
                                {
                                    <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm text-rose-600" title="Tạm khóa tài khoản" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?')">
                                        <i class="fa-solid fa-user-lock"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm text-emerald-600" title="Mở khóa tài khoản">
                                        <i class="fa-solid fa-lock-open"></i>
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
