@model IEnumerable<Omnichannel.Application.DTOs.Account.UserItemViewModel>
@{
    ViewData["Title"] = "Quản Lý Nhân Sự & Phân Quyền";
    Layout = "_AdminLayout";
    var departments = ViewBag.Departments as IEnumerable<Omnichannel.Domain.Entities.Department> ?? Enumerable.Empty<Omnichannel.Domain.Entities.Department>();
    var selectedDeptId = ViewBag.SelectedDepartmentId as int?;
}

<!-- Admin Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-slate-900 mb-1 d-flex align-items-center gap-2">
            <i class="fa-solid fa-users text-rose-600"></i>
            <span>Danh Sách Nhân Sự Nội Bộ & Phân Quyền</span>
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small text-muted mb-0">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted">@Brand.DisplayName</a></li>
                <li class="breadcrumb-item active text-rose-600 fw-semibold" aria-current="page">Nhân Sự & Phân Quyền</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <form method="get" action="/Admin/User" class="d-flex align-items-center gap-2">
            <select name="departmentId" class="form-select form-select-sm rounded-3 border" style="min-width: 210px;" onchange="this.form.submit()">
                <option value="">-- Tất cả phòng ban trong phạm vi --</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept.Id" selected="@(selectedDeptId == dept.Id ? "selected" : null)">@dept.Name (@dept.Code)</option>
                }
            </select>
        </form>
        <a asp-permission="DEPARTMENT_VIEW" href="/Admin/Department" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3">
            <i class="fa-solid fa-sitemap me-1 text-rose-600"></i>Sơ Đồ Phòng Ban
        </a>
        <a asp-permission="USER_CREATE" href="/Admin/User/Create" class="btn btn-primary-gradient btn-sm px-3 py-2 text-white fw-semibold rounded-3 shadow-xs">
            <i class="fa-solid fa-user-plus me-1"></i>Thêm Mới Nhân Sự
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="bg-white rounded-3 p-5 text-center border shadow-xs">
        <div class="w-16 h-16 rounded-circle bg-rose-50 text-rose-600 d-inline-flex align-items-center justify-center fs-2 mb-3">
            <i class="fa-solid fa-user-xmark"></i>
        </div>
        <h5 class="fw-bold text-dark">Chưa Có Nhân Sự Nào Trong Phạm Vi</h5>
        <p class="text-muted small max-w-md mx-auto mb-3">
            Không tìm thấy hồ sơ nhân sự nội bộ nào phù hợp với bộ lọc hoặc phạm vi phòng ban của bạn.
        </p>
        <a asp-permission="USER_CREATE" href="/Admin/User/Create" class="btn btn-primary-gradient px-4 py-2 text-white fw-semibold rounded-3">
            <i class="fa-solid fa-user-plus me-1"></i>Tạo Nhân Sự Đầu Tiên
        </a>
    </div>
}
else
{
    <div class="bg-white rounded-3 border shadow-sm overflow-hidden">
        <div class="table-responsive" tabindex="0" role="region" aria-label="Bảng danh sách nhân sự nội bộ">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="py-3 px-4 text-slate-700 fw-bold small text-uppercase">Mã NV / Họ Tên</th>
                        <th class="py-3 text-slate-700 fw-bold small text-uppercase">Phòng Ban & Chức Danh</th>
                        <th class="py-3 text-slate-700 fw-bold small text-uppercase">Vai Trò Phân Bổ</th>
                        <th class="py-3 text-slate-700 fw-bold small text-uppercase">Email & Điện Thoại</th>
                        <th class="py-3 text-slate-700 fw-bold small text-uppercase text-center">Trạng Thái</th>
                        <th class="py-3 px-4 text-slate-700 fw-bold small text-uppercase text-end">Thao Tác & Phân Quyền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="border-bottom">
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 fw-bold text-white shadow-xs flex-shrink-0" 
                                         style="width: 40px; height: 40px; font-size: 14px; background: linear-gradient(135deg, #e11d48, #9333ea);">
                                        @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-1.5">
                                            @if (!string.IsNullOrEmpty(user.EmployeeCode))
                                            {
                                                <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.68rem;">@user.EmployeeCode</span>
                                            }
                                            <span class="fw-bold text-dark" style="font-size: 0.9rem;">@user.FullName</span>
                                        </div>
                                        <div class="text-muted font-monospace" style="font-size: 0.75rem;">@@@user.Username</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark small">
                                    <i class="fa-solid fa-building-user text-rose-500 me-1"></i>@(user.DepartmentName ?? "Chưa phân phòng ban")
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @(user.JobTitle ?? "Nhân viên")
                                    @if (!string.IsNullOrEmpty(user.ManagerName))
                                    {
                                        <span> • QL: @user.ManagerName</span>
                                    }
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in user.AssignedRoles)
                                    {
                                        <span class="badge bg-slate-100 text-slate-800 border px-2 py-1 rounded-2" style="font-size: 11px; background-color: #f1f5f9; color: #334155;">
                                            <i class="fa-solid fa-id-badge text-rose-500 me-1" style="font-size: 10px;"></i>@role
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="small fw-semibold text-dark">@user.Email</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@(user.PhoneNumber ?? "Chưa có SĐT")</div>
                            </td>
                            <td class="py-3 text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="d-inline-flex align-items-center gap-1.5">
                                    @if (user.CanActorManage)
                                    {
                                        <a asp-permission="PERMISSION_DELEGATE"
                                           href="/Admin/User/Permissions/@user.UserId"
                                           class="btn btn-sm btn-outline-primary rounded-3 px-2.5 py-1 fw-semibold"
                                           title="Phân quyền cá nhân & Gán vai trò">
                                            <i class="fa-solid fa-user-Check fa-shield-halved me-1"></i>Phân quyền
                                        </a>

                                        <form asp-permission="USER_EDIT" asp-action="ToggleStatus" asp-route-userId="@user.UserId" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2 py-1" title="Tạm khóa tài khoản" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?')">
                                                    <i class="fa-solid fa-user-lock"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2 py-1" title="Mở khóa tài khoản">
                                                    <i class="fa-solid fa-lock-open"></i>
                                                </button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border" title="Tài khoản cùng cấp hoặc cao hơn cấp bậc của bạn">
                                            <i class="fa-solid fa-lock me-1"></i>Chỉ xem
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
