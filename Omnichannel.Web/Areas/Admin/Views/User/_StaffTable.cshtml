@model Omnichannel.Application.DTOs.HR.PagedResult<Omnichannel.Application.DTOs.HR.StaffListItemDto>
@{
    string viewMode = (ViewBag.ViewMode as string ?? "table").ToLowerInvariant();
    string sortBy = (ViewBag.SortBy as string ?? "createdat").ToLowerInvariant();
    string sortDir = (ViewBag.SortDir as string ?? "desc").ToLowerInvariant();

    string FormatRelativeTime(DateTime? utcTime)
    {
        if (!utcTime.HasValue) return "Chưa đăng nhập";
        var local = utcTime.Value.ToLocalTime();
        var diff = DateTime.Now - local;
        if (diff.TotalMinutes < 1) return "Vừa xong";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} phút trước";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} giờ trước";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays} ngày trước";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)} tháng trước";
        return local.ToString("dd/MM/yyyy");
    }

    (string Bg, string Text, string Border) GetRoleBadgeStyle(string? color)
    {
        return (color?.ToLowerInvariant()) switch
        {
            "rose" or "pink" or "red" => ("#fff1f2", "#be123c", "#fecdd3"),
            "indigo" or "blue" => ("#eef2ff", "#4338ca", "#c7d2fe"),
            "emerald" or "green" or "teal" => ("#ecfdf5", "#047857", "#a7f3d0"),
            "amber" or "yellow" or "orange" => ("#fffbeb", "#b45309", "#fde68a"),
            "purple" or "violet" => ("#f5f3ff", "#6d28d9", "#ddd6fe"),
            "sky" or "cyan" => ("#f0f9ff", "#0369a1", "#bae6fd"),
            _ => ("#f8fafc", "#334155", "#e2e8f0")
        };
    }

    string RenderSortIcon(string col)
    {
        if (sortBy != col.ToLowerInvariant()) return "fa-solid fa-sort text-slate-300 ms-1";
        return sortDir == "asc"
            ? "fa-solid fa-sort-up text-rose-600 ms-1"
            : "fa-solid fa-sort-down text-rose-600 ms-1";
    }
}

@if (Model.Items.Count == 0)
{
    <!-- Trạng thái rỗng (Empty State) -->
    <div class="text-center py-5 px-3">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-xs"
             style="width: 72px; height: 72px; background: linear-gradient(135deg, #fff1f2, #f5f3ff); color: #e11d48;">
            <i class="fa-solid fa-users-slash fs-2"></i>
        </div>
        <h6 class="fw-bold text-dark dark:text-white mb-1">Không tìm thấy hồ sơ nhân sự phù hợp</h6>
        <p class="small text-muted mb-3 mx-auto" style="max-width: 420px;">
            Không có nhân sự nào khớp với điều kiện tìm kiếm hoặc bộ lọc hiện tại trong phạm vi quản lý của bạn.
        </p>
        <button type="button" class="btn btn-outline-rose btn-sm rounded-3 px-3 py-1.5 fw-semibold"
                style="border-color: #f43f5e; color: #e11d48;" onclick="resetAllStaffFilters()">
            <i class="fa-solid fa-filter-circle-xmark me-1.5"></i>Xóa tất cả bộ lọc
        </button>
    </div>
}
else if (viewMode == "card")
{
    <!-- ========================================================================= -->
    <!-- CHẾ ĐỘ XEM 2: DẠNG THẺ (CARD VIEW)                                        -->
    <!-- ========================================================================= -->
    <div class="p-3 bg-slate-50/50 dark:bg-slate-900">
        <div class="d-flex align-items-center justify-content-between mb-3 px-1">
            <div class="form-check">
                <input type="checkbox" id="selectAllStaffCb" class="form-check-input cursor-pointer"
                       onchange="toggleSelectAllStaff(this.checked)" />
                <label class="form-check-label small fw-semibold text-muted" for="selectAllStaffCb">
                    Chọn tất cả nhân sự trên trang này
                </label>
            </div>
            <span class="small text-muted">Chế độ xem: <strong class="text-dark dark:text-white">Thẻ hồ sơ</strong></span>
        </div>

        <div class="row g-3">
            @foreach (var staff in Model.Items)
            {
                var visibleRoles = staff.Roles.Take(2).ToList();
                int extraRoleCount = Math.Max(0, staff.Roles.Count - 2);
                string extraRoleNames = extraRoleCount > 0
                    ? string.Join(", ", staff.Roles.Skip(2).Select(r => r.DisplayName))
                    : "";

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border border-slate-200/80 dark:border-slate-800 shadow-xs rounded-4 h-100 bg-white dark:bg-slate-900 hover:border-rose-300 transition">
                        <div class="card-body p-3.5 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Top row: Checkbox + Avatar + Name + Dropdown -->
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                    <div class="d-flex align-items-center gap-2.5 min-w-0">
                                        @if (staff.CanActorManage)
                                        {
                                            <input type="checkbox" class="form-check-input staff-select-cb m-0 flex-shrink-0 cursor-pointer"
                                                   value="@staff.Id" onchange="updateBulkActionToolbar()" aria-label="Chọn @staff.FullName" />
                                        }
                                        @if (!string.IsNullOrEmpty(staff.AvatarUrl))
                                        {
                                            <img src="@staff.AvatarUrl" alt="@staff.FullName"
                                                 class="rounded-circle object-fit-cover border shadow-xs flex-shrink-0"
                                                 style="width: 46px; height: 46px;" />
                                        }
                                        else
                                        {
                                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white shadow-xs flex-shrink-0"
                                                 style="width: 46px; height: 46px; font-size: 16px; background: linear-gradient(135deg, #e11d48, #9333ea);">
                                                @(staff.FullName.Length > 0 ? staff.FullName[0].ToString().ToUpper() : "U")
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                <a href="/Admin/User/Details/@staff.Id" class="fw-bold text-dark dark:text-white text-decoration-none text-truncate">
                                                    @staff.FullName
                                                </a>
                                                @if (staff.IsDepartmentHead)
                                                {
                                                    <span class="badge bg-amber-100 text-amber-800 border border-amber-300" style="font-size: 0.62rem;">
                                                        <i class="fa-solid fa-crown text-amber-600 me-0.5"></i>Trưởng phòng
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-muted font-monospace" style="font-size: 0.72rem;">
                                                @@@staff.Username
                                                @if (!string.IsNullOrEmpty(staff.EmployeeCode))
                                                {
                                                    <span class="ms-1 badge bg-light text-dark border">@staff.EmployeeCode</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Dropdown Actions (⋯) -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border rounded-3 px-2 py-1" type="button" data-bs-toggle="dropdown" aria-label="Tùy chọn thao tác cho @staff.FullName">
                                            <i class="fa-solid fa-ellipsis-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3 small">
                                            <li>
                                                <a class="dropdown-item py-1.5" href="/Admin/User/Details/@staff.Id">
                                                    <i class="fa-regular fa-id-badge text-indigo-600 me-2" style="width:16px;"></i>Xem hồ sơ 360°
                                                </a>
                                            </li>
                                            @if (staff.CanActorEdit)
                                            {
                                                <li asp-permission="USER_EDIT">
                                                    <a class="dropdown-item py-1.5" href="/Admin/User/Edit/@staff.Id">
                                                        <i class="fa-solid fa-pen text-primary me-2" style="width:16px;"></i>Chỉnh sửa hồ sơ
                                                    </a>
                                                </li>
                                            }
                                            @if (staff.CanActorDelegate)
                                            {
                                                <li asp-any-permission="PERMISSION_DELEGATE,USER_ASSIGN_ROLE">
                                                    <a class="dropdown-item py-1.5" href="/Admin/User/Permissions/@staff.Id">
                                                        <i class="fa-solid fa-shield-halved text-rose-600 me-2" style="width:16px;"></i>Phân quyền cá nhân
                                                    </a>
                                                </li>
                                            }
                                            @if (staff.CanActorResetPassword)
                                            {
                                                <li asp-permission="USER_RESET_PASSWORD">
                                                    <button type="button" class="dropdown-item py-1.5" onclick="openResetPasswordModal(@staff.Id, '@staff.FullName', '@staff.Username')">
                                                        <i class="fa-solid fa-key text-amber-600 me-2" style="width:16px;"></i>Đặt lại mật khẩu
                                                    </button>
                                                </li>
                                            }
                                            @if (staff.CanActorEdit)
                                            {
                                                <li asp-permission="USER_EDIT">
                                                    <button type="button" class="dropdown-item py-1.5" onclick="quickToggleStaffStatus(@staff.Id, '@staff.FullName', @(staff.IsActive ? "true" : "false"))">
                                                        @if (staff.IsActive)
                                                        {
                                                            <i class="fa-solid fa-user-lock text-warning me-2" style="width:16px;"></i><span>Tạm khóa tài khoản</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-lock-open text-success me-2" style="width:16px;"></i><span>Mở khóa tài khoản</span>
                                                        }
                                                    </button>
                                                </li>
                                            }
                                            @if (staff.CanActorDelete)
                                            {
                                                <li asp-permission="USER_DELETE"><hr class="dropdown-divider my-1" /></li>
                                                <li asp-permission="USER_DELETE">
                                                    <button type="button" class="dropdown-item py-1.5 text-danger" onclick="confirmDeleteStaff(@staff.Id, '@staff.FullName', '@staff.Username')">
                                                        <i class="fa-regular fa-trash-can me-2" style="width:16px;"></i>Xóa mềm (Thùng rác)
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                <!-- Roles Badges -->
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @if (staff.Roles.Count == 0)
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">Chưa gán vai trò</span>
                                    }
                                    else
                                    {
                                        @foreach (var role in visibleRoles)
                                        {
                                            var style = GetRoleBadgeStyle(role.Color);
                                            <span class="badge px-2 py-1 rounded-2 fw-semibold"
                                                  style="background:@style.Bg; color:@style.Text; border:1px solid @style.Border; font-size: 0.7rem;">
                                                @role.DisplayName
                                            </span>
                                        }
                                        @if (extraRoleCount > 0)
                                        {
                                            <span class="badge bg-slate-100 text-slate-700 border px-2 py-1 rounded-2"
                                                  style="font-size: 0.7rem;" title="@extraRoleNames">
                                                +@extraRoleCount
                                            </span>
                                        }
                                    }
                                </div>

                                <!-- Metadata list -->
                                <div class="small space-y-1.5 text-muted border-top pt-2.5">
                                    <div class="d-flex justify-content-between">
                                        <span><i class="fa-solid fa-building-user text-rose-500 me-1.5"></i>Phòng ban:</span>
                                        <span class="fw-semibold text-dark dark:text-white text-end">@(staff.DepartmentName ?? "Chưa phân phòng")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span><i class="fa-solid fa-briefcase text-indigo-500 me-1.5"></i>Chức danh:</span>
                                        <span class="text-dark dark:text-slate-200 text-end">@(staff.JobTitle ?? "Nhân viên")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span><i class="fa-solid fa-store text-emerald-600 me-1.5"></i>Chi nhánh:</span>
                                        <span class="text-dark dark:text-slate-200 text-end">@(staff.StoreName ?? "Trụ sở chính")</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="fa-regular fa-envelope me-1.5"></i>Email:</span>
                                        <span class="text-dark dark:text-slate-200 text-truncate" style="max-width: 180px;" title="@staff.Email">
                                            @staff.Email
                                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted" onclick="copyToClipboard('@staff.Email', 'Email')" title="Sao chép Email">
                                                <i class="fa-regular fa-copy" style="font-size: 0.7rem;"></i>
                                            </button>
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(staff.PhoneNumber))
                                    {
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span><i class="fa-solid fa-phone me-1.5"></i>SĐT:</span>
                                            <span class="font-monospace text-dark dark:text-slate-200">
                                                @staff.PhoneNumber
                                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted" onclick="copyToClipboard('@staff.PhoneNumber', 'Số điện thoại')" title="Sao chép SĐT">
                                                    <i class="fa-regular fa-copy" style="font-size: 0.7rem;"></i>
                                                </button>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Card Footer: Status Switch & Last Login -->
                            <div class="d-flex align-items-center justify-content-between border-top mt-3 pt-2.5">
                                <div class="d-flex align-items-center gap-2">
                                    @if (staff.CanActorEdit)
                                    {
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input cursor-pointer" type="checkbox" role="switch"
                                                   checked="@(staff.IsActive ? "checked" : null)"
                                                   onchange="quickToggleStaffStatus(@staff.Id, '@staff.FullName', @(staff.IsActive ? "true" : "false"), this)"
                                                   aria-label="Trạng thái hoạt động của @staff.FullName" />
                                        </div>
                                    }
                                    <span class="badge @(staff.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                        @(staff.IsActive ? "Hoạt động" : "Tạm khóa")
                                    </span>
                                </div>
                                <div class="small text-muted" style="font-size: 0.7rem;" title="Đăng nhập cuối: @(staff.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa từng đăng nhập")">
                                    <i class="fa-regular fa-clock me-1"></i>@FormatRelativeTime(staff.LastLoginAt)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else if (viewMode == "department")
{
    <!-- ========================================================================= -->
    <!-- CHẾ ĐỘ XEM 3: NHÓM THEO PHÒNG BAN (ACCORDION VIEW)                        -->
    <!-- ========================================================================= -->
    var deptGroups = Model.Items
        .GroupBy(s => s.DepartmentName ?? "Chưa phân bổ phòng ban")
        .OrderBy(g => g.Key)
        .ToList();

    <div class="p-3">
        <div class="accordion" id="staffDeptAccordion">
            @for (int gIdx = 0; gIdx < deptGroups.Count; gIdx++)
            {
                var grp = deptGroups[gIdx];
                string collapseId = $"deptCollapse_{gIdx}";
                var headPerson = grp.FirstOrDefault(x => x.IsDepartmentHead);

                <div class="accordion-item border rounded-4 mb-3 overflow-hidden shadow-xs">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(gIdx > 0 ? "collapsed" : "") bg-slate-50 dark:bg-slate-800 fw-bold text-dark dark:text-white py-3 px-4"
                                type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(gIdx == 0 ? "true" : "false")">
                            <div class="d-flex flex-wrap align-items-center justify-content-between w-100 me-3 gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-3 bg-rose-100 text-rose-600 p-1.5 px-2">
                                        <i class="fa-solid fa-building-user"></i>
                                    </span>
                                    <span>@grp.Key</span>
                                    <span class="badge bg-rose-600 text-white rounded-pill px-2.5 py-1" style="font-size: 0.7rem;">
                                        @grp.Count() nhân sự
                                    </span>
                                </div>
                                @if (headPerson != null)
                                {
                                    <span class="small text-muted fw-normal">
                                        <i class="fa-solid fa-crown text-amber-500 me-1"></i>Trưởng phòng: <strong class="text-dark dark:text-white">@headPerson.FullName</strong>
                                    </span>
                                }
                            </div>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse @(gIdx == 0 ? "show" : "")" data-bs-parent="#staffDeptAccordion">
                        <div class="accordion-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 text-sm">
                                    <thead class="bg-light dark:bg-slate-800/60 text-xs text-uppercase text-muted">
                                        <tr>
                                            <th scope="col" class="ps-4 py-2.5">Nhân Sự</th>
                                            <th scope="col" class="py-2.5">Chức Danh & Vai Trò</th>
                                            <th scope="col" class="py-2.5">Liên Hệ</th>
                                            <th scope="col" class="py-2.5 text-center">Trạng Thái</th>
                                            <th scope="col" class="pe-4 py-2.5 text-end">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var staff in grp)
                                        {
                                            <tr>
                                                <td class="ps-4 py-2.5">
                                                    <div class="d-flex align-items-center gap-2.5">
                                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white flex-shrink-0"
                                                             style="width: 34px; height: 34px; font-size: 13px; background: linear-gradient(135deg, #e11d48, #9333ea);">
                                                            @(staff.FullName.Length > 0 ? staff.FullName[0].ToString().ToUpper() : "U")
                                                        </div>
                                                        <div>
                                                            <a href="/Admin/User/Details/@staff.Id" class="fw-bold text-dark dark:text-white text-decoration-none">@staff.FullName</a>
                                                            @if (staff.IsDepartmentHead)
                                                            {
                                                                <span class="badge bg-amber-100 text-amber-800 border border-amber-300 ms-1" style="font-size: 0.62rem;">Trưởng phòng</span>
                                                            }
                                                            <div class="text-muted font-monospace" style="font-size: 0.72rem;">@@@staff.Username @(string.IsNullOrEmpty(staff.EmployeeCode) ? "" : $"• {staff.EmployeeCode}")</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-2.5">
                                                    <div class="small fw-medium text-dark dark:text-slate-200 mb-1">@(staff.JobTitle ?? "Nhân viên")</div>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var r in staff.Roles.Take(2))
                                                        {
                                                            var st = GetRoleBadgeStyle(r.Color);
                                                            <span class="badge px-2 py-0.5 rounded-2" style="background:@st.Bg;color:@st.Text;border:1px solid @st.Border;font-size:0.68rem;">@r.DisplayName</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="py-2.5 small">
                                                    <div>@staff.Email</div>
                                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">@(staff.PhoneNumber ?? "-")</div>
                                                </td>
                                                <td class="py-2.5 text-center">
                                                    <span class="badge @(staff.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-2.5 py-1" style="font-size: 0.7rem;">
                                                        @(staff.IsActive ? "Hoạt động" : "Tạm khóa")
                                                    </span>
                                                </td>
                                                <td class="pe-4 py-2.5 text-end">
                                                    <a href="/Admin/User/Details/@staff.Id" class="btn btn-sm btn-light border rounded-3 px-2.5 py-1">
                                                        <i class="fa-regular fa-eye me-1"></i>Chi tiết
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- ========================================================================= -->
    <!-- CHẾ ĐỘ XEM 1: DẠNG BẢNG TIÊU CHUẨN (TABLE VIEW - DEFAULT)                 -->
    <!-- ========================================================================= -->
    <div class="table-responsive" tabindex="0" role="region" aria-label="Bảng danh sách nhân sự nội bộ">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Danh sách hồ sơ nhân sự nội bộ trong phạm vi quản lý</caption>
            <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold uppercase tracking-wider border-b border-slate-200 dark:border-slate-700 sticky-top">
                <tr>
                    <th scope="col" class="ps-4 py-3 text-center" style="width: 42px;">
                        <input type="checkbox" id="selectAllStaffCb" class="form-check-input m-0 cursor-pointer"
                               onchange="toggleSelectAllStaff(this.checked)" aria-label="Chọn tất cả nhân sự trên trang" />
                    </th>
                    <th scope="col" class="py-3 px-3 cursor-pointer user-select-none" onclick="sortStaffBy('name')">
                        <span>Nhân Sự & Mã NV</span>
                        <i class="@RenderSortIcon("name")"></i>
                    </th>
                    <th scope="col" class="py-3 px-3 cursor-pointer user-select-none" onclick="sortStaffBy('department')">
                        <span>Phòng Ban & Chức Danh</span>
                        <i class="@RenderSortIcon("department")"></i>
                    </th>
                    <th scope="col" class="py-3 px-3">Vai Trò</th>
                    <th scope="col" class="py-3 px-3">Chi Nhánh & Quản Lý</th>
                    <th scope="col" class="py-3 px-3">Liên Hệ</th>
                    <th scope="col" class="py-3 px-3 text-center">Trạng Thái</th>
                    <th scope="col" class="py-3 px-3 text-center cursor-pointer user-select-none" onclick="sortStaffBy('lastlogin')">
                        <span>Đăng Nhập Cuối</span>
                        <i class="@RenderSortIcon("lastlogin")"></i>
                    </th>
                    <th scope="col" class="py-3 px-3 text-center cursor-pointer user-select-none" onclick="sortStaffBy('createdat')">
                        <span>Ngày Tạo</span>
                        <i class="@RenderSortIcon("createdat")"></i>
                    </th>
                    <th scope="col" class="pe-4 py-3 text-end" style="min-width: 110px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                @foreach (var staff in Model.Items)
                {
                    var visibleRoles = staff.Roles.Take(2).ToList();
                    int extraRoleCount = Math.Max(0, staff.Roles.Count - 2);
                    string extraRoleNames = extraRoleCount > 0
                        ? string.Join(", ", staff.Roles.Skip(2).Select(r => r.DisplayName))
                        : "";

                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition">
                        <td class="ps-4 py-3 text-center">
                            @if (staff.CanActorManage)
                            {
                                <input type="checkbox" class="form-check-input staff-select-cb m-0 cursor-pointer"
                                       value="@staff.Id" onchange="updateBulkActionToolbar()" aria-label="Chọn nhân sự @staff.FullName" />
                            }
                            else
                            {
                                <input type="checkbox" class="form-check-input m-0 opacity-25" disabled
                                       title="Tài khoản cùng cấp hoặc cao hơn cấp của bạn" aria-label="Không thể chọn @staff.FullName" />
                            }
                        </td>

                        <!-- Avatar + Họ tên + Username + Mã NV -->
                        <th scope="row" class="py-3 px-3 fw-normal">
                            <div class="d-flex align-items-center gap-2.5">
                                @if (!string.IsNullOrEmpty(staff.AvatarUrl))
                                {
                                    <img src="@staff.AvatarUrl" alt="@staff.FullName"
                                         class="rounded-circle object-fit-cover border shadow-xs flex-shrink-0"
                                         style="width: 40px; height: 40px;" />
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white shadow-xs flex-shrink-0"
                                         style="width: 40px; height: 40px; font-size: 14px; background: linear-gradient(135deg, #e11d48, #9333ea);">
                                        @(staff.FullName.Length > 0 ? staff.FullName[0].ToString().ToUpper() : "U")
                                    </div>
                                }
                                <div class="min-w-0">
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <a href="/Admin/User/Details/@staff.Id" class="fw-bold text-dark dark:text-white text-decoration-none hover:text-rose-600">
                                            @staff.FullName
                                        </a>
                                        @if (staff.IsDepartmentHead)
                                        {
                                            <span class="badge bg-amber-100 text-amber-800 border border-amber-300" style="font-size: 0.65rem;" title="Trưởng phòng phụ trách">
                                                <i class="fa-solid fa-crown text-amber-600 me-0.5"></i>Trưởng phòng
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                        <span class="text-muted font-monospace" style="font-size: 0.73rem;">@@@staff.Username</span>
                                        @if (!string.IsNullOrEmpty(staff.EmployeeCode))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.66rem;">@staff.EmployeeCode</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </th>

                        <!-- Phòng ban + Chức danh -->
                        <td class="py-3 px-3">
                            <div class="fw-semibold text-dark dark:text-white small">
                                <i class="fa-solid fa-building-user text-rose-500 me-1"></i>@(staff.DepartmentName ?? "Chưa phân phòng")
                            </div>
                            <div class="text-muted" style="font-size: 0.74rem;">
                                @(staff.JobTitle ?? "Nhân viên")
                            </div>
                        </td>

                        <!-- Vai trò (badge màu theo Role.Color, tối đa 2 + "+n") -->
                        <td class="py-3 px-3">
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                @if (staff.Roles.Count == 0)
                                {
                                    <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">Chưa gán vai trò</span>
                                }
                                else
                                {
                                    @foreach (var role in visibleRoles)
                                    {
                                        var badgeStyle = GetRoleBadgeStyle(role.Color);
                                        <span class="badge px-2 py-1 rounded-2 fw-semibold"
                                              style="background:@badgeStyle.Bg; color:@badgeStyle.Text; border: 1px solid @badgeStyle.Border; font-size: 11px;">
                                            @role.DisplayName
                                        </span>
                                    }
                                    @if (extraRoleCount > 0)
                                    {
                                        <span class="badge bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border px-2 py-1 rounded-2 fw-bold"
                                              style="font-size: 11px; cursor: help;" title="Vai trò khác: @extraRoleNames">
                                            +@extraRoleCount
                                        </span>
                                    }
                                }
                            </div>
                        </td>

                        <!-- Chi nhánh & Người quản lý -->
                        <td class="py-3 px-3 small">
                            <div class="text-dark dark:text-slate-200 fw-medium">
                                <i class="fa-solid fa-store text-indigo-500 me-1"></i>@(staff.StoreName ?? "Trụ sở chính")
                            </div>
                            <div class="text-muted" style="font-size: 0.72rem;">
                                <i class="fa-solid fa-user-tie me-1"></i>QL: @(staff.ManagerName ?? "Trực tiếp BGD")
                            </div>
                        </td>

                        <!-- Liên hệ (Email + SĐT có icon copy) -->
                        <td class="py-3 px-3 small">
                            <div class="d-flex align-items-center gap-1 text-dark dark:text-slate-200">
                                <span class="text-truncate" style="max-width: 175px;" title="@staff.Email">@staff.Email</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-muted hover:text-rose-600"
                                        onclick="copyToClipboard('@staff.Email', 'Email')" aria-label="Sao chép Email @staff.Email" title="Sao chép Email">
                                    <i class="fa-regular fa-copy" style="font-size: 0.72rem;"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(staff.PhoneNumber))
                            {
                                <div class="d-flex align-items-center gap-1 text-muted font-monospace" style="font-size: 0.73rem;">
                                    <span>@staff.PhoneNumber</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted hover:text-rose-600"
                                            onclick="copyToClipboard('@staff.PhoneNumber', 'Số điện thoại')" aria-label="Sao chép SĐT @staff.PhoneNumber" title="Sao chép SĐT">
                                        <i class="fa-regular fa-copy" style="font-size: 0.7rem;"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="text-slate-400" style="font-size: 0.72rem;">Chưa cập nhật SĐT</div>
                            }
                        </td>

                        <!-- Trạng thái (Switch bật/tắt nhanh nếu có quyền) -->
                        <td class="py-3 px-3 text-center">
                            @if (staff.CanActorEdit)
                            {
                                <div class="d-inline-flex flex-column align-items-center gap-0.5" asp-permission="USER_EDIT">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input cursor-pointer" type="checkbox" role="switch"
                                               checked="@(staff.IsActive ? "checked" : null)"
                                               onchange="quickToggleStaffStatus(@staff.Id, '@staff.FullName', @(staff.IsActive ? "true" : "false"), this)"
                                               aria-label="Bật tắt trạng thái hoạt động của @staff.FullName" />
                                    </div>
                                    <span class="small fw-semibold @(staff.IsActive ? "text-success" : "text-danger")" style="font-size: 0.68rem;">
                                        @(staff.IsActive ? "Hoạt động" : "Đang khóa")
                                    </span>
                                </div>
                            }
                            else
                            {
                                @if (staff.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.7rem;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.7rem;">
                                        <i class="fa-solid fa-lock me-1"></i>Đang khóa
                                    </span>
                                }
                            }
                        </td>

                        <!-- Lần đăng nhập cuối (dạng tương đối "2 giờ trước") -->
                        <td class="py-3 px-3 text-center small">
                            @if (staff.LastLoginAt.HasValue)
                            {
                                <div class="fw-medium text-dark dark:text-slate-200" style="font-size: 0.75rem;">
                                    @FormatRelativeTime(staff.LastLoginAt)
                                </div>
                                <div class="text-slate-400 font-monospace" style="font-size: 0.66rem;">
                                    @staff.LastLoginAt.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                </div>
                            }
                            else
                            {
                                <span class="text-slate-400" style="font-size: 0.73rem;">Chưa đăng nhập</span>
                            }
                        </td>

                        <!-- Ngày tạo -->
                        <td class="py-3 px-3 text-center small font-monospace text-muted" style="font-size: 0.74rem;">
                            <div>@staff.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            @if (staff.HireDate.HasValue)
                            {
                                <div class="text-slate-400" style="font-size: 0.65rem;" title="Ngày vào làm">
                                    Vào: @staff.HireDate.Value.ToString("dd/MM/yy")
                                </div>
                            }
                        </td>

                        <!-- Cột hành động dạng Dropdown (⋯) -->
                        <td class="pe-4 py-3 text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <a href="/Admin/User/Details/@staff.Id" class="btn btn-sm btn-light border rounded-3 px-2 py-1" title="Xem hồ sơ 360°">
                                    <i class="fa-regular fa-eye text-slate-600"></i>
                                </a>

                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border rounded-3 px-2.5 py-1" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false" aria-label="Mở menu hành động cho @staff.FullName">
                                        <i class="fa-solid fa-ellipsis"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 small py-1.5" style="min-width: 200px;">
                                        <li>
                                            <a class="dropdown-item py-1.5 d-flex align-items-center gap-2" href="/Admin/User/Details/@staff.Id">
                                                <i class="fa-regular fa-id-card text-indigo-600" style="width: 16px;"></i>
                                                <span>Xem hồ sơ chi tiết</span>
                                            </a>
                                        </li>

                                        @if (staff.CanActorEdit)
                                        {
                                            <li asp-permission="USER_EDIT">
                                                <a class="dropdown-item py-1.5 d-flex align-items-center gap-2" href="/Admin/User/Edit/@staff.Id">
                                                    <i class="fa-solid fa-user-pen text-primary" style="width: 16px;"></i>
                                                    <span>Chỉnh sửa thông tin</span>
                                                </a>
                                            </li>
                                        }

                                        @if (staff.CanActorDelegate)
                                        {
                                            <li asp-any-permission="PERMISSION_DELEGATE,USER_ASSIGN_ROLE">
                                                <a class="dropdown-item py-1.5 d-flex align-items-center gap-2" href="/Admin/User/Permissions/@staff.Id">
                                                    <i class="fa-solid fa-shield-halved text-rose-600" style="width: 16px;"></i>
                                                    <span>Phân quyền (Ma trận 3 trạng thái)</span>
                                                </a>
                                            </li>
                                        }

                                        @if (staff.CanActorResetPassword)
                                        {
                                            <li asp-permission="USER_RESET_PASSWORD">
                                                <button type="button" class="dropdown-item py-1.5 d-flex align-items-center gap-2"
                                                        onclick="openResetPasswordModal(@staff.Id, '@staff.FullName', '@staff.Username')">
                                                    <i class="fa-solid fa-key text-amber-600" style="width: 16px;"></i>
                                                    <span>Đặt lại mật khẩu</span>
                                                </button>
                                            </li>
                                        }

                                        @if (staff.CanActorEdit)
                                        {
                                            <li asp-permission="USER_EDIT">
                                                <button type="button" class="dropdown-item py-1.5 d-flex align-items-center gap-2"
                                                        onclick="quickToggleStaffStatus(@staff.Id, '@staff.FullName', @(staff.IsActive ? "true" : "false"))">
                                                    @if (staff.IsActive)
                                                    {
                                                        <i class="fa-solid fa-user-lock text-warning" style="width: 16px;"></i>
                                                        <span>Tạm khóa tài khoản</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-lock-open text-success" style="width: 16px;"></i>
                                                        <span>Mở khóa tài khoản</span>
                                                    }
                                                </button>
                                            </li>
                                        }

                                        @if (staff.CanActorDelete)
                                        {
                                            <li asp-permission="USER_DELETE"><hr class="dropdown-divider my-1" /></li>
                                            <li asp-permission="USER_DELETE">
                                                <button type="button" class="dropdown-item py-1.5 d-flex align-items-center gap-2 text-danger fw-semibold"
                                                        onclick="confirmDeleteStaff(@staff.Id, '@staff.FullName', '@staff.Username')">
                                                    <i class="fa-regular fa-trash-can" style="width: 16px;"></i>
                                                    <span>Xóa mềm (Chuyển thùng rác)</span>
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Phân trang & Chọn số dòng/trang -->
@if (Model.TotalItems > 0)
{
    <div class="p-3 border-top bg-white dark:bg-slate-900 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="small text-muted">
                Hiển thị <span class="fw-bold text-dark dark:text-white">@Model.FromItem–@Model.ToItem</span> / <span class="fw-bold text-rose-600">@Model.TotalItems</span> nhân sự
            </div>

            <div class="d-flex align-items-center gap-1.5">
                <label for="bottomPageSizeSelect" class="small text-muted mb-0">Số dòng:</label>
                <select id="bottomPageSizeSelect" class="form-select form-select-sm rounded-3 py-0.5 px-2" style="width: auto; font-size: 0.78rem;"
                        onchange="changeStaffPageSize(this.value)">
                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / trang</option>
                    <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / trang</option>
                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / trang</option>
                    <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100 / trang</option>
                </select>
            </div>
        </div>

        <nav aria-label="Phân trang danh sách nhân sự">
            <ul class="pagination pagination-sm mb-0 gap-1">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <button type="button" class="page-link rounded-2" onclick="goToStaffPage(1)" aria-label="Trang đầu" title="Trang đầu">
                        <i class="fa-solid fa-angles-left" style="font-size: 0.7rem;"></i>
                    </button>
                </li>
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <button type="button" class="page-link rounded-2" onclick="goToStaffPage(@(Model.Page - 1))" aria-label="Trang trước">
                        <i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i>
                    </button>
                </li>

                @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                {
                    int pNum = p;
                    <li class="page-item @(Model.Page == pNum ? "active" : "")">
                        <button type="button" class="page-link rounded-2 fw-semibold" onclick="goToStaffPage(@pNum)">@pNum</button>
                    </li>
                }

                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <button type="button" class="page-link rounded-2" onclick="goToStaffPage(@(Model.Page + 1))" aria-label="Trang sau">
                        <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
                    </button>
                </li>
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <button type="button" class="page-link rounded-2" onclick="goToStaffPage(@Model.TotalPages)" aria-label="Trang cuối" title="Trang cuối">
                        <i class="fa-solid fa-angles-right" style="font-size: 0.7rem;"></i>
                    </button>
                </li>
            </ul>
        </nav>
    </div>
}
