@model Omnichannel.Application.DTOs.HR.StaffFormViewModel
@{
    ViewData["Title"] = "Thêm Mới Nhân Sự Nội Bộ";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a href="/Admin/User" class="text-decoration-none text-muted">Nhân sự</a></li>
                <li class="breadcrumb-item active text-dark dark:text-white fw-semibold" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-plus text-rose-600"></i>
            <span>Tạo Mới Tài Khoản Nhân Sự & Phân Bổ Phòng Ban</span>
        </h4>
        <p class="small text-muted mb-0 mt-1">Khởi tạo tài khoản nhân viên, gán vai trò ban đầu và xác lập người quản lý trực tiếp.</p>
    </div>
</div>

<partial name="_StaffForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
