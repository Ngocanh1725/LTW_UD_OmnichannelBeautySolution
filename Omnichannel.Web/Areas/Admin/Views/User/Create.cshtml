@model Omnichannel.Application.DTOs.Account.CreateUserViewModel
@{
    ViewData["Title"] = "Thêm Mới Nhân Sự";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">Thêm Mới Tài Khoản Nhân Sự</h4>
                <p class="text-muted small mb-0">Cấp tài khoản và chỉ định vai trò ban đầu cho nhân viên</p>
            </div>
            <a href="/Admin/User" class="btn btn-outline-secondary rounded-3 btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="beauty-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold small"></label>
                        <input asp-for="Username" class="form-control rounded-3" placeholder="vd: phuongnguyen" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <input asp-for="FullName" class="form-control rounded-3" placeholder="vd: Nguyễn Thu Phương" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="phuong.nguyen@beauty.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="0901234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small"></label>
                        <input asp-for="Password" class="form-control rounded-3" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RoleId" class="form-label fw-semibold small"></label>
                        <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select rounded-3">
                            <option value="">-- Chọn nhóm vai trò --</option>
                        </select>
                        <span asp-validation-for="RoleId" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <a href="/Admin/User" class="btn btn-light rounded-3 px-4 me-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary-gradient px-4">
                            <i class="fa-solid fa-check me-2"></i>Tạo Tài Khoản
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
