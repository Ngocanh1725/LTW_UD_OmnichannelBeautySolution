@model Omnichannel.Application.DTOs.HR.StaffFormViewModel
@{
    ViewData["Title"] = "Thêm Mới Nhân Sự Nội Bộ";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/Admin/User" class="btn btn-sm btn-outline-secondary rounded-3 px-2.5 py-1">
                <i class="fa-solid fa-arrow-left me-1"></i>Danh sách nhân sự
            </a>
            <span class="badge bg-rose-50 text-rose-700 border border-rose-200 px-2.5 py-1 rounded-pill font-monospace" style="background:#fff1f2;color:#be123c;">
                Thêm Nhân Sự Mới
            </span>
        </div>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-plus text-rose-600"></i>
            <span>Tạo Mới Tài Khoản Nhân Sự & Phân Bổ Phòng Ban</span>
        </h4>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white dark:bg-slate-900">
    <form asp-action="Create" method="post" id="createStaffForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4"></div>

        <h6 class="fw-bold text-dark dark:text-white mb-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-id-card text-rose-600"></i>
            <span>1. Thông Tin Định Danh & Đăng Nhập</span>
        </h6>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="CreateRequest.Username" class="form-label small fw-bold text-dark dark:text-white">
                    Tên đăng nhập (Username) <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted">@@</span>
                    <input asp-for="CreateRequest.Username" id="staffUsernameInput" class="form-control"
                           placeholder="vd: nguyenvana" autocorrect="off" autocapitalize="off" spellcheck="false" onblur="validateUniqueUsername(this.value)" />
                </div>
                <span asp-validation-for="CreateRequest.Username" class="text-danger small"></span>
                <div id="usernameCheckMsg" class="small mt-1"></div>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.FullName" class="form-label small fw-bold text-dark dark:text-white">
                    Họ và tên <span class="text-danger">*</span>
                </label>
                <input asp-for="CreateRequest.FullName" class="form-control" placeholder="vd: Nguyễn Văn An" />
                <span asp-validation-for="CreateRequest.FullName" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.EmployeeCode" class="form-label small fw-bold text-dark dark:text-white">
                    Mã nhân viên (EmployeeCode)
                </label>
                <input asp-for="CreateRequest.EmployeeCode" id="staffCodeInput" class="form-control font-monospace"
                       placeholder="vd: NV0019" autocorrect="off" autocapitalize="off" spellcheck="false" onblur="validateUniqueCode(this.value)" />
                <span asp-validation-for="CreateRequest.EmployeeCode" class="text-danger small"></span>
                <div id="codeCheckMsg" class="small mt-1"></div>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.Email" class="form-label small fw-bold text-dark dark:text-white">
                    Địa chỉ Email <span class="text-danger">*</span>
                </label>
                <input asp-for="CreateRequest.Email" id="staffEmailInput" type="email" class="form-control"
                       placeholder="vd: an.nguyen@canmakebeauty.vn" autocorrect="off" autocapitalize="off" spellcheck="false" onblur="validateUniqueEmail(this.value)" />
                <span asp-validation-for="CreateRequest.Email" class="text-danger small"></span>
                <div id="emailCheckMsg" class="small mt-1"></div>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.PhoneNumber" class="form-label small fw-bold text-dark dark:text-white">
                    Số điện thoại
                </label>
                <input asp-for="CreateRequest.PhoneNumber" class="form-control font-monospace" placeholder="vd: 0901234567" />
                <span asp-validation-for="CreateRequest.PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.Password" class="form-label small fw-bold text-dark dark:text-white">
                    Mật khẩu ban đầu <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input asp-for="CreateRequest.Password" id="staffPasswordInput" class="form-control font-monospace" placeholder="Tối thiểu 8 ký tự..." />
                    <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPassword()" title="Sinh ngẫu nhiên">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </button>
                </div>
                <span asp-validation-for="CreateRequest.Password" class="text-danger small"></span>
            </div>
        </div>

        <hr class="my-4 border-slate-200 dark:border-slate-700" />

        <h6 class="fw-bold text-dark dark:text-white mb-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-sitemap text-indigo-600"></i>
            <span>2. Cơ Cấu Tổ Chức & Nơi Làm Việc</span>
        </h6>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="CreateRequest.DepartmentId" class="form-label small fw-bold text-dark dark:text-white">
                    Phòng ban trực thuộc
                </label>
                <select asp-for="CreateRequest.DepartmentId" class="form-select rounded-3">
                    <option value="">-- Chọn phòng ban --</option>
                    @foreach (var d in Model.ScopedDepartments)
                    {
                        <option value="@d.Id">@d.Name (@d.Code)</option>
                    }
                </select>
                <span asp-validation-for="CreateRequest.DepartmentId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.JobTitle" class="form-label small fw-bold text-dark dark:text-white">
                    Chức danh công việc
                </label>
                <input asp-for="CreateRequest.JobTitle" class="form-control" placeholder="vd: Chuyên Viên Tư Vấn & Chốt Đơn" />
                <span asp-validation-for="CreateRequest.JobTitle" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.StoreId" class="form-label small fw-bold text-dark dark:text-white">
                    Chi nhánh / Điểm làm việc
                </label>
                <select asp-for="CreateRequest.StoreId" class="form-select rounded-3">
                    <option value="">Trụ sở chính / Văn phòng</option>
                    @foreach (var s in Model.ScopedStores)
                    {
                        <option value="@s.Id">@s.Name (@s.Code)</option>
                    }
                </select>
                <span asp-validation-for="CreateRequest.StoreId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.ManagerId" class="form-label small fw-bold text-dark dark:text-white">
                    Người quản lý trực tiếp
                </label>
                <select asp-for="CreateRequest.ManagerId" class="form-select rounded-3">
                    <option value="">-- Không chỉ định / Trực thuộc cấp cao --</option>
                    @foreach (var m in Model.PotentialManagers)
                    {
                        <option value="@m.Id">@m.FullName (@($"@{m.Username}") - @(m.JobTitle ?? "Quản lý"))</option>
                    }
                </select>
                <span asp-validation-for="CreateRequest.ManagerId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CreateRequest.Gender" class="form-label small fw-bold text-dark dark:text-white">
                    Giới tính
                </label>
                <select asp-for="CreateRequest.Gender" class="form-select rounded-3">
                    <option value="">Chưa xác định</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Nam">Nam</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="col-md-2">
                <label asp-for="CreateRequest.DateOfBirth" class="form-label small fw-bold text-dark dark:text-white">
                    Ngày sinh (≥ 16 tuổi)
                </label>
                <input asp-for="CreateRequest.DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="CreateRequest.DateOfBirth" class="text-danger small"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="CreateRequest.HireDate" class="form-label small fw-bold text-dark dark:text-white">
                    Ngày vào làm (≤ hôm nay)
                </label>
                <input asp-for="CreateRequest.HireDate" type="date" class="form-control" />
                <span asp-validation-for="CreateRequest.HireDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CreateRequest.Address" class="form-label small fw-bold text-dark dark:text-white">
                    Địa chỉ thường trú / liên hệ
                </label>
                <input asp-for="CreateRequest.Address" class="form-control" placeholder="vd: Số 123 Đường Cầu Giấy, Hà Nội" />
            </div>

            <div class="col-md-6">
                <label asp-for="CreateRequest.Notes" class="form-label small fw-bold text-dark dark:text-white">
                    Ghi chú nội bộ
                </label>
                <input asp-for="CreateRequest.Notes" class="form-control" placeholder="vd: Nhân viên thử việc 2 tháng, ca làm việc sáng" />
            </div>
        </div>

        <hr class="my-4 border-slate-200 dark:border-slate-700" />

        <h6 class="fw-bold text-dark dark:text-white mb-2 d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved text-emerald-600"></i>
            <span>3. Phân Vai Trò Ban Đầu (Role Assignment)</span>
        </h6>
        <p class="small text-muted mb-3">
            Chọn các vai trò phù hợp với phạm vi thẩm quyền của bạn (chỉ hiển thị các vai trò có cấp bậc nhỏ hơn <code>MaxGrantLevel = @Model.ActorContext.MaxGrantLevel</code>).
        </p>

        <div class="d-flex flex-wrap gap-2.5 mb-4">
            @foreach (var r in Model.AssignableRoles)
            {
                <label class="border rounded-3 p-2.5 px-3 d-inline-flex align-items-center gap-2 bg-light dark:bg-slate-800 cursor-pointer hover:border-rose-400">
                    <input type="checkbox" name="CreateRequest.RoleIds" value="@r.Id" class="form-check-input m-0" />
                    <div>
                        <div class="fw-bold small text-dark dark:text-white">@r.DisplayName</div>
                        <div class="text-muted font-monospace" style="font-size: 0.68rem;">@r.Name • Cấp bậc Lv@r.Level</div>
                    </div>
                </label>
            }
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a href="/Admin/User" class="btn btn-light rounded-3 px-4 fw-semibold">Hủy Bỏ</a>
            <button type="submit" class="btn btn-primary-gradient px-4 py-2 text-white fw-semibold rounded-3 shadow-xs">
                <i class="fa-solid fa-check me-1.5"></i>Tạo Nhân Sự Mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function generateRandomPassword() {
            const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!#$%&*+';
            let pwd = 'Canmake2026!';
            for (let i = 0; i < 6; i++) {
                pwd += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('staffPasswordInput').value = pwd;
        }

        async function validateUniqueUsername(username) {
            if (!username || username.trim().length < 3) return;
            const res = await fetch(`/Admin/User/CheckUsername?username=${encodeURIComponent(username.trim())}`);
            const isValid = await res.json();
            const msgEl = document.getElementById('usernameCheckMsg');
            if (!isValid) {
                msgEl.className = 'small mt-1 text-danger';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i>Tên đăng nhập này đã được sử dụng!';
            } else {
                msgEl.className = 'small mt-1 text-success';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Tên đăng nhập hợp lệ.';
            }
        }

        async function validateUniqueEmail(email) {
            if (!email || !email.includes('@@')) return;
            const res = await fetch(`/Admin/User/CheckEmail?email=${encodeURIComponent(email.trim())}`);
            const isValid = await res.json();
            const msgEl = document.getElementById('emailCheckMsg');
            if (!isValid) {
                msgEl.className = 'small mt-1 text-danger';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i>Địa chỉ Email này đã tồn tại!';
            } else {
                msgEl.className = 'small mt-1 text-success';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Email hợp lệ.';
            }
        }

        async function validateUniqueCode(code) {
            if (!code || !code.trim()) return;
            const res = await fetch(`/Admin/User/CheckEmployeeCode?code=${encodeURIComponent(code.trim())}`);
            const isValid = await res.json();
            const msgEl = document.getElementById('codeCheckMsg');
            if (!isValid) {
                msgEl.className = 'small mt-1 text-danger';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i>Mã nhân viên đã được cấp!';
            } else {
                msgEl.className = 'small mt-1 text-success';
                msgEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Mã nhân viên hợp lệ.';
            }
        }
    </script>
}
