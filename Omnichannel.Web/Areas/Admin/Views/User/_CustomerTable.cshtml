@model Omnichannel.Application.DTOs.HR.PagedResult<Omnichannel.Application.DTOs.HR.CustomerUserListItemDto>

<div class="table-responsive" tabindex="0" role="region" aria-label="Bảng tài khoản khách hàng">
    <table class="table table-hover align-middle mb-0 text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold uppercase tracking-wider border-b">
            <tr>
                <th class="ps-4 py-3">Họ Tên / Username</th>
                <th class="py-3 px-3">Email & SĐT</th>
                <th class="py-3 px-3 text-center">Đơn Hàng</th>
                <th class="py-3 px-3 text-end">Tổng Chi Tiêu</th>
                <th class="py-3 px-3 text-center">Trạng Thái</th>
                <th class="py-3 px-3 text-center">Đăng Nhập Cuối</th>
                <th class="pe-4 py-3 text-end" style="width: 170px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted mb-2" style="width: 48px; height: 48px;">
                            <i class="fa-solid fa-users-slash fs-4"></i>
                        </div>
                        <div class="fw-bold text-dark dark:text-white">Không tìm thấy tài khoản khách hàng nào</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var cust in Model.Items)
                {
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white shadow-xs flex-shrink-0"
                                     style="width: 36px; height: 36px; font-size: 13px; background: linear-gradient(135deg, #ec4899, #8b5cf6);">
                                    @(cust.FullName.Length > 0 ? cust.FullName[0].ToString().ToUpper() : "K")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark dark:text-white">@cust.FullName</div>
                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">@@@cust.Username</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-3 small">
                            <div class="text-dark dark:text-white">@cust.Email</div>
                            <div class="text-muted font-monospace" style="font-size: 0.72rem;">@(cust.PhoneNumber ?? "Chưa có SĐT")</div>
                        </td>
                        <td class="py-3 px-3 text-center small fw-bold">
                            @cust.TotalOrders đơn
                        </td>
                        <td class="py-3 px-3 text-end font-monospace small fw-bold text-rose-600">
                            @cust.TotalSpent.ToString("N0") đ
                        </td>
                        <td class="py-3 px-3 text-center">
                            @if (cust.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                                    <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                                    <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                </span>
                            }
                        </td>
                        <td class="py-3 px-3 text-center small text-muted font-monospace" style="font-size: 0.72rem;">
                            @(cust.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="d-inline-flex align-items-center gap-1.5">
                                <a href="/Admin/Customer" class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1" title="Xem hồ sơ sắc đẹp CRM">
                                    <i class="fa-solid fa-address-book text-pink-500 me-1"></i>CRM
                                </a>

                                <form asp-action="ToggleCustomerStatus" asp-route-id="@cust.Id" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    @if (cust.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2 py-1" title="Tạm khóa tài khoản" onclick="return confirm('Bạn có chắc muốn tạm khóa tài khoản khách hàng @cust.Username?')">
                                            <i class="fa-solid fa-user-lock"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2 py-1" title="Mở khóa tài khoản">
                                            <i class="fa-solid fa-lock-open"></i>
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalItems > 0)
{
    <div class="p-3 border-top bg-white dark:bg-slate-900 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="small text-muted">
            Hiển thị <span class="fw-bold text-dark dark:text-white">@Model.FromItem</span> - <span class="fw-bold text-dark dark:text-white">@Model.ToItem</span> trên tổng số <span class="fw-bold text-dark dark:text-white">@Model.TotalItems</span> khách hàng
        </div>
    </div>
}

