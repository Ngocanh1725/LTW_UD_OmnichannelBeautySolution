@model Omnichannel.Application.DTOs.HR.PagedResult<Omnichannel.Application.DTOs.HR.CustomerUserListItemDto>

<div class="table-responsive" tabindex="0" role="region" aria-label="Bảng tài khoản khách hàng">
    <table class="table table-hover align-middle mb-0 text-sm">
        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-bold uppercase tracking-wider border-b">
            <tr>
                <th class="ps-4 py-3">Khách Hàng</th>
                <th class="py-3 px-3">Email & SĐT</th>
                <th class="py-3 px-3 text-center">Hạng Thành Viên</th>
                <th class="py-3 px-3 text-center">Tổng Đơn</th>
                <th class="py-3 px-3 text-center">Trạng Thái</th>
                <th class="py-3 px-3 text-center">Ngày Tạo</th>
                <th class="pe-4 py-3 text-end" style="width: 190px;">Hành Động</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light text-muted mb-2" style="width: 52px; height: 52px;">
                            <i class="fa-solid fa-users-slash fs-4"></i>
                        </div>
                        <div class="fw-bold text-dark dark:text-white">Không tìm thấy tài khoản khách hàng phù hợp</div>
                        <div class="small text-muted mt-1">Thử thay đổi từ khóa tìm kiếm hoặc trạng thái lọc.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var cust in Model.Items)
                {
                    string tierName = !string.IsNullOrWhiteSpace(cust.MemberTierName) ? cust.MemberTierName : "Member";
                    <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-2.5">
                                @if (!string.IsNullOrWhiteSpace(cust.AvatarUrl))
                                {
                                    <img src="@cust.AvatarUrl" alt="@cust.FullName" class="rounded-circle object-fit-cover flex-shrink-0 border" style="width: 38px; height: 38px;" />
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold text-white shadow-xs flex-shrink-0"
                                         style="width: 38px; height: 38px; font-size: 14px; background: linear-gradient(135deg, #ec4899, #6366f1);">
                                        @(cust.FullName.Length > 0 ? cust.FullName[0].ToString().ToUpper() : "K")
                                    </div>
                                }
                                <div>
                                    <div class="fw-bold text-dark dark:text-white">@cust.FullName</div>
                                    <div class="text-muted font-monospace" style="font-size: 0.72rem;">@@@cust.Username</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-3 small">
                            <div class="text-dark dark:text-white">@cust.Email</div>
                            <div class="text-muted font-monospace" style="font-size: 0.72rem;">@(cust.PhoneNumber ?? "Chưa cập nhật SĐT")</div>
                        </td>
                        <td class="py-3 px-3 text-center">
                            <span class="badge rounded-pill px-2.5 py-1 fw-semibold"
                                  style="background:#fdf2f8;color:#be185d;border:1px solid #fbcfe8;font-size:0.72rem;">
                                <i class="fa-solid fa-crown me-1 text-warning"></i>@tierName
                            </span>
                        </td>
                        <td class="py-3 px-3 text-center small">
                            <div class="fw-bold text-dark dark:text-white">@cust.TotalOrders đơn</div>
                            <div class="text-rose-600 font-monospace fw-semibold" style="font-size: 0.72rem;">@cust.TotalSpent.ToString("N0") đ</div>
                        </td>
                        <td class="py-3 px-3 text-center">
                            @if (cust.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                                    <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                                    <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                </span>
                            }
                        </td>
                        <td class="py-3 px-3 text-center small text-muted font-monospace" style="font-size: 0.74rem;">
                            @cust.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <!-- Chỉ có nút sang CRM và Khóa/Mở khóa — tuyệt đối KHÔNG có nút phân quyền nội bộ -->
                            <div class="d-inline-flex align-items-center gap-1.5">
                                <a href="/Admin/Customer?keyword=@Uri.EscapeDataString(cust.Email)"
                                   class="btn btn-sm btn-outline-primary rounded-3 px-2.5 py-1 fw-semibold"
                                   title="Mở hồ sơ khách hàng trên phân hệ CRM">
                                    <i class="fa-solid fa-address-book me-1"></i>Sang CRM
                                </a>

                                <form asp-action="ToggleCustomerStatus" asp-route-id="@cust.Id" method="post" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    @if (cust.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2 py-1"
                                                title="Khóa tài khoản khách hàng"
                                                onclick="return confirm('Xác nhận tạm khóa tài khoản khách hàng @cust.FullName?')">
                                            <i class="fa-solid fa-user-lock"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2 py-1"
                                                title="Mở khóa tài khoản khách hàng">
                                            <i class="fa-solid fa-lock-open"></i>
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalItems > 0)
{
    <div class="p-3 border-top bg-white dark:bg-slate-900 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="small text-muted">
            Hiển thị <span class="fw-bold text-dark dark:text-white">@Model.FromItem–@Model.ToItem</span> / <span class="fw-bold text-dark dark:text-white">@Model.TotalItems</span> khách hàng
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang khách hàng">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link rounded-2" href="/Admin/User/Customers?Page=@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
}
