@model Omnichannel.Application.DTOs.HR.StaffFormViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa Hồ Sơ - {Model.UpdateRequest.FullName}";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a href="/Admin/User" class="text-decoration-none text-muted">Nhân sự</a></li>
                <li class="breadcrumb-item active text-dark dark:text-white fw-semibold" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-pen text-rose-600"></i>
            <span>Chỉnh Sửa Hồ Sơ: @Model.UpdateRequest.FullName</span>
        </h4>
        <p class="small text-muted mb-0 mt-1 font-monospace">@@@Model.Username • Cập nhật thông tin công tác, phòng ban và vai trò</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a href="/Admin/User/Details/@Model.StaffId" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold shadow-2xs">
            <i class="fa-regular fa-eye me-1.5"></i>Xem Hồ Sơ 360
        </a>
        <a asp-permission="PERMISSION_DELEGATE" href="/Admin/User/Permissions/@Model.StaffId" class="btn btn-outline-rose btn-sm px-3 py-2 rounded-3 fw-semibold shadow-2xs" style="border-color:#f43f5e;color:#e11d48;">
            <i class="fa-solid fa-shield-halved me-1.5"></i>Phân Quyền Chi Tiết
        </a>
    </div>
</div>

<partial name="_StaffForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
