@model Omnichannel.Application.DTOs.HR.StaffFormViewModel
@{
    ViewData["Title"] = $"Chỉnh Sửa Nhân Sự - {Model.UpdateRequest.FullName}";
    Layout = "_AdminLayout";
}

<!-- Breadcrumb & Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb" class="mb-1">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Admin/User" class="text-decoration-none text-muted">Quản Lý Nhân Sự</a></li>
                <li class="breadcrumb-item"><a href="/Admin/User/Details/@Model.StaffId" class="text-decoration-none text-muted">@Model.UpdateRequest.FullName</a></li>
                <li class="breadcrumb-item active fw-semibold text-rose-600" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-slate-900 dark:text-white mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-user-pen text-rose-600"></i>
            <span>Chỉnh Sửa Hồ Sơ: @Model.UpdateRequest.FullName</span>
            <span class="badge rounded-pill font-monospace fw-normal" style="background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe;font-size:0.72rem;">
                @@@Model.Username • ID #@Model.StaffId
            </span>
        </h4>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/Admin/User" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold rounded-3">
            <i class="fa-solid fa-arrow-left me-1.5"></i>Danh sách
        </a>
        <a href="/Admin/User/Details/@Model.StaffId" class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold rounded-3">
            <i class="fa-regular fa-id-card me-1.5"></i>Hồ sơ 360°
        </a>
        <a asp-permission="PERMISSION_DELEGATE" href="/Admin/User/Permissions/@Model.StaffId"
           class="btn btn-sm px-3 py-2 fw-semibold rounded-3"
           style="background:#fff1f2;color:#be123c;border:1px solid #fecdd3;">
            <i class="fa-solid fa-shield-halved me-1.5"></i>Phân quyền
        </a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.StaffId" method="post" id="editStaffForm" novalidate>
    @Html.AntiForgeryToken()
    <partial name="_StaffForm" model="Model" />
</form>

<partial name="_MediaPickerModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
