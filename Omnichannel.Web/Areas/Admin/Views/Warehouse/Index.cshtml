<div class="warehouse-desktop-scale" style="zoom: 0.84;">
@model Omnichannel.Application.DTOs.Inventory.WarehouseOverviewViewModel
@{
    ViewData["Title"] = "Quản Trị Kho & Lô Date FEFO";
    Layout = "_AdminLayout";
    var productList = ViewBag.ProductList as List<SelectListItem> ?? new List<SelectListItem>();
    var supplierList = ViewBag.SupplierList as List<SelectListItem> ?? new List<SelectListItem>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
            <div><strong>Thành công!</strong> @TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2 text-danger"></i>
            <div><strong>Thông báo lỗi:</strong> @TempData["ErrorMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Header Điều Hành & Nút Thao Tác -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="fw-bold text-dark mb-0">Quản Trị Kho Vận & Lô Date (FEFO Engine)</h4>
            <span class="badge bg-purple-subtle text-purple border font-monospace px-2.5 py-1">FEFO v2.4</span>
        </div>
        <p class="text-muted small mb-0">Theo dõi hạn sử dụng mỹ phẩm, tự động phân bổ lô date cận theo nguyên tắc FEFO và điều chuyển liên chi nhánh</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-primary rounded-pill px-3 fw-semibold" onclick="openCreateTransferModal()">
            <i class="fa-solid fa-truck-ramp-box me-1.5"></i>Tạo Phiếu Chuyển Kho
        </button>
        <button class="btn btn-primary-gradient rounded-pill px-3.5 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#importBatchModal">
            <i class="fa-solid fa-boxes-packing me-1.5"></i>Nhập Lô Mới (PO)
        </button>
    </div>
</div>

<!-- Thanh Lựa Chọn Kho & Thẻ Thống Kê Cảnh Báo Màu Sắc -->
<div class="row g-3 mb-4">
    <!-- Chọn Kho Hàng -->
    <div class="col-12 col-md-6 col-xl-3">
        <div class="beauty-card p-3 h-100 d-flex flex-column justify-content-center bg-white shadow-sm border-0">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small fw-semibold text-secondary mb-0">Đang chọn chi nhánh / kho:</label>
                <i class="fa-solid fa-warehouse text-purple"></i>
            </div>
            <select class="form-select rounded-3 fw-semibold border-secondary-subtle" onchange="location.href='?storeId=' + this.value">
                @foreach (var s in Model.AvailableStores)
                {
                    if (s.StoreId == Model.SelectedStoreId)
                    {
                        <option value="@s.StoreId" selected>@s.StoreName @(s.IsCentralWarehouse ? "⭐ [Tổng kho]" : "")</option>
                    }
                    else
                    {
                        <option value="@s.StoreId">@s.StoreName @(s.IsCentralWarehouse ? "⭐ [Tổng kho]" : "")</option>
                    }
                }
            </select>
            <div class="d-flex justify-content-between mt-2 font-monospace text-muted" style="font-size: 11px;">
                <span>Tổng giá trị tồn:</span>
                <strong class="text-dark">@Model.TotalStockValue.ToString("N0") đ</strong>
            </div>
        </div>
    </div>

    <!-- Stat 1: Cảnh báo Hết Hạn (ĐỎ) -->
    <div class="col-6 col-md-6 col-xl-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=EXPIRED" class="text-decoration-none">
            <div class="beauty-card p-3 h-100 d-flex align-items-center gap-3 border border-danger-subtle bg-white shadow-sm @(Model.FilterStatus == "EXPIRED" ? "ring-2 ring-danger shadow-md" : "")" style="background: linear-gradient(135deg, #FEF2F2 0%, #FFFFFF 100%);">
                <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center shadow-sm" style="background: #FEE2E2; color: #DC2626; width: 50px; height: 50px; font-size: 22px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <div class="text-danger small fw-bold">Lô Đã Hết Hạn</div>
                    <div class="h3 fw-bold mb-0 text-danger font-monospace">@Model.TotalExpiredBatches</div>
                    <span class="text-muted" style="font-size: 11px;">Cần xuất hủy ngay</span>
                </div>
            </div>
        </a>
    </div>

    <!-- Stat 2: Cảnh báo Cận Date <= 60 ngày (VÀNG / CAM) -->
    <div class="col-6 col-md-6 col-xl-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=NEAR_EXPIRY" class="text-decoration-none">
            <div class="beauty-card p-3 h-100 d-flex align-items-center gap-3 border border-warning-subtle bg-white shadow-sm @(Model.FilterStatus == "NEAR_EXPIRY" ? "ring-2 ring-warning shadow-md" : "")" style="background: linear-gradient(135deg, #FFFBEB 0%, #FFFFFF 100%);">
                <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center shadow-sm" style="background: #FEF3C7; color: #D97706; width: 50px; height: 50px; font-size: 22px;">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <div class="text-warning small fw-bold" style="color: #B45309 !important;">Lô Cận Date (&le;60d)</div>
                    <div class="h3 fw-bold mb-0 text-dark font-monospace">@Model.TotalNearExpiryBatches</div>
                    <span class="text-muted" style="font-size: 11px;">Ưu tiên xuất FEFO</span>
                </div>
            </div>
        </a>
    </div>

    <!-- Stat 3: Cảnh báo Dưới Tồn An Toàn (CAM NHẠT) -->
    <div class="col-6 col-md-6 col-xl-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=LOW_STOCK" class="text-decoration-none">
            <div class="beauty-card p-3 h-100 d-flex align-items-center gap-3 border border-secondary-subtle bg-white shadow-sm @(Model.FilterStatus == "LOW_STOCK" ? "ring-2 ring-primary shadow-md" : "")" style="background: linear-gradient(135deg, #FEFCE8 0%, #FFFFFF 100%);">
                <div class="rounded-4 p-2.5 d-flex align-items-center justify-content-center shadow-sm" style="background: #FEF9C3; color: #CA8A04; width: 50px; height: 50px; font-size: 22px;">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <div>
                    <div class="small fw-bold" style="color: #A16207;">Dưới Tồn An Toàn</div>
                    <div class="h3 fw-bold mb-0 text-dark font-monospace">@Model.TotalLowStockBatches</div>
                    <span class="text-muted" style="font-size: 11px;">Tồn &le; 10 sản phẩm</span>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- RADAR HẠN DÙNG MỸ PHẨM FEFO: 3 TẦNG CẢNH BÁO MÀU SẮC TRỰC QUAN -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="p-2 rounded-3 bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center">
                <i class="fa-solid fa-radar fs-5"></i>
            </span>
            <div>
                <h5 class="fw-bold text-dark mb-0">Radar Hạn Dùng Mỹ Phẩm FEFO (First Expired, First Out)</h5>
                <span class="small text-muted">Giám sát rủi ro hết hạn mỹ phẩm theo 3 ngưỡng chuẩn: Khẩn cấp (&le; 30 ngày) &bull; Cảnh báo (&le; 60 ngày) &bull; An toàn (&gt; 60 ngày)</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="?storeId=@Model.SelectedStoreId" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-rotate-left me-1"></i>Xem Toàn Bộ Lô
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <!-- Tầng 1: ĐỎ - KHẨN CẤP (<= 30 NGÀY HOẶC ĐÃ HẾT HẠN) -->
            <div class="col-md-4">
                <div class="p-3.5 rounded-4 h-100 border border-danger-subtle d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #FFF1F2 0%, #FFFFFF 100%);">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-danger text-white rounded-pill px-3 py-1 font-monospace fw-bold">
                                <i class="fa-solid fa-circle-exclamation me-1"></i>ĐỎ: KHẨN CẤP (&le; 30 NGÀY)
                            </span>
                            <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span>
                        </div>
                        <div class="h2 fw-bold text-danger font-monospace mb-1">@Model.FefoCriticalCount <span class="fs-6 text-muted fw-normal">lô hàng</span></div>
                        <p class="small text-danger opacity-85 mb-3" style="font-size: 12px;">Hạn dùng dưới 30 ngày hoặc đã hết hạn. Cần kích hoạt Flash Sale thanh lý xả hàng hoặc lập biên bản xuất hủy.</p>
                    </div>
                    <div>
                        <a href="?storeId=@Model.SelectedStoreId&filterStatus=CRITICAL_30" class="btn btn-sm btn-danger w-100 rounded-pill fw-semibold shadow-sm">
                            <i class="fa-solid fa-filter me-1.5"></i>Lọc Lô Khẩn Cấp (&le; 30 ngày)
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tầng 2: VÀNG - CẢNH BÁO (31 - 60 NGÀY) -->
            <div class="col-md-4">
                <div class="p-3.5 rounded-4 h-100 border border-warning-subtle d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #FFFBEB 0%, #FFFFFF 100%);">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-1 font-monospace fw-bold">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>VÀNG: CẢNH BÁO (&le; 60 NGÀY)
                            </span>
                            <i class="fa-solid fa-clock text-warning fs-5"></i>
                        </div>
                        <div class="h2 fw-bold text-dark font-monospace mb-1">@Model.FefoWarningCount <span class="fs-6 text-muted fw-normal">lô hàng</span></div>
                        <p class="small text-secondary mb-3" style="font-size: 12px;">Hạn dùng từ 31 đến 60 ngày. Động cơ FEFO tự động ưu tiên xuất bán tại quầy POS hoặc điều chuyển tới showroom bán chạy.</p>
                    </div>
                    <div>
                        <a href="?storeId=@Model.SelectedStoreId&filterStatus=WARNING_60" class="btn btn-sm btn-outline-warning text-dark w-100 rounded-pill fw-semibold">
                            <i class="fa-solid fa-filter me-1.5"></i>Lọc Lô Cảnh Báo (31 - 60 ngày)
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tầng 3: XANH - AN TOÀN (> 60 NGÀY) -->
            <div class="col-md-4">
                <div class="p-3.5 rounded-4 h-100 border border-success-subtle d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #F0FDF4 0%, #FFFFFF 100%);">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success text-white rounded-pill px-3 py-1 font-monospace fw-bold">
                                <i class="fa-solid fa-shield-halved me-1"></i>XANH: AN TOÀN (&gt; 60 NGÀY)
                            </span>
                            <i class="fa-solid fa-circle-check text-success fs-5"></i>
                        </div>
                        <div class="h2 fw-bold text-success font-monospace mb-1">@Model.FefoSafeCount <span class="fs-6 text-muted fw-normal">lô hàng</span></div>
                        <p class="small text-success opacity-85 mb-3" style="font-size: 12px;">Hạn dùng trên 60 ngày (đủ điều kiện bán lẻ tiêu chuẩn và đơn hàng thương mại điện tử gửi xa toàn quốc).</p>
                    </div>
                    <div>
                        <a href="?storeId=@Model.SelectedStoreId&filterStatus=SAFE_60" class="btn btn-sm btn-outline-success w-100 rounded-pill fw-semibold">
                            <i class="fa-solid fa-filter me-1.5"></i>Lọc Lô An Toàn (&gt; 60 ngày)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- NAV TABS: TỒN KHO FEFO vs ĐIỀU CHUYỂN KHO vs NHẬT KÝ KIỂM TOÁN -->
<ul class="nav nav-pills mb-3 gap-2 border-bottom pb-2" id="warehouseTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2" id="tab-inventory" data-bs-toggle="pill" data-bs-target="#content-inventory" type="button" role="tab">
            <i class="fa-solid fa-boxes-stacked"></i>
            <span>Tồn Kho Theo Lô (FEFO)</span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill font-monospace ms-1">@Model.BatchStockItems.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2" id="tab-transfers" data-bs-toggle="pill" data-bs-target="#content-transfers" type="button" role="tab">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Điều Chuyển Kho Liên Chi Nhánh</span>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill font-monospace ms-1">@Model.RecentTransfers.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-4 py-2 fw-semibold d-flex align-items-center gap-2" id="tab-inventory-logs" data-bs-toggle="pill" data-bs-target="#content-inventory-logs" type="button" role="tab">
            <i class="fa-solid fa-book-journal-whills"></i>
            <span>Nhật Ký Tồn Kho Bất Biến (Logs)</span>
            <span class="badge bg-primary-subtle text-primary rounded-pill font-monospace ms-1">@Model.InventoryLogs.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="warehouseTabContent">
    <!-- TAB 1: DANH SÁCH LÔ HÀNG FEFO -->
    <div class="tab-pane fade show active" id="content-inventory" role="tabpanel">
        <div class="beauty-card overflow-hidden bg-white shadow-sm border-0 rounded-4">
            <!-- Filter Bar & Search Input -->
            <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light">
                <form method="get" class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 450px;">
                    <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
                    <input type="hidden" name="filterStatus" value="@Model.FilterStatus" />
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                        <input type="text" name="keyword" class="form-control border-start-0" placeholder="Tìm tên mỹ phẩm, SKU, số hiệu lô..." value="@Model.Keyword" autocomplete="off" />
                        <button type="submit" class="btn btn-primary px-3">Tìm</button>
                        @if (!string.IsNullOrEmpty(Model.Keyword))
                        {
                            <a href="?storeId=@Model.SelectedStoreId&filterStatus=@Model.FilterStatus" class="btn btn-outline-secondary">Xóa</a>
                        }
                    </div>
                </form>

                <!-- Filter Status Badges -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted me-1">Bộ lọc:</span>
                    <a href="?storeId=@Model.SelectedStoreId" class="badge rounded-pill text-decoration-none px-3 py-2 @(string.IsNullOrEmpty(Model.FilterStatus) ? "bg-dark text-white" : "bg-light text-secondary border")">Tất cả</a>
                    <a href="?storeId=@Model.SelectedStoreId&filterStatus=CRITICAL_30" class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.FilterStatus == "CRITICAL_30" ? "bg-danger text-white" : "bg-danger-subtle text-danger border border-danger-subtle")">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>🔴 Khẩn cấp (&le;30d)
                    </a>
                    <a href="?storeId=@Model.SelectedStoreId&filterStatus=WARNING_60" class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.FilterStatus == "WARNING_60" ? "bg-warning text-dark" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                        <i class="fa-solid fa-clock me-1"></i>🟡 Cảnh báo (&le;60d)
                    </a>
                    <a href="?storeId=@Model.SelectedStoreId&filterStatus=SAFE_60" class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.FilterStatus == "SAFE_60" ? "bg-success text-white" : "bg-success-subtle text-success border border-success-subtle")">
                        <i class="fa-solid fa-shield-halved me-1"></i>🟢 An toàn (&gt;60d)
                    </a>
                    <a href="?storeId=@Model.SelectedStoreId&filterStatus=EXPIRED" class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.FilterStatus == "EXPIRED" ? "bg-danger text-white" : "bg-light text-muted border")">
                        <i class="fa-solid fa-ban me-1"></i>Đã hết hạn
                    </a>
                    <a href="?storeId=@Model.SelectedStoreId&filterStatus=LOW_STOCK" class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.FilterStatus == "LOW_STOCK" ? "bg-info text-dark" : "bg-info-subtle text-info-emphasis border border-info-subtle")">
                        <i class="fa-solid fa-box-open me-1"></i>Tồn thấp
                    </a>
                </div>
            </div>

            <!-- Table FEFO Batches -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-white border-bottom">
                        <tr class="small text-secondary" style="font-size: 12px;">
                            <th class="py-3 px-3" style="width: 40px;">#</th>
                            <th class="py-3">Mỹ phẩm & SKU</th>
                            <th class="py-3">Số hiệu Lô (Batch)</th>
                            <th class="py-3">Ngày SX</th>
                            <th class="py-3">Hạn sử dụng (FEFO)</th>
                            <th class="py-3 text-center" style="width: 130px;">Tồn kho / Ban đầu</th>
                            <th class="py-3 text-center" style="width: 140px;">Tỷ lệ đã bán</th>
                            <th class="py-3 text-center">Khả dụng</th>
                            <th class="py-3">Tình trạng HSD</th>
                            <th class="py-3 px-3 text-end" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BatchStockItems.Any()) 
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <div class="p-4 rounded-circle bg-light d-inline-block mb-3">
                                        <i class="fa-solid fa-box-open fs-1 text-secondary opacity-50"></i>
                                    </div>
                                    <div class="fw-semibold text-dark">Không có lô hàng nào phù hợp với bộ lọc.</div>
                                    <div class="small text-muted mt-1">Thử thay đổi chi nhánh hoặc nhập thêm lô mới vào kho.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index = 1;
                            foreach (var item in Model.BatchStockItems)
                            {
                                // Alert color classes based on FEFO days remaining (Red <= 30d, Yellow <= 90d, Green > 90d)
                                bool isRedTier = item.IsExpired || item.DaysRemaining <= 30;
                                bool isYellowTier = !isRedTier && item.DaysRemaining <= 90;
                                bool isGreenTier = item.DaysRemaining > 90;

                                string statusBgClass = isRedTier ? "bg-danger text-white border-danger" 
                                    : (isYellowTier ? "bg-warning text-dark border-warning" 
                                    : "bg-success text-white border-success");

                                string rowStyle = isRedTier ? "background: rgba(254, 226, 226, 0.45); border-left: 4px solid #ef4444;" 
                                    : (isYellowTier ? "background: rgba(254, 243, 199, 0.45); border-left: 4px solid #f59e0b;" 
                                    : "background: rgba(240, 253, 244, 0.35); border-left: 4px solid #10b981;");

                                <tr style="@rowStyle">
                                    <td class="px-3 text-muted small font-monospace">@index</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2.5">
                                            <img src="@(item.ThumbnailUrl ?? "/images/products/_placeholder.webp")" class="rounded-3 border" style="width: 40px; height: 40px; object-fit: cover;" onerror="this.src='/images/products/_placeholder.webp';" />
                                            <div>
                                                <div class="fw-bold text-dark small">@item.ProductName</div>
                                                <div class="text-muted font-monospace" style="font-size: 11px;">
                                                    SKU: <strong>@item.ProductSku</strong> | <i class="fa-solid fa-barcode ms-1"></i> @item.Barcode
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column align-items-start gap-1">
                                            <span class="badge bg-light text-dark border font-monospace px-2.5 py-1.5 fw-bold">@item.BatchNumber</span>
                                            @if (item.ClearanceDiscountPercent.HasValue && item.ClearanceDiscountPercent > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5" style="font-size: 10px;">
                                                    <i class="fa-solid fa-bolt me-1"></i>Clearance -@item.ClearanceDiscountPercent.Value.ToString("0.#")%
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="small text-secondary font-monospace">
                                        @(item.ManufacturingDate.HasValue ? item.ManufacturingDate.Value.ToString("dd/MM/yyyy") : "---")
                                    </td>
                                    <td>
                                        <div class="fw-bold font-monospace @(item.IsExpired ? "text-danger" : (item.IsNearExpiry ? "text-warning-emphasis" : "text-dark"))">
                                            <i class="fa-solid fa-calendar-day me-1 opacity-75"></i>@(item.ExpDate.HasValue ? item.ExpDate.Value.ToString("dd/MM/yyyy") : "---")
                                        </div>
                                        <div class="small fw-semibold mt-0.5" style="font-size: 11px;">
                                            @if (item.IsExpired)
                                            {
                                                <span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>Quá hạn @Math.Abs(item.DaysRemaining) ngày</span>
                                            }
                                            else if (item.DaysRemaining <= 15)
                                            {
                                                <span class="text-danger fw-bold"><i class="fa-solid fa-fire me-1"></i>Cực cận date: còn @item.DaysRemaining ngày!</span>
                                            }
                                            else if (item.IsNearExpiry || (item.ClearanceDiscountPercent.HasValue && item.ClearanceDiscountPercent > 0))
                                            {
                                                <span class="text-warning-emphasis"><i class="fa-solid fa-clock me-1"></i>Còn @item.DaysRemaining ngày (Ngưỡng @item.AlertDaysThreshold d)</span>
                                            }
                                            else
                                            {
                                                <span class="text-success"><i class="fa-solid fa-check me-1"></i>Còn @item.DaysRemaining ngày (An toàn)</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="fw-bold text-dark font-monospace fs-6">@item.PhysicalQuantity <span class="text-muted fs-xs fw-normal">/ @item.InitialQuantity</span></div>
                                        <div class="text-muted font-monospace" style="font-size: 10px;">Khóa: @item.ReservedQuantity</div>
                                    </td>
                                    <td class="text-center px-3">
                                        <div class="d-flex justify-content-between align-items-center small font-monospace mb-1" style="font-size: 11px;">
                                            <span>Đã bán:</span>
                                            <strong>@item.SoldRatioPercent%</strong>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(item.SoldRatioPercent >= 80 ? "bg-success" : (item.SoldRatioPercent >= 40 ? "bg-primary" : "bg-warning"))" role="progressbar" style="width: @item.SoldRatioPercent%"></div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill @(item.AvailableQuantity > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-3 py-1 font-monospace fw-bold">
                                            @item.AvailableQuantity
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-2.5 py-1 small fw-bold font-monospace @statusBgClass shadow-sm">
                                            @if (isRedTier)
                                            {
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i><span>ĐỎ: CẬN HẠN (&le;30d)</span>
                                            }
                                            else if (isYellowTier)
                                            {
                                                <i class="fa-solid fa-clock me-1"></i><span>VÀNG: CẢNH BÁO (&le;90d)</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-shield-check me-1"></i><span>XANH: AN TOÀN (&gt;90d)</span>
                                            }
                                        </span>
                                    </td>
                                    <td class="px-3 text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-1.5 flex-wrap">
                                            <button type="button" class="btn btn-xs btn-outline-warning text-dark fw-bold rounded-pill px-2.5 py-1 shadow-sm" style="font-size: 11px; background: #FEF3C7;" onclick="alert('Mở hộp thoại Thiết lập chiết khấu xả hàng cận date cho lô: @item.BatchNumber')">
                                                <i class="fa-solid fa-tag text-warning me-1"></i>Xả Date
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-danger fw-bold rounded-pill px-2.5 py-1 shadow-sm" style="font-size: 11px; background: #FEE2E2;" onclick="openDisposeModal(@item.BatchId, '@item.BatchNumber', '@item.ProductName', @item.AvailableQuantity)">
                                                <i class="fa-solid fa-trash-can me-1"></i>Xuất Hủy
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: ĐIỀU CHUYỂN KHO LIÊN CHI NHÁNH -->
    <div class="tab-pane fade" id="content-transfers" role="tabpanel">
        <div class="beauty-card overflow-hidden bg-white shadow-sm border-0 rounded-4">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark"><i class="fa-solid fa-truck-fast text-primary me-2"></i>Lịch Sử Điều Chuyển Kho Liên Chi Nhánh</span>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="openCreateTransferModal()">
                        <i class="fa-solid fa-plus me-1"></i>Tạo Phiếu Mới
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-white border-bottom">
                        <tr class="small text-secondary" style="font-size: 12px;">
                            <th class="py-3 px-3">Mã phiếu</th>
                            <th class="py-3">Kho nguồn (Xuất)</th>
                            <th class="py-3">Kho đích (Nhập)</th>
                            <th class="py-3 text-center">SL Yêu cầu</th>
                            <th class="py-3 text-center">SL Đã xuất</th>
                            <th class="py-3 text-center">SL Thực nhận</th>
                            <th class="py-3 text-center">Trạng thái</th>
                            <th class="py-3">Ngày tạo & Người tạo</th>
                            <th class="py-3 px-3 text-end" style="width: 180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentTransfers.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-dolly fs-1 text-secondary opacity-50 mb-2"></i>
                                    <div>Chưa có phiếu điều chuyển kho nào liên quan đến chi nhánh này.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var tr in Model.RecentTransfers)
                            {
                                <tr>
                                    <td class="px-3 font-monospace fw-bold text-dark small">
                                        <a href="javascript:void(0)" onclick="viewTransferDetails(@tr.Id)" class="text-decoration-none">@tr.TransferCode</a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark small"><i class="fa-solid fa-arrow-up-from-bracket me-1 text-danger"></i>@tr.SourceStoreName</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark small"><i class="fa-solid fa-arrow-down-to-bracket me-1 text-success"></i>@tr.DestinationStoreName</div>
                                    </td>
                                    <td class="text-center font-monospace fw-semibold">@tr.TotalRequestedQuantity</td>
                                    <td class="text-center font-monospace text-primary fw-semibold">@tr.TotalSentQuantity</td>
                                    <td class="text-center font-monospace text-success fw-semibold">@tr.TotalReceivedQuantity</td>
                                    <td class="text-center">
                                        @if (tr.Status == "PENDING")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 font-monospace">
                                                <i class="fa-solid fa-hourglass-half me-1"></i>Chờ duyệt
                                            </span>
                                        }
                                        else if (tr.Status == "IN_TRANSIT")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 font-monospace">
                                                <i class="fa-solid fa-truck-moving me-1"></i>Đang vận chuyển
                                            </span>
                                        }
                                        else if (tr.Status == "RECEIVED")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 font-monospace">
                                                <i class="fa-solid fa-circle-check me-1"></i>Hoàn thành
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1 font-monospace">
                                                <i class="fa-solid fa-ban me-1"></i>Đã hủy
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-dark">@tr.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="text-muted font-monospace" style="font-size: 11px;">Bởi: @tr.CreatedByUserName</div>
                                    </td>
                                    <td class="px-3 text-end">
                                        <div class="d-flex justify-content-end gap-1.5">
                                            <button type="button" class="btn btn-sm btn-light border px-2.5 rounded-3" onclick="viewTransferDetails(@tr.Id)" title="Xem chi tiết">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>

                                            @if (tr.Status == "PENDING")
                                            {
                                                <button type="button" class="btn btn-sm btn-success px-2.5 rounded-3" onclick="approveTransfer(@tr.Id, '@tr.TransferCode')" title="Duyệt & Xuất Kho FEFO">
                                                    <i class="fa-solid fa-check me-1"></i>Duyệt
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger px-2 rounded-3" onclick="cancelTransfer(@tr.Id, '@tr.TransferCode')" title="Hủy phiếu">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }
                                            else if (tr.Status == "IN_TRANSIT" && tr.DestinationStoreId.ToString() == Model.SelectedStoreId)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary rounded-3 px-2.5" onclick="receiveTransfer(@tr.Id, '@tr.TransferCode')" title="Xác nhận nhận hàng nhập kho">
                                                    <i class="fa-solid fa-inbox me-1"></i>Nhập kho
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: NHẬT KÝ TỒN KHO BẤT BIẾN (INVENTORY LOGS AUDIT TRAIL) -->
    <div class="tab-pane fade" id="content-inventory-logs" role="tabpanel">
        <div class="beauty-card overflow-hidden bg-white shadow-sm border-0 rounded-4">
            <!-- Header & Filter Bar for Logs -->
            <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 rounded-3 bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center">
                        <i class="fa-solid fa-book-journal-whills fs-5"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Sổ Cái Nhật Ký Tồn Kho Bất Biến (Immutable Inventory Logs)</h6>
                        <span class="small text-muted">Bảng tra cứu toàn bộ lịch sử biến động kho theo từng SKU, từng Lô và người thực hiện</span>
                    </div>
                </div>

                <!-- Live Filters for InventoryLogs -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <input type="text" id="logFilterKeyword" class="form-control form-control-sm rounded-pill font-monospace" placeholder="Lọc theo SKU / Lô / Tên..." style="width: 220px;" onkeyup="filterInventoryLogsTable()" />
                    <select id="logFilterType" class="form-select form-select-sm rounded-pill" style="width: 180px;" onchange="filterInventoryLogsTable()">
                        <option value="">-- Tất cả nghiệp vụ --</option>
                        <option value="IMPORT">Nhập kho (PO)</option>
                        <option value="POS_SALE">Bán tại quầy POS</option>
                        <option value="ONLINE_SALE">Bán trực tuyến</option>
                        <option value="TRANSFER_IN">Nhận điều chuyển</option>
                        <option value="TRANSFER_OUT">Xuất điều chuyển</option>
                        <option value="ADJUSTMENT">Cân bằng kiểm kê</option>
                        <option value="DISCARD_EXPIRED">Hủy hàng hết hạn</option>
                        <option value="EXPORT_DISPOSE">Xuất hủy hao hụt</option>
                    </select>
                </div>
            </div>

            <!-- Table of Logs -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tableInventoryLogs">
                    <thead class="bg-white border-bottom">
                        <tr class="small text-secondary" style="font-size: 12px;">
                            <th class="py-3 px-3" style="width: 140px;">Thời Gian</th>
                            <th class="py-3">Mỹ Phẩm & SKU</th>
                            <th class="py-3">Lô & HSD</th>
                            <th class="py-3 text-center">Nghiệp Vụ</th>
                            <th class="py-3 text-center" style="width: 110px;">Biến Động</th>
                            <th class="py-3 text-center" style="width: 130px;">Tồn Trước &rarr; Sau</th>
                            <th class="py-3">Người Thực Hiện</th>
                            <th class="py-3 px-3">Ghi Chú Kiểm Toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InventoryLogs == null || !Model.InventoryLogs.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-clock-rotate-left fs-2 opacity-50 mb-2"></i>
                                    <div>Chưa có nhật ký biến động kho nào tại chi nhánh này.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var log in Model.InventoryLogs)
                            {
                                string txBadgeClass = log.TransactionType switch
                                {
                                    "IMPORT" => "bg-primary-subtle text-primary border border-primary-subtle",
                                    "POS_SALE" or "ONLINE_SALE" => "bg-success-subtle text-success border border-success-subtle",
                                    "TRANSFER_IN" => "bg-info-subtle text-info-emphasis border border-info-subtle",
                                    "TRANSFER_OUT" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                    "ADJUSTMENT" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                    "DISCARD_EXPIRED" => "bg-danger-subtle text-danger border border-danger-subtle",
                                    "EXPORT_DISPOSE" => "bg-danger-subtle text-danger border border-danger-subtle",
                                    _ => "bg-light text-dark border"
                                };

                                string txName = log.TransactionType switch
                                {
                                    "IMPORT" => "Nhập kho (PO)",
                                    "POS_SALE" => "Bán lẻ POS",
                                    "ONLINE_SALE" => "Bán Online",
                                    "TRANSFER_IN" => "Nhận điều chuyển",
                                    "TRANSFER_OUT" => "Xuất điều chuyển",
                                    "ADJUSTMENT" => "Kiểm kê cân bằng",
                                    "DISCARD_EXPIRED" => "Hủy hàng hết hạn",
                                    "EXPORT_DISPOSE" => "Xuất hủy hao hụt",
                                    _ => log.TransactionType
                                };

                                string changeSign = log.QuantityChanged > 0 ? $"+{log.QuantityChanged}" : log.QuantityChanged.ToString();
                                string changeColor = log.QuantityChanged > 0 ? "text-success" : (log.QuantityChanged < 0 ? "text-danger" : "text-muted");

                                <tr class="log-row" data-sku="@log.ProductSku.ToLower()" data-name="@log.ProductName.ToLower()" data-batch="@log.BatchNumber.ToLower()" data-type="@log.TransactionType">
                                    <td class="px-3 small font-monospace text-secondary">
                                        <div>@log.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div style="font-size: 11px;">@log.CreatedAt.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark small">@log.ProductName</div>
                                        <div class="text-muted font-monospace" style="font-size: 11px;">SKU: @log.ProductSku</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@log.BatchNumber</span>
                                        <div class="small text-muted font-monospace mt-0.5" style="font-size: 11px;">
                                            HSD: @(log.ExpDate.HasValue ? log.ExpDate.Value.ToString("dd/MM/yyyy") : "---")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill @txBadgeClass font-monospace px-2.5 py-1" style="font-size: 11px;">
                                            @txName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <strong class="@changeColor font-monospace fs-6">@changeSign</strong>
                                    </td>
                                    <td class="text-center font-monospace small">
                                        <span class="text-muted">@log.QuantityBefore</span>
                                        <i class="fa-solid fa-arrow-right mx-1 text-secondary opacity-50" style="font-size: 10px;"></i>
                                        <strong class="text-dark">@log.QuantityAfter</strong>
                                    </td>
                                    <td class="small">
                                        <div class="d-flex align-items-center gap-1.5">
                                            <i class="fa-solid fa-user-circle text-secondary"></i>
                                            <span class="fw-semibold text-dark">@log.PerformerName</span>
                                        </div>
                                    </td>
                                    <td class="px-3 small text-secondary">
                                        @(string.IsNullOrEmpty(log.Note) ? "---" : log.Note)
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODALS SECTION -->
<!-- ============================================================== -->

<!-- Modal 1: Nhập Kho Theo Lô (PO) -->
<div class="modal fade" id="importBatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-boxes-packing text-primary me-2"></i>Nhập Kho Theo Lô Mới (Purchase Order)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportBatch" method="post" id="importBatchForm" onsubmit="return validateImportForm()">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewBatchImport.StoreId" value="@Model.SelectedStoreId" />

                <div class="modal-body p-4">
                    <div class="alert alert-info rounded-3 small py-2 mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-info fs-5 text-primary"></i>
                        <div>Kho nhập đích: <strong class="text-dark">@Model.SelectedStoreName</strong>. Hệ thống sẽ tự động tạo thẻ kho và ghi sổ cái kiểm toán <strong>InventoryLog</strong>.</div>
                    </div>

                    <div class="row g-3">
                        <!-- Chọn Sản Phẩm -->
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold text-dark">Sản phẩm mỹ phẩm: <span class="text-danger">*</span></label>
                            <select asp-for="NewBatchImport.ProductId" class="form-select rounded-3" required id="importProductId">
                                <option value="">-- Chọn sản phẩm mỹ phẩm --</option>
                                @foreach (var prod in productList)
                                {
                                    <option value="@prod.Value">@prod.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Chọn Nhà Cung Cấp -->
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-dark">Nhà cung cấp:</label>
                            <select asp-for="NewBatchImport.SupplierId" class="form-select rounded-3">
                                <option value="">-- Chọn nhà cung cấp --</option>
                                @foreach (var sup in supplierList)
                                {
                                    <option value="@sup.Value">@sup.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Mã Lô Sản Xuất -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số hiệu Lô (Batch Number): <span class="text-danger">*</span></label>
                            <input asp-for="NewBatchImport.BatchNumber" class="form-control rounded-3 font-monospace text-uppercase" placeholder="vd: LOT-2026-10A" required />
                        </div>

                        <!-- Số lượng nhập -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-dark">Số lượng nhập: <span class="text-danger">*</span></label>
                            <input asp-for="NewBatchImport.Quantity" type="number" class="form-control rounded-3 font-monospace fw-bold" min="1" value="50" required />
                        </div>

                        <!-- Đơn giá nhập -->
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-dark">Giá vốn nhập (đ):</label>
                            <input asp-for="NewBatchImport.ImportCost" type="number" class="form-control rounded-3 font-monospace" min="0" step="1000" value="0" placeholder="vd: 450000" />
                        </div>

                        <!-- Ngày sản xuất -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Ngày sản xuất (NSX): <span class="text-danger">*</span></label>
                            <input asp-for="NewBatchImport.ManufacturingDate" type="date" class="form-control rounded-3" id="importMfgDate" required />
                        </div>

                        <!-- Hạn sử dụng (FEFO) -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Hạn sử dụng (HSD - FEFO): <span class="text-danger">*</span></label>
                            <input asp-for="NewBatchImport.ExpDate" type="date" class="form-control rounded-3" id="importExpDate" required />
                            <div class="form-text small text-danger" id="expValidationMsg" style="display: none;">Hạn sử dụng phải lớn hơn ngày hiện tại!</div>
                        </div>

                        <!-- Số hóa đơn / PO No -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số chứng từ (PO / Bill):</label>
                            <input asp-for="NewBatchImport.ReferenceDocNo" class="form-control rounded-3" placeholder="vd: PO-LOREAL-2026-001" />
                        </div>

                        <!-- Ghi chú -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Ghi chú đợt nhập:</label>
                            <input asp-for="NewBatchImport.Notes" class="form-control rounded-3" placeholder="Ghi chú thêm về quy cách đóng gói..." />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-gradient rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-circle-check me-1"></i>Xác Nhận Nhập Kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Xuất Hủy / Hao Hụt Theo Lô FEFO -->
<div class="modal fade" id="disposeStockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-trash-can me-2"></i>Xuất Hủy / Giảm Tồn Lô Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="DisposeStock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StoreId" value="@Model.SelectedStoreId" />
                <input type="hidden" name="BatchId" id="disposeBatchId" />

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3 font-monospace small">
                        <div>Sản phẩm: <strong id="disposeProdName" class="text-dark">---</strong></div>
                        <div>Số hiệu lô: <strong id="disposeBatchNumber" class="text-purple">---</strong></div>
                        <div>Tồn khả dụng: <strong id="disposeAvailableQty" class="text-success fs-6">0</strong></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Lý do xuất hủy / giảm tồn: <span class="text-danger">*</span></label>
                        <select name="Reason" class="form-select rounded-3">
                            <option value="EXPIRED">1. Hàng đã quá hạn sử dụng (Expired)</option>
                            <option value="DAMAGED">2. Hư hỏng, vỡ bao bì, biến chất trong quá trình lưu kho</option>
                            <option value="RETURN_SUPPLIER">3. Xuất trả nhà cung cấp do lỗi kỹ thuật</option>
                            <option value="AUDIT_LOSS">4. Hao hụt kiểm kê không rõ nguyên nhân</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Số lượng xuất hủy: <span class="text-danger">*</span></label>
                        <input type="number" name="Quantity" id="disposeQuantity" class="form-control rounded-3 font-monospace fw-bold" min="1" value="1" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Ghi chú biên bản hủy:</label>
                        <textarea name="Notes" rows="2" class="form-control rounded-3" placeholder="Nhập số biên bản tiêu hủy hoặc giải trình..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Xác Nhận Xuất Hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Cân Bằng Kiểm Kê -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-sliders text-primary me-2"></i>Cân Bằng Kiểm Kê Định Kỳ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StoreId" value="@Model.SelectedStoreId" />
                <input type="hidden" name="BatchId" id="adjustBatchId" />

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3 font-monospace small">
                        <div>Sản phẩm: <strong id="adjustProdName" class="text-dark">---</strong></div>
                        <div>Số hiệu lô: <strong id="adjustBatchNumber" class="text-purple">---</strong></div>
                        <div>Tồn thực tế hiện tại: <strong id="adjustCurrentQty" class="text-danger fs-6">0</strong></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Số lượng chênh lệch (Cộng thêm / Giảm bớt): <span class="text-danger">*</span></label>
                        <input type="number" name="QuantityChange" class="form-control rounded-3 font-monospace fw-bold" placeholder="vd: -2 (thiếu 2) hoặc 5 (thừa 5)" required />
                        <span class="form-text small text-muted">Nhập số âm để trừ tồn, số dương để cộng tồn kho.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Lý do điều chỉnh (Bắt buộc): <span class="text-danger">*</span></label>
                        <textarea name="Notes" rows="2" class="form-control rounded-3" placeholder="vd: Kiểm kê tháng 10 phát hiện chênh lệch đếm..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Lưu Cân Bằng</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 4: Tạo Phiếu Điều Chuyển Kho -->
<div class="modal fade" id="createTransferModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-truck-ramp-box text-primary me-2"></i>Tạo Yêu Cầu Điều Chuyển Kho Liên Chi Nhánh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Kho xuất nguồn: <span class="text-danger">*</span></label>
                        <select id="transferSourceStoreId" class="form-select rounded-3">
                            @foreach (var s in Model.AvailableStores)
                            {
                                if (s.StoreId == Model.SelectedStoreId)
                                {
                                    <option value="@s.StoreId" selected>@s.StoreName @(s.IsCentralWarehouse ? "[Tổng kho]" : "")</option>
                                }
                                else
                                {
                                    <option value="@s.StoreId">@s.StoreName @(s.IsCentralWarehouse ? "[Tổng kho]" : "")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-dark">Kho đích nhận hàng: <span class="text-danger">*</span></label>
                        <select id="transferDestStoreId" class="form-select rounded-3">
                            <option value="">-- Chọn kho đích nhận hàng --</option>
                            @foreach (var s in Model.AvailableStores)
                            {
                                if (s.StoreId != Model.SelectedStoreId)
                                {
                                    <option value="@s.StoreId">@s.StoreName @(s.IsCentralWarehouse ? "[Tổng kho]" : "")</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Chọn sản phẩm mỹ phẩm cần chuyển: <span class="text-danger">*</span></label>
                    <div class="row g-2">
                        <div class="col-md-8">
                            <select id="transferProductId" class="form-select rounded-3">
                                <option value="">-- Chọn mỹ phẩm --</option>
                                @foreach (var prod in productList)
                                {
                                    <option value="@prod.Value">@prod.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light border">SL:</span>
                                <input type="number" id="transferQuantity" class="form-control font-monospace fw-bold" min="1" value="10" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Ghi chú điều chuyển:</label>
                    <textarea id="transferNote" rows="2" class="form-control rounded-3" placeholder="vd: Điều chuyển cân đối tồn kho cuối tuần..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-gradient rounded-pill px-4 fw-semibold" onclick="submitCreateTransfer()">
                    <i class="fa-solid fa-paper-plane me-1"></i>Gửi Yêu Cầu Chờ Duyệt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 5: Chi Tiết Phiếu Điều Chuyển -->
<div class="modal fade" id="transferDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0">Chi Tiết Phiếu Điều Chuyển <span id="dtlTransferCode" class="text-primary font-monospace">---</span></h5>
                    <span id="dtlStatusBadge" class="badge rounded-pill mt-1">---</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3 font-monospace small p-3 bg-light rounded-3">
                    <div class="col-6">Kho xuất: <strong id="dtlSourceStore" class="text-dark">---</strong></div>
                    <div class="col-6">Kho đích: <strong id="dtlDestStore" class="text-dark">---</strong></div>
                    <div class="col-6">Người tạo: <strong id="dtlCreatedBy" class="text-dark">---</strong></div>
                    <div class="col-6">Ngày tạo: <strong id="dtlCreatedAt" class="text-dark">---</strong></div>
                    <div class="col-12" id="dtlNotesBox">Ghi chú: <span id="dtlNotes">---</span></div>
                </div>

                <h6 class="fw-bold text-dark mb-2">Danh sách mặt hàng & Phân bổ Lô FEFO:</h6>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 font-monospace" style="font-size: 12px;">
                        <thead class="bg-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Mã Lô FEFO</th>
                                <th>Hạn Dùng</th>
                                <th class="text-center">Yêu cầu</th>
                                <th class="text-center">Đã xuất</th>
                                <th class="text-center">Thực nhận</th>
                            </tr>
                        </thead>
                        <tbody id="dtlItemsTableBody">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Form Validation: Hạn sử dụng phải > ngày hiện tại
        function validateImportForm() {
            const expInput = document.getElementById('importExpDate');
            const expMsg = document.getElementById('expValidationMsg');
            const expDate = new Date(expInput.value);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (expDate <= today) {
                expMsg.style.display = 'block';
                Swal.fire({
                    icon: 'error',
                    title: 'Hạn sử dụng không hợp lệ',
                    text: 'Hạn sử dụng của lô mỹ phẩm phải lớn hơn ngày hiện tại!'
                });
                return false;
            }
            expMsg.style.display = 'none';
            return true;
        }

        // Open Dispose Modal
        function openDisposeModal(batchId, batchNumber, prodName, availableQty) {
            document.getElementById('disposeBatchId').value = batchId;
            document.getElementById('disposeBatchNumber').innerText = batchNumber;
            document.getElementById('disposeProdName').innerText = prodName;
            document.getElementById('disposeAvailableQty').innerText = availableQty;
            document.getElementById('disposeQuantity').max = availableQty;
            document.getElementById('disposeQuantity').value = Math.min(1, availableQty);

            const modal = new bootstrap.Modal(document.getElementById('disposeStockModal'));
            modal.show();
        }

        // Open Adjust Modal
        function openAdjustModal(batchId, batchNumber, prodName, currentQty) {
            document.getElementById('adjustBatchId').value = batchId;
            document.getElementById('adjustBatchNumber').innerText = batchNumber;
            document.getElementById('adjustProdName').innerText = prodName;
            document.getElementById('adjustCurrentQty').innerText = currentQty;

            const modal = new bootstrap.Modal(document.getElementById('adjustStockModal'));
            modal.show();
        }

        // Open Create Transfer Modal
        function openCreateTransferModal() {
            const modal = new bootstrap.Modal(document.getElementById('createTransferModal'));
            modal.show();
        }

        // Submit Create Stock Transfer
        async function submitCreateTransfer() {
            const sourceId = parseInt(document.getElementById('transferSourceStoreId').value);
            const destId = parseInt(document.getElementById('transferDestStoreId').value);
            const prodId = parseInt(document.getElementById('transferProductId').value);
            const qty = parseInt(document.getElementById('transferQuantity').value);
            const note = document.getElementById('transferNote').value.trim();

            if (!destId) {
                Swal.fire({ icon: 'warning', title: 'Thiếu kho đích', text: 'Vui lòng chọn kho nhận hàng.' });
                return;
            }
            if (sourceId === destId) {
                Swal.fire({ icon: 'error', title: 'Trùng lặp kho', text: 'Kho nguồn và kho đích không được trùng nhau!' });
                return;
            }
            if (!prodId || qty <= 0) {
                Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng chọn sản phẩm và số lượng cần chuyển.' });
                return;
            }

            try {
                const res = await fetch('/Admin/Warehouse/CreateTransfer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sourceStoreId: sourceId,
                        destinationStoreId: destId,
                        note: note,
                        items: [{ productId: prodId, requestedQuantity: qty, note: '' }]
                    })
                });

                const data = await res.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã tạo phiếu điều chuyển!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi tạo phiếu', text: data.message });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Không thể kết nối đến máy chủ.' });
            }
        }

        // View Transfer Details Modal
        async function viewTransferDetails(id) {
            try {
                const res = await fetch(`/Admin/Warehouse/GetTransferDetails?id=${id}`);
                const result = await res.json();
                if (!result.success || !result.data) return;

                const tr = result.data;
                document.getElementById('dtlTransferCode').innerText = tr.transferCode;
                document.getElementById('dtlSourceStore').innerText = tr.sourceStoreName;
                document.getElementById('dtlDestStore').innerText = tr.destinationStoreName;
                document.getElementById('dtlCreatedBy').innerText = tr.createdByUserName;
                document.getElementById('dtlCreatedAt').innerText = new Date(tr.requestedAt).toLocaleString('vi-VN');
                document.getElementById('dtlNotes').innerText = tr.note || 'Không có ghi chú.';

                const badge = document.getElementById('dtlStatusBadge');
                badge.innerText = tr.status === 'PENDING' ? 'Chờ duyệt' : (tr.status === 'IN_TRANSIT' ? 'Đang vận chuyển' : (tr.status === 'RECEIVED' ? 'Hoàn thành' : 'Đã hủy'));
                badge.className = 'badge rounded-pill ' + (tr.status === 'PENDING' ? 'bg-warning text-dark' : (tr.status === 'IN_TRANSIT' ? 'bg-primary' : (tr.status === 'RECEIVED' ? 'bg-success' : 'bg-secondary')));

                const tbody = document.getElementById('dtlItemsTableBody');
                tbody.innerHTML = '';
                tr.details.forEach(d => {
                    const trElem = document.createElement('tr');
                    trElem.innerHTML = `
                        <td><strong>${d.productName}</strong></td>
                        <td>${d.batchNumber || '<em>Chưa phân bổ</em>'}</td>
                        <td>${d.expDate ? new Date(d.expDate).toLocaleDateString('vi-VN') : '---'}</td>
                        <td class="text-center fw-bold">${d.requestedQuantity}</td>
                        <td class="text-center text-primary fw-bold">${d.sentQuantity}</td>
                        <td class="text-center text-success fw-bold">${d.receivedQuantity}</td>
                    `;
                    tbody.appendChild(trElem);
                });

                const modal = new bootstrap.Modal(document.getElementById('transferDetailsModal'));
                modal.show();
            } catch (err) {
                console.error(err);
            }
        }

        // Approve Transfer
        function approveTransfer(id, code) {
            Swal.fire({
                title: 'Duyệt & Xuất Kho FEFO?',
                html: `Hệ thống sẽ tự động quét các lô <strong>cận date nhất (FEFO)</strong> tại kho nguồn để trừ tồn và xuất điều chuyển phiếu <strong>${code}</strong>.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý duyệt xuất',
                cancelButtonText: 'Hủy bỏ',
                confirmButtonColor: '#10B981'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Warehouse/ApproveTransfer?id=${id}&note=${encodeURIComponent('Duyệt qua giao diện quản trị')}`, { method: 'POST' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Thành công!', text: data.message }).then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Không thể duyệt', text: data.message });
                        }
                    } catch (e) {
                        console.error(e);
                    }
                }
            });
        }

        // Receive Transfer
        function receiveTransfer(id, code) {
            Swal.fire({
                title: 'Xác Nhận Nhập Kho Đích?',
                text: `Xác nhận đã nhận đủ hàng từ phiếu điều chuyển ${code} và nhập vào kho này.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Xác nhận nhập kho',
                cancelButtonText: 'Hủy bỏ',
                confirmButtonColor: '#7C3AED'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch('/Admin/Warehouse/ReceiveTransfer', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ transferId: id, note: 'Nhận đủ hàng tại kho', items: [] })
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Hoàn tất nhập kho!', text: data.message }).then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                        }
                    } catch (e) {
                        console.error(e);
                    }
                }
            });
        }

        // Cancel Transfer
        function cancelTransfer(id, code) {
            Swal.fire({
                title: 'Hủy Phiếu Điều Chuyển?',
                input: 'text',
                inputLabel: 'Lý do hủy phiếu:',
                inputPlaceholder: 'vd: Thay đổi kế hoạch điều phối...',
                inputValidator: (val) => !val ? 'Vui lòng nhập lý do hủy!' : null,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Hủy phiếu',
                cancelButtonText: 'Quay lại',
                confirmButtonColor: '#EF4444'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Warehouse/CancelTransfer?id=${id}&reason=${encodeURIComponent(result.value)}`, { method: 'POST' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Đã hủy phiếu', text: data.message }).then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                        }
                    } catch (e) {
                        console.error(e);
                    }
                }
            });
        }

        function filterInventoryLogsTable() {
            const kw = document.getElementById('logFilterKeyword')?.value?.trim().toLowerCase() || '';
            const type = document.getElementById('logFilterType')?.value?.trim().toUpperCase() || '';
            const rows = document.querySelectorAll('#tableInventoryLogs tbody tr.log-row');
            rows.forEach(r => {
                const rSku = r.getAttribute('data-sku') || '';
                const rName = r.getAttribute('data-name') || '';
                const rBatch = r.getAttribute('data-batch') || '';
                const rType = r.getAttribute('data-type') || '';

                const matchKw = !kw || rSku.includes(kw) || rName.includes(kw) || rBatch.includes(kw);
                const matchType = !type || rType === type;
                r.style.display = (matchKw && matchType) ? '' : 'none';
            });
        }
    </script>
}

</div>