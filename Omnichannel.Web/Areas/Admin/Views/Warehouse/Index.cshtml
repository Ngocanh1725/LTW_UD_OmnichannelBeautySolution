@model Omnichannel.Application.DTOs.Inventory.WarehouseOverviewViewModel
@{
    ViewData["Title"] = "Quản Trị Kho & Lô Date FEFO";
    Layout = "_AdminLayout";
}

<!-- Header Điều Hành & Nút Thao Tác -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Quản Trị Kho Vận & Lô Date (FEFO Engine)</h4>
        <p class="text-muted small mb-0">Hệ thống phân bổ xuất kho ưu tiên lô cận date nhất và cảnh báo màu sắc thời gian thực</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary-gradient px-3" data-bs-toggle="modal" data-bs-target="#importBatchModal">
            <i class="fa-solid fa-boxes-packing me-1"></i>Nhập Lô Mới
        </button>
    </div>
</div>

<!-- Thanh Lựa Chọn Kho & Thẻ Thống Kê Cảnh Báo Màu Sắc -->
<div class="row g-3 mb-4">
    <!-- Chọn Kho -->
    <div class="col-12 col-lg-3">
        <div class="beauty-card p-3 h-100 d-flex flex-column justify-content-center">
            <label class="form-label small fw-semibold text-secondary mb-1">Đang xem kho hàng:</label>
            <select class="form-select rounded-3" onchange="location.href='?storeId=' + this.value">
                @foreach (var s in Model.AvailableStores)
                {
                    if (s.StoreId == Model.SelectedStoreId)
                    {
                        <option value="@s.StoreId" selected>@s.StoreName @(s.IsCentralWarehouse ? "⭐ (Tổng kho)" : "")</option>
                    }
                    else
                    {
                        <option value="@s.StoreId">@s.StoreName @(s.IsCentralWarehouse ? "⭐ (Tổng kho)" : "")</option>
                    }
                }
            </select>
        </div>
    </div>

    <!-- Stat 1: Cảnh báo Hết Hạn (ĐỎ) -->
    <div class="col-6 col-sm-3 col-lg-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=EXPIRED" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center gap-3 border-danger-subtle" style="background: #FEF2F2;">
                <div class="rounded-4 p-2 d-flex align-items-center justify-content-center" style="background: #FEE2E2; color: #DC2626; width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <div class="text-danger small fw-bold">Lô Đã Hết Hạn</div>
                    <h4 class="fw-bold mb-0 text-danger">@Model.TotalExpiredBatches</h4>
                </div>
            </div>
        </a>
    </div>

    <!-- Stat 2: Cảnh báo Cận Date < 60 ngày (CAM) -->
    <div class="col-6 col-sm-3 col-lg-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=NEAR_EXPIRY" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center gap-3 border-warning-subtle" style="background: #FFFBEB;">
                <div class="rounded-4 p-2 d-flex align-items-center justify-content-center" style="background: #FEF3C7; color: #D97706; width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <div class="text-warning small fw-bold" style="color: #B45309 !important;">Lô Cận Date (&le;60 ngày)</div>
                    <h4 class="fw-bold mb-0 text-dark">@Model.TotalNearExpiryBatches</h4>
                </div>
            </div>
        </a>
    </div>

    <!-- Stat 3: Cảnh báo Dưới Tồn An Toàn (VÀNG) -->
    <div class="col-6 col-sm-3 col-lg-3">
        <a href="?storeId=@Model.SelectedStoreId&filterStatus=LOW_STOCK" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center gap-3" style="background: #FEFCE8;">
                <div class="rounded-4 p-2 d-flex align-items-center justify-content-center" style="background: #FEF9C3; color: #CA8A04; width: 48px; height: 48px; font-size: 20px;">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <div>
                    <div class="small fw-bold" style="color: #A16207;">Dưới Tồn An Toàn</div>
                    <h4 class="fw-bold mb-0 text-dark">@Model.TotalLowStockBatches</h4>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Lưới Dữ Liệu Tồn Kho Mật Độ Cao (DataGrid FEFO) -->
<div class="beauty-card overflow-hidden">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-dark"><i class="fa-solid fa-list-ol me-2 text-purple" style="color: var(--primary-purple);"></i>Danh sách Lô hàng tồn kho</span>
            @if (!string.IsNullOrEmpty(Model.FilterStatus))
            {
                <span class="badge bg-secondary-subtle text-secondary">Đang lọc: @Model.FilterStatus</span>
                <a href="?storeId=@Model.SelectedStoreId" class="small text-danger ms-2"><i class="fa-solid fa-xmark me-1"></i>Bỏ lọc</a>
            }
        </div>
        <div class="d-flex align-items-center gap-3 small text-muted">
            <span><span class="badge bg-danger me-1">&nbsp;</span>Hết hạn</span>
            <span><span class="badge bg-warning me-1">&nbsp;</span>Cận date (&le;60d)</span>
            <span><span class="badge bg-success me-1">&nbsp;</span>An toàn</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-white border-bottom">
                <tr class="small text-secondary">
                    <th class="py-3 px-4">Sản phẩm & Barcode</th>
                    <th class="py-3">Số hiệu Lô (Batch)</th>
                    <th class="py-3">Ngày sản xuất</th>
                    <th class="py-3">Hạn sử dụng (HSD)</th>
                    <th class="py-3 text-center">Tồn vật lý</th>
                    <th class="py-3 text-center">Tạm khóa</th>
                    <th class="py-3 text-center">Khả dụng</th>
                    <th class="py-3">Tình trạng HSD</th>
                    <th class="py-3 px-4 text-end">Cân bằng / Hủy</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BatchStockItems.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-box-archive fs-1 mb-2 text-muted"></i>
                            <div>Không có lô hàng nào phù hợp với bộ lọc hiện tại.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.BatchStockItems)
                    {
                        string rowClass = item.IsExpired ? "table-danger" : (item.IsNearExpiry ? "table-warning" : "");
                        <tr class="@rowClass">
                            <td class="px-4">
                                <div class="fw-bold text-dark">@item.ProductName</div>
                                <div class="text-muted small font-monospace">@item.ProductId | <i class="fa-solid fa-barcode ms-1"></i> @item.Barcode</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.BatchNumber</span>
                            </td>
                            <td class="small text-secondary">@item.ManufacturingDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-bold @(item.IsExpired ? "text-danger" : (item.IsNearExpiry ? "text-warning-emphasis" : "text-dark"))">
                                    @item.ExpDate.ToString("dd/MM/yyyy")
                                </div>
                                <div class="small text-muted" style="font-size: 11px;">
                                    @(item.IsExpired ? "Đã quá hạn " + Math.Abs(item.DaysRemaining) + " ngày" : "Còn " + item.DaysRemaining + " ngày")
                                </div>
                            </td>
                            <td class="text-center fw-bold text-dark">@item.PhysicalQuantity</td>
                            <td class="text-center text-muted small">@item.ReservedQuantity</td>
                            <td class="text-center">
                                <span class="badge rounded-pill @(item.AvailableQuantity > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-3 py-1 fw-bold">
                                    @item.AvailableQuantity
                                </span>
                            </td>
                            <td>
                                @if (item.IsExpired)
                                {
                                    <span class="badge bg-danger"><i class="fa-solid fa-ban me-1"></i>HẾT HẠN</span>
                                }
                                else if (item.IsNearExpiry)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i>CẬN DATE</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-shield-check me-1"></i>AN TOÀN</span>
                                }
                            </td>
                            <td class="px-4 text-end">
                                <button type="button" class="btn btn-sm btn-soft-purple" onclick="openAdjustModal(@item.BatchId, '@item.BatchNumber', '@item.ProductName', @item.PhysicalQuantity)">
                                    <i class="fa-solid fa-sliders me-1"></i>Điều chỉnh
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal 1: Nhập Kho Theo Lô Mới -->
<div class="modal fade" id="importBatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-dolly me-2 text-pink" style="color: var(--accent-pink);"></i>Nhập Hàng Hóa Theo Lô (PO)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportBatch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewBatchImport.StoreId" value="@Model.SelectedStoreId" />

                <div class="modal-body p-4">
                    <div class="alert alert-info rounded-3 small py-2 mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>Đang nhập vào: <strong>@Model.SelectedStoreName</strong>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="NewBatchImport.ProductId" class="form-label small fw-semibold"></label>
                            <select asp-for="NewBatchImport.ProductId" class="form-select rounded-3" required>
                                <option value="">-- Chọn sản phẩm SKU cần nhập --</option>
                                @foreach (var prod in ViewBag.ProductList)
                                {
                                    <option value="@prod.ProductId">@prod.Display</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.BatchNumber" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.BatchNumber" class="form-control rounded-3 font-monospace text-uppercase" placeholder="vd: LOT-2026-09A" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.Quantity" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.Quantity" type="number" class="form-control rounded-3 font-monospace" min="1" value="50" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.ManufacturingDate" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.ManufacturingDate" type="date" class="form-control rounded-3" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.ExpDate" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.ExpDate" type="date" class="form-control rounded-3" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.ReferenceDocNo" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.ReferenceDocNo" class="form-control rounded-3" placeholder="vd: PO-LOREAL-2026-001" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewBatchImport.Notes" class="form-label small fw-semibold"></label>
                            <input asp-for="NewBatchImport.Notes" class="form-control rounded-3" placeholder="Ghi chú đợt hàng..." />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Xác Nhận Nhập Kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Kiểm Kê / Điều Chỉnh Tồn Kho -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark">Điều Chỉnh & Cân Bằng Tồn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AdjustStock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="StoreId" value="@Model.SelectedStoreId" />
                <input type="hidden" name="BatchId" id="adjustBatchId" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="small text-muted">Sản phẩm: <strong id="adjustProdName" class="text-dark"></strong></div>
                        <div class="small text-muted">Lô hàng: <strong id="adjustBatchNumber" class="text-purple"></strong> | Tồn hiện tại: <strong id="adjustCurrentQty" class="text-danger"></strong></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Loại giao dịch:</label>
                        <select name="TransactionType" class="form-select rounded-3">
                            <option value="4">4. Cân bằng kiểm kê (Thừa / Thiếu)</option>
                            <option value="5">5. Xuất hủy (Hàng hỏng / Hết hạn sử dụng)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số lượng chênh lệch:</label>
                        <input type="number" name="QuantityChange" class="form-control rounded-3" placeholder="vd: -5 (giảm 5) hoặc 3 (tăng 3)" required />
                        <span class="form-text text-muted small">Nhập số âm để giảm tồn, số dương để tăng tồn.</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do điều chỉnh (Bắt buộc):</label>
                        <textarea name="Notes" rows="2" class="form-control rounded-3" placeholder="vd: Kiểm kê định kỳ phát hiện hỏng bao bì..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Lưu Điều Chỉnh</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAdjustModal(batchId, batchNumber, prodName, currentQty) {
            document.getElementById('adjustBatchId').value = batchId;
            document.getElementById('adjustBatchNumber').innerText = batchNumber;
            document.getElementById('adjustProdName').innerText = prodName;
            document.getElementById('adjustCurrentQty').innerText = currentQty;

            const modal = new bootstrap.Modal(document.getElementById('adjustStockModal'));
            modal.show();
        }
    </script>
}
