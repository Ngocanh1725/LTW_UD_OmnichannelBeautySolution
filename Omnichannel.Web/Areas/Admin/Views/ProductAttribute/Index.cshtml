@model Omnichannel.Application.DTOs.Catalog.ProductAttributesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Thuộc Tính & AI Beauty Advisor";
    var skinTypes = Model.AvailableSkinTypes;
    var concerns = Model.AvailableConcerns;
}

<div x-data="adminProductAttributes()" class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-tr from-pink-500 via-rose-500 to-purple-600 text-white shadow-lg shadow-pink-500/25">
                <i class="fa-solid fa-wand-magic-sparkles text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    Thuộc Tính Sản Phẩm (AI Advisor)
                    <span class="text-xs bg-pink-100 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300 font-bold px-2 py-0.5 rounded-full border border-pink-200 dark:border-pink-800">
                        Skin Types & Concerns
                    </span>
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Gán Loại da phù hợp và Mối quan tâm điều trị để cung cấp dữ liệu cho thuật toán lọc thông minh AI Beauty Advisor
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <!-- Bulk Edit Button -->
            <button type="button" 
                    @@click="openBulkEditModal()"
                    :disabled="selectedProductIds.length === 0"
                    :class="selectedProductIds.length > 0 ? 'bg-magenta-accent text-white shadow-md shadow-pink-500/20 hover:opacity-95' : 'bg-slate-100 text-slate-400 cursor-not-allowed'"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition">
                <i class="fa-solid fa-layer-group text-xs"></i>
                <span>Cập Nhật Hàng Loạt</span>
                <span x-show="selectedProductIds.length > 0" class="bg-white text-magenta-accent text-[10px] px-1.5 py-0.2 rounded-full font-black" x-text="selectedProductIds.length"></span>
            </button>

            <!-- Storefront Preview Link -->
            <a href="/Product/SmartFilter" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 text-xs font-semibold shadow-xs transition">
                <i class="fa-solid fa-arrow-up-right-from-square text-magenta-accent"></i>
                <span>Mở AI Advisor Storefront</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500 text-base"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-rose-500 text-base"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
        </div>
    }

    <!-- Filter Card -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
        <form method="get" action="/Admin/ProductAttribute" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Search -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Tìm sản phẩm</label>
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tên sản phẩm hoặc SKU..."
                           class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100" />
                </div>
            </div>

            <!-- Skin Type Filter -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Loại da</label>
                <select name="skinTypeId" class="w-full px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100">
                    <option value="">-- Tất cả loại da --</option>
                    @foreach (var st in skinTypes)
                    {
                        <!option value="@st.Id" @(ViewBag.SkinTypeId == st.Id ? "selected" : "")>@st.Name</!option>
                    }
                </select>
            </div>

            <!-- Concern Filter -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Mối quan tâm</label>
                <select name="concernId" class="w-full px-3 py-1.5 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100">
                    <option value="">-- Tất cả mối quan tâm --</option>
                    @foreach (var c in concerns)
                    {
                        <!option value="@c.Id" @(ViewBag.ConcernId == c.Id ? "selected" : "")>@c.Name</!option>
                    }
                </select>
            </div>

            <!-- Buttons -->
            <div class="flex items-end gap-2">
                <button type="submit" class="flex-1 py-1.5 px-4 rounded-xl bg-magenta-accent hover:opacity-95 text-white text-xs font-semibold shadow-xs transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-filter text-xs"></i>
                    <span>Lọc</span>
                </button>
                <a href="/Admin/ProductAttribute" class="py-1.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-medium transition" title="Đặt lại">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Products Table Card -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
                <thead class="bg-slate-50 dark:bg-slate-800/80 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="py-3.5 px-4 w-10 text-center">
                            <input type="checkbox" @@change="toggleSelectAll($event)" class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                        </th>
                        <th class="py-3.5 px-4">Sản Phẩm</th>
                        <th class="py-3.5 px-4">Danh Mục & Giá</th>
                        <th class="py-3.5 px-4">Loại Da Phù Hợp (Skin Types)</th>
                        <th class="py-3.5 px-4">Mối Quan Tâm (Concerns)</th>
                        <th class="py-3.5 px-4 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-normal">
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        @foreach (var p in Model.Products)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition">
                                <!-- Checkbox -->
                                <td class="py-3.5 px-4 text-center">
                                    <input type="checkbox" 
                                           :value="@p.ProductId" 
                                           x-model="selectedProductIds" 
                                           class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                                </td>

                                <!-- Product Info -->
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-12 w-12 rounded-xl bg-slate-100 overflow-hidden flex-shrink-0 border border-slate-200">
                                            <img src="@(p.ThumbnailUrl ?? "/images/default-product.png")" alt="@p.ProductName" class="w-full h-full object-cover" onerror="this.src='/images/default-product.png'" />
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-800 dark:text-slate-100 leading-snug">@p.ProductName</div>
                                            <div class="font-mono text-[11px] text-slate-400 mt-0.5">SKU: @p.Sku</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Category & Price -->
                                <td class="py-3.5 px-4">
                                    <div class="font-medium text-slate-700 dark:text-slate-300">@p.CategoryName</div>
                                    <div class="font-mono font-bold text-magenta-accent mt-0.5">@p.Price.ToString("N0") ₫</div>
                                </td>

                                <!-- Skin Types -->
                                <td class="py-3.5 px-4">
                                    <div class="flex flex-wrap gap-1 max-w-xs">
                                        @if (p.AssignedSkinTypeNames.Any())
                                        {
                                            @foreach (var stName in p.AssignedSkinTypeNames)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200">
                                                    @stName
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-[11px] text-slate-400 italic">(Chưa gán)</span>
                                        }
                                    </div>
                                </td>

                                <!-- Concerns -->
                                <td class="py-3.5 px-4">
                                    <div class="flex flex-wrap gap-1 max-w-xs">
                                        @if (p.AssignedConcernNames.Any())
                                        {
                                            @foreach (var cName in p.AssignedConcernNames)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-pink-50 text-magenta-accent dark:bg-pink-950/60 dark:text-pink-300 border border-pink-200">
                                                    @cName
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-[11px] text-slate-400 italic">(Chưa gán)</span>
                                        }
                                    </div>
                                </td>

                                <!-- Action -->
                                <td class="py-3.5 px-4 text-right">
                                    <button type="button" 
                                            @@click="openSingleEditModal(@p.ProductId, '@(p.ProductName.Replace("'", "\\'"))', @System.Text.Json.JsonSerializer.Serialize(p.AssignedSkinTypeIds), @System.Text.Json.JsonSerializer.Serialize(p.AssignedConcernIds))"
                                            class="p-2 rounded-xl bg-slate-100 hover:bg-magenta-accent hover:text-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 transition"
                                            title="Sửa thuộc tính">
                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <i class="fa-solid fa-box-open text-3xl mb-2 text-slate-300"></i>
                                <p class="text-sm">Không tìm thấy sản phẩm nào</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL: CHỈNH SỬA ĐƠN LẺ CHO 1 SẢN PHẨM -->
    <!-- ========================================================================= -->
    <div x-show="isSingleModalOpen" style="display: none;" class="fixed inset-0 z-50 overflow-y-auto bg-charcoal/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="relative w-full max-w-xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden flex flex-col max-h-[85vh]">
            <form method="post" action="/Admin/ProductAttribute/UpdateSingle">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" :value="singleProduct.id" />

                <!-- Modal Header -->
                <div class="px-6 py-4 bg-gradient-to-r from-pink-500 to-purple-600 text-white flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-base">Cập Nhật Thuộc Tính Sản Phẩm</h3>
                        <p class="text-xs text-pink-100 truncate max-w-md" x-text="singleProduct.name"></p>
                    </div>
                    <button type="button" @@click="isSingleModalOpen = false" class="text-white hover:opacity-80">
                        <i class="fa-solid fa-xmark text-base"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="p-6 space-y-6 overflow-y-auto max-h-[60vh]">
                    <!-- Skin Types Checkboxes -->
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-2.5 flex items-center gap-1.5">
                            <i class="fa-solid fa-droplet text-blue-500"></i>
                            <span>Loại da tương thích (Skin Types)</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var st in skinTypes)
                            {
                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 cursor-pointer text-xs">
                                    <input type="checkbox" 
                                           name="skinTypeIds" 
                                           value="@st.Id" 
                                           :checked="singleProduct.skinTypeIds.includes(@st.Id)" 
                                           class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                                    <span class="font-medium text-slate-700 dark:text-slate-200">@st.Name</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Concerns Checkboxes -->
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-2.5 flex items-center gap-1.5">
                            <i class="fa-solid fa-wand-magic-sparkles text-magenta-accent"></i>
                            <span>Mối quan tâm điều trị (Concerns)</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var c in concerns)
                            {
                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 cursor-pointer text-xs">
                                    <input type="checkbox" 
                                           name="concernIds" 
                                           value="@c.Id" 
                                           :checked="singleProduct.concernIds.includes(@c.Id)" 
                                           class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                                    <span class="font-medium text-slate-700 dark:text-slate-200">@c.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-2">
                    <button type="button" @@click="isSingleModalOpen = false" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-slate-700 text-xs font-semibold">
                        Hủy
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-magenta-accent hover:opacity-95 text-white text-xs font-bold shadow-xs">
                        Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL: CẬP NHẬT HÀNG LOẠT (BULK EDIT) -->
    <!-- ========================================================================= -->
    <div x-show="isBulkModalOpen" style="display: none;" class="fixed inset-0 z-50 overflow-y-auto bg-charcoal/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="relative w-full max-w-xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden flex flex-col max-h-[85vh]">
            <form method="post" action="/Admin/ProductAttribute/BulkUpdate">
                @Html.AntiForgeryToken()

                <!-- Hidden inputs for selected product IDs -->
                <template x-for="id in selectedProductIds" :key="id">
                    <input type="hidden" name="ProductIds" :value="id" />
                </template>

                <!-- Modal Header -->
                <div class="px-6 py-4 bg-gradient-to-r from-purple-600 via-pink-600 to-rose-600 text-white flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-base">Cập Nhật Thuộc Tính Hàng Loạt</h3>
                        <p class="text-xs text-pink-100">
                            Đang áp dụng cho <strong x-text="selectedProductIds.length"></strong> sản phẩm đã chọn
                        </p>
                    </div>
                    <button type="button" @@click="isBulkModalOpen = false" class="text-white hover:opacity-80">
                        <i class="fa-solid fa-xmark text-base"></i>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="p-6 space-y-6 overflow-y-auto max-h-[60vh]">
                    <!-- Mode Selector -->
                    <div>
                        <div class="text-xs font-bold text-slate-700 dark:text-slate-200 mb-2">Chế độ cập nhật:</div>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="p-3 rounded-2xl border-2 cursor-pointer flex items-center gap-2.5 transition"
                                   :class="bulkMode === 'ADD' ? 'border-magenta-accent bg-pastel-rose' : 'border-slate-200'">
                                <input type="radio" name="Mode" value="ADD" x-model="bulkMode" class="text-magenta-accent" />
                                <div>
                                    <div class="font-bold text-xs text-charcoal">Thêm mới (ADD)</div>
                                    <div class="text-[10px] text-slate-500">Giữ thuộc tính cũ, thêm thuộc tính chọn</div>
                                </div>
                            </label>

                            <label class="p-3 rounded-2xl border-2 cursor-pointer flex items-center gap-2.5 transition"
                                   :class="bulkMode === 'REPLACE' ? 'border-magenta-accent bg-pastel-rose' : 'border-slate-200'">
                                <input type="radio" name="Mode" value="REPLACE" x-model="bulkMode" class="text-magenta-accent" />
                                <div>
                                    <div class="font-bold text-xs text-charcoal">Ghi đè (REPLACE)</div>
                                    <div class="text-[10px] text-slate-500">Xóa thuộc tính cũ và gán danh sách mới</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Skin Types Checkboxes -->
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-droplet text-blue-500"></i>
                            <span>Chọn Loại da cần gán:</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var st in skinTypes)
                            {
                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 cursor-pointer text-xs">
                                    <input type="checkbox" name="SkinTypeIds" value="@st.Id" class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                                    <span class="font-medium text-slate-700 dark:text-slate-200">@st.Name</span>
                                </label>
                            }
                        </div>
                    </div>

                    <!-- Concerns Checkboxes -->
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-200 mb-2 flex items-center gap-1.5">
                            <i class="fa-solid fa-wand-magic-sparkles text-magenta-accent"></i>
                            <span>Chọn Mối quan tâm cần gán:</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var c in concerns)
                            {
                                <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 cursor-pointer text-xs">
                                    <input type="checkbox" name="ConcernIds" value="@c.Id" class="rounded border-slate-300 text-magenta-accent focus:ring-magenta-accent" />
                                    <span class="font-medium text-slate-700 dark:text-slate-200">@c.Name</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-2">
                    <button type="button" @@click="isBulkModalOpen = false" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-slate-700 text-xs font-semibold">
                        Hủy
                    </button>
                    <button type="submit" class="px-6 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-95 text-white text-xs font-bold shadow-md">
                        Xác Nhận Áp Dụng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function adminProductAttributes() {
        return {
            selectedProductIds: [],
            isSingleModalOpen: false,
            isBulkModalOpen: false,
            bulkMode: 'ADD',
            singleProduct: {
                id: 0,
                name: '',
                skinTypeIds: [],
                concernIds: []
            },

            toggleSelectAll(e) {
                if (e.target.checked) {
                    const checkboxes = document.querySelectorAll('tbody input[type="checkbox"]');
                    this.selectedProductIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
                } else {
                    this.selectedProductIds = [];
                }
            },

            openSingleEditModal(id, name, skinTypeIds, concernIds) {
                this.singleProduct = {
                    id: id,
                    name: name,
                    skinTypeIds: skinTypeIds || [],
                    concernIds: concernIds || []
                };
                this.isSingleModalOpen = true;
            },

            openBulkEditModal() {
                if (this.selectedProductIds.length === 0) return;
                this.isBulkModalOpen = true;
            }
        };
    }
</script>
