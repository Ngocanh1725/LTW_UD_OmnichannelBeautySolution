<div id="toastNotification" class="fixed bottom-6 right-6 z-50 max-w-md bg-slate-900/95 dark:bg-slate-800/95 text-white backdrop-blur-xl border border-rose-500/30 rounded-2xl p-4 shadow-2xl flex items-start gap-3">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center text-lg flex-shrink-0 shadow-lg shadow-rose-500/40">
        <i class="fa-solid fa-bolt text-yellow-300"></i>
    </div>
    <div class="flex-grow">
        <div class="font-bold text-sm text-rose-300" id="toastTitle">Flash Sale Smart Clearance</div>
        <div class="text-xs text-slate-200 mt-0.5" id="toastMessage">Đã kích hoạt chương trình thanh lý cho lô hàng cận date thành công!</div>
    </div>
    <button onclick="hideToast()" class="text-slate-400 hover:text-white p-1 text-sm">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

@section Scripts {
    <!-- Thư viện Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Alpine Counter Animation Component
        function kpiCounter(targetValue, isCurrency = false) {
            return {
                current: 0,
                target: targetValue,
                display: isCurrency ? '0 đ' : '0',
                init() {
                    const duration = 1200; // 1.2s
                    const startTime = performance.now();
                    const step = (now) => {
                        const elapsed = now - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const ease = 1 - Math.pow(1 - progress, 3);
                        this.current = Math.floor(ease * this.target);
                        this.display = isCurrency 
                            ? this.current.toLocaleString('vi-VN') + ' đ'
                            : this.current.toLocaleString('vi-VN');
                        if (progress < 1) {
                            requestAnimationFrame(step);
                        } else {
                            this.current = this.target;
                            this.display = isCurrency 
                                ? this.target.toLocaleString('vi-VN') + ' đ'
                                : this.target.toLocaleString('vi-VN');
                        }
                    };
                    requestAnimationFrame(step);
                }
            };
        }

        // =====================================================================
        // THAO TÁC NHANH: ĐẨY LÔ HÀNG SANG FLASH SALE SMART CLEARANCE
        // =====================================================================
        let toastTimeout;
        function showToast(title, message) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMessage').textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                hideToast();
            }, 4500);
        }

        function hideToast() {
            const toast = document.getElementById('toastNotification');
            toast.classList.remove('show');
        }

        async function pushToFlashSale(batchId, batchNumber, productName, btnElement) {
            const originalContent = btnElement.innerHTML;
            btnElement.disabled = true;
            btnElement.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang đẩy...';

            try {
                const response = await fetch('/Admin/Dashboard/PushToFlashSale', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        batchId: batchId,
                        discountPercent: 50
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showToast('Flash Sale Activated! ⚡', data.message || `Đã kích hoạt Flash Sale Smart Clearance giảm 50% cho lô ${batchNumber}!`);
                    
                    // Cập nhật nút thành badge thành công
                    btnElement.outerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                            <i class="fa-solid fa-circle-check text-emerald-500"></i> Đã Flash Sale (-50%)
                        </span>
                    `;

                    // Cập nhật cột giá trị rủi ro trên dòng tương ứng
                    const row = document.getElementById(`batch-row-${batchId}`);
                    if (row) {
                        const riskCell = row.children[6];
                        if (riskCell) {
                            const subSpan = riskCell.querySelector('span');
                            if (subSpan) {
                                subSpan.className = "inline-block mt-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-200 dark:border-emerald-800";
                                subSpan.textContent = "Flash Sale -50%";
                            }
                        }
                    }
                } else {
                    alert(data.message || 'Có lỗi xảy ra khi đẩy sang Flash Sale.');
                    btnElement.disabled = false;
                    btnElement.innerHTML = originalContent;
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối khi gửi yêu cầu. Vui lòng thử lại.');
                btnElement.disabled = false;
                btnElement.innerHTML = originalContent;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // =================================================================
            // 1. BIỂU ĐỒ LINE: Doanh Thu 7 Ngày Gần Nhất (So Sánh Tuần Này vs Tuần Trước)
            // =================================================================
            const lineLabels7 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Revenue7DaysComparison.DayLabels));
            const lineCurrentWeekData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Revenue7DaysComparison.CurrentWeekRevenues));
            const linePreviousWeekData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Revenue7DaysComparison.PreviousWeekRevenues));

            const ctxLine7 = document.getElementById('revenueTrend7DaysChart').getContext('2d');
            
            // Gradients
            const gradCur = ctxLine7.createLinearGradient(0, 0, 0, 300);
            gradCur.addColorStop(0, 'rgba(225, 29, 72, 0.28)');
            gradCur.addColorStop(1, 'rgba(225, 29, 72, 0.0)');

            new Chart(ctxLine7, {
                type: 'line',
                data: {
                    labels: lineLabels7,
                    datasets: [
                        {
                            label: 'Tuần Này (7 Ngày)',
                            data: lineCurrentWeekData,
                            borderColor: '#e11d48',
                            backgroundColor: gradCur,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#e11d48',
                            pointBorderWidth: 2.5,
                            pointRadius: 4.5,
                            pointHoverRadius: 7,
                            pointHoverBackgroundColor: '#e11d48',
                            pointHoverBorderColor: '#ffffff'
                        },
                        {
                            label: 'Tuần Trước',
                            data: linePreviousWeekData,
                            borderColor: '#6366f1',
                            borderDash: [5, 5],
                            backgroundColor: 'transparent',
                            borderWidth: 2.2,
                            fill: false,
                            tension: 0.35,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#6366f1',
                            pointBorderWidth: 2,
                            pointRadius: 3.5,
                            pointHoverRadius: 6,
                            pointHoverBackgroundColor: '#6366f1',
                            pointHoverBorderColor: '#ffffff'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            align: 'end',
                            labels: {
                                boxWidth: 12,
                                boxHeight: 12,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '600' },
                                color: '#64748b'
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#e2e8f0',
                            padding: 12,
                            borderRadius: 12,
                            callbacks: {
                                label: function (context) {
                                    const val = Number(context.raw).toLocaleString('vi-VN') + ' đ';
                                    return ` ${context.dataset.label}: ${val}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                font: { family: "'Plus Jakarta Sans', sans-serif", size: 11, weight: '600' },
                                color: '#94a3b8'
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(226, 232, 240, 0.4)',
                                borderDash: [4, 4]
                            },
                            ticks: {
                                font: { family: "'JetBrains Mono', monospace", size: 10 },
                                color: '#94a3b8',
                                callback: function (value) {
                                    if (value >= 1000000) return (value / 1000000) + 'M';
                                    if (value >= 1000) return (value / 1000) + 'k';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });

            // =================================================================
            // 2. BIỂU ĐỒ DOUGHNUT: Tỷ Trọng Doanh Thu Theo Kênh Bán (POS vs Online)
            // =================================================================
            const channelLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChannelDistributions.Select(c => c.ChannelName)));
            const channelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChannelDistributions.Select(c => c.Revenue)));
            const channelColors = ['#e11d48', '#6366f1', '#0ea5e9', '#10b981'];

            const ctxDoughnutChan = document.getElementById('channelRevenueDoughnutChart').getContext('2d');
            new Chart(ctxDoughnutChan, {
                type: 'doughnut',
                data: {
                    labels: channelLabels,
                    datasets: [{
                        data: channelData,
                        backgroundColor: channelColors,
                        borderWidth: 3,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#e2e8f0',
                            padding: 11,
                            borderRadius: 12,
                            callbacks: {
                                label: function (context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const val = Number(context.raw);
                                    const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                    return ` ${context.label}: ${val.toLocaleString('vi-VN')} đ (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '72%'
                }
            });

            // =================================================================
            // 3. BIỂU ĐỒ BAR NGANG: Doanh Thu Theo Chi Nhánh
            // =================================================================
            const storeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StoreDistributions.Select(s => s.StoreName)));
            const storeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StoreDistributions.Select(s => s.Revenue)));

            const ctxBar = document.getElementById('storeBarChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: storeLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: storeData,
                        backgroundColor: ['#10b981', '#06b6d4', '#f59e0b', '#8b5cf6'],
                        borderRadius: 8,
                        barThickness: 20
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#e2e8f0',
                            padding: 10,
                            borderRadius: 10,
                            callbacks: {
                                label: function (context) {
                                    return ' Doanh thu: ' + Number(context.raw).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(226, 232, 240, 0.4)',
                                borderDash: [4, 4]
                            },
                            ticks: {
                                font: { family: "'JetBrains Mono', monospace", size: 10 },
                                color: '#94a3b8',
                                callback: function (value) {
                                    if (value >= 1000000) return (value / 1000000) + 'M';
                                    if (value >= 1000) return (value / 1000) + 'k';
                                    return value;
                                }
                            }
                        },
                        y: {
                            grid: { display: false },
                            ticks: {
                                font: { family: "'Plus Jakarta Sans', sans-serif", weight: '600', size: 11 },
                                color: '#475569'
                            }
                        }
                    }
                }
            });
        });
    </script>
}