@model Omnichannel.Application.DTOs.Reports.DashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị - Executive Retail Analytics";
    Layout = "_AdminLayout";
    var userDisplayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value 
                          ?? User.Identity?.Name 
                          ?? "Quản Trị Viên";
}

<style>
    /* Staggered Fade-in Animations */
    @@keyframes fadeInUpStagger {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-stagger-1 { animation: fadeInUpStagger 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .animate-stagger-2 { animation: fadeInUpStagger 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
    .animate-stagger-3 { animation: fadeInUpStagger 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
    .animate-stagger-4 { animation: fadeInUpStagger 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both; }
    .animate-stagger-5 { animation: fadeInUpStagger 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both; }

    /* Card Glow & Hover Transition */
    .beauty-card-hover {
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s ease;
    }
    .beauty-card-hover:hover {
        transform: translateY(-4px);
    }

    /* Smooth HTMX Live Swap Transition */
    #kpiRealtimeWrapper {
        transition: opacity 0.3s ease;
    }
    #kpiRealtimeWrapper.htmx-swapping {
        opacity: 0.4;
    }
    #kpiRealtimeWrapper.htmx-settling {
        opacity: 1;
    }

    /* Flash Sale Glow Button */
    .btn-clearance-glow {
        background: linear-gradient(135deg, #e11d48 0%, #be123c 50%, #9f1239 100%);
        box-shadow: 0 4px 14px 0 rgba(225, 29, 72, 0.39);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-clearance-glow:hover {
        box-shadow: 0 6px 20px rgba(225, 29, 72, 0.55);
        transform: translateY(-1px) scale(1.02);
    }
    .btn-clearance-glow:active {
        transform: translateY(0) scale(0.98);
    }

    /* Toast Notification */
    #toastNotification {
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        transform: translateY(100px);
        opacity: 0;
        pointer-events: none;
    }
    #toastNotification.show {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
</style>

<!-- =========================================================================
     1. HEADER SECTION (Cá nhân hóa + Clock Alpine.js + Nút nhanh)
     ========================================================================= -->
<div class="mb-8 animate-stagger-1">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-3 mb-1.5 flex-wrap">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <span>Xin chào, <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500">@userDisplayName</span>! 👋</span>
                </h1>
                @if (Model.IsStoreScoped)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800 shadow-sm">
                        <i class="fa-solid fa-store"></i> Chi nhánh: @Model.CurrentStoreName
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800 shadow-sm">
                        <i class="fa-solid fa-globe"></i> Toàn Hệ Thống Toàn Quốc
                    </span>
                }
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 shadow-sm">
                    <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span> Executive Live 30s
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-sm">
                Trung tâm phân tích bán lẻ đa kênh & Kiểm soát rủi ro tồn kho FEFO theo tiêu chuẩn Dược Mỹ Phẩm.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <!-- Đồng hồ thời gian thực bằng Alpine.js -->
            <div x-data="{
                    timeStr: '',
                    dateStr: '',
                    updateClock() {
                        const now = new Date();
                        const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
                        this.dateStr = `${days[now.getDay()]}, ${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()}`;
                        this.timeStr = now.toLocaleTimeString('vi-VN', { hour12: false });
                    },
                    init() {
                        this.updateClock();
                        setInterval(() => this.updateClock(), 1000);
                    }
                }" class="flex items-center gap-2 text-xs font-semibold text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
                <i class="fa-regular fa-clock text-rose-500"></i>
                <span x-text="dateStr"></span>
                <span class="text-slate-300 dark:text-slate-700">•</span>
                <span x-text="timeStr" class="font-mono text-slate-900 dark:text-white font-bold"></span>
            </div>

            <!-- Nút Hành Động Nhanh -->
            <a href="/Admin/Pos" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-500 hover:from-rose-700 hover:to-pink-600 shadow-md shadow-rose-500/25 transition active:scale-95">
                <i class="fa-solid fa-cash-register"></i> Bán tại quầy POS (F1)
            </a>
            <a href="#fefoRiskSection" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/50 hover:bg-amber-100 dark:hover:bg-amber-900/60 border border-amber-300 dark:border-amber-800 shadow-sm transition active:scale-95">
                <i class="fa-solid fa-triangle-exclamation text-amber-500"></i> Kho Cận Date FEFO
            </a>
            <a href="/Admin/Report" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 shadow-sm transition active:scale-95">
                <i class="fa-solid fa-chart-line text-indigo-500"></i> Báo cáo BI chi tiết
            </a>
        </div>
    </div>
</div>

<!-- =========================================================================
     2. 6 THẺ CHỈ SỐ KPI HÀNG ĐẦU (EXECUTIVE METRIC CARDS - LIVE HTMX 30s)
     ========================================================================= -->
@{
    var initialKpiDto = new Omnichannel.Application.DTOs.Reports.RealtimeKpiDto
    {
        TodayRevenue = Model.TodayRevenue,
        TodayRevenueFormatted = Model.TodayRevenue.ToString("N0") + " đ",
        MonthRevenue = Model.MonthRevenue,
        MonthRevenueFormatted = Model.MonthRevenue.ToString("N0") + " đ",
        TodayOrderCount = Model.TodayOrderCount,
        MonthTotalOrders = Model.MonthTotalOrders,
        MonthOnlineOrders = Model.MonthOnlineOrders,
        MonthPosOrders = Model.MonthPosOrders,
        CustomerRetentionRate = Model.CustomerRetentionRate,
        FefoRiskInventoryValue = Model.FefoRiskInventoryValue,
        FefoRiskInventoryValueFormatted = Model.FefoRiskInventoryValue.ToString("N0") + " đ",
        FefoRiskBatchCount = Model.FefoRiskBatchCount,
        TotalInventoryValue = Model.TotalInventoryValue,
        TotalInventoryValueFormatted = Model.TotalInventoryValueFormatted,
        NewCustomersThisMonth = Model.NewCustomersThisMonth,
        TotalProducts = Model.TotalProducts,
        TotalStores = Model.TotalStores,
        TodayVsYesterdayRevenueGrowth = Model.TodayVsYesterdayRevenueGrowth,
        MonthVsLastMonthRevenueGrowth = Model.MonthVsLastMonthRevenueGrowth,
        TodayVsYesterdayOrderGrowth = Model.TodayVsYesterdayOrderGrowth,
        LastUpdated = DateTime.Now.ToString("HH:mm:ss")
    };
}
<div id="kpiRealtimeWrapper" 
     hx-get="/Admin/Dashboard/GetRealtimeStats" 
     hx-trigger="every 30s" 
     hx-swap="innerHTML"
     class="mb-8 animate-stagger-2">
    @await Html.PartialAsync("_RealtimeKpis", initialKpiDto)
</div>

<!-- =========================================================================
     3. 3 BIỂU ĐỒ TRỰC QUAN HÓA DỮ LIỆU (CHART.JS)
     - Line Chart: Doanh thu 7 ngày gần nhất (so sánh với tuần trước)
     - Doughnut Chart: Tỷ trọng doanh thu theo kênh bán (POS vs Online)
     - Bar Chart: Doanh thu phân bổ theo chi nhánh
     ========================================================================= -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8 animate-stagger-3">
    <!-- Cột Trái (8/12): Doanh Thu 7 Ngày Gần Nhất (So Sánh Tuần Này vs Tuần Trước) -->
    <div class="lg:col-span-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm h-full flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-100 dark:border-slate-800 mb-4 gap-2">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-rose-500"></i>
                        Doanh Thu 7 Ngày Gần Nhất (So Sánh Tuần Này vs Tuần Trước)
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Đối chiếu doanh số thực tế 7 ngày vừa qua so với cùng kỳ tuần trước</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Tuần Này
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> Tuần Trước
                    </span>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-extrabold @(Model.Revenue7DaysComparison.GrowthRate >= 0 ? "bg-emerald-50 text-emerald-600 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-400 dark:border-emerald-800" : "bg-rose-50 text-rose-600 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-400 dark:border-rose-800")">
                        @(Model.Revenue7DaysComparison.GrowthRate >= 0 ? "+" : "")@Model.Revenue7DaysComparison.GrowthRate%
                    </span>
                </div>
            </div>

            <div class="relative flex-grow" style="min-height: 310px;">
                <canvas id="revenueTrend7DaysChart"></canvas>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-3">
                <div class="flex items-center gap-4">
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-calendar-week text-rose-500"></i>Tuần này: <strong class="text-slate-800 dark:text-white font-mono">@Model.Revenue7DaysComparison.CurrentWeekTotal.ToString("N0") đ</strong></span>
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-clock-rotate-left text-indigo-500"></i>Tuần trước: <strong class="text-slate-800 dark:text-white font-mono">@Model.Revenue7DaysComparison.PreviousWeekTotal.ToString("N0") đ</strong></span>
                </div>
                <div class="font-mono font-bold text-slate-800 dark:text-white">
                    Tăng trưởng: <span class="@(Model.Revenue7DaysComparison.GrowthRate >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400") font-extrabold">@(Model.Revenue7DaysComparison.GrowthRate >= 0 ? "+" : "")@Model.Revenue7DaysComparison.GrowthRate%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột Phải (4/12): Doughnut Chart Tỷ Trọng Doanh Thu Theo Kênh Bán (POS vs Online) -->
    <div class="lg:col-span-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm h-full flex flex-col justify-between">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800 mb-4">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-pink-500"></i>
                        Kênh Bán Hàng
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Tỷ trọng POS Tại Quầy vs Storefront Online</p>
                </div>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-pink-50 dark:bg-pink-950/60 text-pink-600 dark:text-pink-400 border border-pink-200 dark:border-pink-800">
                    Omnichannel
                </span>
            </div>

            <div class="relative flex items-center justify-center py-2" style="min-height: 230px;">
                <div style="width: 220px; height: 220px; position: relative;">
                    <canvas id="channelRevenueDoughnutChart"></canvas>
                </div>
            </div>

            <!-- Legend Phân Tách Kênh Bán -->
            <div class="pt-4 mt-2 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2.5 max-h-[170px] overflow-y-auto">
                @foreach (var ch in Model.ChannelDistributions)
                {
                    var chColor = ch.ChannelKey.ToUpper() switch
                    {
                        "POS" or "STORE" or "OFFLINE" => "#e11d48",
                        "WEBSITE" or "ONLINE" => "#6366f1",
                        _ => "#0ea5e9"
                    };
                    <div class="flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: @chColor;"></span>
                            <span class="font-semibold text-slate-700 dark:text-slate-200 truncate" title="@ch.ChannelName">@ch.ChannelName</span>
                        </div>
                        <div class="font-mono text-slate-800 dark:text-slate-300 font-bold flex-shrink-0 text-right">
                            @ch.Revenue.ToString("N0") đ <span class="text-slate-400 font-normal">(@ch.Percentage%)</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     4. BẢNG CẢNH BÁO KHO HÀNG CẬN DATE (FEFO RISK MONITOR TABLE - TOP 10 SẢN PHẨM)
     ========================================================================= -->
<div id="fefoRiskSection" class="mb-8 animate-stagger-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm overflow-hidden">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-100 dark:border-slate-800 mb-4 gap-3">
            <div>
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-sm font-bold border border-amber-200 dark:border-amber-800">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">
                        Bảng Cảnh Báo Kho Hàng Cận Date (FEFO Risk Monitor - Top 10 Sản Phẩm)
                    </h3>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
                        ≤ 90 Ngày
                    </span>
                </div>
                <p class="text-xs text-slate-400 mt-1">
                    Thuật toán FEFO (First-Expired, First-Out) kiểm soát hạn dùng mỹ phẩm. Thao tác 1 chạm đẩy sang <strong>Flash Sale Smart Clearance</strong> để thu hồi vốn tức thì.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <a href="/Admin/Warehouse" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                    <i class="fa-solid fa-warehouse"></i> Quản lý kho FEFO
                </a>
            </div>
        </div>

        @if (!Model.NearExpiryBatches.Any())
        {
            <div class="text-center py-12 text-slate-400">
                <div class="w-16 h-16 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-500 mx-auto flex items-center justify-center text-2xl mb-3 border border-emerald-200 dark:border-emerald-800">
                    <i class="fa-solid fa-shield-check"></i>
                </div>
                <div class="text-sm font-bold text-slate-700 dark:text-slate-200">Kho hàng đang ở trạng thái an toàn tuyệt đối!</div>
                <div class="text-xs text-slate-400 mt-1">Không có lô hàng mỹ phẩm nào cận date dưới 90 ngày.</div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="text-slate-400 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 font-bold bg-slate-50/50 dark:bg-slate-800/20">
                            <th class="py-3 px-3 text-center" style="width: 44px;">#</th>
                            <th class="py-3 px-3">Mỹ Phẩm / Mã SKU</th>
                            <th class="py-3 px-3">Mã Lô (Batch)</th>
                            <th class="py-3 px-3 text-center">Tồn Kho</th>
                            <th class="py-3 px-3">Ngày Hết Hạn (EXP)</th>
                            <th class="py-3 px-3 text-center">Thời Gian Còn</th>
                            <th class="py-3 px-3 text-right">Giá Trị Rủi Ro</th>
                            <th class="py-3 px-3 text-center">Thao Tác Nhanh</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
                        @{ int batchIndex = 1; }
                        @foreach (var batch in Model.NearExpiryBatches)
                        {
                            <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition group" id="batch-row-@batch.BatchId">
                                <td class="py-3.5 px-3 text-center font-mono font-bold text-slate-400">
                                    @batchIndex
                                </td>
                                <td class="py-3.5 px-3">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(batch.ThumbnailUrl))
                                        {
                                            <img src="@batch.ThumbnailUrl" alt="@batch.ProductName" class="w-10 h-10 rounded-xl object-cover border border-slate-200 dark:border-slate-700 flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-500 flex items-center justify-center text-sm font-bold flex-shrink-0 border border-rose-200 dark:border-rose-800">
                                                <i class="fa-solid fa-spray-can-sparkles"></i>
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-900 dark:text-slate-100 truncate max-w-[240px]" title="@batch.ProductName">
                                                @batch.ProductName
                                            </div>
                                            <div class="flex items-center gap-2 mt-0.5">
                                                <span class="font-mono text-[11px] text-slate-400">@batch.Sku</span>
                                                <span class="text-slate-300 dark:text-slate-700">•</span>
                                                <span class="text-[11px] text-slate-500 dark:text-slate-400">@batch.StoreName</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3">
                                    <span class="inline-block px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono text-[11px] font-bold rounded-lg border border-slate-200 dark:border-slate-700">
                                        @batch.BatchNumber
                                    </span>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    <span class="font-mono font-extrabold text-slate-900 dark:text-white text-sm">
                                        @batch.CurrentQuantity
                                    </span>
                                    <span class="text-slate-400 text-[10px] block">sản phẩm</span>
                                </td>
                                <td class="py-3.5 px-3">
                                    <div class="font-mono font-bold text-slate-800 dark:text-slate-200">
                                        @batch.ExpDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="text-[10px] text-slate-400">
                                        SX: @batch.ManufacturingDate.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td class="py-3.5 px-3 text-center">
                                    @if (batch.DaysRemaining <= 30)
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full font-mono text-xs font-extrabold bg-rose-100 text-rose-700 border border-rose-300 dark:bg-rose-950 dark:text-rose-300 dark:border-rose-800 animate-pulse shadow-sm">
                                            <i class="fa-solid fa-triangle-exclamation"></i> Còn @batch.DaysRemaining ngày
                                        </span>
                                    }
                                    else if (batch.DaysRemaining <= 60)
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full font-mono text-xs font-bold bg-orange-100 text-orange-800 border border-orange-300 dark:bg-orange-950 dark:text-orange-300 dark:border-orange-800 shadow-sm">
                                            <i class="fa-solid fa-hourglass-half"></i> Còn @batch.DaysRemaining ngày
                                        </span>
                                    }
                                    else
                                    {
