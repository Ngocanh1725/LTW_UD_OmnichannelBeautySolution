</div>

<!-- =========================================================================
     TOAST NOTIFICATION MODAL CHO SMART CLEARANCE & VOUCHER CREATION
     ========================================================================= -->
<div id="toastNotification" class="fixed bottom-6 right-6 z-50 max-w-md bg-slate-900/95 dark:bg-slate-800/95 text-white backdrop-blur-xl border border-rose-500/30 rounded-2xl p-4 shadow-2xl flex items-start gap-3">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 flex items-center justify-center text-lg flex-shrink-0 shadow-lg shadow-rose-500/40" id="toastIcon">
        <i class="fa-solid fa-bolt text-yellow-300"></i>
    </div>
    <div class="flex-grow">
        <div class="font-bold text-sm text-rose-300" id="toastTitle">Thông Báo Vận Hành</div>
        <div class="text-xs text-slate-200 mt-0.5" id="toastMessage">Thao tác hoàn tất thành công!</div>
    </div>
    <button onclick="hideToast()" class="text-slate-400 hover:text-white p-1 text-sm">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let toastTimeout;
        function showToast(title, message, isSuccess = true) {
            const toast = document.getElementById('toastNotification');
            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastMessage').textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                hideToast();
            }, 5000);
        }

        function hideToast() {
            const toast = document.getElementById('toastNotification');
            toast.classList.remove('show');
        }

        // 1-Click Tạo Voucher Nhắm Mục Tiêu cho phân khúc RFM
        async function createTargetedVoucher(segmentCode, discountPercent, btnElement) {
            const originalContent = btnElement.innerHTML;
            btnElement.disabled = true;
            btnElement.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang tạo...';

            try {
                const response = await fetch('/Admin/Dashboard/CreateTargetedVoucher', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        segmentCode: segmentCode,
                        discountPercent: discountPercent
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showToast('Voucher Đã Phát Hành! 🎟️', data.message);
                    btnElement.outerHTML = `
                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <i class="fa-solid fa-circle-check text-emerald-500"></i> ${data.couponCode}
                        </span>
                    `;
                } else {
                    alert(data.message || 'Có lỗi xảy ra khi tạo Voucher.');
                    btnElement.disabled = false;
                    btnElement.innerHTML = originalContent;
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối khi gửi yêu cầu. Vui lòng thử lại.');
                btnElement.disabled = false;
                btnElement.innerHTML = originalContent;
            }
        }

        // Đẩy lô hàng cận date sang Flash Sale Smart Clearance
        async function pushToFlashSale(batchId, batchNumber, productName, btnElement) {
            const originalContent = btnElement.innerHTML;
            btnElement.disabled = true;
            btnElement.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang đẩy...';

            try {
                const response = await fetch('/Admin/Dashboard/PushToFlashSale', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        batchId: batchId,
                        discountPercent: 50
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showToast('Flash Sale Activated! ⚡', data.message || `Đã kích hoạt Flash Sale cho lô ${batchNumber}!`);
                    btnElement.outerHTML = `
                        <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <i class="fa-solid fa-circle-check text-emerald-500"></i> Đã Flash Sale (-50%)
                        </span>
                    `;
                } else {
                    alert(data.message || 'Có lỗi xảy ra khi đẩy sang Flash Sale.');
                    btnElement.disabled = false;
                    btnElement.innerHTML = originalContent;
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối khi gửi yêu cầu.');
                btnElement.disabled = false;
                btnElement.innerHTML = originalContent;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // =================================================================
            // 1. BIỂU ĐỒ LINE: Biến Động Doanh Thu Kỳ Đã Lọc (Online vs POS vs Tổng)
            // =================================================================
            const lineLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyChannelRevenues.Select(x => x.Date)));
            const lineOnlineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyChannelRevenues.Select(x => x.OnlineRevenue)));
            const linePosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyChannelRevenues.Select(x => x.PosRevenue)));
            const lineTotalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyChannelRevenues.Select(x => x.TotalRevenue)));

            const chartEl = document.getElementById('revenueTrendChart');
            if (chartEl) {
                const ctxLine = chartEl.getContext('2d');
                new Chart(ctxLine, {
                    type: 'line',
                    data: {
                        labels: lineLabels,
                        datasets: [
                            {
                                label: 'Online Storefront (Web/App)',
                                data: lineOnlineData,
                                borderColor: '#e11d48',
                                backgroundColor: 'rgba(225, 29, 72, 0.12)',
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointRadius: 2.5
                            },
                            {
                                label: 'Bán Lẻ POS (Tại Quầy)',
                                data: linePosData,
                                borderColor: '#6366f1',
                                backgroundColor: 'rgba(99, 102, 241, 0.08)',
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointRadius: 2.5
                            },
                            {
                                label: 'Tổng Doanh Thu Hợp Nhất',
                                data: lineTotalData,
                                borderColor: '#10b981',
                                borderDash: [5, 4],
                                borderWidth: 2,
                                fill: false,
                                tension: 0.35,
                                pointRadius: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                align: 'end',
                                labels: { boxWidth: 10, usePointStyle: true, font: { size: 11, weight: '600' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ` ${ctx.dataset.label}: ${Number(ctx.raw).toLocaleString('vi-VN')} đ`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (val) {
                                        if (val >= 1000000) return (val / 1000000).toFixed(0) + 'M';
                                        if (val >= 1000) return (val / 1000).toFixed(0) + 'k';
                                        return val;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // =================================================================
            // 2. BIỂU ĐỒ DOUGHNUT: Cơ Cấu Danh Mục Mỹ Phẩm
            // =================================================================
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.CategoryName)));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.Revenue)));
            const catColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryRevenues.Select(c => c.Color)));

            const ctxDoughnutCat = document.getElementById('categoryRevenueDoughnutChart').getContext('2d');
            new Chart(ctxDoughnutCat, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: catColors.length > 0 ? catColors : ['#e11d48', '#6366f1', '#0ea5e9', '#10b981'],
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    const val = Number(ctx.raw);
                                    const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                    return ` ${ctx.label}: ${val.toLocaleString('vi-VN')} đ (${pct}%)`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
}
