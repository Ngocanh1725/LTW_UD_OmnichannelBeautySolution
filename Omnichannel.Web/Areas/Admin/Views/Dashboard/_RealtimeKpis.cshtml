@model Omnichannel.Application.DTOs.Reports.RealtimeKpiDto

<!-- =========================================================================
     6 EXECUTIVE METRIC CARDS (Thời Gian Thực - HTMX Live Polling 30s)
     ========================================================================= -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 sm:gap-5">
    <!-- Card 1: Doanh Thu Hôm Nay -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-rose-500/10 hover:-translate-y-1 hover:border-rose-300 dark:hover:border-rose-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-rose-500 via-pink-500 to-rose-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 text-white flex items-center justify-center text-lg shadow-md shadow-rose-500/30">
                    <i class="fa-solid fa-coins"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold @(Model.TodayVsYesterdayRevenueGrowth >= 0 ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800" : "bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-200 dark:border-rose-800")">
                    <i class="fa-solid @(Model.TodayVsYesterdayRevenueGrowth >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                    @(Model.TodayVsYesterdayRevenueGrowth >= 0 ? "+" : "")@Model.TodayVsYesterdayRevenueGrowth%
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Doanh Thu Hôm Nay</div>
            <div class="text-xl sm:text-2xl font-extrabold text-rose-600 dark:text-rose-400 font-mono tracking-tight truncate" title="@Model.TodayRevenueFormatted">
                @Model.TodayRevenueFormatted
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Hôm nay (@Model.TodayOrderCount đơn)</span>
            <span class="font-mono text-slate-500 dark:text-slate-400"><i class="fa-solid fa-rotate text-rose-400 me-1"></i>@Model.LastUpdated</span>
        </div>
    </div>

    <!-- Card 2: Doanh Thu Tháng Này -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 hover:-translate-y-1 hover:border-indigo-300 dark:hover:border-indigo-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-violet-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-purple-600 text-white flex items-center justify-center text-lg shadow-md shadow-indigo-500/30">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold @(Model.MonthVsLastMonthRevenueGrowth >= 0 ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800" : "bg-rose-50 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 border border-rose-200 dark:border-rose-800")">
                    <i class="fa-solid @(Model.MonthVsLastMonthRevenueGrowth >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                    @(Model.MonthVsLastMonthRevenueGrowth >= 0 ? "+" : "")@Model.MonthVsLastMonthRevenueGrowth%
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Doanh Thu Tháng</div>
            <div class="text-xl sm:text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 font-mono tracking-tight truncate" title="@Model.MonthRevenueFormatted">
                @Model.MonthRevenueFormatted
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Lũy kế toàn chuỗi</span>
            <span class="text-indigo-500 font-semibold"><i class="fa-solid fa-check-double me-1"></i>Tháng</span>
        </div>
    </div>

    <!-- Card 3: Đơn Hàng Mới -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-sky-500/10 hover:-translate-y-1 hover:border-sky-300 dark:hover:border-sky-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-500 via-cyan-500 to-blue-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center text-lg shadow-md shadow-sky-500/30">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-sky-50 text-sky-600 dark:bg-sky-950/60 dark:text-sky-400 border border-sky-200 dark:border-sky-800">
                    <i class="fa-solid fa-layer-group"></i> Đa kênh
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Đơn Hàng Mới</div>
            <div class="text-xl sm:text-2xl font-extrabold text-sky-600 dark:text-sky-400 font-mono tracking-tight">
                @Model.MonthTotalOrders.ToString("N0") <span class="text-xs font-normal text-slate-400">đơn</span>
            </div>
            <!-- Thanh tỷ trọng Online / POS -->
            <div class="mt-2.5">
                <div class="h-1.5 w-full rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden flex">
                    <div class="bg-indigo-500 h-full" style="width: @(Model.MonthOnlinePercentage)%"></div>
                    <div class="bg-rose-500 h-full" style="width: @(Model.MonthPosPercentage)%"></div>
                </div>
                <div class="mt-1 flex items-center justify-between text-[10px] text-slate-400">
                    <span>Web: @Model.MonthOnlinePercentage%</span>
                    <span>POS: @Model.MonthPosPercentage%</span>
                </div>
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Hôm nay: @Model.TodayOrderCount đơn</span>
            <span class="text-sky-500 font-semibold"><i class="fa-solid fa-bolt me-1"></i>Live</span>
        </div>
    </div>

    <!-- Card 4: Khách Hàng Mới -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-emerald-500/10 hover:-translate-y-1 hover:border-emerald-300 dark:hover:border-emerald-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-500 text-white flex items-center justify-center text-lg shadow-md shadow-emerald-500/30">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                    <i class="fa-solid fa-arrows-rotate"></i> @Model.CustomerRetentionRate%
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Khách Hàng Mới</div>
            <div class="text-xl sm:text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono tracking-tight">
                @Model.NewCustomersThisMonth.ToString("N0") <span class="text-xs font-normal text-slate-400">khách</span>
            </div>
            <div class="mt-2 text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <i class="fa-solid fa-heart text-pink-500 text-[10px]"></i> Tỷ lệ quay lại: <strong class="text-emerald-600 font-mono">@Model.CustomerRetentionRate%</strong>
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Thành viên VIP & CRM</span>
            <span class="text-emerald-500 font-semibold"><i class="fa-solid fa-gem me-1"></i>Loyalty</span>
        </div>
    </div>

    <!-- Card 5: Giá Trị Tồn Kho -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-violet-500/10 hover:-translate-y-1 hover:border-violet-300 dark:hover:border-violet-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-violet-500 via-purple-500 to-indigo-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-600 to-purple-600 text-white flex items-center justify-center text-lg shadow-md shadow-violet-500/30">
                    <i class="fa-solid fa-cubes-stacked"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-violet-50 text-violet-700 dark:bg-violet-950/60 dark:text-violet-300 border border-violet-200 dark:border-violet-800">
                    <i class="fa-solid fa-box"></i> @Model.TotalProducts SKU
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Giá Trị Tồn Kho</div>
            <div class="text-xl sm:text-2xl font-extrabold text-violet-600 dark:text-violet-400 font-mono tracking-tight truncate" title="@Model.TotalInventoryValueFormatted">
                @Model.TotalInventoryValueFormatted
            </div>
            <div class="mt-2 text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <i class="fa-solid fa-store text-violet-500 text-[10px]"></i> Trên @Model.TotalStores chi nhánh & kho
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Tổng vốn hàng hóa</span>
            <span class="text-violet-500 font-semibold"><i class="fa-solid fa-warehouse me-1"></i>Kho</span>
        </div>
    </div>

    <!-- Card 6: Cảnh Báo Cận Date FEFO -->
    <div class="group relative bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 shadow-sm hover:shadow-xl hover:shadow-amber-500/10 hover:-translate-y-1 hover:border-amber-300 dark:hover:border-amber-500/40 transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600"></div>
        <div>
            <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-rose-500 text-white flex items-center justify-center text-lg shadow-md shadow-amber-500/30">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800 animate-pulse">
                    <i class="fa-solid fa-clock"></i> ≤90 Ngày
                </span>
            </div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Cảnh Báo Cận Date</div>
            <div class="text-xl sm:text-2xl font-extrabold text-amber-600 dark:text-amber-400 font-mono tracking-tight truncate" title="@Model.FefoRiskInventoryValueFormatted">
                @Model.FefoRiskInventoryValueFormatted
            </div>
            <div class="mt-2 text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <i class="fa-solid fa-boxes-stacked text-amber-500 text-[10px]"></i> <strong class="text-rose-600 dark:text-rose-400 font-mono">@Model.FefoRiskBatchCount lô</strong> cần xả gấp
            </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
            <span>Clearance Sale</span>
            <span class="text-rose-500 font-semibold"><i class="fa-solid fa-bolt me-1"></i>Ưu tiên</span>
        </div>
    </div>
</div>
