@{
    ViewData["Title"] = "Quản lý Khuyến Mãi & Voucher VIP";
    Layout = "_AdminLayout";

    var promotions = ViewBag.Promotions as List<Omnichannel.Application.DTOs.Sales.PromotionDto> ?? new();
    var coupons = ViewBag.Coupons as List<Omnichannel.Domain.Entities.Coupon> ?? new();
    var vouchers = ViewBag.Vouchers as List<Omnichannel.Domain.Entities.Voucher> ?? new();
    var vipWallets = ViewBag.VipWallets as List<Omnichannel.Domain.Entities.LoyaltyWallet> ?? new();
    var customers = ViewBag.Customers as List<Omnichannel.Domain.Entities.User> ?? new();
    string currentTab = ViewBag.CurrentTab as string ?? "promotions";

    var now = DateTime.UtcNow;
    int activePromos = promotions.Count(p => p.IsActive && now >= p.ValidFrom && now <= p.ValidTo);
    int upcomingPromos = promotions.Count(p => p.IsActive && now < p.ValidFrom);
    int expiredPromos = promotions.Count(p => !p.IsActive || now > p.ValidTo);
    int activeCoupons = coupons.Count(c => c.IsActive && now >= c.ValidFrom && now <= c.ValidTo);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">Động Cơ Khuyến Mãi & Voucher VIP</h4>
        <p class="text-muted small mb-0">Thiết lập Flash sale, Chiết khấu %, Quà tặng GWP, Mã Coupon và Phát hành Voucher đặc quyền cho khách hàng VIP.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary-gradient px-3 shadow-xs" onclick="openModal('createPromotionModal')">
            <i class="fa-solid fa-plus me-1.5"></i>Tạo CTKM Mới
        </button>
        <button type="button" class="btn btn-soft-purple px-3 shadow-xs" onclick="openModal('createCouponModal')">
            <i class="fa-solid fa-ticket me-1.5"></i>Tạo Mã Coupon
        </button>
        <button type="button" class="btn btn-warning px-3 shadow-xs text-dark fw-semibold" onclick="openModal('issueVoucherModal')">
            <i class="fa-solid fa-crown me-1.5"></i>Phát Hành Voucher VIP
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 py-2.5 px-3 border-0 bg-success-subtle text-success small mb-3" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2.5 px-3 border-0 bg-danger-subtle text-danger small mb-3" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="beauty-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small fw-medium">CTKM Đang Chạy</div>
                <div class="fs-4 fw-bold text-success mt-1">@activePromos</div>
                <div class="text-success text-[11px] mt-1"><i class="fa-solid fa-bolt me-1"></i>Tự động áp dụng tại giỏ</div>
            </div>
            <div class="stat-icon-square bg-success-subtle text-success">
                <i class="fa-solid fa-fire"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="beauty-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small fw-medium">CTKM Sắp Diễn Ra</div>
                <div class="fs-4 fw-bold text-primary mt-1">@upcomingPromos</div>
                <div class="text-primary text-[11px] mt-1"><i class="fa-solid fa-clock me-1"></i>Chiến dịch sắp tới</div>
            </div>
            <div class="stat-icon-square bg-primary-subtle text-primary">
                <i class="fa-solid fa-calendar-day"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="beauty-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small fw-medium">Mã Coupon Khả Dụng</div>
                <div class="fs-4 fw-bold text-purple mt-1">@activeCoupons</div>
                <div class="text-purple text-[11px] mt-1">Trên tổng @coupons.Count mã</div>
            </div>
            <div class="stat-icon-square bg-purple-light text-purple">
                <i class="fa-solid fa-ticket"></i>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="beauty-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small fw-medium">Voucher VIP Đã Cấp</div>
                <div class="fs-4 fw-bold text-warning mt-1">@vouchers.Count</div>
                <div class="text-warning text-[11px] mt-1"><i class="fa-solid fa-crown me-1"></i>Dành riêng khách hàng VIP</div>
            </div>
            <div class="stat-icon-square bg-warning-subtle text-warning">
                <i class="fa-solid fa-gift"></i>
            </div>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<div class="beauty-card p-2 mb-4">
    <ul class="nav nav-pills gap-1">
        <li class="nav-item">
            <a class="nav-link px-4 py-2 rounded-3 @(currentTab == "promotions" ? "active bg-purple" : "text-secondary")" href="@Url.Action("Index", new { tab = "promotions" })">
                <i class="fa-solid fa-bullhorn me-1.5"></i>Chương Trình Khuyến Mãi <span class="badge rounded-pill bg-light text-dark ms-1">@promotions.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link px-4 py-2 rounded-3 @(currentTab == "coupons" ? "active bg-purple" : "text-secondary")" href="@Url.Action("Index", new { tab = "coupons" })">
                <i class="fa-solid fa-ticket me-1.5"></i>Mã Giảm Giá (Coupons) <span class="badge rounded-pill bg-light text-dark ms-1">@coupons.Count</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link px-4 py-2 rounded-3 @(currentTab == "vouchers" ? "active bg-purple" : "text-secondary")" href="@Url.Action("Index", new { tab = "vouchers" })">
                <i class="fa-solid fa-crown me-1.5"></i>Kho Voucher VIP <span class="badge rounded-pill bg-light text-dark ms-1">@vouchers.Count</span>
            </a>
        </li>
    </ul>
</div>

<!-- TAB 1: PROMOTIONS -->
@if (currentTab == "promotions")
{
    <div class="row g-3 mb-4">
        @if (!promotions.Any())
        {
            <div class="col-12">
                <div class="beauty-card p-5 text-center text-muted">
                    <i class="fa-solid fa-bullhorn fs-1 text-pink-border mb-2" style="color: var(--accent-pink-border);"></i>
                    <div>Chưa có chương trình khuyến mãi nào được tạo.</div>
                </div>
            </div>
        }
        else
        {
            @foreach (var p in promotions)
            {
                bool isRunning = p.IsActive && now >= p.ValidFrom && now <= p.ValidTo;
                bool isUpcoming = p.IsActive && now < p.ValidFrom;
                bool isExpired = !p.IsActive || now > p.ValidTo;

                <div class="col-md-6 col-xl-4">
                    <div class="beauty-card overflow-hidden h-100 d-flex flex-column justify-content-between transition hover-lift">
                        <div>
                            <!-- Header with Badge -->
                            <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
                                <span class="font-mono fw-bold text-dark fs-6">@p.PromotionCode</span>
                                @if (isRunning)
                                {
                                    <span class="badge bg-success text-white px-2.5 py-1 rounded-pill shadow-xs" style="font-size: 11px;">
                                        <span class="d-inline-block rounded-circle bg-white me-1" style="width: 6px; height: 6px;"></span>Đang chạy
                                    </span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-primary text-white px-2.5 py-1 rounded-pill" style="font-size: 11px;">
                                        <i class="fa-solid fa-clock me-1"></i>Sắp tới
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-2.5 py-1 rounded-pill" style="font-size: 11px;">
                                        <i class="fa-solid fa-ban me-1"></i>Đã hết / Tắt
                                    </span>
                                }
                            </div>

                            <div class="p-3 space-y-2">
                                <div class="fw-bold text-dark fs-6">@p.Name</div>
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <div class="text-muted small">@p.Description</div>
                                }

                                <div class="p-2.5 rounded-3 bg-pastel-rose/50 border border-soft d-flex align-items-center justify-content-between">
                                    <span class="small text-secondary">Mức ưu đãi:</span>
                                    <strong class="text-magenta-accent font-mono fs-6">
                                        @if (p.PromotionType == "PERCENTAGE" || p.PromotionType == "FLASH_SALE")
                                        {
                                            <span>Giảm @p.DiscountValue.ToString("0.##")%</span>
                                            @if (p.MaxDiscountAmount.HasValue)
                                            {
                                                <small class="text-muted fw-normal d-block text-end">(Tối đa: @p.MaxDiscountAmount.Value.ToString("N0")đ)</small>
                                            }
                                        }
                                        else if (p.PromotionType == "FIXED_AMOUNT")
                                        {
                                            <span>-@p.DiscountValue.ToString("N0") ₫</span>
                                        }
                                        else
                                        {
                                            <span>Tặng quà GWP</span>
                                        }
                                    </strong>
                                </div>

                                <div class="small text-muted space-y-1 pt-1">
                                    <div class="d-flex justify-content-between">
                                        <span>Đơn tối thiểu:</span>
                                        <span class="fw-semibold text-dark font-mono">@(p.MinOrderValue.HasValue ? $"{p.MinOrderValue.Value:N0} ₫" : "0 ₫")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Thời gian:</span>
                                        <span class="font-mono text-dark">@p.ValidFrom.ToString("dd/MM") - @p.ValidTo.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Lượt sử dụng:</span>
                                        <span class="font-mono text-dark">@p.UsageCount / @(p.UsageLimit.HasValue ? p.UsageLimit.Value.ToString() : "∞")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer with Toggle & Delete -->
                        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                            <form asp-action="TogglePromotion" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-secondary" : "btn-success") py-1">
                                    <i class="fa-solid @(p.IsActive ? "fa-pause" : "fa-play") me-1"></i>@(p.IsActive ? "Tạm ngưng" : "Kích hoạt")
                                </button>
                            </form>

                            <form asp-action="DeletePromotion" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa CTKM này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm text-danger border-0 p-1">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

<!-- TAB 2: COUPONS -->
@if (currentTab == "coupons")
{
    <div class="beauty-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary small text-uppercase">
                        <th class="ps-4">Mã Coupon</th>
                        <th>Mô Tả</th>
                        <th>Mức Giảm</th>
                        <th>Đơn Tối Thiểu</th>
                        <th>Hiệu Lực</th>
                        <th class="text-center">Lượt Dùng</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!coupons.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Chưa có mã coupon nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in coupons)
                        {
                            bool isRunning = c.IsActive && now >= c.ValidFrom && now <= c.ValidTo;

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="font-mono fw-bold px-2.5 py-1 rounded bg-purple-subtle text-purple border border-purple-subtle">
                                            @c.CouponCode
                                        </span>
                                        <button type="button" class="btn btn-sm text-muted p-0" onclick="navigator.clipboard.writeText('@c.CouponCode'); alert('Đã sao chép mã @c.CouponCode');" title="Sao chép">
                                            <i class="fa-regular fa-copy"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-dark small">@(c.Description ?? "Không có mô tả")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-magenta-accent font-mono">
                                        @(c.DiscountType == "PERCENTAGE" ? $"{c.DiscountValue:0.##}%" : $"-{c.DiscountValue:N0} ₫")
                                    </div>
                                    @if (c.MaxDiscountAmount.HasValue)
                                    {
                                        <div class="text-[11px] text-muted">Tối đa: @c.MaxDiscountAmount.Value.ToString("N0")đ</div>
                                    }
                                </td>
                                <td>
                                    <span class="font-mono text-dark small">@(c.MinOrderValue.HasValue ? $"{c.MinOrderValue.Value:N0} ₫" : "0 ₫")</span>
                                </td>
                                <td>
                                    <div class="font-mono text-dark small">@c.ValidFrom.ToString("dd/MM") - @c.ValidTo.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-center font-mono">
                                    @c.UsageCount / @(c.UsageLimit.HasValue ? c.UsageLimit.Value.ToString() : "∞")
                                </td>
                                <td class="text-center">
                                    @if (isRunning)
                                    {
                                        <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill">Kích hoạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">Tạm ngưng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="ToggleCoupon" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-1 me-1">
                                            @(c.IsActive ? "Khóa" : "Mở")
                                        </button>
                                    </form>
                                    <form asp-action="DeleteCoupon" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa mã coupon này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm text-danger border-0 p-1">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- TAB 3: VIP VOUCHERS -->
@if (currentTab == "vouchers")
{
    <div class="beauty-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary small text-uppercase">
                        <th class="ps-4">Mã Voucher</th>
                        <th>Khách Hàng Nhận</th>
                        <th>Mức Ưu Đãi</th>
                        <th>Đơn Tối Thiểu</th>
                        <th>Thời Hạn</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!vouchers.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-gift fs-1 text-pink-border mb-2" style="color: var(--accent-pink-border);"></i>
                                <div>Chưa có voucher VIP nào được phát hành. Nhấn "Phát Hành Voucher VIP" để tặng voucher.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var v in vouchers)
                        {
                            bool isExpired = now > v.ValidTo;

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold font-mono text-purple">
                                        @v.VoucherCode
                                    </div>
                                    <div class="text-[11px] text-muted">@v.Description</div>
                                </td>
                                <td>
                                    @if (v.User != null)
                                    {
                                        <div class="fw-bold text-dark small">@v.User.FullName</div>
                                        <div class="text-[11px] text-muted font-mono">@(v.User.PhoneNumber ?? v.User.Username)</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Toàn bộ khách hàng</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-warning font-mono">
                                        @(v.DiscountType == "PERCENTAGE" ? $"{v.DiscountValue:0.##}%" : $"-{v.DiscountValue:N0} ₫")
                                    </div>
                                    @if (v.MaxDiscountAmount.HasValue)
                                    {
                                        <div class="text-[11px] text-muted">Tối đa: @v.MaxDiscountAmount.Value.ToString("N0")đ</div>
                                    }
                                </td>
                                <td>
                                    <span class="font-mono text-dark small">@v.MinOrderValue.ToString("N0") ₫</span>
                                </td>
                                <td>
                                    <div class="font-mono text-dark small">@v.ValidFrom.ToString("dd/MM") - @v.ValidTo.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-center">
                                    @if (v.IsUsed)
                                    {
                                        <span class="badge bg-success px-2.5 py-1 rounded-pill">Đã dùng @(v.UsedAt.HasValue ? $"({v.UsedAt.Value:dd/MM})" : "")</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-secondary px-2.5 py-1 rounded-pill">Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill">Khả dụng</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="DeleteVoucher" method="post" class="d-inline" onsubmit="return confirm('Thu hồi voucher này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button type="submit" class="btn btn-sm text-danger border-0 p-1" title="Thu hồi">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal 1: Create Promotion -->
<div class="modal fade" id="createPromotionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-bullhorn text-rose-500 me-2"></i>Tạo Chương Trình Khuyến Mãi Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreatePromotion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 space-y-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã CTKM (*):</label>
                            <input type="text" name="PromotionCode" placeholder="VD: FLASHSALE30, SUMMERBEAUTY" required class="form-control rounded-3 font-mono text-uppercase" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tên chương trình (*):</label>
                            <input type="text" name="Name" placeholder="VD: Flash Sale Cuối Tuần 30%" required class="form-control rounded-3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Loại khuyến mãi:</label>
                            <select name="PromotionType" class="form-select rounded-3">
                                <option value="PERCENTAGE">Chiết khấu %</option>
                                <option value="FIXED_AMOUNT">Giảm tiền trực tiếp</option>
                                <option value="FLASH_SALE">Flash Sale chớp nhoáng</option>
                                <option value="BUY_X_GET_Y">Mua X tặng Y (Add-on Deal)</option>
                                <option value="TIERED_GWP">Bậc thang quà tặng (GWP)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mức giảm (% hoặc VNĐ) (*):</label>
                            <input type="number" step="0.01" name="DiscountValue" value="15" required class="form-control rounded-3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đơn tối thiểu (VNĐ):</label>
                            <input type="number" step="10000" name="MinOrderValue" placeholder="0" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Giảm tối đa (VNĐ):</label>
                            <input type="number" step="10000" name="MaxDiscountAmount" placeholder="Không giới hạn" class="form-control rounded-3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ngày bắt đầu (*):</label>
                            <input type="date" name="ValidFrom" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Ngày kết thúc (*):</label>
                            <input type="date" name="ValidTo" value="@DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd")" required class="form-control rounded-3" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold">Mô tả chi tiết:</label>
                            <textarea name="Description" rows="2" class="form-control rounded-3" placeholder="Nhập tóm tắt ưu đãi hiển thị trên banner hoặc giỏ hàng..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Lưu Chương Trình</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Create Coupon -->
<div class="modal fade" id="createCouponModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-ticket text-purple me-2"></i>Tạo Mã Coupon Giảm Giá</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCoupon" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 space-y-3">
                    <div>
                        <label class="form-label small fw-semibold">Mã Coupon (*):</label>
                        <input type="text" name="CouponCode" placeholder="VD: BEAUTY50K, CHAOBANMOI" required class="form-control rounded-3 font-mono text-uppercase" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Mô tả:</label>
                        <input type="text" name="Description" placeholder="VD: Giảm 50K cho đơn từ 300K" class="form-control rounded-3" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Loại giảm:</label>
                            <select name="DiscountType" class="form-select rounded-3">
                                <option value="FIXED_AMOUNT">Giảm tiền mặt (VNĐ)</option>
                                <option value="PERCENTAGE">Giảm theo %</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Mức giảm (*):</label>
                            <input type="number" step="0.01" name="DiscountValue" value="50000" required class="form-control rounded-3" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Đơn tối thiểu (VNĐ):</label>
                            <input type="number" step="10000" name="MinOrderValue" value="300000" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giảm tối đa (VNĐ):</label>
                            <input type="number" step="10000" name="MaxDiscountAmount" placeholder="Không giới hạn" class="form-control rounded-3" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Ngày bắt đầu:</label>
                            <input type="date" name="ValidFrom" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Ngày kết thúc:</label>
                            <input type="date" name="ValidTo" value="@DateTime.UtcNow.AddMonths(2).ToString("yyyy-MM-dd")" required class="form-control rounded-3" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Giới hạn số lượt dùng toàn hệ thống:</label>
                        <input type="number" name="UsageLimit" placeholder="Để trống nếu không giới hạn" class="form-control rounded-3" />
                    </div>
                </div>
                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Lưu Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Issue VIP Voucher -->
<div class="modal fade" id="issueVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-crown text-warning me-2"></i>Phát Hành Voucher Cho Khách Hàng VIP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="IssueVoucher" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 space-y-3">
                    <div>
                        <label class="form-label small fw-semibold">Nhóm đối tượng nhận voucher (*):</label>
                        <select name="TargetGroup" id="voucherTargetGroup" class="form-select rounded-3" onchange="onVoucherTargetGroupChanged()">
                            <option value="VIP_DIAMOND">1. Toàn bộ Thành viên VIP Diamond (@vipWallets.Count(w => w.CurrentTier.TierName == "Diamond") khách)</option>
                            <option value="VIP_GOLD_DIAMOND">2. Thành viên Gold & Diamond (@vipWallets.Count khách)</option>
                            <option value="ALL_CUSTOMERS">3. Toàn bộ khách hàng đã đăng ký (@customers.Count khách)</option>
                            <option value="SPECIFIC_USER">4. Chỉ định 1 khách hàng cụ thể</option>
                        </select>
                    </div>

                    <div id="specificUserSelectCol" class="d-none">
                        <label class="form-label small fw-semibold">Chọn khách hàng nhận:</label>
                        <select name="SpecificUserId" class="form-select rounded-3">
                            <option value="">-- Chọn khách hàng --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id">@c.FullName (@(c.PhoneNumber ?? c.Username))</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Tiền tố mã (Prefix):</label>
                            <input type="text" name="VoucherCodePrefix" value="VIP" class="form-control rounded-3 font-mono text-uppercase" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Thời hạn (số ngày):</label>
                            <input type="number" name="ValidDays" value="30" min="1" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div>
                        <label class="form-label small fw-semibold">Mô tả voucher (*):</label>
                        <input type="text" name="Description" value="Đặc quyền tri ân Thành Viên VIP Canmake Beauty" class="form-control rounded-3" required />
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Loại giảm:</label>
                            <select name="DiscountType" class="form-select rounded-3">
                                <option value="FIXED_AMOUNT">Giảm tiền mặt (VNĐ)</option>
                                <option value="PERCENTAGE">Giảm theo %</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giá trị giảm (*):</label>
                            <input type="number" step="0.01" name="DiscountValue" value="100000" class="form-control rounded-3" required />
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Đơn tối thiểu:</label>
                            <input type="number" step="10000" name="MinOrderValue" value="500000" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Giảm tối đa (nếu %):</label>
                            <input type="number" step="10000" name="MaxDiscountAmount" placeholder="Không giới hạn" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning px-4 text-dark fw-bold">Phát Hành Voucher</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(modalId) {
            const modalEl = document.getElementById(modalId);
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        }

        function onVoucherTargetGroupChanged() {
            const group = document.getElementById('voucherTargetGroup').value;
            const specificCol = document.getElementById('specificUserSelectCol');
            if (group === 'SPECIFIC_USER') {
                specificCol.classList.remove('d-none');
            } else {
                specificCol.classList.add('d-none');
            }
        }
    </script>
}
