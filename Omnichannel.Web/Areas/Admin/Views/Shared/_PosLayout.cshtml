<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-900 select-none">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POS Thu Ngân Bán Lẻ - Omnichannel Beauty</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .font-mono-num {
            font-family: 'JetBrains Mono', monospace;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full flex flex-col text-slate-100 overflow-hidden">
    <header class="h-14 bg-slate-950 border-b border-slate-800 flex items-center justify-between px-4 flex-shrink-0">
        <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-lg bg-emerald-500 flex items-center justify-center text-slate-950 font-black">
                <i class="fa-solid fa-cash-register text-sm"></i>
            </div>
            <div>
                <span class="font-bold text-white tracking-wide text-sm">QUẦY BÁN LẺ POS</span>
                <span class="ml-2 text-xs text-emerald-400 bg-emerald-950/70 border border-emerald-800/60 px-2 py-0.5 rounded-full font-medium">Ca Bán: Số 01</span>
            </div>
        </div>

        <div class="flex items-center gap-6 text-xs">
            <div class="flex items-center gap-2 text-slate-400">
                <i class="fa-solid fa-store text-emerald-400"></i>
                <span class="font-semibold text-slate-200">Flagship Quận 1 HCM</span>
            </div>
            <div class="flex items-center gap-2 text-slate-400">
                <i class="fa-regular fa-user text-indigo-400"></i>
                <span class="font-semibold text-slate-200">Thu ngân: @User.Identity?.Name</span>
            </div>
            <div id="posClock" class="font-mono-num font-bold text-amber-400 bg-slate-900 px-3 py-1 rounded-lg border border-slate-800">
                00:00:00
            </div>
            <a href="/Admin/Dashboard" class="text-slate-400 hover:text-white text-xs px-2.5 py-1 rounded-lg hover:bg-slate-800 transition">
                <i class="fa-solid fa-xmark mr-1"></i> Thoát POS
            </a>
        </div>
    </header>

    <main class="flex-1 overflow-hidden p-3 bg-slate-900">
        @RenderBody()
    </main>

    <footer class="h-12 bg-slate-950 border-t border-slate-800 flex items-center justify-between px-4 text-xs flex-shrink-0">
        <div class="flex items-center gap-3 overflow-x-auto">
            <span class="text-slate-500 font-semibold uppercase tracking-wider text-[10px]">Phím Tắt:</span>

            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
                <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-amber-400 font-mono-num font-bold text-[11px]">F1</kbd>
                <span>Tìm Hàng / Barcode</span>
            </div>

            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
                <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-amber-400 font-mono-num font-bold text-[11px]">F2</kbd>
                <span>Khách Hàng</span>
            </div>

            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
                <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-amber-400 font-mono-num font-bold text-[11px]">F4</kbd>
                <span>Mã Giảm Giá</span>
            </div>

            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
                <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-emerald-400 font-mono-num font-bold text-[11px]">F9</kbd>
                <span>Quét VietQR Pro</span>
            </div>

            <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-950/80 border border-emerald-700 text-emerald-300 font-semibold">
                <kbd class="px-1.5 py-0.5 rounded bg-emerald-800 text-white font-mono-num font-bold text-[11px]">F10</kbd>
                <span>THANH TOÁN HÓA ĐƠN</span>
            </div>
        </div>

        <div class="text-slate-500 font-medium">
            <span class="text-emerald-500">●</span> Máy in hóa đơn: Sẵn sàng
        </div>
    </footer>

    <script>
        // Realtime Clock
        setInterval(() => {
            const now = new Date();
            document.getElementById('posClock').innerText = now.toLocaleTimeString('vi-VN');
        }, 1000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>