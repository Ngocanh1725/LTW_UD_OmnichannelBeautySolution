<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Omnichannel Beauty Suite</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
    <!-- HTMX, Alpine.js, SignalR & SweetAlert2 -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full antialiased text-slate-800">
    <div class="min-h-full flex">
        <!-- Sidebar Navigation -->
        <aside class="w-64 flex-shrink-0 bg-slate-900 text-slate-300 flex flex-col justify-between hidden md:flex">
            <div>
                <!-- Brand Logo -->
                <div class="h-16 flex items-center px-6 border-b border-slate-800 gap-3">
                    <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-pink-500 to-rose-400 flex items-center justify-center text-white font-bold shadow-lg shadow-pink-500/30">
                        OB
                    </div>
                    <div>
                        <div class="font-bold text-white text-base tracking-wide">OMNICHANNEL</div>
                        <div class="text-[10px] text-pink-400 font-semibold tracking-wider">BEAUTY SYSTEM</div>
                    </div>
                </div>

                <div class="px-4 py-6 space-y-1">
                    <div class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Điều Hành Bán Lẻ</div>

                    <!-- Dashboard -->
                    <a href="/Admin/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-chart-pie w-5 text-slate-400"></i>
                        <span>Tổng Quan</span>
                    </a>

                    <!-- POS Sale -->
                    <a href="/Admin/Pos" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-cash-register w-5 text-emerald-400"></i>
                        <span>Quầy Thu Ngân (POS)</span>
                    </a>

                    <!-- Warehouse & FEFO -->
                    <a href="/Admin/Warehouse" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-boxes-stacked w-5 text-amber-400"></i>
                        <span>Kho & Hạn Lô FEFO</span>
                    </a>

                    <!-- Catalog & Products -->
                    <a href="/Admin/Product" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-spray-can-sparkles w-5 text-pink-400"></i>
                        <span>Sản Phẩm Mỹ Phẩm</span>
                    </a>

                    <div class="pt-4 px-3 text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Hệ Thống & Bảo Mật</div>

                    <!-- CMS & Menu -->
                    <a href="/Admin/Menu" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-bars-staggered w-5 text-slate-400"></i>
                        <span>Cây Menu Điều Hướng</span>
                    </a>

                    <a href="/Admin/Banner" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white">
                        <i class="fa-solid fa-image w-5 text-slate-400"></i>
                        <span>Banner Quảng Cáo</span>
                    </a>

                    <!-- Dynamic PBAC Matrix -->
                    <a href="/Admin/PermissionManagement" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 shadow-md shadow-indigo-600/30">
                        <i class="fa-solid fa-shield-halved w-5"></i>
                        <span>Ma Trận Phân Quyền</span>
                    </a>
                </div>
            </div>

            <!-- Store & User Footer -->
            <div class="p-4 border-t border-slate-800">
                <div class="flex items-center gap-3">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop" class="h-9 w-9 rounded-full object-cover border border-slate-700" alt="Avatar" />
                    <div class="truncate">
                        <div class="text-xs font-bold text-white truncate">@User.Identity?.Name (Quản Trị)</div>
                        <div class="text-[11px] text-emerald-400 flex items-center gap-1">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Flagship Q1 HCM
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            <!-- Header Bar -->
            <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10 sticky top-0">
                <!-- Breadcrumbs & Quick Search -->
                <div class="flex items-center gap-4 flex-1">
                    <div class="relative w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                        <input type="text" placeholder="Tìm kiếm nhanh toàn hệ thống (Ctrl + K)..." class="w-full pl-9 pr-4 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:bg-white focus:border-indigo-500" />
                    </div>
                </div>

                <!-- Notifications & Profile Action -->
                <div class="flex items-center gap-4">
                    <button class="relative p-2 text-slate-500 hover:text-slate-800 rounded-xl hover:bg-slate-100 transition">
                        <i class="fa-regular fa-bell text-base"></i>
                        <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-rose-500"></span>
                    </button>
                    <a href="/Account/Logout" class="text-xs font-semibold text-rose-600 hover:text-rose-700 px-3 py-1.5 rounded-xl hover:bg-rose-50 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                    </a>
                </div>
            </header>

            <!-- Main Dynamic Body -->
            <main class="flex-1 p-6 md:p-8 overflow-y-auto">
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>