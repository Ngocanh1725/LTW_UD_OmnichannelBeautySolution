<!-- Reusable Media Picker Modal -->
<div id="mediaPickerModal" class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-4xl w-full h-[85vh] shadow-2xl flex flex-col overflow-hidden border border-gray-100 dark:border-gray-700" onclick="event.stopPropagation()">
        <!-- Modal Header -->
        <div class="p-4 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between bg-gray-50/50 dark:bg-gray-800/50">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-photo-film text-rose-500 text-lg"></i>
                <h3 class="text-base font-bold text-gray-900 dark:text-white">Thư Viện Ảnh CSDL</h3>
            </div>
            <button type="button" onclick="closeMediaPickerModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Tabs Navigation -->
        <div class="flex border-b border-gray-200 dark:border-gray-700 px-4 bg-white dark:bg-gray-800">
            <button type="button" id="tabLibraryBtn" onclick="switchMediaTab('library')" class="px-4 py-2.5 text-xs font-semibold border-b-2 border-rose-600 text-rose-600 transition flex items-center gap-1.5">
                <i class="fa-solid fa-images"></i>
                Thư Viện CSDL Có Sẵn
            </button>
            <button type="button" id="tabUploadBtn" onclick="switchMediaTab('upload')" class="px-4 py-2.5 text-xs font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 transition flex items-center gap-1.5">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                Tải Ảnh Mới Lên
            </button>
        </div>

        <!-- Tab 1: Library Content -->
        <div id="mediaTabLibrary" class="flex-1 flex flex-col p-4 overflow-hidden">
            <!-- Filter Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-2">
                    <select id="pickerCategorySelect" onchange="loadMediaPickerItems(1)" class="text-xs border rounded-lg px-2.5 py-1.5 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-200 border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-1 focus:ring-rose-500">
                        <option value="ALL">Tất cả danh mục</option>
                        <option value="PRODUCT">Sản phẩm</option>
                        <option value="BANNER">Banners</option>
                        <option value="BRAND">Thương hiệu</option>
                        <option value="BLOG">Bài viết</option>
                        <option value="THEME">Giao diện</option>
                    </select>
                </div>
                <div class="relative">
                    <input type="text" id="pickerSearchInput" placeholder="Tìm tên file ảnh..." onkeydown="if(event.key==='Enter'){loadMediaPickerItems(1);}"
                           class="pl-8 pr-3 py-1.5 text-xs rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-rose-500" />
                    <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-gray-400 text-xs"></i>
                </div>
            </div>

            <!-- Image Grid Container -->
            <div class="flex-1 overflow-y-auto pr-1">
                <div id="pickerGridContainer" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
                    <!-- Dynamic Items render here -->
                </div>
                <div id="pickerLoading" class="hidden text-center py-10 text-gray-400">
                    <i class="fa-solid fa-circle-notch fa-spin text-2xl text-rose-500 mb-2"></i>
                    <p class="text-xs">Đang tải danh sách ảnh từ CSDL...</p>
                </div>
                <div id="pickerEmpty" class="hidden text-center py-10 text-gray-400">
                    <i class="fa-regular fa-image text-3xl mb-2 text-gray-300 dark:text-gray-600"></i>
                    <p class="text-xs">Không tìm thấy ảnh nào trong CSDL.</p>
                </div>
            </div>

            <!-- Pagination Bar -->
            <div id="pickerPaginationBar" class="flex items-center justify-between border-t border-gray-100 dark:border-gray-700 pt-3 mt-2 text-xs text-gray-500">
                <span id="pickerPaginationInfo">Trang 1 / 1</span>
                <div class="flex gap-1" id="pickerPaginationBtns"></div>
            </div>
        </div>

        <!-- Tab 2: Upload Content -->
        <div id="mediaTabUpload" class="hidden flex-1 p-6 overflow-y-auto">
            <div class="max-w-lg mx-auto text-center border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-2xl p-8 bg-gray-50/50 dark:bg-gray-800/50">
                <div class="w-14 h-14 mx-auto mb-3 text-rose-500 bg-rose-50 dark:bg-rose-950/40 rounded-full flex items-center justify-center">
                    <i class="fa-solid fa-cloud-arrow-up text-2xl"></i>
                </div>
                <h4 class="text-sm font-bold text-gray-800 dark:text-gray-200 mb-1">Chọn ảnh từ máy tính để lưu vào CSDL</h4>
                <p class="text-xs text-gray-400 mb-4">Hệ thống sẽ nạp trực tiếp vào bảng MediaAssets dạng varbinary(max).</p>
                
                <input type="file" id="modalUploadInput" accept="image/*" class="hidden" onchange="previewUploadFile(this.files)" />
                <button type="button" onclick="document.getElementById('modalUploadInput').click()" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl transition shadow">
                    Duyệt File Trên Máy Tính
                </button>

                <div id="modalUploadPreviewContainer" class="hidden mt-4 text-left p-3 bg-white dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 flex items-center gap-3">
                    <img id="modalUploadPreviewImg" src="" class="w-14 h-14 object-cover rounded-lg border" />
                    <div class="flex-1 overflow-hidden">
                        <div id="modalUploadFileName" class="text-xs font-bold text-gray-800 dark:text-gray-200 truncate"></div>
                        <div id="modalUploadFileSize" class="text-[10px] text-gray-400"></div>
                    </div>
                    <button type="button" onclick="submitModalUpload()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition">
                        Lưu Ngay
                    </button>
                </div>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="p-3 bg-gray-50 dark:bg-gray-800/80 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between">
            <div class="text-xs text-gray-500 truncate max-w-sm">
                <span id="pickerSelectedInfo" class="italic text-gray-400">Chưa chọn ảnh nào</span>
            </div>
            <div class="flex gap-2">
                <button type="button" onclick="closeMediaPickerModal()" class="px-3 py-1.5 text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-200 dark:bg-gray-700 rounded-lg hover:bg-gray-300">
                    Hủy Bỏ
                </button>
                <button type="button" id="btnConfirmPicker" onclick="confirmMediaPickerSelection()" disabled class="px-4 py-1.5 text-xs font-medium text-white bg-rose-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg hover:bg-rose-700 transition shadow">
                    Xác Nhận Chọn
                </button>
            </div>
        </div>
    </div>
</div>
