@model Omnichannel.Application.DTOs.Cms.MenuManagementViewModel
@{
    ViewData["Title"] = "Quản Trị Cây Menu Đa Hình & Điều Hướng SEO";
    Layout = "_AdminLayout";
}

<style>
    .cursor-grab { cursor: grab; }
    .cursor-grab:active { cursor: grabbing; }
    .tree-branch-line {
        position: relative;
    }
    .tree-branch-line::before {
        content: "";
        position: absolute;
        top: -10px;
        bottom: 12px;
        left: -18px;
        width: 2px;
        background-color: #e2e8f0;
    }
    .tree-branch-line::after {
        content: "";
        position: absolute;
        top: 20px;
        left: -18px;
        width: 14px;
        height: 2px;
        background-color: #e2e8f0;
    }
    .storefront-nav-item:hover .storefront-dropdown {
        display: block !important;
    }
</style>

<div class="mb-8" style="zoom: 0.85;">
    <!-- =========================================================================
         1. TIÊU ĐỀ PHÂN HỆ & NÚT TÁC VỤ
         ========================================================================= -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-6 border-b border-slate-200/80 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-3 mb-1.5 flex-wrap">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-sitemap text-rose-500"></i>
                    <span>Quản Trị Cây Menu Đa Hình & Điều Hướng SEO</span>
                </h1>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 shadow-sm">
                    <i class="fa-solid fa-network-wired"></i> Phân Cấp Đa Tầng
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-sm">
                    <i class="fa-solid fa-magnifying-glass"></i> SEO Canonical Ready
                </span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-sm">
                Cấu hình phân giải liên kết đa hình (Category, Product, Post, StaticPage), kéo thả sắp xếp phân cấp và tối ưu hóa URL tĩnh thân thiện chuẩn SEO.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <form asp-action="EvictCache" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="menuCode" value="@Model.SelectedMenuCode" />
                <input type="hidden" name="menuId" value="@Model.SelectedMenuId" />
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 shadow-sm transition active:scale-95">
                    <i class="fa-solid fa-rotate text-rose-500"></i> Đồng Bộ & Xóa Cache
                </button>
            </form>
            <button class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-500 hover:from-rose-700 hover:to-pink-600 shadow-md shadow-rose-500/25 transition active:scale-95" data-bs-toggle="modal" data-bs-target="#createMenuModal" onclick="prepareCreateRoot()">
                <i class="fa-solid fa-plus"></i> Thêm Nút Cấp 1
            </button>
        </div>
    </div>

    <!-- =========================================================================
         2. XEM TRƯỚC GIAO DIỆN THANH ĐIỀU HƯỚNG STOREFRONT (LIVE MEGA MENU PREVIEW)
         ========================================================================= -->
    <div class="mt-6 mb-6 bg-slate-900 text-white rounded-2xl p-5 border border-slate-800 shadow-lg relative overflow-hidden">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-3 border-b border-slate-800 gap-2">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-rose-400">Xem Trước Giao Diện Thanh Điều Hướng Storefront (Live Mega Menu Preview)</span>
                <span class="text-[11px] text-slate-400">| Độ phân giải Desktop 1920x1080</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400">
                <span>Vị trí: <strong class="text-slate-200 font-mono">HEADER_MAIN (Top Navigation)</strong></span>
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold text-[11px]">Đang phát hành</span>
            </div>
        </div>

        <!-- Thanh Storefront Navbar Demo -->
        <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl px-6 py-3 flex items-center justify-between shadow-inner">
            <!-- Brand Logo -->
            <div class="flex items-center gap-3">
                <img src="@Brand.IconUrl" alt="@Brand.Name" class="w-8 h-8 rounded-lg object-contain shadow-md shadow-rose-500/30" />
                <div>
                    <div class="font-bold text-white text-sm tracking-widest font-serif">@Brand.Name</div>
                    <div class="text-[9px] text-pink-400 font-semibold tracking-wider">PREMIUM STOREFRONT</div>
                </div>
            </div>

            <!-- Menu Links Demo -->
            <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-300">
                <a href="/" class="text-rose-400 font-bold border-b-2 border-rose-500 pb-0.5 flex items-center gap-1.5">
                    <i class="fa-solid fa-house text-xs"></i> Trang Chủ
                </a>
                
                <!-- Mega Dropdown Item: Chăm Sóc Da -->
                <div class="relative storefront-nav-item group cursor-pointer py-1">
                    <span class="text-white hover:text-rose-300 transition flex items-center gap-1.5 font-bold">
                        <i class="fa-solid fa-spa text-xs text-rose-400"></i> Chăm Sóc Da <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                    </span>
                    <!-- Dropdown Box (Luôn hiển thị demo để chụp ảnh rõ ràng) -->
                    <div class="absolute left-0 top-full mt-2 w-64 bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl p-3 z-30">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-2">Danh mục con (Child Nodes):</div>
                        <div class="space-y-1">
                            <a href="/category/sua-rua-mat" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs text-slate-200 hover:bg-slate-800 transition">
                                <span class="flex items-center gap-2"><i class="fa-solid fa-droplet text-pink-400 text-[11px]"></i> Sữa Rửa Mặt</span>
                                <span class="text-[10px] text-slate-500 font-mono">/sua-rua-mat</span>
                            </a>
                            <a href="/category/serum-tinh-chat" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs text-slate-200 hover:bg-slate-800 transition bg-slate-800/60 font-semibold">
                                <span class="flex items-center gap-2"><i class="fa-solid fa-vial-virus text-indigo-400 text-[11px]"></i> Serum Phục Hồi</span>
                                <span class="text-[10px] text-indigo-400 font-mono">/serum-tinh-chat</span>
                            </a>
                            <a href="/category/kem-chong-nang" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs text-slate-200 hover:bg-slate-800 transition">
                                <span class="flex items-center gap-2"><i class="fa-solid fa-sun text-amber-400 text-[11px]"></i> Kem Chống Nắng</span>
                                <span class="text-[10px] text-slate-500 font-mono">/kem-chong-nang</span>
                            </a>
                        </div>
                    </div>
                </div>

                <a href="/category/trang-diem" class="hover:text-rose-300 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-wand-magic-sparkles text-xs text-purple-400"></i> Trang Điểm
                </a>
                <a href="/category/nuoc-hoa" class="hover:text-rose-300 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-spray-can-sparkles text-xs text-amber-400"></i> Nước Hoa
                </a>
                <a href="/clearance-fefo" class="text-amber-300 hover:text-amber-200 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-bolt text-xs text-amber-400"></i> Deal Cận Date
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-extrabold bg-rose-600 text-white animate-pulse">-50%</span>
                </a>
            </nav>

            <!-- Storefront Right Utility Icons -->
            <div class="flex items-center gap-3">
                <div class="relative hidden sm:block">
                    <input type="text" placeholder="Tìm kiếm serum, son môi..." class="bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-1.5 w-44 text-slate-300 placeholder-slate-500 focus:outline-none" readonly />
                    <i class="fa-solid fa-magnifying-glass absolute right-2.5 top-2.5 text-xs text-slate-500"></i>
                </div>
                <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-300 text-xs">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <div class="w-8 h-8 rounded-lg bg-rose-600/30 border border-rose-500/50 flex items-center justify-center text-rose-400 text-xs relative">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-rose-600 text-white font-mono text-[9px] flex items-center justify-center font-bold">2</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         3. BỘ CHỌN KHUNG MENU & HƯỚNG DẪN KÉO THẢ SẮP XẾP
         ========================================================================= -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 mb-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-3 flex-wrap">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Đang cấu hình Khung Menu:</label>
            <select class="px-3 py-2 rounded-xl text-xs font-bold text-slate-800 dark:text-white bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-none" onchange="location.href='?menuId=' + this.value">
                @foreach (var m in Model.AvailableMenus)
                {
                    if (m.MenuId == Model.SelectedMenuId)
                    {
                        <option value="@m.MenuId" selected>@m.MenuName (@m.MenuCode)</option>
                    }
                    else
                    {
                        <option value="@m.MenuId">@m.MenuName (@m.MenuCode)</option>
                    }
                }
            </select>
            <span class="text-xs text-slate-400">• Tổng số: <strong class="text-slate-700 dark:text-slate-300 font-mono">@Model.MenuTree.Count nút chính</strong></span>
        </div>

        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                <i class="fa-solid fa-arrows-up-down-left-right text-rose-500"></i>
                <span>Kéo thả biểu tượng <i class="fa-solid fa-grip-vertical text-slate-400 mx-1"></i> để sắp xếp thứ tự phân cấp đa tầng</span>
            </span>
            <span id="reorderStatusBadge" class="hidden px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-200">
                <i class="fa-solid fa-check me-1"></i>Đã lưu thứ tự!
            </span>
        </div>
    </div>

    <!-- =========================================================================
         4. LƯỚI HAI CỘT: CÂY PHÂN CẤP (8/12) & Ô CẤU HÌNH LIÊN KẾT TĨNH SEO (4/12)
         ========================================================================= -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- CỘT TRÁI (8/12): CÂY DANH MỤC PHÂN CẤP ĐA TẦNG (PARENT - CHILD NODE TREE) -->
        <div class="lg:col-span-8">
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <i class="fa-solid fa-bars-staggered text-rose-500"></i>
                            <span>Cấu Trúc Cây Phân Cấp Nút Hiển Thị (Parent - Child Nodes)</span>
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">Sắp xếp các nút gốc và nhánh danh mục con trực quan theo tiêu chuẩn Clean Architecture</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                        SortableJS Active
                    </span>
                </div>

                <!-- Sortable Root Container -->
                <div id="sortableRootMenu" class="space-y-4">
                    @foreach (var node in Model.MenuTree)
                    {
                        var isCategoryWithChildren = node.Children != null && node.Children.Any();
                        <div class="menu-tree-node root-menu-item bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 rounded-2xl p-4 transition hover:border-rose-300 dark:hover:border-rose-500/50" data-id="@node.MenuItemId" data-parent-id="">
                            <!-- Node Cha (Parent Node Header) -->
                            <div class="flex items-center justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <!-- Drag Handle -->
                                    <span class="drag-handle cursor-grab text-slate-400 hover:text-rose-500 px-1 py-2" title="Kéo thả sắp xếp nút cha">
                                        <i class="fa-solid fa-grip-vertical text-lg"></i>
                                    </span>

                                    <!-- Node Icon -->
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-pink-600 text-white flex items-center justify-center text-sm shadow-md shadow-rose-500/25">
                                        <i class="@(node.IconClass ?? "fa-solid fa-layer-group")"></i>
                                    </div>

                                    <!-- Node Info -->
                                    <div>
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="text-sm font-extrabold text-slate-900 dark:text-white">@node.Title</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                                                Loại: @(string.IsNullOrEmpty(node.LinkType) || node.LinkType == "CUSTOM" ? GetTargetTypeName(node.TargetType) : node.LinkType)
                                            </span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                                SEO: @(string.IsNullOrEmpty(node.TargetSlug) ? (node.ResolvedUrl.StartsWith("/") ? node.ResolvedUrl.TrimStart('/') : node.ResolvedUrl) : node.TargetSlug)
                                            </span>
                                            @if (isCategoryWithChildren)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                                    <i class="fa-solid fa-diagram-project"></i> @(node.Children?.Count ?? 0) nhánh con
                                                </span>
                                            }
                                        </div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-2 flex-wrap">
                                            <span>Liên kết tĩnh: <code class="text-rose-600 dark:text-rose-400 font-mono font-bold">@node.ResolvedUrl</code></span>
                                            <span>• Thứ tự: <strong class="font-mono text-slate-700 dark:text-slate-300">@node.DisplayOrder</strong></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex items-center gap-2">
                                    <button type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-100 border border-slate-200 dark:border-slate-700 transition" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(node)))'>
                                        <i class="fa-solid fa-pen-to-square me-1 text-indigo-500"></i> Sửa
                                    </button>
                                    <button type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 border border-rose-200 dark:border-rose-800 transition" onclick="prepareCreateChild(@node.MenuItemId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(node.Title))')" data-bs-toggle="modal" data-bs-target="#createMenuModal">
                                        <i class="fa-solid fa-plus me-1"></i> Thêm con
                                    </button>
                                </div>
                            </div>

                            <!-- Nhánh Con (Child Nodes Rendering) -->
                            @if (isCategoryWithChildren)
                            {
                                <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700/60 ms-8 pl-4 space-y-2 tree-branch-line sortable-children" id="childrenContainer-@node.MenuItemId" data-parent-id="@node.MenuItemId">
                                    @foreach (var sub in node.Children ?? Enumerable.Empty<Omnichannel.Application.DTOs.Cms.MenuItemDto>())
                                    {
                                        <div class="child-menu-item bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-3 flex items-center justify-between gap-3 shadow-sm hover:border-indigo-300 transition" data-id="@sub.MenuItemId" data-parent-id="@node.MenuItemId">
                                            <div class="flex items-center gap-2.5">
                                                <span class="drag-handle-child cursor-grab text-slate-400 hover:text-indigo-500 px-1" title="Kéo thả sắp xếp nhánh con">
                                                    <i class="fa-solid fa-grip-vertical text-sm"></i>
                                                </span>
                                                <i class="fa-solid fa-turn-up fa-rotate-90 text-indigo-400 text-xs"></i>
                                                <div class="w-7 h-7 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xs font-bold">
                                                    <i class="@(sub.IconClass ?? "fa-solid fa-circle-dot")"></i>
                                                </div>
                                                <div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-xs font-bold text-slate-900 dark:text-white">@sub.Title</span>
                                                        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                                            @sub.ResolvedUrl
                                                        </span>
                                                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200">
                                                            SEO: @sub.TargetSlug
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1.5">
                                                <button type="button" class="p-1.5 text-slate-400 hover:text-indigo-600 transition" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(sub)))' title="Sửa">
                                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                </button>
                                                <form asp-action="DeleteItem" method="post" class="inline" onsubmit="return confirm('Bạn có chắc muốn xóa nút này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="menuItemId" value="@sub.MenuItemId" />
                                                    <input type="hidden" name="menuId" value="@Model.SelectedMenuId" />
                                                    <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 transition" title="Xóa">
                                                        <i class="fa-solid fa-trash-can text-xs"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI (4/12): Ô CẤU HÌNH LIÊN KẾT TĨNH THÂN THIỆN CHUẨN SEO (SEO CANONICAL SLUG BOX) -->
        <div class="lg:col-span-4 space-y-6">
            <!-- Thẻ Cấu Hình SEO & Canonical Slug -->
            <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
                <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 dark:border-slate-800">
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-magnifying-glass-chart text-emerald-500"></i>
                        <span>Cấu Hình Liên Kết Tĩnh Chuẩn SEO</span>
                    </h4>
                    <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200">
                        Score 100/100
                    </span>
                </div>

                <div class="space-y-4">
                    <!-- Nút đang chọn -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1">Nút danh mục đang cấu hình:</label>
                        <div class="px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs font-bold text-slate-900 dark:text-white">
                            <span><i class="fa-solid fa-spa text-rose-500 me-2"></i> Chăm Sóc Da (Category Root)</span>
                            <span class="text-emerald-500 font-mono text-[10px]"><i class="fa-solid fa-circle-check"></i> Valid</span>
                        </div>
                    </div>

                    <!-- Ô Cấu Hình Slug Thân Thiện SEO -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">
                            <span>Liên Kết Tĩnh Thân Thiện (SEO Friendly Slug) (*)</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-xs text-slate-400 font-mono">/category/</span>
                            <input type="text" value="cham-soc-da" class="w-full pl-24 pr-4 py-2 text-xs font-mono font-bold text-rose-600 dark:text-rose-400 bg-white dark:bg-slate-950 border border-rose-300 dark:border-rose-700 rounded-xl focus:outline-none" />
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Định dạng URL tĩnh: không dấu, viết thường, phân tách bằng dấu gạch ngang (-).</p>
                    </div>

                    <!-- Thẻ Meta Title Google SERP -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-200 mb-1">Thẻ Tiêu Đề SEO (Meta Title):</label>
                        <input type="text" value="Mỹ Phẩm Chăm Sóc Da Cao Cấp Chính Hãng | Canmake Beauty" class="w-full px-3 py-2 text-xs text-slate-800 dark:text-slate-200 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none" />
                    </div>

                    <!-- Hộp Xem Trước Google SERP Snippet Preview -->
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center justify-between">
                            <span><i class="fa-brands fa-google text-blue-500 me-1"></i> Xem Trước Hiển Thị Google Search</span>
                            <span class="text-emerald-500 text-[10px]">Mobile & Desktop</span>
                        </div>
                        <div class="text-[11px] text-emerald-700 dark:text-emerald-400 font-mono truncate">
                            https://canmakebeauty.vn/category/cham-soc-da
                        </div>
                        <div class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer mt-0.5 line-clamp-1">
                            Mỹ Phẩm Chăm Sóc Da Cao Cấp Chính Hãng | Canmake Beauty
