@model Omnichannel.Application.DTOs.Cms.MenuManagementViewModel
@{
    ViewData["Title"] = "Quản lý Cây Menu Đa hình";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Cấu trúc Menu Điều hướng Đa hình</h4>
        <p class="text-muted small mb-0">Hệ thống điều hướng tự động phân giải liên kết tới Danh mục, Sản phẩm, Bài viết hoặc Trang chính sách. Hỗ trợ kéo thả sắp xếp phân cấp.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="EvictCache" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="menuCode" value="@Model.SelectedMenuCode" />
            <input type="hidden" name="menuId" value="@Model.SelectedMenuId" />
            <button type="submit" class="btn btn-soft-purple">
                <i class="fa-solid fa-rotate me-1"></i>Đồng bộ & Xóa Cache
            </button>
        </form>
        <button class="btn btn-primary-gradient px-3" data-bs-toggle="modal" data-bs-target="#createMenuModal" onclick="prepareCreateRoot()">
            <i class="fa-solid fa-plus me-1"></i>Thêm Nút Cấp 1
        </button>
    </div>
</div>

<!-- Bộ chọn Vị trí Menu -->
<div class="beauty-card p-3 mb-4">
    <div class="row align-items-center">
        <div class="col-md-5">
            <label class="form-label small fw-semibold text-secondary">Đang cấu hình Khung Menu:</label>
            <select class="form-select rounded-3" onchange="location.href='?menuId=' + this.value">
                @foreach (var m in Model.AvailableMenus)
                {
                    if (m.MenuId == Model.SelectedMenuId)
                    {
                        <option value="@m.MenuId" selected>@m.MenuName (@m.MenuCode)</option>
                    }
                    else
                    {
                        <option value="@m.MenuId">@m.MenuName (@m.MenuCode)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-7 text-md-end mt-3 mt-md-0">
            <span class="badge" style="background: var(--accent-pink-light); color: var(--accent-pink); padding: 8px 14px; border-radius: 10px; font-size: 12.5px;">
                <i class="fa-solid fa-arrows-up-down-left-right me-1"></i>Kéo thả biểu tượng <i class="fa-solid fa-grip-vertical mx-1"></i> để sắp xếp thứ tự hiển thị
            </span>
        </div>
    </div>
</div>

<!-- Danh sách Cây Menu Đa tầng -->
<div class="beauty-card overflow-hidden p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-bold text-dark mb-0">
            <i class="fa-solid fa-bars-staggered me-2 text-purple" style="color: var(--primary-purple);"></i>Cây phân cấp nút hiển thị
        </h6>
        <span id="reorderStatusBadge" class="badge bg-light text-muted d-none" style="font-size: 11px;">
            <i class="fa-solid fa-spinner fa-spin me-1"></i>Đang lưu thứ tự...
        </span>
    </div>

    @if (!Model.MenuTree.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-folder-open fs-1 text-pink-border mb-2" style="color: var(--accent-pink-border);"></i>
            <div>Chưa có nút Menu nào trong khung này. Nhấn "Thêm Nút Cấp 1" để bắt đầu thiết lập.</div>
        </div>
    }
    else
    {
        <div id="sortableRootMenu" class="tree-container">
            @foreach (var node in Model.MenuTree)
            {
                <div class="menu-tree-node mb-3 root-menu-item" data-id="@node.MenuItemId" data-parent-id="">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border">
                        <div class="d-flex align-items-center gap-3">
                            <span class="drag-handle cursor-grab text-muted" title="Kéo thả để sắp xếp">
                                <i class="fa-solid fa-grip-vertical fs-5"></i>
                            </span>

                            <span class="badge bg-purple-subtle text-purple" style="background: var(--primary-purple-light); color: var(--primary-purple); width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                                <i class="@(node.IconClass ?? "fa-solid fa-circle-dot")"></i>
                            </span>

                            <div>
                                <div class="fw-bold text-dark">
                                    @node.Title
                                    @if (!node.IsActive)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 10px;">Ẩn</span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    <span class="badge bg-secondary-subtle text-secondary me-1">Loại: @(string.IsNullOrEmpty(node.LinkType) || node.LinkType == "CUSTOM" ? GetTargetTypeName(node.TargetType) : node.LinkType)</span>
                                    <span>Liên kết: <code>@node.ResolvedUrl</code></span>
                                    @if (!string.IsNullOrEmpty(node.CssClass))
                                    {
                                        <span class="badge bg-light text-dark border ms-1">CSS: @node.CssClass</span>
                                    }
                                    <span class="badge bg-light text-muted border ms-1">Thứ tự: @node.DisplayOrder</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <!-- Edit Button -->
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(node)))'>
                                <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                            </button>

                            <!-- Add Child Button -->
                            <button type="button" class="btn btn-sm btn-soft-pink" onclick="prepareCreateChild(@node.MenuItemId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(node.Title))')" data-bs-toggle="modal" data-bs-target="#createMenuModal">
                                <i class="fa-solid fa-plus me-1"></i>Thêm con
                            </button>

                            <!-- Delete Button -->
                            <form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Xóa nút này sẽ xóa luôn toàn bộ nhánh con?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="menuItemId" value="@node.MenuItemId" />
                                <input type="hidden" name="menuId" value="@Model.SelectedMenuId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Xóa nút">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Render Nhánh Cấp 2 -->
                    <div class="ms-5 mt-2 ps-2 border-start border-2 border-purple-subtle sortable-children" id="childrenContainer-@node.MenuItemId" data-parent-id="@node.MenuItemId">
                        @foreach (var sub in node.Children)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 mb-2 rounded-3 bg-white border child-menu-item" data-id="@sub.MenuItemId" data-parent-id="@node.MenuItemId">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="drag-handle-child cursor-grab text-muted me-1" title="Kéo thả sắp xếp">
                                        <i class="fa-solid fa-grip-vertical text-muted"></i>
                                    </span>
                                    <i class="fa-solid fa-turn-up fa-rotate-90 text-muted me-1"></i>
                                    <span class="fw-semibold text-dark small">@sub.Title</span>
                                    <span class="badge bg-light text-muted" style="font-size: 11px;">@sub.ResolvedUrl</span>
                                    @if (!sub.IsActive)
                                    {
                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 10px;">Ẩn</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-sm text-secondary border-0 p-1" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(sub)))' title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa nút này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="menuItemId" value="@sub.MenuItemId" />
                                        <input type="hidden" name="menuId" value="@Model.SelectedMenuId" />
                                        <button type="submit" class="btn btn-sm text-danger border-0 p-1" title="Xóa">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal Thêm Nút Menu Đa Hình -->
<div class="modal fade" id="createMenuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark" id="modalTitle">Thêm Nút Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewItem.MenuId" value="@Model.SelectedMenuId" />
                <input type="hidden" asp-for="NewItem.ParentId" id="modalParentId" />
                <input type="hidden" asp-for="NewItem.TargetSlug" id="modalTargetSlug" />

                <div class="modal-body p-4">
                    <div id="parentBadgeContainer" class="mb-3 d-none">
                        <span class="badge" style="background: var(--primary-purple-light); color: var(--primary-purple); font-size: 13px;">
                            <i class="fa-solid fa-turn-down me-1"></i>Thuộc nút cha: <strong id="parentTitleLabel"></strong>
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="NewItem.Title" class="form-label small fw-semibold">Tiêu đề hiển thị (*)</label>
                            <input asp-for="NewItem.Title" id="nodeTitleInput" class="form-control rounded-3" placeholder="vd: Serum Phục Hồi Da B5" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewItem.DisplayOrder" class="form-label small fw-semibold">Thứ tự</label>
                            <input asp-for="NewItem.DisplayOrder" type="number" class="form-control rounded-3" value="0" />
                        </div>

                        <!-- Selector Loại liên kết Đa hình -->
                        <div class="col-md-6">
                            <label asp-for="NewItem.TargetType" class="form-label small fw-semibold">Loại liên kết đa hình</label>
                            <select asp-for="NewItem.TargetType" id="targetTypeSelect" class="form-select rounded-3" onchange="onTargetTypeChanged()">
                                <option value="1">1. Danh mục sản phẩm (Category)</option>
                                <option value="2">2. Sản phẩm SKU (Product)</option>
                                <option value="3">3. Bài viết & Cẩm nang (Post)</option>
                                <option value="4">4. Trang tĩnh & Chính sách (StaticPage)</option>
                                <option value="5">5. Đường dẫn ngoài tùy chọn (CustomUrl)</option>
                            </select>
                        </div>

                        <div class="col-md-6" id="targetPickerCol">
                            <label class="form-label small fw-semibold">Chọn đối tượng đích:</label>
                            <select asp-for="NewItem.TargetId" id="targetEntitySelect" class="form-select rounded-3" onchange="onEntityPicked()">
                                <option value="">-- Đang tải danh sách --</option>
                            </select>
                        </div>

                        <div class="col-12 d-none" id="customUrlCol">
                            <label asp-for="NewItem.CustomUrl" class="form-label small fw-semibold">Đường dẫn ngoài URL</label>
                            <input asp-for="NewItem.CustomUrl" class="form-control rounded-3" placeholder="https://example.com/..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewItem.IconClass" class="form-label small fw-semibold">Icon Class (FontAwesome)</label>
                            <input asp-for="NewItem.IconClass" class="form-control rounded-3" placeholder="fa-solid fa-droplet" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewItem.CssClass" class="form-label small fw-semibold">CSS Class tùy biến</label>
                            <input asp-for="NewItem.CssClass" class="form-control rounded-3" placeholder="text-danger fw-bold" />
                        </div>

                        <div class="col-12 d-flex align-items-center mt-2">
                            <div class="form-check">
                                <input asp-for="NewItem.OpenInNewTab" class="form-check-input" type="checkbox" id="chkNewTab" />
                                <label class="form-check-label small" for="chkNewTab">Mở liên kết trong tab mới (_blank)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Lưu Nút Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Nút Menu Đa Hình -->
<div class="modal fade" id="editMenuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark">Chỉnh Sửa Nút Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MenuId" value="@Model.SelectedMenuId" />
                <input type="hidden" name="MenuItemId" id="editMenuItemId" />
                <input type="hidden" name="ParentId" id="editParentId" />
                <input type="hidden" name="TargetSlug" id="editTargetSlug" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Tiêu đề hiển thị (*)</label>
                            <input name="Title" id="editTitleInput" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Thứ tự</label>
                            <input name="DisplayOrder" id="editDisplayOrder" type="number" class="form-control rounded-3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Loại liên kết đa hình</label>
                            <select name="TargetType" id="editTargetTypeSelect" class="form-select rounded-3" onchange="onEditTargetTypeChanged()">
                                <option value="1">1. Danh mục sản phẩm (Category)</option>
                                <option value="2">2. Sản phẩm SKU (Product)</option>
                                <option value="3">3. Bài viết & Cẩm nang (Post)</option>
                                <option value="4">4. Trang tĩnh & Chính sách (StaticPage)</option>
                                <option value="5">5. Đường dẫn ngoài tùy chọn (CustomUrl)</option>
                            </select>
                        </div>

                        <div class="col-md-6" id="editTargetPickerCol">
                            <label class="form-label small fw-semibold">Chọn đối tượng đích:</label>
                            <select name="TargetId" id="editTargetEntitySelect" class="form-select rounded-3" onchange="onEditEntityPicked()">
                                <option value="">-- Đang tải danh sách --</option>
                            </select>
                        </div>

                        <div class="col-12 d-none" id="editCustomUrlCol">
                            <label class="form-label small fw-semibold">Đường dẫn ngoài URL</label>
                            <input name="CustomUrl" id="editCustomUrl" class="form-control rounded-3" placeholder="https://example.com/..." />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Icon Class (FontAwesome)</label>
                            <input name="IconClass" id="editIconClass" class="form-control rounded-3" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">CSS Class tùy biến</label>
                            <input name="CssClass" id="editCssClass" class="form-control rounded-3" />
                        </div>

                        <div class="col-12 d-flex align-items-center gap-4 mt-2">
                            <div class="form-check">
                                <input name="OpenInNewTab" value="true" class="form-check-input" type="checkbox" id="editChkNewTab" />
                                <label class="form-check-label small" for="editChkNewTab">Mở liên kết trong tab mới (_blank)</label>
                            </div>
                            <div class="form-check">
                                <input name="IsActive" value="true" class="form-check-input" type="checkbox" id="editChkIsActive" checked />
                                <label class="form-check-label small" for="editChkIsActive">Kích hoạt hiển thị</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-soft">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary-gradient px-4">Cập Nhật Nút Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public static string GetTargetTypeName(int type) => type switch
    {
        1 => "Danh mục",
        2 => "Sản phẩm",
        3 => "Bài viết",
        4 => "Trang tĩnh",
        5 => "URL Tùy chọn",
        _ => "Khác"
    };
}

@section Scripts {
    <!-- SortableJS CDN for Drag & Drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
        let currentTargetData = [];
        let editTargetData = [];

        function prepareCreateRoot() {
            document.getElementById('modalTitle').innerText = 'Thêm Nút Menu Cấp 1';
            document.getElementById('modalParentId').value = '';
            document.getElementById('parentBadgeContainer').classList.add('d-none');
            onTargetTypeChanged();
        }

        function prepareCreateChild(parentId, parentTitle) {
            document.getElementById('modalTitle').innerText = 'Thêm Nút Menu Con';
            document.getElementById('modalParentId').value = parentId;
            document.getElementById('parentTitleLabel').innerText = parentTitle;
            document.getElementById('parentBadgeContainer').classList.remove('d-none');
            onTargetTypeChanged();
        }

        async function onTargetTypeChanged() {
            const targetType = document.getElementById('targetTypeSelect').value;
            const targetPicker = document.getElementById('targetPickerCol');
            const customUrlCol = document.getElementById('customUrlCol');
            const entitySelect = document.getElementById('targetEntitySelect');

            if (targetType === '5') {
                targetPicker.classList.add('d-none');
                customUrlCol.classList.remove('d-none');
                document.getElementById('modalTargetSlug').value = '';
            } else {
                targetPicker.classList.remove('d-none');
                customUrlCol.classList.add('d-none');
                entitySelect.innerHTML = '<option>Đang nạp dữ liệu...</option>';

                try {
                    const res = await fetch(`/Admin/Menu/GetTargetsByType?targetType=${targetType}`);
                    currentTargetData = await res.json();

                    entitySelect.innerHTML = '<option value="">-- Chọn đối tượng liên kết --</option>';
                    currentTargetData.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.id;
                        opt.text = item.name;
                        opt.dataset.slug = item.slug;
                        entitySelect.appendChild(opt);
                    });
                } catch (e) {
                    console.error(e);
                    entitySelect.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
                }
            }
        }

        function onEntityPicked() {
            const select = document.getElementById('targetEntitySelect');
            const selectedOpt = select.options[select.selectedIndex];
            if (selectedOpt && selectedOpt.dataset.slug) {
                document.getElementById('modalTargetSlug').value = selectedOpt.dataset.slug;
                const titleInput = document.getElementById('nodeTitleInput');
                if (!titleInput.value) {
                    titleInput.value = selectedOpt.text.split('(')[0].trim();
                }
            }
        }

        // --- Edit Modal Handling ---
        async function openEditModal(node) {
            document.getElementById('editMenuItemId').value = node.MenuItemId;
            document.getElementById('editParentId').value = node.ParentId || '';
            document.getElementById('editTitleInput').value = node.Title || '';
            document.getElementById('editDisplayOrder').value = node.DisplayOrder || 0;
            document.getElementById('editIconClass').value = node.IconClass || '';
            document.getElementById('editCssClass').value = node.CssClass || '';
            document.getElementById('editCustomUrl').value = node.CustomUrl || '';
            document.getElementById('editTargetSlug').value = node.TargetSlug || '';
            document.getElementById('editChkNewTab').checked = !!node.OpenInNewTab;
            document.getElementById('editChkIsActive').checked = node.IsActive !== false;

            // Map link type to int
            let typeVal = "5";
            if (node.LinkType === "CATEGORY" || node.TargetType === 1) typeVal = "1";
            else if (node.LinkType === "PRODUCT" || node.TargetType === 2) typeVal = "2";
            else if (node.LinkType === "POST" || node.TargetType === 3) typeVal = "3";
            else if (node.LinkType === "STATIC_PAGE" || node.TargetType === 4) typeVal = "4";

            document.getElementById('editTargetTypeSelect').value = typeVal;
            await onEditTargetTypeChanged(node.TargetEntityId ? node.TargetEntityId.toString() : node.TargetId);

            const modal = new bootstrap.Modal(document.getElementById('editMenuModal'));
            modal.show();
        }

        async function onEditTargetTypeChanged(preSelectedId = null) {
            const targetType = document.getElementById('editTargetTypeSelect').value;
            const targetPicker = document.getElementById('editTargetPickerCol');
            const customUrlCol = document.getElementById('editCustomUrlCol');
            const entitySelect = document.getElementById('editTargetEntitySelect');

            if (targetType === '5') {
                targetPicker.classList.add('d-none');
                customUrlCol.classList.remove('d-none');
                document.getElementById('editTargetSlug').value = '';
            } else {
                targetPicker.classList.remove('d-none');
                customUrlCol.classList.add('d-none');
                entitySelect.innerHTML = '<option>Đang nạp dữ liệu...</option>';

                try {
                    const res = await fetch(`/Admin/Menu/GetTargetsByType?targetType=${targetType}`);
                    editTargetData = await res.json();

                    entitySelect.innerHTML = '<option value="">-- Chọn đối tượng liên kết --</option>';
                    editTargetData.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.id;
                        opt.text = item.name;
                        opt.dataset.slug = item.slug;
                        if (preSelectedId && item.id.toString() === preSelectedId.toString()) {
                            opt.selected = true;
                        }
                        entitySelect.appendChild(opt);
                    });
                } catch (e) {
                    console.error(e);
                    entitySelect.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
                }
            }
        }

        function onEditEntityPicked() {
            const select = document.getElementById('editTargetEntitySelect');
            const selectedOpt = select.options[select.selectedIndex];
            if (selectedOpt && selectedOpt.dataset.slug) {
                document.getElementById('editTargetSlug').value = selectedOpt.dataset.slug;
            }
        }

        // --- Drag & Drop Reordering via SortableJS ---
        document.addEventListener('DOMContentLoaded', function () {
            const rootContainer = document.getElementById('sortableRootMenu');
            if (rootContainer) {
                new Sortable(rootContainer, {
                    handle: '.drag-handle',
                    animation: 200,
                    ghostClass: 'bg-purple-subtle',
                    onEnd: function () {
                        saveTreeOrder();
                    }
                });
            }

            // Init Sortable on child containers
            document.querySelectorAll('.sortable-children').forEach(childContainer => {
                new Sortable(childContainer, {
                    handle: '.drag-handle-child',
                    animation: 200,
                    ghostClass: 'bg-light',
                    onEnd: function () {
                        saveTreeOrder();
                    }
                });
            });
        });

        async function saveTreeOrder() {
            const badge = document.getElementById('reorderStatusBadge');
            badge.classList.remove('d-none');

            const items = [];
            const menuId = @Model.SelectedMenuId;

            // Root nodes
            const rootNodes = document.querySelectorAll('#sortableRootMenu > .root-menu-item');
            rootNodes.forEach((nodeEl, index) => {
                const id = parseInt(nodeEl.dataset.id);
                if (id) {
                    items.push({
                        id: id,
                        parentId: null,
                        sortOrder: index + 1
                    });
                }

                // Child nodes under this root
                const childNodes = nodeEl.querySelectorAll('.child-menu-item');
                childNodes.forEach((cEl, cIndex) => {
                    const cId = parseInt(cEl.dataset.id);
                    if (cId) {
                        items.push({
                            id: cId,
                            parentId: id,
                            sortOrder: cIndex + 1
                        });
                    }
                });
            });

            try {
                const res = await fetch('/Admin/Menu/Reorder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ menuId: menuId, items: items })
                });

                const data = await res.json();
                if (data.success) {
                    badge.className = 'badge bg-success-subtle text-success';
                    badge.innerHTML = '<i class="fa-solid fa-check me-1"></i>Đã lưu thứ tự!';
                    setTimeout(() => badge.classList.add('d-none'), 2000);
                } else {
                    badge.className = 'badge bg-danger-subtle text-danger';
                    badge.innerText = 'Lỗi lưu thứ tự';
                }
            } catch (err) {
                console.error(err);
                badge.className = 'badge bg-danger-subtle text-danger';
                badge.innerText = 'Lỗi kết nối';
            }
        }
    </script>
}
