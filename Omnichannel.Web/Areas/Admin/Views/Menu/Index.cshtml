                <h4 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Nguyên Lý Phân Giải Liên Kết Đa Hình</span>
                </h4>
                <div class="space-y-2.5 text-xs text-slate-300 leading-relaxed">
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-check text-emerald-400 text-[10px] mt-1"></i>
                        <span><strong>1. Category Polymorphism:</strong> Tự động phân giải route <code>/category/{slug}</code> kèm bộ lọc hoạt chất da liễu.</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-check text-emerald-400 text-[10px] mt-1"></i>
                        <span><strong>2. Product SKU Target:</strong> Phân giải đích danh <code>/product/{slug}</code> kèm bảng kiểm soát tồn kho FEFO.</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-check text-emerald-400 text-[10px] mt-1"></i>
                        <span><strong>3. Clean Architecture:</strong> Lưu trữ phân tách tầng Domain và phân giải động thông qua <code>IMenuEngineService</code>.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Nút Menu Đa Hình -->
<div class="modal fade" id="createMenuModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-2xl border-0 shadow-2xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white">
            <div class="modal-header border-b border-slate-200 dark:border-slate-800 p-4">
                <h5 class="modal-title font-bold text-base" id="modalTitle">Thêm Nút Menu Đa Hình</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewItem.MenuId" value="@Model.SelectedMenuId" />
                <input type="hidden" asp-for="NewItem.ParentId" id="modalParentId" />
                <input type="hidden" asp-for="NewItem.TargetSlug" id="modalTargetSlug" />

                <div class="modal-body p-6 space-y-4">
                    <div id="parentBadgeContainer" class="hidden">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                            <i class="fa-solid fa-turn-down"></i> Thuộc nút cha: <strong id="parentTitleLabel"></strong>
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                        <div class="md:col-span-8">
                            <label asp-for="NewItem.Title" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Tiêu đề hiển thị (*)</label>
                            <input asp-for="NewItem.Title" id="nodeTitleInput" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none" placeholder="vd: Serum Phục Hồi B5" required />
                        </div>
                        <div class="md:col-span-4">
                            <label asp-for="NewItem.DisplayOrder" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Thứ tự hiển thị</label>
                            <input asp-for="NewItem.DisplayOrder" type="number" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none" value="0" />
                        </div>

                        <div class="md:col-span-6">
                            <label asp-for="NewItem.TargetType" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Loại liên kết đa hình</label>
                            <select asp-for="NewItem.TargetType" id="targetTypeSelect" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none" onchange="onTargetTypeChanged()">
                                <option value="1">1. Danh mục sản phẩm (Category)</option>
                                <option value="2">2. Sản phẩm SKU (Product)</option>
                                <option value="3">3. Bài viết & Cẩm nang (Post)</option>
                                <option value="4">4. Trang tĩnh & Chính sách (StaticPage)</option>
                                <option value="5">5. Đường dẫn ngoài tùy chọn (CustomUrl)</option>
                            </select>
                        </div>

                        <div class="md:col-span-6" id="targetPickerCol">
                            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Chọn đối tượng đích:</label>
                            <select asp-for="NewItem.TargetId" id="targetEntitySelect" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none" onchange="onEntityPicked()">
                                <option value="">-- Đang nạp danh sách --</option>
                            </select>
                        </div>

                        <div class="md:col-span-12 hidden" id="customUrlCol">
                            <label asp-for="NewItem.CustomUrl" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Đường dẫn ngoài URL</label>
                            <input asp-for="NewItem.CustomUrl" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none" placeholder="https://..." />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-t border-slate-200 dark:border-slate-800 p-4 flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-600 shadow-md">Lưu Nút Menu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public static string GetTargetTypeName(int type) => type switch
    {
        1 => "Danh mục",
        2 => "Sản phẩm",
        3 => "Bài viết",
        4 => "Trang tĩnh",
        5 => "URL Tùy chọn",
        _ => "Khác"
    };
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rootContainer = document.getElementById('sortableRootMenu');
            if (rootContainer) {
                new Sortable(rootContainer, {
                    handle: '.drag-handle',
                    animation: 200,
                    ghostClass: 'bg-rose-50',
                    onEnd: function () {
                        const badge = document.getElementById('reorderStatusBadge');
                        if (badge) {
                            badge.classList.remove('hidden');
                            setTimeout(() => badge.classList.add('hidden'), 2500);
                        }
                    }
                });
            }

            document.querySelectorAll('.sortable-children').forEach(childContainer => {
                new Sortable(childContainer, {
                    handle: '.drag-handle-child',
                    animation: 200,
                    ghostClass: 'bg-indigo-50',
                    onEnd: function () {
                        const badge = document.getElementById('reorderStatusBadge');
                        if (badge) {
                            badge.classList.remove('hidden');
                            setTimeout(() => badge.classList.add('hidden'), 2500);
                        }
                    }
                });
            });
        });

        function prepareCreateRoot() {
            document.getElementById('modalTitle').innerText = 'Thêm Nút Menu Cấp 1';
            document.getElementById('modalParentId').value = '';
            document.getElementById('parentBadgeContainer').classList.add('hidden');
        }

        function prepareCreateChild(parentId, parentTitle) {
            document.getElementById('modalTitle').innerText = 'Thêm Nút Menu Con';
            document.getElementById('modalParentId').value = parentId;
            document.getElementById('parentTitleLabel').innerText = parentTitle;
            document.getElementById('parentBadgeContainer').classList.remove('hidden');
        }

        function openEditModal(node) {
            alert('Mở ô cấu hình chỉnh sửa liên kết tĩnh & SEO cho nút: ' + node.Title);
        }
    </script>
}
