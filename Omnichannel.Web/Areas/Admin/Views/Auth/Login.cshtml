@model Omnichannel.Application.DTOs.Account.LoginViewModel
@{
    ViewData["Title"] = "Cổng Quản Trị Doanh Nghiệp (Admin Portal)";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.TitleSuffix</title>
    
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg-deep: #070B14;
            --card-bg: rgba(15, 23, 42, 0.82);
            --card-border: rgba(99, 102, 241, 0.22);
            --primary-accent: #6366F1;
            --primary-gradient: linear-gradient(135deg, #6366F1 0%, #A855F7 50%, #EC4899 100%);
            --glow-color: rgba(99, 102, 241, 0.28);
            --text-primary: #F8FAFC;
            --text-secondary: #94A3B8;
            --input-bg: rgba(30, 41, 59, 0.7);
            --input-border: rgba(148, 163, 184, 0.16);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-deep);
            background-image: 
                radial-gradient(at 15% 15%, rgba(99, 102, 241, 0.18) 0px, transparent 50%),
                radial-gradient(at 85% 85%, rgba(236, 72, 153, 0.14) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(168, 85, 247, 0.08) 0px, transparent 70%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 24px;
            color: var(--text-primary);
        }

        .admin-login-wrapper {
            max-width: 460px;
            width: 100%;
            position: relative;
        }

        .admin-login-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid var(--card-border);
            padding: 44px 38px;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px -10px var(--glow-color);
            position: relative;
            overflow: hidden;
        }

        .admin-login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--primary-gradient);
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(99, 102, 241, 0.12);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #A5B4FC;
            margin-bottom: 20px;
        }

        .portal-icon-container {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(168, 85, 247, 0.25));
            border: 1px solid rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px auto;
            box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
        }

        .portal-icon-container i {
            font-size: 30px;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .form-floating > .form-control {
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 14px;
            color: var(--text-primary);
            font-size: 14px;
            transition: all 0.25s ease;
        }

        .form-floating > .form-control:focus {
            background: rgba(30, 41, 59, 0.95);
            border-color: #818CF8;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
            color: #FFFFFF;
        }

        .form-floating > label {
            color: var(--text-secondary);
            font-size: 13px;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #A5B4FC;
        }

        .btn-portal-submit {
            background: var(--primary-gradient);
            border: none;
            border-radius: 14px;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 14.5px;
            letter-spacing: 0.02em;
            padding: 14px 20px;
            width: 100%;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.5);
        }

        .btn-portal-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px -5px rgba(168, 85, 247, 0.6);
            color: #FFFFFF;
        }

        .password-toggle-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            z-index: 10;
            padding: 6px;
        }

        .password-toggle-btn:hover {
            color: var(--text-primary);
        }

        .security-badge {
            background: rgba(15, 23, 42, 0.6);
            border: 1px dashed rgba(148, 163, 184, 0.2);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 11.5px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
</head>
<body>

<div class="admin-login-wrapper">
    <div class="admin-login-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="mb-3">
                <img src="@Brand.LogoStackedUrl" alt="Canmake Beauty Admin Logo" style="height: 100px; width: auto; display: block; margin: 0 auto;" />
            </div>
            <div class="brand-badge">
                <i class="fa-solid fa-server"></i> Enterprise Portal
            </div>
            <h1 class="h4 fw-bold mb-1 tracking-tight">@Brand.Name ADMIN</h1>
            <p class="text-secondary small mb-0">Hệ thống Điều hành & Quản trị Bán lẻ Đa kênh</p>
        </div>

        <!-- Alert Error Message -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-25 text-danger rounded-4 p-3 mb-4 d-flex gap-2.5 align-items-start">
                <i class="fa-solid fa-circle-exclamation mt-1"></i>
                <div class="small">
                    <div asp-validation-summary="All" class="mb-0 list-unstyled"></div>
                </div>
            </div>
        }

        <!-- Login Form -->
        <form method="post" asp-action="Login" asp-controller="Auth" asp-area="Admin" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Username" class="form-control" id="floatingUsername" placeholder="username" autocomplete="username" autofocus required />
                <label for="floatingUsername"><i class="fa-solid fa-user-tie me-1.5 opacity-75"></i> Tài khoản / Email Quản trị</label>
                <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="password" autocomplete="current-password" required />
                <label for="floatingPassword"><i class="fa-solid fa-key me-1.5 opacity-75"></i> Mật khẩu bảo mật</label>
                <button type="button" class="password-toggle-btn" id="togglePasswordBtn" title="Hiện/Ẩn mật khẩu">
                    <i class="fa-regular fa-eye" id="toggleEyeIcon"></i>
                </button>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input bg-dark border-secondary" type="checkbox" id="rememberMeCheck" />
                    <label class="form-check-label text-secondary small" for="rememberMeCheck">
                        Duy trì phiên ca trực (8h)
                    </label>
                </div>
                <span class="badge bg-indigo-950 text-indigo-300 border border-indigo-800 small py-1 px-2">
                    <i class="fa-solid fa-lock text-xs"></i> 256-bit SSL
                </span>
            </div>

            <button type="submit" class="btn btn-portal-submit mb-3 d-flex align-items-center justify-content-center gap-2" id="submitBtn">
                <span>ĐĂNG NHẬP HỆ THỐNG</span>
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>

            <!-- 1-Click Fast Fill for Admin / Staff -->
            <div class="p-2.5 rounded-3 mb-3 text-start" style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(148, 163, 184, 0.2);">
                <div class="d-flex justify-content-between align-items-center mb-1.5" style="font-size: 11px;">
                    <span class="text-secondary fw-semibold"><i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i>Điền nhanh tài khoản kiểm thử:</span>
                    <span class="text-muted" style="font-size: 10px;">Pass: Admin@123</span>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <button type="button" class="btn btn-xs btn-outline-light py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAdminCreds('admin', 'Admin@123')">Admin</button>
                    <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAdminCreds('superadmin', 'Admin@123')">SuperAdmin</button>
                    <button type="button" class="btn btn-xs btn-outline-success py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAdminCreds('manager_hq', 'Admin@123')">Quản lý HQ</button>
                    <button type="button" class="btn btn-xs btn-outline-info py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAdminCreds('cashier01', 'Admin@123')">Thu ngân</button>
                    <button type="button" class="btn btn-xs btn-outline-warning py-0.5 px-2 rounded-pill text-white" style="font-size: 11px;" onclick="fillAdminCreds('warehouse01', 'Admin@123')">Thủ kho</button>
                    <button type="button" class="btn btn-xs py-0.5 px-2 rounded-pill text-white fw-semibold" style="font-size: 11px; background: #c93b8b;" onclick="fillAdminCreds('editor01', 'Admin@123')">Biên tập viên</button>
                </div>
            </div>

            <!-- Storefront Isolation Notice -->
            <div class="text-center pt-2 mb-3">
                <a href="/account/login" class="text-decoration-none text-secondary small hover-text-white transition">
                    <i class="fa-solid fa-bag-shopping me-1"></i> Bạn là khách hàng? Đăng nhập tại Storefront
                </a>
            </div>

            <!-- Security Footer -->
            <div class="security-badge">
                <i class="fa-solid fa-fingerprint text-indigo-400 fs-5"></i>
                <div>
                    <div class="fw-semibold text-white">Multi-Scheme Isolation Active</div>
                    <div class="opacity-75">Phiên làm việc được phân lập 100% bằng Cookie bảo mật riêng biệt.</div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("togglePasswordBtn");
        const passwordInput = document.getElementById("floatingPassword");
        const eyeIcon = document.getElementById("toggleEyeIcon");

        if (toggleBtn && passwordInput && eyeIcon) {
            toggleBtn.addEventListener("click", function () {
                const isPassword = passwordInput.getAttribute("type") === "password";
                passwordInput.setAttribute("type", isPassword ? "text" : "password");
                eyeIcon.classList.toggle("fa-eye");
                eyeIcon.classList.toggle("fa-eye-slash");
            });
        }
    });

    function fillAdminCreds(u, p) {
        const uInput = document.getElementById("floatingUsername");
        const pInput = document.getElementById("floatingPassword");
        if (uInput && pInput) {
            uInput.value = u;
            pInput.value = p;
        }
    }
</script>
</body>
</html>

