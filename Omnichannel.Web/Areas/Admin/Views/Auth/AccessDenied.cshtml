@model Omnichannel.Application.DTOs.Account.AccessDeniedViewModel
@{
    ViewData["Title"] = "Từ Chối Quyền Truy Cập (403)";
    Layout = null;
    var contactName = !string.IsNullOrWhiteSpace(Model?.ContactPersonName)
        ? Model.ContactPersonName
        : "Trưởng phòng / Admin tổng (superadmin)";
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 Forbidden - @Brand.Name Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top, #1e1b4b 0%, #090d16 70%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #F8FAFC;
        }
        .denied-card {
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid rgba(244, 63, 94, 0.35);
            padding: 44px 36px;
            max-width: 560px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px -10px rgba(244, 63, 94, 0.25);
        }
        .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            color: #FB7185;
            font-size: 34px;
        }
        .contact-box {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            padding: 16px;
            text-align: left;
        }
    </style>
</head>
<body>
<div class="denied-card">
    <div class="icon-circle">
        <i class="fa-solid fa-shield-halved"></i>
    </div>
    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-3 py-1.5 rounded-pill mb-3">
        HTTP 403 • GIỚI HẠN PHẠM VI PHÂN QUYỀN
    </span>
    <h1 class="h4 fw-bold mb-2">Bạn Chưa Được Cấp Quyền Chức Năng Này</h1>
    <p class="text-light opacity-75 small mb-3">
        Bạn chưa được cấp quyền chức năng này – vui lòng liên hệ <strong class="text-warning">@contactName</strong> để được cấp hoặc mở rộng thẩm quyền.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model?.ActorRoleName) || !string.IsNullOrWhiteSpace(Model?.ActorDepartmentName))
    {
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
            @if (!string.IsNullOrWhiteSpace(Model.ActorRoleName))
            {
                <span class="badge bg-primary bg-opacity-25 text-info border border-info border-opacity-25 px-3 py-1.5 rounded-pill">
                    <i class="fa-solid fa-id-badge me-1"></i>Vai trò: @Model.ActorRoleName
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ActorDepartmentName))
            {
                <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-50 px-3 py-1.5 rounded-pill">
                    <i class="fa-solid fa-building-user me-1"></i>@Model.ActorDepartmentName
                </span>
            }
        </div>
    }

    <div class="contact-box mb-3">
        <div class="text-uppercase text-secondary fw-bold mb-1" style="font-size: 11px; letter-spacing: 0.05em;">
            <i class="fa-solid fa-user-tie text-warning me-1"></i>Đầu mối phê duyệt & cấp quyền trực tiếp
        </div>
        <div class="fw-bold text-white">@contactName</div>
        @if (!string.IsNullOrWhiteSpace(Model?.ContactPersonTitle))
        {
            <div class="small text-secondary">@Model.ContactPersonTitle</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model?.ContactPersonEmail))
        {
            <div class="small text-info mt-1">
                <i class="fa-regular fa-envelope me-1"></i>@Model.ContactPersonEmail
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model?.AttemptedPath))
    {
        <div class="bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-3 p-2.5 mb-4 text-start font-monospace small text-secondary text-truncate">
            <span class="text-danger fw-bold">Tài nguyên yêu cầu:</span> @Model.AttemptedPath
        </div>
    }

    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
        <a href="javascript:history.back()" class="btn btn-outline-light px-4 py-2.5 rounded-3 fw-semibold">
            <i class="fa-solid fa-arrow-left me-1.5"></i> Quay Lại
        </a>
        <a href="/admin/dashboard" class="btn btn-primary px-4 py-2.5 rounded-3 fw-semibold">
            <i class="fa-solid fa-gauge-high me-1.5"></i> Về Bảng Điều Khiển
        </a>
        <a href="/admin/auth/logout" class="btn btn-outline-danger px-4 py-2.5 rounded-3 fw-semibold">
            <i class="fa-solid fa-arrow-right-from-bracket me-1.5"></i> Đổi Tài Khoản
        </a>
    </div>
</div>
</body>
</html>
