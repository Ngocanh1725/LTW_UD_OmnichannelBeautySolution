@model Omnichannel.Application.DTOs.Account.AccessDeniedViewModel
@{
    ViewData["Title"] = "Từ Chối Quyền Truy Cập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 Forbidden - @Brand.Name Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #070B14;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #F8FAFC;
        }
        .denied-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            border-radius: 24px;
            border: 1px solid rgba(239, 68, 68, 0.25);
            padding: 48px 36px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 40px -10px rgba(239, 68, 68, 0.2);
        }
        .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px auto;
            color: #EF4444;
            font-size: 36px;
        }
    </style>
</head>
<body>
<div class="denied-card">
    <div class="icon-circle">
        <i class="fa-solid fa-ban"></i>
    </div>
    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-3 py-1.5 rounded-pill mb-3">
        HTTP 403 • ACCESS DENIED
    </span>
    <h1 class="h4 fw-bold mb-2">Giới Hạn Đặc Quyền Quản Trị</h1>
    <p class="text-secondary small mb-4">
        @(!string.IsNullOrEmpty(Model?.Message) ? Model.Message : "Tài khoản của bạn không được cấp quyền hạn hạt nhân (Permission) để truy cập tài nguyên này.")
    </p>

    @if (!string.IsNullOrEmpty(Model?.AttemptedPath))
    {
        <div class="bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-3 p-2.5 mb-4 text-start font-monospace small text-secondary text-truncate">
            <span class="text-danger">URL:</span> @Model.AttemptedPath
        </div>
    }

    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
        <a href="/admin/dashboard" class="btn btn-primary px-4 py-2.5 rounded-3 fw-semibold">
            <i class="fa-solid fa-gauge-high me-1.5"></i> Về Bảng Điều Khiển
        </a>
        <a href="/admin/auth/logout" class="btn btn-outline-danger px-4 py-2.5 rounded-3 fw-semibold">
            <i class="fa-solid fa-arrow-right-from-bracket me-1.5"></i> Đăng Xuất Đổi Tài Khoản
        </a>
    </div>
</div>
</body>
</html>

