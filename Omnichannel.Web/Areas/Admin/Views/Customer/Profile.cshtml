@model Omnichannel.Application.DTOs.Crm.Customer360ProfileViewModel
@{
    ViewData["Title"] = $"Hồ Sơ 360° - {Model.FullName}";
    Layout = "_AdminLayout";

    var tierGradient = Model.TierName switch
    {
        "Diamond" => "from-cyan-400 via-sky-400 to-blue-500 text-white shadow-cyan-500/25",
        "Gold" => "from-amber-400 via-yellow-400 to-amber-500 text-amber-950 shadow-amber-500/25",
        "Silver" => "from-slate-200 via-slate-300 to-slate-400 text-slate-800 dark:from-slate-700 dark:via-slate-600 dark:to-slate-500 dark:text-slate-100",
        _ => "from-pink-400 to-rose-500 text-white"
    };

    var tierIcon = Model.TierName switch
    {
        "Diamond" => "fa-solid fa-gem text-cyan-200",
        "Gold" => "fa-solid fa-crown text-amber-950",
        "Silver" => "fa-solid fa-medal text-slate-700 dark:text-slate-200",
        _ => "fa-solid fa-user-tag text-white"
    };

    var qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=160x160&data={Uri.EscapeDataString(Model.QrCodeData ?? Model.Username)}";
}

<div class="space-y-6" x-data="{ activeTab: 'overview' }">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <a href="/Admin/Dashboard" class="hover:text-rose-500 transition-colors">Bảng Điều Khiển</a>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
            <a href="/Admin/Customer" class="hover:text-rose-500 transition-colors">Khách Hàng CRM</a>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
            <span class="text-slate-700 dark:text-slate-300 font-medium">Hồ Sơ 360° #@Model.UserId</span>
        </div>

        <div class="flex items-center gap-2">
            <a href="/Admin/Customer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-sm">
                <i class="fa-solid fa-arrow-left text-[11px]"></i>
                <span>Danh Sách</span>
            </a>
            <a href="/Admin/Customer/Edit/@Model.UserId" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white shadow-sm transition-colors">
                <i class="fa-solid fa-user-pen text-[11px]"></i>
                <span>Chỉnh Sửa</span>
            </a>
            <a href="/Admin/Pos" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm shadow-emerald-500/20 transition-all">
                <i class="fa-solid fa-cart-plus text-[11px]"></i>
                <span>Tạo Đơn POS</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-3 shadow-sm">
            <i class="fa-solid fa-circle-check text-emerald-500 text-lg shrink-0"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- 360° CUSTOMER PROFILE HEADER CARD -->
    <div class="relative overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <!-- Luxury Accent Glow -->
        <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-gradient-to-br from-rose-400/10 via-pink-400/10 to-amber-400/10 blur-3xl pointer-events-none"></div>

        <div class="p-6 sm:p-8">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <!-- Avatar & Core Identity -->
                <div class="flex flex-col sm:flex-row items-center sm:items-start lg:items-center gap-5 text-center sm:text-left">
                    <div class="relative shrink-0">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="@Model.FullName" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover ring-4 ring-rose-100 dark:ring-rose-950/60 shadow-lg" />
                        }
                        else
                        {
                            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-br from-rose-400 via-pink-500 to-rose-600 text-white flex items-center justify-center font-bold text-3xl shadow-lg ring-4 ring-rose-100 dark:ring-rose-950/60">
                                @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper())
                            </div>
                        }
                        @if (Model.IsActive)
                        {
                            <span class="absolute -bottom-1 -right-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500 text-white ring-2 ring-white dark:ring-slate-900 flex items-center gap-1 shadow-sm">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="absolute -bottom-1 -right-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-400 text-white ring-2 ring-white dark:ring-slate-900 shadow-sm">
                                Tạm khóa
                            </span>
                        }
                    </div>

                    <div class="space-y-2">
                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2.5">
                            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">@Model.FullName</h2>
                            <!-- Membership Tier Badge -->
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r @tierGradient shadow-md">
                                <i class="@tierIcon text-xs"></i>
                                <span>@Model.TierName Member</span>
                            </span>
                        </div>

                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs text-slate-500 dark:text-slate-400 font-medium">
                            <span class="inline-flex items-center gap-1.5 text-slate-700 dark:text-slate-300 font-mono">
                                <i class="fa-solid fa-hashtag text-slate-400 text-[10px]"></i>
                                @Model.Username
                            </span>
                            <span class="inline-block w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                            <span class="inline-flex items-center gap-1.5">
                                <i class="fa-solid fa-phone text-slate-400"></i>
                                <span class="font-mono">@(Model.PhoneNumber ?? "Chưa có SĐT")</span>
                            </span>
                            <span class="inline-block w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                            <span class="inline-flex items-center gap-1.5">
                                <i class="fa-solid fa-envelope text-slate-400"></i>
                                <span>@Model.Email</span>
                            </span>
                        </div>

                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 pt-1 text-xs">
                            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                <i class="fa-regular fa-calendar-check mr-1 text-slate-400"></i> Thành viên từ: <strong>@Model.MemberSince.ToString("dd/MM/yyyy")</strong>
                            </span>
                            @if (!string.IsNullOrEmpty(Model.CurrentSkinType))
                            {
                                <span class="px-2.5 py-1 rounded-lg bg-pink-50 dark:bg-pink-950/40 text-pink-700 dark:text-pink-300 font-semibold border border-pink-200/50 dark:border-pink-900/40">
                                    <i class="fa-solid fa-spa mr-1 text-pink-500"></i> @Model.CurrentSkinType
                                </span>
                            }
                            @if (Model.DateOfBirth.HasValue)
                            {
                                <span class="px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 font-medium border border-amber-200/50 dark:border-amber-900/40">
                                    <i class="fa-solid fa-cake-candles mr-1 text-amber-500"></i> @Model.DateOfBirth.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Digital VIP Member QR Card -->
                <div class="shrink-0 flex items-center justify-center">
                    <div class="p-4 rounded-xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white shadow-xl border border-slate-700/60 max-w-[260px] w-full text-center relative overflow-hidden group">
                        <div class="absolute -right-8 -top-8 w-24 h-24 bg-pink-500/20 rounded-full blur-xl pointer-events-none"></div>
                        <div class="flex items-center justify-between text-[11px] font-bold tracking-wider text-rose-400 mb-2">
                            <span>BEAUTY VIP PASS</span>
                            <span class="text-[10px] text-slate-400">@Model.TierName</span>
                        </div>
                        <div class="p-2 rounded-lg bg-white inline-block shadow-inner mb-2">
                            <img src="@qrCodeUrl" alt="QR Thẻ thành viên" class="w-24 h-24 object-contain" />
                        </div>
                        <div class="font-mono text-xs font-bold text-amber-300 tracking-wider">
                            @(Model.QrCodeData ?? $"LOYALTY-{Model.UserId}-{Model.TierName.ToUpper()}")
                        </div>
                        <div class="text-[10px] text-slate-400 mt-0.5">Quét tại POS để tích/đổi điểm</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 360° TABS NAVIGATION -->
        <div class="px-6 border-t border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40">
            <div class="flex items-center gap-1 sm:gap-4 overflow-x-auto scrollbar-none">
                <button type="button" 
                        @@click="activeTab = 'overview'" 
                        :class="activeTab === 'overview' ? 'border-rose-500 text-rose-600 dark:text-rose-400 font-bold bg-white dark:bg-slate-900 shadow-sm' : 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'"
                        class="py-3 px-4 border-b-2 text-xs sm:text-sm flex items-center gap-2 rounded-t-lg transition-all shrink-0">
                    <i class="fa-solid fa-chart-line text-rose-500"></i>
                    <span>Tổng Quan & Thống Kê</span>
                </button>

                <button type="button" 
                        @@click="activeTab = 'orders'" 
                        :class="activeTab === 'orders' ? 'border-rose-500 text-rose-600 dark:text-rose-400 font-bold bg-white dark:bg-slate-900 shadow-sm' : 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'"
                        class="py-3 px-4 border-b-2 text-xs sm:text-sm flex items-center gap-2 rounded-t-lg transition-all shrink-0">
                    <i class="fa-solid fa-receipt text-blue-500"></i>
                    <span>Lịch Sử Đơn Hàng</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300">
                        @Model.TotalOrdersCount
                    </span>
                </button>

                <button type="button" 
                        @@click="activeTab = 'loyalty'" 
                        :class="activeTab === 'loyalty' ? 'border-rose-500 text-rose-600 dark:text-rose-400 font-bold bg-white dark:bg-slate-900 shadow-sm' : 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'"
                        class="py-3 px-4 border-b-2 text-xs sm:text-sm flex items-center gap-2 rounded-t-lg transition-all shrink-0">
                    <i class="fa-solid fa-coins text-amber-500"></i>
                    <span>Điểm Thưởng & Thăng Hạng</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300">
                        @Model.CurrentPoints pts
                    </span>
                </button>

                <button type="button" 
                        @@click="activeTab = 'beauty'" 
                        :class="activeTab === 'beauty' ? 'border-rose-500 text-rose-600 dark:text-rose-400 font-bold bg-white dark:bg-slate-900 shadow-sm' : 'border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'"
                        class="py-3 px-4 border-b-2 text-xs sm:text-sm flex items-center gap-2 rounded-t-lg transition-all shrink-0">
                    <i class="fa-solid fa-wand-magic-sparkles text-purple-500"></i>
                    <span>Hồ Sơ Sắc Đẹp</span>
                    @if (Model.HasBeautyProfile)
                    {
                        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- TAB 1: TỔNG QUAN & THỐNG KÊ (OVERVIEW) -->
    <div x-show="activeTab === 'overview'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-6">
        <!-- 4 KPI Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 1. Total Spend -->
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Chi Tiêu 12 Tháng</span>
                    <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-950/50 text-rose-500 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
                <div class="font-mono text-2xl font-black text-slate-900 dark:text-white">
                    @Model.TotalSpend12Months.ToString("N0") <span class="text-sm font-sans font-normal text-slate-400">đ</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
                    <span>Tổng trọn đời:</span>
                    <span class="font-mono font-bold text-slate-700 dark:text-slate-300">@Model.TotalSpendAllTime.ToString("N0") đ</span>
                </div>
            </div>

            <!-- 2. Total Orders -->
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Tổng Đơn Hàng</span>
                    <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-500 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                </div>
                <div class="font-mono text-2xl font-black text-slate-900 dark:text-white">
                    @Model.TotalOrdersCount <span class="text-sm font-sans font-normal text-slate-400">đơn</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
                    <span>Hoàn thành:</span>
                    <span class="font-bold text-emerald-600 dark:text-emerald-400">@Model.CompletedOrdersCount đơn</span>
                </div>
            </div>

            <!-- 3. Current Loyalty Points -->
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Điểm Khả Dụng</span>
                    <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-500 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                </div>
                <div class="font-mono text-2xl font-black text-amber-600 dark:text-amber-400">
                    @Model.CurrentPoints.ToString("N0") <span class="text-sm font-sans font-normal text-slate-400">pts</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
                    <span>Tổng tích lũy:</span>
                    <span class="font-bold text-slate-700 dark:text-slate-300">@Model.TotalPointsEarned.ToString("N0") pts</span>
                </div>
            </div>

            <!-- 4. Average Order Value (AOV) -->
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Giá Trị Đơn TB (AOV)</span>
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-500 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                </div>
                <div class="font-mono text-2xl font-black text-slate-900 dark:text-white">
                    @Model.AverageOrderValue.ToString("N0") <span class="text-sm font-sans font-normal text-slate-400">đ</span>
                </div>
                <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 flex items-center justify-between">
                    <span>Hệ số tích điểm:</span>
                    <span class="font-bold text-rose-500">x@Model.PointMultiplier.ToString("0.0")</span>
                </div>
            </div>
        </div>

        <!-- 12-Month Spending Chart & Tier Upgrade Card -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Col (8): Line Chart -->
            <div class="lg:col-span-8 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                            <i class="fa-solid fa-chart-area text-rose-500"></i>
                            <span>Biến Động Chi Tiêu 12 Tháng Gần Nhất</span>
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">Biểu đồ thể hiện doanh số mua hàng đa kênh theo từng tháng</p>
                    </div>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-300">
                        12 Tháng
                    </span>
                </div>

                <div class="h-64 sm:h-72 w-full relative">
                    <canvas id="monthlySpendingChart"></canvas>
                </div>
            </div>

            <!-- Right Col (4): Tier Status & Skincare Snapshot -->
            <div class="lg:col-span-4 space-y-6">
                <!-- Tier Progress Card -->
                <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Tiến Độ Hạng Thành Viên</span>
                        <i class="@tierIcon text-base"></i>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br @tierGradient flex items-center justify-center font-bold text-lg shadow-md shrink-0">
                            <i class="@tierIcon"></i>
                        </div>
                        <div>
                            <div class="font-bold text-slate-900 dark:text-white text-base">Hạng @Model.TierName</div>
                            <div class="text-xs text-slate-400">Tích điểm x@Model.PointMultiplier.ToString("0.0") giá trị đơn</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.NextTierName))
                    {
                        var progressPercent = Model.MaxSpend.HasValue && Model.MaxSpend.Value > 0
                            ? Math.Min(100, (int)((Model.TotalSpend12Months / Model.MaxSpend.Value) * 100))
                            : 50;

                        <div class="space-y-1.5 pt-2">
                            <div class="flex justify-between text-xs text-slate-500 dark:text-slate-400">
                                <span>Lên hạng <strong>@Model.NextTierName</strong>:</span>
                                <span class="font-semibold text-rose-500">@progressPercent%</span>
                            </div>
                            <div class="w-full h-2.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                                <div class="h-full rounded-full bg-gradient-to-r from-rose-500 to-pink-500 transition-all duration-500" style="width: @progressPercent%"></div>
                            </div>
                            <p class="text-[11px] text-slate-400 pt-1">
                                Cần chi tiêu thêm <strong class="text-slate-700 dark:text-slate-200 font-mono">@Model.SpendNeededForNextTier.ToString("N0") đ</strong> trong 12 tháng để thăng hạng @Model.NextTierName.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-xl bg-cyan-50 dark:bg-cyan-950/40 text-cyan-800 dark:text-cyan-300 text-xs border border-cyan-200/50 flex items-center gap-2">
                            <i class="fa-solid fa-crown text-cyan-500"></i>
                            <span>Khách hàng đang ở hạng bậc cao nhất (VIP Diamond)!</span>
                        </div>
                    }
                </div>

                <!-- Skincare Advisor Quick Card -->
                <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Chuyên Viên Tư Vấn</span>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-300 flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-user-doctor"></i>
                        </div>
                        <div>
                            <div class="font-semibold text-slate-800 dark:text-slate-100 text-sm">
                                @(Model.ConsultantName ?? "Chưa chỉ định chuyên viên")
                            </div>
                            <div class="text-xs text-slate-400">
                                Lần tư vấn gần nhất: @(Model.LastConsultationDate.HasValue ? Model.LastConsultationDate.Value.ToString("dd/MM/yyyy") : "Chưa có")
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ConsultantNote))
                    {
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 text-xs text-slate-600 dark:text-slate-300 italic border-l-2 border-purple-500">
                            "@Model.ConsultantNote"
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: LỊCH SỬ ĐƠN HÀNG (ORDERS) -->
    <div x-show="activeTab === 'orders'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-4">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-receipt text-rose-500"></i>
                        <span>Danh Sách Đơn Hàng Đã Mua (@Model.Orders.Count đơn)</span>
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Bao gồm toàn bộ đơn hàng phát sinh từ quầy POS và Storefront Website</p>
                </div>
                <a href="/Admin/Order" class="text-xs font-semibold text-rose-500 hover:text-rose-600">Xem tất cả đơn hàng →</a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-semibold">Mã Đơn</th>
                            <th class="py-3 px-4 font-semibold">Kênh Bán</th>
                            <th class="py-3 px-4 font-semibold">Ngày Tạo</th>
                            <th class="py-3 px-4 font-semibold text-center">Số Món</th>
                            <th class="py-3 px-4 font-semibold text-right">Tổng Tiền</th>
                            <th class="py-3 px-4 font-semibold text-center">Trạng Thái Đơn</th>
                            <th class="py-3 px-4 font-semibold text-center">Thanh Toán</th>
                            <th class="py-3 px-4 font-semibold text-right">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                        @if (Model.Orders.Any())
                        {
                            @foreach (var order in Model.Orders)
                            {
                                var statusBadge = order.OrderStatus switch
                                {
                                    "COMPLETED" => "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800",
                                    "CANCELLED" => "bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border-rose-200 dark:border-rose-800",
                                    "PROCESSING" or "SHIPPING" => "bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border-sky-200 dark:border-sky-800",
                                    "CONFIRMED" => "bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-400 border-indigo-200 dark:border-indigo-800",
                                    _ => "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border-amber-200 dark:border-amber-800"
                                };

                                var statusText = order.OrderStatus switch
                                {
                                    "COMPLETED" => "Hoàn thành",
                                    "CANCELLED" => "Đã hủy",
                                    "SHIPPING" => "Đang giao",
                                    "PROCESSING" => "Đang xử lý",
                                    "CONFIRMED" => "Đã xác nhận",
                                    _ => "Chờ duyệt"
                                };

                                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="py-3 px-4 font-mono font-bold text-slate-800 dark:text-slate-100">
                                        <a href="/Admin/Order/Details/@order.Id" class="hover:text-rose-500 transition-colors">
                                            @order.OrderCode
                                        </a>
                                    </td>
                                    <td class="py-3 px-4">
                                        @if (order.OrderSource == "POS")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                                                <i class="fa-solid fa-cash-register text-[10px]"></i> POS Quầy
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                                                <i class="fa-solid fa-globe text-[10px]"></i> Website
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-xs text-slate-500 dark:text-slate-400">
                                        @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-3 px-4 text-center font-medium">
                                        @order.ItemsCount
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-slate-900 dark:text-white">
                                        @order.TotalAmount.ToString("N0") đ
                                    </td>
                                    <td class="py-3 px-4 text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border @statusBadge">
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-center">
                                        @if (order.PaymentStatus == "PAID")
                                        {
                                            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 flex items-center justify-center gap-1">
                                                <i class="fa-solid fa-circle-check text-[11px]"></i> Đã trả
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs font-medium text-amber-600 dark:text-amber-400 flex items-center justify-center gap-1">
                                                <i class="fa-solid fa-clock text-[11px]"></i> Chưa trả
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-right">
                                        <a href="/Admin/Order/Details/@order.Id" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors">
                                            <span>Chi tiết</span>
                                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="py-10 text-center text-slate-400">
                                    <i class="fa-solid fa-box-open text-3xl mb-2 text-slate-300 dark:text-slate-600"></i>
                                    <p class="text-xs">Khách hàng chưa có đơn hàng nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 3: ĐIỂM THƯỞNG & THĂNG HẠNG (LOYALTY) -->
    <div x-show="activeTab === 'loyalty'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-6">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-coins"></i>
                </div>
                <div>
                    <div class="text-xs font-bold uppercase text-slate-400">Điểm Khả Dụng Hiện Tại</div>
                    <div class="font-mono text-2xl font-black text-amber-600 dark:text-amber-400">@Model.CurrentPoints.ToString("N0") <span class="text-sm font-sans font-normal text-slate-400">điểm</span></div>
                </div>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-circle-arrow-up"></i>
                </div>
                <div>
                    <div class="text-xs font-bold uppercase text-slate-400">Tổng Điểm Tích Lũy</div>
                    <div class="font-mono text-2xl font-black text-slate-900 dark:text-white">@Model.TotalPointsEarned.ToString("N0") <span class="text-sm font-sans font-normal text-slate-400">điểm</span></div>
                </div>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-950/50 text-rose-500 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-crown"></i>
                </div>
                <div>
                    <div class="text-xs font-bold uppercase text-slate-400">Hạng & Hệ Số</div>
                    <div class="text-xl font-black text-slate-900 dark:text-white">Hạng @Model.TierName (x@Model.PointMultiplier.ToString("0.0"))</div>
                </div>
            </div>
        </div>

        <!-- Point Transactions History Table -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-amber-500"></i>
                        <span>Nhật Ký Giao Dịch Điểm Thành Viên</span>
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Lịch sử tích điểm từ đơn hàng, đổi voucher, thưởng sinh nhật và điều chỉnh</p>
                </div>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300">
                    @Model.PointTransactions.Count giao dịch
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-semibold">Thời Gian</th>
                            <th class="py-3 px-4 font-semibold">Loại Giao Dịch</th>
                            <th class="py-3 px-4 font-semibold text-right">Biến Động</th>
                            <th class="py-3 px-4 font-semibold text-right">Số Dư Trước</th>
                            <th class="py-3 px-4 font-semibold text-right">Số Dư Sau</th>
                            <th class="py-3 px-4 font-semibold">Nội Dung / Diễn Giải</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                        @if (Model.PointTransactions.Any())
                        {
                            @foreach (var pt in Model.PointTransactions)
                            {
                                var typeBadge = pt.TransactionType switch
                                {
                                    "EARN" => "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800",
                                    "REDEEM" => "bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-400 border border-rose-200 dark:border-rose-800",
                                    "BONUS" => "bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-200 dark:border-amber-800",
                                    _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300"
                                };

                                var typeText = pt.TransactionType switch
                                {
                                    "EARN" => "Tích điểm",
                                    "REDEEM" => "Đổi điểm",
                                    "BONUS" => "Thưởng hạng",
                                    "ADJUST" => "Điều chỉnh",
                                    _ => pt.TransactionType
                                };

                                <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="py-3 px-4 text-xs text-slate-500 dark:text-slate-400 font-mono">
                                        @pt.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-3 px-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @typeBadge">
                                            @typeText
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-black text-sm">
                                        @if (pt.Points > 0)
                                        {
                                            <span class="text-emerald-600 dark:text-emerald-400">+@pt.Points.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-rose-600 dark:text-rose-400">@pt.Points.ToString("N0")</span>
                                        }
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono text-xs text-slate-500 dark:text-slate-400">
                                        @pt.BalanceBefore.ToString("N0")
                                    </td>
                                    <td class="py-3 px-4 text-right font-mono font-bold text-xs text-slate-800 dark:text-slate-100">
                                        @pt.BalanceAfter.ToString("N0")
                                    </td>
                                    <td class="py-3 px-4 text-xs text-slate-700 dark:text-slate-200">
                                        @pt.Description
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-400 text-xs">
                                    Chưa có giao dịch điểm nào được ghi nhận.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 4: HỒ SƠ SẮC ĐẸP (BEAUTY PROFILE) -->
    <div x-show="activeTab === 'beauty'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Col (5): Skin Attributes & Preferences -->
            <div class="lg:col-span-5 space-y-6">
                <!-- Skin Type Card -->
                <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Loại Da Hiện Tại</span>
                        <a href="/Admin/Customer/Edit/@Model.UserId" class="text-xs font-semibold text-rose-500 hover:text-rose-600">Sửa</a>
                    </div>

                    <div class="p-4 rounded-xl bg-gradient-to-r from-pink-50 to-rose-50 dark:from-pink-950/30 dark:to-rose-950/30 border border-pink-200/60 dark:border-pink-900/40 flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-pink-500 text-white flex items-center justify-center text-xl shadow-md">
                            <i class="fa-solid fa-droplet"></i>
                        </div>
                        <div>
                            <div class="text-xs text-pink-600 dark:text-pink-400 font-semibold uppercase tracking-wider">Đặc tính làn da</div>
                            <div class="text-lg font-bold text-slate-900 dark:text-white">
                                @(string.IsNullOrEmpty(Model.CurrentSkinType) ? "Chưa xác định" : Model.CurrentSkinType)
                            </div>
                        </div>
                    </div>

                    <!-- Skin Concerns -->
                    <div class="space-y-2">
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-exclamation text-amber-500 text-xs"></i>
                            <span>Vấn Đề Về Da Quan Tâm:</span>
                        </span>
                        <div class="flex flex-wrap gap-1.5">
                            @if (Model.SkinConcerns.Any())
                            {
                                @foreach (var concern in Model.SkinConcerns)
                                {
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300 border border-amber-200/50">
                                        #@concern
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 italic">Chưa ghi nhận</span>
                            }
                        </div>
                    </div>

                    <!-- Known Allergies -->
                    <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <span class="text-xs font-semibold text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-triangle-exclamation text-xs"></i>
                            <span>Thành Phần Dị Ứng / Kích Ứng (Cần Tránh):</span>
                        </span>
                        <div class="flex flex-wrap gap-1.5">
                            @if (Model.KnownAllergies.Any())
                            {
                                @foreach (var allergy in Model.KnownAllergies)
                                {
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300 border border-rose-200/50">
                                        ⚠️ @allergy
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 italic">Không có dị ứng nào được ghi nhận</span>
                            }
                        </div>
                    </div>

                    <!-- Preferred Brands -->
                    <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-heart text-pink-500 text-xs"></i>
                            <span>Thương Hiệu Ưa Thích:</span>
                        </span>
                        <div class="flex flex-wrap gap-1.5">
                            @if (Model.PreferredBrands.Any())
                            {
                                @foreach (var brand in Model.PreferredBrands)
                                {
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-purple-50 text-purple-700 dark:bg-purple-950/40 dark:text-purple-300 border border-purple-200/50">
                                        @brand
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 italic">Chưa ghi nhận</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Col (7): Consultant Notes & Skin History Timeline -->
            <div class="lg:col-span-7 space-y-6">
                <!-- Consultant Note Box -->
                <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Ghi Chú Của Chuyên Viên Sắc Đẹp</span>
                        <span class="text-xs text-slate-400">Người phụ trách: <strong>@(Model.ConsultantName ?? "Hệ thống")</strong></span>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700 text-sm text-slate-700 dark:text-slate-200 italic">
                        @(string.IsNullOrEmpty(Model.ConsultantNote) ? "Chưa có ghi chú liệu trình đặc biệt nào." : Model.ConsultantNote)
                    </div>
                </div>

                <!-- Skin History Timeline -->
                <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h4 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="fa-solid fa-timeline text-pink-500"></i>
                                <span>Tiến Trình Chăm Sóc & Biến Chuyển Làn Da</span>
                            </h4>
                            <p class="text-xs text-slate-400 mt-0.5">Lịch sử soi da và kiểm tra định kỳ tại chi nhánh</p>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-pink-50 dark:bg-pink-950/40 text-pink-600 dark:text-pink-300">
                            @Model.SkinHistories.Count lần khám
                        </span>
                    </div>

                    @if (Model.SkinHistories.Any())
                    {
                        <div class="relative pl-6 space-y-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-pink-200 dark:before:bg-pink-950">
                            @foreach (var history in Model.SkinHistories)
                            {
                                <div class="relative group">
                                    <div class="absolute -left-[27px] top-1 w-3.5 h-3.5 rounded-full bg-pink-500 ring-4 ring-white dark:ring-slate-900"></div>
                                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800 space-y-1.5">
                                        <div class="flex flex-wrap items-center justify-between gap-2">
                                            <span class="text-xs font-bold text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                                                <i class="fa-regular fa-calendar text-rose-500"></i>
                                                @history.RecordedAt.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300">
                                                @history.SkinType
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrEmpty(history.SkinCondition))
                                        {
                                            <div class="text-xs font-medium text-slate-700 dark:text-slate-200">
                                                <strong>Tình trạng:</strong> @history.SkinCondition
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(history.TreatmentNote))
                                        {
                                            <div class="text-xs text-slate-600 dark:text-slate-300 bg-white dark:bg-slate-900/60 p-2.5 rounded-lg border border-slate-100 dark:border-slate-800">
                                                <i class="fa-solid fa-notes-medical text-rose-400 mr-1"></i>
                                                @history.TreatmentNote
                                            </div>
                                        }

                                        <div class="text-[11px] text-slate-400 pt-1">
                                            Ghi nhận bởi: <strong>@history.RecordedByName</strong>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-8 text-center text-slate-400 text-xs">
                            <i class="fa-solid fa-notes-medical text-2xl mb-2 text-slate-300 dark:text-slate-600"></i>
                            <p>Chưa có nhật ký soi da nào được ghi nhận cho khách hàng này.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('monthlySpendingChart');
            if (ctx) {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySpendingLabels));
                const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySpendingValues));

                // Gradient background fill
                const chartCtx = ctx.getContext('2d');
                const gradient = chartCtx.createLinearGradient(0, 0, 0, 260);
                gradient.addColorStop(0, 'rgba(244, 63, 94, 0.35)');
                gradient.addColorStop(1, 'rgba(244, 63, 94, 0.00)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Chi tiêu (VNĐ)',
                            data: dataValues,
                            borderColor: '#f43f5e',
                            borderWidth: 3,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.38,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#e11d48',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                titleFont: { size: 12, weight: 'bold' },
                                bodyFont: { size: 13 },
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function(context) {
                                        return ' ' + Number(context.parsed.y).toLocaleString('vi-VN') + ' đ';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(148, 163, 184, 0.1)'
                                },
                                ticks: {
                                    font: { size: 11 },
                                    color: '#94a3b8',
                                    callback: function(val) {
                                        if (val >= 1000000) return (val / 1000000).toFixed(1) + ' tr';
                                        if (val >= 1000) return (val / 1000).toFixed(0) + ' k';
                                        return val;
                                    }
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    font: { size: 11 },
                                    color: '#94a3b8'
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
