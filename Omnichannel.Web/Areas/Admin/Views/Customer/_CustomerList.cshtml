@model Omnichannel.Application.DTOs.Crm.CustomerPagedListViewModel

<div id="customerTableWrapper" class="space-y-4">
    <!-- Desktop Table View -->
    <div class="hidden md:block overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                <tr>
                    <th scope="col" class="py-3.5 px-4 font-semibold">Khách Hàng</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold">Liên Hệ</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-center">Hạng Thành Viên</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-right">Điểm Tích Lũy</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-right">Chi Tiêu (12 Tháng)</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-center">Đơn Hàng</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-center">Ngày Tham Gia</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-center">Trạng Thái</th>
                    <th scope="col" class="py-3.5 px-4 font-semibold text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        var tierGradient = item.TierName switch
                        {
                            "Diamond" => "bg-gradient-to-r from-cyan-400 via-sky-400 to-blue-500 text-white font-bold shadow-sm shadow-cyan-500/25",
                            "Gold" => "bg-gradient-to-r from-amber-400 to-yellow-500 text-amber-950 font-bold shadow-sm shadow-amber-500/25",
                            "Silver" => "bg-gradient-to-r from-slate-200 to-slate-300 text-slate-800 dark:from-slate-700 dark:to-slate-600 dark:text-slate-100 font-semibold border border-slate-300 dark:border-slate-600",
                            _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 font-semibold"
                        };

                        var tierIcon = item.TierName switch
                        {
                            "Diamond" => "fa-solid fa-gem text-cyan-200",
                            "Gold" => "fa-solid fa-crown text-amber-900",
                            "Silver" => "fa-solid fa-medal text-slate-600 dark:text-slate-300",
                            _ => "fa-solid fa-user-tag text-slate-500"
                        };

                        <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors group">
                            <!-- Customer Info -->
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="relative shrink-0">
                                        @if (!string.IsNullOrEmpty(item.AvatarUrl))
                                        {
                                            <img src="@item.AvatarUrl" alt="@item.FullName" class="w-10 h-10 rounded-full object-cover ring-2 ring-rose-200 dark:ring-rose-900/50" />
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-rose-400 to-pink-500 text-white flex items-center justify-center font-bold text-sm shadow-sm">
                                                @(string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        @if (item.IsActive)
                                        {
                                            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-slate-900"></span>
                                        }
                                        else
                                        {
                                            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-slate-400 ring-2 ring-white dark:ring-slate-900"></span>
                                        }
                                    </div>
                                    <div>
                                        <a href="/Admin/Customer/Profile/@item.Id" class="font-semibold text-slate-800 dark:text-slate-100 hover:text-rose-500 dark:hover:text-rose-400 transition-colors">
                                            @item.FullName
                                        </a>
                                        <div class="text-xs text-slate-400 dark:text-slate-500 flex items-center gap-1.5 mt-0.5">
                                            <span class="font-mono">@@@item.Username</span>
                                            @if (!string.IsNullOrEmpty(item.CurrentSkinType))
                                            {
                                                <span class="inline-block w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-600"></span>
                                                <span class="text-pink-500 dark:text-pink-400 font-medium">@item.CurrentSkinType</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Contact -->
                            <td class="py-3 px-4">
                                <div class="space-y-0.5">
                                    <div class="flex items-center gap-1.5 text-xs text-slate-700 dark:text-slate-200">
                                        <i class="fa-solid fa-phone text-slate-400 w-3 text-center"></i>
                                        <span class="font-mono font-medium">@(string.IsNullOrEmpty(item.PhoneNumber) ? "Chưa có" : item.PhoneNumber)</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500">
                                        <i class="fa-solid fa-envelope text-slate-400 w-3 text-center"></i>
                                        <span class="truncate max-w-[170px]" title="@item.Email">@item.Email</span>
                                    </div>
                                </div>
                            </td>

                            <!-- Member Tier -->
                            <td class="py-3 px-4 text-center">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs @tierGradient">
                                    <i class="@tierIcon text-[11px]"></i>
                                    <span>@item.TierName</span>
                                </span>
                            </td>

                            <!-- Points -->
                            <td class="py-3 px-4 text-right">
                                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 text-xs font-bold border border-amber-200/60 dark:border-amber-900/40">
                                    <i class="fa-solid fa-coins text-amber-500 text-[11px]"></i>
                                    <span>@item.CurrentPoints.ToString("N0")</span>
                                </div>
                            </td>

                            <!-- 12-Month Spend -->
                            <td class="py-3 px-4 text-right">
                                <div class="font-mono font-bold text-slate-800 dark:text-slate-100 text-sm">
                                    @item.TotalSpend12Months.ToString("N0") đ
                                </div>
                                @if (item.TotalSpendAllTime > item.TotalSpend12Months)
                                {
                                    <div class="text-[11px] text-slate-400 dark:text-slate-500">
                                        Trọn đời: @item.TotalSpendAllTime.ToString("N0") đ
                                    </div>
                                }
                            </td>

                            <!-- Total Orders -->
                            <td class="py-3 px-4 text-center">
                                <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                                    @item.TotalOrders đơn
                                </span>
                            </td>

                            <!-- Joined Date -->
                            <td class="py-3 px-4 text-center text-xs text-slate-500 dark:text-slate-400">
                                @item.MemberSince.ToString("dd/MM/yyyy")
                            </td>

                            <!-- Status -->
                            <td class="py-3 px-4 text-center">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/60">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800/60">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                        Khóa
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="py-3 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5 opacity-90 group-hover:opacity-100">
                                    <a href="/Admin/Customer/Profile/@item.Id" 
                                       class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 hover:bg-rose-100 text-rose-600 dark:bg-rose-950/40 dark:hover:bg-rose-900/60 dark:text-rose-300 transition-colors"
                                       title="Xem Hồ Sơ 360°">
                                        <i class="fa-solid fa-address-card"></i>
                                        <span>Hồ Sơ 360°</span>
                                    </a>
                                    <a href="/Admin/Customer/Edit/@item.Id" 
                                       class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                       title="Chỉnh sửa thông tin">
                                        <i class="fa-solid fa-user-pen text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="py-12 text-center">
                            <div class="max-w-sm mx-auto flex flex-col items-center">
                                <div class="w-14 h-14 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-400 flex items-center justify-center text-2xl mb-3 shadow-inner">
                                    <i class="fa-solid fa-users-slash"></i>
                                </div>
                                <h4 class="text-base font-semibold text-slate-800 dark:text-slate-100 mb-1">Không tìm thấy khách hàng nào</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">Thử thay đổi từ khóa tìm kiếm hoặc bỏ chọn bộ lọc hạng thành viên.</p>
                                <button type="button" 
                                        onclick="document.getElementById('keywordInput').value=''; document.getElementById('tierSelect').value=''; htmx.trigger('#filterForm', 'submit');" 
                                        class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors">
                                    <i class="fa-solid fa-rotate-right mr-1.5"></i> Đặt Lại Bộ Lọc
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View -->
    <div class="block md:hidden space-y-3">
        @if (Model.Items != null && Model.Items.Any())
        {
            @foreach (var item in Model.Items)
            {
                var tierGradient = item.TierName switch
                {
                    "Diamond" => "bg-gradient-to-r from-cyan-400 to-blue-500 text-white font-bold",
                    "Gold" => "bg-gradient-to-r from-amber-400 to-yellow-500 text-amber-950 font-bold",
                    "Silver" => "bg-gradient-to-r from-slate-200 to-slate-300 text-slate-800 dark:from-slate-700 dark:to-slate-600 dark:text-slate-100 font-semibold",
                    _ => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 font-semibold"
                };

                <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                            {
                                <img src="@item.AvatarUrl" alt="@item.FullName" class="w-10 h-10 rounded-full object-cover ring-2 ring-rose-200 dark:ring-rose-900/50" />
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-rose-400 to-pink-500 text-white flex items-center justify-center font-bold text-sm">
                                    @(string.IsNullOrEmpty(item.FullName) ? "?" : item.FullName.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <div>
                                <a href="/Admin/Customer/Profile/@item.Id" class="font-semibold text-slate-800 dark:text-slate-100 text-sm">
                                    @item.FullName
                                </a>
                                <div class="text-xs text-slate-400 dark:text-slate-500 font-mono">
                                    @@@item.Username
                                </div>
                            </div>
                        </div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs @tierGradient">
                            @item.TierName
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs py-2 border-y border-slate-100 dark:border-slate-800/80">
                        <div>
                            <span class="text-slate-400 dark:text-slate-500">Điện thoại:</span>
                            <div class="font-mono font-medium text-slate-700 dark:text-slate-200">@(item.PhoneNumber ?? "Chưa có")</div>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500">Điểm khả dụng:</span>
                            <div class="font-bold text-amber-600 dark:text-amber-400">@item.CurrentPoints.ToString("N0") pts</div>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500">Chi tiêu 12T:</span>
                            <div class="font-mono font-bold text-slate-800 dark:text-slate-100">@item.TotalSpend12Months.ToString("N0") đ</div>
                        </div>
                        <div>
                            <span class="text-slate-400 dark:text-slate-500">Đơn hàng:</span>
                            <div class="font-semibold text-slate-700 dark:text-slate-200">@item.TotalOrders đơn</div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-1">
                        <span class="text-xs text-slate-400">Tham gia: @item.MemberSince.ToString("dd/MM/yyyy")</span>
                        <div class="flex items-center gap-2">
                            <a href="/Admin/Customer/Edit/@item.Id" class="px-2.5 py-1.5 rounded-lg text-xs text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 font-medium">
                                Sửa
                            </a>
                            <a href="/Admin/Customer/Profile/@item.Id" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-500 text-white hover:bg-rose-600 transition-colors">
                                Hồ Sơ 360°
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="p-8 text-center rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <i class="fa-solid fa-users-slash text-3xl text-slate-300 dark:text-slate-600 mb-2"></i>
                <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Không tìm thấy khách hàng nào</p>
            </div>
        }
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-3 pb-2 text-xs text-slate-500 dark:text-slate-400">
            <div>
                Hiển thị <span class="font-semibold text-slate-800 dark:text-slate-100">@(((Model.PageNumber - 1) * Model.PageSize) + 1)</span> - 
                <span class="font-semibold text-slate-800 dark:text-slate-100">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</span> trong tổng số 
                <span class="font-semibold text-slate-800 dark:text-slate-100">@Model.TotalCount</span> khách hàng
            </div>

            <div class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-1 shadow-sm">
                <!-- First Page -->
                <button type="button"
                        hx-get="/Admin/Customer?Keyword=@Model.Filter.Keyword&TierId=@Model.Filter.TierId&SortBy=@Model.Filter.SortBy&PageNumber=1&PageSize=@Model.PageSize"
                        hx-target="#customerTableContainer"
                        hx-indicator="#tableLoadingSpinner"
                        class="p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                        @(Model.PageNumber <= 1 ? "disabled" : "")
                        title="Trang đầu">
                    <i class="fa-solid fa-angles-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button"
                        hx-get="/Admin/Customer?Keyword=@Model.Filter.Keyword&TierId=@Model.Filter.TierId&SortBy=@Model.Filter.SortBy&PageNumber=@(Model.PageNumber - 1)&PageSize=@Model.PageSize"
                        hx-target="#customerTableContainer"
                        hx-indicator="#tableLoadingSpinner"
                        class="p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                        @(!Model.HasPreviousPage ? "disabled" : "")
                        title="Trang trước">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <!-- Current / Total -->
                <span class="px-3 py-1 font-semibold text-slate-700 dark:text-slate-200">
                    Trang @Model.PageNumber / @Model.TotalPages
                </span>

                <!-- Next Page -->
                <button type="button"
                        hx-get="/Admin/Customer?Keyword=@Model.Filter.Keyword&TierId=@Model.Filter.TierId&SortBy=@Model.Filter.SortBy&PageNumber=@(Model.PageNumber + 1)&PageSize=@Model.PageSize"
                        hx-target="#customerTableContainer"
                        hx-indicator="#tableLoadingSpinner"
                        class="p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                        @(!Model.HasNextPage ? "disabled" : "")
                        title="Trang kế tiếp">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button"
                        hx-get="/Admin/Customer?Keyword=@Model.Filter.Keyword&TierId=@Model.Filter.TierId&SortBy=@Model.Filter.SortBy&PageNumber=@Model.TotalPages&PageSize=@Model.PageSize"
                        hx-target="#customerTableContainer"
                        hx-indicator="#tableLoadingSpinner"
                        class="p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30 disabled:pointer-events-none transition-colors"
                        @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")
                        title="Trang cuối">
                    <i class="fa-solid fa-angles-right"></i>
                </button>
            </div>
        </div>
    }
</div>
