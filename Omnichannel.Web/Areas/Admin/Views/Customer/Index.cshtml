@model Omnichannel.Application.DTOs.Crm.CustomerPagedListViewModel
@{
    ViewData["Title"] = "Quản Lý Khách Hàng (CRM 360°)";
    Layout = "_AdminLayout";
    var currentTierId = Model.Filter?.TierId;
}

<div class="space-y-6" x-data="{ activeTier: '@(currentTierId?.ToString() ?? "")' }">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-1">
                <a href="/Admin/Dashboard" class="hover:text-rose-500 transition-colors">Bảng Điều Khiển</a>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
                <span class="text-slate-700 dark:text-slate-300 font-medium">Khách Hàng CRM</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2.5">
                <i class="fa-solid fa-address-book text-pink-500"></i>
                <span>Quản Lý Khách Hàng (CRM 360°)</span>
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                Hồ sơ khách hàng đa kênh, ví điểm thưởng thành viên và hồ sơ sắc đẹp cá nhân hóa.
            </p>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="/Admin/Pos" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm shadow-emerald-500/20 transition-all">
                <i class="fa-solid fa-cash-register"></i>
                <span>Tạo Đơn POS</span>
            </a>
            <a href="/Admin/Order" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-sm">
                <i class="fa-solid fa-receipt text-rose-500"></i>
                <span>Đơn Hàng</span>
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-emerald-500 text-base shrink-0"></i>
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-300 text-sm flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation text-rose-500 text-base shrink-0"></i>
            <span class="font-medium">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Membership Tier Status Tabs Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800 scrollbar-none">
        <!-- Tab All -->
        <button type="button"
                @@click="activeTier = ''; document.getElementById('tierSelect').value = ''; htmx.trigger('#filterForm', 'submit');"
                :class="activeTier === '' ? 'bg-pink-500 text-white shadow-md shadow-pink-500/20' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800'"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all shrink-0">
            <i class="fa-solid fa-users"></i>
            <span>Tất Cả Khách Hàng</span>
            <span :class="activeTier === '' ? 'bg-white/20 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'" class="px-2 py-0.5 rounded-full text-[11px] font-bold">
                @Model.TierCounts.GetValueOrDefault("All", 0)
            </span>
        </button>

        @foreach (var tier in Model.AvailableTiers)
        {
            var tierIdStr = tier.Id.ToString();
            var iconClass = tier.TierName switch
            {
                "Diamond" => "fa-solid fa-gem text-cyan-400",
                "Gold" => "fa-solid fa-crown text-amber-400",
                "Silver" => "fa-solid fa-medal text-slate-400",
                _ => "fa-solid fa-user-tag text-pink-400"
            };

            <button type="button"
                    @@click="activeTier = '@tierIdStr'; document.getElementById('tierSelect').value = '@tierIdStr'; htmx.trigger('#filterForm', 'submit');"
                    :class="activeTier === '@tierIdStr' ? 'bg-pink-500 text-white shadow-md shadow-pink-500/20' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800'"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all shrink-0">
                <i class="@iconClass"></i>
                <span>@tier.TierName</span>
                <span :class="activeTier === '@tierIdStr' ? 'bg-white/20 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'" class="px-2 py-0.5 rounded-full text-[11px] font-bold">
                    @tier.MemberCount
                </span>
            </button>
        }
    </div>

    <!-- Filter & Search Controls Bar -->
    <form id="filterForm" 
          hx-get="/Admin/Customer" 
          hx-target="#customerTableContainer" 
          hx-indicator="#tableLoadingSpinner"
          class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-sm">
        
        <input type="hidden" name="TierId" id="tierSelect" value="@(Model.Filter?.TierId)" />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3.5 items-center">
            <!-- Search Keyword -->
            <div class="lg:col-span-6 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text"
                       name="Keyword"
                       id="keywordInput"
                       value="@Model.Filter?.Keyword"
                       placeholder="Tìm kiếm theo Tên, SĐT, Email, Username..."
                       hx-get="/Admin/Customer"
                       hx-target="#customerTableContainer"
                       hx-trigger="input changed delay:400ms, search"
                       hx-include="#filterForm"
                       hx-indicator="#tableLoadingSpinner"
                       class="w-full pl-9 pr-4 py-2 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all" />
            </div>

            <!-- Sort By Dropdown -->
            <div class="lg:col-span-4">
                <select name="SortBy"
                        onchange="htmx.trigger('#filterForm', 'submit')"
                        class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
                    <!option value="spend_desc" @(Model.Filter?.SortBy == "spend_desc" ? "selected" : "")>💰 Chi tiêu 12 tháng: Cao nhất</!option>
                    <!option value="spend_asc" @(Model.Filter?.SortBy == "spend_asc" ? "selected" : "")>💰 Chi tiêu 12 tháng: Thấp nhất</!option>
                    <!option value="points_desc" @(Model.Filter?.SortBy == "points_desc" ? "selected" : "")>⭐ Điểm tích lũy: Nhiều nhất</!option>
                    <!option value="points_asc" @(Model.Filter?.SortBy == "points_asc" ? "selected" : "")>⭐ Điểm tích lũy: Ít nhất</!option>
                    <!option value="newest" @(Model.Filter?.SortBy == "newest" ? "selected" : "")>🕒 Khách hàng mới nhất</!option>
                    <!option value="oldest" @(Model.Filter?.SortBy == "oldest" ? "selected" : "")>🕒 Khách hàng lâu năm nhất</!option>
                    <!option value="name_asc" @(Model.Filter?.SortBy == "name_asc" ? "selected" : "")>🔤 Họ và tên: A → Z</!option>
                </select>
            </div>

            <!-- Page Size & Reset -->
            <div class="lg:col-span-2 flex items-center justify-end gap-2">
                <select name="PageSize"
                        onchange="htmx.trigger('#filterForm', 'submit')"
                        class="px-2.5 py-2 text-xs rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all">
                    <!option value="10" @(Model.PageSize == 10 ? "selected" : "")>10 / trang</!option>
                    <!option value="20" @(Model.PageSize == 20 ? "selected" : "")>20 / trang</!option>
                    <!option value="50" @(Model.PageSize == 50 ? "selected" : "")>50 / trang</!option>
                </select>

                <button type="button"
                        onclick="document.getElementById('keywordInput').value=''; document.getElementById('tierSelect').value=''; activeTier=''; htmx.trigger('#filterForm', 'submit');"
                        class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
                        title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                </button>
            </div>
        </div>
    </form>

    <!-- Loading Indicator Shimmer -->
    <div id="tableLoadingSpinner" class="htmx-indicator py-4 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-300 text-xs font-semibold shadow-sm border border-rose-200/50 dark:border-rose-900/50">
            <i class="fa-solid fa-spinner fa-spin text-rose-500"></i>
            <span>Đang tải danh sách khách hàng...</span>
        </div>
    </div>

    <!-- Paged Customer Table Container -->
    <div id="customerTableContainer">
        @await Html.PartialAsync("_CustomerList", Model)
    </div>
</div>
