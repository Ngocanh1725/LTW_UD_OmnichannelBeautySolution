@{
    ViewData["Title"] = "Quầy Thu Ngân Bán Lẻ";
    Layout = "_PosLayout";
    var stores = ViewBag.Stores as List<Omnichannel.Domain.Entities.Store> ?? new List<Omnichannel.Domain.Entities.Store>();
    var currentStore = ViewBag.CurrentStore as Omnichannel.Domain.Entities.Store;
    var currentShift = ViewBag.CurrentShift as Omnichannel.Application.DTOs.Sales.PosShiftSummaryDto;
    var cashierName = ViewBag.CashierName as string ?? "Thu Ngân";
    var cashierId = ViewBag.CashierId != null ? (int)ViewBag.CashierId : 1;
    var categories = ViewBag.Categories as List<Omnichannel.Domain.Entities.Category> ?? new List<Omnichannel.Domain.Entities.Category>();
}

<!-- TOP HEADER BAR: STORE, SHIFT & HOTKEYS -->
<header class="pos-header d-flex align-items-center justify-content-between">
    <!-- Brand & Store Selection -->
    <div class="d-flex align-items-center gap-3">
        <a href="/Admin/Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-none">
            <i class="fa-solid fa-arrow-left me-1"></i>Quản Trị
        </a>
        <span class="fw-bold text-dark fs-5 d-flex align-items-center">
            <span class="p-1.5 rounded-3 bg-danger-subtle text-danger me-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="fa-solid fa-cash-register fs-6"></i>
            </span>
            <span>Omni Beauty POS</span>
        </span>

        <!-- Store Selector Dropdown -->
        <div class="dropdown">
            <button class="btn btn-sm btn-light border px-3 rounded-pill dropdown-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-shop text-danger"></i>
                <span id="currentStoreName">@(currentStore?.Name ?? "Chọn Chi Nhánh")</span>
            </button>
            <ul class="dropdown-menu shadow-sm rounded-3 border-0 py-1" style="font-size: 13px;">
                @foreach (var s in stores)
                {
                    <li>
                        <a class="dropdown-item py-2 @(s.Id == currentStore?.Id ? "active fw-bold" : "")" href="/Admin/Pos?storeId=@s.Id">
                            <i class="fa-solid fa-location-dot me-2 text-secondary"></i>@s.Name
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Shift Status Widget -->
    <div class="d-flex align-items-center gap-2">
        @if (currentShift != null)
        {
            <div id="shiftActiveBadge" class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-success-subtle text-success border border-success-subtle small font-monospace">
                <span class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 8px; height: 8px;"></span>
                <span>Ca: <strong>@currentShift.ShiftCode</strong></span>
                <span class="text-secondary opacity-75">|</span>
                <span>Đầu ca: <strong>@currentShift.OpeningBalance.ToString("N0") đ</strong></span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold text-dark" onclick="openDrawerModal()" title="Rút bớt tiền nộp két lớn (Drop Cash) hoặc bổ sung tiền lẻ (Add Float)">
                <i class="fa-solid fa-vault me-1 text-warning"></i>Két Tiền
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" onclick="openCloseShiftModal()">
                <i class="fa-solid fa-lock me-1"></i>Chốt Ca
            </button>
        }
        else
        {
            <div id="shiftInactiveBadge" class="d-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle small">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>Chưa mở ca bán hàng</span>
            </div>
            <button type="button" class="btn btn-sm btn-gradient rounded-pill px-3 fw-semibold" onclick="openOpenShiftModal()">
                <i class="fa-solid fa-key me-1"></i>Mở Ca Mới
            </button>
        }
    </div>

    <!-- Standard Keyboard Hotkeys Legend Bar (F1, F2, F8, F9, F10) -->
    <div class="d-none d-lg-flex align-items-center gap-2 small text-secondary">
        <span role="button" onclick="focusBarcodeScanner()" class="badge bg-light text-dark border px-2 py-1 cursor-pointer hover-bg" title="Phím tắt F1: Quét mã vạch GS1-128 / Tìm sản phẩm">
            <span class="hotkey-badge me-1">F1</span>Quét Barcode
        </span>
        <span role="button" onclick="focusCustomerSearch()" class="badge bg-light text-dark border px-2 py-1 cursor-pointer hover-bg" title="Phím tắt F2: Tra cứu khách hàng VIP & tích điểm">
            <span class="hotkey-badge me-1">F2</span>Tìm Khách VIP
        </span>
        <span role="button" onclick="focusCouponInput()" class="badge bg-light text-dark border px-2 py-1 cursor-pointer hover-bg" title="Phím tắt F8: Áp dụng mã giảm giá voucher">
            <span class="hotkey-badge me-1">F8</span>Voucher
        </span>
        <span role="button" onclick="openCheckoutModal()" class="badge bg-light text-dark border px-2 py-1 cursor-pointer hover-bg" title="Phím tắt F9: Mở popup thanh toán">
            <span class="hotkey-badge me-1">F9</span>Thanh toán
        </span>
        <span role="button" onclick="printLastReceipt()" class="badge bg-light text-dark border px-2 py-1 cursor-pointer hover-bg" title="Phím tắt F10: In lại hóa đơn nhiệt 80mm gần nhất">
            <span class="hotkey-badge me-1">F10</span>In K80
        </span>
    </div>

    <!-- Cashier Info -->
    <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: #EDE9FE; color: #7C3AED; font-weight: 700;">
            <i class="fa-solid fa-user-tie"></i>
        </div>
        <div class="small text-end">
            <div class="fw-bold text-dark lh-1">@cashierName</div>
            <span class="text-muted" style="font-size: 11px;">Thu ngân chính</span>
        </div>
    </div>
</header>

<!-- MAIN POS WORKSPACE: 2 COLUMNS -->
<div class="container-fluid pos-workspace p-3">
    <div class="row h-100 g-3">
        <!-- LEFT COLUMN: SCANNER, SEARCH, CATALOG GRID & CART TABLE (8 COLS) -->
        <div class="col-lg-8 d-flex flex-column h-100">
            <!-- Scan / Search / View Switcher Card -->
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-2 bg-white">
                <div class="row g-2 align-items-center">
                    <!-- Barcode / SKU Scanner Input (F1) with Laser Auto-Detect Indicator -->
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0" id="scannerStatusIcon" title="Máy quét mã vạch Laser tự động nhận diện (F1)">
                                <i class="fa-solid fa-barcode text-primary fs-5"></i>
                            </span>
                            <input type="text" 
                                   id="barcodeScannerInput" 
                                   class="form-control form-control-lg bg-light border-0 fs-6 font-monospace" 
                                   placeholder="[F1] Quét mã vạch GS1-128 / SKU (Laser Scanner Ready)..." 
                                   autofocus 
                                   autocomplete="off" />
                            <span class="input-group-text bg-light border-0 d-none d-sm-flex">
                                <span class="badge bg-success-subtle text-success border border-success-subtle small py-1" style="font-size: 11px;">
                                    <i class="fa-solid fa-bolt me-1 text-success"></i>F1 Laser Ready
                                </span>
                            </span>
                        </div>
                    </div>

                    <!-- Live Keyword Search Input -->
                    <div class="col-md-4 position-relative">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                            <input type="text" id="keywordSearchInput" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="Tìm tên mỹ phẩm / SKU..." autocomplete="off" />
                            <span id="searchLoadingSpinner" class="input-group-text bg-light border-0 d-none">
                                <i class="fa-solid fa-spinner fa-spin text-primary"></i>
                            </span>
                        </div>
                        <!-- Search Dropdown Results -->
                        <div id="searchDropdown" class="position-absolute bg-white shadow-lg rounded-4 mt-1 border p-2 d-none" style="z-index: 1050; width: 100%; max-height: 320px; overflow-y: auto;">
                            <!-- Dynamically populated -->
                        </div>
                    </div>

                    <!-- View Switcher (Cart vs Visual Catalog vs Split) -->
                    <div class="col-md-2 text-end">
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-sm btn-outline-secondary active px-2" id="btnViewSplit" onclick="switchPosView('split')" title="Chế độ chia đôi: Giỏ hàng + Lưới danh mục">
                                <i class="fa-solid fa-table-columns"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2" id="btnViewCart" onclick="switchPosView('cart')" title="Chỉ hiện bảng giỏ hàng">
                                <i class="fa-solid fa-list-check"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2" id="btnViewCatalog" onclick="switchPosView('catalog')" title="Chỉ hiện lưới sản phẩm danh mục">
                                <i class="fa-solid fa-border-all"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Workspace Body: Split View / Cart Table / Visual Product Catalog -->
            <div class="flex-grow-1 overflow-hidden d-flex gap-2" id="posLeftWorkspace">
                <!-- 1. CART TABLE CONTAINER -->
                <div class="card border-0 shadow-sm rounded-4 flex-grow-1 bg-white overflow-hidden d-flex flex-column" id="cartSection" style="flex: 1 1 55%;">
                    <div class="p-2.5 px-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                        <span class="small fw-bold text-dark flex align-items-center gap-1.5">
                            <i class="fa-solid fa-cart-shopping text-rose-500 text-danger"></i>
                            <span>Chi Tiết Giỏ Hàng POS</span>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1 font-monospace" id="cartItemBadge">0</span>
                        </span>
                        <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 small" onclick="clearCart()">
                            <i class="fa-solid fa-trash-can me-1"></i>Xóa sạch
                        </button>
                    </div>

                    <div class="table-responsive flex-grow-1 overflow-y-auto">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light sticky-top">
                                <tr class="small text-secondary" style="font-size: 11px;">
                                    <th class="py-2.5 px-3" style="width: 35px;">#</th>
                                    <th class="py-2.5">Mỹ phẩm / Lô FEFO</th>
                                    <th class="py-2.5 text-end" style="width: 105px;">Đơn giá</th>
                                    <th class="py-2.5 text-center" style="width: 130px;">Số lượng</th>
                                    <th class="py-2.5 text-end px-3" style="width: 120px;">Thành tiền</th>
                                    <th class="py-2.5 text-center" style="width: 35px;"></th>
                                </tr>
                            </thead>
                            <tbody id="posCartTbody">
                                <!-- Populated via JavaScript -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty Cart Notice -->
                    <div id="emptyCartNotice" class="text-center py-5 text-muted my-auto">
                        <div class="p-3 rounded-circle bg-light d-inline-block mb-3">
                            <i class="fa-solid fa-basket-shopping fs-1 text-secondary opacity-50"></i>
                        </div>
                        <div class="fw-semibold text-dark mb-1">Giỏ hàng đang trống</div>
                        <div class="small text-muted">Quét mã vạch laser (F2) hoặc bấm vào sản phẩm trong danh mục bên cạnh.</div>
                    </div>

                    <!-- Bottom Cart Status Summary -->
                    <div class="p-2 px-3 bg-light border-top d-flex align-items-center justify-content-between small text-secondary">
                        <div>
                            Dòng hàng: <strong id="cartItemCount" class="text-dark font-monospace">0</strong> • 
                            Tổng số lượng: <strong id="cartTotalQty" class="text-dark font-monospace">0</strong>
                        </div>
                        <div class="font-monospace fw-bold text-dark">
                            Tạm tính: <span id="cartSubTotalBottom" class="text-danger">0 đ</span>
                        </div>
                    </div>
                </div>

                <!-- 2. VISUAL PRODUCT CATALOG & CATEGORIES GRID -->
                <div class="card border-0 shadow-sm rounded-4 flex-grow-1 bg-white overflow-hidden d-flex flex-column" id="catalogSection" style="flex: 1 1 45%;">
                    <!-- Category Pills Carousel -->
                    <div class="p-2 border-bottom bg-light">
                        <div class="d-flex align-items-center gap-1.5 overflow-x-auto pb-1" id="categoryPillsList" style="white-space: nowrap;">
                            <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 fw-semibold small flex-shrink-0 category-pill active" data-cat-id="0" onclick="filterCatalogByCategory(0)">
                                Tất cả
                            </button>
                            @foreach (var c in categories)
                            {
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1 fw-semibold small flex-shrink-0 category-pill" data-cat-id="@c.Id" onclick="filterCatalogByCategory(@c.Id)">
                                    @c.Name
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Product Quick-Pick Cards Grid -->
                    <div class="flex-grow-1 p-2.5 overflow-y-auto" style="max-height: calc(100vh - 220px);">
                        <div class="row row-cols-2 row-cols-md-3 g-2" id="catalogProductGrid">
                            <!-- Populated dynamically via fetch / Admin/Pos/GetVisualCatalog -->
                            <div class="col-12 text-center py-5 text-muted">
                                <i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải danh mục mỹ phẩm...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: BILLING & CHECKOUT (4 COLS) -->
        <div class="col-lg-4 h-100 d-flex flex-column">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white d-flex flex-column overflow-hidden">
                <!-- Scrollable Form Container -->
                <div class="flex-grow-1 overflow-y-auto pe-1" style="max-height: calc(100vh - 180px);">
                    <!-- 1. Customer Section (F2) with VIP Tier & Loyalty Redemption -->
                    <div class="mb-2 pb-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small fw-bold text-dark"><i class="fa-solid fa-id-card me-1 text-primary"></i>Khách Hàng Thành Viên</span>
                            <span class="hotkey-badge" role="button" onclick="focusCustomerSearch()" title="Phím tắt F2">F2</span>
                        </div>
                        <div class="input-group mb-1.5">
                            <input type="text" id="custPhoneInput" class="form-control form-control-sm rounded-start-3 font-monospace" placeholder="Nhập SĐT khách (0909000011)..." autocomplete="off" />
                            <button type="button" class="btn btn-sm btn-primary px-3 rounded-end-3" onclick="searchCustomer()">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </div>

                        <!-- Customer Profile & Loyalty Card (Toggled when found) -->
                        <div id="customerInfoCard" class="p-2.5 rounded-3 bg-light border d-none space-y-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div id="custNameLabel" class="fw-bold text-dark small">Khách hàng</div>
                                    <div class="d-flex align-items-center gap-1.5 mt-1 flex-wrap">
                                        <span id="custTierBadge" class="badge bg-warning text-dark font-monospace" style="font-size: 10px;">Silver</span>
                                        <span id="custPointsLabel" class="badge bg-info-subtle text-info border font-monospace" style="font-size: 10px;">⭐ 0 pts</span>
                                    </div>
                                    <div id="custSkinLabel" class="text-secondary mt-0.5" style="font-size: 11px;">Da dầu mụn</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="resetCustomer()" title="Xóa khách hàng">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>

                            <!-- Cấn Trừ Điểm Tích Lũy Trực Tiếp -->
                            <div class="pt-2 border-top" id="loyaltyRedeemBox">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" role="switch" id="chkUsePoints" onchange="toggleUsePoints()" />
                                    <label class="form-check-label small fw-semibold text-dark" for="chkUsePoints">
                                        Cấn trừ điểm Beauty Club
                                    </label>
                                </div>
                                <div id="pointRedeemInputs" class="d-none">
                                    <div class="input-group input-group-sm mb-1">
                                        <span class="input-group-text bg-white small">Điểm tiêu:</span>
                                        <input type="number" id="inputRedeemPoints" class="form-control font-monospace text-end" value="0" min="0" step="10" oninput="onRedeemPointsChanged()" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setMaxRedeemPoints()">Tất cả</button>
                                    </div>
                                    <div class="d-flex justify-content-between text-success font-monospace" style="font-size: 11px;">
                                        <span>Giảm tương đương:</span>
                                        <strong id="pointDiscountText">-0 đ</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Voucher / Coupon Section (F8) -->
                    <div class="mb-2 pb-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small fw-bold text-dark"><i class="fa-solid fa-ticket me-1 text-danger"></i>Mã Giảm Giá (Voucher)</span>
                            <span class="hotkey-badge" role="button" onclick="focusCouponInput()">F8</span>
                        </div>
                        <div class="input-group">
                            <input type="text" id="couponCodeInput" class="form-control form-control-sm rounded-start-3 text-uppercase font-monospace" placeholder="Nhập mã voucher..." autocomplete="off" />
                            <button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-end-3" onclick="applyCoupon()">
                                Áp Dụng
                            </button>
                        </div>
                        <div id="appliedCouponBadge" class="mt-1.5 d-none">
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2 rounded-3 d-flex align-items-center justify-content-between">
                                <span><i class="fa-solid fa-check me-1"></i>Voucher: <strong id="appliedCouponCode"></strong> (<span id="appliedCouponDiscount"></span>)</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="removeCoupon()"><i class="fa-solid fa-xmark"></i></button>
                            </span>
                        </div>
                    </div>

                    <!-- 3. Financial Summary Breakdown -->
                    <div class="d-flex flex-column gap-1.5 mb-2">
                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Tổng tiền hàng:</span>
                            <span id="posSubTotal" class="font-monospace fw-semibold text-dark">0 đ</span>
                        </div>

                        <!-- Chiết khấu VIP (nếu có) -->
                        <div id="vipDiscountRow" class="d-none justify-content-between small text-purple-600" style="color: #7C3AED;">
                            <span>Chiết khấu hạng VIP (<span id="vipDiscountPercent">0%</span>):</span>
                            <span id="vipDiscountLabel" class="font-monospace font-semibold">-0 đ</span>
                        </div>

                        <!-- Chiết khấu voucher -->
                        <div class="d-flex justify-content-between align-items-center small text-secondary">
                            <span>Chiết khấu voucher:</span>
                            <span id="voucherDiscountLabel" class="font-monospace text-danger font-semibold">0 đ</span>
                        </div>

                        <!-- Cấn trừ điểm tích lũy -->
                        <div id="pointDiscountRow" class="d-none justify-content-between small text-success">
                            <span>Cấn trừ điểm Beauty Club:</span>
                            <span id="pointDiscountLabel" class="font-monospace font-semibold">-0 đ</span>
                        </div>

                        <!-- Chiết khấu đơn -->
                        <div class="d-flex justify-content-between align-items-center small text-secondary">
                            <span>Chiết khấu đơn (đ):</span>
                            <input type="number" id="orderDiscountInput" class="form-control form-control-sm text-end font-monospace w-50 rounded-3 py-0.5" value="0" min="0" step="5000" onchange="recalculateTotal()" />
                        </div>

                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Thuế VAT (10%):</span>
                            <span id="posVatAmount" class="font-monospace text-muted">0 đ</span>
                        </div>

                        <hr class="my-1" />

                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="h6 fw-bold text-dark mb-0">KHÁCH PHẢI TRẢ:</span>
                            <span id="posFinalTotal" class="h3 fw-bold text-danger font-monospace mb-0">0 đ</span>
                        </div>
                    </div>
                </div>

                <!-- 4. Fixed Bottom Action Buttons (F9 Checkout & F10 Print) -->
                <div class="pt-2 border-top flex-shrink-0 space-y-2">
                    <button type="button" 
                            id="btnCheckout" 
                            class="btn btn-gradient w-100 py-3 rounded-4 fs-5 d-flex align-items-center justify-content-center gap-2 shadow" 
                            onclick="openCheckoutModal()">
                        <i class="fa-solid fa-credit-card fs-5"></i>
                        <span>THANH TOÁN (F9)</span>
                    </button>

                    <div class="d-flex gap-2">
                        <button type="button" 
                                class="btn btn-sm btn-outline-secondary w-100 rounded-3 py-1.5 fw-semibold d-flex align-items-center justify-content-center gap-1.5" 
                                onclick="printLastReceipt()">
                            <i class="fa-solid fa-print text-danger"></i>
                            <span>In Hóa Đơn K80 (F10)</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- POS BOTTOM DOCK: FULL HOTKEY BAR F1 - F12 -->
<div class="pos-hotkey-dock bg-dark text-white px-3 py-1 d-flex align-items-center justify-content-between" style="height: 42px; border-top: 1px solid #334155; z-index: 105;">
    <div class="d-flex align-items-center gap-2 overflow-x-auto w-100" style="font-size: 11.5px;">
        <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-50 px-2 py-1.5 d-inline-flex align-items-center gap-1.5"><strong class="text-primary font-monospace">F1</strong> Quét Barcode</span>
        <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-50 px-2 py-1.5 d-inline-flex align-items-center gap-1.5"><strong class="text-primary font-monospace">F2</strong> Khách VIP</span>
        <span class="badge bg-secondary bg-opacity-25 text-white border border-secondary border-opacity-50 px-2 py-1.5 d-inline-flex align-items-center gap-1.5"><strong class="text-primary font-monospace">F3</strong> Tồn Kho Lô</span>
