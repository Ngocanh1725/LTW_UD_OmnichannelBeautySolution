<!-- Hidden Iframe For Silent Thermal Receipt Printing -->
<iframe id="receiptPrintFrame" style="display:none; width:0; height:0; border:0;"></iframe>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const storeId = '@(currentStore?.Id.ToString() ?? "1")';
        const cashierId = @cashierId;
        let currentShiftId = @(currentShift?.Id ?? 0);
        let cartItems = [];
        let customerInfo = null; // { userId, name, phone, tierName, points, skinType, vipDiscountRate }
        let appliedCoupon = null; // { code, discountAmount }
        let pointsToRedeem = 0;
        let selectedPaymentMethod = "CASH";
        let lastCompletedOrderId = null;
        let activeCatalogCategoryId = 0;

        // ==============================================================
        // 1. KEYBOARD SHORTCUTS HANDLER (F2, F4, F8, F9, F10)
        // ==============================================================
        window.addEventListener('keydown', function (e) {
            // F2: Tìm khách hàng thân thiết
            if (e.key === 'F2') {
                e.preventDefault();
                focusCustomerSearch();
            }
            // F4: Quét mã vạch GS1-128 / Tìm sản phẩm
            else if (e.key === 'F4') {
                e.preventDefault();
                focusBarcodeScanner();
            }
            // F8: Áp dụng mã giảm giá / Chiết khấu
            else if (e.key === 'F8') {
                e.preventDefault();
                focusCouponInput();
            }
            // F9: Thanh toán hóa đơn (Mở popup nhận tiền mặt / Thẻ / VietQR)
            else if (e.key === 'F9') {
                e.preventDefault();
                openCheckoutModal();
            }
            // F10: In lại hóa đơn gần nhất K80
            else if (e.key === 'F10') {
                e.preventDefault();
                printLastReceipt();
            }
            // Escape: Đóng modal
            else if (e.key === 'Escape') {
                const openModals = document.querySelectorAll('.modal.show');
                openModals.forEach(m => bootstrap.Modal.getInstance(m)?.hide());
            }
            // Enter trong checkout modal: Xác nhận thanh toán
            else if (e.key === 'Enter') {
                const checkoutModalEl = document.getElementById('checkoutPaymentModal');
                if (checkoutModalEl && checkoutModalEl.classList.contains('show')) {
                    // Nếu đang focus ở input tiền mặt, tránh duplicate
                    if (document.activeElement?.id === 'modalCashGivenInput') {
                        e.preventDefault();
                        submitFinalCheckout();
                    }
                }
            }
        });

        function focusBarcodeScanner() {
            const el = document.getElementById('barcodeScannerInput');
            el?.focus();
            el?.select();
        }

        function focusCustomerSearch() {
            const el = document.getElementById('custPhoneInput');
            el?.focus();
            el?.select();
        }

        function focusCouponInput() {
            const el = document.getElementById('couponCodeInput');
            el?.focus();
            el?.select();
        }

        // ==============================================================
        // 2. BARCODE LASER SCANNER AUTO-DETECTION
        // ==============================================================
        const barcodeInput = document.getElementById('barcodeScannerInput');

        // Bắt sự kiện Enter khi máy quét Laser quét mã
        barcodeInput.addEventListener('keypress', async function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const code = this.value.trim();
                if (!code) return;
                await processBarcodeScan(code);
            }
        });

        // Global Laser Scanner Interceptor: Nếu thu ngân quét mã khi chưa focus vào ô nhập
        let laserBuffer = '';
        let lastKeyTime = Date.now();
        window.addEventListener('keydown', async function (e) {
            // Không can thiệp nếu đang nhập trong modal hoặc ô text khác (ngoại trừ ô barcode)
            const targetTag = e.target.tagName;
            const isInputTarget = targetTag === 'INPUT' || targetTag === 'TEXTAREA';
            if (isInputTarget && e.target.id !== 'barcodeScannerInput') {
                return;
            }

            const now = Date.now();
            const timeDiff = now - lastKeyTime;
            lastKeyTime = now;

            // Máy quét laser vật lý nhập ký tự cực nhanh (< 50ms)
            if (e.key === 'Enter') {
                if (laserBuffer.length >= 3 && timeDiff < 100) {
                    e.preventDefault();
                    const scannedCode = laserBuffer.trim();
                    laserBuffer = '';
                    await processBarcodeScan(scannedCode);
                } else {
                    laserBuffer = '';
                }
            } else if (e.key.length === 1) {
                if (timeDiff > 120) {
                    laserBuffer = ''; // Quá chậm -> người gõ bình thường
                }
                laserBuffer += e.key;
            }
        });

        async function processBarcodeScan(code) {
            try {
                const res = await fetch(`/Admin/Pos/ScanBarcode?storeId=${storeId}&barcode=${encodeURIComponent(code)}`);
                const data = await res.json();
                if (data.success && data.product) {
                    playScanBeep();
                    addProductToCart(data.product);
                    barcodeInput.value = '';
                    barcodeInput.focus();
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Không tìm thấy sản phẩm',
                        text: data.message || `Mã barcode '${code}' không tồn tại trong hệ thống.`,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    barcodeInput.value = '';
                    barcodeInput.focus();
                }
            } catch (err) {
                console.error(err);
                barcodeInput.value = '';
            }
        }

        // ==============================================================
        // 3. KEYWORD SEARCH WITH DEBOUNCE
        // ==============================================================
        let searchTimeout = null;
        const searchInput = document.getElementById('keywordSearchInput');
        const searchDropdown = document.getElementById('searchDropdown');
        const searchSpinner = document.getElementById('searchLoadingSpinner');

        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            const kw = this.value.trim();
            if (kw.length < 2) {
                searchDropdown.classList.add('d-none');
                return;
            }

            searchSpinner.classList.remove('d-none');
            searchTimeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/Admin/Pos/SearchProducts?storeId=${storeId}&keyword=${encodeURIComponent(kw)}`);
                    const products = await res.json();
                    renderSearchResults(products);
                } catch (err) {
                    console.error(err);
                } finally {
                    searchSpinner.classList.add('d-none');
                }
            }, 350);
        });

        function renderSearchResults(products) {
            searchDropdown.innerHTML = '';
            if (!products || products.length === 0) {
                searchDropdown.innerHTML = '<div class="p-3 text-center text-muted small">Không tìm thấy sản phẩm phù hợp.</div>';
                searchDropdown.classList.remove('d-none');
                return;
            }

            products.forEach(p => {
                const itemDiv = document.createElement('div');
                itemDiv.className = 'd-flex align-items-center justify-content-between p-2 rounded-3 hover-bg cursor-pointer border-bottom';
                itemDiv.style.cursor = 'pointer';
                itemDiv.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <img src="${p.imageUrl || '/images/products/_placeholder.webp'}" class="rounded-2" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.src='/images/products/_placeholder.webp';" />
                        <div>
                            <div class="fw-semibold text-dark small text-truncate" style="max-width: 200px;">${p.name}</div>
                            <div class="text-muted font-monospace" style="font-size: 11px;">SKU: ${p.sku} | Tồn: <span class="${p.availableQuantity > 0 ? 'text-success fw-bold' : 'text-danger fw-bold'}">${p.availableQuantity}</span></div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold font-monospace text-danger small">${Number(p.finalPrice).toLocaleString('vi-VN')} đ</div>
                        <button type="button" class="btn btn-xs btn-primary py-0 px-2 rounded-pill" style="font-size: 11px;">+ Thêm</button>
                    </div>
                `;
                itemDiv.onclick = () => {
                    playScanBeep();
                    addProductToCart(p);
                    searchInput.value = '';
                    searchDropdown.classList.add('d-none');
                    barcodeInput.focus();
                };
                searchDropdown.appendChild(itemDiv);
            });
            searchDropdown.classList.remove('d-none');
        }

        document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                searchDropdown.classList.add('d-none');
            }
        });

        // ==============================================================
        // 4. VISUAL PRODUCT CATALOG & QUICK-PICK GRID
        // ==============================================================
        async function loadVisualCatalog(categoryId = 0) {
            activeCatalogCategoryId = categoryId;
            const grid = document.getElementById('catalogProductGrid');
            grid.innerHTML = '<div class="col-12 text-center py-4 text-muted"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải sản phẩm...</div>';

            try {
                const res = await fetch(`/Admin/Pos/GetVisualCatalog?storeId=${storeId}&categoryId=${categoryId}`);
                const data = await res.json();
                if (data.success && data.products) {
                    renderCatalogProducts(data.products);
                } else {
                    grid.innerHTML = '<div class="col-12 text-center py-4 text-muted">Không có sản phẩm nào trong danh mục này.</div>';
                }
            } catch (err) {
                console.error(err);
                grid.innerHTML = '<div class="col-12 text-center py-4 text-danger">Lỗi tải danh mục. Vui lòng thử lại.</div>';
            }
        }

        function filterCatalogByCategory(catId) {
            document.querySelectorAll('.category-pill').forEach(btn => {
                if (Number(btn.dataset.catId) === Number(catId)) {
                    btn.classList.add('btn-dark', 'active');
                    btn.classList.remove('btn-light');
                } else {
                    btn.classList.remove('btn-dark', 'active');
                    btn.classList.add('btn-light');
                }
            });
            loadVisualCatalog(catId);
        }

        function renderCatalogProducts(products) {
            const grid = document.getElementById('catalogProductGrid');
            grid.innerHTML = '';

            if (!products || products.length === 0) {
                grid.innerHTML = '<div class="col-12 text-center py-4 text-muted">Không có sản phẩm nào hiển thị.</div>';
                return;
            }

            products.forEach(p => {
                const col = document.createElement('div');
                col.className = 'col';

                const isOutOfStock = p.availableQuantity <= 0;
                col.innerHTML = `
                    <div class="card h-100 border rounded-3 p-2 text-center product-quick-card transition ${isOutOfStock ? 'opacity-50' : 'cursor-pointer'}" 
                         style="transition: all 0.2s; ${isOutOfStock ? '' : 'cursor: pointer;'}"
                         title="${p.name} - SKU: ${p.sku}">
                        <div class="position-relative mb-1.5 overflow-hidden rounded-2 bg-light" style="height: 80px;">
                            <img src="${p.imageUrl || '/images/products/_placeholder.webp'}" 
                                 class="w-100 h-100 object-fit-cover" 
                                 onerror="this.src='https://placehold.co/100x100?text=SP';" />
                            <span class="position-absolute top-0 end-0 badge ${isOutOfStock ? 'bg-danger' : 'bg-success'} m-1" style="font-size: 9px;">
                                ${isOutOfStock ? 'Hết hàng' : 'Tồn ' + p.availableQuantity}
                            </span>
                        </div>
                        <div class="fw-bold text-dark text-truncate small mb-1" style="font-size: 11.5px;">${p.name}</div>
                        <div class="text-danger font-monospace fw-bold small" style="font-size: 12px;">
                            ${Number(p.finalPrice).toLocaleString('vi-VN')} đ
                        </div>
                    </div>
                `;

                if (!isOutOfStock) {
                    col.querySelector('.product-quick-card').onclick = () => {
                        playScanBeep();
                        addProductToCart(p);
                        barcodeInput.focus();
                    };
                }

                grid.appendChild(col);
            });
        }

        // Chuyển đổi chế độ xem (Split, Cart Only, Catalog Only)
        function switchPosView(mode) {
            const cartSec = document.getElementById('cartSection');
            const catalogSec = document.getElementById('catalogSection');
            const btnSplit = document.getElementById('btnViewSplit');
            const btnCart = document.getElementById('btnViewCart');
            const btnCatalog = document.getElementById('btnViewCatalog');

            [btnSplit, btnCart, btnCatalog].forEach(b => b.classList.remove('active'));

            if (mode === 'split') {
                btnSplit.classList.add('active');
                cartSec.classList.remove('d-none');
                catalogSec.classList.remove('d-none');
                cartSec.style.flex = '1 1 55%';
                catalogSec.style.flex = '1 1 45%';
            } else if (mode === 'cart') {
                btnCart.classList.add('active');
                cartSec.classList.remove('d-none');
                catalogSec.classList.add('d-none');
                cartSec.style.flex = '1 1 100%';
            } else if (mode === 'catalog') {
                btnCatalog.classList.add('active');
                cartSec.classList.add('d-none');
                catalogSec.classList.remove('d-none');
                catalogSec.style.flex = '1 1 100%';
            }
        }

        // ==============================================================
        // 5. CART OPERATIONS & REALTIME CALCULATIONS
        // ==============================================================
        function addProductToCart(p) {
            if (p.availableQuantity <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Hết hàng khả dụng',
                    text: `Sản phẩm '${p.name}' hiện tại đã hết tồn kho tại chi nhánh này.`,
                    timer: 2000,
                    showConfirmButton: false
                });
                return;
            }

            const existing = cartItems.find(i => i.productId === p.productId);
            if (existing) {
                if (existing.quantity + 1 > p.availableQuantity) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vượt tồn kho',
                        text: `Chỉ còn ${p.availableQuantity} sản phẩm khả dụng trong kho.`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    return;
                }
                existing.quantity += 1;
                existing.lineTotal = Math.round(existing.unitPrice * existing.quantity * (1 - existing.discountRate / 100));
            } else {
                cartItems.push({
                    productId: p.productId,
                    barcode: p.barcode,
                    sku: p.sku,
                    productName: p.name,
                    unitPrice: p.finalPrice || p.sellingPrice,
                    availableQuantity: p.availableQuantity,
                    quantity: 1,
                    discountRate: 0,
                    lineTotal: p.finalPrice || p.sellingPrice
                });
            }

            renderCartTable();
        }

        function renderCartTable() {
            const tbody = document.getElementById('posCartTbody');
            const emptyNotice = document.getElementById('emptyCartNotice');
            tbody.innerHTML = '';

            if (cartItems.length === 0) {
                emptyNotice.classList.remove('d-none');
            } else {
                emptyNotice.classList.add('d-none');
                cartItems.forEach((item, idx) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="px-3 font-monospace text-secondary">${idx + 1}</td>
                        <td>
                            <div class="fw-bold text-dark text-truncate" style="max-width: 230px;" title="${item.productName}">${item.productName}</div>
                            <div class="d-flex align-items-center gap-1.5 mt-1 flex-wrap">
                                <span class="text-secondary font-monospace" style="font-size: 11px;">SKU: ${item.sku}</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace py-0.5 px-1.5" style="font-size: 10px;">
                                    <i class="fa-solid fa-boxes-stacked me-1"></i>Lô: ${item.batchCode || 'VT02-202409-B1'}
                                </span>
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace py-0.5 px-1.5" style="font-size: 10px;">
                                    <i class="fa-regular fa-calendar-check me-1"></i>HSD: ${item.expiryDate || '15/09/2026'}
                                </span>
                            </div>
                        </td>
                        <td class="text-end font-monospace">${Number(item.unitPrice).toLocaleString('vi-VN')} đ</td>
                        <td>
                            <div class="input-group input-group-sm justify-content-center">
                                <button type="button" class="btn btn-outline-secondary px-2" onclick="changeQty(${idx}, -1)">-</button>
                                <input type="number" class="form-control text-center font-monospace px-1" style="max-width: 50px;" value="${item.quantity}" min="1" max="${item.availableQuantity}" onchange="setQty(${idx}, this.value)" />
                                <button type="button" class="btn btn-outline-secondary px-2" onclick="changeQty(${idx}, 1)">+</button>
                            </div>
                        </td>
                        <td class="text-end px-3 font-monospace fw-bold text-dark">${Number(item.lineTotal).toLocaleString('vi-VN')} đ</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removeItem(${idx})">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            const totalQty = cartItems.reduce((sum, i) => sum + i.quantity, 0);
            const totalLines = cartItems.length;
            document.getElementById('cartItemCount').innerText = totalLines;
            document.getElementById('cartTotalQty').innerText = totalQty;
            document.getElementById('cartItemBadge').innerText = totalLines;

            recalculateTotal();
        }

        function changeQty(index, delta) {
            const item = cartItems[index];
            const newQty = item.quantity + delta;
            if (newQty <= 0) {
                removeItem(index);
                return;
            }
            if (newQty > item.availableQuantity) {
                Swal.fire({ icon: 'warning', title: 'Vượt tồn kho', text: `Chỉ còn ${item.availableQuantity} sản phẩm trong kho.`, timer: 1200, showConfirmButton: false });
                return;
            }
            item.quantity = newQty;
            item.lineTotal = Math.round(item.unitPrice * item.quantity * (1 - item.discountRate / 100));
            renderCartTable();
        }

        function setQty(index, val) {
            const item = cartItems[index];
            let q = parseInt(val) || 1;
            if (q <= 0) q = 1;
            if (q > item.availableQuantity) {
                q = item.availableQuantity;
                Swal.fire({ icon: 'warning', title: 'Vượt tồn kho', text: `Chỉ còn ${item.availableQuantity} sản phẩm.`, timer: 1200, showConfirmButton: false });
            }
            item.quantity = q;
            item.lineTotal = Math.round(item.unitPrice * item.quantity * (1 - item.discountRate / 100));
            renderCartTable();
        }

        function removeItem(index) {
            cartItems.splice(index, 1);
            renderCartTable();
        }

        function clearCart() {
            if (cartItems.length === 0) return;
            cartItems = [];
            appliedCoupon = null;
            pointsToRedeem = 0;
            document.getElementById('appliedCouponBadge').classList.add('d-none');
            document.getElementById('orderDiscountInput').value = 0;
            document.getElementById('chkUsePoints').checked = false;
            document.getElementById('pointRedeemInputs').classList.add('d-none');
            renderCartTable();
        }

        // ==============================================================
        // 6. FINANCIAL CALCULATIONS & LOYALTY POINTS REDEMPTION
        // ==============================================================
        function recalculateTotal() {
            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);

            // Chiết khấu VIP (nếu có VIP discount rate)
            let vipDiscount = 0;
            if (customerInfo && customerInfo.vipDiscountRate > 0) {
                vipDiscount = Math.round(subTotal * (customerInfo.vipDiscountRate / 100));
                document.getElementById('vipDiscountRow').classList.remove('d-none');
                document.getElementById('vipDiscountRow').classList.add('d-flex');
                document.getElementById('vipDiscountPercent').innerText = customerInfo.vipDiscountRate + '%';
                document.getElementById('vipDiscountLabel').innerText = '-' + Number(vipDiscount).toLocaleString('vi-VN') + ' đ';
            } else {
                document.getElementById('vipDiscountRow').classList.add('d-none');
                document.getElementById('vipDiscountRow').classList.remove('d-flex');
            }

            // Chiết khấu voucher
            const voucherDiscount = appliedCoupon ? appliedCoupon.discountAmount : 0;

            // Cấn trừ điểm tích lũy
            const pointDiscount = pointsToRedeem * 1000;
            if (pointDiscount > 0) {
                document.getElementById('pointDiscountRow').classList.remove('d-none');
                document.getElementById('pointDiscountRow').classList.add('d-flex');
                document.getElementById('pointDiscountLabel').innerText = '-' + Number(pointDiscount).toLocaleString('vi-VN') + ' đ';
            } else {
                document.getElementById('pointDiscountRow').classList.add('d-none');
                document.getElementById('pointDiscountRow').classList.remove('d-flex');
            }

            // Chiết khấu đơn thủ công
            const orderDiscount = Number(document.getElementById('orderDiscountInput').value) || 0;

            const totalDiscounts = vipDiscount + voucherDiscount + pointDiscount + orderDiscount;
            const finalTotal = Math.max(0, subTotal - totalDiscounts);
            const vatAmount = Math.round(finalTotal - (finalTotal / 1.1));

            document.getElementById('posSubTotal').innerText = Number(subTotal).toLocaleString('vi-VN') + ' đ';
            document.getElementById('cartSubTotalBottom').innerText = Number(subTotal).toLocaleString('vi-VN') + ' đ';
            document.getElementById('voucherDiscountLabel').innerText = '-' + Number(voucherDiscount).toLocaleString('vi-VN') + ' đ';
            document.getElementById('posVatAmount').innerText = Number(vatAmount).toLocaleString('vi-VN') + ' đ';
            document.getElementById('posFinalTotal').innerText = Number(finalTotal).toLocaleString('vi-VN') + ' đ';
        }

        function getFinalTotalNumber() {
            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            let vipDiscount = 0;
            if (customerInfo && customerInfo.vipDiscountRate > 0) {
                vipDiscount = Math.round(subTotal * (customerInfo.vipDiscountRate / 100));
            }
            const voucherDiscount = appliedCoupon ? appliedCoupon.discountAmount : 0;
            const pointDiscount = pointsToRedeem * 1000;
            const orderDiscount = Number(document.getElementById('orderDiscountInput').value) || 0;
            return Math.max(0, subTotal - vipDiscount - voucherDiscount - pointDiscount - orderDiscount);
        }

        // ==============================================================
        // 7. CUSTOMER SEARCH & LOYALTY (F4)
        // ==============================================================
        async function searchCustomer() {
            const kw = document.getElementById('custPhoneInput').value.trim();
            if (!kw) {
                Swal.fire({ icon: 'warning', title: 'Chưa nhập số điện thoại', text: 'Vui lòng nhập số điện thoại để tra cứu hồ sơ khách hàng.' });
                return;
            }

            try {
                const res = await fetch(`/Admin/Pos/LookupCustomer?keyword=${encodeURIComponent(kw)}`);
                const data = await res.json();
                if (data.success && data.data) {
                    customerInfo = data.data;
                    document.getElementById('custNameLabel').innerText = customerInfo.name + (customerInfo.phone ? ` (${customerInfo.phone})` : '');
                    document.getElementById('custTierBadge').innerText = customerInfo.tierName + ' Member';
                    document.getElementById('custPointsLabel').innerText = '⭐ ' + Number(customerInfo.points).toLocaleString('vi-VN') + ' pts';
                    document.getElementById('custSkinLabel').innerText = 'Làn da: ' + (customerInfo.skinType || 'Bình thường');
                    document.getElementById('customerInfoCard').classList.remove('d-none');

                    // Reset points redeem
                    document.getElementById('chkUsePoints').checked = false;
                    document.getElementById('pointRedeemInputs').classList.add('d-none');
                    pointsToRedeem = 0;

                    recalculateTotal();

                    Swal.fire({
                        icon: 'success',
                        title: 'Đã nhận diện khách hàng!',
                        html: `<b>${customerInfo.name}</b><br/>Hạng thẻ: <strong>${customerInfo.tierName}</strong> • Khả dụng: <strong>${customerInfo.points} điểm</strong>`,
                        timer: 1600,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Không tìm thấy khách hàng',
                        text: data.message || 'Không có hồ sơ khớp với số điện thoại này trong hệ thống.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
            } catch (err) {
                console.error(err);
            }
        }

        function resetCustomer() {
            customerInfo = null;
            pointsToRedeem = 0;
            document.getElementById('custPhoneInput').value = '';
            document.getElementById('customerInfoCard').classList.add('d-none');
            document.getElementById('chkUsePoints').checked = false;
            document.getElementById('pointRedeemInputs').classList.add('d-none');
            recalculateTotal();
        }

        function toggleUsePoints() {
            const chk = document.getElementById('chkUsePoints');
            const inputs = document.getElementById('pointRedeemInputs');
            if (chk.checked && customerInfo && customerInfo.points > 0) {
                inputs.classList.remove('d-none');
                setMaxRedeemPoints();
            } else {
                inputs.classList.add('d-none');
                pointsToRedeem = 0;
                document.getElementById('inputRedeemPoints').value = 0;
                document.getElementById('pointDiscountText').innerText = '-0 đ';
                recalculateTotal();
            }
        }

        function setMaxRedeemPoints() {
            if (!customerInfo) return;
            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            const maxPointsByBill = Math.floor(subTotal / 1000);
            const allowablePoints = Math.min(customerInfo.points, maxPointsByBill);

            document.getElementById('inputRedeemPoints').value = allowablePoints;
            pointsToRedeem = allowablePoints;
            document.getElementById('pointDiscountText').innerText = '-' + Number(allowablePoints * 1000).toLocaleString('vi-VN') + ' đ';
            recalculateTotal();
        }

        function onRedeemPointsChanged() {
            if (!customerInfo) return;
            let val = parseInt(document.getElementById('inputRedeemPoints').value) || 0;
            if (val < 0) val = 0;
            if (val > customerInfo.points) val = customerInfo.points;

            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            const maxPointsByBill = Math.floor(subTotal / 1000);
            if (val > maxPointsByBill) val = maxPointsByBill;

            document.getElementById('inputRedeemPoints').value = val;
            pointsToRedeem = val;
            document.getElementById('pointDiscountText').innerText = '-' + Number(val * 1000).toLocaleString('vi-VN') + ' đ';
            recalculateTotal();
        }

        // ==============================================================
        // 8. VOUCHER / COUPON ENGINE (F8)
        // ==============================================================
        async function applyCoupon() {
            const code = document.getElementById('couponCodeInput').value.trim();
            if (!code) {
                Swal.fire({ icon: 'warning', title: 'Thiếu mã voucher', text: 'Vui lòng nhập mã voucher.' });
                return;
            }

            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            try {
                const res = await fetch('/Admin/Pos/ApplyCoupon', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        couponCode: code,
                        subTotal: subTotal,
                        userId: customerInfo ? customerInfo.userId : null
                    })
                });

                const data = await res.json();
                if (data.success) {
                    appliedCoupon = {
                        code: data.couponCode,
                        discountAmount: data.discountAmount
                    };
                    document.getElementById('appliedCouponCode').innerText = data.couponCode;
                    document.getElementById('appliedCouponDiscount').innerText = '-' + Number(data.discountAmount).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('appliedCouponBadge').classList.remove('d-none');
                    document.getElementById('couponCodeInput').value = '';
                    recalculateTotal();
                    Swal.fire({ icon: 'success', title: 'Áp dụng voucher thành công!', text: data.message, timer: 1500, showConfirmButton: false });
                } else {
                    Swal.fire({ icon: 'error', title: 'Không thể áp dụng', text: data.message });
                }
            } catch (err) {
                console.error(err);
            }
        }

        function removeCoupon() {
            appliedCoupon = null;
            document.getElementById('appliedCouponBadge').classList.add('d-none');
            recalculateTotal();
        }

        // ==============================================================
        // 9. CHECKOUT PAYMENT MODAL (F9)
        // ==============================================================
        function openCheckoutModal() {
            if (cartItems.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Giỏ hàng đang trống',
                    text: 'Vui lòng quét ít nhất một mỹ phẩm vào đơn trước khi mở thanh toán.'
                });
                return;
            }

            const finalTotal = getFinalTotalNumber();
            document.getElementById('modalPayableAmount').innerText = Number(finalTotal).toLocaleString('vi-VN') + ' đ';
            document.getElementById('modalCustomerName').innerText = customerInfo ? `${customerInfo.name} (${customerInfo.phone || ''})` : 'Khách lẻ tại quầy';

            // Auto-fill cash given
            const cashInput = document.getElementById('modalCashGivenInput');
            cashInput.value = finalTotal;
            recalculateModalChange();

            // Setup default payment tab
            setPaymentMethod(selectedPaymentMethod);

            const modal = new bootstrap.Modal(document.getElementById('checkoutPaymentModal'));
            modal.show();

            setTimeout(() => {
                cashInput.focus();
                cashInput.select();
            }, 300);
        }

        function setPaymentMethod(method) {
            selectedPaymentMethod = method;
            const finalTotal = getFinalTotalNumber();

            if (method === 'VIETQR') {
                const bankId = "MB";
                const accountNo = "0909999888";
                const accountName = "OMNICHANNEL BEAUTY";
                const qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-compact2.png?amount=${finalTotal}&addInfo=POS-${storeId}&accountName=${encodeURIComponent(accountName)}`;
                document.getElementById('modalQrImage').src = qrUrl;
            }
        }

        function recalculateModalChange() {
            const finalTotal = getFinalTotalNumber();
            const cashGiven = Number(document.getElementById('modalCashGivenInput').value) || 0;
            const change = Math.max(0, cashGiven - finalTotal);
            document.getElementById('modalChangeAmount').innerText = Number(change).toLocaleString('vi-VN') + ' đ';
        }

        function setModalExactCash() {
            document.getElementById('modalCashGivenInput').value = getFinalTotalNumber();
            recalculateModalChange();
        }

        function addModalCash(amt) {
            const input = document.getElementById('modalCashGivenInput');
            input.value = (Number(input.value) || 0) + amt;
            recalculateModalChange();
        }

        async function submitFinalCheckout() {
            const finalTotal = getFinalTotalNumber();
            const cashGiven = Number(document.getElementById('modalCashGivenInput').value) || 0;

            if (selectedPaymentMethod === 'CASH' && cashGiven < finalTotal) {
                Swal.fire({
                    icon: 'error',
                    title: 'Tiền khách đưa chưa đủ',
                    text: `Cần thanh toán ${finalTotal.toLocaleString('vi-VN')} đ, khách mới đưa ${cashGiven.toLocaleString('vi-VN')} đ.`
                });
                return;
            }

            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            let vipDiscount = 0;
            if (customerInfo && customerInfo.vipDiscountRate > 0) {
                vipDiscount = Math.round(subTotal * (customerInfo.vipDiscountRate / 100));
            }
            const voucherDiscount = appliedCoupon ? appliedCoupon.discountAmount : 0;
            const pointDiscount = pointsToRedeem * 1000;
            const orderDiscount = Number(document.getElementById('orderDiscountInput').value) || 0;
            const totalDiscounts = vipDiscount + voucherDiscount + pointDiscount + orderDiscount;

            const payload = {
                storeId: storeId,
                posShiftId: currentShiftId > 0 ? currentShiftId : null,
                customerName: customerInfo ? customerInfo.name : 'Khách lẻ tại quầy',
                customerPhone: customerInfo ? customerInfo.phone : (document.getElementById('custPhoneInput').value.trim() || null),
                customerUserId: customerInfo ? customerInfo.userId : null,
                couponCode: appliedCoupon ? appliedCoupon.code : null,
                items: cartItems.map(i => ({
                    productId: i.productId,
                    quantity: i.quantity,
                    unitPrice: i.unitPrice,
                    discountAmount: Math.round(i.unitPrice * i.quantity * (i.discountRate / 100))
                })),
                discountAmount: totalDiscounts,
                pointsToRedeem: pointsToRedeem,
                pointDiscountAmount: pointDiscount,
                vipDiscountAmount: vipDiscount,
                paymentMethod: selectedPaymentMethod,
                amountReceived: selectedPaymentMethod === 'CASH' ? cashGiven : finalTotal
            };

            const btn = document.getElementById('btnConfirmPayment');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>ĐANG XỬ LÝ...';

            try {
                const res = await fetch('/Admin/Pos/Checkout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    playSuccessChime();
                    lastCompletedOrderId = data.orderId;

                    // Close checkout modal
                    const modalEl = document.getElementById('checkoutPaymentModal');
                    bootstrap.Modal.getInstance(modalEl)?.hide();

                    // Print thermal receipt if checked (F10)
                    if (document.getElementById('chkAutoPrintK80').checked) {
                        printK80Receipt(data.orderId);
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Thanh Toán Thành Công!',
                        html: `
                            <div class="font-monospace small">
                                <div>Mã hóa đơn: <strong class="text-primary">${data.orderId}</strong></div>
                                <div>Tổng thu: <strong class="text-danger fs-5">${Number(data.totalAmount).toLocaleString('vi-VN')} đ</strong></div>
                                <div>Mã tra cứu HĐĐT: <strong>${data.taxLookupCode}</strong></div>
                            </div>
                        `,
                        confirmButtonText: 'Đơn Hàng Tiếp Theo',
                        confirmButtonColor: '#10B981'
                    });

                    // Reset form state for next order
                    cartItems = [];
                    appliedCoupon = null;
                    pointsToRedeem = 0;
                    document.getElementById('appliedCouponBadge').classList.add('d-none');
                    document.getElementById('orderDiscountInput').value = 0;
                    resetCustomer();
                    renderCartTable();
                    focusBarcodeScanner();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thanh toán không thành công',
                        text: data.message
                    });
                }
            } catch (err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi xử lý thanh toán',
                    text: 'Không thể kết nối đến máy chủ POS.'
                });
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-circle-check me-1.5"></i>Hoàn Tất Thanh Toán (Enter)';
            }
        }

        // ==============================================================
        // 10. PRINT K80 THERMAL RECEIPT (F10)
        // ==============================================================
        function printK80Receipt(orderId) {
            if (!orderId) return;
            const printFrame = document.getElementById('receiptPrintFrame');
            printFrame.src = `/Admin/Pos/PrintReceipt?orderId=${encodeURIComponent(orderId)}`;
        }

        function printLastReceipt() {
            if (lastCompletedOrderId) {
                printK80Receipt(lastCompletedOrderId);
            } else if (cartItems.length > 0) {
                openCheckoutModal();
            } else {
                Swal.fire({
                    icon: 'info',
                    title: 'Chưa có hóa đơn gần nhất',
                    text: 'Vui lòng hoàn tất thanh toán đơn hàng trước khi in hóa đơn K80.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
        }

        // ==============================================================
        // 11. SHIFT MANAGEMENT
        // ==============================================================
        function openOpenShiftModal() {
            const modal = new bootstrap.Modal(document.getElementById('openShiftModal'));
            modal.show();
        }

        async function submitOpenShift() {
            const opening = Number(document.getElementById('openingBalanceInput').value) || 0;
            try {
                const res = await fetch('/Admin/Pos/OpenShift', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ storeId: parseInt(storeId), openingBalance: opening })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi mở ca', text: data.message });
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function openCloseShiftModal() {
            try {
                const res = await fetch(`/Admin/Pos/GetShiftStatus?storeId=${storeId}`);
                const data = await res.json();
                if (data.hasOpenShift && data.shift) {
                    const s = data.shift;
                    document.getElementById('closeShiftCode').innerText = s.shiftCode;
                    document.getElementById('closeShiftOpening').innerText = Number(s.openingBalance).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('closeShiftCashSales').innerText = Number(s.cashSales).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('closeShiftCashIn').innerText = '+' + Number(s.cashIn || 0).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('closeShiftCashOut').innerText = '-' + Number(s.cashOut || 0).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('closeShiftCardSales').innerText = Number(s.cardSales).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('closeShiftExpected').innerText = Number(s.expectedCash).toLocaleString('vi-VN') + ' đ';
                    document.getElementById('actualCashInput').value = s.expectedCash;
                    calcShiftDiff();

                    const modal = new bootstrap.Modal(document.getElementById('closeShiftModal'));
                    modal.show();
                }
            } catch (e) {
                console.error(e);
            }
        }

        function openDrawerModal() {
            const modal = new bootstrap.Modal(document.getElementById('drawerTransactionModal'));
            modal.show();
        }

        async function submitDrawerTransaction() {
            const txType = document.getElementById('drawerTxType').value;
            const amt = Number(document.getElementById('drawerTxAmount').value) || 0;
            const reason = document.getElementById('drawerTxReason').value.trim();

            if (amt <= 0) {
                Swal.fire({ icon: 'warning', title: 'Số tiền không hợp lệ', text: 'Vui lòng nhập số tiền lớn hơn 0.' });
                return;
            }
            if (!reason) {
                Swal.fire({ icon: 'warning', title: 'Thiếu lý do', text: 'Vui lòng nhập lý do giao dịch két tiền.' });
                return;
            }

            try {
                const res = await fetch('/Admin/Pos/AddDrawerTransaction', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        type: txType,
                        amount: amt,
                        reason: reason
                    })
                });
                const data = await res.json();
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('drawerTransactionModal'))?.hide();
                    Swal.fire({ icon: 'success', title: 'Thành công', text: data.message });
                    document.getElementById('drawerTxReason').value = '';
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                }
            } catch (e) {
                console.error(e);
            }
        }

        function calcShiftDiff() {
            const exp = parseInt(document.getElementById('closeShiftExpected').innerText.replace(/\D/g, '')) || 0;
            const act = Number(document.getElementById('actualCashInput').value) || 0;
            const diff = act - exp;
            const label = document.getElementById('shiftDiffLabel');
            if (diff === 0) {
                label.innerText = '0 đ (Khớp két 100%)';
                label.className = 'text-success';
            } else if (diff > 0) {
                label.innerText = `+${Number(diff).toLocaleString('vi-VN')} đ (Thừa)`;
                label.className = 'text-primary';
            } else {
                label.innerText = `${Number(diff).toLocaleString('vi-VN')} đ (Thiếu)`;
                label.className = 'text-danger';
            }
        }

        async function submitCloseShift() {
            const act = Number(document.getElementById('actualCashInput').value) || 0;
            const note = document.getElementById('closeShiftNote').value.trim();
            try {
                const res = await fetch('/Admin/Pos/CloseShift', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        shiftId: currentShiftId,
                        actualCash: act,
                        note: note
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi chốt ca', text: data.message });
                }
            } catch (e) {
                console.error(e);
            }
        }

        // ==============================================================
        // 12. INITIALIZATION ON DOM READY
        // ==============================================================
