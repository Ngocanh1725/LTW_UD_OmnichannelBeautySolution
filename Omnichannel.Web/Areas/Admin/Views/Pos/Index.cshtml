                    document.getElementById('closeShiftCashSales').innerText = '500.000 đ';
                    document.getElementById('closeShiftCashIn').innerText = '+0 đ';
                    document.getElementById('closeShiftCashOut').innerText = '-0 đ';
                    document.getElementById('closeShiftCardSales').innerText = '1.168.750 đ';
                    document.getElementById('closeShiftExpected').innerText = '1.500.000 đ';
                    document.getElementById('actualCashInput').value = '1450000';
                    document.getElementById('closeShiftNote').value = 'Thối nhầm tiền lẻ 50k cho khách đơn POS-002 lúc 11h15';
                    calcShiftDiff();

                    const modalEl = document.getElementById('closeShiftModal');
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
