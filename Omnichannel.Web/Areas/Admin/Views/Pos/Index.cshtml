@{
    ViewData["Title"] = "Quầy Thu Ngân Bán Lẻ";
    Layout = "_PosLayout";
}

<!-- Header Điều Hành Quầy & Phím Tắt -->
<header class="pos-header d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <a href="/Admin/Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i>Về Quản Trị
        </a>
        <span class="fw-bold text-dark fs-5">
            <i class="fa-solid fa-cash-register me-2 text-primary"></i>Omnichannel POS
        </span>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
            <i class="fa-solid fa-shop me-1"></i>@ViewBag.CurrentStore.StoreName
        </span>
    </div>

    <!-- Hướng Dẫn Phím Tắt Nhanh F1 - F10 -->
    <div class="d-none d-xl-flex align-items-center gap-3 small text-muted">
        <span><span class="hotkey-badge">F1</span> Quét Barcode</span>
        <span><span class="hotkey-badge">F2</span> Khách hàng</span>
        <span><span class="hotkey-badge">F9</span> VietQR</span>
        <span><span class="hotkey-badge">F10</span> Thanh toán</span>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="small text-secondary"><i class="fa-solid fa-user-check text-success me-1"></i>@ViewBag.CashierName</span>
    </div>
</header>

<!-- Không Gian Làm Việc 2 Cột -->
<div class="container-fluid pos-workspace p-3">
    <div class="row h-100 g-3">
        <!-- Cột Trái: Quét Barcode & Danh Sách Hàng Đã Quét -->
        <div class="col-lg-8 d-flex flex-column h-100">
            <!-- Ô Quét Mã Vạch Barcode / Tìm Kiếm -->
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
                <div class="row g-2">
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-barcode text-primary fs-5"></i></span>
                            <input type="text" id="barcodeScannerInput" class="form-control form-control-lg bg-light border-0 fs-6 font-monospace" placeholder="Quét mã Barcode hoặc nhập mã SKU rồi bấm Enter (F1)..." autofocus autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-magnifying-glass text-secondary"></i></span>
                            <input type="text" id="keywordSearchInput" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="Tìm theo tên mỹ phẩm..." autocomplete="off" />
                        </div>
                        <div id="searchDropdown" class="position-absolute bg-white shadow-lg rounded-4 mt-1 border p-2 d-none" style="z-index: 1050; width: 380px; max-height: 280px; overflow-y: auto;"></div>
                    </div>
                </div>
            </div>

            <!-- Bảng Hóa Đơn Quầy (Giỏ Hàng POS) -->
            <div class="card border-0 shadow-sm rounded-4 flex-grow-1 bg-white overflow-hidden d-flex flex-column">
                <div class="table-responsive flex-grow-1">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light sticky-top">
                            <tr class="small text-secondary">
                                <th class="py-3 px-3">#</th>
                                <th class="py-3">Mỹ phẩm / Lô Date</th>
                                <th class="py-3 text-end">Đơn giá</th>
                                <th class="py-3 text-center" style="width: 150px;">Số lượng</th>
                                <th class="py-3 text-center" style="width: 90px;">% Giảm</th>
                                <th class="py-3 text-end px-3">Thành tiền</th>
                                <th class="py-3 text-center" style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="posCartTbody">
                            <!-- JS tự render các dòng sản phẩm -->
                        </tbody>
                    </table>
                </div>

                <!-- Khung báo trống -->
                <div id="emptyCartNotice" class="text-center py-5 text-muted my-auto">
                    <i class="fa-solid fa-barcode fs-1 mb-2 text-secondary opacity-50"></i>
                    <div>Chưa có sản phẩm nào. Hãy dùng máy quét mã vạch hoặc gõ phím F1.</div>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Bảng Tính Tiền & Chốt Đơn -->
        <div class="col-lg-4 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white d-flex flex-column justify-content-between">
                <div>
                    <!-- Thông Tin Khách Hàng (F2) -->
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark"><i class="fa-solid fa-id-card me-1 text-primary"></i>Khách hàng</span>
                            <span class="hotkey-badge">F2</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="text" id="custPhone" class="form-control form-control-sm rounded-3" placeholder="Số điện thoại..." />
                            </div>
                            <div class="col-6">
                                <input type="text" id="custName" class="form-control form-control-sm rounded-3" placeholder="Tên khách hàng..." value="Khách lẻ" />
                            </div>
                        </div>
                    </div>

                    <!-- Tóm Tắt Doanh Thu Dòng Tiền -->
                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Tổng tiền hàng:</span>
                            <span id="posSubTotal" class="font-monospace fw-semibold text-dark">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small text-secondary">
                            <span>Chiết khấu đơn (đ):</span>
                            <input type="number" id="orderDiscountInput" class="form-control form-control-sm text-end font-monospace w-50 rounded-3" value="0" min="0" step="5000" onchange="recalculateTotal()" />
                        </div>
                        <div class="d-flex justify-content-between small text-secondary">
                            <span>Thuế VAT (10%):</span>
                            <span id="posVatAmount" class="font-monospace text-muted">0 đ</span>
                        </div>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="h6 fw-bold text-dark mb-0">KHÁCH PHẢI TRẢ:</span>
                            <span id="posFinalTotal" class="h3 fw-bold text-danger font-monospace mb-0">0 đ</span>
                        </div>
                    </div>

                    <!-- Chọn Phương Thức Thanh Toán -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-2">Phương thức thanh toán:</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="paymentMethodRadio" id="payCash" value="1" checked onchange="onPaymentMethodChanged()" />
                            <label class="btn btn-outline-secondary py-2 small fw-semibold" for="payCash">
                                <i class="fa-solid fa-money-bill-wave me-1 text-success"></i>Tiền mặt
                            </label>

                            <input type="radio" class="btn-check" name="paymentMethodRadio" id="payQr" value="2" onchange="onPaymentMethodChanged()" />
                            <label class="btn btn-outline-secondary py-2 small fw-semibold" for="payQr">
                                <i class="fa-solid fa-qrcode me-1 text-primary"></i>VietQR (F9)
                            </label>

                            <input type="radio" class="btn-check" name="paymentMethodRadio" id="payCard" value="3" onchange="onPaymentMethodChanged()" />
                            <label class="btn btn-outline-secondary py-2 small fw-semibold" for="payCard">
                                <i class="fa-solid fa-credit-card me-1 text-warning"></i>Thẻ POS
                            </label>
                        </div>
                    </div>

                    <!-- Khung Nhập Tiền Khách Đưa (Dành cho Tiền mặt) -->
                    <div id="cashCalculationBox" class="p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-dark">Tiền khách đưa:</span>
                            <input type="number" id="cashGivenInput" class="form-control form-control-sm text-end font-monospace w-50 rounded-3 fs-6 fw-bold" value="0" step="10000" onkeyup="recalculateChange()" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-secondary">Tiền thối lại:</span>
                            <span id="changeAmountLabel" class="font-monospace fw-bold text-success fs-5">0 đ</span>
                        </div>
                    </div>
                </div>

                <!-- Nút Xác Nhận Thanh Toán (F10) -->
                <div>
                    <button type="button" id="btnCheckout" class="btn btn-gradient w-100 py-3 rounded-4 fs-5" onclick="executeCheckout()">
                        <i class="fa-solid fa-circle-check me-2"></i>THANH TOÁN & IN (F10)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thanh Toán VietQR Động Tại Quầy -->
<div class="modal fade" id="posQrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg text-center p-4">
            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-qrcode text-primary me-2"></i>Quét Mã VietQR Quẹt Nhanh</h5>
            <p class="text-muted small mb-3">Khách mở ứng dụng ngân hàng quét thanh toán tức thì</p>

            <div class="bg-white p-2 rounded-3 border d-inline-block mx-auto mb-3 shadow-sm">
                <img id="posQrImage" src="" alt="VietQR POS" style="width: 260px; height: 260px; object-fit: contain;" />
            </div>

            <div class="h4 fw-bold font-monospace text-danger mb-3" id="qrAmountLabel">0 đ</div>

            <button type="button" class="btn btn-gradient py-2 rounded-pill px-4" data-bs-dismiss="modal">
                <i class="fa-solid fa-check me-1"></i>Đã Nhận Được Tiền
            </button>
        </div>
    </div>
</div>

<!-- Iframe Ẩn Phục Vụ In Hóa Đơn Nhiệt K80 Tức Thì -->
<iframe id="receiptPrintFrame" class="d-none"></iframe>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const storeId = '@ViewBag.CurrentStore.StoreId';
        let cartItems = []; // Mảng chứa các sản phẩm: { productId, barcode, productName, batchId, batchNumber, expDateStr, unitPrice, quantity, discountRate, lineTotal }

        // 1. Bắt Sự Kiện Phím Tắt Thu Ngân (F1, F2, F9, F10)
        window.addEventListener('keydown', function (e) {
            if (e.key === 'F1') {
                e.preventDefault();
                document.getElementById('barcodeScannerInput').focus();
            } else if (e.key === 'F2') {
                e.preventDefault();
                document.getElementById('custPhone').focus();
            } else if (e.key === 'F9') {
                e.preventDefault();
                document.getElementById('payQr').checked = true;
                onPaymentMethodChanged();
                openQrModal();
            } else if (e.key === 'F10') {
                e.preventDefault();
                executeCheckout();
            }
        });

        // 2. Bắt Đầu Đọc Mã Vạch Barcode (Khi ấn Enter từ súng bắn mã vạch)
        document.getElementById('barcodeScannerInput').addEventListener('keypress', async function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const barcode = this.value.trim();
                if (!barcode) return;

                try {
                    const res = await fetch(`/Admin/Pos/ScanBarcode?storeId=${storeId}&barcode=${barcode}`);
                    const data = await res.json();
                    if (data.success) {
                        addProductToCart(data.product);
                        this.value = '';
                    } else {
                        alert(data.message);
                    }
                } catch (err) {
                    console.error(err);
                }
            }
        });

        // 3. Thêm Sản Phẩm Vào Giỏ POS
        function addProductToCart(p) {
            const existing = cartItems.find(i => i.batchId === p.batchId);
            if (existing) {
                if (existing.quantity + 1 > p.availableQuantity) {
                    alert(`Không đủ tồn kho khả dụng cho lô ${p.batchNumber}. Tối đa: ${p.availableQuantity}`);
                    return;
                }
                existing.quantity += 1;
                existing.lineTotal = Math.round(existing.unitPrice * existing.quantity * (1 - existing.discountRate / 100));
            } else {
                cartItems.push({
                    productId: p.productId,
                    barcode: p.barcode,
                    productName: p.productName,
                    batchId: p.batchId,
                    batchNumber: p.batchNumber,
                    expDateStr: p.expDateStr,
                    unitPrice: p.sellingPrice,
                    quantity: 1,
                    discountRate: 0,
                    lineTotal: p.sellingPrice
                });
            }
            renderCartTable();
        }

        // 4. Render Bảng Giỏ Hàng
        function renderCartTable() {
            const tbody = document.getElementById('posCartTbody');
            const notice = document.getElementById('emptyCartNotice');
            tbody.innerHTML = '';

            if (cartItems.length === 0) {
                notice.classList.remove('d-none');
            } else {
                notice.classList.add('d-none');
                cartItems.forEach((item, idx) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="px-3 text-muted small">${idx + 1}</td>
                        <td>
                            <div class="fw-bold text-dark small">${item.productName}</div>
                            <span class="badge bg-light text-dark border font-monospace" style="font-size: 10px;">Lô: ${item.batchNumber} (HSD: ${item.expDateStr})</span>
                        </td>
                        <td class="text-end font-monospace small">${Number(item.unitPrice).toLocaleString()} đ</td>
                        <td class="text-center">
                            <div class="d-inline-flex align-items-center border rounded-3 bg-white p-1">
                                <button type="button" class="btn btn-sm btn-light py-0 px-2" onclick="changeQty(${idx}, -1)">-</button>
                                <span class="px-2 fw-bold small">${item.quantity}</span>
                                <button type="button" class="btn btn-sm btn-light py-0 px-2" onclick="changeQty(${idx}, 1)">+</button>
                            </div>
                        </td>
                        <td class="text-center">
                            <input type="number" class="form-control form-control-sm text-center p-1 rounded-2" value="${item.discountRate}" min="0" max="100" onchange="changeDiscount(${idx}, this.value)" />
                        </td>
                        <td class="text-end px-3 font-monospace fw-bold text-danger">${Number(item.lineTotal).toLocaleString()} đ</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm text-danger border-0 p-0" onclick="removeItem(${idx})"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
            recalculateTotal();
        }

        function changeQty(index, delta) {
            cartItems[index].quantity += delta;
            if (cartItems[index].quantity <= 0) {
                cartItems.splice(index, 1);
            } else {
                const item = cartItems[index];
                item.lineTotal = Math.round(item.unitPrice * item.quantity * (1 - item.discountRate / 100));
            }
            renderCartTable();
        }

        function changeDiscount(index, discount) {
            const item = cartItems[index];
            item.discountRate = Math.min(100, Math.max(0, Number(discount) || 0));
            item.lineTotal = Math.round(item.unitPrice * item.quantity * (1 - item.discountRate / 100));
            renderCartTable();
        }

        function removeItem(index) {
            cartItems.splice(index, 1);
            renderCartTable();
        }

        // 5. Tính Tổng Tiền & Tiền Thối
        function recalculateTotal() {
            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            const orderDiscount = Number(document.getElementById('orderDiscountInput').value) || 0;
            const finalTotal = Math.max(0, subTotal - orderDiscount);
            const vatAmount = Math.round(finalTotal - (finalTotal / 1.1));

            document.getElementById('posSubTotal').innerText = Number(subTotal).toLocaleString() + ' đ';
            document.getElementById('posVatAmount').innerText = Number(vatAmount).toLocaleString() + ' đ';
            document.getElementById('posFinalTotal').innerText = Number(finalTotal).toLocaleString() + ' đ';

            // Nếu đang chọn tiền mặt và chưa gõ tiền khách đưa, tự động gán bằng FinalTotal
            const cashInput = document.getElementById('cashGivenInput');
            if (Number(cashInput.value) === 0 || Number(cashInput.value) < finalTotal) {
                cashInput.value = finalTotal;
            }
            recalculateChange();
        }

        function recalculateChange() {
            const finalTotal = getFinalTotalNumber();
            const cashGiven = Number(document.getElementById('cashGivenInput').value) || 0;
            const change = Math.max(0, cashGiven - finalTotal);
            document.getElementById('changeAmountLabel').innerText = Number(change).toLocaleString() + ' đ';
        }

        function getFinalTotalNumber() {
            const subTotal = cartItems.reduce((sum, i) => sum + i.lineTotal, 0);
            const orderDiscount = Number(document.getElementById('orderDiscountInput').value) || 0;
            return Math.max(0, subTotal - orderDiscount);
        }

        function onPaymentMethodChanged() {
            const method = document.querySelector('input[name="paymentMethodRadio"]:checked').value;
            const cashBox = document.getElementById('cashCalculationBox');
            if (method === '1') {
                cashBox.classList.remove('d-none');
            } else {
                cashBox.classList.add('d-none');
            }

            if (method === '2') {
                openQrModal();
            }
        }

        function openQrModal() {
            const finalTotal = getFinalTotalNumber();
            if (finalTotal <= 0) return;

            const bankId = "MB";
            const accountNo = "0909999888";
            const accountName = "OMNICHANNEL BEAUTY";
            const qrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-compact2.png?amount=${finalTotal}&addInfo=POS-QUAY&accountName=${encodeURIComponent(accountName)}`;

            document.getElementById('posQrImage').src = qrUrl;
            document.getElementById('qrAmountLabel').innerText = Number(finalTotal).toLocaleString() + ' đ';

            const modal = new bootstrap.Modal(document.getElementById('posQrModal'));
            modal.show();
        }

        // 6. Thực Thi Thanh Toán & In Hóa Đơn (F10)
        async function executeCheckout() {
            if (cartItems.length === 0) {
                alert('Vui lòng quét ít nhất một sản phẩm để thanh toán.');
                return;
            }

            const finalTotal = getFinalTotalNumber();
            const method = Number(document.querySelector('input[name="paymentMethodRadio"]:checked').value);
            const cashGiven = Number(document.getElementById('cashGivenInput').value) || 0;

            if (method === 1 && cashGiven < finalTotal) {
                alert('Tiền khách đưa chưa đủ để thanh toán.');
                return;
            }

            const payload = {
                storeId: storeId,
                customerPhone: document.getElementById('custPhone').value,
                customerName: document.getElementById('custName').value,
                items: cartItems,
                orderDiscountAmount: Number(document.getElementById('orderDiscountInput').value) || 0,
                paymentMethod: method,
                cashGiven: method === 1 ? cashGiven : finalTotal,
                notes: 'Bán lẻ POS'
            };

            const btn = document.getElementById('btnCheckout');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>ĐANG XỬ LÝ...';

            try {
                const res = await fetch('/Admin/Pos/Checkout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    // Kích hoạt iframe in hóa đơn nhiệt K80
                    printK80Receipt(data.orderId);

                    // Reset giỏ hàng
                    cartItems = [];
                    document.getElementById('orderDiscountInput').value = 0;
                    document.getElementById('custPhone').value = '';
                    document.getElementById('custName').value = 'Khách lẻ';
                    renderCartTable();
                    alert(`Thanh toán thành công hóa đơn ${data.orderId}! Mã tra cứu HĐĐT: ${data.taxLookupCode}`);
                } else {
                    alert(data.message);
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối máy chủ.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i>THANH TOÁN & IN (F10)';
            }
        }

        function printK80Receipt(orderId) {
            const printFrame = document.getElementById('receiptPrintFrame');
            printFrame.src = `/Admin/Pos/PrintReceipt?orderId=${orderId}`;
            printFrame.onload = function () {
                printFrame.contentWindow.focus();
                printFrame.contentWindow.print();
            };
        }
    </script>
}
