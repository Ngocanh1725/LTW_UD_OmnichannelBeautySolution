                document.getElementById('custTierBadge').innerHTML = '<i class="fa-solid fa-crown me-1"></i>VIP Kim Cương';
                document.getElementById('custTierBadge').className = 'badge bg-warning text-dark font-monospace fw-bold';
                document.getElementById('custPointsLabel').innerHTML = '<i class="fa-solid fa-star me-1"></i>179 Điểm (Beauty Club)';
                document.getElementById('custPointsLabel').className = 'badge bg-info-subtle text-info border font-monospace fw-semibold';
