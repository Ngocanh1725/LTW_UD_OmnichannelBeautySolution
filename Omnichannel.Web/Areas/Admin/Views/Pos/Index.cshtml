                document.getElementById('customerInfoCard').classList.remove('d-none');

                renderCartTable();
            }

            if (modalTarget === 'closeShift') {
                setTimeout(() => {
                    document.getElementById('closeShiftCode').innerText = 'SHIFT-20260930-001';
