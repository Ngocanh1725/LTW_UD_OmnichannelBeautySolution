@model Omnichannel.Application.DTOs.Settings.SettingsGroupViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cài Đặt Hệ Thống & Cấu Hình Động";
    var activeGroup = Model.ActiveGroup?.ToUpperInvariant() ?? "GENERAL";

    var currentSettings = activeGroup switch
    {
        "SMTP" => Model.SmtpSettings,
        "PAYMENT" => Model.PaymentSettings,
        "SHIPPING" => Model.ShippingSettings,
        _ => Model.GeneralSettings
    };

    var isDemoMode = string.Equals(Configuration["DemoMode:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
    var isSuperAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("SUPER_ADMIN");
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">
                <i class="fa-solid fa-sliders"></i> System Dynamic Configuration
            </div>
            <h1 class="text-2xl font-black text-slate-800">Cài Đặt Hệ Thống & Tham Số Vận Hành</h1>
            <p class="text-xs text-slate-500 mt-1">Quản lý linh hoạt cấu hình đa kênh, máy chủ SMTP, cổng thanh toán và giao vận thời gian thực</p>
        </div>
        <div class="flex items-center gap-3">
            @if (isDemoMode && isSuperAdmin)
            {
                <button type="button" onclick="confirmResetDemoData()" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-rose-300 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition shadow-sm" title="Khôi phục trạng thái chuẩn trước giờ demo">
                    <i class="fa-solid fa-rotate-left text-rose-600"></i> Khôi Phục Dữ Liệu Demo
                </button>
            }
            <form asp-action="ClearCache" method="post" class="inline">
                <input type="hidden" name="group" value="@activeGroup" />
                <button type="submit" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-bold transition">
                    <i class="fa-solid fa-arrows-rotate text-indigo-600"></i> Xóa Cache Cài Đặt
                </button>
            </form>
            <button onclick="document.getElementById('modalNewSetting').classList.remove('hidden')" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition">
                <i class="fa-solid fa-plus"></i> Thêm Cấu Hình Mới
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-triangle-exclamation text-rose-600 text-sm"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Tabs Header -->
    <div class="border-b border-slate-200 bg-white rounded-t-2xl px-6 pt-4 flex gap-4 overflow-x-auto shadow-sm">
        <a href="/Admin/Settings?group=GENERAL" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 transition @(activeGroup == "GENERAL" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            <i class="fa-solid fa-globe"></i> Cấu Hình Chung
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.GeneralSettings.Count</span>
        </a>
        <a href="/Admin/Settings?group=SMTP" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 transition @(activeGroup == "SMTP" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            <i class="fa-solid fa-envelope"></i> Email & SMTP
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.SmtpSettings.Count</span>
        </a>
        <a href="/Admin/Settings?group=PAYMENT" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 transition @(activeGroup == "PAYMENT" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            <i class="fa-solid fa-credit-card"></i> Cổng Thanh Toán
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.PaymentSettings.Count</span>
        </a>
        <a href="/Admin/Settings?group=SHIPPING" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 transition @(activeGroup == "SHIPPING" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-800")">
            <i class="fa-solid fa-truck-fast"></i> Giao Vận & Vận Chuyển
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-600">@Model.ShippingSettings.Count</span>
        </a>
    </div>

    <!-- Tab Content -->
    <div class="bg-white rounded-b-2xl border border-t-0 border-slate-200 shadow-sm p-6">
        <form asp-action="SaveGroup" method="post">
            <input type="hidden" name="group" value="@activeGroup" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var setting in currentSettings)
                {
                    <div class="p-5 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 hover:border-slate-200 transition space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-xs font-bold text-slate-800 flex items-center gap-2">
                                <code>@setting.SettingKey</code>
                                @if (setting.IsEncrypted)
                                {
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-800 flex items-center gap-1" title="Dữ liệu nhạy cảm được mã hóa AES-256">
                                        <i class="fa-solid fa-lock text-[8px]"></i> Mã hóa
                                    </span>
                                }
                            </label>
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-200 text-slate-700">
                                @setting.DataType
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(setting.Description))
                        {
                            <p class="text-[11px] text-slate-500">@setting.Description</p>
                        }

                        <!-- Value Input Based on Type -->
                        <div class="pt-1">
                            @if (setting.DataType == "BOOL")
                            {
                                <select name="@setting.SettingKey" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-indigo-500">
                                    <option value="true" selected="@(setting.SettingValue?.ToLower() == "true")">Bật / Có (True)</option>
                                    <option value="false" selected="@(setting.SettingValue?.ToLower() == "false")">Tắt / Không (False)</option>
                                </select>
                            }
                            else if (setting.DataType == "INT")
                            {
                                <input type="number" name="@setting.SettingKey" value="@setting.SettingValue" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-indigo-500" />
                            }
                            else if (setting.DataType == "JSON")
                            {
                                <textarea name="@setting.SettingKey" rows="3" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-mono text-slate-800 focus:outline-none focus:border-indigo-500">@setting.SettingValue</textarea>
                            }
                            else if (setting.IsEncrypted)
                            {
                                <div class="relative">
                                    <input type="password" id="input_@setting.SettingKey" name="@setting.SettingKey" value="@setting.SettingValue" class="w-full pl-3 pr-10 py-2 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-indigo-500" />
                                    <button type="button" onclick="togglePass('input_@setting.SettingKey', this)" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 text-xs">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <input type="text" name="@setting.SettingKey" value="@setting.SettingValue" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-indigo-500" />
                            }
                        </div>

                        <!-- Update Info -->
                        @if (setting.UpdatedAt.HasValue)
                        {
                            <div class="text-[10px] text-slate-400 flex items-center justify-between pt-1">
                                <span>Cập nhật: @setting.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                @if (!string.IsNullOrEmpty(setting.UpdatedByName))
                                {
                                    <span>Bởi: @setting.UpdatedByName</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (currentSettings.Count == 0)
            {
                <div class="text-center py-12 text-slate-400">
                    <i class="fa-solid fa-inbox text-3xl mb-2"></i>
                    <p class="text-xs">Chưa có cấu hình nào trong nhóm này.</p>
                </div>
            }

            <div class="mt-8 pt-4 border-t border-slate-200 flex justify-end">
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition">
                    <i class="fa-solid fa-floppy-disk"></i> Lưu Thay Đổi Nhóm @activeGroup
                </button>
            </div>
        </form>
    </div>

    @if (isDemoMode && isSuperAdmin)
    {
        <!-- Demo State Restoration Card -->
        <div class="bg-gradient-to-r from-amber-500/10 via-rose-500/10 to-indigo-500/10 border-2 border-rose-300/80 rounded-2xl p-6 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="space-y-2">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-rose-600 text-white shadow-sm">
                            <i class="fa-solid fa-bolt-lightning mr-1"></i> Demo Ready
                        </span>
                        <h2 class="text-lg font-black text-slate-800">Cơ Chế Khôi Phục Dữ Liệu Demo (Reset State)</h2>
                    </div>
                    <p class="text-xs text-slate-600 max-w-3xl leading-relaxed">
                        Chế độ diễn tập đang được kích hoạt (<code class="text-indigo-600 font-mono font-bold">DemoMode:Enabled = true</code>). Tính năng này cho phép dọn sạch toàn bộ dữ liệu tạm sinh ra trong lúc diễn tập thử nghiệm (đơn hàng test, tồn kho bị trừ, giỏ hàng dở dang) và đưa hệ thống về đúng <span class="font-bold text-slate-800">Trạng Thái Chuẩn Hoàn Hảo</span> trước khi bước lên thuyết trình đồ án trước Hội đồng.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 pt-2 text-xs text-slate-700">
                        <div class="flex items-center gap-2 bg-white/80 backdrop-blur px-3 py-2 rounded-xl border border-rose-100">
                            <i class="fa-solid fa-shield-halved text-emerald-600 text-sm"></i>
                            <span>Bảo toàn 150+ đơn chuẩn & charts</span>
                        </div>
                        <div class="flex items-center gap-2 bg-white/80 backdrop-blur px-3 py-2 rounded-xl border border-rose-100">
                            <i class="fa-solid fa-trash-can text-rose-600 text-sm"></i>
                            <span>Xóa đơn diễn tập (!ORD-SEED)</span>
                        </div>
                        <div class="flex items-center gap-2 bg-white/80 backdrop-blur px-3 py-2 rounded-xl border border-rose-100">
                            <i class="fa-solid fa-boxes-stacked text-indigo-600 text-sm"></i>
                            <span>Phục hồi tồn kho lô FEFO thật</span>
                        </div>
                        <div class="flex items-center gap-2 bg-white/80 backdrop-blur px-3 py-2 rounded-xl border border-rose-100">
                            <i class="fa-solid fa-ticket text-amber-600 text-sm"></i>
                            <span>Làm mới coupon DEMO10, COMBO15</span>
                        </div>
                    </div>
                </div>
                <div class="flex-shrink-0">
                    <form id="formResetDemoData" asp-action="ResetDemoData" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="button" onclick="confirmResetDemoData()" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-rose-600 to-amber-600 hover:from-rose-700 hover:to-amber-700 text-white text-xs font-black shadow-lg shadow-rose-600/30 transition transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-rotate-left text-sm"></i> Khôi Phục Về Chuẩn Demo (1-Click)
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Thêm Cấu Hình Mới -->
<div id="modalNewSetting" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-4 animate-scale-up">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-plus-circle text-indigo-600"></i> Thêm Cấu Hình Hệ Thống Mới
            </h3>
            <button onclick="document.getElementById('modalNewSetting').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="Create" method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Mã Cấu Hình (Key) *</label>
                <input type="text" name="key" required placeholder="VD: DEFAULT_DISCOUNT_PERCENT" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs uppercase font-mono focus:outline-none focus:border-indigo-500" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nhóm Cấu Hình *</label>
                <select name="group" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    <option value="GENERAL" selected="@(activeGroup == "GENERAL")">GENERAL (Chung)</option>
                    <option value="SMTP" selected="@(activeGroup == "SMTP")">SMTP (Email)</option>
                    <option value="PAYMENT" selected="@(activeGroup == "PAYMENT")">PAYMENT (Thanh toán)</option>
                    <option value="SHIPPING" selected="@(activeGroup == "SHIPPING")">SHIPPING (Vận chuyển)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Kiểu Dữ Liệu *</label>
                <select name="dataType" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    <option value="STRING">STRING (Chuỗi văn bản)</option>
                    <option value="INT">INT (Số nguyên)</option>
                    <option value="BOOL">BOOL (Đúng/Sai)</option>
                    <option value="JSON">JSON (Cấu trúc dữ liệu)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Giá Trị Khởi Tạo</label>
                <textarea name="value" rows="2" placeholder="Giá trị thiết lập..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Mô Tả / Ý Nghĩa</label>
                <input type="text" name="description" placeholder="Mô tả mục đích cấu hình này..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
            </div>

            <div class="flex items-center gap-2 pt-1">
                <input type="checkbox" id="chkEncrypted" name="isEncrypted" value="true" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                <label for="chkEncrypted" class="text-xs font-bold text-slate-700 flex items-center gap-1">
                    <i class="fa-solid fa-lock text-amber-600 text-xs"></i> Mã hóa bảo mật (AES-256)
                </label>
            </div>

            <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('modalNewSetting').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition">
                    Lưu Cấu Hình
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePass(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function confirmResetDemoData() {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Khôi phục dữ liệu Demo?',
                html: `Hệ thống sẽ <b>xóa các đơn hàng thử nghiệm</b> tạo trong lúc diễn tập, <b>hoàn trả tồn kho vật lý</b> và <b>làm mới giỏ hàng</b> về trạng thái chuẩn trước giờ demo.<br/><br/><span class="text-rose-600 font-bold">Dữ liệu chuẩn (150+ đơn seed, 200+ review, báo cáo doanh thu) được bảo toàn tuyệt đối.</span>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fa-solid fa-rotate-left mr-1"></i> Xác nhận khôi phục ngay',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Đang khôi phục...',
                        text: 'Hệ thống đang chuẩn hóa lại dữ liệu demo, vui lòng đợi trong giây lát.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                            document.getElementById('formResetDemoData').submit();
                        }
                    });
                }
            });
        } else {
            if (confirm('Bạn có chắc chắn muốn khôi phục dữ liệu về trạng thái chuẩn trước giờ demo? Các đơn thử nghiệm sẽ bị xóa và tồn kho được hoàn trả.')) {
                document.getElementById('formResetDemoData').submit();
            }
        }
    }
</script>
