@model IEnumerable<Omnichannel.Application.DTOs.Media.MediaAssetDto>
@{
    ViewData["Title"] = "Thư Viện Media CSDL";
    Layout = "_AdminLayout";
    var filter = ViewBag.Filter as Omnichannel.Application.DTOs.Media.MediaFilterRequest ?? new Omnichannel.Application.DTOs.Media.MediaFilterRequest();
    int totalCount = ViewBag.TotalCount ?? 0;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentCategory = filter.Category ?? "ALL";
}

<div class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-photo-film text-rose-500"></i>
                Thư Viện Media CSDL
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Toàn bộ ảnh được lưu trữ nhị phân trực tiếp trong SQL Server (Tổng cộng: <strong class="text-rose-600 font-semibold">@totalCount</strong> ảnh)
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="document.getElementById('fileUploadInput').click()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-rose-600 to-pink-600 text-white text-sm font-medium rounded-xl shadow-md hover:from-rose-700 hover:to-pink-700 transition">
                <i class="fa-solid fa-cloud-arrow-up mr-2"></i>
                Tải Ảnh Lên CSDL
            </button>
            <input type="file" id="fileUploadInput" multiple accept="image/*" class="hidden" onchange="handleDirectUpload(this.files)" />
        </div>
    </div>
</div>

<!-- Drag & Drop Zone -->
<div id="dropZone" class="mb-6 border-2 border-dashed border-gray-300 dark:border-gray-700 hover:border-rose-500 dark:hover:border-rose-500 rounded-2xl p-6 text-center bg-gray-50/50 dark:bg-gray-800/50 transition cursor-pointer"
     onclick="document.getElementById('fileUploadInput').click()"
     ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)">
    <div class="max-w-md mx-auto">
        <div class="w-12 h-12 mx-auto mb-3 text-rose-500 bg-rose-50 dark:bg-rose-950/40 rounded-full flex items-center justify-center">
            <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
        </div>
        <h3 class="text-base font-semibold text-gray-800 dark:text-gray-200">Kéo và thả ảnh vào đây, hoặc click để duyệt file</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Hỗ trợ JPG, PNG, WEBP, SVG, GIF (Tối đa 10MB/ảnh). Tự động lưu nhị phân và lọc trùng lặp SHA256.</p>
        <div class="mt-3 flex justify-center items-center gap-3">
            <label class="text-xs text-gray-600 dark:text-gray-300 font-medium">Danh mục lưu:</label>
            <select id="uploadCategorySelect" onclick="event.stopPropagation()" class="text-xs border rounded-lg px-2.5 py-1 bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 border-gray-300 dark:border-gray-600">
                <option value="PRODUCT">Sản Phẩm (PRODUCT)</option>
                <option value="BANNER">Banner / Slider (BANNER)</option>
                <option value="BRAND">Thương Hiệu (BRAND)</option>
                <option value="BLOG">Tin Tức / Blog (BLOG)</option>
                <option value="THEME">Giao Diện / Theme (THEME)</option>
                <option value="SYSTEM">Hệ Thống (SYSTEM)</option>
            </select>
        </div>
    </div>
    
    <!-- Upload Progress Bar -->
    <div id="uploadProgressContainer" class="hidden mt-4 max-w-md mx-auto">
        <div class="flex justify-between text-xs text-gray-600 dark:text-gray-300 mb-1">
            <span id="uploadStatusText">Đang tải lên...</span>
            <span id="uploadPercentText">0%</span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
            <div id="uploadProgressBar" class="bg-gradient-to-r from-rose-500 to-pink-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
    </div>
</div>

<!-- Filter & Search Toolbar -->
<div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 mb-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-1.5">
        <a href="/admin/media?Category=ALL&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "ALL" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Tất Cả
        </a>
        <a href="/admin/media?Category=PRODUCT&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "PRODUCT" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Sản Phẩm
        </a>
        <a href="/admin/media?Category=BANNER&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "BANNER" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Banners
        </a>
        <a href="/admin/media?Category=BRAND&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "BRAND" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Thương Hiệu
        </a>
        <a href="/admin/media?Category=BLOG&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "BLOG" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Bài Viết
        </a>
        <a href="/admin/media?Category=THEME&Keyword=@filter.Keyword" class="px-3 py-1.5 rounded-lg text-xs font-medium transition @(currentCategory == "THEME" ? "bg-rose-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200")">
            Theme / Logo
        </a>
    </div>

    <form method="get" action="/admin/media" class="flex items-center gap-2">
        <input type="hidden" name="Category" value="@currentCategory" />
        <div class="relative">
            <input type="text" name="Keyword" value="@filter.Keyword" placeholder="Tìm tên file, alt text..."
                   class="pl-9 pr-3 py-1.5 text-xs rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-rose-500" />
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-xs"></i>
        </div>
        <button type="submit" class="px-3 py-1.5 bg-gray-800 text-white text-xs font-medium rounded-lg hover:bg-black transition">
            Lọc
        </button>
    </form>
</div>

<!-- Media Grid -->
@if (Model == null || !Model.Any())
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-12 text-center border border-gray-100 dark:border-gray-700">
        <div class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-gray-600 flex items-center justify-center">
            <i class="fa-regular fa-images text-4xl"></i>
        </div>
        <h4 class="text-base font-semibold text-gray-700 dark:text-gray-300">Chưa có ảnh nào trong nhóm này</h4>
        <p class="text-xs text-gray-400 mt-1">Kéo thả ảnh lên hoặc nhấn "Tải Ảnh Lên CSDL" ở trên để nạp ảnh trực tiếp vào SQL Server.</p>
    </div>
}
else
{
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">
        @foreach (var item in Model)
        {
            <div class="group relative bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-sm border border-gray-200 dark:border-gray-700 hover:shadow-md transition">
                <div class="aspect-square bg-gray-100 dark:bg-gray-900 relative flex items-center justify-center overflow-hidden cursor-pointer" onclick="previewImage('@item.Url', '@item.FileName', @item.FileSize, '@item.ContentType', '@item.Category', @item.Id, '@item.AltText')">
                    <img src="@item.Url" alt="@item.AltText" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded text-[10px] font-bold bg-black/60 text-white backdrop-blur-sm">
                        @item.Category
                    </span>
                    <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded text-[10px] bg-black/60 text-white backdrop-blur-sm">
                        @(Math.Round((double)item.FileSize / 1024, 1)) KB
                    </span>
                </div>
                <div class="p-2.5">
                    <div class="text-xs font-medium text-gray-800 dark:text-gray-200 truncate" title="@item.FileName">
                        @item.FileName
                    </div>
                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 dark:border-gray-700">
                        <button type="button" onclick="copyToClipboard('@item.Url')" title="Sao chép URL" class="text-gray-500 hover:text-rose-600 text-xs transition">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                        <button type="button" onclick="previewImage('@item.Url', '@item.FileName', @item.FileSize, '@item.ContentType', '@item.Category', @item.Id, '@item.AltText')" title="Xem chi tiết" class="text-gray-500 hover:text-blue-600 text-xs transition">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <button type="button" onclick="deleteMedia(@item.Id, '@item.FileName')" title="Xóa ảnh" class="text-gray-500 hover:text-red-600 text-xs transition">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 pt-4">
            <span class="text-xs text-gray-500">Trang @filter.PageIndex / @totalPages (Tổng @totalCount ảnh)</span>
            <div class="flex items-center gap-1">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a href="/admin/media?PageIndex=@p&PageSize=@filter.PageSize&Category=@currentCategory&Keyword=@filter.Keyword"
                       class="px-3 py-1 text-xs rounded-lg font-medium transition @(p == filter.PageIndex ? "bg-rose-600 text-white" : "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-200")">
                        @p
                    </a>
                }
            </div>
        </div>
    }
}

<!-- Preview & Edit Alt Modal -->
<div id="mediaDetailModal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-800 rounded-2xl max-w-lg w-full p-5 shadow-2xl relative" onclick="event.stopPropagation()">
        <button type="button" onclick="closeDetailModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h3 class="text-base font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <i class="fa-solid fa-image text-rose-500"></i>
            Chi Tiết Media CSDL
        </h3>
        <div class="w-full aspect-video bg-gray-100 dark:bg-gray-900 rounded-xl overflow-hidden flex items-center justify-center mb-4">
            <img id="modalPreviewImg" src="" class="max-h-full max-w-full object-contain" />
        </div>
        <div class="space-y-2 text-xs text-gray-600 dark:text-gray-300 mb-4">
            <div class="flex justify-between"><span>Tên file:</span><strong id="modalFileName" class="text-gray-900 dark:text-white"></strong></div>
            <div class="flex justify-between"><span>Định dạng:</span><span id="modalMime"></span></div>
            <div class="flex justify-between"><span>Dung lượng:</span><span id="modalSize"></span></div>
            <div class="flex justify-between"><span>Đường dẫn gọi:</span><code id="modalUrl" class="text-rose-500"></code></div>
        </div>
        <div class="mb-4">
            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Mô tả SEO (Alt Text):</label>
            <input type="text" id="modalAltInput" class="w-full text-xs px-3 py-2 border rounded-lg dark:bg-gray-700 dark:border-gray-600 text-gray-900 dark:text-white" />
        </div>
        <div class="flex justify-end gap-2">
            <button type="button" onclick="closeDetailModal()" class="px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200">Đóng</button>
            <button type="button" onclick="saveAltText()" class="px-4 py-2 text-xs font-medium text-white bg-rose-600 rounded-lg hover:bg-rose-700">Lưu Alt Text</button>
        </div>
    </div>
</div>

<script>
    let activeMediaId = null;

    function handleDragOver(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.add('border-rose-500', 'bg-rose-50/20');
    }

    function handleDragLeave(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.remove('border-rose-500', 'bg-rose-50/20');
    }

    function handleDrop(e) {
        e.preventDefault();
        handleDragLeave(e);
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            handleDirectUpload(e.dataTransfer.files);
        }
    }

    function handleDirectUpload(files) {
        if (!files || files.length === 0) return;
        const category = document.getElementById('uploadCategorySelect').value;
        const formData = new FormData();
        for (let i = 0; i < files.length; i++) {
            formData.append('files', files[i]);
        }
        formData.append('category', category);

        const progressContainer = document.getElementById('uploadProgressContainer');
        const progressBar = document.getElementById('uploadProgressBar');
        const percentText = document.getElementById('uploadPercentText');
        const statusText = document.getElementById('uploadStatusText');

        progressContainer.classList.remove('hidden');
        progressBar.style.width = '30%';
        percentText.innerText = '30%';
        statusText.innerText = `Đang nạp ${files.length} ảnh vào SQL Server...`;

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/admin/media/api/upload', true);

        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressBar.style.width = percent + '%';
                percentText.innerText = percent + '%';
            }
        };

        xhr.onload = function() {
            if (xhr.status === 200) {
                progressBar.style.width = '100%';
                percentText.innerText = '100%';
                statusText.innerText = 'Thành công! Đang tải lại...';
                setTimeout(() => window.location.reload(), 600);
            } else {
                alert('Tải lên thất bại. Vui lòng kiểm tra định dạng file.');
                progressContainer.classList.add('hidden');
            }
        };

        xhr.onerror = function() {
            alert('Lỗi kết nối khi tải ảnh lên.');
            progressContainer.classList.add('hidden');
        };

        xhr.send(formData);
    }

    function copyToClipboard(url) {
        const fullUrl = window.location.origin + url;
        navigator.clipboard.writeText(fullUrl).then(() => {
            alert('Đã sao chép đường dẫn: ' + fullUrl);
        });
    }

    function previewImage(url, fileName, size, mime, category, id, alt) {
        activeMediaId = id;
        document.getElementById('modalPreviewImg').src = url;
        document.getElementById('modalFileName').innerText = fileName;
        document.getElementById('modalMime').innerText = mime;
        document.getElementById('modalSize').innerText = Math.round(size / 1024) + ' KB';
        document.getElementById('modalUrl').innerText = url;
        document.getElementById('modalAltInput').value = alt || '';
        document.getElementById('mediaDetailModal').classList.remove('hidden');
    }

    function closeDetailModal() {
        document.getElementById('mediaDetailModal').classList.add('hidden');
        activeMediaId = null;
    }

    function saveAltText() {
        if (!activeMediaId) return;
        const alt = document.getElementById('modalAltInput').value;
        fetch(`/admin/media/api/update-alt/${activeMediaId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(alt)
        }).then(r => r.json()).then(res => {
            if (res.success) {
                alert('Đã cập nhật Alt Text thành công!');
                closeDetailModal();
                window.location.reload();
            }
        });
    }

    function deleteMedia(id, name) {
        if (!confirm(`Bạn có chắc muốn xóa ảnh "${name}" khỏi Database?`)) return;
        fetch(`/admin/media/api/delete/${id}`, { method: 'POST' })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    window.location.reload();
                } else {
                    alert('Không thể xóa ảnh do đang được liên kết trong sản phẩm hoặc banner.');
                }
            });
    }
</script>
