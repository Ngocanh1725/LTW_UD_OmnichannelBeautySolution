@model List<Omnichannel.Application.DTOs.Cms.ProductReviewDto>
@{
    ViewData["Title"] = "Quản lý Đánh Giá & Phản Hồi Sản Phẩm";
    Layout = "_AdminLayout";

    var currentTab = ViewBag.CurrentTab as string ?? "all";
    var filter = ViewBag.Filter as Omnichannel.Application.DTOs.Cms.ReviewFilterDto ?? new Omnichannel.Application.DTOs.Cms.ReviewFilterDto();
    int totalCount = ViewBag.TotalCount ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int hiddenCount = ViewBag.HiddenCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Kiểm Duyệt & Đánh Giá Sản Phẩm (Reviews)</h4>
        <p class="text-muted small mb-0">Hệ thống kiểm duyệt phản hồi khách hàng, xác thực đơn mua thực tế (Verified Purchase) và bảo vệ uy tín thương hiệu.</p>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="@Url.Action("Index", new { tab = "all" })" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center justify-content-between transition hover-lift @(currentTab == "all" ? "border-purple" : "")">
                <div>
                    <div class="text-muted small fw-medium">Tổng Đánh Giá</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@totalCount</div>
                    <div class="text-muted text-[11px] mt-1">Toàn bộ phản hồi</div>
                </div>
                <div class="stat-icon-square bg-purple-light text-purple">
                    <i class="fa-solid fa-comments"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a href="@Url.Action("Index", new { tab = "pending" })" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center justify-content-between transition hover-lift @(currentTab == "pending" ? "border-warning" : "")">
                <div>
                    <div class="text-muted small fw-medium">Chờ Phê Duyệt</div>
                    <div class="fs-4 fw-bold text-warning mt-1">@pendingCount</div>
                    <div class="text-warning text-[11px] mt-1"><i class="fa-solid fa-clock me-1"></i>Cần xử lý ngay</div>
                </div>
                <div class="stat-icon-square bg-warning-subtle text-warning">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a href="@Url.Action("Index", new { tab = "approved" })" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center justify-content-between transition hover-lift @(currentTab == "approved" ? "border-success" : "")">
                <div>
                    <div class="text-muted small fw-medium">Đã Phê Duyệt</div>
                    <div class="fs-4 fw-bold text-success mt-1">@approvedCount</div>
                    <div class="text-success text-[11px] mt-1"><i class="fa-solid fa-circle-check me-1"></i>Hiển thị Storefront</div>
                </div>
                <div class="stat-icon-square bg-success-subtle text-success">
                    <i class="fa-solid fa-check-double"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a href="@Url.Action("Index", new { tab = "hidden" })" class="text-decoration-none">
            <div class="beauty-card p-3 d-flex align-items-center justify-content-between transition hover-lift @(currentTab == "hidden" ? "border-danger" : "")">
                <div>
                    <div class="text-muted small fw-medium">Bị Ẩn / Vi Phạm</div>
                    <div class="fs-4 fw-bold text-danger mt-1">@hiddenCount</div>
                    <div class="text-danger text-[11px] mt-1"><i class="fa-solid fa-ban me-1"></i>Vi phạm tiêu chuẩn</div>
                </div>
                <div class="stat-icon-square bg-danger-subtle text-danger">
                    <i class="fa-solid fa-eye-slash"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Tabs & Filter Bar -->
<div class="beauty-card p-3 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Status Tabs -->
        <ul class="nav nav-pills gap-1">
            <li class="nav-nav-item">
                <a class="nav-link px-3 py-1.5 rounded-pill @(currentTab == "all" ? "active bg-purple" : "text-secondary")" href="@Url.Action("Index", new { tab = "all" })">
                    Tất cả <span class="badge rounded-pill bg-light text-dark ms-1">@totalCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1.5 rounded-pill @(currentTab == "pending" ? "active bg-warning text-dark" : "text-secondary")" href="@Url.Action("Index", new { tab = "pending" })">
                    Chờ duyệt <span class="badge rounded-pill bg-warning text-dark ms-1">@pendingCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1.5 rounded-pill @(currentTab == "approved" ? "active bg-success text-white" : "text-secondary")" href="@Url.Action("Index", new { tab = "approved" })">
                    Đã duyệt <span class="badge rounded-pill bg-light text-success ms-1">@approvedCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1.5 rounded-pill @(currentTab == "hidden" ? "active bg-danger text-white" : "text-secondary")" href="@Url.Action("Index", new { tab = "hidden" })">
                    Bị ẩn <span class="badge rounded-pill bg-light text-danger ms-1">@hiddenCount</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link px-3 py-1.5 rounded-pill @(currentTab == "qna" ? "active bg-purple text-white" : "text-secondary")" href="@Url.Action("Index", new { tab = "qna" })">
                    <i class="fa-solid fa-circle-question me-1"></i> Hỏi Đáp Q&A <span class="badge rounded-pill @(currentTab == "qna" ? "bg-white text-purple" : "bg-purple-light text-purple") ms-1">@ViewBag.QnaCount</span>
                </a>
            </li>
        </ul>

        <!-- Quick Filters -->
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="tab" value="@currentTab" />

            <select name="rating" class="form-select form-select-sm rounded-3" style="width: 140px;" onchange="this.form.submit()">
                <option value="">Tất cả số sao</option>
                <option value="5" selected="@(filter.Rating == 5)">5 Sao ★★★★★</option>
                <option value="4" selected="@(filter.Rating == 4)">4 Sao ★★★★☆</option>
                <option value="3" selected="@(filter.Rating == 3)">3 Sao ★★★☆☆</option>
                <option value="2" selected="@(filter.Rating == 2)">2 Sao ★★☆☆☆</option>
                <option value="1" selected="@(filter.Rating == 1)">1 Sao ★☆☆☆☆</option>
            </select>

            <select name="isVerifiedPurchase" class="form-select form-select-sm rounded-3" style="width: 160px;" onchange="this.form.submit()">
                <option value="">Tất cả người mua</option>
                <option value="true" selected="@(filter.IsVerifiedPurchase == true)">Đã mua thực tế</option>
                <option value="false" selected="@(filter.IsVerifiedPurchase == false)">Chưa xác thực</option>
            </select>
        </form>
    </div>
</div>

@if (currentTab == "qna")
{
    var questions = ViewBag.Questions as List<Omnichannel.Application.DTOs.Cms.ProductQuestionDto> ?? new List<Omnichannel.Application.DTOs.Cms.ProductQuestionDto>();
    <div class="beauty-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary small text-uppercase">
                        <th style="width: 220px;" class="ps-4">Sản Phẩm</th>
                        <th style="width: 180px;">Khách Hàng</th>
                        <th>Nội Dung Câu Hỏi & Câu Trả Lời</th>
                        <th style="width: 120px;">Trạng Thái</th>
                        <th style="width: 130px;">Thời Gian</th>
                        <th style="width: 180px;" class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!questions.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-circle-question fs-1 text-pink-border mb-2" style="color: var(--accent-pink-border);"></i>
                                <div>Chưa có câu hỏi nào từ khách hàng.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var q in questions)
                        {
                            <tr id="questionRow-@q.Id">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 210px;" title="@q.ProductName">
                                        @q.ProductName
                                    </div>
                                    <div class="small text-muted">
                                        ID: <code>#@q.ProductId</code>
                                        <a href="/Product/Detail/@q.ProductId" target="_blank" class="text-purple ms-1" title="Xem trên storefront">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@q.AuthorName</div>
                                    <div class="small text-muted">User ID: @(q.UserId.HasValue ? $"#{q.UserId}" : "Khách")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark mb-1">
                                        <i class="fa-regular fa-comment-dots text-purple me-1"></i> @q.Content
                                    </div>
                                    @if (q.Answers != null && q.Answers.Any())
                                    {
                                        <div class="mt-2 p-2 rounded-3 bg-light border border-dashed">
                                            @foreach (var ans in q.Answers)
                                            {
                                                <div class="small mb-1 pb-1 border-bottom last:border-0">
                                                    @if (ans.IsOfficial)
                                                    {
                                                        <span class="badge bg-purple text-white me-1"><i class="fa-solid fa-user-doctor me-1"></i>Dược Sĩ Omni Beauty</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary me-1">Cộng đồng</span>
                                                    }
                                                    <span class="fw-medium text-dark">@ans.Content</span>
                                                    <span class="text-muted ms-1" style="font-size: 10px;">(@ans.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (q.IsApproved && !q.IsHidden)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đã duyệt</span>
                                    }
                                    else if (q.IsHidden)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Bị ẩn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ duyệt</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @q.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-purple" onclick="openAnswerModal(@q.Id, '@Html.Raw(Html.Encode(q.Content))')" title="Trả lời chính thức">
                                            <i class="fa-solid fa-reply"></i> Trả lời
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" onclick="deleteQuestion(@q.Id)" title="Xóa câu hỏi">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
<!-- Reviews Table -->
<div class="beauty-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-secondary small text-uppercase">
                    <th style="width: 220px;" class="ps-4">Sản Phẩm</th>
                    <th style="width: 200px;">Khách Hàng</th>
                    <th style="width: 120px;">Đánh Giá</th>
                    <th>Nội Dung Chi Tiết</th>
                    <th style="width: 140px;">Trạng Thái</th>
                    <th style="width: 130px;">Ngày Tạo</th>
                    <th style="width: 140px;" class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-comment-slash fs-1 text-pink-border mb-2" style="color: var(--accent-pink-border);"></i>
                            <div>Không có đánh giá nào phù hợp với bộ lọc.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr id="reviewRow-@r.Id">
                            <td class="ps-4">
                                <div class="fw-bold text-dark text-truncate" style="max-width: 210px;" title="@r.ProductName">
                                    @r.ProductName
                                </div>
                                <div class="small text-muted">
                                    ID: <code>#@r.ProductId</code>
                                    <a href="/Product/Detail/@r.ProductId" target="_blank" class="text-purple ms-1" title="Xem trên storefront">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                </div>
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@r.UserName</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @if (r.IsVerifiedPurchase)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">
                                            <i class="fa-solid fa-circle-check me-0.5"></i> Đã mua hàng
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(r.SkinType))
                                    {
                                        <span class="badge bg-light text-secondary border" style="font-size: 10px;">
                                            @r.SkinType
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="text-warning small text-nowrap">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <i class="fa-solid fa-star @(s <= r.Rating ? "text-warning" : "text-muted opacity-25")"></i>
                                    }
                                </div>
                                <span class="badge bg-light text-dark border mt-1 font-mono">@r.Rating.0 / 5</span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(r.Title))
                                {
                                    <div class="fw-bold text-dark small mb-1">@r.Title</div>
                                }
                                <div class="text-secondary small leading-relaxed" style="max-width: 380px;">
                                    @r.Content
                                </div>
                                @if (r.Images != null && r.Images.Any())
                                {
                                    <div class="d-flex gap-1 mt-2">
                                        @foreach (var img in r.Images.Take(4))
                                        {
                                            <img src="@img" class="rounded border" style="width: 36px; height: 36px; object-fit: cover;" alt="Review photo" />
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(r.AdminNote))
                                {
                                    <div class="mt-1 small text-info bg-info-subtle px-2 py-1 rounded-2 border border-info-subtle">
                                        <i class="fa-solid fa-circle-info me-1"></i><strong>Admin Note:</strong> @r.AdminNote
                                    </div>
                                }
                            </td>

                            <td>
                                @if (r.IsHidden)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill">
                                        <i class="fa-solid fa-eye-slash me-1"></i>Bị ẩn
                                    </span>
                                }
                                else if (r.IsApproved)
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đã duyệt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 rounded-pill">
                                        <i class="fa-solid fa-clock me-1"></i>Chờ duyệt
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="small text-dark font-mono">@r.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted text-[11px] font-mono">@r.CreatedAt.ToString("HH:mm")</div>
                            </td>

                            <td class="text-end pe-4">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light rounded-circle shadow-xs" type="button" data-bs-toggle="dropdown">
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        @if (!r.IsApproved)
                                        {
                                            <li>
                                                <button class="dropdown-item text-success" onclick="approveReview(@r.Id, true)">
                                                    <i class="fa-solid fa-circle-check me-2"></i>Phê duyệt (Approve)
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <button class="dropdown-item text-secondary" onclick="approveReview(@r.Id, false)">
                                                    <i class="fa-solid fa-rotate-left me-2"></i>Thu hồi phê duyệt
                                                </button>
                                            </li>
                                        }

                                        @if (r.IsHidden)
                                        {
                                            <li>
                                                <button class="dropdown-item text-primary" onclick="toggleHideReview(@r.Id, false)">
                                                    <i class="fa-solid fa-eye me-2"></i>Hiển thị lại
                                                </button>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <button class="dropdown-item text-warning" onclick="toggleHideReview(@r.Id, true)">
                                                    <i class="fa-solid fa-eye-slash me-2"></i>Ẩn vi phạm
                                                </button>
                                            </li>
                                        }

                                        <li>
                                            <button class="dropdown-item text-info" onclick="openNoteModal(@r.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(r.AdminNote ?? ""))')">
                                                <i class="fa-solid fa-pen-to-square me-2"></i>Thêm ghi chú
                                            </button>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <button class="dropdown-item text-danger" onclick="deleteReview(@r.Id)">
                                                <i class="fa-solid fa-trash-can me-2"></i>Xóa vĩnh viễn
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
}

<!-- Modal Trả Lời Câu Hỏi Q&A Chính Thức -->
<div class="modal fade" id="answerQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-user-doctor text-purple me-2"></i>Phản Hồi Chính Thức Từ Dược Sĩ / CSKH
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="answerQuestionId" />
                <div class="mb-3">
                    <label class="form-label small text-muted">Câu hỏi của khách hàng:</label>
                    <div id="displayQuestionContent" class="p-3 rounded-3 bg-light border text-dark fw-medium small"></div>
                </div>
                <div class="mb-3">
                    <label for="answerContentInput" class="form-label small fw-semibold text-dark">Nội dung giải đáp chuyên môn:</label>
                    <textarea class="form-control rounded-3" id="answerContentInput" rows="4" placeholder="Nhập tư vấn chi tiết về công dụng, cách dùng và bảo quản sản phẩm..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-purple rounded-pill px-4" onclick="submitQuestionAnswer()">
                    <i class="fa-solid fa-paper-plane me-1"></i> Gửi Câu Trả Lời
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Admin Note Modal -->
<div class="modal fade" id="adminNoteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom border-soft">
                <h5 class="modal-title fw-bold text-dark">Ghi Chú Ban Quản Trị</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="noteReviewId" />
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Nội dung ghi chú nội bộ:</label>
                    <textarea id="noteContent" rows="4" class="form-control rounded-3" placeholder="Nhập lý do ẩn, lưu ý chất lượng phản hồi..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top border-soft">
                <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary-gradient px-4" onclick="saveAdminNote()">Lưu Ghi Chú</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function getCsrfToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        async function approveReview(reviewId, isApproved) {
            try {
                const formData = new FormData();
                formData.append('reviewId', reviewId);
                formData.append('isApproved', isApproved);
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/Approve', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi xử lý yêu cầu.', 'error');
            }
        }

        async function toggleHideReview(reviewId, isHidden) {
            try {
                const formData = new FormData();
                formData.append('reviewId', reviewId);
                formData.append('isHidden', isHidden);
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/ToggleHide', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi xử lý yêu cầu.', 'error');
            }
        }

        async function deleteReview(reviewId) {
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này không? Hành động này không thể hoàn tác.')) {
                return;
            }

            try {
                const formData = new FormData();
                formData.append('reviewId', reviewId);
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/Delete', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    const row = document.getElementById(`reviewRow-${reviewId}`);
                    if (row) row.remove();
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi xử lý yêu cầu.', 'error');
            }
        }

        function openNoteModal(reviewId, currentNote) {
            document.getElementById('noteReviewId').value = reviewId;
            document.getElementById('noteContent').value = currentNote;
            const modal = new bootstrap.Modal(document.getElementById('adminNoteModal'));
            modal.show();
        }

        async function saveAdminNote() {
            const reviewId = document.getElementById('noteReviewId').value;
            const adminNote = document.getElementById('noteContent').value;

            try {
                const formData = new FormData();
                formData.append('reviewId', reviewId);
                formData.append('isHidden', false);
                formData.append('adminNote', adminNote);
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/ToggleHide', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast('Đã lưu ghi chú thành công!', 'success');
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi lưu ghi chú.', 'error');
            }
        }

        function openAnswerModal(questionId, content) {
            document.getElementById('answerQuestionId').value = questionId;
            document.getElementById('displayQuestionContent').innerText = content;
            document.getElementById('answerContentInput').value = '';
            const modal = new bootstrap.Modal(document.getElementById('answerQuestionModal'));
            modal.show();
        }

        async function submitQuestionAnswer() {
            const questionId = document.getElementById('answerQuestionId').value;
            const answerContent = document.getElementById('answerContentInput').value;

            if (!answerContent || answerContent.trim().length < 2) {
                alert('Vui lòng nhập nội dung câu trả lời.');
                return;
            }

            try {
                const formData = new FormData();
                formData.append('questionId', questionId);
                formData.append('answerContent', answerContent.trim());
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/AnswerQuestion', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast('Đã gửi câu trả lời chính thức thành công!', 'success');
                    setTimeout(() => location.reload(), 600);
                } else {
                    showToast(data.message || 'Lỗi gửi câu trả lời', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi xử lý yêu cầu.', 'error');
            }
        }

        async function deleteQuestion(questionId) {
            if (!confirm('Bạn có chắc chắn muốn xóa vĩnh viễn câu hỏi này không?')) {
                return;
            }

            try {
                const formData = new FormData();
                formData.append('questionId', questionId);
                formData.append('__RequestVerificationToken', getCsrfToken());

                const res = await fetch('/Admin/Review/DeleteQuestion', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    const row = document.getElementById(`questionRow-${questionId}`);
                    if (row) row.remove();
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi xử lý yêu cầu.', 'error');
            }
        }

        function showToast(message, type) {
            const bgClass = type === 'success' ? 'bg-success' : (type === 'error' ? 'bg-danger' : 'bg-info');
            const toastEl = document.createElement('div');
            toastEl.className = `position-fixed bottom-0 end-0 p-3 z-50`;
            toastEl.innerHTML = `
                <div class="toast align-items-center text-white ${bgClass} border-0 show" role="alert">
                    <div class="d-flex">
                        <div class="toast-body small fw-semibold">
                            <i class="fa-solid fa-circle-check me-2"></i>${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;
            document.body.appendChild(toastEl);
            setTimeout(() => toastEl.remove(), 3500);
        }
    </script>
}
