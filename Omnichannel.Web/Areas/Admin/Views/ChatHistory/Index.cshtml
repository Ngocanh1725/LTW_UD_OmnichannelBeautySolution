@model Omnichannel.Application.DTOs.Chat.ChatHistoryViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch Sử Hội Thoại Chatbot AI";
    var stats = Model.Stats;
    var filter = Model.Filter;
}

<!-- Page Header -->
<div class="mb-6 flex flex-col justify-between gap-4 md:flex-row md:items-center">
    <div>
        <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-tr from-pink-500 via-rose-500 to-purple-600 text-white shadow-lg shadow-pink-500/25">
                <i class="fa-solid fa-robot text-xl"></i>
            </span>
            <div>
                <h1 class="text-2xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
                    Lịch Sử Hội Thoại Chatbot AI
                    <span class="text-xs bg-pink-100 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300 font-bold px-2 py-0.5 rounded-full border border-pink-200 dark:border-pink-800">
                        Storefront Assistant
                    </span>
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Theo dõi, phân tích các cuộc trò chuyện và câu hỏi phổ biến của khách hàng trên hệ thống Storefront
                </p>
            </div>
        </div>
    </div>

    <div class="flex items-center gap-2.5">
        <a href="/" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-xs font-semibold shadow-xs transition">
            <i class="fa-solid fa-arrow-up-right-from-square text-magenta-accent"></i>
            <span>Mở Storefront Trải Nghiệm</span>
        </a>
    </div>
</div>

<!-- Success / Error Alert Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-5 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-200">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-emerald-500 text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700">&times;</button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-5 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 flex items-center justify-between text-xs text-rose-800 dark:text-rose-200">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-rose-500 text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700">&times;</button>
    </div>
}

<!-- 4 Key Stat Cards -->
<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Card 1: Total Sessions -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs flex items-center gap-4">
        <div class="h-12 w-12 rounded-2xl bg-pink-50 dark:bg-pink-950/50 text-magenta-accent flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-comments"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Tổng Cuộc Trò Chuyện</div>
            <div class="text-2xl font-bold text-slate-800 dark:text-white font-mono mt-0.5">@stats.TotalSessions.ToString("N0")</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Tất cả phiên từ trước đến nay</div>
        </div>
    </div>

    <!-- Card 2: Today Sessions -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs flex items-center gap-4">
        <div class="h-12 w-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-calendar-day"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Hội Thoại Hôm Nay</div>
            <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 font-mono mt-0.5">@stats.TodaySessions.ToString("N0")</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-medium mt-0.5 flex items-center gap-1">
                <i class="fa-solid fa-arrow-trend-up text-[10px]"></i> Đang hoạt động
            </div>
        </div>
    </div>

    <!-- Card 3: Total Messages -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs flex items-center gap-4">
        <div class="h-12 w-12 rounded-2xl bg-purple-50 dark:bg-purple-950/50 text-purple-600 flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-message"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Tổng Số Tin Nhắn</div>
            <div class="text-2xl font-bold text-slate-800 dark:text-white font-mono mt-0.5">@stats.TotalMessages.ToString("N0")</div>
            <div class="text-[11px] text-slate-400 mt-0.5">Cả tin nhắn khách & bot</div>
        </div>
    </div>

    <!-- Card 4: Top Topic -->
    @{
        var topTopic = stats.TopicBreakdown.OrderByDescending(x => x.Value).FirstOrDefault();
    }
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs flex items-center gap-4">
        <div class="h-12 w-12 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-fire"></i>
        </div>
        <div>
            <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Chủ Đề Quan Tâm Nhất</div>
            <div class="text-lg font-bold text-slate-800 dark:text-white mt-0.5 truncate max-w-[150px]">
                @(string.IsNullOrEmpty(topTopic.Key) ? "Chưa có" : topTopic.Key)
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">
                Chiếm <strong>@(topTopic.Value)</strong> lượt tương tác
            </div>
        </div>
    </div>
</div>

<!-- Most Common Questions Chips Banner -->
@if (stats.MostCommonQuestions != null && stats.MostCommonQuestions.Any())
{
    <div class="mb-6 rounded-2xl border border-pink-100 dark:border-slate-800 bg-gradient-to-r from-pink-50/60 via-purple-50/40 to-white dark:from-slate-900 dark:to-slate-800 p-4 shadow-xs">
        <div class="flex items-center gap-2 mb-2.5 text-xs font-bold text-slate-700 dark:text-slate-200">
            <i class="fa-solid fa-magnifying-glass-chart text-magenta-accent"></i>
            <span>Câu hỏi phổ biến nhất của khách hàng gần đây:</span>
        </div>
        <div class="flex flex-wrap gap-2">
            @foreach (var q in stats.MostCommonQuestions)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white dark:bg-slate-800 border border-pink-200/70 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-200 shadow-xs">
                    <span class="truncate max-w-xs font-medium">"@q.Key"</span>
                    <span class="bg-magenta-accent text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full">@q.Value</span>
                </span>
            }
        </div>
    </div>
}

<!-- Filters Card -->
<div class="mb-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs">
    <form method="get" action="/Admin/ChatHistory" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <!-- Search Keyword -->
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Tìm kiếm từ khóa</label>
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                <input type="text" name="Search" value="@filter.Search" placeholder="Session Key, khách hàng, email..."
                       class="w-full pl-9 pr-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100" />
            </div>
        </div>

        <!-- Topic Filter -->
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Chủ đề phân tích</label>
            <select name="Topic" class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100">
                <option value="ALL">-- Tất cả chủ đề --</option>
                <!option value="SKINCARE" @(filter.Topic == "SKINCARE" ? "selected" : "")>Chăm sóc da (Skincare)</!option>
                <!option value="CONSULTATION" @(filter.Topic == "CONSULTATION" ? "selected" : "")>Tư vấn loại da</!option>
                <!option value="ORDER" @(filter.Topic == "ORDER" ? "selected" : "")>Đơn hàng & Vận chuyển</!option>
                <!option value="PROMOTION" @(filter.Topic == "PROMOTION" ? "selected" : "")>Khuyến mãi & Voucher</!option>
                <!option value="CONTACT" @(filter.Topic == "CONTACT" ? "selected" : "")>Liên hệ & Showroom</!option>
                <!option value="GENERAL" @(filter.Topic == "GENERAL" ? "selected" : "")>Chung / Khác</!option>
            </select>
        </div>

        <!-- Date Range: From -->
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Từ ngày</label>
            <input type="date" name="FromDate" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100" />
        </div>

        <!-- Date Range: To -->
        <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Đến ngày</label>
            <input type="date" name="ToDate" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                   class="w-full px-3 py-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-magenta-accent text-slate-800 dark:text-slate-100" />
        </div>

        <!-- Submit & Reset Buttons -->
        <div class="flex items-end gap-2">
            <button type="submit" class="flex-1 py-2 px-4 rounded-xl bg-magenta-accent hover:opacity-95 text-white text-xs font-semibold shadow-sm transition flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-filter text-xs"></i>
                <span>Lọc</span>
            </button>
            <a href="/Admin/ChatHistory" class="py-2 px-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium transition" title="Đặt lại bộ lọc">
                <i class="fa-solid fa-rotate-left"></i>
            </a>
        </div>
    </form>
</div>

<!-- Sessions Table Card -->
<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
            <thead class="bg-slate-50 dark:bg-slate-800/80 text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                <tr>
                    <th class="py-3.5 px-4">Mã Phiên (Session)</th>
                    <th class="py-3.5 px-4">Khách Hàng</th>
                    <th class="py-3.5 px-4">Chủ Đề Phân Tích</th>
                    <th class="py-3.5 px-4 text-center">Số Tin</th>
                    <th class="py-3.5 px-4">Nội Dung Gần Nhất</th>
                    <th class="py-3.5 px-4">Thời Gian</th>
                    <th class="py-3.5 px-4 text-right">Hành Động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-normal">
                @if (Model.Sessions != null && Model.Sessions.Any())
                {
                    @foreach (var s in Model.Sessions)
                    {
                        <tr class="hover:bg-pink-50/30 dark:hover:bg-slate-800/40 transition">
                            <!-- Session Key -->
                            <td class="py-3.5 px-4 font-mono font-medium text-slate-800 dark:text-slate-200">
                                <div class="flex items-center gap-1.5">
                                    <span class="truncate max-w-[120px]" title="@s.SessionKey">@s.SessionKey</span>
                                    <button type="button" onclick="navigator.clipboard.writeText('@s.SessionKey'); alert('Đã sao chép mã phiên!');" class="text-slate-400 hover:text-magenta-accent text-[11px]" title="Sao chép mã">
                                        <i class="fa-regular fa-copy"></i>
                                    </button>
                                </div>
                            </td>

                            <!-- Customer Info -->
                            <td class="py-3.5 px-4">
                                <div class="font-medium text-slate-800 dark:text-slate-200">
                                    @(string.IsNullOrWhiteSpace(s.CustomerName) ? "Khách Vãng Lai" : s.CustomerName)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(s.CustomerEmail))
                                {
                                    <div class="text-[11px] text-slate-400 truncate max-w-[150px]">@s.CustomerEmail</div>
                                }
                            </td>

                            <!-- Topic Badge -->
                            <td class="py-3.5 px-4">
                                @switch (s.DetectedTopic?.ToUpperInvariant())
                                {
                                    case "SKINCARE":
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-pink-100 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300 border border-pink-200 dark:border-pink-800">
                                            <i class="fa-solid fa-spa text-[10px]"></i> Skincare
                                        </span>
                                        break;
                                    case "CONSULTATION":
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                            <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i> Tư Vấn Da
                                        </span>
                                        break;
                                    case "ORDER":
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-blue-100 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                                            <i class="fa-solid fa-box text-[10px]"></i> Đơn Hàng
                                        </span>
                                        break;
                                    case "PROMOTION":
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-100 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                                            <i class="fa-solid fa-tags text-[10px]"></i> Khuyến Mãi
                                        </span>
                                        break;
                                    case "CONTACT":
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-teal-100 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                                            <i class="fa-solid fa-phone text-[10px]"></i> Liên Hệ
                                        </span>
                                        break;
                                    default:
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            <i class="fa-solid fa-comment-dots text-[10px]"></i> Chung
                                        </span>
                                        break;
                                }
                            </td>

                            <!-- Message Count -->
                            <td class="py-3.5 px-4 text-center font-mono font-bold text-slate-700 dark:text-slate-300">
                                <span class="px-2 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800">@s.MessageCount</span>
                            </td>

                            <!-- Last Message Preview -->
                            <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400">
                                <div class="truncate max-w-xs text-xs" title="@s.LastMessage">
                                    @(string.IsNullOrWhiteSpace(s.LastMessage) ? "(Chưa có tin nhắn)" : s.LastMessage)
                                </div>
                            </td>

                            <!-- Started & Last Message Times -->
                            <td class="py-3.5 px-4 text-[11px] text-slate-500 dark:text-slate-400">
                                <div class="flex items-center gap-1 font-mono">
                                    <i class="fa-regular fa-clock text-[10px] text-slate-400"></i>
                                    <span>@s.LastMessageAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </td>

                            <!-- Action Buttons -->
                            <td class="py-3.5 px-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button type="button" 
                                            onclick="openTranscriptModal(@s.Id)" 
                                            class="p-2 rounded-xl bg-pink-50 text-magenta-accent hover:bg-magenta-accent hover:text-white dark:bg-slate-800 dark:hover:bg-magenta-accent transition shadow-xs" 
                                            title="Xem hội thoại chi tiết">
                                        <i class="fa-solid fa-eye text-xs"></i>
                                    </button>

                                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("SUPER_ADMIN"))
                                    {
                                        <form method="post" action="/Admin/ChatHistory/Delete/@s.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn phiên chat này không?');" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-2 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white dark:bg-slate-800 dark:hover:bg-rose-600 transition shadow-xs" title="Xóa phiên">
                                                <i class="fa-solid fa-trash-can text-xs"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-12 text-center text-slate-400">
                            <i class="fa-solid fa-comments text-4xl mb-3 opacity-30 text-magenta-accent"></i>
                            <p class="text-sm font-medium">Chưa có phiên hội thoại nào phù hợp với bộ lọc</p>
                            <p class="text-xs text-slate-400 mt-1">Các phiên chat từ Storefront sẽ tự động được ghi nhận tại đây.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="px-5 py-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs text-slate-500">
                Hiển thị trang <strong>@filter.Page</strong> / <strong>@Model.TotalPages</strong> (Tổng @Model.TotalItems phiên)
            </span>
            <div class="flex items-center gap-1">
                @if (filter.Page > 1)
                {
                    <a href="/Admin/ChatHistory?Page=@(filter.Page - 1)&Search=@filter.Search&Topic=@filter.Topic&FromDate=@(filter.FromDate?.ToString("yyyy-MM-dd"))&ToDate=@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                        Trước
                    </a>
                }
                @for (int p = Math.Max(1, filter.Page - 2); p <= Math.Min(Model.TotalPages, filter.Page + 2); p++)
                {
                    <a href="/Admin/ChatHistory?Page=@p&Search=@filter.Search&Topic=@filter.Topic&FromDate=@(filter.FromDate?.ToString("yyyy-MM-dd"))&ToDate=@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                       class="px-3 py-1.5 rounded-lg text-xs font-semibold @(p == filter.Page ? "bg-magenta-accent text-white" : "border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800") transition">
                        @p
                    </a>
                }
                @if (filter.Page < Model.TotalPages)
                {
                    <a href="/Admin/ChatHistory?Page=@(filter.Page + 1)&Search=@filter.Search&Topic=@filter.Topic&FromDate=@(filter.FromDate?.ToString("yyyy-MM-dd"))&ToDate=@(filter.ToDate?.ToString("yyyy-MM-dd"))"
                       class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                        Sau
                    </a>
                }
            </div>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- MODAL: XEM CHI TIẾT TRANSCRIPT HỘI THOẠI -->
<!-- ========================================================================= -->
<div id="transcriptModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-charcoal/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative w-full max-w-2xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-pink-100 dark:border-slate-800 overflow-hidden flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-200">
        <!-- Modal Header -->
        <div class="px-6 py-4 bg-gradient-to-r from-pink-500 via-rose-500 to-purple-600 text-white flex items-center justify-between flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white text-lg shadow-inner">
                    <i class="fa-solid fa-comments"></i>
                </div>
                <div>
                    <h3 class="font-bold text-base text-white flex items-center gap-2">
                        Transcript Cuộc Trò Chuyện
                        <span id="modalTopicBadge" class="bg-white/25 text-[10px] px-2 py-0.5 rounded font-black tracking-wider uppercase">GENERAL</span>
                    </h3>
                    <p id="modalSessionSubtext" class="text-xs text-pink-100">Mã phiên: -</p>
                </div>
            </div>

            <button type="button" onclick="closeTranscriptModal()" class="h-8 w-8 rounded-full hover:bg-white/20 flex items-center justify-center text-white transition">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- Customer Summary Header Bar -->
        <div class="px-6 py-3 bg-slate-50 dark:bg-slate-800/70 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300 flex-shrink-0">
            <div>
                Khách hàng: <strong id="modalCustomerName" class="text-slate-800 dark:text-white">Khách Vãng Lai</strong>
                <span id="modalCustomerEmail" class="text-slate-400 ml-1.5"></span>
            </div>
            <div id="modalTimestamp" class="font-mono text-[11px] text-slate-400">
                -
            </div>
        </div>

        <!-- Chat Transcript Message Stream -->
        <div id="modalMessagesContainer" class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/50 dark:bg-slate-900/60 chat-scroll">
            <div class="text-center text-slate-400 py-10">
                <i class="fa-solid fa-circle-notch fa-spin text-2xl text-magenta-accent"></i>
                <p class="text-xs mt-2">Đang tải toàn bộ hội thoại...</p>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-3.5 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 flex justify-end flex-shrink-0">
            <button type="button" onclick="closeTranscriptModal()" class="px-5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold transition">
                Đóng
            </button>
        </div>
    </div>
</div>

<script>
    async function openTranscriptModal(sessionId) {
        const modal = document.getElementById('transcriptModal');
        const container = document.getElementById('modalMessagesContainer');
        const subtext = document.getElementById('modalSessionSubtext');
        const topicBadge = document.getElementById('modalTopicBadge');
        const customerName = document.getElementById('modalCustomerName');
        const customerEmail = document.getElementById('modalCustomerEmail');
        const timestamp = document.getElementById('modalTimestamp');

        modal.classList.remove('hidden');
        container.innerHTML = `
            <div class="text-center text-slate-400 py-10">
                <i class="fa-solid fa-circle-notch fa-spin text-2xl text-magenta-accent"></i>
                <p class="text-xs mt-2">Đang tải toàn bộ hội thoại...</p>
            </div>
        `;

        try {
            const res = await fetch(`/Admin/ChatHistory/Detail/${sessionId}`);
            const result = await res.json();

            if (!result.success || !result.data) {
                container.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">Không tìm thấy thông tin hội thoại.</div>`;
                return;
            }

            const data = result.data;
            const session = data.session;
            const messages = data.messages;

            subtext.innerText = `Mã phiên: ${session.sessionKey}`;
            topicBadge.innerText = session.detectedTopic || 'GENERAL';
            customerName.innerText = session.customerName || 'Khách Vãng Lai';
            customerEmail.innerText = session.customerEmail ? `(${session.customerEmail})` : '';
            timestamp.innerText = `Bắt đầu: ${new Date(session.startedAt).toLocaleString('vi-VN')}`;

            if (!messages || messages.length === 0) {
                container.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">Phiên này chưa có tin nhắn nào.</div>`;
                return;
            }

            container.innerHTML = '';
            messages.forEach(m => {
                const isUser = m.sender === 'USER';
                const timeStr = new Date(m.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                const msgDiv = document.createElement('div');
                msgDiv.className = isUser ? 'flex justify-end gap-2' : 'flex justify-start gap-2.5';

                let formattedContent = m.content.replace(/\n/g, '<br/>');

                if (isUser) {
                    msgDiv.innerHTML = `
                        <div class="max-w-[80%] space-y-1 text-right">
                            <div class="text-[10px] text-slate-400 font-medium">${session.customerName || 'Khách hàng'} • ${timeStr}</div>
                            <div class="bg-gradient-to-r from-pink-500 to-rose-600 text-white text-xs rounded-2xl rounded-br-xs px-4 py-2.5 shadow-xs leading-relaxed text-left inline-block">
                                ${formattedContent}
                            </div>
                        </div>
                    `;
                } else {
                    msgDiv.innerHTML = `
                        <div class="h-8 w-8 rounded-xl bg-gradient-to-tr from-pink-500 to-purple-600 text-white flex items-center justify-center text-xs flex-shrink-0 mt-3 shadow-xs">
                            <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i>
                        </div>
                        <div class="max-w-[80%] space-y-1">
                            <div class="flex items-center gap-1.5 text-[10px] text-slate-400 font-medium">
                                <span>Beauty Assistant</span>
                                <span>• ${timeStr}</span>
                                ${m.intent ? `<span class="bg-pink-100 text-pink-700 px-1.5 py-0.2 rounded font-mono text-[9px] uppercase font-bold">${m.intent}</span>` : ''}
                            </div>
                            <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100 text-xs rounded-2xl rounded-tl-xs px-4 py-2.5 shadow-xs leading-relaxed inline-block break-words">
                                ${formattedContent}
                            </div>
                        </div>
                    `;
                }

                container.appendChild(msgDiv);
            });

            container.scrollTop = container.scrollHeight;
        } catch (e) {
            container.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">Lỗi khi tải chi tiết hội thoại: ${e.message}</div>`;
        }
    }

    function closeTranscriptModal() {
        const modal = document.getElementById('transcriptModal');
        if (modal) modal.classList.add('hidden');
    }
</script>
