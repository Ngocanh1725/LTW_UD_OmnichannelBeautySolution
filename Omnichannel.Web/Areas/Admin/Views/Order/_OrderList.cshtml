@model Omnichannel.Application.DTOs.Sales.AdminOrderPagedListViewModel
@using System.Text.Encodings.Web

@if (!Model.Items.Any())
{
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-12 text-center my-4">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-50 dark:bg-rose-950/40 text-rose-500 dark:text-rose-400 mb-4 ring-8 ring-rose-50/50 dark:ring-rose-950/20">
            <i class="fa-solid fa-receipt text-3xl"></i>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100">Không tìm thấy đơn hàng nào</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mt-1 mb-6">
            Không có đơn hàng nào khớp với điều kiện tìm kiếm hoặc tab trạng thái hiện tại. Hãy thử chọn tab khác hoặc làm mới bộ lọc.
        </p>
        <button type="button" 
                onclick="resetOrderFilters()" 
                class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-xl text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
            <i class="fa-solid fa-rotate-left mr-2"></i>Đặt lại bộ lọc
        </button>
    </div>
}
else
{
    <!-- Desktop Responsive Table View (Hidden on mobile) -->
    <div class="hidden md:block overflow-hidden bg-white dark:bg-slate-900 shadow-sm border border-slate-200/80 dark:border-slate-800 rounded-2xl">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-800">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300">
                <tr>
                    <th scope="col" class="py-3.5 pl-6 pr-3 text-left text-xs font-bold uppercase tracking-wider">
                        Mã Đơn Hàng
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-bold uppercase tracking-wider">
                        Khách Hàng
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-center text-xs font-bold uppercase tracking-wider">
                        Kênh Bán
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-right text-xs font-bold uppercase tracking-wider">
                        Tổng Tiền
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-center text-xs font-bold uppercase tracking-wider">
                        Trạng Thái
                    </th>
                    <th scope="col" class="px-3 py-3.5 text-center text-xs font-bold uppercase tracking-wider">
                        Ngày Tạo
                    </th>
                    <th scope="col" class="py-3.5 pl-3 pr-6 text-right text-xs font-bold uppercase tracking-wider">
                        Hành Động
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900">
                @foreach (var order in Model.Items)
                {
                    <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                        <!-- Order Code -->
                        <td class="py-4 pl-6 pr-3">
                            <div class="flex items-center gap-2">
                                <a href="/Admin/Order/Details/@order.Id" class="text-sm font-bold font-mono text-rose-600 dark:text-rose-400 hover:underline">
                                    @order.OrderCode
                                </a>
                                <button type="button" 
                                        onclick="navigator.clipboard.writeText('@order.OrderCode'); Swal.fire({toast:true, position:'bottom-end', icon:'info', title:'Đã sao chép mã đơn', showConfirmButton:false, timer:1500});"
                                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-xs" 
                                        title="Sao chép mã đơn">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                            <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5 flex items-center gap-1">
                                <i class="fa-solid fa-store text-[10px]"></i>
                                <span>@order.StoreName</span>
                            </div>
                        </td>

                        <!-- Customer Info -->
                        <td class="px-3 py-4 text-sm">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-400 to-rose-500 text-white font-bold text-xs flex items-center justify-center flex-shrink-0 shadow-sm">
                                    @(string.IsNullOrWhiteSpace(order.CustomerName) ? "K" : order.CustomerName.Trim()[0].ToString().ToUpperInvariant())
                                </div>
                                <div class="min-w-0">
                                    <div class="font-semibold text-slate-800 dark:text-slate-200 line-clamp-1">
                                        @order.CustomerName
                                    </div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400 font-mono">
                                        @order.CustomerPhone
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- Channel -->
                        <td class="px-3 py-4 text-sm text-center">
                            @if (order.OrderSource == "POS")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                    <i class="fa-solid fa-cash-register text-[10px] mr-1.5 text-emerald-500"></i>
                                    POS Tại Quầy
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                                    <i class="fa-solid fa-globe text-[10px] mr-1.5 text-indigo-500"></i>
                                    Website Online
                                </span>
                            }
                        </td>

                        <!-- Total Amount -->
                        <td class="px-3 py-4 text-sm text-right font-mono">
                            <div class="font-bold text-slate-900 dark:text-slate-100">
                                @order.TotalAmount.ToString("N0") <span class="text-xs font-normal text-slate-500">đ</span>
                            </div>
                            <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">
                                @order.ItemCount món • @order.PaymentMethod
                            </div>
                        </td>

                        <!-- Order Status -->
                        <td class="px-3 py-4 text-sm text-center">
                            @if (order.OrderStatus == "PENDING")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300 border border-amber-200 dark:border-amber-800 animate-pulse">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                    Chờ xác nhận
                                </span>
                            }
                            else if (order.OrderStatus == "CONFIRMED" || order.OrderStatus == "ALLOCATED")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1.5"></span>
                                    Đã phân bổ kho
                                </span>
                            }
                            else if (order.OrderStatus == "PROCESSING" || order.OrderStatus == "SHIPPING")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 dark:bg-purple-950/50 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-purple-500 mr-1.5"></span>
                                    Đang giao hàng
                                </span>
                            }
                            else if (order.OrderStatus == "COMPLETED")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                    Hoàn thành
                                </span>
                            }
                            else if (order.OrderStatus == "CANCELLED")
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 dark:bg-rose-950/50 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span>
                                    Đã hủy
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                    @order.OrderStatus
                                </span>
                            }
                        </td>

                        <!-- Created Date -->
                        <td class="px-3 py-4 text-sm text-center font-mono text-slate-600 dark:text-slate-300">
                            <div>@order.CreatedAt.ToString("dd/MM/yyyy")</div>
                            <div class="text-[11px] text-slate-400">@order.CreatedAt.ToString("HH:mm")</div>
                        </td>

                        <!-- Actions -->
                        <td class="py-4 pl-3 pr-6 text-right text-sm">
                            <div class="inline-flex items-center gap-1.5">
                                <a href="/Admin/Order/Details/@order.Id" 
                                   class="p-2 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:text-slate-400 dark:hover:text-rose-400 dark:hover:bg-rose-950/50 transition" 
                                   title="Xem chi tiết đơn hàng">
                                    <i class="fa-solid fa-eye text-sm"></i>
                                </a>
                                <a href="/Admin/Order/Print/@order.Id" 
                                   target="_blank"
                                   class="p-2 rounded-lg text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 dark:text-slate-400 dark:hover:text-indigo-400 dark:hover:bg-indigo-950/50 transition" 
                                   title="In hóa đơn / Phiếu xuất">
                                    <i class="fa-solid fa-print text-sm"></i>
                                </a>
                                <!-- Quick Status Transition Menu -->
                                @if (order.OrderStatus != "COMPLETED" && order.OrderStatus != "CANCELLED")
                                {
                                    <div x-data="{ openMenu: false }" class="relative inline-block text-left">
                                        <button type="button" 
                                                @@click="openMenu = !openMenu" 
                                                class="p-2 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-slate-200 dark:hover:bg-slate-800 transition" 
                                                title="Cập nhật trạng thái">
                                            <i class="fa-solid fa-ellipsis-vertical text-sm"></i>
                                        </button>
                                        <div x-show="openMenu" 
                                             @@click.outside="openMenu = false"
                                             style="display: none;"
                                             class="absolute right-0 z-30 mt-2 w-48 origin-top-right rounded-xl bg-white dark:bg-slate-900 p-1.5 shadow-xl ring-1 ring-black ring-opacity-5 border border-slate-200 dark:border-slate-800 text-xs space-y-1">
                                            @if (order.OrderStatus == "PENDING")
                                            {
                                                <button type="button" 
                                                        onclick="quickUpdateStatus(@order.Id, 'CONFIRMED')" 
                                                        class="w-full text-left px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 flex items-center gap-2">
                                                    <i class="fa-solid fa-check text-blue-500"></i>
                                                    <span>Xác nhận & Khóa kho</span>
                                                </button>
                                            }
                                            @if (order.OrderStatus == "CONFIRMED" || order.OrderStatus == "ALLOCATED")
                                            {
                                                <button type="button" 
                                                        onclick="quickUpdateStatus(@order.Id, 'SHIPPING')" 
                                                        class="w-full text-left px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 flex items-center gap-2">
                                                    <i class="fa-solid fa-truck-fast text-purple-500"></i>
                                                    <span>Bắt đầu giao hàng</span>
                                                </button>
                                            }
                                            @if (order.OrderStatus == "PROCESSING" || order.OrderStatus == "SHIPPING")
                                            {
                                                <button type="button" 
                                                        onclick="quickUpdateStatus(@order.Id, 'COMPLETED')" 
                                                        class="w-full text-left px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 flex items-center gap-2">
                                                    <i class="fa-solid fa-circle-check text-emerald-500"></i>
                                                    <span>Hoàn thành & Thu tiền</span>
                                                </button>
                                            }
                                            <button type="button" 
                                                    onclick="promptCancelOrder(@order.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(order.OrderCode))')" 
                                                    class="w-full text-left px-3 py-2 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center gap-2">
                                                <i class="fa-solid fa-ban"></i>
                                                <span>Hủy đơn hàng</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View (Visible on mobile only) -->
    <div class="block md:hidden space-y-3">
        @foreach (var order in Model.Items)
        {
            <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 shadow-sm border border-slate-200/80 dark:border-slate-800">
                <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2.5">
                    <a href="/Admin/Order/Details/@order.Id" class="font-bold font-mono text-sm text-rose-600 dark:text-rose-400">
                        @order.OrderCode
                    </a>
                    @if (order.OrderSource == "POS")
                    {
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                            POS
                        </span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
                            Website
                        </span>
                    }
                </div>

                <div class="py-2.5 space-y-1.5 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Khách hàng:</span>
                        <span class="font-semibold text-slate-800 dark:text-slate-200">@order.CustomerName (@order.CustomerPhone)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Tổng tiền:</span>
                        <span class="font-bold font-mono text-sm text-slate-900 dark:text-slate-100">@order.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Trạng thái:</span>
                        <span class="font-semibold @(order.OrderStatus == "COMPLETED" ? "text-emerald-600" : order.OrderStatus == "CANCELLED" ? "text-rose-600" : "text-amber-600")">
                            @order.OrderStatus
                        </span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Ngày tạo:</span>
                        <span class="font-mono text-slate-600 dark:text-slate-300">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 border-t border-slate-100 dark:border-slate-800 pt-2.5">
                    <a href="/Admin/Order/Details/@order.Id" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-eye text-xs"></i>
                        <span>Chi tiết</span>
                    </a>
                    <a href="/Admin/Order/Print/@order.Id" target="_blank" class="px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-print text-xs"></i>
                        <span>In</span>
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Pagination & Summary Footer -->
    <div class="bg-white dark:bg-slate-900 px-4 py-3 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 mt-4">
        <div class="text-xs text-slate-500 dark:text-slate-400">
            Hiển thị <span class="font-semibold text-slate-700 dark:text-slate-200">@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</span> đến 
            <span class="font-semibold text-slate-700 dark:text-slate-200">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)</span> 
            trên tổng số <span class="font-bold text-rose-600 dark:text-rose-400">@Model.TotalItems</span> đơn hàng
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="inline-flex items-center gap-1">
                <!-- First Page -->
                <button type="button" 
                        onclick="goToOrderPage(1)"
                        disabled="@(Model.CurrentPage == 1)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang đầu">
                    <i class="fa-solid fa-angles-left"></i>
                </button>

                <!-- Previous Page -->
                <button type="button" 
                        onclick="goToOrderPage(@(Model.CurrentPage - 1))"
                        disabled="@(!Model.HasPreviousPage)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang trước">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <!-- Page numbers -->
                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                {
                    int pageNum = i;
                    <button type="button" 
                            onclick="goToOrderPage(@pageNum)"
                            class="min-w-[32px] h-8 rounded-xl text-xs font-semibold transition @(pageNum == Model.CurrentPage ? "bg-rose-500 text-white shadow-sm shadow-rose-500/30" : "text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800")">
                        @pageNum
                    </button>
                }

                <!-- Next Page -->
                <button type="button" 
                        onclick="goToOrderPage(@(Model.CurrentPage + 1))"
                        disabled="@(!Model.HasNextPage)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang tiếp">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

                <!-- Last Page -->
                <button type="button" 
                        onclick="goToOrderPage(@Model.TotalPages)"
                        disabled="@(Model.CurrentPage == Model.TotalPages)"
                        class="p-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-40 disabled:pointer-events-none transition" 
                        title="Trang cuối">
                    <i class="fa-solid fa-angles-right"></i>
                </button>
            </div>
        }
    </div>
}
