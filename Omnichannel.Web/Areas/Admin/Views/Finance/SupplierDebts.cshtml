@model List<Omnichannel.Application.DTOs.Finance.SupplierDebtDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Công Nợ Nhà Cung Cấp";
    var suppliers = ViewBag.Suppliers as List<Omnichannel.Domain.Entities.Supplier> ?? new();
    var stores = ViewBag.Stores as List<Omnichannel.Domain.Entities.Store> ?? new();
    int? selectedSupplierId = ViewBag.SelectedSupplierId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";

    decimal totalDebt = Model.Sum(d => d.DebtAmount);
    decimal totalPaid = Model.Sum(d => d.PaidAmount);
    decimal totalRemaining = Model.Sum(d => d.RemainingAmount);
}

<div class="space-y-6">
    <!-- Top Navigation Subtabs -->
    <div class="flex items-center gap-2 border-b border-slate-200 bg-white px-6 pt-3 rounded-2xl shadow-sm overflow-x-auto">
        <a href="/Admin/Finance/ProfitLoss" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition">
            <i class="fa-solid fa-chart-pie"></i> Báo Cáo Lãi Lỗ (P&L)
        </a>
        <a href="/Admin/Finance/Ledger" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition">
            <i class="fa-solid fa-book"></i> Sổ Cái Thu Chi
        </a>
        <a href="/Admin/Finance/SupplierDebts" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 border-indigo-600 text-indigo-600 transition">
            <i class="fa-solid fa-file-invoice-dollar"></i> Công Nợ Nhà Cung Cấp
        </a>
        <a href="/Admin/Finance/CodReconciliations" class="pb-3 text-xs font-bold flex items-center gap-2 border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition">
            <i class="fa-solid fa-hand-holding-dollar"></i> Đối Soát COD
        </a>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-check text-emerald-600 text-sm"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-triangle-exclamation text-rose-600 text-sm"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header & Action -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-1">
                <i class="fa-solid fa-truck-ramp-box"></i> Accounts Payable & Supplier Ledger
            </div>
            <h1 class="text-xl font-black text-slate-800">Quản Lý Công Nợ Nhà Cung Cấp (Accounts Payable)</h1>
            <p class="text-xs text-slate-500 mt-0.5">Theo dõi lịch trình thanh toán khi nhập kho mỹ phẩm theo lô và kiểm soát nợ quá hạn</p>
        </div>

        <div class="flex items-center gap-3">
            <button onclick="document.getElementById('modalCreateDebt').classList.remove('hidden')" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow-md shadow-indigo-600/30 transition flex items-center gap-2">
                <i class="fa-solid fa-plus"></i> Khởi Tạo Công Nợ Mới
            </button>
        </div>
    </div>

    <!-- 3 Summary Metric Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Tổng Nợ Đã Phát Sinh</span>
            <div class="text-xl font-black text-slate-800 mt-1">@totalDebt.ToString("N0") <span class="text-xs font-normal">đ</span></div>
            <div class="text-[10px] text-slate-500 mt-1">Từ các phiếu nhập hàng theo lô</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Đã Thanh Toán</span>
            <div class="text-xl font-black text-emerald-600 mt-1">@totalPaid.ToString("N0") <span class="text-xs font-normal">đ</span></div>
            <div class="text-[10px] text-emerald-700 mt-1 font-semibold">Tự động ghi sổ cái tài chính</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Còn Phải Trả Nhà Cung Cấp</span>
            <div class="text-xl font-black text-rose-600 mt-1">@totalRemaining.ToString("N0") <span class="text-xs font-normal">đ</span></div>
            <div class="text-[10px] text-rose-700 mt-1 font-bold">Nợ cần thu xếp dòng tiền</div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
                <label class="block text-[11px] font-bold text-slate-500 mb-1">Nhà Cung Cấp</label>
                <select name="supplierId" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-indigo-500">
                    <option value="">-- Tất cả Nhà cung cấp --</option>
                    @foreach (var sup in suppliers)
                    {
                        <option value="@sup.Id" selected="@(sup.Id == selectedSupplierId)">@sup.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-slate-500 mb-1">Trạng Thái Thanh Toán</label>
                <select name="status" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-indigo-500">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="PENDING" selected="@(selectedStatus == "PENDING")">Chưa thanh toán (PENDING)</option>
                    <option value="PARTIAL" selected="@(selectedStatus == "PARTIAL")">Thanh toán 1 phần (PARTIAL)</option>
                    <option value="PAID" selected="@(selectedStatus == "PAID")">Đã tất toán (PAID)</option>
                </select>
            </div>

            <div>
                <button type="submit" class="w-full py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-magnifying-glass"></i> Lọc Công Nợ
                </button>
            </div>
        </form>
    </div>

    <!-- Debt Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-slate-50/75 border-b border-slate-200 text-slate-500 font-bold uppercase text-[10px] tracking-wider">
                        <th class="py-3 px-4">Nhà Cung Cấp</th>
                        <th class="py-3 px-4">Mã Đơn Nhập (PO)</th>
                        <th class="py-3 px-4 text-right">Tổng Tiền Nợ</th>
                        <th class="py-3 px-4 text-right">Đã Trả</th>
                        <th class="py-3 px-4 text-right">Còn Nợ</th>
                        <th class="py-3 px-4 text-center">Hạn Thanh Toán</th>
                        <th class="py-3 px-4 text-center">Trạng Thái</th>
                        <th class="py-3 px-4 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var debt in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="py-3.5 px-4 font-bold text-slate-800">
                                @debt.SupplierName
                            </td>
                            <td class="py-3.5 px-4 font-mono font-bold text-indigo-600">
                                @debt.PurchaseOrderCode
                            </td>
                            <td class="py-3.5 px-4 text-right font-semibold text-slate-800">
                                @debt.DebtAmount.ToString("N0") đ
                            </td>
                            <td class="py-3.5 px-4 text-right font-semibold text-emerald-600">
                                @debt.PaidAmount.ToString("N0") đ
                            </td>
                            <td class="py-3.5 px-4 text-right font-black @(debt.RemainingAmount > 0 ? "text-rose-600" : "text-slate-400")">
                                @debt.RemainingAmount.ToString("N0") đ
                            </td>
                            <td class="py-3.5 px-4 text-center text-slate-500">
                                @(debt.DueDate?.ToString("dd/MM/yyyy") ?? "-")
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                @if (debt.Status == "PAID")
                                {
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">ĐÃ TẤT TOÁN</span>
                                }
                                else if (debt.Status == "PARTIAL")
                                {
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">TRẢ 1 PHẦN</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800">CHƯA TRẢ</span>
                                }
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                @if (debt.RemainingAmount > 0)
                                {
                                    <button onclick="openPaymentModal(@debt.Id, '@debt.SupplierName', '@debt.PurchaseOrderCode', @debt.RemainingAmount)" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center gap-1 mx-auto">
                                        <i class="fa-solid fa-money-bill-wave"></i> Thanh Toán
                                    </button>
                                }
                                else
                                {
                                    <span class="text-emerald-600 font-bold text-xs"><i class="fa-solid fa-circle-check"></i> Xong</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="text-center py-12 text-slate-400">
                    <i class="fa-solid fa-inbox text-3xl mb-2"></i>
                    <p class="text-xs">Chưa có bản ghi công nợ nào.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Khởi Tạo Công Nợ Mới -->
<div id="modalCreateDebt" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 animate-scale-up">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-plus-circle text-indigo-600"></i> Khởi Tạo Công Nợ Nhà Cung Cấp
            </h3>
            <button onclick="document.getElementById('modalCreateDebt').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="CreateSupplierDebt" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nhà Cung Cấp *</label>
                <select name="SupplierId" required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Mã Phiếu Nhập Kho (PO Code) *</label>
                <input type="text" name="PurchaseOrderCode" required placeholder="vd: PO-20260930-01" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-mono uppercase focus:outline-none focus:border-indigo-500" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tổng Số Tiền Công Nợ (VNĐ) *</label>
                <input type="number" name="DebtAmount" required min="1000" placeholder="50000000" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-indigo-500" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Hạn Thanh Toán (Due Date)</label>
                <input type="date" name="DueDate" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
            </div>

            <div class="pt-3 border-t border-slate-200 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('modalCreateDebt').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition">
                    Hủy Bỏ
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition">
                    Lưu Công Nợ
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Thanh Toán Công Nợ -->
<div id="modalPayDebt" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 animate-scale-up">
        <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-hand-holding-dollar text-emerald-600"></i> Thanh Toán Công Nợ NCC
            </h3>
            <button onclick="document.getElementById('modalPayDebt').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form asp-action="PaySupplierDebt" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="payDebtId" name="DebtId" />

            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1">
                <div class="text-slate-500">Nhà cung cấp: <span id="paySupplierName" class="font-bold text-slate-800"></span></div>
                <div class="text-slate-500">Mã đơn nhập: <span id="payPoCode" class="font-bold text-indigo-600 font-mono"></span></div>
                <div class="text-slate-500">Dư nợ hiện tại: <span id="payRemaining" class="font-bold text-rose-600"></span> đ</div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Chi Nhánh Xuất Tiền Chi Trả *</label>
                <select name="StoreId" required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    @foreach (var st in stores)
                    {
                        <option value="@st.Id">@st.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Số Tiền Thanh Toán (VNĐ) *</label>
                <input type="number" id="payAmountInput" name="PaymentAmount" required min="1000" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-bold text-emerald-600 focus:outline-none focus:border-indigo-500" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Ghi Chú / Chứng Từ Chuyển Khoản</label>
                <input type="text" name="Note" placeholder="vd: UNC Ngân hàng Vietcombank..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:outline-none focus:border-indigo-500" />
            </div>

            <div class="pt-3 border-t border-slate-200 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('modalPayDebt').classList.add('hidden')" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition">
                    Hủy Bỏ
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md shadow-emerald-600/30 transition">
                    Xác Nhận Chi Trả
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPaymentModal(debtId, supplierName, poCode, remainingAmount) {
        document.getElementById('payDebtId').value = debtId;
        document.getElementById('paySupplierName').innerText = supplierName;
        document.getElementById('payPoCode').innerText = poCode;
        document.getElementById('payRemaining').innerText = Number(remainingAmount).toLocaleString();
        document.getElementById('payAmountInput').value = remainingAmount;
        document.getElementById('modalPayDebt').classList.remove('hidden');
    }
</script>
