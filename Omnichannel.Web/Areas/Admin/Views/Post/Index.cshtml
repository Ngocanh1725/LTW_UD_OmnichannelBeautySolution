@model IEnumerable<Omnichannel.Application.DTOs.Cms.PostItemViewModel>
@{
    ViewData["Title"] = "Cẩm nang Làm đẹp & Tin tức";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Cẩm nang Chăm sóc Da & Bài viết</h4>
        <p class="text-muted small mb-0">Quản lý bài viết tư vấn sắc đẹp, cẩm nang skincare và tin tức sự kiện</p>
    </div>
    <a href="/Admin/Post/Create" class="btn btn-primary-gradient px-3">
        <i class="fa-solid fa-pen-nib me-1"></i>Soạn Bài Viết Mới
    </a>
</div>

<div class="beauty-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="py-3 px-4" style="width: 100px;">Ảnh bìa</th>
                    <th class="py-3">Tiêu đề bài viết</th>
                    <th class="py-3">Chuyên mục</th>
                    <th class="py-3">Tác giả</th>
                    <th class="py-3 text-center">Lượt xem</th>
                    <th class="py-3">Trạng thái</th>
                    <th class="py-3 px-4 text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td class="px-4">
                            <img src="@post.ThumbnailUrl" alt="@post.Title" class="rounded-3 shadow-sm border" style="width: 80px; height: 50px; object-fit: cover;" onerror="this.src='https://placehold.co/80x50/FDF2F8/EC4899?text=Post'" />
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@post.Title</div>
                            <div class="text-muted" style="font-size: 11px;">Slug: <code>@post.Slug</code></div>
                        </td>
                        <td>
                            <span class="badge" style="background: var(--primary-purple-light); color: var(--primary-purple);">@post.CategoryName</span>
                        </td>
                        <td class="small text-secondary">@post.AuthorName</td>
                        <td class="text-center small fw-semibold">@post.ViewCount</td>
                        <td>
                            @if (post.Status == 3)
                            {
                                <span class="badge-active">Đã xuất bản</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Bản nháp</span>
                            }
                        </td>
                        <td class="px-4 text-end">
                            <a href="/tin-tuc/@post.Slug" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3" title="Xem trên web">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@post.PostId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
