@model IEnumerable<Omnichannel.Application.DTOs.Cms.PostItemViewModel>
@{
    ViewData["Title"] = "Quản lý Bài Viết & Cẩm Nang";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Cẩm Nang Làm Đẹp & Bài Viết</h4>
        <p class="text-muted small mb-0">Quản lý bài viết tư vấn skincare, xu hướng makeup và truyền thông thương hiệu</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Blog" target="_blank" class="btn btn-outline-secondary px-3">
            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Xem Trang Blog
        </a>
        <a href="/Admin/Post/Create" class="btn btn-primary-gradient px-3">
            <i class="fa-solid fa-pen-nib me-1"></i>Soạn Bài Viết Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 small mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="beauty-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="py-3 px-4" style="width: 90px;">Ảnh bìa</th>
                    <th class="py-3">Tiêu đề bài viết</th>
                    <th class="py-3">Chuyên mục</th>
                    <th class="py-3">Tác giả</th>
                    <th class="py-3 text-center">Lượt xem</th>
                    <th class="py-3">Ngày đăng</th>
                    <th class="py-3 text-center">Trạng thái</th>
                    <th class="py-3 px-4 text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-regular fa-newspaper fs-1 text-muted opacity-50 mb-2"></i>
                            <div>Chưa có bài viết nào trong hệ thống. Nhấn <strong>"Soạn Bài Viết Mới"</strong> để đăng tải bài viết đầu tiên!</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td class="px-4">
                                <img src="@post.ThumbnailUrl" alt="@post.Title" class="rounded-3 shadow-sm border" style="width: 80px; height: 50px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=200&fit=crop'" />
                            </td>
                            <td>
                                <a href="/Admin/Post/Edit/@post.PostId" class="fw-bold text-dark text-decoration-none hover-magenta">
                                    @post.Title
                                </a>
                                <div class="text-muted font-monospace" style="font-size: 11px;">/Blog/@post.Slug</div>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--primary-purple-light); color: var(--primary-purple); font-weight: 600;">
                                    @post.CategoryName
                                </span>
                            </td>
                            <td class="small text-secondary">
                                <i class="fa-regular fa-user me-1 text-muted"></i>@post.AuthorName
                            </td>
                            <td class="text-center small font-monospace fw-bold text-secondary">
                                <i class="fa-regular fa-eye me-1 text-muted"></i>@post.ViewCount
                            </td>
                            <td class="small text-secondary">
                                @(post.PublishedAt?.ToString("dd/MM/yyyy HH:mm") ?? post.CreatedAt.ToString("dd/MM/yyyy"))
                            </td>
                            <td class="text-center">
                                <form asp-action="TogglePublish" asp-route-id="@post.PostId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="border-0 bg-transparent p-0" title="Nhấp để đổi trạng thái">
                                        @if (post.Status == 3)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill" style="cursor: pointer;">
                                                <i class="fa-solid fa-circle-check me-1"></i>Đã xuất bản
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5 rounded-pill" style="cursor: pointer;">
                                                <i class="fa-solid fa-clock me-1"></i>Bản nháp
                                            </span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="px-4 text-end">
                                <div class="d-inline-flex gap-1.5">
                                    <a href="/Blog/@post.Slug" target="_blank" class="btn btn-sm btn-outline-secondary rounded-3" title="Xem trên Storefront">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                    <a href="/Admin/Post/Edit/@post.PostId" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa bài viết">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@post.PostId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa bài viết">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
