@{
    ViewData["Title"] = "Tạo Yêu Cầu Chuyển Kho";
    Layout = "_AdminLayout";
    var stores = ViewBag.Stores as List<Omnichannel.Domain.Entities.Store> ?? new();
    var products = ViewBag.Products as dynamic ?? new List<dynamic>();
}

<div class="space-y-6 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="md:flex md:items-center md:justify-between border-b pb-4">
        <div class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl">
                <i class="fa-solid fa-file-circle-plus text-indigo-600 mr-2"></i>Tạo Yêu Cầu Điều Chuyển Kho
            </h2>
            <p class="mt-1 text-sm text-gray-500">
                Lập phiếu yêu cầu điều chuyển hàng hóa giữa các kho/chi nhánh trong chuỗi bán lẻ.
            </p>
        </div>
        <div class="mt-4 flex md:ml-4 md:mt-0">
            <a asp-action="Index" class="inline-flex items-center rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                <i class="fa-solid fa-arrow-left mr-2"></i>Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Main Card -->
    <div class="bg-white shadow sm:rounded-lg p-6 border border-gray-200">
        <form id="createTransferForm" onsubmit="submitTransfer(event)" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-gray-50 p-4 rounded-lg border border-gray-200">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-1">
                        <i class="fa-solid fa-warehouse text-amber-500 mr-1"></i>Kho Xuất Hàng (Nguồn) *
                    </label>
                    <select id="sourceStoreId" required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">-- Chọn kho xuất hàng --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id">@s.Name @(s.IsHeadquarters ? "(Kho Tổng HQ)" : "")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-1">
                        <i class="fa-solid fa-store text-emerald-500 mr-1"></i>Kho Nhận Hàng (Đích) *
                    </label>
                    <select id="destinationStoreId" required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">-- Chọn chi nhánh nhận hàng --</option>
                        @foreach (var s in stores)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Ghi chú điều chuyển</label>
                <textarea id="transferNote" rows="2" placeholder="VD: Yêu cầu bổ sung 20 chai serum chống lão hóa phục vụ chiến dịch Flash Sale..." class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"></textarea>
            </div>

            <!-- Items Table Section -->
            <div class="border-t pt-4">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-base font-semibold text-gray-900">
                        <i class="fa-solid fa-boxes-stacked text-indigo-500 mr-2"></i>Danh Sách Sản Phẩm Yêu Cầu
                    </h3>
                    <button type="button" onclick="addRow()" class="inline-flex items-center rounded-md bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-100 border border-indigo-200">
                        <i class="fa-solid fa-plus mr-1"></i>Thêm dòng sản phẩm
                    </button>
                </div>

                <div class="overflow-x-auto border rounded-lg">
                    <table class="min-w-full divide-y divide-gray-200" id="itemsTable">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="py-3 px-4 text-left text-xs font-semibold text-gray-700 uppercase">Sản phẩm</th>
                                <th class="py-3 px-4 text-center text-xs font-semibold text-gray-700 uppercase w-36">Số lượng</th>
                                <th class="py-3 px-4 text-left text-xs font-semibold text-gray-700 uppercase">Ghi chú dòng</th>
                                <th class="py-3 px-4 text-center text-xs font-semibold text-gray-700 uppercase w-20">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody" class="divide-y divide-gray-200 bg-white">
                            <!-- Dynamic rows -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex justify-end space-x-3 border-t pt-4">
                <a asp-action="Index" class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Hủy bỏ</a>
                <button type="submit" id="submitBtn" class="inline-flex items-center rounded-md bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
                    <i class="fa-solid fa-paper-plane mr-2"></i>Gửi Yêu Cầu Chuyển Kho
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const availableProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(products));

    function addRow(productId = '', quantity = 1, note = '') {
        const tbody = document.getElementById('itemsBody');
        const tr = document.createElement('tr');
        tr.className = "item-row";

        let optionsHtml = '<option value="">-- Chọn sản phẩm mỹ phẩm --</option>';
        availableProducts.forEach(p => {
            optionsHtml += `<option value="${p.Id}" ${p.Id == productId ? 'selected' : ''}>${p.Name} (SKU: ${p.Sku || 'N/A'})</option>`;
        });

        tr.innerHTML = `
            <td class="p-3">
                <select class="product-select block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" required>
                    ${optionsHtml}
                </select>
            </td>
            <td class="p-3 text-center">
                <input type="number" min="1" value="${quantity}" class="quantity-input block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm text-center font-bold" required />
            </td>
            <td class="p-3">
                <input type="text" value="${note}" placeholder="Ghi chú thêm..." class="note-input block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
            </td>
            <td class="p-3 text-center">
                <button type="button" onclick="this.closest('tr').remove()" class="text-red-500 hover:text-red-700">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
    }

    // Khởi tạo sẵn 1 dòng
    document.addEventListener("DOMContentLoaded", function() {
        addRow();
    });

    async function submitTransfer(e) {
        e.preventDefault();

        const sourceStoreId = parseInt(document.getElementById('sourceStoreId').value);
        const destStoreId = parseInt(document.getElementById('destinationStoreId').value);
        const note = document.getElementById('transferNote').value;

        if (sourceStoreId === destStoreId) {
            alert("Kho nguồn và kho đích không được trùng nhau!");
            return;
        }

        const rows = document.querySelectorAll('.item-row');
        if (rows.length === 0) {
            alert("Vui lòng thêm ít nhất một sản phẩm!");
            return;
        }

        const items = [];
        rows.forEach(r => {
            const pId = parseInt(r.querySelector('.product-select').value);
            const qty = parseInt(r.querySelector('.quantity-input').value);
            const n = r.querySelector('.note-input').value;
            if (pId > 0 && qty > 0) {
                items.push({
                    productId: pId,
                    requestedQuantity: qty,
                    note: n
                });
            }
        });

        if (items.length === 0) {
            alert("Vui lòng chọn sản phẩm và số lượng hợp lệ!");
            return;
        }

        const payload = {
            sourceStoreId: sourceStoreId,
            destinationStoreId: destStoreId,
            note: note,
            items: items
        };

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerText = "Đang xử lý...";

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch('/Admin/StockTransfer/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                window.location.href = data.redirectUrl;
            } else {
                alert("Lỗi: " + data.message);
                btn.disabled = false;
                btn.innerText = "Gửi Yêu Cầu Chuyển Kho";
            }
        } catch (err) {
            alert("Lỗi hệ thống: " + err);
            btn.disabled = false;
            btn.innerText = "Gửi Yêu Cầu Chuyển Kho";
        }
    }
</script>
