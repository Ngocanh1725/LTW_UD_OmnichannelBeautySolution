@model List<Omnichannel.Application.DTOs.Inventory.StockTransferDto>
@{
    ViewData["Title"] = "Điều chuyển kho liên chi nhánh";
    Layout = "_AdminLayout";
    var stores = ViewBag.Stores as List<Omnichannel.Domain.Entities.Store> ?? new();
    var filter = ViewBag.Filter as Omnichannel.Application.DTOs.Inventory.StockTransferFilterDto ?? new();
}

<div class="space-y-6">
    <!-- Header -->
    <div class="md:flex md:items-center md:justify-between">
        <div class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
                <i class="fa-solid fa-truck-ramp-box text-indigo-600 mr-2"></i>Điều Chuyển Kho Liên Chi Nhánh
            </h2>
            <p class="mt-1 text-sm text-gray-500">
                Quản lý luân chuyển hàng hóa giữa Kho Tổng và các Showroom bán lẻ theo tiêu chuẩn xuất kho FEFO.
            </p>
        </div>
        <div class="mt-4 flex md:ml-4 md:mt-0">
            <a asp-action="Create" class="inline-flex items-center rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
                <i class="fa-solid fa-plus mr-2"></i>Tạo Yêu Cầu Chuyển Kho
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-md bg-green-50 p-4 border border-green-200">
            <div class="flex">
                <i class="fa-solid fa-circle-check text-green-600 mt-0.5 mr-3"></i>
                <div class="text-sm font-medium text-green-800">@TempData["SuccessMessage"]</div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-md bg-red-50 p-4 border border-red-200">
            <div class="flex">
                <i class="fa-solid fa-circle-xmark text-red-600 mt-0.5 mr-3"></i>
                <div class="text-sm font-medium text-red-800">@TempData["ErrorMessage"]</div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="bg-white p-4 shadow sm:rounded-lg border border-gray-200">
        <form method="get" asp-action="Index" class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Mã phiếu / Ghi chú</label>
                <input type="text" name="Keyword" value="@filter.Keyword" placeholder="Tìm theo mã TRF..." class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Trạng thái</label>
                <select name="Status" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="PENDING" selected="@(filter.Status == "PENDING")">Chờ duyệt (PENDING)</option>
                    <option value="IN_TRANSIT" selected="@(filter.Status == "IN_TRANSIT")">Đang trung chuyển (IN_TRANSIT)</option>
                    <option value="RECEIVED" selected="@(filter.Status == "RECEIVED")">Đã nhận hàng (RECEIVED)</option>
                    <option value="CANCELLED" selected="@(filter.Status == "CANCELLED")">Đã hủy (CANCELLED)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Kho xuất (Nguồn)</label>
                <select name="SourceStoreId" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    <option value="">-- Tất cả kho nguồn --</option>
                    @foreach (var s in stores)
                    {
                        <option value="@s.Id" selected="@(filter.SourceStoreId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="flex items-end space-x-2">
                <button type="submit" class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700">
                    <i class="fa-solid fa-filter mr-2"></i>Lọc
                </button>
                <a asp-action="Index" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <i class="fa-solid fa-rotate-left mr-1"></i>Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table Card -->
    <div class="bg-white shadow sm:rounded-lg overflow-hidden border border-gray-200">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-300">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="py-3.5 pl-4 pr-3 text-left text-xs font-semibold text-gray-900 uppercase">Mã phiếu</th>
                        <th class="px-3 py-3.5 text-left text-xs font-semibold text-gray-900 uppercase">Kho xuất -> Kho nhận</th>
                        <th class="px-3 py-3.5 text-center text-xs font-semibold text-gray-900 uppercase">Số lượng</th>
                        <th class="px-3 py-3.5 text-center text-xs font-semibold text-gray-900 uppercase">Trạng thái</th>
                        <th class="px-3 py-3.5 text-left text-xs font-semibold text-gray-900 uppercase">Người tạo / Ngày</th>
                        <th class="relative py-3.5 pl-3 pr-4 sm:pr-6 text-center text-xs font-semibold text-gray-900 uppercase">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-8 text-sm text-gray-500 italic">
                                Không có phiếu chuyển kho nào phù hợp điều kiện lọc.
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm">
                                <a asp-action="Details" asp-route-id="@t.Id" class="font-mono font-bold text-indigo-600 hover:text-indigo-900">
                                    @t.TransferCode
                                </a>
                                @if (!string.IsNullOrEmpty(t.Note))
                                {
                                    <div class="text-xs text-gray-500 truncate max-w-xs mt-0.5">@t.Note</div>
                                }
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900">
                                <div class="font-medium text-gray-900">@t.SourceStoreName</div>
                                <div class="text-xs text-indigo-600 font-semibold flex items-center mt-0.5">
                                    <i class="fa-solid fa-arrow-down-long mr-1"></i>@t.DestinationStoreName
                                </div>
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-center">
                                <span class="font-semibold text-gray-900">@t.TotalRequestedQuantity</span>
                                @if (t.Status == "IN_TRANSIT" || t.Status == "RECEIVED")
                                {
                                    <span class="text-xs text-gray-500 block">Đã xuất: @t.TotalSentQuantity</span>
                                }
                                @if (t.Status == "RECEIVED")
                                {
                                    <span class="text-xs text-green-600 block">Đã nhận: @t.TotalReceivedQuantity</span>
                                    @if (t.TotalShortageQuantity > 0)
                                    {
                                        <span class="text-xs text-red-600 font-bold block">Thiếu: -@t.TotalShortageQuantity</span>
                                    }
                                }
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-center">
                                @if (t.Status == "PENDING")
                                {
                                    <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">
                                        <i class="fa-regular fa-clock mr-1 mt-0.5"></i>Chờ duyệt xuất
                                    </span>
                                }
                                else if (t.Status == "IN_TRANSIT")
                                {
                                    <span class="inline-flex rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-800">
                                        <i class="fa-solid fa-truck-fast mr-1 mt-0.5"></i>Đang trung chuyển
                                    </span>
                                }
                                else if (t.Status == "RECEIVED")
                                {
                                    <span class="inline-flex rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-800">
                                        <i class="fa-solid fa-check-double mr-1 mt-0.5"></i>Đã nhập kho
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-800">
                                        Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-xs text-gray-500">
                                <div class="font-medium text-gray-800">@t.CreatedByUserName</div>
                                <div>@t.RequestedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="whitespace-nowrap py-4 pl-3 pr-4 text-center text-sm font-medium sm:pr-6">
                                <a asp-action="Details" asp-route-id="@t.Id" class="inline-flex items-center rounded bg-indigo-50 px-2.5 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-100">
                                    Chi tiết<i class="fa-solid fa-chevron-right ml-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
