@model Omnichannel.Application.DTOs.Sales.OrderSuccessViewModel
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="beauty-card p-4 p-md-5 text-center mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; background: #ECFDF5; color: #059669; font-size: 32px;">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h4 class="fw-bold text-dark mb-1">Đặt Hàng Thành Công!</h4>
                <p class="text-muted small mb-3">Mã đơn hàng của bạn: <strong class="text-purple font-monospace fs-6" style="color: var(--primary-purple);">@Model.OrderId</strong></p>

                <div class="badge px-3 py-2 rounded-pill mb-4" id="orderStatusBadge" style="background: var(--primary-purple-light); color: var(--primary-purple); font-size: 12.5px;">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Trạng thái: <strong>@(Model.PaymentStatus == 2 ? "Đã thanh toán" : "Đang chờ thanh toán (Đã khóa tồn)")</strong>
                </div>

                @if (Model.PaymentMethod == 2 && Model.VietQr != null)
                {
                    <div class="p-4 rounded-4 border border-2 border-purple-subtle mx-auto text-center" style="max-width: 460px; background: #FAF5FF;">
                        <h6 class="fw-bold text-dark mb-1"><i class="fa-solid fa-qrcode text-pink me-2" style="color: var(--accent-pink);"></i>Quét Mã VietQR Để Thanh Toán</h6>
                        <p class="text-muted small mb-3">Mở ứng dụng Ngân hàng bất kỳ (MB, VCB, Techcombank...) để quét mã</p>

                        <div class="bg-white p-2 rounded-3 shadow-sm d-inline-block mb-3 border">
                            <img src="@Model.VietQr.QrImageUrl" alt="VietQR Payment" class="img-fluid" style="width: 260px; height: 260px; object-fit: contain;" />
                        </div>

                        <div class="text-start bg-white p-3 rounded-3 border small mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Ngân hàng:</span>
                                <strong class="text-dark">@Model.VietQr.BankName</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Số tài khoản:</span>
                                <strong class="font-monospace text-purple" style="color: var(--primary-purple);">@Model.VietQr.BankAccountNo</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Chủ tài khoản:</span>
                                <strong class="text-dark">@Model.VietQr.AccountName</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Số tiền:</span>
                                <strong class="font-monospace text-danger fs-6">@Model.VietQr.Amount.ToString("N0") đ</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Nội dung chuyển khoản:</span>
                                <strong class="font-monospace text-dark">@Model.VietQr.OrderInfo</strong>
                            </div>
                        </div>

                        <!-- Đồng hồ đếm ngược 15 phút -->
                        <div class="small fw-semibold text-danger">
                            <i class="fa-solid fa-stopwatch me-1"></i>Hạn khóa giữ hàng còn lại: <span id="countdownTimer" class="font-monospace">15:00</span>
                        </div>

                        <div class="mt-3">
                            <!-- Nút Test mô phỏng Webhook thành công dành cho Developer/Demo -->
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="simulateBankPayment('@Model.OrderId', @Model.FinalTotal)">
                                <i class="fa-solid fa-vial me-1"></i>[Demo] Giả lập Ngân Hàng Xác Nhận
                            </button>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a href="/" class="btn btn-soft-purple px-4 py-2">Tiếp Tục Mua Sắm</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Đồng hồ đếm ngược 15 phút (900 giây)
        let timeLeft = 900;
        const timerEl = document.getElementById('countdownTimer');

        if (timerEl) {
            const timer = setInterval(() => {
                timeLeft--;
                const min = Math.floor(timeLeft / 60).toString().padStart(2, '0');
                const sec = (timeLeft % 60).toString().padStart(2, '0');
                timerEl.innerText = `${min}:${sec}`;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    timerEl.innerText = 'Hết hạn khóa tồn!';
                }
            }, 1000);
        }

        // 2. Tự động kiểm tra trạng thái đơn hàng (Polling mỗi 3 giây)
        const checkPoll = setInterval(async () => {
            try {
                const res = await fetch(`/Checkout/CheckOrderStatus?orderId=@Model.OrderId`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.isPaid) {
                        clearInterval(checkPoll);
                        const badge = document.getElementById('orderStatusBadge');
                        badge.className = 'badge px-3 py-2 rounded-pill mb-4 bg-success text-white';
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>ĐÃ THANH TOÁN THÀNH CÔNG (ĐÃ CHỐT TRỪ KHO & XUẤT HÓA ĐƠN)';
                        alert('Xác nhận thanh toán thành công! Tồn kho đã được chốt trừ và phát hành hóa đơn VAT.');
                    }
                }
            } catch (e) {
                console.error(e);
            }
        }, 3000);

        // 3. Hàm Giả lập Webhook thanh toán (Phục vụ Demo nghiệm thu)
        async function simulateBankPayment(orderId, amount) {
            const res = await fetch('/Checkout/MockBankWebhook', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    orderId: orderId,
                    amount: amount,
                    transactionRef: 'MB-' + Date.now(),
                    status: 'SUCCESS'
                })
            });

            const data = await res.json();
            if (data.success) {
                console.log(data.message);
            }
        }
    </script>
}