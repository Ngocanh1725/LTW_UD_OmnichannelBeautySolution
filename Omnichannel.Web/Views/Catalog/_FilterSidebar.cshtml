@model Omnichannel.Web.Models.CategoryViewModel

@*
    Omnichannel Beauty Suite - Clean Beauty & Faceted Filter Sidebar Partial (_FilterSidebar.cshtml)
    Học hỏi từ Paula's Choice & Watsons Clean Beauty
*@

<aside class="bg-white p-6 rounded-3xl border border-soft-border/90 shadow-xs sticky top-24 select-none">
    
    <!-- Filter Header -->
    <div class="flex items-center justify-between pb-4 border-b border-soft-border mb-6">
        <h3 class="font-serif font-bold text-charcoal text-base flex items-center gap-2">
            <i class="fa-solid fa-sliders text-magenta-accent text-sm"></i>
            <span>Bộ Lọc Đa Tiêu Chí</span>
        </h3>
        <button type="button" 
                onclick="resetFacetedFilter()" 
                class="text-[11px] text-magenta-accent hover:underline font-semibold flex items-center gap-1 cursor-pointer">
            <i class="fa-solid fa-arrows-rotate text-[10px]"></i> Đặt lại
        </button>
    </div>

    <form id="facetedFilterForm" 
          hx-get="/category/@Model.CategorySlug" 
          hx-push-url="true"
          hx-target="#categoryProductsContainer" 
          hx-swap="innerHTML"
          hx-indicator="#filterSkeletonLoader"
          class="space-y-6 text-xs">
        
        <!-- Hidden inputs for state management -->
        <input type="hidden" name="sort" id="hiddenSortInput" value="@Model.Sort" />
        <input type="hidden" name="viewMode" id="hiddenViewMode" value="@Model.ViewMode" />
        <input type="hidden" name="page" id="hiddenPageInput" value="1" />

        <!-- 1. LỌC CLEAN BEAUTY (Học hỏi Paula's Choice & Watsons) -->
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h4 class="font-bold text-charcoal uppercase tracking-wider text-[11px] flex items-center gap-1.5">
                    <i class="fa-solid fa-leaf text-emerald-600"></i> Tiêu Chuẩn Clean Beauty
                </h4>
                <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">Thuần Khiết</span>
            </div>

            <div class="space-y-2">
                <!-- Không cồn khô -->
                <label class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-emerald-50/50 cursor-pointer transition">
                    <input type="checkbox" 
                           name="isAlcoholFree" 
                           value="true" 
                           @(Model.IsAlcoholFree ? "checked" : "")
                           onchange="submitFacetedFilter()"
                           class="rounded text-emerald-600 focus:ring-emerald-500 border-slate-300" />
                    <span class="text-slate-700 font-medium text-xs flex items-center gap-1.5">
                        <i class="fa-solid fa-shield-check text-emerald-600 text-xs"></i>
                        <span>Không Cồn Khô (Alcohol-Free)</span>
                    </span>
                </label>

                <!-- Không hương liệu -->
                <label class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-pink-50/50 cursor-pointer transition">
                    <input type="checkbox" 
                           name="isFragranceFree" 
                           value="true" 
                           @(Model.IsFragranceFree ? "checked" : "")
                           onchange="submitFacetedFilter()"
                           class="rounded text-magenta-accent focus:ring-magenta-accent border-slate-300" />
                    <span class="text-slate-700 font-medium text-xs flex items-center gap-1.5">
                        <i class="fa-solid fa-feather text-pink-500 text-xs"></i>
                        <span>Không Hương Liệu (Fragrance-Free)</span>
                    </span>
                </label>

                <!-- An toàn mẹ bầu -->
                <label class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-purple-50/50 cursor-pointer transition">
                    <input type="checkbox" 
                           name="isPregnancySafe" 
                           value="true" 
                           @(Model.IsPregnancySafe ? "checked" : "")
                           onchange="submitFacetedFilter()"
                           class="rounded text-purple-600 focus:ring-purple-500 border-slate-300" />
                    <span class="text-slate-700 font-medium text-xs flex items-center gap-1.5">
                        <i class="fa-solid fa-baby text-purple-500 text-xs"></i>
                        <span>An Toàn Mẹ Bầu (Pregnancy-Safe)</span>
                    </span>
                </label>
            </div>
        </div>

        <div class="border-t border-slate-100"></div>

        <!-- 2. LỌC THEO HẠN DÙNG FEFO -->
        <div class="space-y-3">
            <h4 class="font-bold text-charcoal uppercase tracking-wider text-[11px] flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left text-magenta-accent"></i> Hạn Dùng FEFO
                </span>
                <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-bold border border-emerald-200">GSP Chuẩn Y Khoa</span>
            </h4>

            <div class="space-y-1.5">
                <label class="flex items-center justify-between p-2 rounded-xl border cursor-pointer transition text-xs @(Model.FefoOption == "all" ? "bg-pastel-rose/80 border-magenta-accent font-bold text-charcoal" : "border-slate-100 hover:bg-slate-50 text-slate-600")">
                    <div class="flex items-center gap-2">
                        <input type="radio" name="fefo" value="all" @(Model.FefoOption == "all" ? "checked" : "") onchange="submitFacetedFilter()" class="hidden" />
                        <span>Tất cả hạn dùng</span>
                    </div>
                </label>
                <label class="flex items-center justify-between p-2 rounded-xl border cursor-pointer transition text-xs @(Model.FefoOption == "fresh" ? "bg-pastel-rose/80 border-magenta-accent font-bold text-charcoal" : "border-slate-100 hover:bg-slate-50 text-slate-600")">
                    <div class="flex items-center gap-2">
                        <input type="radio" name="fefo" value="fresh" @(Model.FefoOption == "fresh" ? "checked" : "") onchange="submitFacetedFilter()" class="hidden" />
                        <span class="text-emerald-700 font-semibold">Date mới >18 tháng</span>
                    </div>
                    <span class="text-[10px] text-emerald-600">Lô mới</span>
                </label>
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" 
                class="w-full py-3 rounded-2xl bg-gradient-to-r from-magenta-accent to-rose-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-md hover:shadow-lg transition">
            Áp Dụng Bộ Lọc
        </button>
    </form>
</aside>

