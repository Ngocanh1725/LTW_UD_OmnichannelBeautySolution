@model Omnichannel.Web.Models.BlogDetailViewModel
@{
    var post = Model.Post;
    ViewData["Title"] = $"{post.Title} - Cẩm Nang Làm Đẹp Canmake Beauty";
    ViewData["Description"] = post.Summary ?? post.Title;
    var postImg = !string.IsNullOrEmpty(post.ThumbnailUrl) ? post.ThumbnailUrl : "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1200&fit=crop";
}

<div class="bg-[#fffdfd] min-h-screen py-8 sm:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- 1. BREADCRUMB -->
        <nav aria-label="Đường dẫn bài viết" class="mb-6 text-xs text-slate-500 flex items-center gap-2 flex-wrap">
            <a href="/" class="hover:text-magenta-accent transition flex items-center gap-1">
                <i class="fa-solid fa-house text-slate-400"></i> Trang Chủ
            </a>
            <span class="text-slate-300">/</span>
            <a href="/Blog" class="hover:text-magenta-accent transition">
                Cẩm Nang Sắc Đẹp
            </a>
            <span class="text-slate-300">/</span>
            @if (post.PostCategory != null)
            {
                <a href="/Blog?category=@post.PostCategory.Slug" class="hover:text-magenta-accent transition">
                    @post.PostCategory.Name
                </a>
                <span class="text-slate-300">/</span>
            }
            <span class="text-charcoal font-semibold truncate max-w-[200px]">@post.Title</span>
        </nav>

        <!-- 2. ARTICLE HEADER -->
        <header class="space-y-4 mb-8 text-center sm:text-left">
            @if (post.PostCategory != null)
            {
                <a href="/Blog?category=@post.PostCategory.Slug" class="inline-block px-3 py-1 rounded-full bg-pastel-rose text-magenta-accent font-bold text-xs border border-soft-border uppercase tracking-wider">
                    @post.PostCategory.Name
                </a>
            }

            <h1 class="font-serif font-bold text-3xl sm:text-4xl lg:text-5xl text-charcoal leading-tight">
                @post.Title
            </h1>

            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-xs text-slate-500 pt-2 border-y border-soft-border py-3">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-charcoal text-white font-bold flex items-center justify-center text-[10px]">
                        @(post.Author?.FullName?.Substring(0, 1) ?? "B")
                    </div>
                    <span class="font-bold text-charcoal">@(post.Author?.FullName ?? "Ban Biên Tập Canmake Beauty")</span>
                </div>
                <span>•</span>
                <span><i class="fa-regular fa-calendar me-1"></i>@(post.PublishedAt?.ToString("dd/MM/yyyy") ?? post.CreatedAt.ToString("dd/MM/yyyy"))</span>
                <span>•</span>
                <span><i class="fa-regular fa-eye me-1"></i>@post.ViewCount lượt xem</span>
                <span>•</span>
                <span><i class="fa-regular fa-clock me-1"></i>~5 phút đọc</span>
            </div>
        </header>

        <!-- 3. FEATURED IMAGE -->
        <div class="rounded-3xl overflow-hidden mb-10 border border-soft-border shadow-md">
            <img src="@postImg" alt="@post.Title" loading="lazy" decoding="async" class="w-full max-h-[500px] object-cover" />
        </div>

        <!-- 4. LEAD SUMMARY -->
        @if (!string.IsNullOrEmpty(post.Summary))
        {
            <div class="p-6 sm:p-8 rounded-3xl bg-pastel-rose/50 border border-soft-border mb-10 text-sm sm:text-base text-slate-700 italic font-serif leading-relaxed">
                <i class="fa-solid fa-quote-left text-rose-gold text-xl mr-2"></i>
                @post.Summary
            </div>
        }

        <!-- 5. MAIN RICH TEXT ARTICLE BODY -->
        <article class="bg-white p-6 sm:p-10 rounded-3xl border border-soft-border shadow-xs leading-relaxed text-slate-700 font-sans space-y-6 text-sm sm:text-base article-body">
            @Html.Raw(post.Content)
        </article>

        <!-- 6. AUTHOR BIO & SOCIAL SHARE -->
        <div class="mt-10 p-6 rounded-3xl bg-white border border-soft-border flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-4 text-center sm:text-left">
                <div class="w-14 h-14 rounded-full bg-pastel-rose text-magenta-accent font-bold flex items-center justify-center text-xl shrink-0">
                    @(post.Author?.FullName?.Substring(0, 1) ?? "B")
                </div>
                <div>
                    <h4 class="font-serif font-bold text-charcoal text-sm">@(post.Author?.FullName ?? "Ban Biên Tập Canmake Beauty")</h4>
                    <p class="text-xs text-slate-500 mt-0.5">Chuyên gia cố vấn da liễu & biên tập viên làm đẹp chính ngạch</p>
                </div>
            </div>

            <!-- Social Share -->
            <div class="flex items-center gap-2" x-data="{ copied: false }">
                <span class="text-xs font-bold text-slate-400 mr-2">Chia sẻ:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u=@Context.Request.Scheme://@Context.Request.Host@Context.Request.Path" target="_blank" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-[#1877F2] hover:text-white flex items-center justify-center text-slate-600 transition" title="Chia sẻ Facebook">
                    <i class="fa-brands fa-facebook-f text-xs"></i>
                </a>
                <button type="button" 
                        @@click="navigator.clipboard.writeText(window.location.href); copied = true; setTimeout(() => copied = false, 2500)" 
                        class="px-3.5 py-2 rounded-full bg-slate-100 hover:bg-charcoal hover:text-white text-xs font-bold text-slate-600 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-link text-xs"></i>
                    <span x-text="copied ? 'Đã chép link!' : 'Copy link'">Copy link</span>
                </button>
            </div>
        </div>

        <!-- 7. RECOMMENDED PRODUCTS IN ARTICLE -->
        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <div class="mt-16 pt-10 border-t border-soft-border">
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-widest text-rose-gold">Gợi Ý Sản Phẩm Phù Hợp</span>
                        <h2 class="font-serif text-2xl font-bold text-charcoal mt-1">Sản Phẩm Được Nhắc Đến Trong Bài</h2>
                    </div>
                    <a href="/Product/Search" class="text-xs font-bold text-magenta-accent hover:underline">Xem thêm sản phẩm</a>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    @foreach (var prod in Model.RelatedProducts)
                    {
                        var pImg = !string.IsNullOrEmpty(prod.ThumbnailUrl) ? prod.ThumbnailUrl : "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=300&fit=crop";
                        <div class="bg-white p-3 rounded-2xl border border-soft-border shadow-xs hover:shadow-md transition text-center group">
                            <a href="/Product/Detail/@prod.Slug" class="block aspect-square overflow-hidden rounded-xl mb-2">
                                <img src="@pImg" alt="@prod.Name" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                            </a>
                            <a href="/Product/Detail/@prod.Slug" class="block">
                                <h4 class="font-serif text-xs font-bold text-charcoal line-clamp-1 group-hover:text-magenta-accent">@prod.Name</h4>
                            </a>
                            <div class="font-mono-numeric font-bold text-magenta-accent text-xs mt-1">
                                @prod.SellingPrice.ToString("N0") ₫
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 8. RELATED POSTS -->
        @if (Model.RelatedPosts != null && Model.RelatedPosts.Any())
        {
            <div class="mt-16 pt-10 border-t border-soft-border">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-8">Bài Viết Cùng Chuyên Mục</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @foreach (var rel in Model.RelatedPosts)
                    {
                        var rImg = !string.IsNullOrEmpty(rel.ThumbnailUrl) ? rel.ThumbnailUrl : "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=400&fit=crop";
                        <article class="bg-white rounded-2xl border border-soft-border overflow-hidden shadow-xs hover:shadow-md transition group flex flex-col">
                            <a href="/Blog/@rel.Slug" class="block aspect-[16/10] overflow-hidden">
                                <img src="@rImg" alt="@rel.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                            </a>
                            <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                                <a href="/Blog/@rel.Slug" class="block">
                                    <h3 class="font-serif text-xs font-bold text-charcoal line-clamp-2 group-hover:text-magenta-accent">
                                        @rel.Title
                                    </h3>
                                </a>
                                <div class="text-[10px] text-slate-400">
                                    @(rel.PublishedAt?.ToString("dd/MM/yyyy") ?? rel.CreatedAt.ToString("dd/MM/yyyy"))
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }

    </div>
</div>
