@model Omnichannel.Application.DTOs.Sales.CartViewModel
@{
    var vm = Model ?? new Omnichannel.Application.DTOs.Sales.CartViewModel();
    decimal freeShippingThreshold = 500000;
    decimal remaining = Math.Max(0, freeShippingThreshold - vm.SubTotal);
    decimal progress = vm.SubTotal >= freeShippingThreshold ? 100 : (freeShippingThreshold > 0 ? (vm.SubTotal / freeShippingThreshold * 100) : 100);
}

<!-- Synchronize count badge and header total in Header via HTMX OOB Swapping -->
<span id="miniCartCountBadge" hx-swap-oob="true" data-cart-count class="min-w-[24px] h-[24px] px-1.5 rounded-full bg-[var(--rl-rose)] group-hover:bg-white group-hover:text-[var(--rl-rose)] text-white text-xs font-extrabold font-mono-numeric flex items-center justify-center transition-colors">@vm.TotalItems</span>
<span id="miniCartHeaderTotal" hx-swap-oob="true" class="text-xs font-bold font-mono-numeric tracking-wide">@vm.SubTotal.ToString("N0") ₫</span>

<!-- 1. THANH TIẾN ĐỘ FREESHIP THÔNG MINH (Rosé Luxe Gradient) -->
<div class="p-4 bg-gradient-to-r from-[var(--rl-bg-blush)] via-white to-[var(--rl-bg-petal)]/40 border-b border-[var(--rl-border-subtle)] shrink-0">
    <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs font-semibold">
            @if (remaining > 0)
            {
                <span class="flex items-center gap-1.5 text-[var(--rl-ink)]">
                    <i class="fa-solid fa-truck-fast text-[var(--rl-rose)]" aria-hidden="true"></i>
                    <span>Còn <strong class="text-[var(--rl-rose)] font-mono-numeric font-bold">@remaining.ToString("N0") ₫</strong> để được <strong class="text-[var(--rl-ink)] uppercase">FREESHIP TOÀN QUỐC! ✦</strong></span>
                </span>
            }
            else
            {
                <span class="text-[var(--rl-success)] font-bold flex items-center gap-1.5">
                    <i class="fa-solid fa-shield-heart text-sm" aria-hidden="true"></i>
                    <span>Chúc mừng! Bạn đã đạt mức <strong class="uppercase text-[var(--rl-success)]">FREESHIP TOÀN QUỐC! ✦</strong></span>
                </span>
            }
            <span class="font-mono-numeric font-bold text-[11px] @(remaining == 0 ? "text-[var(--rl-success)]" : "text-[var(--rl-mauve)]")">
                @progress.ToString("0")%
            </span>
        </div>
        
        <!-- Progress Bar Track -->
        <div class="h-2 rounded-full overflow-hidden bg-[var(--rl-bg-petal)]/50 p-0.5 shadow-inner">
            <div class="h-full rounded-full transition-all duration-500 @(remaining == 0 ? "bg-[var(--rl-success)] shadow-sm" : "bg-gradient-to-r from-[var(--rl-rose)] via-[#D35B89] to-[var(--rl-champagne)] shadow-sm")" 
                 style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
            </div>
        </div>
    </div>
</div>

<!-- 2. DANH SÁCH SẢN PHẨM TRONG GIỎ (SCROLLABLE LIST) -->
<div class="flex-1 overflow-y-auto p-4 space-y-3">
    @if (vm.Items == null || !vm.Items.Any())
    {
        <!-- Empty Cart State -->
        <div class="text-center py-16 text-[var(--rl-mauve)] flex flex-col items-center justify-center space-y-3">
            <div class="w-16 h-16 rounded-full bg-[var(--rl-bg-blush)] flex items-center justify-center text-[var(--rl-rose)] text-2xl shadow-inner">
                <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
            </div>
            <h4 class="font-serif text-sm font-bold text-[var(--rl-ink)]">Giỏ hàng của bạn đang trống</h4>
            <p class="text-xs text-[var(--rl-mauve)] max-w-xs leading-relaxed">Khám phá các sản phẩm mỹ phẩm chính hãng cam kết date mới ngay!</p>
            <button type="button" 
                    @@click="cartOpen = false" 
                    class="btn-primary mt-2 min-h-[44px] px-6 py-2.5 rounded-full text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all cursor-pointer">
                Tiếp Tục Mua Sắm
            </button>
        </div>
    }
    else
    {
        @foreach (var item in vm.Items)
        {
            var itemImg = ProductImageResolver.GetThumbnailImageUrl(item.ProductImageUrl, item.ProductSku, null, item.ProductName);
            var itemWebp = ProductImageResolver.GetWebpImageUrl(itemImg, item.ProductSku, null, item.ProductName);
            var itemAlt = ProductImageResolver.GetAltText(item.ProductName, null, null, item.ProductSku, null);
            
            <div class="flex gap-3 items-center p-3 rounded-2xl bg-white border border-[var(--rl-border-subtle)] shadow-[var(--rl-shadow-xs)] relative group hover:border-[var(--rl-rose)]/40 transition-all">
                <!-- Thumbnail -->
                <picture class="shrink-0">
                    <source srcset="@itemWebp" type="image/webp" />
                    <img src="@itemImg" 
                         alt="@itemAlt" 
                         width="64"
                         height="64"
                         decoding="async"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';"
                         class="rounded-xl w-16 h-16 object-cover border border-[var(--rl-border-subtle)] shrink-0 shadow-2xs" />
                </picture>
                
                <!-- Information -->
                <div class="flex-1 min-w-0 pr-1">
                    <h5 class="font-serif font-bold text-[var(--rl-ink)] text-xs truncate leading-snug hover:text-[var(--rl-rose)] transition" title="@item.ProductName">
                        <a href="/Product/Detail/@item.ProductId">@item.ProductName</a>
                    </h5>
                    
                    @if (!string.IsNullOrEmpty(item.NearestExpDateStr))
                    {
                        <div class="mt-0.5">
                            <span class="inline-flex items-center rounded-md bg-[var(--rl-bg-blush)] px-1.5 py-0.5 text-[9px] font-semibold text-[var(--rl-rose)] border border-[var(--rl-border-subtle)]">
                                <i class="fa-solid fa-clock mr-1 text-[8px] text-[var(--rl-champagne-deep)]" aria-hidden="true"></i> HSD: @item.NearestExpDateStr
                            </span>
                        </div>
                    }

                    <div class="flex items-baseline gap-2 mt-1">
                        <span class="font-bold text-[var(--rl-rose)] text-xs font-mono-numeric">@item.UnitPrice.ToString("N0") ₫</span>
                        @if (item.Quantity > 1)
                        {
                            <span class="text-[10px] text-[var(--rl-mauve)] font-mono-numeric">(= @item.LineTotal.ToString("N0") ₫)</span>
                        }
                    </div>
                </div>
                
                <!-- Actions: Delete & Quantity Stepper -->
                <div class="flex flex-col items-end justify-between self-stretch shrink-0">
                    <!-- Nút Xóa Sản Phẩm -->
                    <button type="button" 
                            hx-post="/Cart/RemoveItem" 
                            hx-ext="json-enc" 
                            hx-vals='{"productId": "@item.ProductId"}'
                            hx-trigger="click"
                            hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')"
                            class="min-w-[32px] min-h-[32px] flex items-center justify-center text-[var(--rl-mauve)] hover:text-rose-600 transition p-1 cursor-pointer"
                            title="Xóa khỏi giỏ hàng"
                            aria-label="Xóa khỏi giỏ hàng">
                        <i class="fa-regular fa-trash-can text-xs" aria-hidden="true"></i>
                    </button>
                    
                    <!-- Stepper Tăng/Giảm Số Lượng (+ / -) Cập Nhật Tức Thì Qua AJAX -->
                    <div class="flex items-center gap-1 bg-[var(--rl-bg-blush)]/70 rounded-full p-0.5 border border-[var(--rl-border-subtle)] mt-2">
                        <!-- Decrement Button -->
                        <button type="button" 
                                class="w-6 h-6 flex items-center justify-center text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-white rounded-full transition cursor-pointer"
                                hx-post="/Cart/UpdateQuantity" 
                                hx-ext="json-enc" 
                                hx-vals='{"productId": "@item.ProductId", "delta": -1}' 
                                hx-trigger="click" 
                                hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')"
                                aria-label="Giảm số lượng">
                            <i class="fa-solid fa-minus text-[8px]" aria-hidden="true"></i>
                        </button>
                        
                        <span class="text-xs font-bold text-[var(--rl-ink)] w-5 text-center font-mono-numeric">@item.Quantity</span>
                        
                        <!-- Increment Button -->
                        <button type="button" 
                                class="w-6 h-6 flex items-center justify-center text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-white rounded-full transition cursor-pointer"
                                hx-post="/Cart/UpdateQuantity" 
                                hx-ext="json-enc" 
                                hx-vals='{"productId": "@item.ProductId", "delta": 1}' 
                                hx-trigger="click" 
                                hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')"
                                aria-label="Tăng số lượng">
                            <i class="fa-solid fa-plus text-[8px]" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- 3. VOUCHER GIẢM GIÁ GỢI Ý & TỔNG TIỀN TẠM TÍNH & 2 NÚT HÀNH ĐỘNG -->
@if (vm.Items != null && vm.Items.Any())
{
    <div class="p-4 border-t border-[var(--rl-border-subtle)] bg-[var(--rl-surface)] space-y-3.5 shrink-0" x-data="{
        couponInput: '',
        couponMsg: '',
        isApplying: false,
        applyVoucher(code) {
            this.couponInput = code;
            this.submitCoupon();
        },
        submitCoupon() {
            if (!this.couponInput) return;
            this.isApplying = true;
            this.couponMsg = '';
            fetch('/Cart/ApplyCoupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponCode: this.couponInput })
            })
            .then(r => r.json())
            .then(data => {
                this.isApplying = false;
                if (data.success) {
                    showStorefrontToast(data.message, 'success');
                    if (window.htmx) {
                        htmx.trigger('body', 'reloadMiniCart');
                    }
                } else {
                    this.couponMsg = data.message;
                    showStorefrontToast(data.message, 'warning');
                }
            })
            .catch(() => {
                this.isApplying = false;
                showStorefrontToast('Lỗi áp dụng voucher, vui lòng thử lại', 'error');
            });
        }
    }">
        
        <!-- Voucher Giảm Giá Gợi Ý (Quick Coupon Box) -->
        <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px]">
                <span class="font-bold text-[var(--rl-ink)] flex items-center gap-1.5">
                    <i class="fa-solid fa-ticket text-[var(--rl-champagne-deep)]" aria-hidden="true"></i> Voucher Gợi Ý Cho Bạn:
                </span>
                <span class="text-[var(--rl-rose)] font-semibold cursor-pointer hover:underline" @@click="applyVoucher('BEAUTY50K')">
                    Dùng mã 50K
                </span>
            </div>

            <!-- Voucher Chip Button -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
                <button type="button" 
                        @@click="applyVoucher('BEAUTY50K')"
                        class="px-2.5 py-1 rounded-full border border-dashed border-[var(--rl-rose)]/60 bg-[var(--rl-bg-blush)] text-[var(--rl-rose)] text-[10px] font-bold flex items-center gap-1 hover:bg-[var(--rl-bg-petal)] transition shrink-0 cursor-pointer">
                    <i class="fa-solid fa-tag text-[9px]" aria-hidden="true"></i> BEAUTY50K (-50.000₫)
                </button>
                <button type="button" 
                        @@click="applyVoucher('FREESHIP')"
                        class="px-2.5 py-1 rounded-full border border-dashed border-[var(--rl-success)]/60 bg-emerald-50 text-[var(--rl-success)] text-[10px] font-bold flex items-center gap-1 hover:bg-emerald-100 transition shrink-0 cursor-pointer">
                    <i class="fa-solid fa-truck-fast text-[9px]" aria-hidden="true"></i> FREESHIP (-30.000₫)
                </button>
            </div>

            <!-- Input Box -->
            <div class="flex gap-1.5">
                <input type="text" 
                       x-model="couponInput" 
                       placeholder="Nhập mã ưu đãi..." 
                       aria-label="Nhập mã ưu đãi"
                       class="flex-1 px-3 py-2 rounded-xl border border-[var(--rl-border-subtle)] text-xs focus:outline-none focus:border-[var(--rl-rose)] uppercase font-mono font-bold bg-white" />
                <button type="button" 
                        @@click="submitCoupon()"
                        :disabled="isApplying"
                        class="min-h-[38px] px-3.5 py-1.5 rounded-xl bg-[var(--rl-ink)] hover:bg-[var(--rl-rose)] text-white font-bold text-xs transition shrink-0 cursor-pointer disabled:opacity-50">
                    <span x-show="!isApplying">Áp Dụng</span>
                    <span x-show="isApplying"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i></span>
                </button>
            </div>
            <div x-show="couponMsg" x-text="couponMsg" class="text-[10px] text-rose-600 font-medium"></div>
        </div>

        <!-- Tóm Tắt Chi Phí -->
        <div class="space-y-1.5 pt-2 border-t border-[var(--rl-border-subtle)] text-xs">
            <div class="flex items-center justify-between text-[var(--rl-mauve)]">
                <span>Tạm tính (@vm.TotalItems sản phẩm):</span>
                <span class="font-bold text-[var(--rl-ink)] font-mono-numeric">@vm.SubTotal.ToString("N0") ₫</span>
            </div>

            @if (vm.DiscountAmount > 0)
            {
                <div class="flex items-center justify-between text-[var(--rl-success)]">
                    <span class="flex items-center gap-1"><i class="fa-solid fa-ticket" aria-hidden="true"></i> Voucher giảm giá:</span>
                    <span class="font-bold font-mono-numeric">-@vm.DiscountAmount.ToString("N0") ₫</span>
                </div>
            }

            <div class="flex items-center justify-between text-[var(--rl-mauve)]">
                <span>Phí vận chuyển:</span>
                <span class="font-bold @(remaining == 0 ? "text-[var(--rl-success)]" : "text-[var(--rl-ink)]") font-mono-numeric">
                    @(remaining == 0 ? "Miễn phí" : "30.000 ₫")
                </span>
            </div>

            <div class="flex items-center justify-between text-sm pt-1 border-t border-dashed border-[var(--rl-border-subtle)]">
                <span class="font-bold text-[var(--rl-ink)] font-serif">Tổng thanh toán:</span>
                <span class="font-extrabold text-[var(--rl-rose)] font-mono-numeric text-base sm:text-lg">@vm.FinalTotal.ToString("N0") ₫</span>
            </div>
        </div>

        <!-- 2 NÚT HÀNH ĐỘNG NỔI BẬT: Xem Chi Tiết Giỏ Hàng & Thanh Toán Nhanh -->
        <div class="grid grid-cols-2 gap-2.5 pt-1">
            <!-- Nút 1: Xem Chi Tiết Giỏ Hàng -->
            <a href="/Cart" 
               class="btn-ghost min-h-[44px] py-2.5 px-3 rounded-full text-[var(--rl-ink)] font-bold text-xs uppercase tracking-wider text-center transition flex items-center justify-center gap-1.5 border border-[var(--rl-border-subtle)]">
                <i class="fa-solid fa-bag-shopping text-[var(--rl-champagne-deep)] text-xs" aria-hidden="true"></i>
                <span>Xem Giỏ Hàng</span>
            </a>

            <!-- Nút 2: Thanh Toán Nhanh -->
            <a href="/Checkout" 
               class="btn-primary min-h-[44px] py-2.5 px-3 rounded-full text-white font-bold text-xs uppercase tracking-wider text-center transition flex items-center justify-center gap-1.5 shadow-md">
                <i class="fa-solid fa-bolt text-xs" aria-hidden="true"></i>
                <span>Thanh Toán</span>
            </a>
        </div>

    </div>
}
