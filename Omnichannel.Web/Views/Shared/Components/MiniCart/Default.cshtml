@model Omnichannel.Application.DTOs.Sales.CartViewModel

<!-- Update total count badge in Header (OOB) -->
<span id="miniCartCountBadge" hx-swap-oob="true" class="h-5 w-5 rounded-full bg-pink-500 text-white text-[11px] font-bold flex items-center justify-center -mr-1">@Model.TotalItems</span>
<span id="miniCartHeaderTotal" hx-swap-oob="true" class="text-xs font-bold font-mono-numeric">@Model.SubTotal.ToString("N0") ₫</span>

<!-- Free Shipping Progress Threshold (500,000đ) -->
@{
    decimal freeShippingThreshold = 500000;
    decimal remaining = freeShippingThreshold - Model.SubTotal;
    decimal progress = Model.SubTotal >= freeShippingThreshold ? 100 : (Model.SubTotal / freeShippingThreshold * 100);
}

<div class="p-4 bg-pink-50/50 border-b border-pink-100 shrink-0">
    <div class="free-shipping-meter">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1.5">
            @if (remaining > 0)
            {
                <span id="shippingMeterText"><i class="fa-solid fa-truck-fast text-pink-600 mr-1"></i> Mua thêm để nhận FREESHIP</span>
                <span id="shippingRemainingAmount" class="text-pink-600 font-mono-numeric">@remaining.ToString("N0") ₫</span>
            }
            else
            {
                <span id="shippingMeterText" class="text-green-600"><i class="fa-solid fa-check-circle mr-1"></i> Bạn đã đạt mức FREESHIP!</span>
            }
        </div>
        <div class="progress-fefo-container bg-pink-100/50 h-1.5 rounded-full overflow-hidden">
            <div id="shippingProgressBar" class="progress-fefo-bar bg-pink-500 h-full transition-all duration-500" style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
        </div>
    </div>
</div>

<!-- Cart Items Scrollable List -->
<div class="flex-1 overflow-y-auto p-5 space-y-4">
    @if (!Model.Items.Any())
    {
        <div class="text-center py-10 text-slate-400">
            <i class="fa-solid fa-basket-shopping text-4xl mb-3 text-pink-200"></i>
            <div class="text-sm">Chưa có sản phẩm nào.</div>
            <button type="button" @@click="cartOpen = false" class="mt-4 px-4 py-2 rounded-full bg-slate-100 text-slate-700 font-bold text-xs hover:bg-slate-200 transition">Tiếp tục mua sắm</button>
        </div>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            <div class="flex gap-3 items-center p-3 rounded-2xl bg-white border border-slate-100 shadow-sm relative group">
                <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=100&h=100&fit=crop" : item.ProductImageUrl)" alt="@item.ProductName" class="rounded-xl w-14 h-14 object-cover border border-slate-50" />
                
                <div class="flex-1 min-w-0">
                    <div class="font-bold text-slate-800 text-xs truncate pr-6">@item.ProductName</div>
                    <div class="text-[10px] text-slate-500 mt-0.5">
                        <span class="inline-flex items-center rounded-md bg-pink-50 px-1.5 py-0.5 text-[9px] font-medium text-pink-700 ring-1 ring-inset ring-pink-700/10">
                            HSD: @item.NearestExpDateStr
                        </span>
                    </div>
                    <div class="font-bold text-pink-600 text-sm mt-1 font-mono-numeric">@item.UnitPrice.ToString("N0") ₫</div>
                </div>
                
                <div class="flex flex-col items-end justify-between h-full">
                    <button type="button" 
                            hx-post="/Cart/RemoveItem" 
                            hx-ext="json-enc" 
                            hx-vals='{"productId": "@item.ProductId"}'
                            hx-trigger="click"
                            hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')"
                            class="text-slate-300 hover:text-red-500 transition p-1">
                        <i class="fa-regular fa-trash-can text-xs"></i>
                    </button>
                    <div class="flex items-center gap-2 bg-slate-50 rounded-lg p-1 border border-slate-100 mt-2">
                        <!-- Cập nhật số lượng qua AJAX -->
                        <button type="button" class="w-5 h-5 flex items-center justify-center text-slate-500 hover:text-pink-600 hover:bg-white rounded"
                                hx-post="/Cart/UpdateQuantity" hx-ext="json-enc" hx-vals='{"productId": "@item.ProductId", "delta": -1}' hx-trigger="click" hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')">
                            <i class="fa-solid fa-minus text-[8px]"></i>
                        </button>
                        <span class="text-xs font-bold text-slate-700 w-4 text-center">@item.Quantity</span>
                        <button type="button" class="w-5 h-5 flex items-center justify-center text-slate-500 hover:text-pink-600 hover:bg-white rounded"
                                hx-post="/Cart/UpdateQuantity" hx-ext="json-enc" hx-vals='{"productId": "@item.ProductId", "delta": 1}' hx-trigger="click" hx-on::after-request="if(event.detail.successful) htmx.trigger('body', 'reloadMiniCart')">
                            <i class="fa-solid fa-plus text-[8px]"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Footer Checkout Action -->
@if (Model.Items.Any())
{
    <div class="p-5 border-t border-slate-100 bg-slate-50/60 space-y-3 shrink-0">
        <div class="flex items-center justify-between text-sm">
            <span class="text-slate-500">Tạm tính:</span>
            <span class="font-bold text-slate-900 font-mono-numeric text-base">@Model.SubTotal.ToString("N0") ₫</span>
        </div>
        <div class="text-[11px] text-slate-400 italic text-center">Giá đã bao gồm thuế GTGT & miễn phí đóng gói mỹ phẩm cao cấp</div>
        <a href="/Checkout" class="w-full py-3.5 rounded-full bg-pink-600 text-white font-bold text-xs uppercase tracking-wider text-center block hover:bg-pink-700 shadow-lg shadow-pink-600/25 transition">
            Tiến Hành Đặt Hàng <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
    </div>
}