            </section>
        }
        else if (code == "FEATURED_CATEGORIES" && item.Categories.Any())
        {
            <!-- =========================================================================
                 2. FEATURED CATEGORIES SECTION (алё,тур Header + 4-Col Large Rounded Cards + Mobile Scroll-Snap)
                 ========================================================================= -->
            <section id="section-@item.Section.Id"
                     data-section-id="@item.Section.Id"
                     data-section-key="featured_categories"
                     data-section-code="@code"
                     class="section-scroll-reveal section-deferred py-12 sm:py-18 bg-[var(--rl-ivory)]">
                <div class="container-editorial">
                    <!-- Section Header алё,тур Pattern: Icon + Tiêu đề + Đường kẻ mảnh + Nút Pill -->
                    <div class="section-header-rule">
                        <span class="section-header-rule__icon" aria-hidden="true">
                            <i class="fa-solid fa-shapes text-sm"></i>
                        </span>
                        <div>
                            <span class="section-eyebrow mb-1">
                                <span>Phân Loại Khoa Học • Minh Bạch Date</span>
                            </span>
                            <h2 data-cms-title class="section-title">
                                @FormatHeroTitle(item.Section.Title ?? "Khám Phá Danh Mục Tuyển Chọn")
                            </h2>
                        </div>
                        <span class="section-header-rule__line hidden md:block" aria-hidden="true"></span>
                        <a href="/category/all" class="btn-pill-arrow btn-pill-arrow--light self-start sm:self-auto shrink-0">
                            <span>Xem tất cả</span>
                            <span class="pill-arrow-circle" aria-hidden="true">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </a>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Section.Subtitle))
                    {
                        <p data-cms-subtitle class="text-xs sm:text-sm text-[var(--rl-mauve)] -mt-4 mb-8 font-sans max-w-xl">
                            @item.Section.Subtitle
                        </p>
                    }

                    <!-- Categories Grid: Mobile Cuộn Ngang Scroll-Snap (~1.6 thẻ) | Desktop Lưới 4 Cột Bo Góc Lớn -->
                    <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6 overflow-x-auto sm:overflow-visible snap-x snap-mandatory no-scrollbar pb-3 sm:pb-0 -mx-3 px-3 sm:mx-0 sm:px-0">
                        @{
                            int catIdx = 0;
                        }
                        @foreach (var cat in item.Categories.Take(8))
                        {
                            var catImg = ProductImageResolver.GetCategoryImageUrl(cat.Slug, cat.ImageUrl);
                            var catWebp = ProductImageResolver.GetWebpImageUrl(catImg);
                            var (catPastelClass, catHaloClass, catBadgeCount) = (catIdx % 6) switch
                            {
                                0 => ("bg-[#FBE8EE]/80", "bg-[#F6D2DF]", 48 + (cat.Id * 7) % 40),
                                1 => ("bg-[#FBF1EA]/80", "bg-[#F4DEC9]", 36 + (cat.Id * 5) % 35),
                                2 => ("bg-[#F3EFFB]/80", "bg-[#E3D9F6]", 29 + (cat.Id * 9) % 30),
                                3 => ("bg-[#ECF6F2]/80", "bg-[#CFEAE0]", 42 + (cat.Id * 6) % 45),
                                4 => ("bg-[#FBF7E8]/80", "bg-[#F3E7BE]", 31 + (cat.Id * 4) % 28),
                                _ => ("bg-[#EDF5FA]/80", "bg-[#D4E7F4]", 38 + (cat.Id * 8) % 32)
                            };

                            <a href="/tim-kiem?categorySlug=@cat.Slug"
                               class="group snap-start shrink-0 w-[62vw] max-w-[240px] sm:w-auto relative rounded-[28px] sm:rounded-[32px] overflow-hidden bg-white border border-[var(--rl-border-subtle)] shadow-[var(--rl-shadow-2xs)] hover:shadow-[var(--rl-shadow-md)] hover:border-[var(--rl-rose)]/40 hover:-translate-y-1 active:scale-[0.98] transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] flex flex-col justify-between p-3 sm:p-4 isolate select-none">
                                
                                <!-- Khung Ảnh Bo Góc Lớn với Hiệu Ứng Zoom 1.06 + Overlay Hồng Mờ -->
                                <div class="relative aspect-square w-full rounded-[20px] sm:rounded-[24px] overflow-hidden bg-slate-50 border border-slate-100 flex items-center justify-center isolate"
                                     style="aspect-ratio: 1/1;">
                                    
                                    <picture class="block w-full h-full">
                                        <source srcset="@catWebp" type="image/webp" sizes="180px" />
                                        <img src="@catImg"
                                             alt="@cat.Name"
                                             width="180"
                                             height="180"
                                             loading="lazy"
                                             decoding="async"
                                             class="w-full h-full object-cover group-hover:scale-[1.06] transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
                                             onerror="this.onerror=null;if(this.parentElement&&this.parentElement.tagName==='PICTURE'){this.parentElement.querySelectorAll('source').forEach(function(s){s.remove();});}this.src='@ProductImageResolver.PlaceholderUrl';" />
                                    </picture>

                                    <!-- Overlay hồng mờ khi hover -->
                                    <div class="pointer-events-none absolute inset-0 bg-[var(--rl-rose)]/0 group-hover:bg-[var(--rl-rose)]/15 transition-colors duration-500 rounded-[20px] sm:rounded-[24px]" aria-hidden="true"></div>

                                    <!-- Nhãn Glass trên ảnh -->
                                    <div class="absolute top-2.5 left-2.5 z-20 pointer-events-none">
                                        <span class="px-2.5 py-1 rounded-full bg-white/90 backdrop-blur-xs text-[10px] font-bold text-[var(--rl-ink)] shadow-2xs border border-white/60">
                                            @catBadgeCount+ SP
                                        </span>
                                    </div>
                                </div>

                                <!-- Tên Danh Mục & Nút Tròn Mũi Tên Góc Dưới -->
                                <div class="pt-3 px-1 flex items-center justify-between gap-2">
                                    <div class="min-w-0">
                                        <h3 class="font-sans font-bold text-xs sm:text-sm text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] transition-colors line-clamp-1 leading-snug">
                                            @cat.Name
                                        </h3>
                                        <p class="text-[11px] text-[var(--rl-muted)] font-mono truncate mt-0.5">
                                            Cam Kết Date Mới
                                        </p>
                                    </div>

                                    <!-- Nút tròn mũi tên góc dưới -->
                                    <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[var(--rl-blush)] text-[var(--rl-ink)] group-hover:bg-[var(--rl-rose)] group-hover:text-white flex items-center justify-center shadow-2xs transition-all duration-300 group-hover:scale-105 shrink-0"
                                          aria-hidden="true">
                                        <i class="fa-solid fa-arrow-right text-[11px] group-hover:translate-x-0.5 transition-transform"></i>
                                    </span>
                                </div>
                            </a>
                            catIdx++;
                        }
                    </div>
                </div>
            </section>
        }
        else if (code == "FLASH_SALE" && ((item.FlashSaleCampaign?.Products.Any() ?? false) || item.FlashSaleProducts.Any()))
        {
            <!-- =========================================================================
                 3. FLASH SALE SECTION (⛔ VÙNG ĐÓNG BĂNG - BẢO TOÀN NGUYÊN VẸN 100%)
                 ========================================================================= -->
            <div class="section-scroll-reveal">
                <partial name="Components/DynamicSection/_FlashSale" model="item" />
            </div>
        }
        else if (code == "BEST_SELLERS" && item.BestSellers.Any())
        {
            <!-- =========================================================================
                 4. BEST SELLERS / MỚI VỀ: 3D COVERFLOW CAROUSEL (Nepalora Inspiration)
                 ========================================================================= -->
            <section id="section-@item.Section.Id"
                     data-section-id="@item.Section.Id"
                     data-section-key="best_sellers"
                     data-section-code="@code"
                     class="section-scroll-reveal section-deferred py-12 sm:py-18 bg-[var(--rl-ivory)] border-t border-[var(--rl-border-subtle)]">
                <div class="container-editorial">
                    <!-- Section Header алё,тур Pattern: Icon + Tiêu đề + Đường kẻ mảnh + Nút Pill -->
                    <div class="section-header-rule">
                        <span class="section-header-rule__icon" aria-hidden="true">
                            <i class="fa-solid fa-crown text-[var(--rl-champagne)] text-sm"></i>
                        </span>
                        <div>
                            <span class="section-eyebrow mb-1">
                                <span>Tuyển Tập Được Yêu Thích Nhất</span>
                            </span>
                            <h2 data-cms-title class="section-title">
                                @FormatHeroTitle(item.Section.Title ?? "Sản Phẩm Bán Chạy & Mới Về")
                            </h2>
                        </div>
                        <span class="section-header-rule__line hidden md:block" aria-hidden="true"></span>
                        <a href="/tim-kiem?sort=best_seller" class="btn-pill-arrow btn-pill-arrow--light self-start sm:self-auto shrink-0">
                            <span>Xem tất cả</span>
                            <span class="pill-arrow-circle" aria-hidden="true">
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </a>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Section.Subtitle))
                    {
                        <p data-cms-subtitle class="text-xs sm:text-sm text-[var(--rl-mauve)] -mt-4 mb-8 font-sans max-w-xl">
                            @item.Section.Subtitle
                        </p>
                    }

                    <!-- Carousel 3D Coverflow Container (Alpine.js coverflowCarousel) -->
                    <div x-data="coverflowCarousel(@item.BestSellers.Count)"
                         x-init="init()"
                         @@keydown.left.prevent="prev()"
                         @@keydown.right.prevent="next()"
                         tabindex="0"
                         aria-label="Băng chuyền 3D sản phẩm bán chạy"
                         class="relative focus:outline-none isolate">
                        
                        <!-- Desktop & Tablet: 3D Coverflow Stage (Nepalora Inspiration) -->
                        <div class="hidden md:block coverflow-stage overflow-hidden py-6 px-4"
                             @@touchstart.passive="onTouchStart($event)"
                             @@touchend.passive="onTouchEnd($event)">
                            <div class="coverflow-track">
                                @{
                                    int bIdx = 0;
                                }
                                @foreach (var prod in item.BestSellers)
                                {
                                    <div class="coverflow-card"
                                         :data-pos="getPos(@bIdx)"
                                         @@click="goTo(@bIdx)">
                                        <partial name="_ProductCard" model="prod" />
                                    </div>
                                    bIdx++;
                                }
                            </div>

                            <!-- Coverflow Controls Bar (Prev Button + Pill Link + Next Button) -->
                            <div class="flex items-center justify-center gap-6 mt-6 z-30 relative">
                                <button type="button"
                                        @@click="prev()"
                                        class="w-11 h-11 rounded-full bg-white hover:bg-[var(--rl-rose)] text-[var(--rl-ink)] hover:text-white border border-[var(--rl-border-strong)] flex items-center justify-center shadow-2xs hover:shadow-sm transition-all active:scale-95 cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--rl-rose)]"
                                        aria-label="Sản phẩm trước">
                                    <i class="fa-solid fa-chevron-left text-xs"></i>
                                </button>

                                <a href="/tim-kiem?sort=best_seller" class="text-xs font-bold text-[var(--rl-ink)] hover:text-[var(--rl-rose)] uppercase tracking-wider inline-flex items-center gap-2 transition">
                                    <span>Khám Phá Toàn Bộ Bán Chạy</span>
                                    <span class="text-xs text-[var(--rl-champagne)]">✦</span>
                                </a>

                                <button type="button"
                                        @@click="next()"
                                        class="w-11 h-11 rounded-full bg-white hover:bg-[var(--rl-rose)] text-[var(--rl-ink)] hover:text-white border border-[var(--rl-border-strong)] flex items-center justify-center shadow-2xs hover:shadow-sm transition-all active:scale-95 cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--rl-rose)]"
                                        aria-label="Sản phẩm tiếp theo">
                                    <i class="fa-solid fa-chevron-right text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Mobile: Carousel Phẳng Scroll-Snap (< 768px) -->
                        <div class="md:hidden flex gap-3.5 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-4 -mx-3 px-3">
                            @foreach (var prod in item.BestSellers)
                            {
                                <div class="snap-center shrink-0 w-[72vw] max-w-[280px]">
                                    <partial name="_ProductCard" model="prod" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
        }

        @if (code == "MID_BANNER")
        {
            var banner = item.MidBanners.FirstOrDefault();
            var bgImg = banner != null
                ? (!string.IsNullOrEmpty(banner.DesktopImageUrl)
                    ? banner.DesktopImageUrl
                    : (banner.DesktopMediaId.HasValue
                        ? $"/media/{banner.DesktopMediaId}"
                        : (!string.IsNullOrEmpty(banner.ImageUrl) ? banner.ImageUrl : "/images/banners/banner-routine-kbeauty.jpg")))
                : "/images/banners/banner-routine-kbeauty.jpg";
            var mobileMidImg = banner != null
                ? (!string.IsNullOrEmpty(banner.MobileImageUrl)
                    ? banner.MobileImageUrl
                    : (banner.MobileMediaId.HasValue ? $"/media/{banner.MobileMediaId}" : null))
                : null;
            var bgWebp = (bgImg.StartsWith("/images/banners/", StringComparison.OrdinalIgnoreCase) && !bgImg.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                ? System.IO.Path.ChangeExtension(bgImg, ".webp")
                : null;
            var title = !string.IsNullOrWhiteSpace(banner?.Title) ? banner.Title : (!string.IsNullOrWhiteSpace(item.Section.Title) ? item.Section.Title : "Made for Everyday Radiance");
            var sub = !string.IsNullOrWhiteSpace(banner?.Subtitle) ? banner.Subtitle : (!string.IsNullOrWhiteSpace(item.Section.Subtitle) ? item.Section.Subtitle : "Chắt lọc những công thức dưỡng da thuần khiết, kết cấu mỏng nhẹ và hạn sử dụng luôn tươi mới — dành cho nghi thức chăm sóc bản thân mỗi ngày của bạn.");
            var link = !string.IsNullOrWhiteSpace(banner?.LinkUrl) ? banner.LinkUrl : "/category/all";
            var btnText = !string.IsNullOrWhiteSpace(banner?.ButtonText) ? banner.ButtonText : "Khám Phá Lookbook";

            var midStyle = (banner != null && item.BannerStyles != null && item.BannerStyles.TryGetValue(banner.Id, out var customMidStyle) && customMidStyle != null)
                ? customMidStyle
                : new Omnichannel.Application.DTOs.Cms.BannerStyleConfigDto
                {
                    BadgeText = "Nghi Thức Làm Đẹp Mỗi Ngày",
                    ShowSecondaryButton = true,
                    SecondaryButtonText = "Trắc Nghiệm Làn Da",
                    SecondaryButtonUrl = "/tu-van-da"
                };

            <!-- =========================================================================
                 5A. CÂU CHUYỆN THƯƠNG HIỆU / FEFO DẠNG BENTO (Nepalora Inspiration)
                 - Thẻ tối Ink giới thiệu FEFO
                 - Thẻ ảnh lớn có nhãn glass
                 - Thẻ thống kê có thanh tiến trình chấm (Bento Dot Meter)
                 ========================================================================= -->
            <section x-data="fefoTrustBentoStats()"
                     x-init="initObserver($el)"
                     class="section-scroll-reveal section-deferred py-12 sm:py-18 bg-[var(--rl-ivory)] border-t border-[var(--rl-border-subtle)]">
                <div class="container-editorial">
                    <!-- Section Header алё,тур Pattern -->
                    <div class="section-header-rule">
                        <span class="section-header-rule__icon" aria-hidden="true">
                            <i class="fa-solid fa-flask-vial text-sm"></i>
                        </span>
                        <div>
                            <span class="section-eyebrow mb-1">
                                <span>Bảo Chứng Chất Lượng &amp; Hạn Dùng</span>
                            </span>
                            <h2 class="section-title">
                                Cam Kết Độ Tươi Mới <em class="font-serif italic font-normal text-[var(--rl-rose)]">&amp; Hạn Dùng Minh Bạch</em>
                            </h2>
                        </div>
                        <span class="section-header-rule__line hidden md:block" aria-hidden="true"></span>
                        <button type="button" 
                                onclick="window.dispatchEvent(new CustomEvent('open-fefo-modal'))"
                                class="btn-pill-arrow btn-pill-arrow--light self-start sm:self-auto shrink-0 cursor-pointer"
                                title="Bấm để xem cam kết chất lượng hạn dùng và quyền lợi người mua">
                            <span>Tìm hiểu Cam Kết Hạn Dùng</span>
                            <span class="pill-arrow-circle" aria-hidden="true">
                                <i class="fa-solid fa-question text-[11px]"></i>
                            </span>
                        </button>
                    </div>
                    <p class="text-xs sm:text-sm text-[var(--rl-mauve)] -mt-4 mb-8 font-sans max-w-2xl">
                        Canmake Beauty cam kết 100% xuất lô sản xuất mới nhất (&gt;18 tháng) và công khai hạn sử dụng thực tế của từng sản phẩm.
                    </p>

                    <!-- Bento 3 Thẻ Bất Đối Xứng (Nepalora Inspiration) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-stretch">
                        
                        <!-- Thẻ 1 (4 Cột Desktop): Thẻ Tối Ink Sang Trọng Giới Thiệu FEFO -->
                        <div class="lg:col-span-4 rounded-[28px] sm:rounded-[36px] bg-[linear-gradient(145deg,#23191E_0%,#3B222F_100%)] text-white p-6 sm:p-7 flex flex-col justify-between min-h-[360px] shadow-[var(--rl-shadow-md)] relative overflow-hidden group">
                            <div class="pointer-events-none absolute -right-12 -top-12 w-48 h-48 rounded-full bg-[var(--rl-rose)]/25 blur-3xl" aria-hidden="true"></div>
                            
                            <div class="relative z-10 flex items-center justify-between">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/12 backdrop-blur-md text-[var(--rl-champagne-light)] text-[10px] font-bold tracking-widest uppercase border border-white/20">
                                    <i class="fa-solid fa-shield-halved text-[var(--rl-champagne)]"></i>
                                    <span>Cam Kết Minh Bạch Hạn Dùng</span>
                                </span>
                                <span class="w-9 h-9 rounded-full bg-white/10 text-white flex items-center justify-center">
                                    <i class="fa-solid fa-calendar-check text-xs"></i>
                                </span>
                            </div>

                            <div class="relative z-10 my-6">
                                <div class="font-serif font-black text-2xl sm:text-3xl text-white tracking-tight leading-tight">
                                    Hạn Dùng Minh Bạch, <br/><em class="italic text-[var(--rl-champagne)]">Lô Luôn Mới Nhất</em>
                                </div>
                                <div class="text-[11px] text-[var(--rl-champagne-light)] mt-1.5 font-semibold">
                                    100% Date Mới • Xuất Kho Chuẩn Y Khoa
                                </div>
                                <p class="text-xs text-white/80 mt-2.5 leading-relaxed">
                                    Khác với mỹ phẩm trôi nổi không rõ date, Canmake Beauty quản trị kho số hóa: Đơn hàng luôn tự động xuất lô mới nhất (&gt;18 tháng), kho mát 22°C - 25°C và hiển thị số tháng sử dụng còn lại trước khi bạn bấm mua.
                                </p>
                            </div>

                            <div class="relative z-10 pt-4 border-t border-white/12 flex items-center justify-between">
                                <button type="button"
                                        onclick="window.dispatchEvent(new CustomEvent('open-fefo-modal'))"
                                        class="btn-pill-arrow bg-[var(--rl-rose)] hover:bg-[var(--rl-rose-deep)] text-white text-xs cursor-pointer">
                                    <span>Xem Cam Kết Hạn Dùng</span>
                                    <span class="pill-arrow-circle" aria-hidden="true">
                                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                    </span>
                                </button>
                                <span class="text-xs text-[var(--rl-champagne)]">✦</span>
                            </div>
                        </div>

                        <!-- Thẻ 2 (4 Cột Desktop): Thẻ Ảnh Lớn Editorial Có Nhãn Glass -->
                        <div class="lg:col-span-4 rounded-[28px] sm:rounded-[36px] overflow-hidden bg-[var(--rl-bg-blush)] border border-[var(--rl-border-subtle)] shadow-[var(--rl-shadow-xs)] relative min-h-[360px] group">
                            <picture class="block w-full h-full">
                                @if (!string.IsNullOrEmpty(mobileMidImg))
                                {
                                    <source media="(max-width: 767px)" srcset="@mobileMidImg" />
                                }
                                @if (!string.IsNullOrEmpty(bgWebp))
                                {
                                    <source srcset="@bgWebp" type="image/webp" />
                                }
                                <img src="@bgImg"
                                     alt="@title"
                                     width="600"
                                     height="800"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
                                     onerror="this.onerror=null;this.src='/images/banners/banner-routine-kbeauty.jpg';" />
                            </picture>

                            <!-- Nhãn Glass nổi (Made for You) -->
                            <div class="absolute top-4 left-4 z-20 pointer-events-none">
                                <span class="glass-surface inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] font-bold text-[var(--rl-ink)] shadow-2xs border border-white/80">
                                    <span class="w-2 h-2 rounded-full bg-[var(--rl-rose)]"></span>
                                    <span>Made for You • Nghi Thức Mỗi Ngày</span>
                                </span>
                            </div>

                            <!-- Bottom Overlay Title -->
                            <div class="absolute inset-x-0 bottom-0 p-5 bg-gradient-to-t from-[var(--rl-ink)]/75 via-[var(--rl-ink)]/30 to-transparent text-white">
                                <p class="text-xs text-white/80 font-mono">Editorial Lookbook 2026</p>
                                <h3 class="font-serif font-bold text-base sm:text-lg text-white leading-snug">
                                    Vẻ đẹp rạng rỡ từ những công thức thuần khiết
                                </h3>
                            </div>

                            @if (isAdminOrStaff && banner != null && banner.Id > 0)
                            {
                                <div class="absolute top-3.5 right-3.5 z-30">
                                    <a href="/Admin/Banner/Edit/@banner.Id" class="px-3 py-1.5 rounded-full bg-white/95 text-[var(--rl-ink)] font-bold text-[11px] shadow-sm flex items-center gap-1.5">
                                        <i class="fa-solid fa-wand-magic-sparkles text-[var(--rl-rose)]"></i>
                                        <span>Tùy Chỉnh</span>
                                    </a>
                                </div>
                            }
                        </div>

                        <!-- Thẻ 3 (4 Cột Desktop): Thẻ Thống Kê Với Thanh Chấm (Nepalora Dot Meter) -->
                        <div class="lg:col-span-4 rounded-[28px] sm:rounded-[36px] bg-white border border-[var(--rl-border-subtle)] p-6 sm:p-7 flex flex-col justify-between min-h-[360px] shadow-[var(--rl-shadow-xs)]">
                            <div>
                                <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--rl-muted)] block">Chỉ Số Tin Cậy Lâm Sàng</span>
                                <div class="font-serif font-black text-3xl sm:text-4xl text-[var(--rl-ink)] tracking-tight mt-1">
                                    50+ <span class="text-sm font-sans font-normal text-[var(--rl-mauve)]">Quy chuẩn độc quyền</span>
                                </div>
                                <p class="text-xs text-[var(--rl-muted)] mt-1">Khảo sát &amp; đánh giá theo chuẩn y khoa da liễu</p>
                            </div>

                            <!-- Thanh Tiến Trình Chấm (Nepalora Dot Meters) -->
                            <div class="space-y-3.5 my-4 pt-4 border-t border-[var(--rl-border-subtle)]">
                                <!-- Tiêu chí 1: Độ tươi mới FEFO -->
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-[var(--rl-ink)]">Lô mới xuất kho (HSD &gt; 18 tháng)</span>
                                    <div class="flex items-center gap-2">
                                        <div class="bento-dot-meter" aria-hidden="true">
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                        </div>
                                        <span class="font-mono font-bold text-[var(--rl-rose)] text-[11px]">100%</span>
                                    </div>
                                </div>

                                <!-- Tiêu chí 2: Chính ngạch VAT -->
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-[var(--rl-ink)]">Chính ngạch có tem phụ</span>
                                    <div class="flex items-center gap-2">
                                        <div class="bento-dot-meter" aria-hidden="true">
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                            <span class="dot active-gold"></span>
                                        </div>
                                        <span class="font-mono font-bold text-[var(--rl-champagne)] text-[11px]">100%</span>
                                    </div>
                                </div>

                                <!-- Tiêu chí 3: Hài lòng da liễu -->
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-[var(--rl-ink)]">Hài lòng da nhạy cảm</span>
                                    <div class="flex items-center gap-2">
                                        <div class="bento-dot-meter" aria-hidden="true">
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot active-teal"></span>
                                            <span class="dot"></span>
                                        </div>
                                        <span class="font-mono font-bold text-[var(--rl-success-icon)] text-[11px]">96%</span>
                                    </div>
                                </div>

                                <!-- Tiêu chí 4: Bảo hành đổi trả -->
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-[var(--rl-ink)]">Bảo hành kích ứng</span>
                                    <div class="flex items-center gap-2">
                                        <div class="bento-dot-meter" aria-hidden="true">
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                            <span class="dot active"></span>
                                        </div>
                                        <span class="font-mono font-bold text-[var(--rl-rose)] text-[11px]">7 Ngày</span>
                                    </div>
                                </div>
                            </div>

                            <blockquote class="text-[11px] text-[var(--rl-mauve)] italic leading-relaxed pt-3 border-t border-[var(--rl-border-subtle)]">
                                “Từng lọ mỹ phẩm đều thể hiện rõ ràng số lô và hạn dùng xa hơn 20 tháng. Rất yên tâm cho làn da nhạy cảm.”
                            </blockquote>
                        </div>

                    </div>
                </div>
            </section>

            <!-- =========================================================================
                 5B. DẢI SỐ LIỆU LỚN COUNT-UP (Nepalora Inspiration)
                 ========================================================================= -->
            <section aria-label="Số liệu thống kê thương hiệu Canmake"
                     x-data="fefoTrustBentoStats()"
