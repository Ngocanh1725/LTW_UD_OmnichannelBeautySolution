                                    <option value="">Mọi thương hiệu</option>
                                    <option value="La Roche-Posay">La Roche-Posay</option>
                                    <option value="Paula's Choice">Paula's Choice</option>
                                    <option value="Obagi">Obagi Medical</option>
                                    <option value="Skin1004">Skin1004</option>
