@using Microsoft.AspNetCore.Authentication
@using Omnichannel.Application.Common
@model Omnichannel.Web.Models.HomeSectionsViewModel
@functions {
    public static Microsoft.AspNetCore.Html.HtmlString FormatHeroTitle(string? rawTitle)
    {
        if (string.IsNullOrWhiteSpace(rawTitle))
            return new Microsoft.AspNetCore.Html.HtmlString("Bừng Sáng <em class=\"font-serif italic font-normal text-[var(--rl-rose)]\">Nhan Sắc</em> Mùa Hè");

        if (rawTitle.Contains('*'))
        {
            var replaced = System.Text.RegularExpressions.Regex.Replace(
                rawTitle,
                @"\*(.*?)\*",
                "<em class=\"font-serif italic font-normal text-[var(--rl-rose)]\">$1</em>"
            );
            return new Microsoft.AspNetCore.Html.HtmlString(replaced);
        }

        var keywords = new[] { "Nhan Sắc", "Beauty", "Thượng Lưu", "Rạng Ngời", "Xuất Sắc", "Mỹ Phẩm", "Dưỡng Da", "Trẻ Hoá", "Summer", "Vibes", "Danh Mục", "Bán Chạy", "Date Mới", "Routine", "Thực Tế", "Làm Đẹp", "Khoa Học", "Tuyển Chọn", "Mới Về" };
        foreach (var kw in keywords)
        {
            if (rawTitle.Contains(kw, StringComparison.OrdinalIgnoreCase))
            {
                var replaced = System.Text.RegularExpressions.Regex.Replace(
                    rawTitle,
                    System.Text.RegularExpressions.Regex.Escape(kw),
                    $"<em class=\"font-serif italic font-normal text-[var(--rl-rose)]\">{kw}</em>",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase
                );
                return new Microsoft.AspNetCore.Html.HtmlString(replaced);
            }
        }

        var parts = rawTitle.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 3)
        {
            parts[1] = $"<em class=\"font-serif italic font-normal text-[var(--rl-rose)]\">{parts[1]}</em>";
            return new Microsoft.AspNetCore.Html.HtmlString(string.Join(" ", parts));
        }

        return new Microsoft.AspNetCore.Html.HtmlString(rawTitle);
    }
}
@{
    var adminAuthResult = Context.RequestServices?.GetService(typeof(IAuthenticationService)) != null
        ? await Context.AuthenticateAsync(AuthConstants.AdminCookieScheme)
        : null;
    bool isAdminOrStaff = (adminAuthResult?.Succeeded == true && adminAuthResult.Principal?.Identity?.IsAuthenticated == true) ||
        (User?.Identity?.IsAuthenticated == true &&
         (User.IsInRole("SuperAdmin") || User.IsInRole("SUPER_ADMIN") || User.HasClaim("IsStaff", "true")));
}

@if (Model != null && Model.Sections.Any())
{
    <div id="dynamic-sections-container">
    @foreach (var item in Model.Sections)
    {
        var code = item.Section.SectionCode.ToUpperInvariant();

        @if (code == "HERO_SLIDER" && item.Banners.Any())
        {
            <!-- =========================================================================
                 1. HERO SECTION "ROSÉ LUXE" (Bloom Room & Nepalora Inspiration)
                 - Khung bo góc 40px trên nền gradient Rosé Glow (#FBE8EE -> #F6D2DF -> #FFFDFB)
                 - Chiều sâu 3 lớp: Nền -> Wordmark khổng lồ -> Sản phẩm chủ đạo đè lên chữ -> Hoạ tiết nổi
                 - Headline trộn Sans đậm + Serif nghiêng
                 - Autoplay 6500ms có thanh tiến trình + nút prev/next tròn (>= 44x44px)
                 - Khối tìm kiếm nhanh dạng pill glass ĐỘC LẬP HOÀN TOÀN (cảm hứng алё,тур)
                 - Dải Trust Strip 4 tiêu chí vàng với icon Champagne
                 - Đường phân cách dạng sóng (SVG wave divider) chuyển mượt sang section sau
                 ========================================================================= -->
            <section id="section-@item.Section.Id"
                     data-section-id="@item.Section.Id"
                     data-section-key="hero_banner"
                     data-section-code="@code"
                     class="relative pt-2 pb-0 bg-[var(--rl-ivory)] overflow-hidden isolate"
                     x-data="heroSliderComponent(@item.Banners.Count)"
                     x-init="init()"
                     @@keydown.left.prevent="prev()"
                     @@keydown.right.prevent="next()">

                <!-- Ambient Radial Glows -->
                <div class="pointer-events-none absolute -top-20 -left-20 w-[420px] h-[420px] rounded-full bg-[var(--rl-rose-100)]/80 blur-3xl" aria-hidden="true"></div>
                <div class="pointer-events-none absolute top-1/3 -right-20 w-[480px] h-[480px] rounded-full bg-[var(--rl-rose-200)]/60 blur-3xl" aria-hidden="true"></div>

                <div class="max-w-[1360px] mx-auto px-3 sm:px-6 lg:px-8 relative z-10">

                    <!-- KHUNG HERO BO GÓC 40PX NỀN ROSÉ GLOW SANG TRỌNG & ÁNH KIM CHAMPAGNE -->
                    <div id="heroInnerFrame"
                         style="background: radial-gradient(circle at 82% 20%, rgba(201,169,110,0.18) 0%, transparent 45%), radial-gradient(circle at 12% 85%, rgba(184,51,106,0.12) 0%, transparent 42%), linear-gradient(135deg, #FFF6F9 0%, #FAEDF2 28%, #F7D7E3 65%, #FFFBF8 100%);"
                         class="relative rounded-[28px] sm:rounded-[36px] lg:rounded-[40px] border border-[#E7D6C8] ring-1 ring-[#C9A96E]/25 shadow-[0_25px_65px_-15px_rgba(43,27,36,0.12)] overflow-hidden min-h-[520px] sm:min-h-[560px] lg:min-h-[600px] flex flex-col justify-between p-5 sm:p-8 lg:p-10 xl:p-12 isolate select-none"
                         @@mouseleave="onMouseLeaveHero()"
                         @@mousemove="onMouseMove($event)"
                         @@touchstart.passive="onTouchStart($event)"
                         @@touchmove.passive="onTouchMove($event)"
                         @@touchend="onTouchEnd()">

                        <!-- LAYER 2: WORDMARK KHỔNG LỒ NẰM CHÌM PHÍA SAU (Tạo chiều sâu 3D Bloom Room) -->
                        <div class="pointer-events-none select-none absolute right-0 top-10 font-serif font-black uppercase leading-none tracking-tighter whitespace-nowrap transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
                             style="color: rgba(184, 51, 106, 0.035); font-size: clamp(3rem, 11vw, 140px); z-index: 1; transform: translate3d(calc(var(--parallaxX, 0) * -0.6px), calc(var(--parallaxY, 0) * -0.4px), 0);"
                             :style="`transform: translate3d(${parallaxX * -0.6}px, ${parallaxY * -0.4}px, 0)`"
                             aria-hidden="true">
                            CANMAKE BEAUTY
                        </div>

                        <!-- LAYER 4: HOẠ TIẾT NỔI BAY LƠ LỬNG (4-6 Cánh hoa / Giọt serum / Hạt lấp lánh Champagne) -->
                        <!-- 1. Hạt lấp lánh Champagne góc trên trái -->
                        <span class="pointer-events-none select-none absolute top-7 left-10 text-[var(--rl-champagne)] text-2xl lg:text-3xl font-black leading-none animate-floating-sparkle z-30"
                              :style="`transform: translate3d(${parallaxX * 0.9}px, ${parallaxY * 0.9}px, 0)`"
                              aria-hidden="true">✦</span>

                        <!-- 2. Cánh hoa anh đào trôi (SVG) góc trên phải -->
                        <div class="pointer-events-none select-none absolute top-12 right-[42%] lg:right-[38%] text-[var(--rl-rose)]/40 animate-floating-petal z-30 hidden sm:block"
                             :style="`transform: translate3d(${parallaxX * 0.7}px, ${parallaxY * 0.7}px, 0)`"
                             aria-hidden="true">
                            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
                                <path d="M12 2C13.5 6 18 8 18 12C18 16 14 20 12 22C10 20 6 16 6 12C6 8 10.5 6 12 2Z"/>
                            </svg>
                        </div>

                        <!-- 3. Giọt Serum tinh chất trôi (SVG) góc dưới trái -->
                        <div class="pointer-events-none select-none absolute bottom-24 left-1/3 text-[var(--rl-rose)]/30 animate-floating-petal-slow z-30 hidden lg:block"
                             :style="`transform: translate3d(${parallaxX * 0.5}px, ${parallaxY * 0.5}px, 0)`"
                             aria-hidden="true">
                            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
                                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                            </svg>
                        </div>

                        <!-- 4. Hạt Champagne góc dưới phải -->
                        <span class="pointer-events-none select-none absolute bottom-14 right-10 text-[var(--rl-champagne)] text-xl lg:text-2xl font-black leading-none animate-floating-sparkle z-30 delay-300"
                              :style="`transform: translate3d(${parallaxX * 0.8}px, ${parallaxY * 0.8}px, 0)`"
                              aria-hidden="true">✦</span>

                        <!-- 5. Lưới điểm nhấn champagne nhẹ -->
                        <div class="pointer-events-none select-none absolute bottom-8 left-10 hidden sm:grid grid-cols-3 gap-1.5 opacity-30 z-20" aria-hidden="true">
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-rose)]"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-champagne)]"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-rose)]"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-champagne)]"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-rose)]"></span>
                            <span class="w-1.5 h-1.5 rounded-full bg-[var(--rl-champagne)]"></span>
                        </div>

                        <!-- BỐ CỤC CHÍNH HERO: 12 CỘT (DESKTOP) / XẾP CHỒNG (MOBILE) -->
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 xl:gap-10 items-center flex-1 z-20">

                            <!-- CỘT TRÁI (5 Cột Desktop / Order 2 Mobile): Eyebrow, Headline Line-Mask, Subtitle, 2 CTAs -->
                            <div class="lg:col-span-5 order-2 lg:order-1 relative grid grid-cols-1 items-center">
                                @for (int i = 0; i < item.Banners.Count; i++)
                                {
                                    var b = item.Banners[i];
                                    var style = (item.BannerStyles != null && item.BannerStyles.TryGetValue(b.Id, out var customStyle) && customStyle != null)
                                        ? customStyle
                                        : new Omnichannel.Application.DTOs.Cms.BannerStyleConfigDto();

                                    var eyebrowText = (style.ShowBadge && !string.IsNullOrWhiteSpace(style.BadgeText))
                                        ? style.BadgeText
                                        : "BỘ SƯU TẬP MỚI 2026 • DATE TƯƠI MỚI";

                                    var titleText = !string.IsNullOrWhiteSpace(b.Title)
                                        ? b.Title
                                        : "SUMMER BEAUTY VIBES";

                                    var subtitleText = !string.IsNullOrWhiteSpace(b.Subtitle)
                                        ? b.Subtitle
                                        : "Bừng Sáng Nhan Sắc Mùa Hè - Ưu Đãi Đến 40% cho các dòng tinh chất & chống nắng chuẩn hạn dùng minh bạch.";

                                    var primaryUrl = string.IsNullOrWhiteSpace(b.LinkUrl) ? "/tim-kiem" : b.LinkUrl;
                                    var primaryBtnText = string.IsNullOrWhiteSpace(b.ButtonText) ? "Khám Phá Ngay" : b.ButtonText;
                                    var secondaryUrl = string.IsNullOrWhiteSpace(style.SecondaryButtonUrl) ? "/clearance-fefo" : style.SecondaryButtonUrl;
                                    if (secondaryUrl.Contains("?") || secondaryUrl.Contains("C?n") || secondaryUrl.Contains("Cận Date"))
                                    {
                                        secondaryUrl = "/clearance-fefo";
                                    }
                                    var secondaryBtnText = string.IsNullOrWhiteSpace(style.SecondaryButtonText) ? "Săn Deal Cận Date -50%" : style.SecondaryButtonText;
                                    if (!string.IsNullOrWhiteSpace(secondaryBtnText))
                                    {
                                        secondaryBtnText = secondaryBtnText.Replace("FEFO", "Cận Date", StringComparison.OrdinalIgnoreCase)
                                                                           .Replace("San Deal C?n Date", "Săn Deal Cận Date")
                                                                           .Replace("C?n Date", "Cận Date");
                                    }
                                    if (!string.IsNullOrWhiteSpace(eyebrowText))
                                    {
                                        eyebrowText = eyebrowText.Replace("FEFO", "Date Mới", StringComparison.OrdinalIgnoreCase);
                                    }

                                    <div x-show="activeSlide === @i"
                                         x-transition:enter="transition ease-[cubic-bezier(0.22,1,0.36,1)] duration-500"
                                         x-transition:enter-start="opacity-0 translate-y-3"
                                         x-transition:enter-end="opacity-100 translate-y-0"
                                         x-transition:leave="transition ease-in duration-200 pointer-events-none absolute"
                                         x-transition:leave-start="opacity-100 translate-y-0"
                                         x-transition:leave-end="opacity-0 -translate-y-2"
                                         style="@(i == 0 ? "" : "display: none;")"
                                         class="col-start-1 row-start-1 space-y-4 sm:space-y-5">

                                        <!-- Eyebrow Pill Badge -->
                                        <div>
                                            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-[#C9A96E]/40 text-[#8E1F4F] text-[11px] font-extrabold uppercase tracking-[0.16em] shadow-[var(--rl-shadow-2xs)]">
                                                <i class="fa-solid fa-sparkles text-[#C9A96E] text-xs" aria-hidden="true"></i>
                                                <span>@eyebrowText</span>
                                            </span>
                                        </div>

                                        <!-- Fluid Headline Line-Mask Reveal (Trộn Sans Đậm + Serif Nghiêng) -->
                                        <div class="hero-line-mask">
                                            <h1 class="hero-line-reveal font-sans font-black text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)] text-[var(--rl-ink)] tracking-tight leading-[1.08] max-w-xl">
                                                @FormatHeroTitle(titleText)
                                            </h1>
                                        </div>

                                        <!-- Subtitle -->
                                        <p class="text-sm sm:text-base text-[var(--rl-mauve)] leading-relaxed max-w-lg line-clamp-3 sm:line-clamp-2">
                                            @subtitleText
                                        </p>

                                        <!-- 2 CTAs (Full width trên mobile, inline-flex trên tablet/desktop) -->
                                        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                                            @if (style.ShowPrimaryButton)
                                            {
                                                <a href="@primaryUrl" class="btn-pill-arrow w-full sm:w-auto justify-between sm:justify-start shadow-[0_10px_25px_rgba(184,51,106,0.30)] hover:shadow-[0_14px_30px_rgba(184,51,106,0.40)]">
                                                    <span>@primaryBtnText</span>
                                                    <span class="arrow-circle" aria-hidden="true">
                                                        <i class="fa-solid fa-arrow-right text-[11px]"></i>
                                                    </span>
                                                </a>
                                            }
                                            @if (style.ShowSecondaryButton || string.IsNullOrWhiteSpace(style.SecondaryButtonText))
                                            {
                                                <a href="@secondaryUrl" class="btn-ghost bg-white/90 hover:bg-white text-[var(--rl-ink)] hover:text-[var(--rl-rose)] border border-[#C9A96E]/35 hover:border-[var(--rl-rose)] w-full sm:w-auto justify-center shadow-2xs">
                                                    <i class="fa-solid fa-shield-heart text-[var(--rl-rose)] text-xs"></i>
                                                    <span>@secondaryBtnText</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- CỘT PHẢI (7 Cột Desktop / Order 1 Mobile): Khung Ảnh Banner Lớn Chuẩn Editorial -->
                            <div class="lg:col-span-7 order-1 lg:order-2 relative w-full"
                                 style="min-height: 280px; height: clamp(280px, 38vw, 460px);">
                                
                                @for (int i = 0; i < item.Banners.Count; i++)
                                {
                                    var b = item.Banners[i];
                                    var bannerImg = !string.IsNullOrEmpty(b.DesktopImageUrl)
                                        ? b.DesktopImageUrl
                                        : (b.DesktopMediaId.HasValue
                                            ? $"/media/{b.DesktopMediaId}"
                                            : (!string.IsNullOrEmpty(b.ImageUrl) ? b.ImageUrl : "/images/banners/hero-banner-summer-beauty.jpg"));
                                    var mobileBannerImg = !string.IsNullOrEmpty(b.MobileImageUrl)
                                        ? b.MobileImageUrl
                                        : (b.MobileMediaId.HasValue ? $"/media/{b.MobileMediaId}" : null);
                                    var bannerWebp = (bannerImg.StartsWith("/images/banners/", StringComparison.OrdinalIgnoreCase) && !bannerImg.EndsWith(".webp", StringComparison.OrdinalIgnoreCase))
                                        ? System.IO.Path.ChangeExtension(bannerImg, ".webp")
                                        : null;
                                    bool canEditBanner = isAdminOrStaff;
                                    var targetLink = string.IsNullOrWhiteSpace(b.LinkUrl) ? "/tim-kiem" : b.LinkUrl;

                                    <div class="absolute inset-0 w-full h-full"
                                         x-show="activeSlide === @i"
                                         x-transition:enter="transition ease-[cubic-bezier(0.22,1,0.36,1)] duration-700"
                                         x-transition:enter-start="opacity-0 translate-x-8 scale-95"
                                         x-transition:enter-end="opacity-100 translate-x-0 scale-100"
                                         x-transition:leave="transition ease-in duration-300 pointer-events-none absolute"
                                         x-transition:leave-start="opacity-100 translate-x-0 scale-100"
                                         x-transition:leave-end="opacity-0 -translate-x-8 scale-102"
                                         style="@(i == 0 ? "" : "display: none;")">

                                        <!-- KHUNG BANNER LỚN SANG TRỌNG (HAUTE EDITORIAL SHOWCASE) -->
                                        <div class="relative w-full h-full rounded-[24px] sm:rounded-[32px] overflow-hidden bg-white/60 backdrop-blur-xs border border-white/95 shadow-[0_20px_45px_rgba(43,27,36,0.16)] ring-1 ring-[#C9A96E]/30 group">
                                            
                                            <!-- Link Ảnh Banner -->
                                            <a href="@targetLink" aria-label="@b.Title" class="block w-full h-full overflow-hidden">
                                                <picture class="block w-full h-full">
                                                    @if (!string.IsNullOrEmpty(mobileBannerImg))
                                                    {
                                                        <source media="(max-width: 767px)" srcset="@mobileBannerImg" sizes="100vw" />
                                                    }
                                                    @if (!string.IsNullOrEmpty(bannerWebp))
                                                    {
                                                        <source srcset="@bannerWebp" type="image/webp" sizes="(max-width: 1023px) 100vw, 60vw" />
                                                    }
                                                    <img src="@bannerImg"
                                                         alt="@(string.IsNullOrWhiteSpace(b.Title) ? "Canmake Rosé Luxe Hero" : b.Title)"
                                                         width="1200"
                                                         height="600"
                                                         fetchpriority="@(i == 0 ? "high" : "low")"
                                                         loading="@(i == 0 ? "eager" : "lazy")"
                                                         decoding="async"
                                                         class="w-full h-full object-cover object-center transition-transform duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                                                         onerror="this.onerror=null;this.src='/images/banners/hero-banner-summer-beauty.jpg';" />
                                                </picture>
                                            </a>

                                            <!-- Lớp Phủ Ánh Sáng Tinh Tế (Sheen Glare & Bottom Vignette) -->
                                            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0)_60%,rgba(35,25,30,0.35)_100%)]" aria-hidden="true"></div>
                                            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.25)_0%,transparent_50%,rgba(201,169,110,0.12)_100%)]" aria-hidden="true"></div>

                                            <!-- Floating Glass Badge bảo chứng FEFO đè trên góc ảnh -->
                                            <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-20 pointer-events-none">
                                                <div class="glass-surface inline-flex items-center gap-2 sm:gap-2.5 px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-2xl shadow-[var(--rl-shadow-xs)] border border-white/80 backdrop-blur-md bg-white/85">
                                                    <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-xl bg-[var(--rl-success-bg)] text-[var(--rl-success-icon)] flex items-center justify-center shrink-0">
                                                        <i class="fa-solid fa-calendar-check text-[11px] sm:text-xs"></i>
                                                    </span>
                                                    <div>
                                                        <p class="text-[10px] sm:text-[11px] font-bold text-[var(--rl-ink)] leading-tight">Cam Kết Date Mới 100%</p>
                                                        <p class="text-[9px] sm:text-[10px] text-[var(--rl-muted)] leading-tight mt-0.5">Minh bạch hạn dùng từng lô hàng</p>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Pill Tag Editorial góc trên trái -->
                                            <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 pointer-events-none">
                                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--rl-ink)]/75 text-[#FDF8F5] text-[10px] font-bold uppercase tracking-wider backdrop-blur-md border border-white/20 shadow-xs">
                                                    <span class="text-[#E5CFA0]">✦</span>
                                                    <span>@(i == 0 ? "Bộ Sưu Tập Mới" : (i == 1 ? "Bán Chạy Nhất" : "Ưu Đãi Cận Date"))</span>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Nút Tùy Chỉnh Cho Admin (BẢO TOÀN NGUYÊN VẸN THEO YÊU CẦU) -->
                                        @if (canEditBanner)
                                        {
                                            <div class="absolute top-2 right-2 sm:top-4 sm:right-4 z-40 flex flex-wrap items-center gap-2">
                                                @if (b.Id > 0)
                                                {
                                                    <a href="/Admin/Banner/Edit/@b.Id" class="px-3.5 py-2 rounded-full bg-white/95 hover:bg-white text-[var(--rl-ink)] font-bold text-xs shadow-md border border-[var(--rl-border-strong)] flex items-center gap-1.5 transition hover:scale-105">
                                                        <i class="fa-solid fa-wand-magic-sparkles text-[var(--rl-rose)]"></i>
                                                        <span>Tùy Chỉnh Ảnh</span>
                                                    </a>
                                                }
                                                <a href="/Admin/Banner" class="px-3.5 py-2 rounded-full bg-[var(--rl-ink)] hover:bg-[var(--rl-rose-deep)] text-white border border-white/20 font-semibold text-xs shadow-md flex items-center gap-1.5 backdrop-blur-md transition">
                                                    <i class="fa-solid fa-sliders text-xs"></i>
                                                    <span>Quản Lý Banner</span>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                        </div>

                        <!-- CHỈ BÁO SLIDE (SỐ "01 / 03" + THANH TIẾN TRÌNH AUTOPLAY + NÚT TRÒN PREV/NEXT) -->
                        <div class="pt-6 mt-4 border-t border-[#C9A96E]/20 flex items-center justify-between gap-4 z-20">
                            <!-- Số & Thanh Tiến Trình -->
                            <div class="flex items-center gap-3">
                                <span class="font-mono text-sm font-bold text-[var(--rl-ink)]" x-text="String(activeSlide + 1).padStart(2, '0')">01</span>

                                <!-- Thanh Tiến Trình Autoplay Phân Đoạn -->
                                <div class="flex items-center gap-1.5 w-24 sm:w-36">
                                    @for (int i = 0; i < item.Banners.Count; i++)
                                    {
                                        <button type="button"
                                                @@click="goTo(@i)"
                                                class="group relative flex-1 min-h-[44px] py-4 flex items-center focus:outline-none cursor-pointer"
                                                aria-label="Chuyển tới slide @(i + 1)">
                                            <span class="w-full h-1.5 rounded-full bg-[var(--rl-ink)]/15 overflow-hidden block">
                                                <span class="block h-full bg-[var(--rl-rose)] rounded-full transition-all duration-75"
                                                      :style="activeSlide === @i ? `width: ${progress}%` : (activeSlide > @i ? 'width: 100%' : 'width: 0%')"></span>
                                            </span>
                                        </button>
                                    }
                                </div>

                                <span class="font-mono text-xs text-[var(--rl-muted)]">/ @item.Banners.Count.ToString("00")</span>
                            </div>

