                        <path d="M0,24 C320,68 640,80 960,40 C1120,20 1280,50 1440,32 L1440,80 L0,80 Z" fill="currentColor"></path>
                    </svg>
                </div>

                <!-- MOBILE BOTTOM SHEET CHO QUICK SEARCH & FILTER (< 768px) -->
                <div x-cloak
