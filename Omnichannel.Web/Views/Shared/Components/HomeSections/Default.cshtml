                                    <option value="">Tất cả loại da</option>
                                    <option value="da dầu mụn">Da dầu &amp; Mụn</option>
                                    <option value="da khô nhạy cảm">Da khô &amp; Nhạy cảm</option>
                                    <option value="dưỡng trắng mờ thâm">Dưỡng sáng &amp; Mờ thâm</option>
                                    <option value="chống lão hóa">Chống lão hóa &amp; Phục hồi</option>
