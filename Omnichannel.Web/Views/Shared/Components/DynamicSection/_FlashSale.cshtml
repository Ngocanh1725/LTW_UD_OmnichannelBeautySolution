@model Omnichannel.Web.Models.HomeSectionItemViewModel

@{
    var campaign = Model.FlashSaleCampaign;
    var endTimeIso = campaign != null 
        ? campaign.EndTime.ToString("yyyy-MM-ddTHH:mm:ssZ") 
        : DateTime.UtcNow.Date.AddDays(1).ToString("yyyy-MM-ddTHH:mm:ssZ");

    var title = campaign?.Title ?? Model.Section.Title;
    var subtitle = campaign?.Subtitle ?? Model.Section.Subtitle ?? "Cơ hội săn mỹ phẩm cao cấp chuẩn hạn dùng FEFO với giá ưu đãi cực lớn";
    var products = campaign?.Products ?? new List<Omnichannel.Application.DTOs.Inventory.FlashSaleProductItemDto>();
}

<!-- FLASH SALE SECTION (DYNAMIC REAL-TIME COUNTDOWN & BURNING PROGRESS) -->
<section id="section-@Model.Section.Id" 
         data-section-id="@Model.Section.Id" 
         data-section-key="flash_sale" 
         data-section-code="@Model.Section.SectionCode" 
         class="section-deferred py-14 sm:py-20 bg-gradient-to-r from-[#2b0819] via-charcoal to-[#181124] text-white relative overflow-hidden"
         x-data="flashSaleCountdown('@endTimeIso')">

    <!-- Hiệu ứng ánh sáng nền -->
    <div class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-magenta-accent/15 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-24 -top-24 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Section Header: Tiêu đề + Đồng hồ đếm ngược Giờ:Phút:Giây -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 gap-6 border-b border-white/10 pb-8">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs font-bold uppercase tracking-wider backdrop-blur-md">
                    <i class="fa-solid fa-bolt text-amber-400 animate-bounce"></i>
                    <span>Giờ Vàng Giá Sốc • FEFO Minh Bạch</span>
                </div>
                <h2 data-cms-title class="font-serif text-2xl sm:text-4xl font-bold text-white tracking-tight">
                    @title
                </h2>
                <p data-cms-subtitle class="text-xs sm:text-sm text-slate-300 max-w-xl font-sans leading-relaxed">
                    @subtitle
                </p>
            </div>

            <!-- ĐỒNG HỒ ĐẾM NGƯỢC THỜI GIAN THỰC (REAL-TIME JS COUNTDOWN) -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 bg-white/5 border border-white/15 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl shadow-xl">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-300">
                    <i class="fa-solid fa-fire-flame-curved text-rose-500 text-base animate-pulse"></i>
                    <span>Kết Thúc Trong:</span>
                </div>

                <div class="flex items-center gap-2 font-mono text-charcoal" aria-label="Đồng hồ đếm ngược Flash Sale">
                    <!-- Khối Giờ -->
                    <div class="flex flex-col items-center">
                        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-b from-amber-400 to-amber-500 text-slate-900 font-extrabold text-lg sm:text-xl flex items-center justify-center shadow-md shadow-amber-500/20">
                            <span x-text="hours">00</span>
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans mt-1">Giờ</span>
                    </div>

                    <span class="text-amber-400 font-bold text-xl mb-4">:</span>

                    <!-- Khối Phút -->
                    <div class="flex flex-col items-center">
                        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-b from-amber-400 to-amber-500 text-slate-900 font-extrabold text-lg sm:text-xl flex items-center justify-center shadow-md shadow-amber-500/20">
                            <span x-text="minutes">00</span>
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans mt-1">Phút</span>
                    </div>

                    <span class="text-amber-400 font-bold text-xl mb-4">:</span>

                    <!-- Khối Giây -->
                    <div class="flex flex-col items-center">
                        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-gradient-to-b from-rose-500 to-red-600 text-white font-extrabold text-lg sm:text-xl flex items-center justify-center shadow-md shadow-rose-500/30 animate-pulse">
                            <span x-text="seconds">00</span>
                        </div>
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-sans mt-1">Giây</span>
                    </div>
                </div>

                <a href="/clearance-fefo" class="text-xs font-bold text-amber-300 hover:text-white flex items-center gap-1.5 transition ml-auto sm:ml-2">
                    <span>Xem tất cả</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
            </div>
        </div>

        <!-- Products Grid với Thanh Tiến Độ Đã Bán % -->
        @if (products.Any())
        {
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                @foreach (var prod in products)
                {
                    var prodUrl = !string.IsNullOrEmpty(prod.Slug) ? $"/san-pham/{prod.Slug}" : $"/Product/Detail/{prod.ProductId}";
                    var img = ProductImageResolver.GetPrimaryImageUrl(prod.ImageUrl, null, prod.Slug, prod.ProductName);
                    var webpImg = ProductImageResolver.GetWebpImageUrl(img, null, prod.Slug, prod.ProductName);
                    var altText = ProductImageResolver.GetAltText(prod.ProductName, prod.BrandName, null, null, prod.Slug);

                    <article class="bg-white rounded-3xl border border-white/20 shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                        <!-- Top Thumbnail -->
                        <div class="relative aspect-square overflow-hidden bg-slate-50 p-3 flex items-center justify-center" style="aspect-ratio: 1/1;">
                            <a href="@prodUrl" class="block w-full h-full relative z-10" title="@altText">
                                <picture class="block w-full h-full">
                                    <source srcset="@webpImg" type="image/webp" />
                                    <img src="@img" 
                                         alt="@altText" 
                                         width="400" 
                                         height="400" 
                                         loading="lazy" 
                                         decoding="async"
                                         onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';" 
                                         class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
                                </picture>
                            </a>

                            <!-- Badge Giảm Giá -->
                            <div class="absolute top-2.5 left-2.5 z-20 flex flex-col gap-1">
                                <span class="px-2.5 py-0.5 rounded-full bg-gradient-to-r from-rose-600 to-red-600 text-white text-[11px] font-extrabold tracking-wider shadow-md flex items-center gap-1">
                                    <i class="fa-solid fa-bolt text-[10px] text-amber-300"></i>
                                    <span>-@prod.DiscountPercent%</span>
                                </span>
                                @if (prod.IsAlmostSoldOut)
                                {
                                    <span class="px-2 py-0.5 rounded-full bg-amber-500 text-white text-[9px] font-bold tracking-wider shadow-sm animate-pulse">
                                        SẮP CHÁY HÀNG
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between text-slate-800">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-gold block mb-1">
                                    @(prod.BrandName ?? "Canmake Beauty")
                                </span>
                                <h3 class="font-bold text-xs sm:text-sm text-slate-800 line-clamp-2 leading-snug group-hover:text-magenta-accent transition-colors">
                                    <a href="@prodUrl">@prod.ProductName</a>
                                </h3>
                            </div>

                            <div class="mt-4 pt-3 border-t border-slate-100 space-y-3">
                                <!-- Giá Bán -->
                                <div class="flex items-baseline gap-2">
                                    <span class="text-base sm:text-lg font-extrabold text-charcoal font-mono">
                                        @prod.SalePrice.ToString("N0") ₫
                                    </span>
                                    @if (prod.OriginalPrice > prod.SalePrice)
                                    {
                                        <span class="text-xs text-slate-400 line-through font-mono">
                                            @prod.OriginalPrice.ToString("N0") ₫
                                        </span>
                                    }
                                </div>

                                <!-- THANH TIẾN ĐỘ ĐÃ BÁN (BURNING PROGRESS BAR) -->
                                <div class="space-y-1">
                                    <div class="flex items-center justify-between text-[11px] font-bold">
                                        <span class="text-slate-600 flex items-center gap-1">
                                            <i class="fa-solid fa-fire text-rose-500 text-[10px]"></i>
                                            <span>Đã bán:</span>
                                        </span>
                                        <span class="text-rose-600 font-mono">@prod.SoldCount/@prod.StockLimit</span>
                                    </div>
                                    <div class="w-full h-3 rounded-full bg-slate-100 overflow-hidden relative shadow-inner">
                                        <div class="h-full rounded-full bg-gradient-to-r from-amber-400 via-orange-500 to-rose-600 transition-all duration-700 shadow-sm"
                                             style="width: @prod.SoldPercentage%;"></div>
                                        <div class="absolute inset-0 flex items-center justify-center text-[9px] font-bold text-white uppercase tracking-wider drop-shadow-xs pointer-events-none">
                                            @if (prod.SoldPercentage >= 50)
                                            {
                                                <span>@prod.SoldPercentage%</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- CTA Mua Ngay 1-Click -->
                                <button type="button"
                                        onclick="event.stopPropagation(); event.preventDefault(); addToCart(@prod.ProductId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(prod.ProductName))', @prod.SalePrice, '@img', 1)"
                                        class="w-full py-2.5 rounded-xl bg-gradient-to-r from-magenta-accent to-pink-600 hover:from-pink-600 hover:to-rose-700 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2 cursor-pointer">
                                    <i class="fa-solid fa-cart-shopping text-xs"></i>
                                    <span>Săn Ngay</span>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else if (Model.FlashSaleProducts.Any())
        {
            <!-- Fallback hiển thị FlashSaleProducts -->
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                @foreach (var prod in Model.FlashSaleProducts)
                {
                    <partial name="_ProductCard" model="prod" />
                }
            </div>
        }
    </div>
</section>

<!-- Script Countdown Driver cho Flash Sale -->
<script>
    function flashSaleCountdown(endTimeStr) {
        return {
            hours: '00',
            minutes: '00',
            seconds: '00',
            isExpired: false,
            init() {
                const targetTime = new Date(endTimeStr).getTime();
                
                const update = () => {
                    const now = new Date().getTime();
                    const diff = Math.max(0, targetTime - now);

                    if (diff <= 0) {
                        this.isExpired = true;
                        this.hours = '00';
                        this.minutes = '00';
                        this.seconds = '00';
                        return;
                    }

                    const h = Math.floor(diff / (1000 * 60 * 60));
                    const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    const s = Math.floor((diff % (1000 * 60)) / 1000);

                    this.hours = String(h).padStart(2, '0');
                    this.minutes = String(m).padStart(2, '0');
                    this.seconds = String(s).padStart(2, '0');
                };

                update();
                setInterval(update, 1000);
            }
        };
    }
</script>

