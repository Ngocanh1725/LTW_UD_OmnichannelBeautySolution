@*
    Canmake Beauty Solution - Luxury QuickCart Drawer Component (Tối ưu hóa 60 FPS)
    - Hiển thị mượt mà với x-show và x-cloak (tránh lỗi ngắt kết nối HTMX của x-if template)
    - Tự động đồng bộ giỏ hàng tức thì khi mở Drawer và khi thêm sản phẩm
    - Tăng tốc phần cứng với GPU Accelerated Transforms (translate3d/opacity)
*@
<div x-show="cartOpen" 
     x-cloak 
     style="display: none;"
     class="relative z-50" 
     aria-labelledby="slide-over-cart-title" 
     role="dialog" 
     aria-modal="true"
     @@keydown.escape.window="cartOpen = false">
    
    <!-- Nền phủ mờ sương (Backdrop Blur) với GPU Acceleration -->
    <div x-show="cartOpen"
         x-transition:enter="ease-in-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in-out duration-300"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-charcoal/60 backdrop-blur-md transition-opacity will-change-opacity" 
         @@click="cartOpen = false"></div>

    <!-- Ngăn kéo trượt từ phải sang (Off-Canvas Right Drawer) -->
    <!-- Mobile: Full screen (w-full max-w-full); Desktop: max-w-md (448px) -->
    <aside x-show="cartOpen"
           x-transition:enter="transform transition ease-out duration-300"
           x-transition:enter-start="translate-x-full"
           x-transition:enter-end="translate-x-0"
           x-transition:leave="transform transition ease-in duration-250"
           x-transition:leave-start="translate-x-0"
           x-transition:leave-end="translate-x-full"
           class="fixed inset-y-0 right-0 flex w-full max-w-full sm:max-w-md flex-col bg-[var(--rl-surface)] shadow-2xl pointer-events-auto z-50 border-l border-[var(--rl-border-subtle)] will-change-transform">
        
        <!-- Header Drawer -->
        <div class="p-4 sm:p-5 border-b border-[var(--rl-border-subtle)] flex items-center justify-between bg-gradient-to-r from-[var(--rl-bg-blush)] via-[var(--rl-surface)] to-[var(--rl-bg-petal)]/40 shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-[var(--rl-rose)] text-white flex items-center justify-center text-sm shadow-[var(--rl-shadow-xs)]">
                    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 class="font-serif font-bold text-[var(--rl-ink)] text-base sm:text-lg leading-tight" id="slide-over-cart-title">Giỏ Hàng Của Bạn</h3>
                    <span class="text-[11px] text-[var(--rl-mauve)] font-medium">Cam kết 100% Lô Date Mới &amp; Minh Bạch HSD</span>
                </div>
            </div>
            
            <button type="button" 
                    @@click="cartOpen = false" 
                    class="min-w-[44px] min-h-[44px] rounded-full bg-[var(--rl-bg-blush)] hover:bg-[var(--rl-bg-petal)] flex items-center justify-center text-[var(--rl-ink)] hover:text-[var(--rl-rose)] transition cursor-pointer" 
                    aria-label="Đóng giỏ hàng">
                <i class="fa-solid fa-xmark text-base" aria-hidden="true"></i>
            </button>
        </div>
        
        <!-- Nội dung giỏ hàng nạp theo nhu cầu qua HTMX chỉ khi Drawer được mở -->
        <div id="miniCartContent" 
             hx-get="/Cart/MiniCart" 
             hx-trigger="load, reloadMiniCart from:body" 
             class="flex-1 overflow-y-auto flex flex-col scrollbar-thin">
            <!-- Skeleton placeholder mượt mà khi tải -->
            <div class="p-12 text-center text-sm text-[var(--rl-mauve)] flex flex-col items-center justify-center flex-1 space-y-3">
                <div class="w-10 h-10 rounded-full border-3 border-[var(--rl-bg-petal)] border-t-[var(--rl-rose)] animate-spin"></div>
                <span class="text-xs font-semibold text-[var(--rl-ink)] animate-pulse">Đang cập nhật giỏ hàng...</span>
            </div>
        </div>

    </aside>
</div>
