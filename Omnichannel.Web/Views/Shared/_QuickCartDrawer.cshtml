@*
    Omnichannel Beauty Solution - Luxury QuickCart Drawer Component (Tối ưu hóa Main Thread)
    - Chỉ khởi tạo DOM khi người dùng bấm mở (x-if thay vì x-show đơn thuần)
    - Triệt tiêu 100% eager HTMX requests khi tải trang ban đầu
    - Tăng tốc phần cứng với GPU Accelerated Transforms (translate3d/opacity)
*@
<template x-if="cartOpen">
    <div class="relative z-50" 
         aria-labelledby="slide-over-cart-title" 
         role="dialog" 
         aria-modal="true"
         @@keydown.escape.window="cartOpen = false">
        
        <!-- Nền phủ mờ sương (Backdrop Blur) với GPU Acceleration -->
        <div x-transition:enter="ease-in-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in-out duration-300"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-charcoal/60 backdrop-blur-md transition-opacity will-change-opacity" 
             @@click="cartOpen = false"></div>

        <!-- Ngăn kéo trượt từ phải sang (Off-Canvas Right Drawer) -->
        <aside x-transition:enter="transform transition ease-in-out duration-300"
               x-transition:enter-start="translate-x-full"
               x-transition:enter-end="translate-x-0"
               x-transition:leave="transform transition ease-in-out duration-300"
               x-transition:leave-start="translate-x-0"
               x-transition:leave-end="translate-x-full"
               class="fixed inset-y-0 right-0 flex max-w-md flex-col bg-white shadow-2xl pointer-events-auto w-full z-50 border-l border-soft-border will-change-transform">
            
            <!-- Header Drawer -->
            <div class="p-4 sm:p-5 border-b border-soft-border flex items-center justify-between bg-gradient-to-r from-pastel-rose via-white to-pink-50/50">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-magenta-accent text-white flex items-center justify-center text-sm shadow-xs">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-charcoal text-sm leading-tight" id="slide-over-cart-title">Giỏ Hàng Của Bạn</h3>
                        <span class="text-[10px] text-slate-500 font-medium">Bảo hộ chất lượng & HSD chuẩn FEFO</span>
                    </div>
                </div>
                
                <button type="button" 
                        @@click="cartOpen = false" 
                        class="h-8 w-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-charcoal transition" 
                        aria-label="Đóng giỏ hàng">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>
            
            <!-- Nội dung giỏ hàng nạp theo nhu cầu qua HTMX chỉ khi Drawer được mở -->
            <div id="miniCartContent" 
                 hx-get="/Cart/MiniCart" 
                 hx-trigger="load, reloadMiniCart from:body" 
                 class="flex-1 overflow-y-auto flex flex-col scrollbar-thin">
                <!-- Skeleton placeholder mượt mà khi tải -->
                <div class="p-12 text-center text-sm text-slate-400 flex flex-col items-center justify-center flex-1 space-y-3">
                    <div class="w-10 h-10 rounded-full border-3 border-pink-100 border-t-magenta-accent animate-spin"></div>
                    <span class="text-xs font-semibold text-charcoal animate-pulse">Đang đồng bộ giỏ hàng FEFO...</span>
                </div>
            </div>

        </aside>
    </div>
</template>
