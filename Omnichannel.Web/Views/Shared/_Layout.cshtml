@inject Omnichannel.Application.Interfaces.Cms.IThemeService ThemeService
@{
    var theme = await ThemeService.GetCurrentThemeAsync();
}
<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {theme.BrandName}" : $"{theme.BrandName} | Luxury Cosmetics & Skincare")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong cam kết date mới minh bạch. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />

    <!-- Canonical & Search Engine Directives -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1")" />

    <!-- Brand Identity & Favicon Suite (CANMAKE BEAUTY) -->
    <link rel="icon" type="image/svg+xml" href="@Brand.FaviconSvgUrl" />
    <link rel="icon" type="image/x-icon" href="@Brand.FaviconUrl" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Brand.Favicon32Url" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Brand.AppleTouchIconUrl" />
    <link rel="manifest" href="@Brand.ManifestUrl" />
    <meta name="theme-color" content="@Brand.ThemeColor" />

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@Brand.Name" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {Brand.ShortName}" : $"{Brand.ShortName} | Luxury Cosmetics & Skincare")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong cam kết date mới minh bạch. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Brand.OgImageUrl}")" />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {Brand.ShortName}" : $"{Brand.ShortName} | Luxury Cosmetics & Skincare")" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong cam kết date mới minh bạch. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Brand.OgImageUrl}")" />

    <!-- Schema.org JSON-LD: Organization & WebSite (Google Rich Results Standard) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "Organization",
          "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#organization",
          "name": "@Brand.Name",
          "alternateName": "@Brand.ShortName",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)/",
          "logo": {
            "@@type": "ImageObject",
            "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#logo",
            "url": "@(Context.Request.Scheme)://@(Context.Request.Host)@Brand.LogoUrl",
            "caption": "@Brand.Name - Luxury Cosmetics & Skincare"
          },
          "image": "@(Context.Request.Scheme)://@(Context.Request.Host)@Brand.OgImageUrl",
          "description": "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong cam kết date mới minh bạch. Cam kết 100% chính hãng, giao hàng tốc hành 2H.",
          "telephone": "@Brand.Hotline",
          "email": "@Brand.Email",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "68 Nguyễn Huệ, Phường Bến Nghé, Quận 1",
            "addressLocality": "Hồ Chí Minh",
            "postalCode": "700000",
            "addressCountry": "VN"
          },
          "contactPoint": [
            {
              "@@type": "ContactPoint",
              "telephone": "+84-1900-8888",
              "contactType": "customer service",
              "areaServed": "VN",
              "availableLanguage": ["vi", "en"]
            }
          ],
          "sameAs": [
            "https://www.facebook.com/canmakebeauty.vn",
            "https://www.instagram.com/canmakebeauty.official",
            "https://www.tiktok.com/@@canmakebeauty.vn",
            "https://www.youtube.com/@@canmakebeautyvietnam"
          ]
        },
        {
          "@@type": "WebSite",
          "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#website",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)/",
          "name": "@Brand.Name",
          "description": "Mỹ Phẩm & Dược Mỹ Phẩm Cao Cấp Cam Kết Date Mới",
          "publisher": {
            "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#organization"
          },
          "potentialAction": {
            "@@type": "SearchAction",
            "target": {
              "@@type": "EntryPoint",
              "urlTemplate": "@(Context.Request.Scheme)://@(Context.Request.Host)/Product/Search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>

    <!-- Google Fonts: Rosé Luxe Haute Couture Typography (Playfair Display Full Suite, Cormorant Garamond, JetBrains Mono, Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700;1,800;1,900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome 6.5.1 (Preconnect + Non-blocking load) -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- NProgress Page Loading Bar (Deferred CSS) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nprogress/0.2.0/nprogress.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nprogress/0.2.0/nprogress.min.css" /></noscript>
    <style>
        [x-cloak] { display: none !important; }
        #nprogress .bar {
            background: linear-gradient(90deg, #E8618C, #B8336A, #F7C6D4) !important;
            height: 3px !important;
            box-shadow: 0 0 10px rgba(232, 97, 140, 0.7);
        }
        #nprogress .peg {
            box-shadow: 0 0 10px #E8618C, 0 0 5px #B8336A !important;
        }
        #nprogress .spinner-icon {
            border-top-color: #E8618C !important;
            border-left-color: #E8618C !important;
        }
    </style>

    <!-- Base Legacy Styles & Compiled Tailwind v4 Bundle -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Dynamic Theme Engine from Database -->
    @await Component.InvokeAsync("ThemeStyle")

    <!-- Design System Rosé Luxe (Load cuối cùng để đảm bảo ưu tiên token & chuẩn tương phản AA) -->
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />

    <!-- HTMX, Alpine.js, SignalR & SweetAlert2 with Defer for 100% Non-blocking Render -->
    <script defer src="https://unpkg.com/htmx.org@1.9.10/dist/htmx.min.js"></script>
    <script defer src="https://unpkg.com/htmx.org@1.9.10/dist/ext/json-enc.js"></script>
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@@alpinejs/collapse@@3.13.5/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body x-data="storefrontApp()" hx-ext="json-enc" class="min-h-full flex flex-col antialiased font-sans selection:bg-pink-100 selection:text-magenta-accent bg-bg-base">
    <!-- Skip Link chuẩn WCAG 2.4.1 cho người dùng bàn phím & trình đọc màn hình -->
    <a href="#mainContent" class="skip-link">Bỏ qua điều hướng tới nội dung chính</a>

    @Html.AntiForgeryToken()

    <!-- Modular Header (Top Announcement + Floating Pill Header + Mega Nav + Fullscreen Search Overlay) -->
    <partial name="_Header" />

    <!-- Modular Mobile Menu Off-Canvas Drawer -->
    <partial name="_MobileMenu" />

    <!-- Main Content Body -->
    <main class="flex-1 focus:outline-none" id="mainContent" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <!-- Modular Footer -->
    <partial name="_Footer" />

    <!-- Quick Cart Drawer (Lazy Mounted via template x-if) -->
    <partial name="_QuickCartDrawer" />

    <!-- Quick View Modal (Lazy Mounted via template x-if) -->
    <partial name="_QuickViewModal" />

    <!-- Floating Back-to-Top Button với Passive Scroll Listener (Chuẩn vùng chạm 44x44px, không đè Chatbot) -->
    <button type="button"
            x-data="{ showTop: false }"
            @@scroll.window.passive="showTop = (window.pageYOffset > 300)"
            x-show="showTop"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4 scale-75"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 translate-y-4 scale-75"
            @@click="window.scrollTo({ top: 0, behavior: 'smooth' })"
            class="fixed bottom-36 md:bottom-24 right-4 sm:right-6 z-40 h-11 w-11 rounded-full bg-charcoal/90 text-white hover:bg-magenta-accent shadow-xl flex items-center justify-center transition-all duration-300 border border-slate-700/50 hover:scale-110 group will-change-transform cursor-pointer"
            aria-label="Cuộn về đầu trang"
            style="display: none;">
        <i class="fa-solid fa-arrow-up text-xs text-rose-gold group-hover:text-white transition-colors" aria-hidden="true"></i>
    </button>

    <!-- AI Chatbot Assistant Widget phong cách CANMAKE BEAUTY -->
    <partial name="_ChatbotWidget" />

    <!-- Mobile Bottom Tab Bar (5 Mục Rosé Luxe: Trang chủ, Danh mục, Quiz Da nút giữa tròn Rose nổi bật, Yêu thích, Tài khoản) -->
    <nav id="mobileBottomNav"
         aria-label="Thanh điều hướng nhanh trên di động"
         x-data="{
            activeTab: 0,
            wishlistCount: 0,
            keyboardOpen: false,
            baseViewportHeight: 0,
            initBottomBar() {
                const path = (window.location.pathname || '/').toLowerCase();
                if (path.startsWith('/category') || path.startsWith('/danh-muc') || path.startsWith('/tim-kiem')) this.activeTab = 1;
                else if (path.startsWith('/tu-van-da') || path.startsWith('/routinequiz')) this.activeTab = 2;
                else if (path.startsWith('/wishlist')) this.activeTab = 3;
                else if (path.startsWith('/account') || path.startsWith('/customer') || path.startsWith('/admin')) this.activeTab = 4;
                else this.activeTab = 0;

                // Đồng bộ số lượng Yêu thích (Wishlist)
                const syncWishlist = () => {
                    try {
                        const stored = JSON.parse(localStorage.getItem('omni_wishlist_ids') || '[]');
                        if (Array.isArray(stored)) this.wishlistCount = stored.length;
                    } catch (e) {}
                    const headerWish = document.getElementById('wishlistCountBadge');
                    if (headerWish) {
                        const parsed = parseInt(headerWish.textContent || '0', 10);
                        if (!isNaN(parsed) && parsed > 0) this.wishlistCount = parsed;
                    }
                };
                syncWishlist();
                const headerWishBadge = document.getElementById('wishlistCountBadge');
                if (headerWishBadge) {
                    new MutationObserver(syncWishlist).observe(headerWishBadge, { childList: true, characterData: true, subtree: true });
                }

                // Tự động ẩn Bottom Navigation khi bàn phím ảo mở trên Mobile
                this.baseViewportHeight = window.visualViewport ? window.visualViewport.height : window.innerHeight;
                if (window.visualViewport) {
                    window.visualViewport.addEventListener('resize', () => {
                        const diff = this.baseViewportHeight - window.visualViewport.height;
                        if (diff > 140) {
                            this.keyboardOpen = true;
                        } else if (diff < 60) {
                            const activeTag = document.activeElement?.tagName;
                            if (!['INPUT', 'TEXTAREA', 'SELECT'].includes(activeTag)) {
                                this.keyboardOpen = false;
                            }
                        }
                    });
                }

                document.addEventListener('focusin', (e) => {
                    const el = e.target;
                    if (el && ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName) && !['checkbox', 'radio', 'button', 'submit'].includes(el.type)) {
                        this.keyboardOpen = true;
                    }
                });

                document.addEventListener('focusout', () => {
                    setTimeout(() => {
                        const activeEl = document.activeElement;
                        const isTextInput = activeEl && ['INPUT', 'TEXTAREA', 'SELECT'].includes(activeEl.tagName) && !['checkbox', 'radio', 'button', 'submit'].includes(activeEl.type);
                        if (!isTextInput) {
                            this.keyboardOpen = false;
                        }
                    }, 120);
                });
            }
         }"
         x-init="initBottomBar()"
         :class="keyboardOpen ? 'translate-y-full opacity-0 pointer-events-none' : 'translate-y-0 opacity-100'"
         style="padding-bottom: env(safe-area-inset-bottom, 0px);"
         class="fixed bottom-0 inset-x-0 z-[1040] md:hidden bg-[var(--rl-surface)]/95 backdrop-blur-xl border-t border-[var(--rl-border-strong)] shadow-[0_-8px_28px_rgba(35,25,30,0.08)] transition-all duration-250 ease-out select-none">

        <div class="relative grid grid-cols-5 gap-2 h-[64px] max-w-md mx-auto px-2.5 items-center">
            <!-- 1. Trang chủ -->
            <a href="/"
               @@click="activeTab = 0"
               aria-label="Trang chủ"
               class="min-w-[44px] min-h-[48px] flex flex-col items-center justify-center gap-0.5 rounded-2xl transition-colors"
               :class="activeTab === 0 ? 'text-[var(--rl-rose)] font-bold' : 'text-[var(--rl-mauve)] hover:text-[var(--rl-ink)] font-medium'">
                <i class="fa-solid fa-house text-base" aria-hidden="true"></i>
                <span class="text-[10px] leading-tight">Trang chủ</span>
            </a>

            <!-- 2. Danh mục -->
            <button type="button"
                    @@click="activeTab = 1; mobileMenuOpen = true"
                    aria-label="Mở danh mục mỹ phẩm"
                    :aria-expanded="mobileMenuOpen ? 'true' : 'false'"
                    aria-controls="mobileNavigationDrawer"
                    class="min-w-[44px] min-h-[48px] flex flex-col items-center justify-center gap-0.5 rounded-2xl transition-colors cursor-pointer"
                    :class="activeTab === 1 || mobileMenuOpen ? 'text-[var(--rl-rose)] font-bold' : 'text-[var(--rl-mauve)] hover:text-[var(--rl-ink)] font-medium'">
                <i class="fa-solid fa-grid-2 text-base" aria-hidden="true"></i>
                <span class="text-[10px] leading-tight">Danh mục</span>
            </button>

            <!-- 3. Quiz Da (Nút giữa nổi bật hình tròn Rose #B8336A) -->
            <a href="/tu-van-da"
               @@click="activeTab = 2"
               aria-label="Trắc nghiệm Quiz Da cá nhân hoá"
               class="min-w-[44px] min-h-[56px] flex flex-col items-center justify-center relative group">
                <span class="w-12 h-12 -mt-5 rounded-full bg-[linear-gradient(135deg,#B8336A_0%,#8E1F4F_100%)] text-white shadow-[0_10px_24px_rgba(184,51,106,0.38)] ring-4 ring-[var(--rl-bg)] flex items-center justify-center group-active:scale-95 transition-transform">
                    <i class="fa-solid fa-wand-magic-sparkles text-base" aria-hidden="true"></i>
                </span>
                <span class="text-[10px] font-extrabold text-[var(--rl-rose)] leading-tight mt-0.5">Quiz Da</span>
            </a>

            <!-- 4. Yêu thích -->
            <a href="/wishlist"
               @@click="activeTab = 3"
               aria-label="Danh sách yêu thích"
               class="relative min-w-[44px] min-h-[48px] flex flex-col items-center justify-center gap-0.5 rounded-2xl transition-colors"
               :class="activeTab === 3 ? 'text-[var(--rl-rose)] font-bold' : 'text-[var(--rl-mauve)] hover:text-[var(--rl-ink)] font-medium'">
                <span class="relative inline-flex items-center justify-center">
                    <i class="fa-regular fa-heart text-base" aria-hidden="true"></i>
                    <span x-cloak
                          x-show="wishlistCount > 0"
                          x-text="wishlistCount"
                          class="absolute -top-1.5 -right-2.5 min-w-[16px] h-[16px] px-1 rounded-full bg-[var(--rl-rose)] text-white text-[9px] font-bold flex items-center justify-center font-mono-numeric"></span>
                </span>
                <span class="text-[10px] leading-tight">Yêu thích</span>
            </a>

            <!-- 5. Tài khoản -->
            <a href="@(User.Identity?.IsAuthenticated == true ? "/Customer/Dashboard" : "/Account/Login")"
               @@click="activeTab = 4"
               aria-label="Tài khoản cá nhân"
               class="min-w-[44px] min-h-[48px] flex flex-col items-center justify-center gap-0.5 rounded-2xl transition-colors"
               :class="activeTab === 4 ? 'text-[var(--rl-rose)] font-bold' : 'text-[var(--rl-mauve)] hover:text-[var(--rl-ink)] font-medium'">
                <i class="fa-regular fa-user text-base" aria-hidden="true"></i>
                <span class="text-[10px] leading-tight">Tài khoản</span>
            </a>
        </div>
    </nav>

    <!-- Global Toast Notifications Container -->
    <div id="storefrontToastContainer" class="fixed bottom-20 lg:bottom-6 right-6 z-50 flex flex-col gap-2.5 max-w-sm pointer-events-none" role="status" aria-live="polite"></div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Customer Realtime Order & System Notification via SignalR -->
        <script>
            window.addEventListener('load', function () {
                if (!window.signalR) return;

                try {
                    const customerHubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect([0, 3000, 10000])
                        .build();

                    customerHubConnection.on("ReceiveNotification", function (payload, arg2) {
                        let title = "Thông Báo Đơn Hàng";
                        let message = "";
                        let severity = "INFO";
                        let url = "/Account/Orders";

                        if (typeof payload === 'string') {
                            message = payload;
                            if (typeof arg2 === 'string') severity = arg2;
                        } else if (payload && typeof payload === 'object') {
                            title = payload.title || payload.Title || title;
                            message = payload.message || payload.Message || "";
                            severity = (payload.severity || payload.Severity || "INFO").toUpperCase();
                            url = payload.url || payload.Url || url;
                        }

                        try {
                            window.dispatchEvent(new CustomEvent('storefront-notification-received', {
                                detail: {
                                    id: (payload && (payload.id || payload.Id)) || Date.now(),
                                    title: title,
                                    message: message,
                                    severity: severity,
                                    url: url,
                                    timeAgo: 'Vừa xong',
                                    isRead: false
                                }
                            }));
                        } catch (e) { }

                        try {
                            const AudioCtx = window.AudioContext || window.webkitAudioContext;
                            if (AudioCtx) {
                                const ctx = new AudioCtx();
                                const osc = ctx.createOscillator();
                                const gain = ctx.createGain();
                                osc.type = 'sine';
                                osc.frequency.setValueAtTime(659.25, ctx.currentTime);
                                osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15);
                                gain.gain.setValueAtTime(0.06, ctx.currentTime);
                                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                                osc.connect(gain);
                                gain.connect(ctx.destination);
                                osc.start();
                                osc.stop(ctx.currentTime + 0.35);
                            }
                        } catch (e) { }

                        const iconType = severity === 'DANGER' ? 'error' : (severity === 'WARNING' ? 'warning' : (severity === 'SUCCESS' ? 'success' : 'info'));

                        if (window.Swal) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: iconType,
                                title: title,
                                text: message,
                                showConfirmButton: false,
                                timer: 5000,
                                timerProgressBar: true,
                                showCloseButton: true,
                                customClass: {
                                    popup: 'rounded-2xl shadow-2xl border border-pink-100 font-sans'
                                },
                                didOpen: (toastEl) => {
                                    if (url) {
                                        toastEl.style.cursor = 'pointer';
                                        toastEl.title = 'Bấm để xem chi tiết';
                                        toastEl.onclick = () => {
                                            window.location.href = url;
                                        };
                                    }
                                }
                            });
                        }
                    });

                    customerHubConnection.start()
                        .then(function () {
                            console.debug("[SignalR] Customer NotificationHub đã kết nối thành công.");
                        })
                        .catch(function (err) {
                            console.debug("[SignalR] Lỗi kết nối Customer NotificationHub:", err);
                        });
                } catch (err) {
                    console.debug("[SignalR] Khởi tạo SignalR thất bại:", err);
                }
            });
        </script>
    }

    <!-- NProgress Script & Page Navigation Hooks -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/nprogress/0.2.0/nprogress.min.js"></script>
    <script>
        window.addEventListener('load', function () {
            if (typeof NProgress !== 'undefined') {
                NProgress.configure({ showSpinner: false, speed: 300, minimum: 0.15 });
                window.addEventListener('beforeunload', function () {
                    NProgress.start();
                });
                NProgress.done();
            }
        });
    </script>

    <!-- Khay So Sánh Mỹ Phẩm Nổi Cố Định (GAP-03: Phiên C3) -->
    <partial name="_CompareDrawer" />

    <!-- Modal Giải Thích Chuẩn Hạn Dùng FEFO Cho Khách Hàng -->
    <partial name="_FefoExplainerModal" />

    <!-- Demo Presenter HUD (GAP-12: Phiên E1 - Chỉ render khi DemoMode:Enabled = true) -->
    <partial name="_DemoPresenterHud" />

    <partial name="_LivePreviewScript" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
