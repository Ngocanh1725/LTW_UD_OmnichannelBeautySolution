@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Omnichannel Beauty Store</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & FontAwesome 6 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary-purple: #7C3AED;
            --primary-purple-hover: #6D28D9;
            --primary-purple-light: #F5F3FF;
            --primary-purple-border: #DDD6FE;
            --accent-pink: #EC4899;
            --accent-pink-hover: #DB2777;
            --accent-pink-light: #FDF2F8;
            --accent-pink-border: #FBCFE8;
            --gradient-brand: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            --text-main: #1F2937;
            --text-muted: #6B7280;
            --bg-body: #FAF7FC;
            --border-color: #F1E8F8;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar-strip {
            background: var(--gradient-brand);
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .main-header {
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(124, 58, 237, 0.05);
            border-bottom: 1.5px solid var(--border-color);
        }

        .brand-logo-text {
            font-size: 1.55rem;
            font-weight: 800;
            background: var(--gradient-brand);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
        }

        .btn-primary-gradient {
            background: var(--gradient-brand);
            color: #ffffff !important;
            border: none;
            border-radius: 50rem;
            font-weight: 600;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(236, 72, 153, 0.3);
        }

            .btn-primary-gradient:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(236, 72, 153, 0.45);
                color: #ffffff !important;
            }

        .btn-outline-purple {
            border: 1.5px solid var(--primary-purple);
            color: var(--primary-purple) !important;
            border-radius: 50rem;
            font-weight: 600;
            background: transparent;
            transition: all 0.2s ease;
        }

            .btn-outline-purple:hover {
                background: var(--primary-purple-light);
                color: var(--primary-purple) !important;
            }

        .beauty-card {
            background: #ffffff;
            border: 1.5px solid var(--border-color);
            border-radius: 1.25rem;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .beauty-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 14px 30px rgba(124, 58, 237, 0.1);
                border-color: var(--primary-purple-border);
            }

        .hover-lift {
            transition: all 0.25s ease;
        }

            .hover-lift:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(124, 58, 237, 0.08);
            }

        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .footer-main {
            background: #ffffff;
            border-top: 1.5px solid var(--border-color);
            margin-top: auto;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <!-- 1. Dải thông báo ưu đãi -->
    <div class="topbar-strip py-2 px-3 text-center">
        <i class="fa-solid fa-sparkles me-2"></i>
        <span>ĐẠI TIỆC MỸ PHẨM CHÍNH HÃNG - CAM KẾT HẠN DÙNG XA NHẤT THEO TIÊU CHUẨN FEFO - FREESHIP ĐƠN TỪ 500K</span>
    </div>

    <!-- 2. Header chính -->
    <header class="main-header sticky-top">
        <div class="container py-3">
            <div class="row align-items-center">
                <div class="col-lg-3 col-6">
                    <a asp-controller="Home" asp-action="Index" class="brand-logo-text d-flex align-items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles" style="color: var(--primary-purple);"></i>
                        <span>Omnichannel</span>
                    </a>
                </div>

                <div class="col-lg-5 d-none d-lg-block">
                    <div class="input-group">
                        <input type="text" class="form-control rounded-start-pill border-end-0 ps-4 py-2 border-secondary-subtle" placeholder="Tìm kiếm kem dưỡng, son môi, serum..." />
                        <button class="btn btn-primary-gradient rounded-end-pill px-4" type="button">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>

                <div class="col-lg-4 col-6 d-flex justify-content-end align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-purple px-3 py-2 btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-circle-user" style="color: var(--primary-purple);"></i>
                                <span class="d-none d-sm-inline">@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-4 border-0 py-2 mt-2">
                                @if (User.IsInRole("SUPER_ADMIN") || User.HasClaim("UserType", "5") || User.HasClaim("UserType", "4") || User.HasClaim("UserType", "3") || User.HasClaim("UserType", "2"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 small fw-semibold" href="/Admin/Dashboard">
                                            <i class="fa-solid fa-gauge me-2 text-primary"></i>Trang Quản Trị
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 small fw-semibold" href="/Admin/Pos" target="_blank">
                                            <i class="fa-solid fa-cash-register me-2 text-danger"></i>Màn Hình Thu Ngân POS
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <a class="dropdown-item py-2 small text-danger fw-semibold" href="/Account/Logout">
                                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-purple px-3 py-2 btn-sm d-flex align-items-center gap-2">
                            <i class="fa-regular fa-circle-user"></i>
                            <span class="d-none d-sm-inline">Đăng nhập</span>
                        </a>
                    }

                    <a asp-controller="Cart" asp-action="Index" class="btn btn-primary-gradient px-3 py-2 btn-sm d-flex align-items-center gap-2 position-relative">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span class="d-none d-sm-inline">Giỏ hàng</span>
                    </a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg border-top py-0 bg-white">
            <div class="container">
                @await Component.InvokeAsync("HeaderMenu")
            </div>
        </nav>
    </header>

    <!-- 3. Nội dung trang chủ -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- 4. Mini-Cart Drawer -->
    <div id="miniCartContainer">
        @await Component.InvokeAsync("MiniCart")
    </div>

    <!-- 5. Chân trang Footer -->
    <footer class="footer-main py-5 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3" style="color: var(--primary-purple);">
                        <i class="fa-solid fa-heart me-2 text-danger"></i>Omnichannel Retail
                    </h5>
                    <p class="text-secondary small">Hệ thống phân phối mỹ phẩm chính hãng đa kênh hàng đầu. Tích hợp giải thuật quản trị kho FEFO thông minh giúp khách hàng luôn nhận được sản phẩm có date mới nhất.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="fw-bold text-dark mb-3">Về chúng tôi</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#" class="text-decoration-none text-muted">Giới thiệu</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Showroom</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Chính sách giao nhận</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="fw-bold text-dark mb-3">Hỗ trợ khách hàng</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a href="#" class="text-decoration-none text-muted">Tra cứu đơn hàng</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Đổi trả & Hoàn tiền</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Bảo mật thông tin</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-dark mb-3">Tổng đài CSKH</h6>
                    <p class="h5 fw-bold mb-1 font-monospace" style="color: var(--primary-purple);">1900-8888</p>
                    <small class="text-muted">Hỗ trợ từ 08:00 - 22:00 hàng ngày (kể cả CN và Lễ)</small>
                </div>
            </div>
            <div class="text-center pt-4 mt-4 border-top text-muted small">
                &copy; 2026 Omnichannel Beauty System. Thiết kế trên nền tảng C# ASP.NET Core 8.0 & SQL Server.
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Nạp site.js xử lý ngầm (đếm ngược Flash Sale & giỏ hàng) -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>