@inject Omnichannel.Application.Interfaces.Cms.IThemeService ThemeService
@{
    var theme = await ThemeService.GetCurrentThemeAsync();
}
<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {theme.BrandName}" : $"{theme.BrandName} | Luxury Cosmetics & Skincare")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong công nghệ hạn sử dụng FEFO. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />

    <!-- Canonical & Search Engine Directives -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1")" />

    <!-- Brand Identity & Dynamic Favicon from Database -->
    <link rel="icon" type="image/x-icon" href="@theme.FaviconUrl" />
    <link rel="icon" type="image/png" sizes="32x32" href="@theme.FaviconUrl" />
    <link rel="apple-touch-icon" sizes="180x180" href="@theme.FaviconUrl" />

    <!-- Open Graph & Social Sharing -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="@theme.BrandName" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Omni Beauty" : "Omni Beauty | Luxury Cosmetics & Skincare")" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong công nghệ hạn sử dụng FEFO. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{theme.LogoUrl}")" />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Omni Beauty" : "Omni Beauty | Luxury Cosmetics & Skincare")" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong công nghệ hạn sử dụng FEFO. Cam kết 100% chính hãng, giao hàng tốc hành 2H.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{theme.LogoUrl}")" />

    <!-- Schema.org JSON-LD: Organization & WebSite (Google Rich Results Standard) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "Organization",
          "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#organization",
          "name": "@theme.BrandName",
          "alternateName": "Omnichannel Beauty Solution",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)/",
          "logo": {
            "@@type": "ImageObject",
            "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#logo",
            "url": "@(Context.Request.Scheme)://@(Context.Request.Host)@theme.LogoUrl",
            "caption": "@theme.BrandName - Luxury Cosmetics & Skincare"
          },
          "image": "@(Context.Request.Scheme)://@(Context.Request.Host)@theme.LogoUrl",
          "description": "Hệ thống mua sắm mỹ phẩm cao cấp đa kênh tiên phong công nghệ hạn sử dụng FEFO. Cam kết 100% chính hãng, giao hàng tốc hành 2H.",
          "telephone": "1900 8888",
          "email": "hotro@omnibeauty.vn",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "68 Nguyễn Huệ, Phường Bến Nghé, Quận 1",
            "addressLocality": "Hồ Chí Minh",
            "postalCode": "700000",
            "addressCountry": "VN"
          },
          "contactPoint": [
            {
              "@@type": "ContactPoint",
              "telephone": "+84-1900-8888",
              "contactType": "customer service",
              "areaServed": "VN",
              "availableLanguage": ["vi", "en"]
            }
          ],
          "sameAs": [
            "https://www.facebook.com/omnibeauty.vn",
            "https://www.instagram.com/omnibeauty.official",
            "https://www.tiktok.com/@@omnibeauty.vn",
            "https://www.youtube.com/@@omnibeautyvietnam"
          ]
        },
        {
          "@@type": "WebSite",
          "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#website",
          "url": "@(Context.Request.Scheme)://@(Context.Request.Host)/",
          "name": "OMNI BEAUTY",
          "description": "Mỹ Phẩm & Dược Mỹ Phẩm Cao Cấp Chuẩn Hạn Dùng FEFO",
          "publisher": {
            "@@id": "@(Context.Request.Scheme)://@(Context.Request.Host)/#organization"
          },
          "potentialAction": {
            "@@type": "SearchAction",
            "target": {
              "@@type": "EntryPoint",
              "urlTemplate": "@(Context.Request.Scheme)://@(Context.Request.Host)/Product/Search?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
    </script>

    <!-- Google Fonts: Fully Certified Vietnamese Font Stack (Plus Jakarta Sans, Playfair Display, Lora, Inter, Montserrat) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- NProgress Page Loading Bar -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/nprogress/0.2.0/nprogress.min.css" />
    <style>
        #nprogress .bar {
            background: linear-gradient(90deg, #ec4899, #f43f5e, #8b5cf6) !important;
            height: 3px !important;
            box-shadow: 0 0 10px rgba(236, 72, 153, 0.7);
        }
        #nprogress .peg {
            box-shadow: 0 0 10px #ec4899, 0 0 5px #f43f5e !important;
        }
        #nprogress .spinner-icon {
            border-top-color: #ec4899 !important;
            border-left-color: #ec4899 !important;
        }
    </style>

    <!-- Unified Design Tokens & Themes -->
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <!-- Dynamic Theme Engine from Database -->
    @await Component.InvokeAsync("ThemeStyle")

    <!-- Tailwind CSS CDN with Dynamic Beauty Theme Extension -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'pastel-rose': '#fdf2f4',
                        'pastel-nude': '#faecef',
                        'pastel-cream': '#fff9f6',
                        'rose-gold': '#b76e79',
                        'nude-gold': '#C5A880',
                        'champagne-gold': '#d4af37',
                        'charcoal': '#18181b',
                        'dark-muted': '#3f3f46',
                        'soft-border': '#f1d8dd',
                        'blush': '#f5d6da',
                        'magenta-accent': '#d63384'
                    },
                    fontFamily: {
                        'serif': ['Playfair Display', 'Lora', 'Georgia', 'serif'],
                        'sans': ['Plus Jakarta Sans', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
                        'mono': ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>

    <!-- HTMX, Alpine.js, SignalR & SweetAlert2 with Defer for Non-blocking Render -->
    <script src="https://unpkg.com/htmx.org@1.9.10/dist/htmx.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/json-enc.js"></script>
    <script defer src="~/js/site.js" asp-append-version="true"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@@alpinejs/collapse@@3.13.5/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body x-data="storefrontApp()" hx-ext="json-enc" class="min-h-full flex flex-col antialiased font-sans selection:bg-pink-100 selection:text-magenta-accent bg-[#fffdfd]">
    @Html.AntiForgeryToken()

    <!-- Modular Header (Top Announcement + Glass Sticky Header + Mega Nav) -->
    <partial name="_Header" />

    <!-- Modular Mobile Menu Off-Canvas Drawer -->
    <partial name="_MobileMenu" />

    <!-- Main Content Body -->
    <main class="flex-1" id="mainContent" role="main">
        @RenderBody()
    </main>

    <!-- Modular Footer -->
    <partial name="_Footer" />

    <!-- Quick Cart Drawer (Lazy Mounted via template x-if) -->
    <partial name="_QuickCartDrawer" />

    <!-- Quick View Modal (Lazy Mounted via template x-if) -->
    <partial name="_QuickViewModal" />

    <!-- Floating Back-to-Top Button với Passive Scroll Listener -->
    <button type="button"
            x-data="{ showTop: false }" 
            @@scroll.window.passive="showTop = (window.pageYOffset > 300)" 
            x-show="showTop" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4 scale-75"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 translate-y-4 scale-75"
            @@click="window.scrollTo({ top: 0, behavior: 'smooth' })" 
            class="fixed bottom-36 sm:bottom-24 right-7 z-40 h-10 w-10 rounded-full bg-charcoal/90 text-white hover:bg-magenta-accent shadow-xl flex items-center justify-center transition-all duration-300 border border-slate-700/50 hover:scale-110 group will-change-transform"
            aria-label="Cuộn về đầu trang"
            style="display: none;">
        <i class="fa-solid fa-arrow-up text-xs text-rose-gold group-hover:text-white transition-colors"></i>
    </button>

    <!-- AI Chatbot Assistant Widget phong cách OMNI BEAUTY -->
    <partial name="_ChatbotWidget" />

    <!-- Mobile Bottom Navigation Bar -->
    <nav aria-label="Thanh điều hướng nhanh trên di động" class="mobile-bottom-nav lg:hidden pb-safe">
        <a href="/" class="active">
            <i class="fa-solid fa-house"></i>
            <span>Trang chủ</span>
        </a>
        <a href="javascript:void(0)" @@click="mobileMenuOpen = true">
            <i class="fa-solid fa-layer-group"></i>
            <span>Danh mục</span>
        </a>
        <a href="javascript:void(0)" @@click="cartOpen = true" class="relative">
            <i class="fa-solid fa-bag-shopping"></i>
            <span>Giỏ hàng</span>
        </a>
        <a href="/Account/Login">
            <i class="fa-regular fa-user"></i>
            <span>Tài khoản</span>
        </a>
    </nav>

    <!-- Global Toast Notifications Container -->
    <div id="storefrontToastContainer" class="fixed bottom-20 lg:bottom-6 right-6 z-50 flex flex-col gap-2.5 max-w-sm pointer-events-none" role="status" aria-live="polite"></div>


    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Customer Realtime Order & System Notification via SignalR -->
        <script>
            window.addEventListener('load', function () {
                if (!window.signalR) return;

                try {
                    const customerHubConnection = new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect([0, 3000, 10000]) // Giới hạn số lần thử kết nối lại
                        .build();

                    customerHubConnection.on("ReceiveNotification", function (payload, arg2) {
                        let title = "Thông Báo Đơn Hàng";
                        let message = "";
                        let severity = "INFO";
                        let url = "/Account/Orders";

                        if (typeof payload === 'string') {
                            message = payload;
                            if (typeof arg2 === 'string') severity = arg2;
                        } else if (payload && typeof payload === 'object') {
                            title = payload.title || payload.Title || title;
                            message = payload.message || payload.Message || "";
                            severity = (payload.severity || payload.Severity || "INFO").toUpperCase();
                            url = payload.url || payload.Url || url;
                        }

                        // Phát sự kiện DOM cho Notification Center trên Header Storefront
                        try {
                            window.dispatchEvent(new CustomEvent('storefront-notification-received', {
                                detail: {
                                    id: (payload && (payload.id || payload.Id)) || Date.now(),
                                    title: title,
                                    message: message,
                                    severity: severity,
                                    url: url,
                                    timeAgo: 'Vừa xong',
                                    isRead: false
                                }
                            }));
                        } catch (e) { }

                        // Web Audio Chime dịu nhẹ
                        try {
                            const AudioCtx = window.AudioContext || window.webkitAudioContext;
                            if (AudioCtx) {
                                const ctx = new AudioCtx();
                                const osc = ctx.createOscillator();
                                const gain = ctx.createGain();
                                osc.type = 'sine';
                                osc.frequency.setValueAtTime(659.25, ctx.currentTime);
                                osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15);
                                gain.gain.setValueAtTime(0.06, ctx.currentTime);
                                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                                osc.connect(gain);
                                gain.connect(ctx.destination);
                                osc.start();
                                osc.stop(ctx.currentTime + 0.35);
                            }
                        } catch (e) { }

                        // Toast slide-in góc trên phải, tự biến mất sau 5s
                        const iconType = severity === 'DANGER' ? 'error' : (severity === 'WARNING' ? 'warning' : (severity === 'SUCCESS' ? 'success' : 'info'));

                        if (window.Swal) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: iconType,
                                title: title,
                                text: message,
                                showConfirmButton: false,
                                timer: 5000,
                                timerProgressBar: true,
                                showCloseButton: true,
                                customClass: {
                                    popup: 'rounded-2xl shadow-2xl border border-pink-100 font-sans'
                                },
                                didOpen: (toastEl) => {
                                    if (url) {
                                        toastEl.style.cursor = 'pointer';
                                        toastEl.title = 'Bấm để xem chi tiết';
                                        toastEl.onclick = () => {
                                            window.location.href = url;
                                        };
                                    }
                                }
                            });
                        }
                    });

                    customerHubConnection.start()
                        .then(function () {
                            console.debug("[SignalR] Customer NotificationHub đã kết nối thành công.");
                        })
                        .catch(function (err) {
                            console.debug("[SignalR] Lỗi kết nối Customer NotificationHub:", err);
                        });
                } catch (err) {
                    console.debug("[SignalR] Khởi tạo SignalR thất bại:", err);
                }
            });
        </script>
    }

    <!-- NProgress Script & Page Navigation Hooks -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/nprogress/0.2.0/nprogress.min.js"></script>
    <script>
        window.addEventListener('load', function () {
            if (typeof NProgress !== 'undefined') {
                NProgress.configure({ showSpinner: false, speed: 300, minimum: 0.15 });
                window.addEventListener('beforeunload', function () {
                    NProgress.start();
                });
                NProgress.done();
            }
        });
    </script>

    <!-- Khay So Sánh Mỹ Phẩm Nổi Cố Định (GAP-03: Phiên C3) -->
    <partial name="_CompareDrawer" />

    <!-- Demo Presenter HUD (GAP-12: Phiên E1 - Chỉ render khi DemoMode:Enabled = true) -->
    <partial name="_DemoPresenterHud" />

    <partial name="_LivePreviewScript" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>