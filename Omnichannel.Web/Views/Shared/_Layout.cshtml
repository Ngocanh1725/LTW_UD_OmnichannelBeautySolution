@using Microsoft.AspNetCore.Http

<!-- Google Fonts: Plus Jakarta Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Bootstrap 5.3 & FontAwesome 6 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- File CSS chủ đề hệ thống -->
<link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

<!-- Định nghĩa đồng bộ bảng màu Hồng / Tím Pastel -->
<style>
    :root {
        --primary: #7C3AED;
        --primary-purple: #7C3AED;
        --primary-purple-hover: #6D28D9;
        --primary-purple-light: #F5F3FF;
        --primary-purple-border: #DDD6FE;
        --secondary: #EC4899;
        --accent-pink: #EC4899;
        --accent-pink-hover: #DB2777;
        --accent-pink-light: #FDF2F8;
        --accent-pink-border: #FBCFE8;
        --gradient-brand: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
        --gradient-brand-subtle: linear-gradient(135deg, #FAF5FF 0%, #FDF2F8 100%);
        --text-main: #1F2937;
        --text-muted: #6B7280;
        --bg-body: #FAF7FC;
        --border-color: #F1E8F8;
        --border-soft: #F1E8F8;
    }

    body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Dải thông báo trên cùng */
    .topbar-strip {
        background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    /* Header chính */
    .main-header {
        background: #ffffff;
        box-shadow: 0 4px 20px rgba(124, 58, 237, 0.05);
        border-bottom: 1.5px solid var(--border-color);
    }

    .brand-logo-text {
        font-size: 1.55rem;
        font-weight: 800;
        background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-decoration: none;
    }

    /* Nút bấm & Hiệu ứng chuyển màu */
    .btn-primary-gradient {
        background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
        color: #ffffff !important;
        border: none;
        border-radius: 50rem;
        font-weight: 600;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(236, 72, 153, 0.3);
    }

        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(236, 72, 153, 0.45);
            color: #ffffff !important;
        }

    .btn-outline-purple {
        border: 1.5px solid var(--primary-purple);
        color: var(--primary-purple) !important;
        border-radius: 50rem;
        font-weight: 600;
        background: transparent;
        transition: all 0.2s ease;
    }

        .btn-outline-purple:hover {
            background: var(--primary-purple-light);
            color: var(--primary-purple) !important;
        }

    .btn-soft-purple {
        background-color: var(--primary-purple-light);
        color: var(--primary-purple) !important;
        border: 1.5px solid var(--primary-purple-border);
        border-radius: 50rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-soft-purple:hover {
            background-color: var(--primary-purple);
            color: #ffffff !important;
        }

    /* Thẻ hiển thị làm đẹp */
    .beauty-card {
        background: #ffffff;
        border: 1.5px solid var(--border-color);
        border-radius: 1.25rem;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.04);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .beauty-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(124, 58, 237, 0.1);
            border-color: var(--primary-purple-border);
        }

    .hover-lift {
        transition: all 0.25s ease;
    }

        .hover-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(124, 58, 237, 0.08);
        }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .footer-main {
        background: #ffffff;
        border-top: 1.5px solid var(--border-color);
        margin-top: auto;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
</style>


<!-- 2. Header chính -->
<header class="main-header sticky-top">
    <div class="container py-3">
        <div class="row align-items-center">
            <!-- Logo thương hiệu -->
            <div class="col-lg-3 col-6">
                <a asp-controller="Home" asp-action="Index" class="brand-logo-text d-flex align-items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-primary"></i>
                    <span>Omnichannel</span>
                </a>
            </div>

            <!-- Thanh tìm kiếm -->
            <div class="col-lg-5 d-none d-lg-block">
                <div class="input-group">
                    <input type="text" class="form-control rounded-start-pill border-end-0 ps-4 py-2 border-secondary-subtle" placeholder="Tìm kiếm kem dưỡng, son môi, serum..." />
                    <button class="btn btn-primary-gradient rounded-end-pill px-4" type="button">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <!-- Tài khoản & Giỏ hàng -->
            <div class="col-lg-4 col-6 d-flex justify-content-end align-items-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-purple px-3 py-2 btn-sm d-flex align-items-center gap-2">
                    <i class="fa-regular fa-circle-user"></i>
                    <span class="d-none d-sm-inline">Tài khoản</span>
                </a>

                <a asp-controller="Cart" asp-action="Index" class="btn btn-primary-gradient px-3 py-2 btn-sm d-flex align-items-center gap-2 position-relative">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="d-none d-sm-inline">Giỏ hàng</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Mega Menu động từ CSDL -->
    <nav class="navbar navbar-expand-lg border-top py-0 bg-white">
        <div class="container">
            @await Component.InvokeAsync("HeaderMenu")
        </div>
    </nav>
</header>

<!-- 3. Nội dung chính của trang (Body) -->
<main class="flex-grow-1">
    @RenderBody()
</main>

<!-- 4. Mini-Cart Drawer (Thanh trượt bên phải) -->
<div id="miniCartContainer">
    @await Component.InvokeAsync("MiniCart")
</div>

<!-- 5. Chân trang Footer -->
<footer class="footer-main py-5 mt-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <h5 class="fw-bold mb-3" style="color: var(--primary-purple);">
                    <i class="fa-solid fa-heart me-2 text-danger"></i>Omnichannel Retail
                </h5>
                <p class="text-secondary small">Hệ thống phân phối mỹ phẩm chính hãng đa kênh hàng đầu. Tích hợp giải thuật quản trị kho FEFO thông minh giúp khách hàng luôn nhận được sản phẩm mới nhất.</p>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="fw-bold text-dark mb-3">Về chúng tôi</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="#" class="text-decoration-none text-muted">Giới thiệu</a></li>
                    <li><a href="#" class="text-decoration-none text-muted">Showroom</a></li>
                    <li><a href="#" class="text-decoration-none text-muted">Chính sách giao nhận</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="fw-bold text-dark mb-3">Hỗ trợ khách hàng</h6>
                <ul class="list-unstyled small d-flex flex-column gap-2">
                    <li><a href="#" class="text-decoration-none text-muted">Tra cứu đơn hàng</a></li>
                    <li><a href="#" class="text-decoration-none text-muted">Đổi trả & Hoàn tiền</a></li>
                    <li><a href="#" class="text-decoration-none text-muted">Bảo mật thông tin</a></li>
                </ul>
            </div>
            <div class="col-lg-4">
                <h6 class="fw-bold text-dark mb-3">Tổng đài CSKH</h6>
                <p class="h5 fw-bold text-primary mb-1">1900-8888</p>
                <small class="text-muted">Hỗ trợ từ 08:00 - 22:00 hàng ngày (kể cả CN và Lễ)</small>
            </div>
        </div>
        <div class="text-center pt-4 mt-4 border-top text-muted small">
            &copy; 2026 Omnichannel Beauty System. Thiết kế trên nền tảng C# ASP.NET Core 8.0 & SQL Server.
        </div>
    </div>
</footer>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
