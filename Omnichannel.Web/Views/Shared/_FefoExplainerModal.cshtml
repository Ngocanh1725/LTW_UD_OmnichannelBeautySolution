<!-- =========================================================================
     _FefoExplainerModal.cshtml — MODAL GIẢI THÍCH CHUẨN HẠN DÙNG FEFO (ROSÉ LUXE)
     Giúp người dùng hiểu rõ: FEFO là gì và quyền lợi người tiêu dùng được bảo vệ ra sao
     ========================================================================= -->
<div id="fefoExplainerModal"
     x-data="{
        isOpen: false,
        openModal() {
            this.isOpen = true;
            document.body.classList.add('overflow-hidden');
        },
        closeModal() {
            this.isOpen = false;
            document.body.classList.remove('overflow-hidden');
        }
     }"
     x-init="
        window.addEventListener('open-fefo-modal', () => openModal());
     "
     @@keydown.escape.window="if (isOpen) closeModal()"
     x-cloak
     x-show="isOpen"
     class="fixed inset-0 z-[1100] flex items-center justify-center p-4 sm:p-6"
     role="dialog"
     aria-labelledby="fefoModalTitle"
     aria-modal="true">

    <!-- Lớp nền mờ (Backdrop) -->
    <div x-show="isOpen"
         x-transition:enter="transition-opacity ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @@click="closeModal()"
         class="fixed inset-0 bg-[var(--rl-ink)]/65 backdrop-blur-md"
         aria-hidden="true"></div>

    <!-- Tấm Modal Nổi (Dialog Box) -->
    <div x-show="isOpen"
         x-transition:enter="transition ease-[cubic-bezier(0.22,1,0.36,1)] duration-300 transform"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="opacity-100 scale-100 translate-y-0"
         x-transition:leave-end="opacity-0 scale-95 translate-y-4"
         @@click.outside="closeModal()"
         class="relative z-10 w-full max-w-2xl bg-white rounded-3xl sm:rounded-[32px] border border-[var(--rl-border-subtle)] shadow-[var(--rl-shadow-xl)] overflow-hidden flex flex-col max-h-[90vh]">

        <!-- 1. Header Modal -->
        <div class="p-6 sm:p-8 bg-gradient-to-br from-[var(--rl-bg-blush)] via-white to-[var(--rl-bg-petal)]/30 border-b border-[var(--rl-border-subtle)] relative">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--rl-rose)]/10 text-[var(--rl-rose)] text-[10px] font-bold tracking-widest uppercase mb-2">
                        <i class="fa-solid fa-shield-halved text-xs"></i>
                        <span>Bảo Chứng Chất Lượng &amp; Độ Tươi Mới</span>
                    </span>
                    <h3 id="fefoModalTitle" class="font-serif text-xl sm:text-2xl font-bold text-[var(--rl-ink)] leading-snug">
                        Cam Kết Chất Lượng &amp; <em class="italic text-[var(--rl-rose)] font-normal">Minh Bạch Hạn Dùng</em>
                    </h3>
                    <p class="text-xs text-[var(--rl-mauve)] mt-1.5 font-sans leading-relaxed">
                        Hệ thống áp dụng chuẩn kiểm soát hạn dùng tự động (quản lý theo lô sản xuất) nhằm bảo đảm 100% khách hàng luôn nhận được sản phẩm date mới nhất.
                    </p>
                </div>
                <button type="button"
                        @@click="closeModal()"
                        aria-label="Đóng cửa sổ"
                        class="w-10 h-10 rounded-full bg-white hover:bg-[var(--rl-bg-blush)] text-[var(--rl-mauve)] hover:text-[var(--rl-rose)] border border-[var(--rl-border-subtle)] flex items-center justify-center transition shadow-2xs shrink-0 cursor-pointer">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
        </div>

        <!-- 2. Nội dung 4 Trụ Cột Lợi Ích Khách Hàng -->
        <div class="p-6 sm:p-8 overflow-y-auto space-y-4 text-xs sm:text-sm text-[var(--rl-ink)]">
            
            <!-- Trụ cột 1 -->
            <div class="p-4 rounded-2xl bg-[var(--rl-bg-blush)]/50 border border-[var(--rl-border-subtle)] flex items-start gap-3.5">
                <span class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs text-base">
                    <i class="fa-solid fa-seedling"></i>
                </span>
                <div>
                    <h4 class="font-bold text-[var(--rl-ink)] text-sm mb-1">1. Luôn Giao Lô Sản Xuất Mới Nhất (&gt; 18 Tháng)</h4>
                    <p class="text-xs text-[var(--rl-mauve)] leading-relaxed">
                        Mọi đơn hàng thông thường tại Canmake Beauty đều được hệ thống tự động lọc và cấp phát lô sản xuất mới nhất, hạn sử dụng còn dài từ 1.5 đến 3 năm, nói <strong>KHÔNG</strong> với việc giao hàng tồn cũ lén lút.
                    </p>
                </div>
            </div>

            <!-- Trụ cột 2 -->
            <div class="p-4 rounded-2xl bg-[var(--rl-bg-blush)]/50 border border-[var(--rl-border-subtle)] flex items-start gap-3.5">
                <span class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs text-base">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                </span>
                <div>
                    <h4 class="font-bold text-[var(--rl-ink)] text-sm mb-1">2. Minh Bạch Hạn Dùng Thực Tế Đến Từng Sản Phẩm</h4>
                    <p class="text-xs text-[var(--rl-mauve)] leading-relaxed">
                        Bạn sẽ luôn biết rõ chai lọ mình sắp mua còn chính xác bao nhiêu tháng sử dụng (ví dụ: <em>Date mới • Còn 24T</em>) ngay trên thẻ sản phẩm và giỏ hàng trước khi thanh toán.
                    </p>
                </div>
            </div>

            <!-- Trụ cột 3 -->
            <div class="p-4 rounded-2xl bg-[var(--rl-bg-blush)]/50 border border-[var(--rl-border-subtle)] flex items-start gap-3.5">
                <span class="w-10 h-10 rounded-xl bg-rose-100 text-[var(--rl-rose)] flex items-center justify-center shrink-0 mt-0.5 shadow-2xs text-base">
                    <i class="fa-solid fa-tags"></i>
                </span>
                <div>
                    <h4 class="font-bold text-[var(--rl-ink)] text-sm mb-1">3. Xả Kho Cận Date Công Khai — Tiết Kiệm 40% - 70%</h4>
                    <p class="text-xs text-[var(--rl-mauve)] leading-relaxed">
                        Những lô hàng còn hạn sử dụng từ 3 đến 6 tháng được đưa vào khu vực <strong>Xả Date Minh Bạch</strong> với giá giảm sâu để khách hàng có nhu cầu sử dụng ngay tiết kiệm chi phí mà vẫn an tâm về chất lượng.
                    </p>
                </div>
            </div>

            <!-- Trụ cột 4 -->
            <div class="p-4 rounded-2xl bg-[var(--rl-bg-blush)]/50 border border-[var(--rl-border-subtle)] flex items-start gap-3.5">
                <span class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5 shadow-2xs text-base">
                    <i class="fa-solid fa-snowflake"></i>
                </span>
                <div>
                    <h4 class="font-bold text-[var(--rl-ink)] text-sm mb-1">4. Kho Lưu Trữ Mát 22°C - 25°C Chuẩn Y Khoa GSP</h4>
                    <p class="text-xs text-[var(--rl-mauve)] leading-relaxed">
                        Mỹ phẩm được bảo quản ở nhiệt độ và độ ẩm lý tưởng, đảm bảo các hoạt chất nhạy cảm như Vitamin C, Retinol, Hyaluronic Acid giữ nguyên vẹn 100% hiệu năng khi đến tay bạn.
                    </p>
                </div>
            </div>

        </div>

        <!-- 3. Footer Nút Đóng -->
        <div class="p-4 sm:p-6 bg-[var(--rl-bg-blush)]/30 border-t border-[var(--rl-border-subtle)] flex items-center justify-between gap-3">
            <span class="text-[11px] text-[var(--rl-muted)]">Cam kết hoàn tiền 200% nếu phát hiện cận date không đúng mô tả.</span>
            <button type="button"
                    @@click="closeModal()"
                    class="btn-primary py-2.5 px-6 rounded-full text-xs font-bold uppercase tracking-wider shrink-0 cursor-pointer">
                Đã Hiểu &amp; Mua Sắm Ngay
            </button>
        </div>

    </div>
</div>

