@*
    Canmake Beauty Suite - Rosé Luxe Mobile Off-Canvas Navigation Drawer (_MobileMenu.cshtml)
    Phiên 2:
    - Trượt từ trái (width: min(22rem, 86dvw), height: 100svh chống giật thanh địa chỉ iOS Safari)
    - Danh mục dạng Accordion mượt mà (Alpine x-collapse), có ẢNH THUMBNAIL TRÒN cho từng danh mục
    - Mọi vùng chạm >= 44x44px, khoảng cách giữa các vùng chạm >= 8px
    - Khoá focus (Focus Trap), gán inert cho #mainContent khi mở, hỗ trợ vuốt trái hoặc phím Escape để đóng
*@
<div id="mobileNavigationDrawer"
     x-cloak
     x-show="mobileMenuOpen"
     x-data="mobileDrawerA11y()"
     x-init="watchState()"
     @@keydown.escape.window="if (mobileMenuOpen) closeDrawer()"
     @@keydown.tab="trapTabFocus($event)"
     role="dialog"
     aria-modal="true"
     aria-labelledby="mobileDrawerTitle"
     class="fixed inset-0 z-[1050] lg:hidden flex">

    <!-- Lớp nền mờ (Dimmed Backdrop) -->
    <div x-show="mobileMenuOpen"
         x-transition:enter="transition-opacity ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @@click="closeDrawer()"
         aria-hidden="true"
         class="fixed inset-0 bg-[var(--rl-ink)]/55 backdrop-blur-xs"></div>

    <!-- Tấm Off-Canvas Trượt Từ Trái (100svh theo chuẩn modern-web-guidance navigation-drawer) -->
    <nav x-ref="drawerSheet"
         x-show="mobileMenuOpen"
         tabindex="-1"
         aria-label="Menu danh mục di động"
         @@touchstart.passive="onTouchStart($event)"
         @@touchmove.passive="onTouchMove($event)"
         @@touchend="onTouchEnd()"
         :style="dragOffsetX < 0 ? `transform: translate3d(${dragOffsetX}px, 0, 0); transition: none;` : ''"
         x-transition:enter="transition ease-[cubic-bezier(0.22,1,0.36,1)] duration-300 transform"
         x-transition:enter-start="-translate-x-full"
         x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="translate-x-0"
         x-transition:leave-end="-translate-x-full"
         class="relative z-10 w-[min(22.5rem,86dvw)] h-[100svh] bg-[#FFFDFB] shadow-[var(--rl-shadow-xl)] border-r border-[var(--rl-border-strong)] flex flex-col overflow-hidden focus:outline-none">

        <!-- 1. ĐẦU DRAWER: LOGO + THÔNG TIN TÀI KHOẢN + NÚT ĐÓNG (>= 44x44px) -->
        <div class="p-4 bg-[linear-gradient(135deg,#FBE8EE_0%,#F6D2DF_55%,#FFFDFB_100%)] border-b border-[var(--rl-border-strong)] shrink-0">
            <div class="flex items-center justify-between gap-3">
                <a href="/" class="flex items-center min-h-[44px] py-1" aria-label="@Brand.Name - Trang chủ">
                    <img src="@Brand.LogoUrl"
                         alt="@Brand.Name Logo"
                         id="mobileDrawerTitle"
                         class="h-8 sm:h-9 w-auto max-w-[155px] object-contain"
                         onerror="this.onerror=null; this.src='/images/branding/canmake-logo-horizontal.svg';" />
                    <span class="sr-only">@Brand.Name</span>
                </a>

                <button type="button"
                        x-ref="closeDrawerBtn"
                        @@click="closeDrawer()"
                        aria-label="Đóng menu điều hướng"
                        class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-white/90 hover:bg-white text-[var(--rl-ink)] hover:text-[var(--rl-rose)] border border-[var(--rl-border-strong)] shadow-2xs transition shrink-0">
                    <i class="fa-solid fa-xmark text-base" aria-hidden="true"></i>
                </button>
            </div>

            <!-- Thẻ Chào Mừng / Đăng Nhập -->
            <div class="mt-3 pt-3 border-t border-[var(--rl-border-strong)]/60">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="w-9 h-9 rounded-full bg-[var(--rl-rose)] text-white font-bold text-xs flex items-center justify-center shrink-0">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </span>
                            <div class="min-w-0">
                                <div class="text-xs font-bold text-[var(--rl-ink)] truncate">@User.Identity.Name</div>
                                <div class="text-[10px] font-bold text-[var(--rl-rose)]">✦ Hội Viên Rosé VIP</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <a href="/Customer/Dashboard"
                               class="inline-flex items-center justify-center min-h-[38px] px-3 rounded-full bg-white text-[var(--rl-rose)] text-xs font-bold border border-[var(--rl-border-strong)]">
                                Hồ sơ
                            </a>
                            <a href="/Account/Logout"
                               class="inline-flex items-center justify-center min-h-[38px] px-2.5 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 text-xs font-bold border border-rose-200"
                               title="Đăng xuất">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-2.5">
                        <a href="/Account/Login"
                           class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 rounded-full bg-[var(--rl-rose)] text-white text-xs font-bold shadow-[var(--rl-shadow-xs)]">
                            <i class="fa-regular fa-user text-[11px]" aria-hidden="true"></i>
                            <span>Đăng Nhập</span>
                        </a>
                        <a href="/Account/Register"
                           class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 rounded-full bg-white text-[var(--rl-ink)] hover:text-[var(--rl-rose)] text-xs font-bold border border-[var(--rl-border-strong)]">
                            <i class="fa-solid fa-sparkles text-[11px] text-[var(--rl-rose)]" aria-hidden="true"></i>
                            <span>Đăng Ký VIP</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- 2. THÂN DRAWER: DANH MỤC ACCORDION CÓ ẢNH THUMBNAIL TRÒN -->
        <div class="flex-1 overflow-y-auto px-4 py-4 space-y-5" x-data="{ openCat: 'skincare' }">

            <!-- Lối tắt Cá Nhân Hoá (Touch Target >= 44px, gap >= 8px) -->
            <div class="grid grid-cols-2 gap-2.5">
                <a href="/tu-van-da"
                   class="flex items-center gap-2.5 min-h-[48px] p-2.5 rounded-2xl bg-[var(--rl-bg-blush)] border border-[var(--rl-border-strong)] text-[var(--rl-ink)] hover:border-[var(--rl-rose)] transition">
                    <span class="w-8 h-8 rounded-full bg-[var(--rl-rose)] text-white flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-wand-magic-sparkles text-xs" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <div class="text-xs font-bold leading-tight truncate">Quiz Da 4 Bước</div>
                        <div class="text-[10px] text-[var(--rl-rose)] font-semibold">Cá nhân hoá</div>
                    </div>
                </a>

                <a href="/Product/SmartFilter"
                   class="flex items-center gap-2.5 min-h-[48px] p-2.5 rounded-2xl bg-white border border-[var(--rl-border-subtle)] text-[var(--rl-ink)] hover:border-[var(--rl-rose)] transition">
                    <span class="w-8 h-8 rounded-full bg-[var(--rl-bg-petal)] text-[var(--rl-rose)] flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-sliders text-xs" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <div class="text-xs font-bold leading-tight truncate">Smart Filter</div>
                        <div class="text-[10px] text-[var(--rl-muted)] font-medium">Lọc hoạt chất</div>
                    </div>
                </a>
            </div>

            <!-- Danh mục sản phẩm dạng Accordion với Ảnh Thumbnail Tròn -->
            <div>
                <div class="flex items-center justify-between px-1 mb-2.5">
                    <span class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-[var(--rl-mauve)]">
                        Danh Mục Mỹ Phẩm
                    </span>
                    <a href="/tim-kiem" class="text-xs font-bold text-[var(--rl-rose)] py-1">Xem tất cả</a>
                </div>

                <div class="space-y-2.5">
                    <!-- Danh mục 1: Chăm Sóc Da (Thumbnail tròn) -->
                    <div class="rounded-2xl bg-white border border-[var(--rl-border-subtle)] overflow-hidden shadow-[var(--rl-shadow-xs)]">
                        <button type="button"
                                @@click="openCat = (openCat === 'skincare' ? null : 'skincare')"
                                :aria-expanded="(openCat === 'skincare').toString()"
                                class="w-full min-h-[56px] px-3.5 py-2.5 flex items-center justify-between gap-3 text-left hover:bg-[var(--rl-bg-blush)]/40 transition">
                            <span class="flex items-center gap-3 min-w-0">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-SKIN-LRP-002")"
                                     alt="Chăm Sóc Da"
                                     width="40"
                                     height="40"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-10 h-10 rounded-full object-cover border-2 border-[var(--rl-bg-petal)] shadow-2xs shrink-0" />
                                <span class="min-w-0">
                                    <span class="block text-sm font-bold text-[var(--rl-ink)] truncate">Chăm Sóc Da</span>
                                    <span class="block text-[11px] text-[var(--rl-muted)] truncate">Rửa mặt, Toner, Serum B5, Kem dưỡng</span>
                                </span>
                            </span>
                            <span class="w-8 h-8 rounded-full bg-[var(--rl-bg-blush)] flex items-center justify-center text-[var(--rl-rose)] shrink-0">
                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"
                                   :class="openCat === 'skincare' ? 'rotate-180' : ''"
                                   aria-hidden="true"></i>
                            </span>
                        </button>
                        <div x-show="openCat === 'skincare'" x-collapse class="border-t border-[var(--rl-border-subtle)] bg-[var(--rl-bg)] px-3 py-2 space-y-2">
                            <a href="/tim-kiem?categorySlug=sua-rua-mat" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Sữa Rửa Mặt Dịu Nhẹ pH 5.5</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=toner-nuoc-hoa-hong" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Toner &amp; Nước Hoa Hồng Cấp Ẩm</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=serum-tinh-chat" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-bold text-[var(--rl-rose)] bg-[var(--rl-bg-blush)]/60 transition">
                                <span>Serum B5 &amp; Tinh Chất Phục Hồi</span>
                                <span class="text-[9px] font-extrabold px-2 py-0.5 rounded-full bg-[var(--rl-rose)] text-white">HOT</span>
                            </a>
                            <a href="/tim-kiem?categorySlug=kem-duong-am" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Kem Dưỡng Khóa Ẩm Biểu Bì</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Danh mục 2: Trang Điểm Rosé (Thumbnail tròn) -->
                    <div class="rounded-2xl bg-white border border-[var(--rl-border-subtle)] overflow-hidden shadow-[var(--rl-shadow-xs)]">
                        <button type="button"
                                @@click="openCat = (openCat === 'makeup' ? null : 'makeup')"
                                :aria-expanded="(openCat === 'makeup').toString()"
                                class="w-full min-h-[56px] px-3.5 py-2.5 flex items-center justify-between gap-3 text-left hover:bg-[var(--rl-bg-blush)]/40 transition">
                            <span class="flex items-center gap-3 min-w-0">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-LIP-DIO-037")"
                                     alt="Trang Điểm"
                                     width="40"
                                     height="40"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-10 h-10 rounded-full object-cover border-2 border-[var(--rl-bg-petal)] shadow-2xs shrink-0" />
                                <span class="min-w-0">
                                    <span class="block text-sm font-bold text-[var(--rl-ink)] truncate">Trang Điểm Cao Cấp</span>
                                    <span class="block text-[11px] text-[var(--rl-muted)] truncate">Son môi, Cushion, Má hồng, Phấn mắt</span>
                                </span>
                            </span>
                            <span class="w-8 h-8 rounded-full bg-[var(--rl-bg-blush)] flex items-center justify-center text-[var(--rl-rose)] shrink-0">
                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"
                                   :class="openCat === 'makeup' ? 'rotate-180' : ''"
                                   aria-hidden="true"></i>
                            </span>
                        </button>
                        <div x-show="openCat === 'makeup'" x-collapse class="border-t border-[var(--rl-border-subtle)] bg-[var(--rl-bg)] px-3 py-2 space-y-2">
                            <a href="/tim-kiem?categorySlug=son-moi" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Son Thỏi Lì &amp; Son Kem Bóng</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=kem-nen-cushion" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Kem Nền &amp; Cushion Căng Bóng</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=phan-mat" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Bảng Mắt &amp; Phấn Má Hồng Đào</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Danh mục 3: Chống Nắng & Cơ Thể (Thumbnail tròn) -->
                    <div class="rounded-2xl bg-white border border-[var(--rl-border-subtle)] overflow-hidden shadow-[var(--rl-shadow-xs)]">
                        <button type="button"
                                @@click="openCat = (openCat === 'sunbody' ? null : 'sunbody')"
                                :aria-expanded="(openCat === 'sunbody').toString()"
                                class="w-full min-h-[56px] px-3.5 py-2.5 flex items-center justify-between gap-3 text-left hover:bg-[var(--rl-bg-blush)]/40 transition">
                            <span class="flex items-center gap-3 min-w-0">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-SKIN-ANE-001")"
                                     alt="Chống Nắng và Cơ Thể"
                                     width="40"
                                     height="40"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-10 h-10 rounded-full object-cover border-2 border-[var(--rl-bg-petal)] shadow-2xs shrink-0" />
                                <span class="min-w-0">
                                    <span class="block text-sm font-bold text-[var(--rl-ink)] truncate">Chống Nắng &amp; Cơ Thể</span>
                                    <span class="block text-[11px] text-[var(--rl-muted)] truncate">SPF50+ PA++++, Sữa tắm, Dưỡng thể</span>
                                </span>
                            </span>
                            <span class="w-8 h-8 rounded-full bg-[var(--rl-bg-blush)] flex items-center justify-center text-[var(--rl-rose)] shrink-0">
                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"
                                   :class="openCat === 'sunbody' ? 'rotate-180' : ''"
                                   aria-hidden="true"></i>
                            </span>
                        </button>
                        <div x-show="openCat === 'sunbody'" x-collapse class="border-t border-[var(--rl-border-subtle)] bg-[var(--rl-bg)] px-3 py-2 space-y-2">
                            <a href="/tim-kiem?categorySlug=kem-chong-nang" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Kem Chống Nắng Kiềm Dầu Phổ Rộng</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=nuoc-tay-trang" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Nước Tẩy Trang Làm Sạch Sâu</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=cham-soc-co-the" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Dưỡng Thể Trắng Hồng &amp; Tẩy Tế Bào</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Danh mục 4: Nước Hoa, Tóc & Quà Tặng (Thumbnail tròn) -->
                    <div class="rounded-2xl bg-white border border-[var(--rl-border-subtle)] overflow-hidden shadow-[var(--rl-shadow-xs)]">
                        <button type="button"
                                @@click="openCat = (openCat === 'fragrance' ? null : 'fragrance')"
                                :aria-expanded="(openCat === 'fragrance').toString()"
                                class="w-full min-h-[56px] px-3.5 py-2.5 flex items-center justify-between gap-3 text-left hover:bg-[var(--rl-bg-blush)]/40 transition">
                            <span class="flex items-center gap-3 min-w-0">
                                <img src="/images/banners/banner-luxury-fragrance.jpg"
                                     alt="Nước Hoa và Quà Tặng"
                                     width="40"
                                     height="40"
                                     loading="lazy"
                                     decoding="async"
                                     class="w-10 h-10 rounded-full object-cover border-2 border-[var(--rl-bg-petal)] shadow-2xs shrink-0" />
                                <span class="min-w-0">
                                    <span class="block text-sm font-bold text-[var(--rl-ink)] truncate">Nước Hoa &amp; Quà Tặng</span>
                                    <span class="block text-[11px] text-[var(--rl-muted)] truncate">Dior, Chanel, YSL &amp; Chăm sóc tóc</span>
                                </span>
                            </span>
                            <span class="w-8 h-8 rounded-full bg-[var(--rl-bg-blush)] flex items-center justify-center text-[var(--rl-rose)] shrink-0">
                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"
                                   :class="openCat === 'fragrance' ? 'rotate-180' : ''"
                                   aria-hidden="true"></i>
                            </span>
                        </button>
                        <div x-show="openCat === 'fragrance'" x-collapse class="border-t border-[var(--rl-border-subtle)] bg-[var(--rl-bg)] px-3 py-2 space-y-2">
                            <a href="/tim-kiem?categorySlug=nuoc-hoa" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Nước Hoa Pháp Haute Parfumerie</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?categorySlug=cham-soc-toc" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                <span>Tinh Dầu Dưỡng Tóc &amp; Phục Hồi</span>
                                <i class="fa-solid fa-angle-right text-[10px] text-[var(--rl-muted)]" aria-hidden="true"></i>
                            </a>
                            <a href="/tim-kiem?fefo=clearance" class="flex items-center justify-between min-h-[44px] px-3 rounded-xl text-xs font-bold text-[var(--rl-emerald)] bg-emerald-50/70 transition">
                                <span>Xả Lô Cận Date Minh Bạch (-50%)</span>
                                <i class="fa-solid fa-shield-heart text-xs" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khối Thương Hiệu Nổi Bật (Mọi pill >= 44px height, gap >= 8px) -->
            <div>
                <div class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-[var(--rl-mauve)] px-1 mb-2.5">
                    Thương Hiệu Đình Đám
                </div>
                <div class="grid grid-cols-2 gap-2.5">
                    <a href="/tim-kiem?brand=Dior" class="min-h-[44px] px-3 rounded-xl bg-white border border-[var(--rl-border-subtle)] hover:border-[var(--rl-rose)] flex items-center justify-center text-xs font-bold text-[var(--rl-ink)]">Dior Beauty</a>
                    <a href="/tim-kiem?brand=Lancome" class="min-h-[44px] px-3 rounded-xl bg-white border border-[var(--rl-border-subtle)] hover:border-[var(--rl-rose)] flex items-center justify-center text-xs font-bold text-[var(--rl-ink)]">Lancôme</a>
