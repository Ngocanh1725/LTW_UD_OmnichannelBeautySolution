@inject Omnichannel.Application.Interfaces.Cms.IThemeService ThemeService
@{
    var theme = await ThemeService.GetCurrentThemeAsync();
}
@* Omnichannel Beauty Suite - Storefront Mobile Menu Off-Canvas Drawer *@
<div x-show="mobileMenuOpen" 
     style="display: none;" 
     class="relative z-50 lg:hidden" 
     aria-labelledby="slide-over-title" 
     role="dialog" 
     aria-modal="true">

    <!-- Backdrop with blur -->
    <div x-show="mobileMenuOpen" 
         x-transition:enter="ease-in-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in-out duration-300"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-charcoal/60 backdrop-blur-sm transition-opacity" 
         @@click="mobileMenuOpen = false"></div>

    <div class="fixed inset-0 overflow-hidden">
        <div class="absolute inset-0 overflow-hidden">
            <div class="pointer-events-none fixed inset-y-0 left-0 flex max-w-full pr-10">
                <div x-show="mobileMenuOpen" 
                     x-transition:enter="transform transition ease-in-out duration-300"
                     x-transition:enter-start="-translate-x-full"
                     x-transition:enter-end="translate-x-0"
                     x-transition:leave="transform transition ease-in-out duration-300"
                     x-transition:leave-start="translate-x-0"
                     x-transition:leave-end="-translate-x-full"
                     class="pointer-events-auto w-screen max-w-xs sm:max-w-sm bg-white shadow-2xl flex flex-col">

                    <!-- Drawer Header -->
                    <div class="p-5 border-b border-soft-border flex items-center justify-between bg-pastel-rose">
                        <a href="/" class="brand-logo-wrapper flex items-center gap-3 leading-none" @@click="mobileMenuOpen = false">
                            <div class="brand-logo-badge relative shrink-0">
                                <img src="@theme.LogoUrl" alt="@theme.BrandName Logo" class="brand-logo-img h-10 w-10 object-cover rounded-full" />
                            </div>
                            <div class="flex flex-col items-start leading-none">
                                <span class="brand-logo-text text-lg font-serif font-bold text-charcoal tracking-[0.16em]">@theme.BrandName</span>
                                <span class="text-[8.5px] font-bold tracking-[0.3em] text-magenta-accent uppercase mt-0.5">@(theme.Slogan ?? "LUXURY COSMETICS")</span>
                            </div>
                        </a>
                        <button type="button" 
                                @@click="mobileMenuOpen = false" 
                                class="h-9 w-9 rounded-full bg-white text-slate-500 hover:text-charcoal hover:bg-slate-100 shadow-sm flex items-center justify-center transition"
                                aria-label="Đóng menu">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                    </div>

                    <!-- Mobile Live Search -->
                    <div class="p-4 border-b border-slate-100 bg-white">
                        <form action="/Product/Search" method="get" class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" name="q" placeholder="Tìm kiếm mỹ phẩm..." class="w-full pl-9 pr-4 py-2.5 rounded-full border border-slate-200 text-xs focus:outline-none focus:border-magenta-accent focus:ring-1 focus:ring-magenta-accent bg-slate-50" />
                        </form>
                    </div>

                    <!-- Navigation Links & Categories -->
                    <div class="flex-1 overflow-y-auto p-4 space-y-6">
                        <!-- Main Links -->
                        <div>
                            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-2">Điều Hướng</div>
                            <nav class="space-y-1 text-sm font-semibold">
                                <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-charcoal hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-house text-rose-gold w-5 text-center"></i>
                                    <span>Trang Chủ</span>
                                </a>
                                <a href="/clearance-fefo" class="flex items-center justify-between px-3 py-2.5 rounded-xl text-charcoal hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-solid fa-fire-flame-curved text-amber-500 w-5 text-center"></i>
                                        <span>Deal Cận Date (FEFO)</span>
                                    </div>
                                    <span class="px-2 py-0.5 rounded-full bg-red-100 text-red-600 font-bold text-[10px]">-50%</span>
                                </a>
                                <a href="/orders/tracking" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-charcoal hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-truck-fast text-rose-gold w-5 text-center"></i>
                                    <span>Tra Cứu Đơn Hàng</span>
                                </a>
                                <a href="/Blog" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-charcoal hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-newspaper text-rose-gold w-5 text-center"></i>
                                    <span>Góc Làm Đẹp (Blog)</span>
                                </a>
                                <a href="/stores" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-charcoal hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-store text-rose-gold w-5 text-center"></i>
                                    <span>Hệ Thống Showroom</span>
                                </a>
                            </nav>
                        </div>

                        <!-- 8 Beauty Categories Accordion / List -->
                        <div x-data="{ catExpanded: true }">
                            <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-2 cursor-pointer" @@click="catExpanded = !catExpanded">
                                <span>Danh Mục Mỹ Phẩm</span>
                                <i class="fa-solid fa-chevron-down transition-transform" :class="catExpanded ? 'rotate-180' : ''"></i>
                            </div>
                            <nav x-show="catExpanded" x-collapse class="space-y-1 text-xs">
                                <a href="/category/cham-soc-da" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-droplet text-pink-400 w-4"></i> Chăm Sóc Da (Skincare)
                                </a>
                                <a href="/category/trang-diem" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-wand-magic-sparkles text-rose-400 w-4"></i> Trang Điểm (Makeup)
                                </a>
                                <a href="/category/kem-chong-nang" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-sun text-amber-400 w-4"></i> Kem Chống Nắng (Suncare)
                                </a>
                                <a href="/category/cham-soc-toc" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-scissors text-purple-400 w-4"></i> Chăm Sóc Tóc (Haircare)
                                </a>
                                <a href="/category/cham-soc-co-the" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-shower text-blue-400 w-4"></i> Chăm Sóc Cơ Thể (Body Care)
                                </a>
                                <a href="/category/nuoc-hoa" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-spray-can-sparkles text-rose-500 w-4"></i> Nước Hoa (Fragrance)
                                </a>
                                <a href="/category/dung-cu-lam-dep" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-brush text-indigo-400 w-4"></i> Dụng Cụ Làm Đẹp (Tools)
                                </a>
                                <a href="/category/set-qua-tang" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-gift text-red-400 w-4"></i> Set Quà Tặng & Combo
                                </a>
                            </nav>
                        </div>

                        <!-- Customer Account & Admin -->
                        <div class="pt-4 border-t border-slate-100">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2 px-2">Tài Khoản</div>
                            <div class="space-y-1 text-xs">
                                <a href="/Account/Login" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-arrow-right-to-bracket text-slate-400 w-4"></i> Đăng Nhập
                                </a>
                                <a href="/Account/Register" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-magenta-accent font-bold hover:bg-pastel-rose transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-gift text-warning w-4"></i> Đăng Ký (+50 Điểm)
                                </a>
                                <a href="/Customer/Dashboard" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-amber-800 font-bold hover:bg-amber-50 transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-crown text-amber-500 w-4"></i> Thẻ VIP & Điểm Thưởng
                                </a>
                                <a href="/Admin/Dashboard" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-magenta-accent font-bold hover:bg-pastel-rose transition" @@click="mobileMenuOpen = false">
                                    <i class="fa-solid fa-shield-halved text-magenta-accent w-4"></i> Quản Trị Hệ Thống
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Drawer Footer Hotline -->
                    <div class="p-4 border-t border-slate-100 bg-slate-50">
                        <a href="tel:19008899" class="w-full py-3 rounded-xl bg-charcoal text-white font-bold text-xs flex items-center justify-center gap-2 hover:bg-magenta-accent transition shadow-md">
                            <i class="fa-solid fa-phone text-rose-gold"></i> Hotline: 1900 8899
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
