@*
    Canmake Beauty Suite - Rosé Luxe Shared Header (_Header.cshtml)
    Phiên 2:
    - DESKTOP (>= 1024px):
      + Top bar mảnh (--rl-ink / --rl-rose-deep) chạy marquee thông điệp ưu đãi, tạm dừng khi hover/focus-within.
      + Header dạng "Floating Pill" bo tròn (cảm hứng Bloom Room): Logo trái | Menu giữa (_MegaNav) | Cụm icon phải
        (Tìm kiếm, Yêu thích, Thông báo, Tài khoản, Giỏ hàng có badge số).
      + Khi cuộn xuống: thu gọn nhẹ bằng transform (CLS = 0), nền glass, bóng hồng nhẹ; cuộn xuống nhanh tự ẩn, cuộn lên hiện lại.
      + Ô tìm kiếm mở rộng thành Fullscreen Search Overlay: gợi ý từ khoá hot, danh mục, sản phẩm xem gần đây.
    - MOBILE (< 768px):
      + Header gọn: Hamburger (trái, >=44x44px) | Logo (giữa) | Giỏ hàng (phải, >=44x44px).
      + Thanh tìm kiếm dạng pill ngay dưới header (sticky).
*@
@inject Omnichannel.Application.Interfaces.Sales.ICartService CartService
@{
    string? headerCartId = Context.Request.Cookies["CanmakeBeauty_CartId"];
    string? headerUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    int initialCartCount = 0;
    decimal initialCartSubTotal = 0m;
    if (!string.IsNullOrEmpty(headerCartId) || !string.IsNullOrEmpty(headerUserId))
    {
        try
        {
            var currentCart = await CartService.GetCartAsync(headerCartId ?? string.Empty, headerUserId);
            if (currentCart != null)
            {
                initialCartCount = currentCart.TotalItems;
                initialCartSubTotal = currentCart.SubTotal;
            }
        }
        catch { }
    }
    string initialCartTotalFormatted = initialCartSubTotal > 0
        ? string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:N0} ₫", initialCartSubTotal)
        : "0 ₫";
}

<!-- 1. TOP BAR MẢNH (INK / ROSE DEEP) CHẠY MARQUEE ƯU ĐÃI, TẠM DỪNG KHI HOVER -->
<aside aria-label="Thông báo ưu đãi và cam kết dịch vụ"
       class="bg-[var(--rl-ink)] text-[var(--rl-bg)] text-[11px] font-medium py-2 px-4 border-b border-white/10 relative z-[var(--rl-z-sticky)] overflow-hidden">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between gap-6">
        <div class="rl-marquee-container flex-1 overflow-hidden">
            <div class="rl-topbar-marquee flex items-center gap-10 whitespace-nowrap">
                <span class="inline-flex items-center gap-2 tracking-wide">
                    <i class="fa-solid fa-shield-heart text-[var(--rl-champagne)]" aria-hidden="true"></i>
                    <span><strong class="text-[var(--rl-bg-petal)]">CAM KẾT DATE MỚI:</strong> 100% mỹ phẩm chính hãng hạn dùng &gt; 18 tháng minh bạch</span>
                </span>
                <span class="text-white/25" aria-hidden="true">✦</span>
                <span class="inline-flex items-center gap-2 tracking-wide">
                    <i class="fa-solid fa-bolt text-[var(--rl-champagne)]" aria-hidden="true"></i>
                    <span><strong class="text-[var(--rl-bg-petal)]">GIAO NHANH 2H:</strong> Nhận hàng siêu tốc nội thành Hà Nội &amp; TP.HCM — Freeship đơn từ 499K</span>
                </span>
                <span class="text-white/25" aria-hidden="true">✦</span>
                <span class="inline-flex items-center gap-2 tracking-wide">
                    <i class="fa-solid fa-gift text-[var(--rl-champagne)]" aria-hidden="true"></i>
                    <span><strong class="text-[var(--rl-bg-petal)]">ROSÉ LUXE PRIVILEGE:</strong> Nhập mã <strong class="underline decoration-[var(--rl-champagne)]">ROSELUXE50</strong> giảm ngay 50.000₫ cho đơn đầu tiên</span>
                </span>
                <span class="text-white/25" aria-hidden="true">✦</span>
                <!-- Nhân bản nội dung để chạy marquee vô tận mượt mà -->
                <span class="inline-flex items-center gap-2 tracking-wide" aria-hidden="true">
                    <i class="fa-solid fa-shield-heart text-[var(--rl-champagne)]"></i>
                    <span><strong class="text-[var(--rl-bg-petal)]">CAM KẾT DATE MỚI:</strong> 100% mỹ phẩm chính hãng hạn dùng &gt; 18 tháng minh bạch</span>
                </span>
                <span class="text-white/25" aria-hidden="true">✦</span>
                <span class="inline-flex items-center gap-2 tracking-wide" aria-hidden="true">
                    <i class="fa-solid fa-bolt text-[var(--rl-champagne)]"></i>
                    <span><strong class="text-[var(--rl-bg-petal)]">GIAO NHANH 2H:</strong> Nhận hàng siêu tốc nội thành Hà Nội &amp; TP.HCM — Freeship đơn từ 499K</span>
                </span>
            </div>
        </div>

        <div class="hidden lg:flex items-center gap-4 text-[11px] shrink-0 pl-4 border-l border-white/15">
            <a href="/tu-van-da" class="text-[var(--rl-bg-petal)] hover:text-white transition inline-flex items-center gap-1.5 font-semibold">
                <i class="fa-solid fa-wand-magic-sparkles text-[10px] text-[var(--rl-champagne)]" aria-hidden="true"></i>
                <span>Trắc Nghiệm Da</span>
            </a>
            <span class="text-white/20" aria-hidden="true">|</span>
            <a href="tel:1900888999" class="text-white/80 hover:text-white transition inline-flex items-center gap-1.5">
                <i class="fa-solid fa-phone-volume text-[10px] text-[var(--rl-champagne)]" aria-hidden="true"></i>
                <span>VIP: <strong class="text-white font-mono-numeric">1900 888 999</strong></span>
            </a>
        </div>
    </div>
</aside>

<!-- 2. STICKY HEADER WRAPPER (CỐ ĐỊNH CHIỀU CAO FLOW ĐỂ ĐẢM BẢO CLS = 0 KHI CUỘN) -->
<header id="siteMainHeader"
        x-data="instantSearch()"
        x-init="initSearch()"
        @@keydown.window.slash="if (!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)) { $event.preventDefault(); openSearchOverlay(); }"
        @@keydown.window.ctrl.k.prevent="openSearchOverlay()"
        style="overflow-anchor: none;"
        class="sticky top-0 z-50 h-[112px] md:h-[84px] select-none pointer-events-none">

    <!-- Khối chuyển động bằng GPU Transform (Không làm thay đổi chiều cao DOM flow -> CLS = 0) -->
    <div class="w-full h-full flex flex-col justify-center transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] pointer-events-auto"
         :class="headerHidden && !searchOverlayOpen ? '-translate-y-[115%]' : 'translate-y-0'">

        <div class="max-w-[1440px] w-full mx-auto px-3 sm:px-6 lg:px-8">

            <!-- =========================================================================
                 A. DESKTOP & TABLET FLOATING PILL HEADER (>= 768px)
                 Lấy cảm hứng từ Bloom Room: Khung viên thuốc nổi bo tròn, thu gọn khi cuộn
                 ========================================================================= -->
            <div class="hidden md:flex items-center justify-between gap-3 lg:gap-4 rounded-full transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
                 :class="isScrolled
                    ? 'glass-surface bg-[var(--rl-surface)]/90 backdrop-blur-xl shadow-[var(--rl-shadow-md)] border border-[var(--rl-border-strong)] px-5 py-2 scale-[0.985]'
                    : 'bg-[var(--rl-surface)]/95 backdrop-blur-md shadow-[var(--rl-shadow-sm)] border border-[var(--rl-border-subtle)] px-6 py-2.5'">

                <!-- Trái: Logo Thương Hiệu -->
                <div class="flex items-center gap-2 shrink-0">
                    <!-- Nút Hamburger chỉ hiện ở Tablet (768px - 1023px) khi chưa có MegaNav -->
                    <button type="button"
                            @@click="mobileMenuOpen = true"
                            aria-label="Mở danh mục điều hướng"
                            :aria-expanded="mobileMenuOpen ? 'true' : 'false'"
                            aria-controls="mobileNavigationDrawer"
                            class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-[var(--rl-bg-blush)] transition">
                        <i class="fa-solid fa-bars-staggered text-base" aria-hidden="true"></i>
                    </button>

                    <a href="/"
                       aria-label="@Brand.Name - Trang chủ"
                       class="flex items-center gap-2 group focus-visible:outline-2 focus-visible:outline-[var(--rl-rose)] rounded-full py-1 pr-2">
                        <img src="@Brand.LogoUrl"
                             alt="@Brand.Name Logo"
                             class="h-9 xl:h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.03]"
                             onerror="this.onerror=null; this.src='/images/branding/canmake-logo-horizontal.svg';" />
                        <span class="sr-only">@Brand.Name</span>
                    </a>
                </div>

                <!-- Giữa: Menu Điều Hướng Trung Tâm + Mega Menu (_MegaNav.cshtml) -->
                <partial name="_MegaNav" />

                <!-- Phải: Cụm Icon Tiện Ích (Tìm kiếm, Yêu thích, Thông báo, Tài khoản, Giỏ hàng) -->
                <div class="flex items-center gap-2 shrink-0">

                    <!-- 1. Nút mở Fullscreen Search Overlay (Dạng Pill thanh lịch) -->
                    <button type="button"
                            id="btnOpenDesktopSearchOverlay"
                            @@click="openSearchOverlay()"
                            aria-label="Mở khung tìm kiếm toàn màn hình"
                            aria-haspopup="dialog"
                            :aria-expanded="searchOverlayOpen.toString()"
                            aria-controls="fullscreenSearchOverlay"
                            class="inline-flex items-center gap-2.5 min-h-[44px] px-3.5 xl:px-4 py-2 rounded-full bg-[var(--rl-bg-blush)]/75 hover:bg-[var(--rl-bg-petal)]/80 text-[var(--rl-mauve)] hover:text-[var(--rl-ink)] border border-[var(--rl-border-strong)]/60 transition group">
                        <i class="fa-solid fa-magnifying-glass text-xs text-[var(--rl-rose)] group-hover:scale-110 transition-transform" aria-hidden="true"></i>
                        <span class="text-xs font-medium hidden xl:inline max-w-[140px] truncate"
                              x-text="query ? query : 'Tìm kiếm mỹ phẩm...'">Tìm kiếm mỹ phẩm...</span>
                        <kbd class="hidden 2xl:inline-flex items-center px-1.5 py-0.5 text-[9px] font-bold text-[var(--rl-muted)] bg-white/80 rounded border border-[var(--rl-border-subtle)]">
                            /
                        </kbd>
                    </button>

                    <!-- 2. Yêu thích (Wishlist) -->
                    <a href="/wishlist"
                       aria-label="Danh sách sản phẩm yêu thích"
                       class="relative inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-[var(--rl-bg-blush)] transition">
                        <i class="fa-regular fa-heart text-base" aria-hidden="true"></i>
                        <span id="wishlistCountBadge"
                              data-wishlist-count
                              class="absolute top-1 right-1 bg-[var(--rl-rose)] text-white text-[10px] font-bold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center shadow-2xs font-mono-numeric">0</span>
                    </a>

                    <!-- 3. Trung Tâm Thông Báo (Notification Bell) -->
                    <div class="relative"
                         x-data="storefrontNotificationCenter()"
                         x-init="initNotifications()"
                         @@click.away="notifOpen = false"
                         @@keydown.escape.window="notifOpen = false">
                        <button type="button"
                                @@click="toggleDropdown()"
                                aria-label="Thông báo của bạn"
                                :aria-expanded="notifOpen.toString()"
                                class="relative inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-[var(--rl-bg-blush)] transition">
                            <i class="fa-regular fa-bell text-base" :class="unreadCount > 0 ? 'animate-swing text-[var(--rl-rose)]' : ''" aria-hidden="true"></i>
                            <span x-cloak
                                  x-show="unreadCount > 0"
                                  x-text="unreadCount > 99 ? '99+' : unreadCount"
                                  class="absolute top-1 right-1 bg-[var(--rl-rose)] text-white text-[10px] font-bold min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center shadow-2xs font-mono-numeric"></span>
                        </button>

                        <!-- Dropdown Thông báo -->
                        <div x-cloak
                             x-show="notifOpen"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                             x-transition:leave-end="opacity-0 translate-y-2 scale-95"
                             class="absolute right-0 mt-3 w-80 sm:w-96 rounded-[24px] bg-[var(--rl-surface)] shadow-[var(--rl-shadow-xl)] border border-[var(--rl-border-strong)] overflow-hidden z-[var(--rl-z-popover)]">
                            <div class="px-4 py-3 bg-[var(--rl-bg-blush)] border-b border-[var(--rl-border-subtle)] flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-bell text-[var(--rl-rose)] text-xs" aria-hidden="true"></i>
                                    <span class="text-xs font-bold text-[var(--rl-ink)] uppercase tracking-wider">Thông Báo Của Bạn</span>
                                    <span x-show="unreadCount > 0"
                                          x-text="unreadCount + ' mới'"
                                          class="px-2 py-0.5 text-[10px] font-bold bg-[var(--rl-rose)] text-white rounded-full"></span>
                                </div>
                                <button type="button"
                                        x-show="unreadCount > 0"
                                        @@click="markAllAsRead()"
                                        class="text-[11px] font-semibold text-[var(--rl-rose)] hover:underline">
                                    Đánh dấu đã đọc
                                </button>
                            </div>

                            <div class="max-h-80 overflow-y-auto divide-y divide-[var(--rl-border-subtle)]">
                                <template x-if="loading">
                                    <div class="p-6 text-center text-xs text-[var(--rl-muted)]">
                                        <i class="fa-solid fa-circle-notch fa-spin text-[var(--rl-rose)] text-base mb-1.5" aria-hidden="true"></i>
                                        <p>Đang tải thông báo...</p>
                                    </div>
                                </template>

                                <template x-if="!loading && items.length === 0">
                                    <div class="p-8 text-center">
                                        <div class="w-11 h-11 rounded-full bg-[var(--rl-bg-blush)] text-[var(--rl-rose)] mx-auto flex items-center justify-center mb-2">
                                            <i class="fa-regular fa-bell-slash text-base" aria-hidden="true"></i>
                                        </div>
                                        <p class="text-xs font-semibold text-[var(--rl-ink)]">Chưa có thông báo mới</p>
                                        <p class="text-[11px] text-[var(--rl-muted)] mt-0.5">Ưu đãi độc quyền &amp; trạng thái đơn hàng sẽ hiển thị tại đây.</p>
                                    </div>
                                </template>

                                <template x-for="item in items" :key="item.id">
                                    <div @@click="openNotificationItem(item)"
                                         class="px-4 py-3 hover:bg-[var(--rl-bg-blush)]/60 transition cursor-pointer flex items-start gap-3"
                                         :class="!item.isRead ? 'bg-[var(--rl-bg-blush)]/35' : ''">
                                        <div class="w-8 h-8 rounded-full bg-[var(--rl-bg-petal)] text-[var(--rl-rose)] flex items-center justify-center shrink-0 mt-0.5">
                                            <i class="text-xs" :class="getIconClass(item.type)" aria-hidden="true"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-xs font-bold text-[var(--rl-ink)] line-clamp-1" x-text="item.title"></p>
                                            <p class="text-[11px] text-[var(--rl-mauve)] line-clamp-2 mt-0.5" x-text="item.message"></p>
                                            <span class="text-[10px] text-[var(--rl-muted)] mt-1 block" x-text="item.timeAgo"></span>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Tài Khoản (Account Dropdown / Login) -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="relative" x-data="{ userMenuOpen: false }" @@click.away="userMenuOpen = false" @@keydown.escape.window="userMenuOpen = false">
                            <button type="button"
                                    @@click="userMenuOpen = !userMenuOpen"
                                    aria-label="Tài khoản cá nhân"
                                    :aria-expanded="userMenuOpen.toString()"
                                    class="inline-flex items-center gap-2 min-h-[44px] min-w-[44px] px-2.5 py-1.5 rounded-full hover:bg-[var(--rl-bg-blush)] border border-transparent hover:border-[var(--rl-border-strong)] transition">
                                <span class="w-8 h-8 rounded-full bg-[var(--rl-rose)] text-white flex items-center justify-center text-xs font-bold shadow-2xs">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </span>
                                <i class="fa-solid fa-chevron-down text-[10px] text-[var(--rl-muted)] hidden xl:inline" aria-hidden="true"></i>
                            </button>

                            <div x-cloak
                                 x-show="userMenuOpen"
                                 x-transition
                                 class="absolute right-0 mt-3 w-64 rounded-[24px] bg-[var(--rl-surface)] shadow-[var(--rl-shadow-xl)] border border-[var(--rl-border-strong)] py-2.5 z-[var(--rl-z-popover)]">
                                <div class="px-4 py-2.5 border-b border-[var(--rl-border-subtle)]">
                                    <p class="text-xs font-bold text-[var(--rl-ink)] truncate">@User.Identity.Name</p>
                                    <p class="text-[10px] font-bold text-[var(--rl-rose)] uppercase tracking-wider mt-0.5">✦ Hội Viên Rosé VIP</p>
                                </div>

                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("Pharmacist") || User.IsInRole("Staff"))
                                {
                                    <div class="p-2 border-b border-[var(--rl-border-subtle)] bg-[var(--rl-bg-blush)]/40">
                                        <a href="/Admin/Dashboard" class="flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-white bg-[var(--rl-rose)] rounded-xl hover:bg-[var(--rl-rose-deep)] transition">
                                            <i class="fa-solid fa-gauge-high w-4 text-center" aria-hidden="true"></i>
                                            <span>Vào Trang Quản Trị</span>
                                        </a>
                                    </div>
                                }

                                <a href="/Customer/Dashboard" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                    <i class="fa-solid fa-id-card-clip w-4 text-center text-[var(--rl-rose)]" aria-hidden="true"></i>
                                    <span>Hồ Sơ &amp; Sổ Địa Chỉ</span>
                                </a>
                                <a href="/Order/History" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-medium text-[var(--rl-ink)] hover:bg-[var(--rl-bg-blush)] hover:text-[var(--rl-rose)] transition">
                                    <i class="fa-solid fa-box-open w-4 text-center text-[var(--rl-rose)]" aria-hidden="true"></i>
                                    <span>Lịch Sử Đơn Hàng</span>
                                </a>
                                <div class="border-t border-[var(--rl-border-subtle)] mt-1 pt-1">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full text-left flex items-center gap-2.5 px-4 py-2.5 text-xs text-[var(--rl-error)] hover:bg-rose-50 transition font-semibold">
                                            <i class="fa-solid fa-right-from-bracket w-4 text-center" aria-hidden="true"></i>
                                            <span>Đăng Xuất</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login"
                           aria-label="Đăng nhập tài khoản"
                           class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--rl-ink)] hover:text-[var(--rl-rose)] hover:bg-[var(--rl-bg-blush)] transition">
                            <i class="fa-regular fa-user text-base" aria-hidden="true"></i>
                        </a>
                    }

                    <!-- 5. Giỏ Hàng Có Badge Số & Tổng Tiền (#btnOpenMiniCart) -->
                    <button type="button"
                            id="btnOpenMiniCart"
                            data-action="open-mini-cart"
                            aria-label="Mở giỏ hàng"
                            class="inline-flex items-center gap-2.5 min-h-[44px] pl-3.5 pr-2 py-1.5 rounded-full bg-[var(--rl-ink)] hover:bg-[var(--rl-rose)] text-white transition-colors duration-200 shadow-[var(--rl-shadow-xs)] group">
                        <i class="fa-solid fa-bag-shopping text-sm text-[var(--rl-bg-petal)] group-hover:text-white transition-colors" aria-hidden="true"></i>
                        <span id="miniCartHeaderTotal"
                              data-cart-total
                              class="hidden 2xl:inline text-xs font-bold font-mono-numeric tracking-tight">@initialCartTotalFormatted</span>
                        <span id="miniCartCountBadge"
                              data-cart-count
                              class="min-w-[26px] h-[26px] px-1.5 rounded-full bg-[var(--rl-rose)] group-hover:bg-white group-hover:text-[var(--rl-rose)] text-white text-xs font-extrabold font-mono-numeric flex items-center justify-center transition-colors">
                            @initialCartCount
                        </span>
                    </button>
                </div>
            </div>

            <!-- =========================================================================
                 B. MOBILE HEADER (< 768px):
                 - Hàng 1: Hamburger (trái, >=44x44px) | Logo (giữa) | Giỏ hàng (phải, >=44x44px)
                 - Hàng 2: Thanh tìm kiếm dạng pill ngay dưới header (sticky)
                 ========================================================================= -->
            <div class="md:hidden flex flex-col gap-1.5 py-1.5 px-2.5 rounded-[24px] bg-[var(--rl-surface)]/95 backdrop-blur-xl border border-[var(--rl-border-strong)]/80 shadow-[var(--rl-shadow-sm)]">
                <!-- Hàng 1: Hamburger | Logo Giữa | Giỏ Hàng -->
                <div class="grid grid-cols-3 items-center h-[46px]">
                    <!-- Trái: Hamburger (>= 44x44px) -->
                    <div class="flex items-center justify-start">
                        <button type="button"
                                id="btnOpenMobileDrawer"
                                @@click="mobileMenuOpen = true"
                                aria-label="Mở menu danh mục"
                                :aria-expanded="mobileMenuOpen ? 'true' : 'false'"
                                aria-controls="mobileNavigationDrawer"
                                class="inline-flex items-center justify-center w-11 h-11 rounded-full text-[var(--rl-ink)] hover:text-[var(--rl-rose)] active:bg-[var(--rl-bg-blush)] transition">
                            <i class="fa-solid fa-bars-staggered text-lg" aria-hidden="true"></i>
                        </button>
                    </div>

                    <!-- Giữa: Logo Thương Hiệu Căn Giữa Tuyệt Đối -->
                    <div class="flex items-center justify-center">
                        <a href="/"
                           aria-label="@Brand.Name - Trang chủ"
                           class="inline-flex items-center justify-center min-h-[44px] px-2 group">
                            <img src="@Brand.LogoUrl"
                                 alt="@Brand.Name Logo"
                                 class="h-7 w-auto max-w-[125px] object-contain"
                                 onerror="this.onerror=null; this.src='/images/branding/canmake-logo-horizontal.svg';" />
                            <span class="sr-only">@Brand.Name</span>
                        </a>
                    </div>

                    <!-- Phải: Giỏ hàng có badge số (>= 44x44px) -->
                    <div class="flex items-center justify-end">
                        <button type="button"
                                data-action="open-mini-cart"
                                aria-label="Mở giỏ hàng"
                                class="relative inline-flex items-center justify-center w-11 h-11 rounded-full bg-[var(--rl-bg-blush)] text-[var(--rl-ink)] active:bg-[var(--rl-bg-petal)] transition">
                            <i class="fa-solid fa-bag-shopping text-base text-[var(--rl-rose)]" aria-hidden="true"></i>
                            <span data-cart-count
                                  class="cart-badge-count absolute top-0.5 right-0.5 min-w-[19px] h-[19px] px-1 rounded-full bg-[var(--rl-rose)] text-white text-[10px] font-extrabold font-mono-numeric flex items-center justify-center shadow-2xs">
                                @initialCartCount
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Hàng 2: Thanh tìm kiếm dạng Pill ngay dưới header (Sticky) -->
                <button type="button"
                        id="btnMobileStickySearchPill"
                        @@click="openSearchOverlay()"
                        aria-label="Mở tìm kiếm sản phẩm"
                        aria-haspopup="dialog"
                        :aria-expanded="searchOverlayOpen.toString()"
                        aria-controls="fullscreenSearchOverlay"
                        class="w-full min-h-[44px] px-4 py-2 rounded-full bg-[var(--rl-bg-blush)]/85 hover:bg-[var(--rl-bg-petal)]/70 border border-[var(--rl-border-strong)] flex items-center justify-between gap-2.5 text-left transition">
                    <span class="flex items-center gap-2.5 min-w-0">
                        <i class="fa-solid fa-magnifying-glass text-xs text-[var(--rl-rose)] shrink-0" aria-hidden="true"></i>
                        <span class="text-xs text-[var(--rl-mauve)] truncate"
                              x-text="query ? query : 'Tìm serum B5, son lì Rosé, chống nắng...'">
                            Tìm serum B5, son lì Rosé, chống nắng...
                        </span>
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/90 text-[9px] font-bold text-[var(--rl-rose)] uppercase tracking-wider shrink-0 border border-[var(--rl-border-subtle)]">
                        <i class="fa-solid fa-wand-magic-sparkles text-[9px]" aria-hidden="true"></i>
                        <span>Date Mới</span>
                    </span>
                </button>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         3. FULLSCREEN SEARCH OVERLAY (DÙNG CHUNG CHO CẢ DESKTOP & MOBILE)
         Hiển thị:
         1. Từ khoá xu hướng (Hot Keywords) & Tìm kiếm gần đây
         2. Danh mục nổi bật (Categories) có thumbnail tròn
         3. Sản phẩm xem gần đây (Recently Viewed Products) + Gợi ý trực tiếp khi gõ
         ========================================================================= -->
    <div id="fullscreenSearchOverlay"
         x-cloak
         x-show="searchOverlayOpen"
         x-transition:enter="transition ease-[cubic-bezier(0.22,1,0.36,1)] duration-300"
         x-transition:enter-start="opacity-0 -translate-y-3"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-2"
         @@keydown.escape.window="if (searchOverlayOpen) closeSearchOverlay()"
         role="dialog"
         aria-modal="true"
         aria-label="Tìm kiếm mỹ phẩm Canmake Beauty"
         class="fixed inset-0 z-[1080] h-[100svh] bg-[#FFFDFB]/98 backdrop-blur-2xl flex flex-col pointer-events-auto overflow-hidden">

        <!-- Đầu Overlay: Thanh Input Tìm Kiếm Cỡ Lớn + Nút Đóng (>= 44x44px) -->
        <div class="border-b border-[var(--rl-border-subtle)] bg-[var(--rl-surface)]/90 px-4 sm:px-8 py-4 sm:py-5 shrink-0">
            <div class="max-w-5xl mx-auto flex items-center gap-3 sm:gap-4">
                <form action="/tim-kiem"
                      method="get"
                      role="search"
                      x-on:submit="handleSubmit($event)"
                      class="flex-1 relative flex items-center">
                    <label for="storefrontSearchInput" class="sr-only">Tìm kiếm sản phẩm, thương hiệu, hoạt chất</label>
                    <i class="fa-solid fa-magnifying-glass text-base text-[var(--rl-rose)] absolute left-5 pointer-events-none" aria-hidden="true"></i>
                    <input type="search"
                           id="storefrontSearchInput"
                           x-ref="searchInput"
                           name="q"
                           x-model="query"
                           @@input="onInput()"
                           @@keydown.arrow-down.prevent="selectNext()"
                           @@keydown.arrow-up.prevent="selectPrev()"
                           @@keydown.enter="handleEnter($event)"
                           autocomplete="off"
                           autocorrect="off"
                           autocapitalize="off"
                           spellcheck="false"
                           enterkeyhint="search"
                           placeholder="Tìm sản phẩm, thương hiệu (Dior, La Roche-Posay) hoặc hoạt chất (B5, Retinol)..."
                           class="w-full min-h-[52px] pl-12 pr-28 py-3 rounded-full bg-[var(--rl-bg-blush)]/65 focus:bg-white border-2 border-[var(--rl-border-strong)] focus:border-[var(--rl-rose)] text-base text-[var(--rl-ink)] placeholder:text-[var(--rl-muted)] focus:outline-none shadow-[var(--rl-shadow-xs)] transition" />

                    <!-- Nút Xoá nhanh chữ đang gõ -->
                    <button type="button"
                            id="btnClearSearch"
                            x-cloak
                            x-show="query.length > 0"
                            @@click="clearQuery()"
                            aria-label="Xóa từ khóa tìm kiếm"
                            class="absolute right-14 w-9 h-9 rounded-full text-[var(--rl-muted)] hover:text-[var(--rl-rose)] hover:bg-[var(--rl-bg-blush)] flex items-center justify-center transition">
                        <i class="fa-solid fa-circle-xmark text-sm" aria-hidden="true"></i>
                    </button>

                    <!-- Nút Submit Tìm kiếm -->
                    <button type="submit"
                            aria-label="Thực hiện tìm kiếm"
                            class="absolute right-2 w-10 h-10 rounded-full bg-[var(--rl-rose)] hover:bg-[var(--rl-rose-deep)] text-white flex items-center justify-center shadow-2xs transition">
                        <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                    </button>
                </form>

                <!-- Nút Đóng Overlay (>= 44x44px) -->
                <button type="button"
                        id="btnCloseSearchOverlay"
                        @@click="closeSearchOverlay()"
                        aria-label="Đóng khung tìm kiếm"
                        class="inline-flex items-center justify-center gap-2 min-w-[44px] min-h-[44px] px-4 rounded-full bg-[var(--rl-bg-blush)] hover:bg-[var(--rl-bg-petal)] text-[var(--rl-ink)] hover:text-[var(--rl-rose)] text-xs font-bold transition shrink-0">
                    <span class="hidden sm:inline">Đóng</span>
                    <i class="fa-solid fa-xmark text-base" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <!-- Thân Overlay: Gợi Ý Mặc Định (< 2 ký tự) HOẶC Kết Quả Tức Thì (>= 2 ký tự) -->
        <div id="liveSearchResultsPopover"
             class="flex-1 overflow-y-auto px-4 sm:px-8 py-6 sm:py-8">
            <div class="max-w-5xl mx-auto">

                <!-- TRẠNG THÁI 1: CHƯA GÕ TỪ KHOÁ (< 2 ký tự) -> HIỂN THỊ TỪ KHOÁ HOT, DANH MỤC, SẢN PHẨM XEM GẦN ĐÂY -->
                <div x-show="query.trim().length < 2" class="space-y-8">

                    <!-- Lịch sử tìm kiếm gần đây (nếu có) -->
                    <div x-cloak x-show="recentSearches.length > 0">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--rl-muted)] flex items-center gap-2">
                                <i class="fa-solid fa-clock-rotate-left text-[var(--rl-rose)]" aria-hidden="true"></i>
                                <span>Tìm Kiếm Gần Đây</span>
                            </span>
                            <button type="button"
                                    @@click="clearRecentSearches()"
                                    class="text-xs font-semibold text-[var(--rl-rose)] hover:underline">
                                Xóa lịch sử
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <template x-for="term in recentSearches" :key="term">
                                <div class="inline-flex items-center rounded-full bg-white border border-[var(--rl-border-strong)] hover:border-[var(--rl-rose)] transition overflow-hidden">
                                    <button type="button"
                                            @@click="selectTerm(term)"
                                            class="min-h-[38px] pl-3.5 pr-2 py-1.5 text-xs font-medium text-[var(--rl-ink)] hover:text-[var(--rl-rose)]">
                                        <span x-text="term"></span>
                                    </button>
                                    <button type="button"
                                            @@click.stop="removeRecentSearch(term)"
                                            aria-label="Xóa từ khóa này"
                                            class="min-h-[38px] px-2.5 text-[var(--rl-muted)] hover:text-[var(--rl-error)]">
                                        <i class="fa-solid fa-xmark text-[10px]" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </template>
                        </div>
                    </div>

                    <!-- Khối 1: Từ Khoá Xu Hướng (Hot Keywords) -->
                    <div>
                        <div class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--rl-rose)] mb-3 flex items-center gap-2">
                            <i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i>
                            <span>Từ Khoá Xu Hướng Hôm Nay</span>
                        </div>
                        <div class="flex flex-wrap gap-2.5">
                            <template x-for="(kw, idx) in (suggestions.hotKeywords && suggestions.hotKeywords.length ? suggestions.hotKeywords : defaultHotKeywords)" :key="kw">
                                <button type="button"
                                        @@click="selectTerm(kw)"
                                        class="chip min-h-[44px] !px-4 !py-2 text-xs font-semibold">
                                    <span class="text-[10px] font-extrabold text-[var(--rl-rose)] font-mono-numeric" x-text="'#' + (idx + 1)"></span>
                                    <span x-text="kw"></span>
                                </button>
                            </template>
                        </div>
                    </div>

                    <!-- Khối 2: Danh Mục Nổi Bật (Categories) -->
                    <div>
                        <div class="flex items-center justify-between mb-3.5">
                            <span class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--rl-mauve)] flex items-center gap-2">
                                <i class="fa-solid fa-layer-group text-[var(--rl-champagne)]" aria-hidden="true"></i>
                                <span>Danh Mục Nổi Bật</span>
                            </span>
                            <a href="/tim-kiem" class="text-xs font-bold text-[var(--rl-rose)] hover:underline">Xem tất cả</a>
                        </div>
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
                            <a href="/tim-kiem?categorySlug=cham-soc-da"
                               class="flex items-center gap-3 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)] border border-[var(--rl-border-subtle)] hover:border-[var(--rl-border-strong)] shadow-[var(--rl-shadow-xs)] transition group">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-SKIN-LRP-002")"
                                     alt=""
                                     aria-hidden="true"
                                     width="44"
                                     height="44"
                                     loading="lazy"
                                     class="w-11 h-11 rounded-full object-cover border border-[var(--rl-border-strong)] shrink-0" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] truncate">Chăm Sóc Da</div>
                                    <div class="text-[10px] text-[var(--rl-muted)]">Serum B5, Rửa mặt</div>
                                </div>
                            </a>

                            <a href="/tim-kiem?categorySlug=trang-diem"
                               class="flex items-center gap-3 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)] border border-[var(--rl-border-subtle)] hover:border-[var(--rl-border-strong)] shadow-[var(--rl-shadow-xs)] transition group">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-LIP-DIO-037")"
                                     alt=""
                                     aria-hidden="true"
                                     width="44"
                                     height="44"
                                     loading="lazy"
                                     class="w-11 h-11 rounded-full object-cover border border-[var(--rl-border-strong)] shrink-0" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] truncate">Trang Điểm</div>
                                    <div class="text-[10px] text-[var(--rl-muted)]">Son Rosé, Cushion</div>
                                </div>
                            </a>

                            <a href="/tim-kiem?categorySlug=kem-chong-nang"
                               class="flex items-center gap-3 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)] border border-[var(--rl-border-subtle)] hover:border-[var(--rl-border-strong)] shadow-[var(--rl-shadow-xs)] transition group">
                                <img src="@ProductImageResolver.GetPrimaryImageUrl(sku: "SKU-SKIN-ANE-001")"
                                     alt=""
                                     aria-hidden="true"
                                     width="44"
                                     height="44"
                                     loading="lazy"
                                     class="w-11 h-11 rounded-full object-cover border border-[var(--rl-border-strong)] shrink-0" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] truncate">Chống Nắng UV</div>
                                    <div class="text-[10px] text-[var(--rl-muted)]">SPF50+ PA++++</div>
                                </div>
                            </a>

                            <a href="/tim-kiem?categorySlug=nuoc-hoa"
                               class="flex items-center gap-3 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)] border border-[var(--rl-border-subtle)] hover:border-[var(--rl-border-strong)] shadow-[var(--rl-shadow-xs)] transition group">
                                <img src="/images/banners/banner-luxury-fragrance.jpg"
                                     alt=""
                                     aria-hidden="true"
                                     width="44"
                                     height="44"
                                     loading="lazy"
                                     class="w-11 h-11 rounded-full object-cover border border-[var(--rl-border-strong)] shrink-0" />
                                <div class="min-w-0">
                                    <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] truncate">Nước Hoa &amp; Quà</div>
                                    <div class="text-[10px] text-[var(--rl-muted)]">Haute Parfumerie</div>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Khối 3: Sản Phẩm Xem Gần Đây (Recently Viewed Products / Curated Fallback) -->
                    <div>
                        <div class="flex items-center justify-between mb-3.5">
                            <span class="text-[11px] font-extrabold uppercase tracking-[0.16em] text-[var(--rl-mauve)] flex items-center gap-2">
                                <i class="fa-solid fa-eye text-[var(--rl-rose)]" aria-hidden="true"></i>
                                <span x-text="recentlyViewedProducts.length > 0 ? 'Sản Phẩm Xem Gần Đây' : 'Sản Phẩm Xem Gần Đây &amp; Đề Xuất Cho Bạn'">
                                    Sản Phẩm Xem Gần Đây
                                </span>
                            </span>
                            <a href="/tim-kiem?sort=bestseller" class="text-xs font-bold text-[var(--rl-rose)] hover:underline">Khám phá thêm</a>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                            <template x-for="prod in getOverlayShowcaseProducts()" :key="prod.id || prod.slug">
                                <a :href="'/san-pham/' + prod.slug"
                                   @@click="recordProductView(prod)"
                                   class="flex sm:flex-col gap-3 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)]/55 border border-[var(--rl-border-subtle)] hover:border-[var(--rl-border-strong)] shadow-[var(--rl-shadow-xs)] transition group">
                                    <div class="w-16 h-16 sm:w-full sm:aspect-square rounded-xl bg-[var(--rl-bg)] overflow-hidden shrink-0 border border-[var(--rl-border-subtle)]">
                                        <img :src="prod.imageUrl || '/images/product-placeholder.svg'"
                                             :alt="prod.name"
                                             loading="lazy"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                    </div>
                                    <div class="min-w-0 flex-1 flex flex-col justify-between">
                                        <div>
                                            <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--rl-rose)] truncate" x-text="prod.brandName || 'CANMAKE'"></div>
                                            <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] line-clamp-2 mt-0.5" x-text="prod.name"></div>
                                        </div>
                                        <div class="flex items-center justify-between gap-2 mt-2">
                                            <span class="text-xs font-extrabold text-[var(--rl-rose)] font-mono-numeric" x-text="formatPrice(prod.salePrice || prod.price)"></span>
                                            <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-[var(--rl-emerald)] border border-emerald-200/70">Date Mới</span>
                                        </div>
                                    </div>
                                </a>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- TRẠNG THÁI 2: ĐANG GÕ TỪ KHOÁ (>= 2 ký tự) -> GỢI Ý TỨC THÌ -->
                <div x-cloak x-show="query.trim().length >= 2" class="space-y-6">
                    <!-- Loading -->
                    <div x-show="isLoading" class="py-12 text-center">
                        <div class="w-8 h-8 border-2 border-[var(--rl-rose)] border-t-transparent rounded-full animate-spin mx-auto mb-2"></div>
                        <p class="text-xs font-medium text-[var(--rl-mauve)]">Đang tìm kiếm sản phẩm chính hãng date mới...</p>
                    </div>

                    <!-- Có kết quả -->
                    <div x-show="!isLoading && hasAnyMatch()" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- Cột trái (4 cols): Thương hiệu & Danh mục khớp -->
                        <div class="lg:col-span-4 space-y-5">
                            <div x-show="suggestions.brands && suggestions.brands.length > 0"
                                 class="p-4 rounded-2xl bg-white border border-[var(--rl-border-subtle)]">
                                <div class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--rl-muted)] mb-2.5">Thương Hiệu</div>
                                <div class="flex flex-wrap gap-2">
                                    <template x-for="b in suggestions.brands" :key="b.name">
                                        <a :href="'/tim-kiem?brand=' + encodeURIComponent(b.name)"
                                           class="px-3 py-1.5 rounded-full bg-[var(--rl-bg-blush)] hover:bg-[var(--rl-rose)] text-xs font-bold text-[var(--rl-ink)] hover:text-white transition">
                                            <span x-html="highlightMatch(b.name, query)"></span>
                                            <span class="text-[10px] opacity-70 ml-1" x-text="'(' + b.productCount + ')'"></span>
                                        </a>
                                    </template>
                                </div>
                            </div>

                            <div x-show="suggestions.categories && suggestions.categories.length > 0"
                                 class="p-4 rounded-2xl bg-white border border-[var(--rl-border-subtle)]">
                                <div class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--rl-muted)] mb-2.5">Danh Mục</div>
                                <div class="space-y-1.5">
                                    <template x-for="c in suggestions.categories" :key="c.slug">
                                        <a :href="'/tim-kiem?categorySlug=' + encodeURIComponent(c.slug)"
                                           class="flex items-center justify-between p-2 rounded-xl hover:bg-[var(--rl-bg-blush)] text-xs font-semibold text-[var(--rl-ink)] transition">
                                            <span x-html="highlightMatch(c.name, query)"></span>
                                            <span class="text-[10px] text-[var(--rl-muted)]" x-text="c.productCount + ' SP'"></span>
                                        </a>
                                    </template>
                                </div>
                            </div>
                        </div>

                        <!-- Cột phải (8 cols): Sản phẩm gợi ý -->
                        <div class="lg:col-span-8">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[11px] font-extrabold uppercase tracking-wider text-[var(--rl-mauve)]">Sản Phẩm Phù Hợp Nhất</span>
                                <span class="text-xs font-bold text-[var(--rl-rose)]" x-text="(suggestions.totalMatches || 0) + ' kết quả'"></span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <template x-for="prod in suggestions.products" :key="prod.id">
                                    <a :href="'/san-pham/' + prod.slug"
                                       @@click="recordProductView(prod); saveRecentSearch(query);"
                                       class="flex items-center gap-3.5 p-3 rounded-2xl bg-white hover:bg-[var(--rl-bg-blush)]/60 border border-[var(--rl-border-subtle)] hover:border-[var(--rl-rose)] shadow-[var(--rl-shadow-xs)] transition group">
                                        <img :src="prod.imageUrl || '/images/product-placeholder.svg'"
                                             :alt="prod.name"
                                             width="60"
                                             height="60"
                                             loading="lazy"
                                             class="w-15 h-15 rounded-xl object-cover border border-[var(--rl-border-subtle)] shrink-0" />
                                        <div class="min-w-0 flex-1">
                                            <div class="text-[10px] font-bold uppercase tracking-wider text-[var(--rl-rose)] truncate" x-text="prod.brandName"></div>
                                            <div class="text-xs font-bold text-[var(--rl-ink)] group-hover:text-[var(--rl-rose)] line-clamp-1 mt-0.5"
                                                 x-html="highlightMatch(prod.name, query)"></div>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-xs font-extrabold text-[var(--rl-rose)] font-mono-numeric" x-text="formatPrice(prod.salePrice || prod.price)"></span>
                                                <template x-if="prod.salePrice && prod.salePrice < prod.price">
                                                    <span class="text-[10px] text-[var(--rl-muted)] line-through font-mono-numeric" x-text="formatPrice(prod.price)"></span>
                                                </template>
                                            </div>
                                        </div>
                                    </a>
                                </template>
                            </div>

                            <div class="mt-5">
                                <a :href="'/tim-kiem?q=' + encodeURIComponent(query.trim())"
                                   @@click="saveRecentSearch(query)"
                                   class="btn-primary w-full justify-center">
                                    <span>Xem tất cả kết quả cho "<span x-text="query.trim()"></span>"</span>
                                    <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Không tìm thấy -->
                    <div x-show="!isLoading && !hasAnyMatch()" class="py-12 text-center bg-white rounded-3xl border border-[var(--rl-border-subtle)] p-8">
                        <div class="w-12 h-12 rounded-full bg-[var(--rl-bg-blush)] text-[var(--rl-rose)] mx-auto flex items-center justify-center mb-3">
                            <i class="fa-solid fa-magnifying-glass text-lg" aria-hidden="true"></i>
                        </div>
                        <p class="text-sm font-bold text-[var(--rl-ink)]">Không tìm thấy sản phẩm khớp với "<span class="text-[var(--rl-rose)]" x-text="query"></span>"</p>
                        <p class="text-xs text-[var(--rl-muted)] mt-1">Hãy thử tìm theo tên hoạt chất (B5, HA, Retinol) hoặc thương hiệu (Dior, Anessa, CeraVe).</p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</header>

<script>
    // Bộ điều khiển Mega Menu Desktop: Hover Delay 120ms + Điều hướng bàn phím 100%
    function megaMenuController() {
        return {
            megaOpen: false,
            hoverTimer: null,
            closeTimer: null,

            onMouseEnter() {
                if (this.closeTimer) {
                    clearTimeout(this.closeTimer);
                    this.closeTimer = null;
                }
                if (this.megaOpen) return;
                this.hoverTimer = setTimeout(() => {
                    this.megaOpen = true;
                }, 120);
            },

            onMouseLeave() {
                if (this.hoverTimer) {
                    clearTimeout(this.hoverTimer);
                    this.hoverTimer = null;
                }
                this.closeTimer = setTimeout(() => {
                    this.megaOpen = false;
                }, 160);
            },

            toggleMega() {
                if (this.hoverTimer) clearTimeout(this.hoverTimer);
                if (this.closeTimer) clearTimeout(this.closeTimer);
                this.megaOpen = !this.megaOpen;
            },

            openAndFocusFirst() {
                if (this.hoverTimer) clearTimeout(this.hoverTimer);
                this.megaOpen = true;
                this.$nextTick(() => {
                    const firstLink = this.$refs.megaPanel?.querySelector('a, button');
                    if (firstLink) firstLink.focus();
                });
            },

            handleEscape() {
                if (this.megaOpen) {
                    this.megaOpen = false;
                    this.$nextTick(() => {
                        this.$refs.megaTrigger?.focus();
                    });
                }
            },

            onFocusOut(event) {
                const container = event.currentTarget;
                const nextFocused = event.relatedTarget;
                if (container && nextFocused && !container.contains(nextFocused)) {
                    this.megaOpen = false;
                }
            }
        };
    }

    // Trung tâm thông báo Storefront
    function storefrontNotificationCenter() {
        return {
            notifOpen: false,
            loading: false,
            unreadCount: 0,
            items: [],

            async initNotifications() {
                await this.fetchUnreadSummary();
                window.addEventListener('storefront-notification-received', () => {
                    this.fetchUnreadSummary();
                });
            },

            async toggleDropdown() {
                this.notifOpen = !this.notifOpen;
                if (this.notifOpen) {
                    await this.fetchLatestNotifications();
                }
            },

            async fetchUnreadSummary() {
                try {
                    const res = await fetch('/api/notifications/summary', { headers: { 'Accept': 'application/json' } });
                    if (res.ok) {
                        const data = await res.json();
                        this.unreadCount = data.unreadCount || 0;
                    }
                } catch (e) { }
            },

            async fetchLatestNotifications() {
                this.loading = true;
                try {
                    const res = await fetch('/api/notifications/latest?limit=8', { headers: { 'Accept': 'application/json' } });
                    if (res.ok) {
                        const data = await res.json();
                        this.items = data.items || [];
                        this.unreadCount = data.unreadCount ?? this.unreadCount;
                    }
                } catch (e) {
                } finally {
                    this.loading = false;
                }
            },

            async markAllAsRead() {
                try {
                    const res = await fetch('/api/notifications/read-all', { method: 'POST' });
                    if (res.ok) {
                        this.unreadCount = 0;
                        this.items = this.items.map(i => ({ ...i, isRead: true }));
                    }
                } catch (e) { }
            },

            async openNotificationItem(item) {
                if (!item.isRead) {
                    try {
                        await fetch('/api/notifications/' + item.id + '/read', { method: 'POST' });
                        item.isRead = true;
                        this.unreadCount = Math.max(0, this.unreadCount - 1);
                    } catch (e) { }
                }
                if (item.targetUrl) {
                    window.location.href = item.targetUrl;
                }
            },

            getIconClass(type) {
                switch ((type || '').toUpperCase()) {
                    case 'ORDER': return 'fa-solid fa-box-open';
                    case 'PROMO': return 'fa-solid fa-gift';
                    case 'FEFO': return 'fa-solid fa-shield-heart';
                    default: return 'fa-solid fa-bell';
                }
            }
        };
    }

    // Bộ điều khiển Header Floating Pill + Fullscreen Search Overlay
    function instantSearch() {
        return {
            query: '',
            isOpen: false,
            searchOverlayOpen: false,
            mobileSearchOpen: false,
            isScrolled: false,
            headerHidden: false,
            lastScrollY: 0,
            isLoading: false,
            selectedIndex: -1,
            debounceTimer: null,
            recentSearches: [],
            recentlyViewedProducts: [],
            defaultHotKeywords: [
                'Serum B5 phục hồi',
                'Kem chống nắng kiềm dầu',
                'Son lì Rosé đỏ gạch',
                'Nước tẩy trang Micellar',
                'Cushion mỏng nhẹ tự nhiên',
                'Retinol tái tạo da'
            ],
            suggestions: {
                products: [],
                brands: [],
                categories: [],
                hotKeywords: [],
                totalMatches: 0
            },
            flatItems: [],
            storageKey: 'canmake_recent_searches_v1',
            recentlyViewedKey: 'canmake_recently_viewed_v1',

            initSearch() {
                const urlParams = new URLSearchParams(window.location.search);
                const qParam = urlParams.get('q');
                if (qParam) {
                    this.query = qParam;
                }
                this.loadRecentSearches();
                this.loadRecentlyViewedProducts();
                this.fetchDefaultSuggestions();

                // Theo dõi cuộn trang 60fps: Không đổi chiều cao DOM flow (CLS = 0)
                this.lastScrollY = window.scrollY || 0;
                this.isScrolled = this.lastScrollY > 56;

                let scrollTicking = false;
                window.addEventListener('scroll', () => {
                    if (!scrollTicking) {
                        window.requestAnimationFrame(() => {
                            const currentY = Math.max(0, window.scrollY || 0);
                            const delta = currentY - this.lastScrollY;

                            if (!this.isScrolled && currentY > 56) {
                                this.isScrolled = true;
                            } else if (this.isScrolled && currentY < 24) {
                                this.isScrolled = false;
                            }

                            // Cuộn xuống nhanh -> ẩn header; cuộn lên -> hiện lại ngay
                            if (currentY <= 120 || this.searchOverlayOpen) {
                                this.headerHidden = false;
                            } else if (delta > 12 && currentY > 220) {
                                this.headerHidden = true;
                            } else if (delta < -6) {
                                this.headerHidden = false;
                            }

                            this.lastScrollY = currentY;
                            scrollTicking = false;
                        });
                        scrollTicking = true;
                    }
                }, { passive: true });
            },

            openSearchOverlay() {
                this.searchOverlayOpen = true;
                this.mobileSearchOpen = true;
                this.isOpen = true;
                this.headerHidden = false;
                document.body.classList.add('overflow-hidden');
                if (this.suggestions.products.length === 0) {
                    this.fetchDefaultSuggestions();
                }
                this.$nextTick(() => {
                    if (this.$refs.searchInput) {
                        this.$refs.searchInput.focus();
                    }
                });
            },

            closeSearchOverlay() {
                this.searchOverlayOpen = false;
                this.mobileSearchOpen = false;
                this.isOpen = false;
                this.selectedIndex = -1;
                document.body.classList.remove('overflow-hidden');
            },

            openMobileSearch() {
                this.openSearchOverlay();
            },

            closeMobileSearch() {
                this.closeSearchOverlay();
            },

            loadRecentSearches() {
                try {
                    const raw = localStorage.getItem(this.storageKey);
                    if (raw) {
                        const parsed = JSON.parse(raw);
                        if (Array.isArray(parsed)) {
                            this.recentSearches = parsed.slice(0, 6);
                        }
                    }
                } catch (e) {
                    this.recentSearches = [];
                }
            },

            loadRecentlyViewedProducts() {
                try {
                    const raw = localStorage.getItem(this.recentlyViewedKey);
                    if (raw) {
                        const parsed = JSON.parse(raw);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            this.recentlyViewedProducts = parsed.slice(0, 4);
                        }
                    }
                } catch (e) {
                    this.recentlyViewedProducts = [];
                }
            },

            recordProductView(prod) {
                if (!prod || !prod.slug) return;
                try {
                    const cleaned = this.recentlyViewedProducts.filter(
                        p => p.slug !== prod.slug
                    );
                    cleaned.unshift({
                        id: prod.id,
                        name: prod.name,
                        slug: prod.slug,
                        imageUrl: prod.imageUrl,
                        price: prod.price,
                        salePrice: prod.salePrice,
                        brandName: prod.brandName
                    });
                    this.recentlyViewedProducts = cleaned.slice(0, 4);
                    localStorage.setItem(this.recentlyViewedKey, JSON.stringify(this.recentlyViewedProducts));
                } catch (e) { }
            },

            getOverlayShowcaseProducts() {
                if (this.recentlyViewedProducts && this.recentlyViewedProducts.length > 0) {
                    return this.recentlyViewedProducts;
                }
                return (this.suggestions.products || []).slice(0, 4);
            },

            saveRecentSearch(term) {
                if (!term) return;
                const clean = term.trim();
                if (clean.length < 2) return;
                try {
                    let list = this.recentSearches.filter(item => item.toLowerCase() !== clean.toLowerCase());
                    list.unshift(clean);
                    this.recentSearches = list.slice(0, 6);
                    localStorage.setItem(this.storageKey, JSON.stringify(this.recentSearches));
                } catch (e) { }
            },

            removeRecentSearch(term) {
                try {
                    this.recentSearches = this.recentSearches.filter(item => item !== term);
                    localStorage.setItem(this.storageKey, JSON.stringify(this.recentSearches));
                    this.updateFlatItems();
                } catch (e) { }
            },

            clearRecentSearches() {
                try {
                    this.recentSearches = [];
                    localStorage.removeItem(this.storageKey);
                    this.updateFlatItems();
                } catch (e) { }
            },

            hasAnyMatch() {
                return (this.suggestions.products && this.suggestions.products.length > 0) ||
                       (this.suggestions.brands && this.suggestions.brands.length > 0) ||
                       (this.suggestions.categories && this.suggestions.categories.length > 0);
            },

            onInput() {
                this.isOpen = true;
                this.selectedIndex = -1;
                if (this.debounceTimer) clearTimeout(this.debounceTimer);

                const q = this.query.trim();
                if (q.length < 2) {
                    this.isLoading = false;
                    this.fetchDefaultSuggestions();
                    return;
                }

                this.isLoading = true;
                this.debounceTimer = setTimeout(() => {
                    this.fetchSuggestions(q);
                }, 220);
            },

            async fetchSuggestions(q) {
                try {
                    const res = await fetch('/api/search/suggest?q=' + encodeURIComponent(q) + '&maxProducts=6&maxBrands=4&maxCategories=4');
                    if (res.ok) {
                        const data = await res.json();
                        this.suggestions = data;
                        this.updateFlatItems();
                    }
                } catch (e) {
                } finally {
                    this.isLoading = false;
                }
            },

            async fetchDefaultSuggestions() {
                try {
                    const res = await fetch('/api/search/suggest?q=');
                    if (res.ok) {
                        const data = await res.json();
                        this.suggestions = data;
                        this.updateFlatItems();
                    }
                } catch (e) { }
            },

            selectTerm(term) {
                this.query = term;
                this.saveRecentSearch(term);
                document.body.classList.remove('overflow-hidden');
                window.location.href = '/tim-kiem?q=' + encodeURIComponent(term);
            },

            clearQuery() {
                this.query = '';
                this.selectedIndex = -1;
                this.fetchDefaultSuggestions();
                if (this.$refs.searchInput) this.$refs.searchInput.focus();
            },

            close() {
                this.closeSearchOverlay();
            },

            updateFlatItems() {
                const items = [];
                const q = this.query ? this.query.trim() : '';

                if (q.length >= 2) {
                    if (this.suggestions.brands && Array.isArray(this.suggestions.brands)) {
                        this.suggestions.brands.forEach(b => {
                            items.push({ type: 'brand', url: '/tim-kiem?brand=' + encodeURIComponent(b.name), title: b.name, id: b.name });
                        });
                    }
                    if (this.suggestions.categories && Array.isArray(this.suggestions.categories)) {
                        this.suggestions.categories.forEach(c => {
                            items.push({ type: 'category', url: '/tim-kiem?categorySlug=' + encodeURIComponent(c.slug), title: c.name, id: c.slug });
                        });
                    }
                    if (this.suggestions.products && Array.isArray(this.suggestions.products)) {
                        this.suggestions.products.forEach(p => {
                            items.push({ type: 'product', url: '/san-pham/' + p.slug, title: p.name, id: p.name });
                        });
                    }
                    if (items.length > 0) {
                        items.push({ type: 'view_all', url: '/tim-kiem?q=' + encodeURIComponent(q), title: 'Xem tất cả kết quả', id: q });
                    }
                } else {
                    if (this.recentSearches && Array.isArray(this.recentSearches)) {
                        this.recentSearches.forEach(term => {
                            items.push({ type: 'recent', url: '/tim-kiem?q=' + encodeURIComponent(term), title: term, id: term });
                        });
                    }
                    if (this.suggestions.hotKeywords && Array.isArray(this.suggestions.hotKeywords)) {
                        this.suggestions.hotKeywords.forEach(kw => {
                            items.push({ type: 'keyword', url: '/tim-kiem?q=' + encodeURIComponent(kw), title: kw, id: kw });
                        });
                    }
                }
                this.flatItems = items;
            },

            selectNext() {
                if (this.flatItems.length === 0) return;
                this.selectedIndex = (this.selectedIndex + 1) % this.flatItems.length;
            },

            selectPrev() {
                if (this.flatItems.length === 0) return;
                this.selectedIndex = (this.selectedIndex - 1 + this.flatItems.length) % this.flatItems.length;
            },

            handleEnter(event) {
                if (event.isComposing) return;
                if (this.selectedIndex >= 0 && this.selectedIndex < this.flatItems.length) {
                    event.preventDefault();
                    const item = this.flatItems[this.selectedIndex];
                    this.saveRecentSearch(item.title);
                    document.body.classList.remove('overflow-hidden');
                    window.location.href = item.url;
                } else if (this.query && this.query.trim().length > 0) {
                    this.saveRecentSearch(this.query.trim());
                    document.body.classList.remove('overflow-hidden');
                }
            },

            handleSubmit(event) {
                if (this.selectedIndex >= 0 && this.selectedIndex < this.flatItems.length) {
                    event.preventDefault();
                    const item = this.flatItems[this.selectedIndex];
                    this.saveRecentSearch(item.title);
                    document.body.classList.remove('overflow-hidden');
                    window.location.href = item.url;
                } else if (this.query && this.query.trim().length > 0) {
                    this.saveRecentSearch(this.query.trim());
                    document.body.classList.remove('overflow-hidden');
                }
            },

            formatPrice(val) {
                if (!val) return '0 ₫';
                return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
            },

            escapeHtml(str) {
                if (!str) return '';
                return String(str).replace(/[&<>"']/g, function(m) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
                });
            },

            highlightMatch(text, query) {
                if (!text) return '';
                const safe = this.escapeHtml(text);
                if (!query || !query.trim()) return safe;
                try {
                    const qClean = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(${qClean})`, 'gi');
                    return safe.replace(regex, '<mark class="bg-[var(--rl-bg-petal)] text-[var(--rl-rose-deep)] font-bold px-1 rounded">$1</mark>');
                } catch (e) {
                    return safe;
                }
            }
        };
    }
</script>
