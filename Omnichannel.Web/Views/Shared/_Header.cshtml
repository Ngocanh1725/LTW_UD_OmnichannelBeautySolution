@inject Omnichannel.Application.Interfaces.Cms.IThemeService ThemeService
@{
    var theme = await ThemeService.GetCurrentThemeAsync();
}
@* Omnichannel Beauty Suite - Storefront Header Partial *@
<header class="w-full relative z-40" x-data="instantSearch()" x-init="init()">
    <style>
        @@keyframes tickerMarquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .animate-ticker-marquee {
            display: inline-flex;
            white-space: nowrap;
            animation: tickerMarquee 30s linear infinite;
        }
        .animate-ticker-marquee:hover {
            animation-play-state: paused;
        }

        /* Luxury Mega Menu Display on Hover */
        .group:hover > .mega-menu-content,
        .has-mega-menu:hover .mega-menu-content {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: auto !important;
            transform: translateY(0) scale(1) !important;
        }
    </style>

    <!-- Top Announcement Bar with Smooth Ticker & VIP Hotline -->
    @if (theme.AnnouncementBarActive && !string.IsNullOrWhiteSpace(theme.AnnouncementBarText))
    {
        <aside aria-label="Thông báo ưu đãi" class="text-white flex items-center justify-between px-3 sm:px-6 py-1.5 text-xs border-b border-white/5 relative overflow-hidden select-none" style="background-color: @theme.AnnouncementBarBgColor;">
            <!-- Left Luxury Badge (Desktop) -->
            <div class="hidden xl:flex items-center gap-3 text-slate-300 text-[11px] shrink-0 font-medium">
                <span class="inline-flex items-center gap-1.5"><i class="fa-solid fa-gem text-rose-gold"></i> Haute Parfumerie</span>
                <span class="text-slate-600">•</span>
                <span class="inline-flex items-center gap-1.5"><i class="fa-solid fa-clock-rotate-left text-amber-400"></i> FEFO Minh Bạch 100%</span>
            </div>

            <!-- Center Smooth Marquee Ticker -->
            <div class="overflow-hidden whitespace-nowrap flex-1 mx-2 sm:mx-6 cursor-pointer">
                <div class="animate-ticker-marquee items-center text-slate-200 text-xs font-medium tracking-wide">
                    <span class="inline-block px-4">
                        ✦ <span class="font-bold text-amber-300">@theme.AnnouncementBarText</span> ✦
                    </span>
                    <span class="inline-block px-4">
                        ✦ <span class="font-bold text-amber-300">@theme.AnnouncementBarText</span> ✦
                    </span>
                </div>
            </div>

            <!-- Right VIP Hotline & Utilities -->
            <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                @if (!string.IsNullOrWhiteSpace(theme.Hotline))
                {
                    <!-- VIP Hotline CTA Button -->
                    <a href="tel:@theme.Hotline.Replace(" ", "")" 
                       class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-amber-500/20 via-pink-500/20 to-purple-500/20 hover:from-amber-500/30 hover:to-pink-500/30 border border-amber-400/40 text-amber-300 hover:text-white transition-all font-bold text-[11px] shadow-2xs group"
                       title="Hotline tư vấn VIP @theme.Hotline">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                        </span>
                        <i class="fa-solid fa-headset text-rose-gold group-hover:scale-110 transition-transform"></i>
                        <span>Hotline VIP: @theme.Hotline <span class="text-[10px] font-normal text-slate-300 hidden md:inline">(08:00 - 22:00)</span></span>
                    </a>
                }

                <div class="hidden lg:flex items-center gap-3 text-[11px] font-semibold text-slate-300">
                    <span class="text-slate-600">|</span>
                    <a href="/tra-cuu-don-hang" class="hover:text-magenta-accent transition flex items-center gap-1">
                        <i class="fa-solid fa-truck-fast text-amber-400"></i> Tra cứu đơn hàng
                    </a>
                    <span class="text-slate-600">|</span>
                    <a href="/stores" class="hover:text-magenta-accent transition flex items-center gap-1">
                        <i class="fa-solid fa-location-dot text-rose-gold"></i> Showroom
                    </a>
                    <span class="text-slate-600">|</span>
                    <span class="text-white font-bold tracking-wider">VNĐ (₫)</span>
                </div>
            </div>
        </aside>
    }

    <!-- Main Navigation Bar with Glassmorphism -->
    <div class="header-glass sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-soft-border/70 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="h-20 flex items-center justify-between gap-4">

                <!-- Mobile Menu Hamburger Button -->
                <button type="button" 
                        class="lg:hidden p-2.5 rounded-xl text-slate-700 hover:text-magenta-accent hover:bg-pastel-rose transition" 
                        @@click="mobileMenuOpen = true" 
                        aria-label="Mở danh mục menu">
                    <i class="fa-solid fa-bars-staggered text-xl"></i>
                </button>

                <!-- Brand Logo (Omni Beauty - Dynamic Theme Engine) -->
                <a href="/" class="brand-logo-wrapper flex items-center gap-2.5 sm:gap-3 group shrink-0" title="@theme.BrandName - @(theme.Slogan ?? "Luxury Cosmetics")">
                    <div class="brand-logo-badge relative shrink-0">
                        <img src="@theme.LogoUrl" 
                             alt="@theme.BrandName Logo" 
                             class="brand-logo-img h-10 w-10 sm:h-11 sm:w-11 object-cover rounded-full" 
                             onerror="this.onerror=null; this.src='@theme.LogoUrl'" />
                    </div>
                    <div class="flex flex-col items-start leading-none">
                        <span class="brand-logo-text text-lg sm:text-2xl font-serif font-bold text-charcoal tracking-[0.16em] transition group-hover:text-magenta-accent">
                            @theme.BrandName
                        </span>
                        <span class="text-[8px] sm:text-[9.5px] font-bold tracking-[0.32em] text-magenta-accent uppercase mt-0.5">
                            @(theme.Slogan ?? "LUXURY COSMETICS")
                        </span>
                    </div>
                </a>

                <!-- Live Sephora/Hasaki Instant Search Bar with Luxury Popover -->
                <div class="search-input-wrapper hidden md:block relative z-50 flex-1 max-w-lg mx-4"
                     @@click.outside="close()"
                     @@keydown.escape.window="close()">
                    
                    <!form action="/tim-kiem" method="GET" x-on:submit="handleSubmit($event)" class="relative">
                        <i class="fa-solid absolute left-4 top-1/2 -translate-y-1/2 text-sm transition-colors"
                           :class="isLoading ? 'fa-spinner fa-spin text-magenta-accent' : 'fa-magnifying-glass text-slate-400'"></i>
                        
                        <input type="text" 
                               name="q" 
                               id="storefrontSearchInput"
                               x-ref="searchInput"
                               x-model="query"
                               @@focus="onFocus()"
                               @@input="onInput()"
                               @@keydown.arrow-down.prevent="selectNext()"
                               @@keydown.arrow-up.prevent="selectPrev()"
                               @@keydown.enter="handleEnter($event)"
                               placeholder="Tìm son lì, kem chống nắng, serum HA & B5, nước hoa..." 
                               class="search-input-beauty w-full pl-11 pr-16 py-2.5 rounded-full border border-slate-200 focus:border-magenta-accent focus:ring-2 focus:ring-magenta-accent/20 bg-slate-50/70 hover:bg-white text-sm outline-none transition-all placeholder:text-slate-400 font-sans shadow-2xs" 
                               autocomplete="off" />

                        <!-- Quick Clear Button -->
                        <button type="button" 
                                x-show="query && query.length > 0"
                                @@click="clearQuery()"
                                class="absolute right-10 top-1/2 -translate-y-1/2 h-5 w-5 flex items-center justify-center text-slate-400 hover:text-charcoal hover:bg-slate-200/60 rounded-full text-xs transition"
                                style="display: none;"
                                aria-label="Xóa từ khóa">
                            <i class="fa-solid fa-xmark text-[11px]"></i>
                        </button>

                        <!-- Submit Arrow Button -->
                        <button type="submit" 
                                class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-magenta-accent transition" 
                                aria-label="Tìm kiếm">
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </!form>

                    <!-- Instant Search Results Dropdown Popover -->
                    <div id="liveSearchResultsPopover" 
                         x-show="isOpen"
                         @@click.stop
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 translate-y-2 scale-98"
                         x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                         x-transition:leave="transition ease-in duration-150"
                         x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                         x-transition:leave-end="opacity-0 translate-y-2 scale-98"
                         style="display: none;"
                         class="search-results-dropdown absolute top-full left-0 right-0 mt-2 bg-white/98 backdrop-blur-xl rounded-2xl shadow-2xl border border-rose-100/90 p-3.5 z-50 max-h-[520px] overflow-y-auto">
                        
                        <!-- STATE 1: RECENT SEARCHES & TRENDING (Khi chưa nhập hoặc < 2 ký tự) -->
                        <template x-if="!query || query.trim().length < 2">
                            <div class="space-y-4">
                                <!-- Recent Searches -->
                                <template x-if="recentSearches.length > 0">
                                    <div>
                                        <div class="flex items-center justify-between px-1 mb-2">
                                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                                <i class="fa-regular fa-clock text-magenta-accent"></i>
                                                <span>Tìm Kiếm Gần Đây</span>
                                            </span>
                                            <button type="button" 
                                                    @@click="clearRecentSearches()"
                                                    class="text-[10px] font-semibold text-magenta-accent hover:underline">
                                                Xóa tất cả
                                            </button>
                                        </div>
                                        <div class="flex flex-wrap gap-1.5 px-1">
                                            <template x-for="(term, rIdx) in recentSearches" :key="'recent-' + rIdx">
                                                <div class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 hover:bg-pastel-rose text-slate-700 hover:text-magenta-accent border border-slate-200/80 text-xs font-medium transition cursor-pointer"
                                                     :class="isItemActive('recent', term) ? 'bg-pastel-rose text-magenta-accent ring-1 ring-magenta-accent' : ''"
                                                     @@click="selectTerm(term)">
                                                    <i class="fa-solid fa-magnifying-glass text-[10px] text-slate-400 group-hover:text-magenta-accent"></i>
                                                    <span x-text="term"></span>
                                                    <button type="button" 
                                                            @@click.stop="removeRecentSearch(term)"
                                                            class="ml-0.5 text-slate-400 hover:text-rose-600 transition p-0.5"
                                                            title="Xóa mục này">
                                                        <i class="fa-solid fa-xmark text-[10px]"></i>
                                                    </button>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <!-- Trending Keywords -->
                                <div>
                                    <div class="px-1 mb-2">
                                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                            <i class="fa-solid fa-fire text-amber-500"></i>
                                            <span>Xu Hướng Tìm Kiếm Hôm Nay</span>
                                            <span class="px-1.5 py-0.2 rounded-full text-[9px] font-bold bg-rose-100 text-rose-700">HOT</span>
                                        </span>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5 px-1">
                                        <template x-for="(kw, kIdx) in suggestions.hotKeywords" :key="'hot-' + kIdx">
                                            <button type="button"
                                                    @@click="selectTerm(kw)"
                                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 hover:bg-pastel-rose text-slate-700 hover:text-magenta-accent border border-slate-200/70 text-xs font-semibold transition group"
                                                    :class="isItemActive('keyword', kw) ? 'bg-pastel-rose text-magenta-accent ring-1 ring-magenta-accent' : ''">
                                                <i class="fa-solid fa-magnifying-glass text-[10px] text-slate-400 group-hover:text-magenta-accent"></i>
                                                <span x-text="kw"></span>
                                            </button>
                                        </template>
                                    </div>
                                </div>

                                <!-- Featured Categories Quick Jump -->
                                <template x-if="suggestions.categories && suggestions.categories.length > 0">
                                    <div class="pt-2 border-t border-slate-100">
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2 px-1">
                                            Khám Phá Danh Mục Nổi Bật
                                        </span>
                                        <div class="grid grid-cols-2 gap-2">
                                            <template x-for="cat in suggestions.categories.slice(0, 4)" :key="'cat-feat-' + cat.id">
                                                <a :href="'/tim-kiem?categorySlug=' + cat.slug"
                                                   class="flex items-center gap-2 p-2 rounded-xl bg-pastel-rose/40 hover:bg-pastel-rose border border-rose-100/60 transition group">
                                                    <div class="w-7 h-7 rounded-lg bg-white flex items-center justify-center text-magenta-accent shadow-2xs group-hover:scale-105 transition shrink-0">
                                                        <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <div class="text-xs font-bold text-charcoal group-hover:text-magenta-accent truncate" x-text="cat.name"></div>
                                                        <div class="text-[10px] text-slate-400" x-text="cat.productCount + ' sản phẩm'"></div>
                                                    </div>
                                                </a>
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <!-- STATE 2: ACTIVE SEARCH SUGGESTIONS (Khi đã nhập >= 2 ký tự) -->
                        <template x-if="query && query.trim().length >= 2">
                            <div>
                                <!-- Loading indicator -->
                                <template x-if="isLoading">
                                    <div class="py-5 text-center text-slate-400 text-xs">
                                        <i class="fa-solid fa-spinner fa-spin text-magenta-accent text-base mb-1.5"></i>
                                        <div>Đang tải gợi ý làm đẹp cao cấp...</div>
                                    </div>
                                </template>

                                <!-- Search Results Content -->
                                <template x-if="!isLoading">
                                    <div>
                                        <!-- Brands & Categories Badges -->
                                        <template x-if="(suggestions.brands && suggestions.brands.length > 0) || (suggestions.categories && suggestions.categories.length > 0)">
                                            <div class="mb-3 space-y-2 border-b border-slate-100 pb-2.5">
                                                <!-- Brands -->
                                                <template x-if="suggestions.brands && suggestions.brands.length > 0">
                                                    <div class="flex items-center gap-1.5 flex-wrap px-1">
                                                        <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider mr-1">Thương hiệu:</span>
                                                        <template x-for="b in suggestions.brands" :key="'b-' + b.id">
                                                            <a :href="'/tim-kiem?brand=' + encodeURIComponent(b.name)"
                                                               class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 hover:bg-magenta-accent hover:text-white text-slate-700 text-xs font-semibold transition"
                                                               :class="isItemActive('brand', b.name) ? 'bg-magenta-accent text-white ring-1 ring-magenta-accent' : ''">
                                                                <i class="fa-solid fa-certificate text-[9px] text-amber-500"></i>
                                                                <span x-html="highlightMatch(b.name, query)"></span>
                                                                <span class="text-[10px] opacity-75" x-text="'(' + b.productCount + ')'"></span>
                                                            </a>
                                                        </template>
                                                    </div>
                                                </template>

                                                <!-- Categories -->
                                                <template x-if="suggestions.categories && suggestions.categories.length > 0">
                                                    <div class="flex items-center gap-1.5 flex-wrap px-1">
                                                        <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider mr-1">Danh mục:</span>
                                                        <template x-for="c in suggestions.categories" :key="'c-' + c.id">
                                                            <a :href="'/tim-kiem?categorySlug=' + c.slug"
                                                               class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-50 hover:bg-magenta-accent hover:text-white text-magenta-accent text-xs font-semibold transition"
                                                               :class="isItemActive('category', c.slug) ? 'bg-magenta-accent text-white ring-1 ring-magenta-accent' : ''">
                                                                <span x-html="highlightMatch(c.name, query)"></span>
                                                            </a>
                                                        </template>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>

                                        <!-- Products List -->
                                        <template x-if="suggestions.products && suggestions.products.length > 0">
                                            <div>
                                                <div class="px-1 mb-2 flex items-center justify-between">
                                                    <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">
                                                        Sản Phẩm Gợi Ý (<span x-text="suggestions.totalMatches"></span>)
                                                    </span>
                                                    <span class="text-[10px] text-slate-400 hidden sm:inline">
                                                        Dùng phím <kbd class="px-1 py-0.5 bg-slate-100 rounded text-[9px] font-mono">↑</kbd> <kbd class="px-1 py-0.5 bg-slate-100 rounded text-[9px] font-mono">↓</kbd> để chọn
                                                    </span>
                                                </div>
                                                
                                                <div class="space-y-1.5 max-h-[320px] overflow-y-auto pr-1 divide-y divide-slate-100/70">
                                                    <template x-for="p in suggestions.products" :key="'p-' + p.id">
                                                        <a :href="'/san-pham/' + p.slug" 
                                                           class="flex items-center gap-3 p-2 rounded-xl hover:bg-pastel-rose/80 transition border border-transparent hover:border-pink-100 group"
                                                           :class="isItemActive('product', p.name) ? 'bg-pastel-rose border-pink-200 ring-1 ring-magenta-accent/30' : ''">
                                                            
                                                            <!-- Product Thumbnail -->
                                                            <div class="relative shrink-0">
                                                                <img :src="p.imageUrl" 
                                                                     :alt="p.name" 
                                                                     class="w-12 h-12 rounded-xl object-cover border border-slate-200/80 group-hover:border-magenta-accent/40 shadow-2xs group-hover:scale-105 transition duration-200" 
                                                                     loading="lazy" />
                                                                <template x-if="p.isFeatured">
                                                                    <span class="absolute -top-1 -left-1 text-[8px] bg-charcoal text-white font-bold px-1 rounded-sm shadow-2xs">HOT</span>
                                                                </template>
                                                            </div>

                                                            <!-- Product Info -->
                                                            <div class="flex-1 min-w-0">
                                                                <div class="flex items-center gap-1.5 mb-0.5">
                                                                    <span class="text-[9px] font-bold text-rose-gold uppercase tracking-wider truncate" x-text="p.brandName"></span>
                                                                    <span class="text-slate-300">•</span>
                                                                    <span class="text-[9px] text-slate-500 truncate" x-text="p.categoryName"></span>
                                                                </div>

                                                                <h4 class="text-xs font-bold text-slate-800 truncate group-hover:text-magenta-accent transition leading-tight" 
                                                                    x-html="highlightMatch(p.name, query)"></h4>

                                                                <div class="flex items-baseline gap-2 mt-1">
                                                                    <span class="text-xs font-bold text-charcoal font-mono-numeric" 
                                                                          x-text="formatPrice(p.salePrice || p.price)"></span>
                                                                    <template x-if="p.salePrice && p.salePrice < p.price">
                                                                        <span class="text-[10px] text-slate-400 line-through font-mono-numeric" 
                                                                              x-text="formatPrice(p.price)"></span>
                                                                    </template>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    </template>
                                                </div>

                                                <!-- View All Footer Button -->
                                                <a :href="'/tim-kiem?q=' + encodeURIComponent(query)"
                                                   @@click="saveRecentSearch(query)"
                                                   class="w-full flex items-center justify-center gap-2 mt-2.5 py-2 px-4 rounded-xl bg-pastel-rose text-magenta-accent hover:bg-magenta-accent hover:text-white font-bold text-xs transition duration-200 shadow-2xs"
                                                   :class="isItemActive('view_all', query) ? 'bg-magenta-accent text-white' : ''">
                                                    <span>Xem tất cả <span x-text="suggestions.totalMatches"></span> kết quả cho "<span x-text="query"></span>"</span>
                                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                                </a>
                                            </div>
                                        </template>

                                        <!-- Fallback Empty State -->
                                        <template x-if="(!suggestions.products || suggestions.products.length === 0) && (!suggestions.brands || suggestions.brands.length === 0) && (!suggestions.categories || suggestions.categories.length === 0)">
                                            <div class="py-6 px-4 text-center">
                                                <div class="h-10 w-10 rounded-full bg-pastel-rose text-magenta-accent flex items-center justify-center mx-auto mb-2 text-base">
                                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                                </div>
                                                <h5 class="text-xs font-bold text-slate-800 mb-1">Không tìm thấy sản phẩm phù hợp</h5>
                                                <p class="text-[11px] text-slate-500 max-w-xs mx-auto mb-3">
                                                    Rất tiếc không có sản phẩm nào khớp với "<span class="font-bold text-charcoal" x-text="query"></span>".
                                                </p>
                                                <div>
                                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2">Từ khóa gợi ý:</span>
                                                    <div class="flex flex-wrap gap-1.5 justify-center">
                                                        <template x-for="kw in suggestions.hotKeywords" :key="'empty-kw-' + kw">
                                                            <button type="button"
                                                                    @@click="selectTerm(kw)"
                                                                    class="px-2.5 py-1 rounded-full bg-slate-100 hover:bg-pastel-rose text-slate-700 hover:text-magenta-accent text-xs font-semibold transition">
                                                                <i class="fa-solid fa-magnifying-glass text-[9px] text-slate-400 mr-1"></i>
                                                                <span x-text="kw"></span>
                                                            </button>
                                                        </template>
                                                    </div>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Utilities: Wishlist, Account, Mini-Cart Drawer Trigger -->
                <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                    <!-- Mobile Search Trigger Button -->
                    <button type="button" 
                            @@click="toggleMobileSearch()" 
                            class="md:hidden p-2.5 text-slate-700 hover:text-magenta-accent transition rounded-full hover:bg-pastel-rose focus:outline-none" 
                            aria-label="Mở tìm kiếm nhanh"
                            title="Tìm kiếm">
                        <i class="fa-solid fa-magnifying-glass text-lg"></i>
                    </button>

                    <!-- Wishlist Link -->
                    <a href="/wishlist" class="relative p-2.5 text-slate-700 hover:text-magenta-accent transition rounded-full hover:bg-pastel-rose" title="Sản phẩm yêu thích">
                        <i class="fa-regular fa-heart text-lg"></i>
                        <span id="wishlistCountBadge" class="absolute top-1 right-1 h-4 w-4 rounded-full bg-magenta-accent text-white text-[10px] font-bold flex items-center justify-center">0</span>
                    </a>

                    <!-- Storefront Realtime Notification Center Dropdown -->
                    <div class="relative" x-data="storefrontNotificationCenter()" x-init="init()">
                        <button @@click="toggleOpen()"
                                type="button" 
                                class="relative p-2.5 text-slate-700 hover:text-magenta-accent transition rounded-full hover:bg-pastel-rose focus:outline-none" 
                                title="Thông báo đơn hàng & Ưu đãi">
                            <i class="fa-regular fa-bell text-lg" :class="unreadCount > 0 ? 'text-magenta-accent' : ''"></i>
                            <span x-show="unreadCount > 0" 
                                  x-text="unreadCount > 9 ? '9+' : unreadCount" 
                                  class="absolute top-1 right-1 h-4 w-4 rounded-full bg-magenta-accent text-white text-[10px] font-bold flex items-center justify-center animate-pulse shadow-sm">0</span>
                        </button>

                        <!-- Notification Dropdown Popover -->
                        <div x-show="isOpen"
                             @@click.outside="isOpen = false"
                             x-transition:enter="transition ease-out duration-200"
                             x-transition:enter-start="opacity-0 translate-y-2 scale-95"
                             x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                             x-transition:leave="transition ease-in duration-150"
                             x-transition:leave-start="opacity-100 translate-y-0 scale-100"
                             x-transition:leave-end="opacity-0 translate-y-2 scale-95"
                             style="display: none;"
                             class="absolute right-0 top-full mt-2 w-80 sm:w-96 rounded-2xl bg-white/98 backdrop-blur-xl border border-rose-100 shadow-2xl z-50 overflow-hidden font-sans">
                            
                            <!-- Header -->
                            <div class="p-3.5 border-b border-rose-100 flex items-center justify-between bg-gradient-to-r from-pastel-rose via-white to-pink-50/50">
                                <div class="flex items-center gap-2">
                                    <div class="h-6 w-6 rounded-lg bg-pink-100 text-magenta-accent flex items-center justify-center text-xs">
                                        <i class="fa-solid fa-bell"></i>
                                    </div>
                                    <span class="text-xs font-bold text-charcoal">Trung Tâm Thông Báo</span>
                                    <template x-if="unreadCount > 0">
                                        <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-magenta-accent text-white" x-text="unreadCount + ' mới'"></span>
                                    </template>
                                </div>
                                <button @@click="markAllAsRead()" 
                                        type="button"
                                        class="text-[11px] font-semibold text-magenta-accent hover:underline">
                                    Đọc tất cả
                                </button>
                            </div>

                            <!-- Items List -->
                            <div class="max-h-80 overflow-y-auto divide-y divide-rose-50">
                                <template x-if="loading && notifications.length === 0">
                                    <div class="p-6 text-center text-xs text-slate-400">
                                        <i class="fa-solid fa-spinner fa-spin text-base text-magenta-accent mb-2"></i>
                                        <div>Đang tải thông báo...</div>
                                    </div>
                                </template>

                                <template x-if="!loading && notifications.length === 0">
                                    <div class="p-6 text-center">
                                        <i class="fa-regular fa-bell-slash text-2xl text-slate-300 mb-2"></i>
                                        <div class="text-xs font-medium text-slate-600">Không có thông báo mới</div>
                                        <div class="text-[10px] text-slate-400 mt-0.5">Bạn sẽ nhận được ưu đãi và cập nhật đơn hàng tại đây</div>
                                    </div>
                                </template>

                                <template x-for="item in notifications" :key="item.id">
                                    <div @@click="handleClick(item)"
                                         class="p-3 hover:bg-pastel-rose/50 cursor-pointer transition flex items-start gap-3 relative"
                                         :class="!item.isRead ? 'bg-pink-50/40' : ''">
                                        <div class="h-8 w-8 rounded-xl flex items-center justify-center text-sm shrink-0"
                                             :class="item.severity === 'SUCCESS' ? 'bg-emerald-50 text-emerald-600' : (item.severity === 'DANGER' ? 'bg-rose-50 text-rose-600' : 'bg-pink-50 text-magenta-accent')">
                                            <i :class="item.severity === 'SUCCESS' ? 'fa-solid fa-circle-check' : (item.type === 'ORDER' ? 'fa-solid fa-box' : 'fa-solid fa-bell')"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-1">
                                                <h5 class="text-xs font-bold text-slate-800 truncate" x-text="item.title"></h5>
                                                <span class="text-[10px] text-slate-400 shrink-0" x-text="item.timeAgo"></span>
                                            </div>
                                            <p class="text-[11px] text-slate-600 line-clamp-2 mt-0.5" x-text="item.message"></p>
                                        </div>
                                        <template x-if="!item.isRead">
                                            <span class="h-2 w-2 rounded-full bg-magenta-accent shrink-0 mt-1.5"></span>
                                        </template>
                                    </div>
                                </template>
                            </div>

                            <!-- Footer -->
                            <div class="p-2 border-t border-rose-100 bg-slate-50 text-center">
                                <a href="/Customer/Orders" class="text-[11px] font-bold text-magenta-accent hover:underline block py-1">
                                    Xem lịch sử đơn hàng & thông báo <i class="fa-solid fa-arrow-right text-[9px] ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Account Menu Dropdown -->
                    <div class="relative group" x-data="{ userMenuOpen: false }">
                        <a href="/Account/Login" class="p-2.5 text-slate-700 hover:text-magenta-accent transition rounded-full hover:bg-pastel-rose flex items-center gap-1.5" title="Tài khoản">
                            <i class="fa-regular fa-user text-lg"></i>
                            <span class="hidden xl:inline text-xs font-semibold">Tài Khoản</span>
                        </a>
                        <div class="absolute right-0 top-full mt-2 w-52 bg-white rounded-2xl shadow-2xl border border-slate-100 p-2 hidden group-hover:block hover:block transition animate-in fade-in z-50">
                            <div class="px-3 py-2 border-b border-slate-100 mb-1">
                                <div class="text-xs font-bold text-charcoal">Khách Hàng Thân Thiết</div>
                                <div class="text-[10px] text-slate-400">Đăng nhập để tích điểm Loyalty</div>
                            </div>
                            <a href="/Account/Login" class="block px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent rounded-xl transition">
                                <i class="fa-solid fa-arrow-right-to-bracket mr-2 text-slate-400"></i> Đăng Nhập
                            </a>
                            <a href="/Account/Register" class="block px-3 py-2 text-xs font-bold text-magenta-accent hover:bg-pastel-rose rounded-xl transition">
                                <i class="fa-solid fa-gift mr-2 text-warning"></i> Đăng Ký (+50 Điểm)
                            </a>
                            <a href="/Customer/Dashboard" class="block px-3 py-2 text-xs font-bold text-amber-800 hover:bg-amber-50/70 rounded-xl transition flex items-center gap-2">
                                <i class="fa-solid fa-crown text-amber-500"></i> Thẻ VIP & Điểm Thưởng
                            </a>
                            <a href="/Customer/Orders" class="block px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent rounded-xl transition flex items-center gap-2">
                                <i class="fa-solid fa-bag-shopping text-blue-500"></i> Đơn Hàng Của Tôi
                            </a>
                            <a href="/Customer/Addresses" class="block px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-pastel-rose hover:text-magenta-accent rounded-xl transition flex items-center gap-2">
                                <i class="fa-solid fa-location-dot text-rose-gold"></i> Sổ Địa Chỉ Nhận Hàng
                            </a>
                            <a href="/orders/tracking" class="block px-3 py-2 text-xs font-medium text-slate-600 hover:bg-slate-50 rounded-xl transition">
                                <i class="fa-solid fa-truck-fast mr-2 text-slate-400"></i> Tra cứu đơn hàng
                            </a>
                            <div class="border-t border-slate-100 my-1"></div>
                            <a href="/Admin/Dashboard" class="block px-3 py-2 text-xs font-bold text-magenta-accent hover:bg-pastel-rose rounded-xl transition flex items-center gap-2">
                                <i class="fa-solid fa-shield-halved text-magenta-accent"></i> Quản Trị Hệ Thống
                            </a>
                        </div>
                    </div>

                    <!-- Mini Cart Trigger Button -->
                    <button type="button" 
                            @@click="cartOpen = true" 
                            id="btnOpenMiniCart" 
                            class="relative inline-flex items-center gap-2.5 px-4 sm:px-5 py-2.5 rounded-full bg-charcoal text-white hover:bg-charcoal/90 shadow-md transition-all group"
                            aria-label="Xem giỏ hàng">
                        <i class="fa-solid fa-bag-shopping text-sm text-rose-gold group-hover:scale-110 transition-transform"></i>
                        <span class="text-xs font-bold font-mono-numeric tracking-wide" id="miniCartHeaderTotal">0 ₫</span>
                        <span id="miniCartCountBadge" class="absolute -top-1.5 -right-1.5 h-5 w-5 rounded-full bg-magenta-accent text-white text-[10px] font-bold flex items-center justify-center border-2 border-white shadow-sm">0</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Instant Search Drawer (Shown on small screens) -->
        <div x-show="mobileSearchOpen"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-2"
             style="display: none;"
             class="md:hidden border-t border-rose-100/90 bg-white/98 backdrop-blur-xl px-4 py-3 shadow-xl">
            
            <!form action="/tim-kiem" method="GET" x-on:submit="handleSubmit($event)" class="relative mb-2">
                <i class="fa-solid absolute left-3.5 top-1/2 -translate-y-1/2 text-xs transition-colors"
                   :class="isLoading ? 'fa-spinner fa-spin text-magenta-accent' : 'fa-magnifying-glass text-slate-400'"></i>
                
                <input type="text" 
                       name="q" 
                       x-ref="mobileSearchInput"
                       x-model="query"
                       @@focus="onFocus()"
                       @@input="onInput()"
                       @@keydown.arrow-down.prevent="selectNext()"
                       @@keydown.arrow-up.prevent="selectPrev()"
                       @@keydown.enter="handleEnter($event)"
                       placeholder="Tìm son lì, kem chống nắng, serum..." 
                       class="w-full pl-9 pr-16 py-2 rounded-full border border-slate-200 focus:border-magenta-accent text-xs focus:outline-none bg-slate-50 focus:bg-white transition" 
                       autocomplete="off" />

                <!-- Mobile Clear Button -->
                <button type="button" 
                        x-show="query && query.length > 0"
                        @@click="clearQuery()"
                        class="absolute right-12 top-1/2 -translate-y-1/2 h-5 w-5 flex items-center justify-center text-slate-400 hover:text-charcoal rounded-full text-xs"
                        style="display: none;"
                        aria-label="Xóa từ khóa">
                    <i class="fa-solid fa-xmark text-[11px]"></i>
                </button>

                <!-- Mobile Close Drawer Button -->
                <button type="button" 
                        @@click="toggleMobileSearch()"
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 px-2 py-1 text-[11px] font-bold text-slate-500 hover:text-magenta-accent transition">
                    Đóng
                </button>
            </!form>

            <!-- Mobile Suggestions Content -->
            <div x-show="isOpen" class="max-h-[380px] overflow-y-auto space-y-3 pt-1">
                <!-- Mobile State 1: Recents & Trending when query < 2 chars -->
                <template x-if="!query || query.trim().length < 2">
                    <div class="space-y-3">
                        <!-- Recent Searches -->
                        <template x-if="recentSearches.length > 0">
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1">
                                        <i class="fa-regular fa-clock text-magenta-accent"></i>
                                        <span>Tìm kiếm gần đây</span>
                                    </span>
                                    <button type="button" @@click="clearRecentSearches()" class="text-[9px] font-semibold text-magenta-accent hover:underline">
                                        Xóa tất cả
                                    </button>
                                </div>
                                <div class="flex flex-wrap gap-1">
                                    <template x-for="(term, rIdx) in recentSearches" :key="'m-recent-' + rIdx">
                                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-[11px] font-medium cursor-pointer"
                                             @@click="selectTerm(term)">
                                            <span x-text="term"></span>
                                            <button type="button" @@click.stop="removeRecentSearch(term)" class="text-slate-400 hover:text-rose-600 p-0.5">
                                                <i class="fa-solid fa-xmark text-[9px]"></i>
                                            </button>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>

                        <!-- Trending Keywords -->
                        <div>
                            <div class="mb-1.5">
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fa-solid fa-fire text-amber-500"></i>
                                    <span>Từ khóa thịnh hành</span>
                                </span>
                            </div>
                            <div class="flex flex-wrap gap-1">
                                <template x-for="(kw, kIdx) in suggestions.hotKeywords" :key="'m-hot-' + kIdx">
                                    <button type="button" @@click="selectTerm(kw)"
                                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-rose-50 text-magenta-accent text-[11px] font-semibold">
                                        <i class="fa-solid fa-magnifying-glass text-[9px] text-magenta-accent/60"></i>
                                        <span x-text="kw"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Mobile State 2: Active Results when query >= 2 chars -->
                <template x-if="query && query.trim().length >= 2">
                    <div>
                        <!-- Loading spinner -->
                        <template x-if="isLoading">
                            <div class="py-4 text-center text-slate-400 text-xs">
                                <i class="fa-solid fa-spinner fa-spin text-magenta-accent text-base mb-1"></i>
                                <div>Đang tìm kiếm...</div>
                            </div>
                        </template>

                        <!-- Results -->
                        <template x-if="!isLoading">
                            <div class="space-y-2">
                                <!-- Brands & Categories Chips -->
                                <template x-if="(suggestions.brands && suggestions.brands.length > 0) || (suggestions.categories && suggestions.categories.length > 0)">
                                    <div class="flex items-center gap-1 flex-wrap pb-1.5 border-b border-slate-100">
                                        <template x-for="b in suggestions.brands" :key="'m-b-' + b.id">
                                            <a :href="'/tim-kiem?brand=' + encodeURIComponent(b.name)"
                                               class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold">
                                                <span x-html="highlightMatch(b.name, query)"></span>
                                            </a>
                                        </template>
                                        <template x-for="c in suggestions.categories" :key="'m-c-' + c.id">
                                            <a :href="'/tim-kiem?categorySlug=' + c.slug"
                                               class="px-2 py-0.5 rounded-full bg-rose-50 text-magenta-accent text-[10px] font-bold">
                                                <span x-html="highlightMatch(c.name, query)"></span>
                                            </a>
                                        </template>
                                    </div>
                                </template>

                                <!-- Products -->
                                <template x-if="suggestions.products && suggestions.products.length > 0">
                                    <div class="space-y-1.5 divide-y divide-slate-100/70">
                                        <template x-for="p in suggestions.products" :key="'m-p-' + p.id">
                                            <a :href="'/san-pham/' + p.slug" class="flex items-center gap-2.5 pt-1.5 group">
                                                <img :src="p.imageUrl" :alt="p.name" class="w-10 h-10 rounded-lg object-cover border border-slate-200 shrink-0" loading="lazy" />
                                                <div class="flex-1 min-w-0">
                                                    <div class="text-[9px] font-bold text-rose-gold uppercase truncate" x-text="p.brandName"></div>
                                                    <h4 class="text-xs font-bold text-slate-800 truncate" x-html="highlightMatch(p.name, query)"></h4>
                                                    <div class="text-xs font-bold text-charcoal font-mono-numeric" x-text="formatPrice(p.salePrice || p.price)"></div>
                                                </div>
                                            </a>
                                        </template>

                                        <!-- View all on mobile -->
                                        <div class="pt-2">
                                            <a :href="'/tim-kiem?q=' + encodeURIComponent(query)"
                                               @@click="saveRecentSearch(query)"
                                               class="w-full flex items-center justify-center gap-1.5 py-1.5 rounded-xl bg-pastel-rose text-magenta-accent font-bold text-xs">
                                                <span>Xem tất cả kết quả</span>
                                                <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                            </a>
                                        </div>
                                    </div>
                                </template>

                                <!-- Mobile Empty State -->
                                <template x-if="(!suggestions.products || suggestions.products.length === 0) && (!suggestions.brands || suggestions.brands.length === 0)">
                                    <div class="py-4 text-center">
                                        <p class="text-xs text-slate-500 mb-2">Không tìm thấy sản phẩm cho "<span class="font-bold" x-text="query"></span>"</p>
                                        <div class="flex flex-wrap gap-1 justify-center">
                                            <template x-for="kw in suggestions.hotKeywords.slice(0, 4)" :key="'m-empty-kw-' + kw">
                                                <button type="button" @@click="selectTerm(kw)" class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-semibold">
                                                    <span x-text="kw"></span>
                                                </button>
                                            </template>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <!-- Mega Navigation Bar (Desktop) - Extracted & Lazy Loaded Component -->
    <partial name="_MegaNav" />

</header>

<script>
    function storefrontNotificationCenter() {
        return {
            isOpen: false,
            loading: false,
            unreadCount: 0,
            notifications: [],

            init() {
                this.fetchCount();
                this.fetchLatest();

                // Nghe sự kiện SignalR từ _Layout
                window.addEventListener('storefront-notification-received', (e) => {
                    const d = e.detail;
                    this.unreadCount++;
                    this.notifications.unshift({
                        id: d.id,
                        title: d.title,
                        message: d.message,
                        severity: d.severity,
                        type: d.type || 'ORDER',
                        url: d.url,
                        timeAgo: d.timeAgo || 'Vừa xong',
                        isRead: false
                    });
                    if (this.notifications.length > 10) this.notifications.pop();
                });
            },

            toggleOpen() {
                this.isOpen = !this.isOpen;
                if (this.isOpen) {
                    this.fetchLatest();
                }
            },

            async fetchCount() {
                try {
                    const res = await fetch('/api/notifications/unread-count');
                    if (res.ok) {
                        const data = await res.json();
                        this.unreadCount = data.count || 0;
                    }
                } catch (e) { }
            },

            async fetchLatest() {
                this.loading = true;
                try {
                    const res = await fetch('/api/notifications/latest?take=10');
                    if (res.ok) {
                        const data = await res.json();
                        this.notifications = data.notifications || [];
                        this.unreadCount = data.unreadCount || 0;
                    }
                } catch (e) { }
                finally {
                    this.loading = false;
                }
            },

            async markAllAsRead() {
                try {
                    const res = await fetch('/api/notifications/mark-all-read', { method: 'POST' });
                    if (res.ok) {
                        this.unreadCount = 0;
                        this.notifications.forEach(n => n.isRead = true);
                    }
                } catch (e) { }
            },

            async handleClick(item) {
                if (!item.isRead && item.id) {
                    try {
                        await fetch(`/api/notifications/mark-read/${item.id}`, { method: 'POST' });
                        item.isRead = true;
                        if (this.unreadCount > 0) this.unreadCount--;
                    } catch (e) { }
                }
                if (item.url) {
                    window.location.href = item.url;
                }
            }
        };
    }

    function instantSearch() {
        return {
            query: '',
            isOpen: false,
            isLoading: false,
            mobileSearchOpen: false,
            suggestions: {
                query: '',
                normalizedQuery: '',
                products: [],
                brands: [],
                categories: [],
                hotKeywords: [],
                totalMatches: 0
            },
            recentSearches: [],
            selectedIndex: -1,
            flatItems: [],
            debounceTimer: null,

            init() {
                this.loadRecentSearches();
                this.fetchDefaultSuggestions();
            },

            loadRecentSearches() {
                try {
                    const stored = localStorage.getItem('omni_recent_searches');
                    if (stored) {
                        const parsed = JSON.parse(stored);
                        if (Array.isArray(parsed)) {
                            this.recentSearches = parsed.slice(0, 5);
                        }
                    }
                } catch (e) {
                    this.recentSearches = [];
                }
            },

            saveRecentSearch(term) {
                if (!term || !term.trim()) return;
                const clean = term.trim();
                this.recentSearches = [clean, ...this.recentSearches.filter(t => t.toLowerCase() !== clean.toLowerCase())].slice(0, 5);
                try {
                    localStorage.setItem('omni_recent_searches', JSON.stringify(this.recentSearches));
                } catch (e) { }
                this.updateFlatItems();
            },

            removeRecentSearch(term) {
                this.recentSearches = this.recentSearches.filter(t => t.toLowerCase() !== term.toLowerCase());
                try {
                    localStorage.setItem('omni_recent_searches', JSON.stringify(this.recentSearches));
                } catch (e) { }
                this.updateFlatItems();
            },

            clearRecentSearches() {
                this.recentSearches = [];
                try {
                    localStorage.removeItem('omni_recent_searches');
                } catch (e) { }
                this.updateFlatItems();
            },

            onFocus() {
                this.isOpen = true;
                this.selectedIndex = -1;
                if (!this.query || this.query.trim().length < 2) {
                    if (!this.suggestions.hotKeywords || this.suggestions.hotKeywords.length === 0) {
                        this.fetchDefaultSuggestions();
                    } else {
                        this.updateFlatItems();
                    }
                } else {
                    this.updateFlatItems();
                }
            },

            onInput() {
                if (this.debounceTimer) clearTimeout(this.debounceTimer);
                this.selectedIndex = -1;
                const q = this.query ? this.query.trim() : '';

                if (q.length < 2) {
                    this.isLoading = false;
                    this.isOpen = true;
                    this.fetchDefaultSuggestions();
                    return;
                }

                this.isOpen = true;
                this.isLoading = true;
                this.debounceTimer = setTimeout(() => {
                    this.fetchSuggestions(q);
                }, 250);
            },

            async fetchSuggestions(q) {
                try {
                    const res = await fetch('/api/search/suggest?q=' + encodeURIComponent(q));
                    if (res.ok) {
                        const data = await res.json();
                        this.suggestions = data;
                        this.updateFlatItems();
                    }
                } catch (e) {
                    console.error('Lỗi tìm kiếm gợi ý:', e);
                } finally {
                    this.isLoading = false;
                }
            },

            async fetchDefaultSuggestions() {
                try {
                    const res = await fetch('/api/search/suggest?q=');
                    if (res.ok) {
                        const data = await res.json();
                        this.suggestions = data;
                        this.updateFlatItems();
                    }
                } catch (e) { }
            },

            selectTerm(term) {
                this.query = term;
                this.saveRecentSearch(term);
                window.location.href = '/tim-kiem?q=' + encodeURIComponent(term);
            },

            clearQuery() {
                this.query = '';
                this.selectedIndex = -1;
                this.fetchDefaultSuggestions();
                this.isOpen = true;
                if (this.$refs.searchInput) this.$refs.searchInput.focus();
            },

            close() {
                this.isOpen = false;
                this.selectedIndex = -1;
            },

            toggleMobileSearch() {
                this.mobileSearchOpen = !this.mobileSearchOpen;
                if (this.mobileSearchOpen) {
                    this.isOpen = true;
                    this.$nextTick(() => {
                        if (this.$refs.mobileSearchInput) this.$refs.mobileSearchInput.focus();
                    });
                } else {
                    this.isOpen = false;
                }
            },

            updateFlatItems() {
                const items = [];
                const q = this.query ? this.query.trim() : '';

                if (q.length >= 2) {
                    if (this.suggestions.brands && Array.isArray(this.suggestions.brands)) {
                        this.suggestions.brands.forEach(b => {
                            items.push({ type: 'brand', url: '/tim-kiem?brand=' + encodeURIComponent(b.name), title: b.name, id: b.name });
                        });
                    }
                    if (this.suggestions.categories && Array.isArray(this.suggestions.categories)) {
                        this.suggestions.categories.forEach(c => {
                            items.push({ type: 'category', url: '/tim-kiem?categorySlug=' + encodeURIComponent(c.slug), title: c.name, id: c.slug });
                        });
                    }
                    if (this.suggestions.products && Array.isArray(this.suggestions.products)) {
                        this.suggestions.products.forEach(p => {
                            items.push({ type: 'product', url: '/san-pham/' + p.slug, title: p.name, id: p.name });
                        });
                    }
                    if (items.length > 0) {
                        items.push({ type: 'view_all', url: '/tim-kiem?q=' + encodeURIComponent(q), title: 'Xem tất cả kết quả', id: q });
                    }
                } else {
                    if (this.recentSearches && Array.isArray(this.recentSearches)) {
                        this.recentSearches.forEach(term => {
                            items.push({ type: 'recent', url: '/tim-kiem?q=' + encodeURIComponent(term), title: term, id: term });
                        });
                    }
                    if (this.suggestions.hotKeywords && Array.isArray(this.suggestions.hotKeywords)) {
                        this.suggestions.hotKeywords.forEach(kw => {
                            items.push({ type: 'keyword', url: '/tim-kiem?q=' + encodeURIComponent(kw), title: kw, id: kw });
                        });
                    }
                }
                this.flatItems = items;
            },

            isItemActive(type, id) {
                if (this.selectedIndex < 0 || this.selectedIndex >= this.flatItems.length) return false;
                const current = this.flatItems[this.selectedIndex];
                return current.type === type && current.id === id;
            },

            selectNext() {
                if (!this.isOpen) {
                    this.isOpen = true;
                    return;
                }
                if (this.flatItems.length === 0) return;
                this.selectedIndex = (this.selectedIndex + 1) % this.flatItems.length;
            },

            selectPrev() {
                if (!this.isOpen) {
                    this.isOpen = true;
                    return;
                }
                if (this.flatItems.length === 0) return;
                this.selectedIndex = (this.selectedIndex - 1 + this.flatItems.length) % this.flatItems.length;
            },

            handleEnter(event) {
                if (this.selectedIndex >= 0 && this.selectedIndex < this.flatItems.length) {
                    event.preventDefault();
                    const item = this.flatItems[this.selectedIndex];
                    this.saveRecentSearch(item.title);
                    window.location.href = item.url;
                } else if (this.query && this.query.trim().length > 0) {
                    this.saveRecentSearch(this.query.trim());
                }
            },

            handleSubmit(event) {
                if (this.selectedIndex >= 0 && this.selectedIndex < this.flatItems.length) {
                    event.preventDefault();
                    const item = this.flatItems[this.selectedIndex];
                    this.saveRecentSearch(item.title);
                    window.location.href = item.url;
                } else if (this.query && this.query.trim().length > 0) {
                    this.saveRecentSearch(this.query.trim());
                }
            },

            formatPrice(val) {
                if (!val) return '0 ₫';
                return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
            },

            escapeHtml(str) {
                if (!str) return '';
                return String(str).replace(/[&<>"']/g, function(m) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
                });
            },

            highlightMatch(text, query) {
                if (!text) return '';
                const safe = this.escapeHtml(text);
                if (!query || !query.trim()) return safe;

                try {
                    const qClean = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    const regex = new RegExp(`(${qClean})`, 'gi');
                    return safe.replace(regex, '<mark class="bg-pink-100 text-magenta-accent font-bold px-0.5 rounded">$1</mark>');
                } catch (e) {
                    return safe;
                }
            }
        };
    }
</script>
