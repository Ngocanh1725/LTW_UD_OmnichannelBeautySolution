<script>
    function storefrontNotificationCenter() {
        return {
            isOpen: false,
            loading: false,
            unreadCount: 0,
            notifications: [],

            init() {
                this.fetchCount();
                this.fetchLatest();

                // Nghe sự kiện SignalR từ _Layout
                window.addEventListener('storefront-notification-received', (e) => {
                    const d = e.detail;
                    this.unreadCount++;
                    this.notifications.unshift({
                        id: d.id,
                        title: d.title,
                        message: d.message,
                        severity: d.severity,
                        type: d.type || 'ORDER',
                        url: d.url,
                        timeAgo: d.timeAgo || 'Vừa xong',
                        isRead: false
                    });
                    if (this.notifications.length > 10) this.notifications.pop();
                });
            },

            toggleOpen() {
                this.isOpen = !this.isOpen;
                if (this.isOpen) {
                    this.fetchLatest();
                }
            },

            async fetchCount() {
                try {
                    const res = await fetch('/api/notifications/unread-count');
                    if (res.ok) {
                        const data = await res.json();
                        this.unreadCount = data.count || 0;
                    }
                } catch (e) { }
            },

            async fetchLatest() {
                this.loading = true;
                try {
                    const res = await fetch('/api/notifications/latest?take=10');
                    if (res.ok) {
                        const data = await res.json();
                        this.notifications = data.notifications || [];
                        this.unreadCount = data.unreadCount || 0;
                    }
                } catch (e) { }
                finally {
                    this.loading = false;
                }
            },

            async markAllAsRead() {
                try {
                    const res = await fetch('/api/notifications/mark-all-read', { method: 'POST' });
                    if (res.ok) {
                        this.unreadCount = 0;
                        this.notifications.forEach(n => n.isRead = true);
                    }
                } catch (e) { }
            },

            async handleClick(item) {
                if (!item.isRead && item.id) {
                    try {
                        await fetch(`/api/notifications/mark-read/${item.id}`, { method: 'POST' });
                        item.isRead = true;
                        if (this.unreadCount > 0) this.unreadCount--;
                    } catch (e) { }
                }
                if (item.url) {
                    window.location.href = item.url;
                }
            }
        };
    }
</script>
