@*
    Omnichannel Beauty Solution - Luxury QuickView Modal Component (Tối ưu hóa Main Thread)
    - Chỉ nạp DOM khi người dùng bấm 'Xem Nhanh' (x-if thay vì x-show đơn thuần)
    - Giữ Main Thread tinh gọn 100%, không reflow cây DOM ẩn khi cuộn trang
    - Tăng tốc phần cứng GPU với will-change: transform, opacity
*@
<template x-if="quickViewOpen">
    <div class="relative z-50" 
         aria-labelledby="modal-quickview-title" 
         role="dialog" 
         aria-modal="true"
         @@keydown.escape.window="quickViewOpen = false">

        <!-- Backdrop mờ sương (Backdrop Blur) -->
        <div x-transition:enter="ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-charcoal/70 backdrop-blur-md transition-opacity will-change-opacity" 
             @@click="quickViewOpen = false"></div>

        <!-- Modal Dialog Outer Wrapper -->
        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-3 text-center sm:items-center sm:p-4">
                
                <div x-transition:enter="ease-out duration-300" 
                     x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                     x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave="ease-in duration-200" 
                     x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" 
                     x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                     class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-4xl border border-soft-border will-change-transform">
                    
                    <!-- Close Button -->
                    <button type="button" 
                            @@click="quickViewOpen = false" 
                            class="absolute right-4 top-4 z-30 h-10 w-10 rounded-full bg-white/90 backdrop-blur text-slate-400 hover:text-charcoal hover:bg-white shadow-md flex items-center justify-center transition hover:scale-110 cursor-pointer"
                            aria-label="Đóng cửa sổ xem nhanh">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                    
                    <!-- Dynamic Content Container -->
                    <div id="quickViewModalBody" class="min-h-[460px]">
                        <!-- Skeleton Loader State -->
                        <div class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[460px] space-y-4 text-center">
                            <div class="w-14 h-14 rounded-full border-4 border-pink-100 border-t-magenta-accent animate-spin flex items-center justify-center"></div>
                            <div class="text-xs font-bold text-charcoal uppercase tracking-widest animate-pulse">Đang tải thông tin sản phẩm...</div>
                            <div class="text-[11px] text-slate-400">Kiểm tra lô hàng FEFO & tồn kho showroom...</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</template>

<script>
    // QuickView Modal is driven globally by site.js (window.openQuickView & window.closeQuickView)
</script>
