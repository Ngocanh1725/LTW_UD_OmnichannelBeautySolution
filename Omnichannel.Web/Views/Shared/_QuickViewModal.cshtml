@*
    Omnichannel Beauty Solution - Luxury QuickView Modal Component
    Tối ưu trải nghiệm xem nhanh sản phẩm không rời trang
*@
<div x-show="quickViewOpen" 
     style="display: none;" 
     class="relative z-50" 
     aria-labelledby="modal-quickview-title" 
     role="dialog" 
     aria-modal="true"
     @@keydown.escape.window="quickViewOpen = false">

    <!-- Backdrop mờ sương (Backdrop Blur) -->
    <div x-show="quickViewOpen" 
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-charcoal/70 backdrop-blur-md transition-opacity" 
         @@click="quickViewOpen = false"></div>

    <!-- Modal Dialog Outer Wrapper -->
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-3 text-center sm:items-center sm:p-4">
            
            <div x-show="quickViewOpen" 
                 x-transition:enter="ease-out duration-300" 
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100" 
                 x-transition:leave="ease-in duration-200" 
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" 
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" 
                 class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-4xl border border-soft-border">
                
                <!-- Close Button -->
                <button type="button" 
                        @@click="quickViewOpen = false" 
                        class="absolute right-4 top-4 z-30 h-10 w-10 rounded-full bg-white/90 backdrop-blur text-slate-400 hover:text-charcoal hover:bg-white shadow-md flex items-center justify-center transition hover:scale-110"
                        aria-label="Đóng cửa sổ xem nhanh">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                
                <!-- Dynamic Content Container -->
                <div id="quickViewModalBody" class="min-h-[460px]">
                    <!-- Skeleton Loader State -->
                    <div class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[460px] space-y-4 text-center">
                        <div class="w-14 h-14 rounded-full border-4 border-pink-100 border-t-magenta-accent animate-spin flex items-center justify-center"></div>
                        <div class="text-xs font-bold text-charcoal uppercase tracking-widest animate-pulse">Đang tải thông tin sản phẩm...</div>
                        <div class="text-[11px] text-slate-400">Kiểm tra lô hàng FEFO & tồn kho showroom...</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // Global QuickView Opener Handler
    window.openQuickView = async function(productId) {
        if (!productId) return;

        // 1. Mở Modal Alpine
        try {
            const bodyEl = document.querySelector('body');
            if (bodyEl && bodyEl.__x && bodyEl.__x.$data) {
                bodyEl.__x.$data.quickViewOpen = true;
            } else if (window.Alpine) {
                // Fallback nếu modal có context riêng
                window.dispatchEvent(new CustomEvent('open-quickview-modal', { detail: { productId: productId } }));
            }
        } catch (e) { }

        // 2. Hiển thị Loading Placeholder
        const container = document.getElementById('quickViewModalBody');
        if (container) {
            container.innerHTML = `
                <div class="p-8 sm:p-12 flex flex-col items-center justify-center min-h-[460px] space-y-4 text-center">
                    <div class="w-12 h-12 rounded-full border-4 border-pink-100 border-t-magenta-accent animate-spin flex items-center justify-center"></div>
                    <div class="text-xs font-bold text-charcoal uppercase tracking-widest animate-pulse">Đang tải thông tin sản phẩm...</div>
                    <div class="text-[11px] text-slate-400">Đồng bộ hạn sử dụng FEFO & tồn kho...</div>
                </div>
            `;
        }

        // 3. Fetch dữ liệu HTML từ Controller
        try {
            const response = await fetch(`/Product/QuickView/${productId}`);
            if (!response.ok) throw new Error('Không thể tải thông tin sản phẩm');
            const html = await response.text();
            if (container) {
                container.innerHTML = html;
                if (window.Alpine) {
                    window.Alpine.initTree(container);
                }
            }
        } catch (err) {
            console.warn('[QuickView] Lỗi tải dữ liệu:', err);
            if (container) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-500 flex flex-col items-center justify-center min-h-[350px]">
                        <i class="fa-solid fa-circle-exclamation text-3xl text-rose-500 mb-2"></i>
                        <p class="text-sm font-semibold text-charcoal">Không thể nạp thông tin xem nhanh.</p>
                        <p class="text-xs text-slate-400 mt-1">Vui lòng bấm vào nút bên dưới để xem trực tiếp trang sản phẩm.</p>
                        <a href="/Product/Detail/${productId}" class="mt-4 px-6 py-2.5 rounded-full bg-magenta-accent text-white text-xs font-bold hover:bg-[#b0276a] transition shadow-md">
                            Xem Chi Tiết Sản Phẩm
                        </a>
                    </div>
                `;
            }
        }
    };
</script>
