@model Omnichannel.Domain.Entities.Product

@{
    if (Model == null) return;

    // Chuẩn hóa đường dẫn chi tiết sản phẩm: Ưu tiên slug, nếu rỗng fallback về /Product/Detail/{Id}
    var productUrl = !string.IsNullOrEmpty(Model.Slug) 
        ? $"/san-pham/{Model.Slug}" 
        : $"/Product/Detail/{Model.Id}";

    // Phân giải đường dẫn ảnh chuẩn, bản WebP và Alt Text tiếng Việt chuẩn SEO qua IProductImageResolver duy nhất
    var imageUrl = ProductImageResolver.GetPrimaryImageUrl(Model.ThumbnailUrl, Model.Sku, Model.Slug, Model.Name);
    var webpUrl = ProductImageResolver.GetWebpImageUrl(imageUrl, Model.Sku, Model.Slug, Model.Name);
    var altText = ProductImageResolver.GetAltText(Model.Name, Model.Brand?.Name, Model.Category?.Name, Model.Sku, Model.Slug);

    // Lấy lô hạn dùng FEFO gần nhất còn hàng
    var bestBatch = Model.Batches?.Where(b => b.CurrentQuantity > 0).OrderBy(b => b.ExpDate).FirstOrDefault()
        ?? Model.Batches?.OrderBy(b => b.ExpDate).FirstOrDefault();
    var daysLeft = bestBatch != null ? Math.Max(0, (bestBatch.ExpDate - DateTime.UtcNow).Days) : 720;
    var firstVariant = Model.Variants?.FirstOrDefault();

    var originalPrice = Model.SellingPrice;
    var hasDiscount = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < originalPrice;
    var finalPrice = hasDiscount && Model.DiscountPrice.HasValue ? Model.DiscountPrice.Value : originalPrice;

    // Tự động tính giá xả kho cận date FEFO nếu lô có chiết khấu hoặc <180 ngày
    if (bestBatch != null)
    {
        if (bestBatch.ClearanceDiscountPercent.HasValue && bestBatch.ClearanceDiscountPercent.Value > 0)
        {
            var clDisc = bestBatch.ClearanceDiscountPercent.Value;
            var clPrice = Math.Round(originalPrice * (1m - (clDisc / 100m)));
            if (clPrice < finalPrice)
            {
                finalPrice = clPrice;
                hasDiscount = true;
            }
        }
        else if (daysLeft < 180 && !hasDiscount && originalPrice > 0)
        {
            finalPrice = Math.Round(originalPrice * 0.6m);
            hasDiscount = true;
        }
    }

    var discountPercent = hasDiscount && originalPrice > 0 
        ? (int)Math.Round((1 - (finalPrice / originalPrice)) * 100) 
        : 0;

    // Chuẩn hóa nhãn hạn dùng FEFO:
    // - Xanh: Chuẩn date > 18 tháng (> 540 ngày)
    // - Cam: Date ổn định 6 - 12 (hoặc 18) tháng (180 - 540 ngày)
    // - Đỏ: Cận date < 6 tháng (< 180 ngày)
    string fefoBadgeClass;
    string fefoText;
    string fefoIcon;

    if (bestBatch != null)
    {
        if (daysLeft < 180)
        {
            fefoBadgeClass = "bg-rose-500/15 border-rose-500/40 text-rose-600";
            fefoText = $"Cận date • HSD {bestBatch.ExpDate:MM/yyyy}";
            fefoIcon = "fa-solid fa-triangle-exclamation text-rose-500";
        }
        else if (daysLeft <= 540)
        {
            fefoBadgeClass = "bg-amber-400/15 border-amber-400/40 text-amber-600";
            fefoText = $"HSD {bestBatch.ExpDate:MM/yyyy}";
            fefoIcon = "fa-solid fa-clock text-amber-500";
        }
        else
        {
            fefoBadgeClass = "bg-emerald-500/15 border-emerald-500/40 text-emerald-600";
            fefoText = $"Chuẩn date • HSD {bestBatch.ExpDate:MM/yyyy}";
            fefoIcon = "fa-solid fa-circle-check text-emerald-500";
        }
    }
    else
    {
        fefoBadgeClass = "bg-emerald-500/15 border-emerald-500/40 text-emerald-600";
        fefoText = "Date mới 100%";
        fefoIcon = "fa-solid fa-shield-check text-emerald-500";
    }

    var brandOrCategory = !string.IsNullOrEmpty(Model.Brand?.Name) 
        ? Model.Brand.Name 
        : (Model.Supplier?.Name ?? Model.Category?.Name ?? "Dược Mỹ Phẩm");
}

<!-- THẺ SẢN PHẨM CHUẨN HÓA DÙNG CHUNG TOÀN HỆ THỐNG -->
<article class="product-card-luxury group bg-white rounded-3xl border border-soft-border/80 shadow-xs hover:shadow-xl hover:border-pink-300 transition-all duration-300 flex flex-col justify-between overflow-hidden cursor-pointer" 
         data-product-url="@productUrl" 
         itemscope itemtype="https://schema.org/Product">

    <!-- 1. THUMBNAIL CONTAINER -->
    <div class="product-thumb-container relative aspect-square overflow-hidden bg-slate-50 flex items-center justify-center p-3" style="aspect-ratio: 1/1;">
        <!-- Ảnh bọc trong thẻ <a> đến trang chi tiết -->
        <a href="@productUrl" class="block w-full h-full relative z-10" title="@altText">
            <picture class="block w-full h-full">
                <source srcset="@webpUrl" type="image/webp" />
                <img src="@imageUrl" 
                     alt="@altText" 
                     width="400" 
                     height="400" 
                     decoding="async" 
                     onerror="this.onerror=null;if(this.parentElement&&this.parentElement.tagName==='PICTURE'){this.parentElement.querySelectorAll('source').forEach(function(s){s.remove();});}this.src='@ProductImageResolver.PlaceholderUrl';" 
                     class="product-thumb-img w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 will-change-transform" 
                     itemprop="image" />
            </picture>
        </a>

        <!-- Badges Stack (Sale, Hot, FEFO) -->
        <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 items-start pointer-events-none z-20">
            @if (hasDiscount)
            {
                <span class="px-2 py-0.5 rounded-full bg-rose-600 text-white text-[10px] font-bold tracking-wider shadow-sm flex items-center gap-1">
                    <i class="fa-solid fa-bolt text-[9px] text-amber-300"></i>
                    <span>-@discountPercent%</span>
                </span>
            }
            @if (Model.IsFeatured)
            {
                <span class="px-2 py-0.5 rounded-full bg-amber-500 text-white text-[10px] font-bold tracking-wider shadow-sm flex items-center gap-1">
                    <i class="fa-solid fa-crown text-[8px]"></i> HOT
                </span>
            }
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold shadow-2xs border @fefoBadgeClass backdrop-blur-xs">
                <i class="@fefoIcon text-[8px]"></i>
                <span>@fefoText</span>
            </span>
        </div>

        <!-- Nút So Sánh Nhanh góc trên phải ảnh (GAP-03: Phiên C3) -->
        <button type="button"
                data-action="compare-badge"
                data-product-id="@Model.Id"
                onclick="event.stopPropagation(); event.preventDefault(); window.omniCompare && window.omniCompare.toggle(@Model.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', @Model.CategoryId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Category?.Name ?? ""))')"
                class="absolute top-2.5 right-2.5 z-25 w-7 h-7 rounded-full bg-white/90 hover:bg-magenta-accent hover:text-white text-slate-500 flex items-center justify-center shadow-xs transition active:scale-95 cursor-pointer border border-slate-100"
                title="So sánh mỹ phẩm"
                aria-label="So sánh">
            <i class="fa-solid fa-scale-balanced text-[11px]"></i>
        </button>

        <!-- 2. ACTION OVERLAY: Nút Thêm Giỏ Hàng & Xem Nhanh (Desktop Hover) -->
        <div class="product-action-overlay z-30">
            <button type="button" 
                    data-action="add-to-cart"
                    data-product-id="@Model.Id"
                    data-variant-id="@(firstVariant?.Id)"
                    data-batch-id="@(bestBatch?.Id)"
                    data-title="@Model.Name"
                    data-price="@finalPrice"
                    data-image="@imageUrl"
                    onclick="event.stopPropagation(); event.preventDefault(); addToCart(@Model.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', @finalPrice, '@imageUrl', 1, @(bestBatch?.Id ?? 0), @(firstVariant?.Id ?? 0))"
                    class="btn-card-action btn-cart-primary active:scale-95 transition-transform cursor-pointer"
                    aria-label="Thêm vào giỏ hàng">
                <i class="fa-solid fa-cart-shopping text-xs"></i>
                <span>Thêm Giỏ Hàng</span>
            </button>
            <button type="button" 
                    data-action="compare"
                    data-product-id="@Model.Id"
                    onclick="event.stopPropagation(); event.preventDefault(); window.omniCompare && window.omniCompare.toggle(@Model.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', @Model.CategoryId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Category?.Name ?? ""))')"
                    class="btn-card-action active:scale-95 transition-transform cursor-pointer" 
                    title="So sánh mỹ phẩm"
                    aria-label="So sánh">
                <i class="fa-solid fa-scale-balanced text-xs"></i>
            </button>
            <button type="button" 
                    data-action="quick-view"
                    data-product-id="@Model.Id"
                    onclick="event.stopPropagation(); event.preventDefault(); openQuickView(@Model.Id)"
                    class="btn-card-action active:scale-95 transition-transform cursor-pointer" 
                    title="Xem nhanh chi tiết"
                    aria-label="Xem nhanh">
                <i class="fa-solid fa-eye text-xs"></i>
            </button>
        </div>
    </div>

    <!-- 3. BODY INFORMATION -->
    <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
        <div>
            <!-- Brand / Category & Đánh giá sao -->
            <div class="flex items-center justify-between mb-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-rose-gold truncate max-w-[150px]">
                    @brandOrCategory
                </span>
                <div class="flex text-amber-400 text-[10px]" title="Đánh giá 5 sao">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>
            </div>

            <!-- Tên sản phẩm bọc trong thẻ <a> -->
            <h3 class="font-bold text-xs sm:text-sm text-slate-800 line-clamp-2 leading-snug group-hover:text-magenta-accent transition-colors" itemprop="name">
                <a href="@productUrl">@Model.Name</a>
            </h3>
        </div>

        <!-- 4. PRICE & ACTION BUTTONS -->
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
            <div>
                <div class="text-sm sm:text-base font-bold text-charcoal font-mono" itemprop="price">
                    @finalPrice.ToString("N0") ₫
                </div>
                @if (hasDiscount)
                {
                    <div class="text-[10px] text-slate-400 line-through font-mono">
                        @originalPrice.ToString("N0") ₫
                    </div>
                }
            </div>
            
            <!-- Nút hành động nhanh (tối ưu tiện dụng trên Mobile & Desktop) -->
            <div class="flex items-center gap-1.5">
                <button type="button" 
                        data-action="compare"
                        data-product-id="@Model.Id"
                        onclick="event.stopPropagation(); event.preventDefault(); window.omniCompare && window.omniCompare.toggle(@Model.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', @Model.CategoryId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Category?.Name ?? ""))')"
                        class="h-8 w-8 rounded-xl bg-slate-100 text-slate-600 hover:bg-magenta-accent hover:text-white flex items-center justify-center transition shadow-2xs active:scale-95 cursor-pointer"
                        title="Thêm vào so sánh mỹ phẩm"
                        aria-label="So sánh">
                    <i class="fa-solid fa-scale-balanced text-xs"></i>
                </button>
                <button type="button" 
                        data-action="quick-view"
                        data-product-id="@Model.Id"
                        onclick="event.stopPropagation(); event.preventDefault(); openQuickView(@Model.Id)"
                        class="h-8 w-8 rounded-xl bg-slate-100 text-slate-600 hover:bg-magenta-accent hover:text-white flex items-center justify-center transition shadow-2xs active:scale-95 cursor-pointer"
                        title="Xem nhanh chi tiết"
                        aria-label="Xem nhanh">
                    <i class="fa-solid fa-eye text-xs"></i>
                </button>
                <button type="button" 
                        data-action="add-to-cart"
                        data-product-id="@Model.Id"
                        data-variant-id="@(firstVariant?.Id)"
                        data-batch-id="@(bestBatch?.Id)"
                        data-title="@Model.Name"
                        data-price="@finalPrice"
                        data-image="@imageUrl"
                        onclick="event.stopPropagation(); event.preventDefault(); addToCart(@Model.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Name))', @finalPrice, '@imageUrl', 1, @(bestBatch?.Id ?? 0), @(firstVariant?.Id ?? 0))" 
                        class="h-8 w-8 rounded-xl bg-magenta-accent text-white hover:bg-rose-700 flex items-center justify-center transition shadow-xs active:scale-95 cursor-pointer" 
                        title="Thêm vào giỏ hàng"
                        aria-label="Thêm vào giỏ hàng">
                    <i class="fa-solid fa-cart-shopping text-xs"></i>
                </button>
            </div>
        </div>
    </div>
</article>
