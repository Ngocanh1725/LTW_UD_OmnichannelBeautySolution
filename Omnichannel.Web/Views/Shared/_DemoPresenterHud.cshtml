    // 1-Click Reset Demo Data
    async function resetDemoData1Click() {
        if (!confirm('Bạn có chắc chắn muốn khôi phục toàn bộ CSDL về trạng thái chuẩn trong 2 giây?')) {
            return;
        }
        try {
            const res = await fetch('/api/demo/reset-data', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert('Khôi phục dữ liệu Demo thành công! ' + (data.message || ''));
                window.location.reload();
            } else {
                alert(data.message || 'Có lỗi khi khôi phục.');
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối khi gửi yêu cầu reset.');
        }
    }
</script>

