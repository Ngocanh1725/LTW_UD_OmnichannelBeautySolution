<script>
    // Presenter HUD Global State & Timer Controller
    let hudTimerInterval = null;
    let hudRemainingSeconds = 600; // 10 minutes = 600 seconds
    let isHudTimerRunning = false;

    function toggleDemoPresenterHud() {
        const drawer = document.getElementById('demoPresenterHudDrawer');
        if (drawer) {
            drawer.classList.toggle('is-open');
        }
    }

    // Keyboard Shortcut Alt + D (or Option + D on Mac)
    document.addEventListener('keydown', function (e) {
        if (e.altKey && (e.key === 'd' || e.key === 'D' || e.keyCode === 68)) {
            e.preventDefault();
            toggleDemoPresenterHud();
        }
    });

    function updateHudTimerDisplay() {
        const minutes = Math.floor(hudRemainingSeconds / 60);
        const seconds = hudRemainingSeconds % 60;
        const displayStr = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        
        const displayEl = document.getElementById('hudTimerDisplay');
        const progressEl = document.getElementById('hudTimerProgressBar');
        
        if (displayEl) {
            displayEl.textContent = displayStr;
            if (hudRemainingSeconds <= 120) {
                displayEl.className = "font-mono text-xl sm:text-2xl font-extrabold text-rose-400 animate-pulse tracking-wider";
                if (progressEl) progressEl.className = "h-full bg-gradient-to-r from-rose-500 to-red-600 transition-all duration-1000";
            } else if (hudRemainingSeconds <= 300) {
                displayEl.className = "font-mono text-xl sm:text-2xl font-extrabold text-amber-400 tracking-wider";
                if (progressEl) progressEl.className = "h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-1000";
            } else {
                displayEl.className = "font-mono text-xl sm:text-2xl font-extrabold text-emerald-400 tracking-wider";
                if (progressEl) progressEl.className = "h-full bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-400 transition-all duration-1000";
            }
        }

        if (progressEl) {
            const pct = Math.max(0, (hudRemainingSeconds / 600) * 100);
            progressEl.style.width = pct + '%';
        }
    }

    function toggleHudTimer() {
        const playIcon = document.getElementById('hudTimerPlayIcon');
        if (isHudTimerRunning) {
            clearInterval(hudTimerInterval);
            isHudTimerRunning = false;
            if (playIcon) playIcon.className = "fa-solid fa-play";
        } else {
            isHudTimerRunning = true;
            if (playIcon) playIcon.className = "fa-solid fa-pause";
            hudTimerInterval = setInterval(() => {
                if (hudRemainingSeconds > 0) {
                    hudRemainingSeconds--;
                    updateHudTimerDisplay();
                } else {
                    clearInterval(hudTimerInterval);
                    isHudTimerRunning = false;
                    if (playIcon) playIcon.className = "fa-solid fa-play";
                    alert("⏰ ĐÃ HẾT 10 PHÚT THUYẾT TRÌNH! Vui lòng chuyển sang phần Hỏi - Đáp với Hội đồng.");
                }
            }, 1000);
        }
    }

    function resetHudTimer() {
        clearInterval(hudTimerInterval);
        isHudTimerRunning = false;
        hudRemainingSeconds = 600;
        const playIcon = document.getElementById('hudTimerPlayIcon');
        if (playIcon) playIcon.className = "fa-solid fa-play";
        updateHudTimerDisplay();
    }

    // Toggle Stage Completion Checkbox (persisted in localStorage)
    function toggleStageCompletion(stageNum) {
        const checkbox = document.getElementById(`stageCheck${stageNum}`);
        const card = document.getElementById(`stageCard${stageNum}`);
        if (checkbox && card) {
            if (checkbox.checked) {
                card.classList.add('is-completed');
                localStorage.setItem(`omni_demo_stage_${stageNum}`, 'true');
            } else {
                card.classList.remove('is-completed');
                localStorage.removeItem(`omni_demo_stage_${stageNum}`);
            }
        }
    }

    // Initialize checkboxes from localStorage
    document.addEventListener('DOMContentLoaded', function () {
        for (let i = 1; i <= 6; i++) {
            const isDone = localStorage.getItem(`omni_demo_stage_${i}`) === 'true';
            const checkbox = document.getElementById(`stageCheck${i}`);
            const card = document.getElementById(`stageCard${i}`);
            if (checkbox && card && isDone) {
                checkbox.checked = true;
                card.classList.add('is-completed');
            }
        }
    });

    // 1-Click Quick Switch Persona API
    async function quickSwitchPersona(role) {
        try {
            const res = await fetch('/api/demo/quick-switch-persona', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ persona: role })
            });
            const data = await res.json();
            if (data.success) {
                if (window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Chuyển Đổi Persona Thành Công! 🎭',
                        text: `Đã đăng nhập vai trò: ${data.displayName} (${data.persona.toUpperCase()})`,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = data.redirectUrl || window.location.href;
                    });
                } else {
                    alert(`Đã chuyển sang vai trò: ${data.displayName}`);
                    window.location.href = data.redirectUrl || window.location.href;
                }
            } else {
                alert(data.message || 'Lỗi khi chuyển đổi vai trò.');
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối khi gửi yêu cầu chuyển đổi.');
        }
    }

    // Nạp giỏ hàng combo Routine 3 bước
    async function seedCartRoutine(btn) {
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        try {
            const res = await fetch('/api/demo/seed-cart-routine', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert(data.message || 'Đã nạp combo Routine 3 bước vào giỏ hàng!');
                window.location.href = data.cartUrl || '/cart';
            } else {
                alert(data.message || 'Có lỗi xảy ra.');
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        } catch (e) {
            console.error(e);
            alert('Lỗi kết nối.');
            btn.disabled = false;
            btn.innerHTML = orig;
        }
    }

