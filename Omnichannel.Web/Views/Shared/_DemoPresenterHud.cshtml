@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    bool isDemoMode = string.Equals(Configuration["DemoMode:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
    if (!isDemoMode)
    {
        return; // Tuyệt đối không render bất kỳ mã HTML nào khi DemoMode:Enabled = false
    }
}

<style>
    /* Demo Presenter HUD Styles */
    #demoPresenterHudDrawer {
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
        transform: translateY(120%);
        opacity: 0;
        pointer-events: none;
    }
    #demoPresenterHudDrawer.is-open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }
    .hud-backdrop {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(8px);
    }
    .hud-glass-card {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.98) 100%);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(244, 63, 94, 0.25);
    }
    .stage-item {
        transition: all 0.2s ease;
    }
    .stage-item.is-completed {
        opacity: 0.65;
        border-color: rgba(52, 211, 153, 0.4);
    }
    .stage-item:hover {
        opacity: 1;
        transform: translateY(-1px);
    }
</style>

