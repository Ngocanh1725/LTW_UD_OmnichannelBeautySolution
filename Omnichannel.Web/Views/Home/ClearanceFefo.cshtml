@model List<Omnichannel.Domain.Entities.ProductBatch>
@{
    ViewData["Title"] = "FEFO Smart Clearance - Xả Kho Cận Date Minh Bạch | CANMAKE BEAUTY";
    ViewData["Description"] = "Chương trình xả kho mỹ phẩm cận date thông minh chuẩn FEFO. Giảm giá tới 70% với hạn dùng và số lô được công khai minh bạch 100%.";
    var now = DateTime.UtcNow;
}

<div class="bg-slate-50 min-h-screen pb-16">
    <!-- HERO HEADER BANNER -->
    <div class="bg-gradient-to-r from-rose-900 via-red-800 to-amber-900 text-white py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden shadow-lg">
        <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/30 text-rose-200 text-xs font-semibold uppercase tracking-wider mb-3 border border-rose-400/30">
                        <i class="fa-solid fa-bolt text-amber-300 animate-pulse"></i> Tiêu Chuẩn FEFO Độc Quyền
                    </div>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
                        FEFO Smart Clearance <span class="text-amber-400">Flash Sale</span>
                    </h1>
                    <p class="mt-3 text-base sm:text-lg text-rose-100 max-w-2xl leading-relaxed">
                        Mua sắm thông minh, tiết kiệm tối đa! Công khai minh bạch số lô, ngày sản xuất và hạn dùng (HSD) đến từng sản phẩm. Giảm sốc tới <strong>70%</strong>.
                    </p>
                    <div class="mt-6 flex flex-wrap gap-4 text-xs sm:text-sm text-rose-200">
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-emerald-400"></i> 100% Chính Hãng</span>
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-calendar-check text-amber-400"></i> Date Rõ Ràng Từng Lô</span>
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-truck-fast text-sky-400"></i> Giao Hỏa Tốc 2H</span>
                    </div>
                </div>

                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 text-center min-w-[280px]">
                    <div class="text-xs uppercase text-rose-200 tracking-wider font-semibold mb-2">Số Lô Cận Date Đang Mở Bán</div>
                    <div class="text-4xl font-extrabold text-amber-300 font-mono">@(Model?.Count ?? 0)</div>
                    <div class="text-xs text-rose-200 mt-1">Lô mỹ phẩm chuẩn FEFO</div>
                    <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-center gap-2 text-xs text-rose-100">
                        <i class="fa-solid fa-clock"></i> Cập nhật theo thời gian thực
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        @if (Model == null || !Model.Any())
        {
            <div class="bg-white rounded-2xl p-12 text-center shadow-sm border border-slate-200/80">
                <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                    <i class="fa-solid fa-boxes-packing"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-2">Hiện Chưa Có Lô Hàng Nào Cần Xả Kho</h3>
                <p class="text-slate-500 max-w-md mx-auto mb-6 text-sm">
                    Tất cả các sản phẩm trong hệ thống hiện đều ở trạng thái Date mới an toàn và tươi mới 100%.
                </p>
                <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-rose-600 text-white font-medium hover:bg-rose-700 transition">
                    <i class="fa-solid fa-house"></i> Về Trang Chủ Mua Sắm
                </a>
            </div>
        }
        else
        {
            <!-- GRID SẢN PHẨM FEFO -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var batch in Model)
                {
                    var product = batch.Product;
                    if (product == null) continue;

                    int daysRemaining = (batch.ExpDate.Date - now.Date).Days;
                    decimal discountPercent = batch.ClearanceDiscountPercent ?? (daysRemaining <= 90 ? 50m : (daysRemaining <= 180 ? 35m : 25m));
                    decimal originalPrice = product.SellingPrice;
                    decimal clearancePrice = Math.Round(originalPrice * (100m - discountPercent) / 100m / 1000m) * 1000m;

                    var prodImg = ProductImageResolver.GetPrimaryImageUrl(product.ThumbnailUrl, product.Sku, product.Slug, product.Name);
                    var prodWebp = ProductImageResolver.GetWebpImageUrl(prodImg, product.Sku, product.Slug, product.Name);
                    var prodAlt = ProductImageResolver.GetAltText(product.Name, product.Brand?.Name, product.Category?.Name, product.Sku, product.Slug);

                    <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200/80 overflow-hidden flex flex-col group">
                        <!-- TOP BADGE & THUMBNAIL -->
                        <div class="relative bg-slate-100 aspect-square overflow-hidden">
                            <picture class="block w-full h-full">
                                <source srcset="@prodWebp" type="image/webp" />
                                <img src="@prodImg" 
                                     alt="@prodAlt" 
                                     width="400"
                                     height="400"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            </picture>

                            <!-- DISCOUNT BADGE -->
                            <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
                                <span class="bg-gradient-to-r from-red-600 to-rose-600 text-white font-extrabold text-xs px-2.5 py-1 rounded-full shadow-md flex items-center gap-1">
                                    <i class="fa-solid fa-bolt text-amber-300"></i> -@discountPercent.ToString("0.#")%
                                </span>
                                @if (daysRemaining <= 90)
                                {
                                    <span class="bg-amber-500 text-white font-bold text-[10px] px-2 py-0.5 rounded-full shadow-sm">
                                        Cận @daysRemaining ngày
                                    </span>
                                }
                            </div>

                            <!-- WISHLIST BUTTON -->
                            <button type="button" 
                                    class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm text-slate-600 hover:text-rose-600 hover:bg-white flex items-center justify-center transition shadow-sm"
                                    onclick="toggleWishlist(@product.Id, this)"
                                    title="Thêm vào yêu thích">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                        </div>

                        <!-- BODY INFO -->
                        <div class="p-4 flex-1 flex flex-col justify-between">
                            <div>
                                <div class="text-[11px] font-semibold text-rose-600 uppercase tracking-wider mb-1">
                                    @(product.Category?.Name ?? "Mỹ Phẩm Cao Cấp")
                                </div>
                                <h3 class="font-bold text-slate-800 text-sm line-clamp-2 group-hover:text-rose-600 transition mb-2" title="@product.Name">
                                    <a href="/Product/Detail/@product.Id">@product.Name</a>
                                </h3>

                                <!-- FEFO LOT & EXPIRY CARD -->
                                <div class="bg-slate-50 border border-slate-200/60 rounded-xl p-2.5 mb-3 text-xs">
                                    <div class="flex items-center justify-between text-slate-600 mb-1">
                                        <span class="font-mono text-[11px]"><i class="fa-solid fa-barcode text-slate-400 me-1"></i>@batch.BatchNumber</span>
                                        <span class="font-bold @(daysRemaining <= 90 ? "text-red-600" : "text-amber-600")">
                                            HSD: @batch.ExpDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between text-[11px] text-slate-500">
                                        <span>NSX: @batch.ManufacturingDate.ToString("MM/yyyy")</span>
                                        <span class="text-slate-700 font-semibold">Còn: <strong>@batch.CurrentQuantity</strong> sp</span>
                                    </div>
                                </div>
                            </div>

                            <!-- PRICING & ACTION -->
                            <div>
                                <div class="flex items-baseline gap-2 mb-3">
                                    <span class="text-lg font-extrabold text-rose-600 font-mono">
                                        @clearancePrice.ToString("N0") ₫
                                    </span>
                                    <span class="text-xs text-slate-400 line-through font-mono">
                                        @originalPrice.ToString("N0") ₫
                                    </span>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <a href="/Product/Detail/@product.Id" class="text-center py-2 px-3 rounded-xl border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                                        Chi Tiết
                                    </a>
                                    <button type="button" 
                                            class="py-2 px-3 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white text-xs font-bold shadow-sm hover:shadow transition flex items-center justify-center gap-1.5"
                                            onclick="addToCartFefo(@product.Id, 1, this)">
                                        <i class="fa-solid fa-cart-plus"></i> Chọn Mua
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    async function toggleWishlist(productId, btn) {
        try {
            const resp = await fetch('/Wishlist/Toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId })
            });
            const data = await resp.json();
            if (data.success) {
                const icon = btn.querySelector('i');
                if (data.inWishlist) {
                    icon.classList.remove('fa-regular');
                    icon.classList.add('fa-solid', 'text-rose-600');
                } else {
                    icon.classList.remove('fa-solid', 'text-rose-600');
                    icon.classList.add('fa-regular');
                }
                if (typeof showToast === 'function') {
                    showToast(data.message || 'Cập nhật wishlist thành công', 'success');
                }
            }
        } catch (e) {
            console.error('Lỗi toggle wishlist', e);
        }
    }

    async function addToCartFefo(productId, qty, btn) {
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        try {
            const resp = await fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: productId, quantity: qty })
            });
            const data = await resp.json();
            if (data.success) {
                btn.classList.remove('from-red-600', 'to-rose-600');
                btn.classList.add('bg-emerald-600');
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Đã Thêm';
                setTimeout(() => {
                    btn.classList.remove('bg-emerald-600');
                    btn.classList.add('from-red-600', 'to-rose-600');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }, 2000);
            } else {
                alert(data.message || 'Không thể thêm vào giỏ');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        } catch (e) {
            btn.innerHTML = originalText;
            btn.disabled = false;
            console.error('Lỗi thêm giỏ hàng', e);
        }
    }
</script>
