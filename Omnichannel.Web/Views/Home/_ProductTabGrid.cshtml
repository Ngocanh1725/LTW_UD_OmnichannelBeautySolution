@model IEnumerable<Omnichannel.Domain.Entities.Product>

@if (Model == null || !Model.Any())
{
    <div class="col-span-full py-16 text-center text-slate-500 font-sans">
        <i class="fa-solid fa-box-open text-4xl text-rose-gold/50 mb-3 block"></i>
        <span>Không tìm thấy sản phẩm nào trong danh mục này.</span>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <!-- Determine closest FEFO batch for transparent expiry display -->
        var bestBatch = item.Batches?.Where(b => b.CurrentQuantity > 0).OrderBy(b => b.ExpDate).FirstOrDefault();
        var daysLeft = bestBatch != null ? (bestBatch.ExpDate - DateTime.UtcNow).Days : 365;
        var isClearance = bestBatch != null && daysLeft <= 90;
        var imageUrl = !string.IsNullOrEmpty(item.ThumbnailUrl) 
            ? item.ThumbnailUrl 
            : "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=400&h=400&fit=crop";

        <article class="product-card-luxury group animate-on-scroll" itemscope itemtype="https://schema.org/Product">
            <div class="product-thumb-container">
                <img src="@imageUrl" 
                     class="product-thumb-img absolute inset-0 z-10" 
                     alt="@item.Name" 
                     loading="lazy" 
                     itemprop="image" />
                
                <!-- Badges Stack -->
                <div class="product-badges-stack">
                    @if (bestBatch != null)
                    {
                        if (isClearance)
                        {
                            <span class="badge-fefo-clearance">
                                <i class="fa-solid fa-fire mr-1 text-[8px]"></i> HSD: @bestBatch.ExpDate.ToString("MM/yyyy")
                            </span>
                        }
                        else
                        {
                            <span class="badge-fefo-fresh">
                                <i class="fa-solid fa-shield mr-1 text-[8px]"></i> HSD: @bestBatch.ExpDate.ToString("MM/yyyy")
                            </span>
                        }
                    }
                    else
                    {
                        <span class="badge-fefo-fresh">
                            <i class="fa-solid fa-check mr-1 text-[8px]"></i> Date Mới
                        </span>
                    }
                </div>

                <!-- Hover Quick Actions Overlay -->
                <div class="product-action-overlay">
                    <button type="button" 
                            class="btn-card-action btn-cart-primary" 
                            onclick="addToCart(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name))', @item.SellingPrice, '@imageUrl')"
                            aria-label="Thêm vào giỏ hàng">
                        <i class="fa-solid fa-cart-plus text-xs"></i>
                        <span>Thêm Giỏ Hàng</span>
                    </button>
                    <button type="button" 
                            class="btn-card-action" 
                            onclick="openQuickView(@item.Id)" 
                            title="Xem nhanh chi tiết"
                            aria-label="Xem nhanh">
                        <i class="fa-solid fa-eye text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 truncate max-w-[150px]">
                            @(item.Category?.Name ?? "Mỹ Phẩm Cao Cấp")
                        </span>
                        <!-- Trust Rating Stars -->
                        <div class="flex text-amber-400 text-[10px]" title="Đánh giá 5 sao">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                        </div>
                    </div>

                    <a href="/Product/Detail/@item.Id" class="block group/link" itemprop="url">
                        <h3 class="font-serif font-bold text-charcoal text-sm leading-snug line-clamp-2 group-hover/link:text-magenta-accent transition-colors" itemprop="name">
                            @item.Name
                        </h3>
                    </a>
                </div>

                <div class="mt-4 pt-3 border-t border-soft-border/50">
                    <div class="flex items-baseline justify-between">
                        <div class="flex flex-col">
                            <span class="font-mono-numeric font-bold text-base sm:text-lg text-charcoal" itemprop="price">
                                @item.SellingPrice.ToString("N0") ₫
                            </span>
                        </div>
                        @if (bestBatch != null)
                        {
                            <span class="text-[10px] text-emerald-600 font-semibold flex items-center gap-1">
                                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Còn hàng
                            </span>
                        }
                    </div>

                    @if (bestBatch != null)
                    {
                        <div class="text-[10px] text-slate-400 mt-1 font-sans flex items-center justify-between">
                            <span>Lô: <strong class="text-slate-600">@bestBatch.BatchNumber</strong></span>
                            <span>Hạn dùng: @bestBatch.ExpDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </article>
    }
}
