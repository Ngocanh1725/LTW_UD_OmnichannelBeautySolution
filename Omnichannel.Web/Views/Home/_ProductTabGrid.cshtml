@model IEnumerable<Omnichannel.Domain.Entities.Product>

@if (!Model.Any())
{
    <div class="col-span-full py-16 text-center text-slate-500 font-sans">
        <i class="fa-solid fa-box-open text-4xl text-blush mb-3 block"></i>
        Không tìm thấy sản phẩm nào trong danh mục này.
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <!-- Find best FEFO batch -->
        var bestBatch = item.Batches?.Where(b => b.CurrentQuantity > 0).OrderBy(b => b.ExpDate).FirstOrDefault();

        <div class="product-card-luxury group">
            <div class="product-thumb-container">
                <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=400&h=400&fit=crop" : item.ThumbnailUrl)" class="product-thumb-img absolute inset-0 z-10" alt="@item.Name" />
                <!-- Hover image swap (secondary image if available, else placeholder) -->
                <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=400&h=400&fit=crop" : item.ThumbnailUrl)" class="absolute inset-0 w-full h-full object-cover z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" alt="Texture @item.Name" />
                
                <div class="product-badges-stack">
                    @if (bestBatch != null)
                    {
                        var isClearance = (bestBatch.ExpDate - DateTime.UtcNow).Days <= 60;
                        <span class="@(isClearance ? "badge-fefo-clearance" : "badge-fefo-fresh")">
                            HSD: @bestBatch.ExpDate.ToString("MM/yyyy")
                        </span>
                    }
                    else
                    {
                        <span class="badge-fefo-clearance bg-slate-500 shadow-none">Hết Lô</span>
                    }
                </div>

                <div class="product-action-overlay">
                    <button type="button" class="btn-card-action btn-cart-primary" onclick="addToCart(event, @item.Id, 1)">
                        <i class="fa-solid fa-cart-shopping"></i> Thêm Giỏ Hàng
                    </button>
                    <button type="button" class="btn-card-action" onclick="openQuickView(@item.Id)" title="Xem nhanh">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="p-4 sm:p-5">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">@item.Category?.Name</span>
                    <!-- Color Swatches (Dummy for UI logic) -->
                    <div class="flex gap-1">
                        <span class="w-3 h-3 rounded-full bg-red-600 border border-white shadow-sm cursor-pointer hover:scale-110 transition"></span>
                        <span class="w-3 h-3 rounded-full bg-rose-400 border border-white shadow-sm cursor-pointer hover:scale-110 transition"></span>
                    </div>
                </div>
                <a href="/san-pham/@item.Slug" class="block">
                    <h3 class="font-serif font-bold text-charcoal text-base leading-snug line-clamp-2 hover:text-magenta-accent transition">@item.Name</h3>
                </a>
                <div class="mt-3 flex items-center justify-between">
                    <span class="font-mono-numeric font-bold text-lg text-charcoal">@item.SellingPrice.ToString("N0") ₫</span>
                </div>
                @if (bestBatch != null)
                {
                    <div class="mt-3 pt-3 border-t border-soft-border/50 text-[10px] text-slate-500 font-sans flex justify-between">
                        <span>Lô NSX: @bestBatch.ManufacturingDate.ToString("dd/MM/yy")</span>
                        <span class="text-success font-semibold">Sẵn kho</span>
                    </div>
                }
            </div>
        </div>
    }
}
