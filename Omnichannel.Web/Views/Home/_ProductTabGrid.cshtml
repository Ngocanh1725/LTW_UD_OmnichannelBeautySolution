@model IEnumerable<Omnichannel.Domain.Entities.Product>

@if (Model == null || !Model.Any())
{
    <div class="col-span-full py-16 text-center text-slate-500 font-sans">
        <i class="fa-solid fa-box-open text-4xl text-rose-gold/50 mb-3 block"></i>
        <span>Không tìm thấy sản phẩm nào trong danh mục này.</span>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <partial name="_ProductCard" model="item" />
    }
}
