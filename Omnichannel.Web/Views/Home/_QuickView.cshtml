@model Omnichannel.Domain.Entities.Product

@if (Model == null)
{
    <div class="p-8 text-center text-slate-500">Sản phẩm không tồn tại.</div>
}
else
{
    var bestBatch = Model.Batches?.Where(b => b.CurrentQuantity > 0).OrderBy(b => b.ExpDate).FirstOrDefault();

    <div class="flex flex-col md:flex-row h-full">
        <div class="md:w-1/2 bg-pastel-rose relative flex items-center justify-center p-6">
            <button type="button" class="absolute top-4 left-4 w-10 h-10 bg-white/50 hover:bg-white rounded-full flex items-center justify-center text-charcoal transition" onclick="closeQuickView()">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <img src="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=600&h=600&fit=crop" : Model.ThumbnailUrl)" class="max-w-full max-h-[400px] object-contain drop-shadow-2xl" alt="@Model.Name" />
        </div>
        
        <div class="md:w-1/2 p-8 md:p-10 flex flex-col">
            <span class="text-[10px] uppercase font-bold tracking-widest text-nude-gold mb-2">@Model.Category?.Name</span>
            <h2 class="font-serif text-3xl font-bold text-charcoal leading-tight mb-4">@Model.Name</h2>
            
            <div class="flex items-end gap-3 mb-6">
                <span class="font-mono-numeric font-bold text-3xl text-magenta-accent">@Model.SellingPrice.ToString("N0") ₫</span>
            </div>

            <p class="text-sm text-slate-600 font-sans leading-relaxed mb-6 line-clamp-3">
                @Model.Description
            </p>

            @if (bestBatch != null)
            {
                <div class="bg-pastel-nude p-4 rounded-2xl border border-blush mb-6">
                    <div class="flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-box-check text-success"></i>
                        <span class="text-xs font-bold text-charcoal">Thông tin Lô hàng FEFO hiện tại</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4 text-xs font-sans">
                        <div>
                            <span class="text-slate-500 block mb-1">Ngày sản xuất:</span>
                            <span class="font-bold text-charcoal">@bestBatch.ManufacturingDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div>
                            <span class="text-slate-500 block mb-1">Hạn sử dụng:</span>
                            <span class="font-bold text-charcoal">@bestBatch.ExpDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-auto pt-6 border-t border-soft-border flex gap-4">
                <div class="flex items-center border border-soft-border rounded-full h-12 w-32 bg-white">
                    <button class="w-1/3 h-full flex items-center justify-center text-slate-500 hover:text-charcoal" onclick="decreaseQty('qv-qty')"><i class="fa-solid fa-minus text-[10px]"></i></button>
                    <input type="text" id="qv-qty" value="1" class="w-1/3 h-full text-center font-mono-numeric font-bold text-sm bg-transparent border-none focus:ring-0 p-0" readonly />
                    <button class="w-1/3 h-full flex items-center justify-center text-slate-500 hover:text-charcoal" onclick="increaseQty('qv-qty')"><i class="fa-solid fa-plus text-[10px]"></i></button>
                </div>
                
                <button type="button" class="flex-1 rounded-full bg-charcoal text-white font-bold text-sm uppercase tracking-widest hover:bg-magenta-accent transition shadow-luxury flex items-center justify-center gap-2 h-12" onclick="addToCart(event, @Model.Id, parseInt(document.getElementById('qv-qty').value)); closeQuickView();">
                    Thêm Vào Giỏ
                </button>
            </div>
        </div>
    </div>
}
