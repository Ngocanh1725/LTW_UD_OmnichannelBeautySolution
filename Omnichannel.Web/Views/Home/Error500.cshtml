@model ErrorViewModel
@{
    ViewData["Title"] = "500 - Sự Cố Máy Chủ";
    Layout = "_Layout";
}

<section class="min-h-[70vh] flex items-center justify-center py-16 px-4 bg-gradient-to-b from-rose-50/30 via-white to-slate-50">
    <div class="max-w-2xl w-full text-center relative">
        <!-- Glow Effect -->
        <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-80 h-80 bg-rose-400/15 rounded-full blur-3xl -z-10 pointer-events-none"></div>

        <!-- 500 Visual Badge -->
        <div class="inline-flex items-center justify-center w-28 h-28 rounded-3xl bg-rose-50 text-rose-600 border border-rose-200/80 shadow-lg shadow-rose-500/5 mb-6">
            <i class="fa-solid fa-triangle-exclamation text-4xl"></i>
        </div>

        <div class="text-7xl sm:text-9xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-rose-600 to-amber-600 mb-3 select-none">
            500
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-tight mb-3">
            Đã Xảy Ra Sự Cố Máy Chủ Nội Bộ
        </h1>

        <p class="text-slate-500 text-sm sm:text-base max-w-lg mx-auto mb-6 leading-relaxed">
            Hệ thống đang gặp gián đoạn kỹ thuật tạm thời. Yêu cầu của bạn đã được ghi nhận vào nhật ký hệ thống để đội ngũ kỹ sư khắc phục ngay lập tức.
        </p>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-xl text-xs text-slate-600 font-mono mb-8 border border-slate-200">
                <i class="fa-solid fa-fingerprint text-slate-400"></i>
                <span>Mã Yêu Cầu (Trace ID): <strong>@Model.RequestId</strong></span>
            </div>
        }

        <!-- Actions -->
        <div class="flex flex-wrap items-center justify-center gap-3">
            <button type="button" 
                    onclick="window.location.reload()" 
                    class="inline-flex items-center gap-2 px-6 py-3.5 bg-gradient-to-r from-rose-600 to-pink-600 text-white rounded-xl font-bold text-sm shadow-lg shadow-rose-500/20 hover:shadow-rose-500/40 hover:-translate-y-0.5 transition-all">
                <i class="fa-solid fa-rotate-right"></i>
                <span>Tải Lại Trang</span>
            </button>

            <a href="/" 
               class="inline-flex items-center gap-2 px-6 py-3.5 bg-white border border-slate-200 text-slate-700 hover:text-rose-600 hover:border-rose-300 rounded-xl font-bold text-sm shadow-sm hover:-translate-y-0.5 transition-all">
                <i class="fa-solid fa-house"></i>
                <span>Về Trang Chủ</span>
            </a>

            <a href="/Account/Profile" 
               class="inline-flex items-center gap-2 px-5 py-3.5 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-xl font-semibold text-sm transition-colors">
                <i class="fa-solid fa-headset text-slate-500"></i>
                <span>Trung Tâm Trợ Giúp</span>
            </a>
        </div>
    </div>
</section>
