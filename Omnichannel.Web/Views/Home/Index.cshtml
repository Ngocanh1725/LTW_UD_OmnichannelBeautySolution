<section class="py-14 bg-stone-900 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Flash Sale Header with Countdown Timer (Alpine) -->
        <div x-data="{
                endTime: new Date().getTime() + 8 * 60 * 60 * 1000 + 45 * 60 * 1000,
                hours: '08',
                minutes: '45',
                seconds: '20',
                init() {
                    setInterval(() => {
                        let now = new Date().getTime();
                        let distance = this.endTime - now;
                        if (distance < 0) {
                            this.hours = '00';
                            this.minutes = '00';
                            this.seconds = '00';
                            return;
                        }
                        this.hours = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
                        this.minutes = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                        this.seconds = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
                    }, 1000);
                }
             }" class="flex flex-col md:flex-row items-center justify-between gap-6 mb-10 pb-6 border-b border-stone-800">
            <div>
                <div class="flex items-center gap-2">
                    <span class="h-3 w-3 rounded-full bg-magenta-accent animate-ping"></span>
                    <span class="text-xs font-bold uppercase tracking-widest text-magenta-accent">Giờ Vàng Xả Kho Minh Bạch</span>
                </div>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mt-2">FEFO Smart Clearance Sale -50%</h2>
                <p class="text-sm text-slate-400 mt-2 font-sans">Lô hàng cận date dưới 60 ngày - Cam kết hiệu quả chất lượng tuyệt đối.</p>
            </div>

            <!-- Countdown Timer Blocks -->
