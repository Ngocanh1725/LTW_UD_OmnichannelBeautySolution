@model Omnichannel.Application.DTOs.Sales.HomeIndexViewModel
@{
    ViewData["Title"] = "Thế Giới Mỹ Phẩm Chính Hãng & Skincare";
}

<div class="row g-3">
    @if (Model.FeaturedCategories != null && Model.FeaturedCategories.Any())
    {
        foreach (var cat in Model.FeaturedCategories)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a href="/danh-muc/@cat.Slug" class="text-decoration-none">
                    <div class="beauty-card p-3 text-center h-100 hover-lift">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 shadow-sm" style="width: 58px; height: 58px; background: #F5F3FF; color: #7C3AED; font-size: 22px;">
                            <i class="@(string.IsNullOrEmpty(cat.IconUrl) ? "fa-solid fa-wand-magic-sparkles" : cat.IconUrl)"></i>
                        </div>
                        <div class="fw-bold text-dark small text-truncate">@cat.CategoryName</div>
                        <div class="text-muted" style="font-size: 11px;">@cat.ProductCount sản phẩm</div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted small py-3">Đang cập nhật danh mục...</div>
    }
</div>


<div class="row g-3">
    @if (Model.FlashSaleProducts != null && Model.FlashSaleProducts.Any())
    {
        foreach (var p in Model.FlashSaleProducts)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beauty-card h-100 p-3 d-flex flex-column justify-content-between position-relative bg-white shadow-sm">
                    <span class="position-absolute top-0 start-0 m-3 badge rounded-pill text-white" style="background: #EC4899; font-size: 11px;">
                        -25%
                    </span>

                    <div class="text-center my-2">
                        <img src="https://placehold.co/240x200/FDF2F8/7C3AED?text=@Uri.EscapeDataString(p.ProductName)" alt="@p.ProductName" class="img-fluid rounded-3" style="max-height: 160px; object-fit: cover;" />
                    </div>

                    <div>
                        <span class="badge mb-1" style="background: #F5F3FF; color: #7C3AED; font-size: 10.5px;">
                            @p.CategoryName
                        </span>
                        <h6 class="fw-bold text-dark mb-1 text-truncate-2" style="font-size: 14px; min-height: 40px;">
                            <a href="/san-pham/@p.Slug" class="text-dark text-decoration-none">@p.ProductName</a>
                        </h6>

                        <!-- Huy hiệu HSD theo Lô Date FEFO gần nhất -->
                        <div class="mb-2">
                            <span class="badge border bg-light text-muted fw-normal" style="font-size: 11px;">
                                <i class="fa-regular fa-calendar-check text-success me-1"></i>HSD: <strong class="text-dark">@p.EarliestExpDateStr</strong>
                            </span>
                        </div>

                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <span class="fw-bold fs-6 font-monospace" style="color: #EC4899;">@p.SellingPrice.ToString("N0") đ</span>
                            <span class="text-muted small text-decoration-line-through font-monospace">@p.OriginalPrice.ToString("N0") đ</span>
                        </div>

                        <button type="button" class="btn btn-primary-gradient w-100 py-2 small" onclick="quickAddToCart('@p.ProductId')">
                            <i class="fa-solid fa-cart-plus me-1"></i>Thêm vào giỏ
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted py-4">
            <i class="fa-solid fa-sparkles fs-3 text-secondary opacity-50 mb-2"></i>
            <div>Chưa có sản phẩm khuyến mãi hôm nay. Vui lòng quay lại sau!</div>
        </div>
    }
</div>
</div>


<div class="row g-3">
    @if (Model.LatestProducts != null && Model.LatestProducts.Any())
    {
        foreach (var p in Model.LatestProducts)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beauty-card h-100 p-3 d-flex flex-column justify-content-between bg-white shadow-sm">
                    <div class="text-center my-2">
                        <img src="https://placehold.co/240x200/FDF2F8/7C3AED?text=@Uri.EscapeDataString(p.ProductName)" alt="@p.ProductName" class="img-fluid rounded-3" style="max-height: 160px; object-fit: cover;" />
                    </div>

                    <div>
                        <span class="badge mb-1" style="background: #F5F3FF; color: #7C3AED; font-size: 10.5px;">
                            @p.CategoryName
                        </span>
                        <h6 class="fw-bold text-dark mb-1 text-truncate-2" style="font-size: 14px; min-height: 40px;">
                            <a href="/san-pham/@p.Slug" class="text-dark text-decoration-none">@p.ProductName</a>
                        </h6>

                        <div class="mb-2">
                            <span class="badge border bg-light text-muted fw-normal" style="font-size: 11px;">
                                <i class="fa-solid fa-shield-halved text-success me-1"></i>HSD: <strong class="text-dark">@p.EarliestExpDateStr</strong>
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="fw-bold fs-6 font-monospace" style="color: #EC4899;">@p.SellingPrice.ToString("N0") đ</span>
                            </div>
                            <button type="button" class="btn btn-outline-purple btn-sm rounded-pill px-3" onclick="quickAddToCart('@p.ProductId')">
                                <i class="fa-solid fa-cart-plus me-1"></i>Thêm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted py-5">
            <p>Đang cập nhật danh sách sản phẩm...</p>
        </div>
    }
</div>


@section Scripts {

    document.addEventListener('DOMContentLoaded', function () {
    var timerContainer = document.getElementById('flashSaleTimer');
    if (timerContainer) {
    var elHours = timerContainer.querySelector('.timer-hours');
    var elMinutes = timerContainer.querySelector('.timer-minutes');
    var elSeconds = timerContainer.querySelector('.timer-seconds');
    var endTime = new Date().getTime() + (8 * 3600 * 1000) + (45 * 60 * 1000) + (12 * 1000);

                function updateCountdown() {
                    var now = new Date().getTime();
                    var diff = endTime - now;
                    if (diff <= 0) {
                        if (elHours) elHours.textContent = '00';
                        if (elMinutes) elMinutes.textContent = '00';
                        if (elSeconds) elSeconds.textContent = '00';
                        return;
                    }
                    var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    var s = Math.floor((diff % (1000 * 60)) / 1000);
                    if (elHours) elHours.textContent = String(h).padStart(2, '0');
                    if (elMinutes) elMinutes.textContent = String(m).padStart(2, '0');
                    if (elSeconds) elSeconds.textContent = String(s).padStart(2, '0');
                }
                updateCountdown();
                setInterval(updateCountdown, 1000);
            }
        });

        async function quickAddToCart(productId) {
            try {
                const res = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                });

                const data = await res.json();
                if (data.success) {
                    const drawerRes = await fetch('/Cart/GetMiniCart');
                    const drawerHtml = await drawerRes.text();
                    document.getElementById('miniCartContainer').innerHTML = drawerHtml;

                    const drawerEl = document.getElementById('miniCartDrawer');
                    if (drawerEl) {
                        const bsDrawer = new bootstrap.Offcanvas(drawerEl);
                        bsDrawer.show();
                    }
                } else {
                    alert(data.message || 'Lỗi thêm vào giỏ hàng.');
                }
            } catch (err) {
                console.error(err);
            }
        }

        async function removeDrawerItem(productId) {
            try {
                await fetch('/Cart/RemoveItem', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(productId)
                });

                const drawerRes = await fetch('/Cart/GetMiniCart');
                document.getElementById('miniCartContainer').innerHTML = await drawerRes.text();
            } catch (err) {
                console.error(err);
            }
        }
    </script>


}