                <span class="text-xs font-medium text-stone-400 mr-2">Kết thúc trong:</span>
                <div class="countdown-segment">
                    <span x-text="hours" class="font-mono-numeric text-xl font-bold text-pink-400">08</span>
                    <span class="block text-[9px] uppercase tracking-wider text-stone-400">Giờ</span>
                </div>
                <span class="font-bold text-stone-500">:</span>
                <div class="countdown-segment">
