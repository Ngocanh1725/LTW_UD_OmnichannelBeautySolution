                </div>
                <span class="font-bold text-stone-500">:</span>
                <div class="countdown-segment">
                    <span x-text="seconds" class="font-mono-numeric text-xl font-bold text-pink-400">20</span>
                    <span class="block text-[9px] uppercase tracking-wider text-stone-400">Giây</span>
