@using Omnichannel.Domain.Entities
@{
    ViewData["Title"] = "Trang Chủ - Thế Giới Nhan Sắc & Mỹ Phẩm Thuần Khiết";
    var heroBanners = ViewBag.HeroBanners as List<Banner> ?? new List<Banner>();
    if(!heroBanners.Any()) {
        heroBanners.Add(new Banner { Title = "Hương Thơm Quý Phái", DesktopImageUrl = "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=1600&q=80", LinkUrl = "/category/all" });
    }
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var fefoBatches = ViewBag.FefoBatches as List<ProductBatch> ?? new List<ProductBatch>();
}

<!-- Hero Slider Section -->
<section x-data="{
        activeSlide: 0,
        slides: [
            @foreach(var b in heroBanners)
            {
                <text>{
                    tag: 'Mới Nhất',
                    title: '@Html.Raw(b.Title)',
                    desc: 'Khám phá chu trình chăm sóc khoa học chuẩn spa và các dòng mỹ phẩm cao cấp.',
                    img: '@Html.Raw(b.DesktopImageUrl)',
                    url: '@Html.Raw(b.LinkUrl ?? "#")'
                },</text>
            }
        ],
        init() {
            if(this.slides.length > 1) {
                setInterval(() => { this.next() }, 6000);
            }
        },
        next() {
            this.activeSlide = this.activeSlide === this.slides.length - 1 ? 0 : this.activeSlide + 1;
        },
        prev() {
            this.activeSlide = this.activeSlide === 0 ? this.slides.length - 1 : this.activeSlide - 1;
        }
    }" class="relative bg-pastel-rose overflow-hidden min-h-[500px] lg:min-h-[650px] flex items-center">
    
    <!-- Background Image Transitions -->
    <template x-for="(slide, index) in slides" :key="index">
        <div x-show="activeSlide === index" 
             x-transition:enter="transition ease-out duration-1000"
             x-transition:enter-start="opacity-0 scale-105"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-1000 absolute inset-0"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="absolute inset-0 z-0">
            <!-- Overlay gradient to make text readable -->
            <div class="absolute inset-0 bg-gradient-to-r from-pastel-rose via-pastel-rose/80 to-transparent z-10"></div>
            <img :src="slide.img" class="w-full h-full object-cover object-right lg:object-center" alt="Banner" />
        </div>
    </template>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full pt-10 pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <!-- Dynamic Content -->
                <template x-for="(slide, index) in slides" :key="'text-'+index">
                    <div x-show="activeSlide === index"
                         x-transition:enter="transition ease-out duration-700 delay-300"
                         x-transition:enter-start="opacity-0 translate-y-8"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         x-transition:leave="transition ease-in duration-300 absolute"
                         x-transition:leave-start="opacity-100"
                         x-transition:leave-end="opacity-0">
                         
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/80 border border-blush shadow-sm text-xs font-semibold text-magenta-accent mb-6">
                            <span class="h-2 w-2 rounded-full bg-magenta-accent animate-ping"></span>
                            <span x-text="slide.tag"></span>
                        </div>

                        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold text-charcoal leading-tight mb-6">
                            Đắm Chìm Trong <br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-magenta-accent to-champagne-gold" x-text="slide.title">
                            </span>
                        </h1>

                        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto lg:mx-0 leading-relaxed font-sans font-medium mb-8" x-text="slide.desc">
                        </p>
                    </div>
                </template>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a href="#featuredProducts" class="w-full sm:w-auto px-8 py-4 rounded-full bg-charcoal text-white font-bold text-xs uppercase tracking-widest hover:bg-magenta-accent shadow-pink-glow transition-all duration-300">
                        Khám Phá Bộ Sưu Tập <i class="fa-solid fa-arrow-right ml-2"></i>
                    </a>
                    <a href="/clearance-fefo" class="w-full sm:w-auto px-8 py-4 rounded-full bg-white text-charcoal font-bold text-xs uppercase tracking-widest border border-soft-border hover:border-magenta-accent hover:text-magenta-accent hover:bg-blush transition-all duration-300">
                        Săn Deal Cận Date -50%
                    </a>
                </div>

                <!-- Trust Badges -->
                <div class="pt-10 grid grid-cols-3 gap-6 border-t border-blush/50 max-w-md mx-auto lg:mx-0 text-left mt-8">
                    <div>
                        <div class="font-serif font-bold text-champagne-gold text-2xl">100%</div>
                        <div class="text-[10px] font-sans text-slate-500 uppercase tracking-wider mt-1">Chính Ngạch</div>
                    </div>
                    <div>
                        <div class="font-serif font-bold text-champagne-gold text-2xl">FEFO</div>
                        <div class="text-[10px] font-sans text-slate-500 uppercase tracking-wider mt-1">Hạn Dùng Minh Bạch</div>
                    </div>
                    <div>
                        <div class="font-serif font-bold text-champagne-gold text-2xl">2 Giờ</div>
                        <div class="text-[10px] font-sans text-slate-500 uppercase tracking-wider mt-1">Giao Tốc Hành</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slider Controls -->
    <div class="absolute bottom-8 right-8 z-30 flex gap-3" x-show="slides.length > 1">
        <button @@click="prev()" class="h-10 w-10 rounded-full bg-white/80 backdrop-blur border border-soft-border flex items-center justify-center text-charcoal hover:bg-magenta-accent hover:text-white transition shadow-sm">
            <i class="fa-solid fa-arrow-left text-xs"></i>
        </button>
        <button @@click="next()" class="h-10 w-10 rounded-full bg-white/80 backdrop-blur border border-soft-border flex items-center justify-center text-charcoal hover:bg-magenta-accent hover:text-white transition shadow-sm">
            <i class="fa-solid fa-arrow-right text-xs"></i>
        </button>
    </div>
</section>

<!-- Category Icons Section -->
<section class="py-14 bg-white border-b border-soft-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto mb-10">
            <span class="text-xs font-bold uppercase tracking-widest text-nude-gold">Danh Mục Chọn Lọc</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal mt-2">Nâng Niu Vẻ Đẹp Của Bạn</h2>
        </div>

        <div class="grid grid-cols-4 sm:grid-cols-4 lg:grid-cols-8 gap-4 sm:gap-6 justify-items-center">
            @if(categories.Any()) {
                @foreach(var cat in categories.Take(8))
                {
                    <a href="/category/@cat.Slug" class="flex flex-col items-center group">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-[3px] bg-gradient-to-tr from-pastel-rose to-rose-gold relative transition transform group-hover:scale-105">
                            <div class="absolute inset-[-3px] rounded-full bg-gradient-to-tr from-magenta-accent via-rose-gold to-champagne-gold opacity-0 group-hover:opacity-100 transition duration-300 blur-sm"></div>
                            <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=200&h=200&fit=crop" : cat.ImageUrl)" class="w-full h-full object-cover rounded-full border-2 border-white relative z-10" alt="@cat.Name" />
                        </div>
                        <span class="text-xs font-bold text-slate-700 mt-3 text-center group-hover:text-magenta-accent transition">@cat.Name</span>
                    </a>
                }
            } else {
                <p class="text-slate-500 text-center col-span-full">Chưa có danh mục nào.</p>
            }
        </div>
    </div>
</section>

<!-- Flash Sale Section -->
<section class="py-16 bg-charcoal text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div x-data="{
                endTime: new Date().getTime() + 8 * 60 * 60 * 1000 + 45 * 60 * 1000,
                hours: '08', minutes: '45', seconds: '20',
                init() {
                    setInterval(() => {
                        let distance = this.endTime - new Date().getTime();
                        if (distance < 0) return;
                        this.hours = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
                        this.minutes = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                        this.seconds = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
                    }, 1000);
                }
             }" class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12 border-b border-white/10 pb-6">
            <div>
                <div class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-champagne-gold animate-ping"></span>
                    <span class="text-xs font-bold uppercase tracking-widest text-champagne-gold">Giờ Vàng Xả Kho</span>
                </div>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mt-2">FEFO Smart Clearance Sale -50%</h2>
            </div>
            
            <div class="flex items-center gap-3 bg-white/5 p-3 rounded-2xl border border-white/10 backdrop-blur-md">
                <span class="text-xs font-bold text-slate-400 mr-2 uppercase tracking-widest">Kết thúc:</span>
                <div class="bg-charcoal px-3 py-2 rounded-xl border border-white/10"><span x-text="hours" class="font-mono-numeric text-xl font-bold text-champagne-gold">08</span></div>
                <span class="font-bold text-slate-500">:</span>
                <div class="bg-charcoal px-3 py-2 rounded-xl border border-white/10"><span x-text="minutes" class="font-mono-numeric text-xl font-bold text-champagne-gold">45</span></div>
                <span class="font-bold text-slate-500">:</span>
                <div class="bg-charcoal px-3 py-2 rounded-xl border border-white/10"><span x-text="seconds" class="font-mono-numeric text-xl font-bold text-champagne-gold">20</span></div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @if(fefoBatches.Any())
            {
                @foreach (var batch in fefoBatches) 
                {
                    var p = batch.Product;
                    if(p == null) continue;
                    var daysLeft = (batch.ExpDate - DateTime.UtcNow).Days;
                    var progress = (batch.InitialQuantity > 0) ? ((batch.InitialQuantity - batch.CurrentQuantity) * 100.0 / batch.InitialQuantity) : 85;
                    var salePrice = p.SellingPrice * 0.6m; // 40% OFF
                    <div class="bg-white/5 rounded-3xl border border-white/10 p-4 flex flex-col justify-between hover:border-champagne-gold/50 transition duration-300">
                        <div>
                            <div class="relative aspect-square rounded-2xl overflow-hidden bg-charcoal mb-4 group cursor-pointer" onclick="openQuickView(@p.Id)">
                                <img src="@(string.IsNullOrEmpty(p.ThumbnailUrl) ? "https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=400&h=400&fit=crop" : p.ThumbnailUrl)" class="w-full h-full object-cover transition transform group-hover:scale-110" alt="@p.Name" />
                                <span class="absolute top-3 left-3 bg-red-600 text-white text-[10px] font-bold px-2 py-1 rounded-full shadow-lg">-40% FEFO</span>
                            </div>
                            <div class="text-[10px] text-champagne-gold font-bold mb-1.5 uppercase tracking-wider">Date: @daysLeft ngày nữa</div>
                            <h4 class="text-sm font-bold text-white line-clamp-1">@p.Name</h4>
                            <div class="flex items-baseline gap-2 mt-2">
                                <span class="text-lg font-bold text-white font-mono-numeric">@salePrice.ToString("N0") ₫</span>
                                <span class="text-xs text-slate-500 line-through font-mono-numeric">@p.SellingPrice.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="mt-5 space-y-2.5">
                            <div class="flex justify-between text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                <span>Đã bán: @Math.Round(progress)%</span>
                                <span class="text-champagne-gold">Sắp hết</span>
                            </div>
                            <div class="h-1.5 w-full rounded-full bg-white/10 overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-champagne-gold to-nude-gold" style="width: @Math.Round(progress)%;"></div>
                            </div>
                            <button type="button" onclick="addToCart(event, @p.Id, 1)" class="w-full py-3 rounded-full bg-white text-charcoal font-bold text-xs hover:bg-champagne-gold hover:text-white transition flex items-center justify-center gap-2 mt-2">
                                <i class="fa-solid fa-cart-shopping"></i> Thêm Giỏ Hàng
                            </button>
                        </div>
                    </div>
                }
            } else {
                <p class="text-slate-400">Không có sản phẩm cận date nào.</p>
            }
        </div>
    </div>
</section>

<!-- Featured Products (Grid loaded via HTMX) -->
<section id="featuredProducts" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-12 pb-4 border-b border-soft-border">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-nude-gold">Mỹ Phẩm Tuyển Lựa</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal mt-2">Sản Phẩm Yêu Thích</h2>
            </div>
            <div x-data="{ activeTab: 'all' }" class="flex items-center gap-1.5 p-1.5 rounded-full bg-pastel-rose border border-blush shadow-inner">
                <button @@click="activeTab = 'all'" hx-get="/Home/GetProductTab?category=all" hx-target="#productCardsGrid" :class="activeTab === 'all' ? 'bg-white text-charcoal shadow' : 'text-slate-500 hover:text-charcoal'" class="px-5 py-2.5 rounded-full text-xs font-bold transition">Tất Cả</button>
                <button @@click="activeTab = 'skincare'" hx-get="/Home/GetProductTab?category=skincare" hx-target="#productCardsGrid" :class="activeTab === 'skincare' ? 'bg-white text-charcoal shadow' : 'text-slate-500 hover:text-charcoal'" class="px-5 py-2.5 rounded-full text-xs font-bold transition">Chăm Sóc Da</button>
                <button @@click="activeTab = 'makeup'" hx-get="/Home/GetProductTab?category=makeup" hx-target="#productCardsGrid" :class="activeTab === 'makeup' ? 'bg-white text-charcoal shadow' : 'text-slate-500 hover:text-charcoal'" class="px-5 py-2.5 rounded-full text-xs font-bold transition">Trang Điểm</button>
            </div>
        </div>

        <div id="productCardsGrid" hx-get="/Home/GetProductTab?category=all" hx-trigger="load" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative min-h-[400px]">
            <div class="absolute inset-0 flex items-center justify-center bg-white/80 z-10 backdrop-blur-sm">
                <span class="flex h-10 w-10 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-gold opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-10 w-10 bg-magenta-accent flex items-center justify-center text-white"><i class="fa-solid fa-spinner fa-spin"></i></span>
                </span>
            </div>
        </div>
    </div>
</section>