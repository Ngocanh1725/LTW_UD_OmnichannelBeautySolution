<section id="featuredProducts" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Tab Navigation Filters (Zyora & Ekommart style) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-12 pb-4 border-b border-blush">
            <div>
                <span class="text-xs font-bold uppercase tracking-widest text-rose-gold">Mỹ Phẩm Tuyển Lựa</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal mt-2">Sản Phẩm Được Yêu Thích Nhất</h2>
            </div>

            <!-- Tab Buttons (Alpine & HTMX) -->
            <div x-data="{ activeTab: 'all' }" class="flex items-center gap-2 p-1.5 rounded-full bg-pastel-pink border border-blush">
                <button type="button" @@click="activeTab = 'all'" hx-get="/Home/GetProductTab?category=all" hx-target="#productCardsGrid" :class="activeTab === 'all' ? 'bg-white text-charcoal shadow-sm' : 'text-slate-500 hover:text-charcoal'" class="px-6 py-2.5 rounded-full text-xs font-bold transition-all">Tất Cả</button>
                <button type="button" @@click="activeTab = 'skincare'" hx-get="/Home/GetProductTab?category=skincare" hx-target="#productCardsGrid" :class="activeTab === 'skincare' ? 'bg-white text-charcoal shadow-sm' : 'text-slate-500 hover:text-charcoal'" class="px-6 py-2.5 rounded-full text-xs font-bold transition-all">Chăm Sóc Da</button>
                <button type="button" @@click="activeTab = 'makeup'" hx-get="/Home/GetProductTab?category=makeup" hx-target="#productCardsGrid" :class="activeTab === 'makeup' ? 'bg-white text-charcoal shadow-sm' : 'text-slate-500 hover:text-charcoal'" class="px-6 py-2.5 rounded-full text-xs font-bold transition-all">Trang Điểm</button>
            </div>
        </div>

        <!-- Product Grid (Loaded via HTMX) -->
        <div id="productCardsGrid" hx-get="/Home/GetProductTab?category=all" hx-trigger="load" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative min-h-[400px]">
            <!-- Loading indicator -->
            <div class="absolute inset-0 flex items-center justify-center bg-white/80 z-10">
