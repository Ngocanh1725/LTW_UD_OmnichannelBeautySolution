
<style>
    @@media screen and (min-width: 1200px) {
        .cart-desktop-scale {
            zoom: 0.80;
        }
    }
</style>
@model Omnichannel.Application.DTOs.Sales.CartViewModel
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn - Canmake Beauty";
    var vm = Model ?? new Omnichannel.Application.DTOs.Sales.CartViewModel();
    decimal threshold = 500000m;
    decimal remaining = Math.Max(0, threshold - vm.SubTotal);
    decimal progress = vm.SubTotal >= threshold ? 100 : (threshold > 0 ? Math.Round(vm.SubTotal / threshold * 100, 1) : 100);
}

<div class="bg-[#fffdfd] min-h-screen py-2 sm:py-3 cart-desktop-scale" x-data="cartPage()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumb -->
        <nav aria-label="Đường dẫn trang" class="mb-2 text-xs text-slate-500 flex items-center gap-2">
            <a href="/" class="hover:text-magenta-accent transition flex items-center gap-1">
                <i class="fa-solid fa-house text-slate-400"></i> Trang Chủ
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-charcoal font-semibold">Giỏ Hàng Của Bạn</span>
        </nav>

        <!-- Top Header & Back to Shop -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal flex items-center gap-3">
                <i class="fa-solid fa-bag-shopping text-magenta-accent text-2xl"></i>
                <span>Giỏ Hàng Của Bạn</span>
                <span class="text-xs font-mono font-bold text-magenta-accent bg-pastel-rose/60 border border-magenta-accent/20 px-3 py-1 rounded-full">
                    <span x-text="totalItems">@vm.TotalItems</span> sản phẩm
                </span>
            </h1>
            <a href="/Product/Search" class="text-xs font-bold text-magenta-accent hover:text-charcoal transition flex items-center gap-1.5 self-start sm:self-auto">
                <i class="fa-solid fa-arrow-left text-[10px]"></i> Tiếp tục chọn mỹ phẩm
            </a>
        </div>

        @if (vm.Items == null || !vm.Items.Any())
        {
            <!-- EMPTY CART STATE -->
            <div class="bg-white rounded-3xl border border-soft-border p-12 text-center max-w-lg mx-auto shadow-sm my-8">
                <div class="w-20 h-20 rounded-full bg-pastel-rose text-magenta-accent flex items-center justify-center text-3xl mx-auto mb-4 shadow-xs">
                    <i class="fa-solid fa-cart-arrow-down"></i>
                </div>
                <h3 class="font-serif text-xl font-bold text-charcoal">Giỏ hàng của bạn đang trống</h3>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                    Hãy lựa chọn những sản phẩm chăm sóc da và mỹ phẩm chính ngạch chuẩn FEFO để tận hưởng ưu đãi freeship và quà tặng thượng lưu!
                </p>
                <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/Product/Search" class="px-8 py-3.5 rounded-full bg-charcoal text-white font-bold text-xs uppercase tracking-wider hover:bg-magenta-accent shadow-md transition-all">
                        Khám Phá Mỹ Phẩm Ngay
                    </a>
                </div>
            </div>

            <!-- RECENTLY VIEWED IN EMPTY CART - PHIÊN C2 -->
            <div x-data="recentlyViewedInCart()" 
                 x-init="init()" 
                 x-show="products && products.length > 0"
                 style="display: none;"
                 class="max-w-4xl mx-auto mt-10 p-6 rounded-3xl bg-white border border-rose-100 shadow-sm">
                
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-rose-gold">Tiếp tục mua sắm</span>
                        <h4 class="font-serif text-lg font-bold text-charcoal">Sản Phẩm Bạn Đã Xem Gần Đây</h4>
                    </div>
                    <span class="text-xs text-slate-400">1-click thêm vào giỏ</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <template x-for="item in products.slice(0, 4)" :key="item.id">
                        <div class="product-card-luxury group bg-slate-50/50 rounded-2xl border border-slate-200/70 p-3 hover:border-magenta-accent/40 hover:bg-white hover:shadow-sm transition flex flex-col justify-between">
                            <div>
                                <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-white mb-2 border border-slate-100">
                                    <img :src="item.imageUrl" :alt="item.name" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
                                </div>
                                <span class="text-[9px] uppercase font-bold tracking-wider text-rose-gold truncate block" x-text="item.brandName"></span>
                                <a :href="'/san-pham/' + item.slug" class="block mt-0.5">
                                    <h5 class="font-bold text-charcoal text-xs line-clamp-2 hover:text-magenta-accent transition leading-tight" x-text="item.name"></h5>
                                </a>
                            </div>
                            <div class="mt-3 pt-2 border-t border-slate-200/60 flex items-center justify-between gap-1">
                                <span class="font-mono-numeric font-bold text-xs text-charcoal" x-text="formatPrice(item.salePrice || item.price)"></span>
                                <button type="button" 
                                        @@click="quickAddToCart(item)"
                                        class="px-2.5 py-1 rounded-full bg-magenta-accent text-white text-[10px] font-bold hover:bg-[#b0276a] transition shadow-2xs flex items-center gap-1 cursor-pointer">
                                    <i class="fa-solid fa-cart-plus text-[9px]"></i>
                                    <span>Thêm</span>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

                <!-- =========================================================================
                     LEFT COLUMN (8 COLS): ITEMS LIST & PACKAGING & CROSS-SELL
                     ========================================================================= -->
                <div class="lg:col-span-8 space-y-3.5">

                    <!-- 3. THANH TIẾN ĐỘ MIỄN PHÍ VẬN CHUYỂN (FREESHIP METER) -->
                    <div class="p-3.5 rounded-2xl bg-gradient-to-r from-pastel-rose/70 via-white to-pastel-rose/50 border border-soft-border shadow-xs transition-all duration-300">
                        <div class="flex items-center justify-between text-xs font-bold mb-2.5">
                            <!-- Dynamic text based on free shipping status -->
                            <div class="flex items-center gap-2">
                                <template x-if="!isFreeShipping">
                                    <div class="flex items-center gap-2 text-charcoal">
                                        <div class="w-7 h-7 rounded-full bg-magenta-accent/10 text-magenta-accent flex items-center justify-center text-xs animate-bounce">
                                            <i class="fa-solid fa-truck-fast"></i>
                                        </div>
                                        <span>
                                            Mua thêm <strong class="text-magenta-accent font-mono-numeric text-sm" x-text="freeShippingRemainingFormatted">@remaining.ToString("N0") ₫</strong> để nhận <strong class="uppercase text-charcoal">MIỄN PHÍ VẬN CHUYỂN!</strong>
                                        </span>
                                    </div>
                                </template>

                                <template x-if="isFreeShipping">
                                    <div class="flex items-center gap-2 text-emerald-700">
                                        <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-circle-check text-sm"></i>
                                        </div>
                                        <span class="text-xs font-bold">
                                            🎉 Chúc mừng! Đơn hàng của bạn đã đủ điều kiện Freeship toàn quốc!
                                        </span>
                                    </div>
                                </template>
                            </div>

                            <span class="text-magenta-accent font-mono font-bold text-xs" x-text="freeShippingProgress + '%'">
                                @Math.Round(progress)%
                            </span>
                        </div>

                        <!-- Progress Bar Track & Indicator -->
                        <div class="h-3 w-full rounded-full bg-slate-100 p-0.5 overflow-hidden shadow-inner relative">
                            <div class="h-full rounded-full transition-all duration-700 relative shadow-sm"
                                 :class="isFreeShipping ? 'bg-gradient-to-r from-emerald-400 to-emerald-600' : 'bg-gradient-to-r from-rose-gold via-pink-400 to-magenta-accent'"
                                 :style="'width: ' + freeShippingProgress + '%;'">
                            </div>
                        </div>
                    </div>

                    <!-- =========================================================================
                         CLINICAL INGREDIENT CONFLICT ALERT BANNER (ĐỘNG CƠ TƯƠNG KỴ DA LIỄU AI)
                         ========================================================================= -->
                    @if (vm.ConflictAnalysis != null && vm.ConflictAnalysis.HasCriticalConflicts)
                    {
                        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-red-50/95 via-amber-50/80 to-rose-50/70 border-2 border-red-300 shadow-md space-y-3 relative overflow-hidden" id="conflictAlertCard">
                            <!-- Header with Pulsing Danger Icon & Badges -->
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-red-200/90 pb-2.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-11 h-11 rounded-2xl bg-red-600 text-white flex items-center justify-center text-xl shadow-md shadow-red-500/30 shrink-0 animate-pulse">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <h3 class="font-serif font-bold text-base sm:text-lg text-red-950 tracking-tight">
                                                CẢNH BÁO XUNG ĐỘT HOẠT CHẤT TỰ ĐỘNG
                                            </h3>
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-red-600 text-white uppercase tracking-wider shadow-xs animate-bounce">
                                                ⚠️ CẦN TÁCH LỊCH DÙNG (HIGH CONFLICT)
                                            </span>
                                        </div>
                                        <p class="text-xs text-red-800 font-medium mt-0.5">
                                            Động cơ chẩn đoán da liễu độc quyền <strong class="font-semibold text-red-900">ISkincareInteractionEngine</strong> phát hiện 2 sản phẩm kỵ nhau trong giỏ hàng!
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 self-start sm:self-auto shrink-0">
                                    <span class="px-3 py-1.5 rounded-xl bg-white/95 border border-red-200 text-red-700 font-mono text-xs font-bold shadow-2xs">
                                        Chuẩn Y Khoa: Skin Cycling AM/PM
                                    </span>
                                </div>
                            </div>

                            @foreach (var inter in vm.ConflictAnalysis.Interactions)
                            {
                                <div class="bg-white/95 rounded-2xl p-3 sm:p-4 border border-red-200/90 shadow-2xs space-y-2.5">
                                    <!-- Cặp hoạt chất tương kỵ -->
                                    <div class="flex flex-wrap items-center gap-2 text-xs">
                                        <span class="font-bold text-slate-700">Cặp hoạt chất phát hiện:</span>
                                        <span class="px-3 py-1 rounded-lg bg-red-100 text-red-800 font-bold border border-red-200 font-mono text-xs">
                                            <i class="fa-solid fa-dna text-red-600 mr-1"></i> @inter.IngredientA
                                        </span>
                                        <span class="text-red-600 font-extrabold px-1 text-sm">⚡ XUNG ĐỘT ⚡</span>
                                        <span class="px-3 py-1 rounded-lg bg-amber-100 text-amber-900 font-bold border border-amber-200 font-mono text-xs">
                                            <i class="fa-solid fa-flask text-amber-700 mr-1"></i> @inter.IngredientB
                                        </span>
                                    </div>

                                    <!-- Cơ chế kích ứng lâm sàng -->
                                    <div class="text-xs text-slate-800 leading-relaxed bg-red-50/60 p-2.5 rounded-xl border border-red-100">
                                        <strong class="text-red-900 flex items-center gap-1.5 mb-1 font-bold">
                                            <i class="fa-solid fa-microscope text-red-600"></i> Cơ chế tương kỵ lâm sàng (Scientific Pathology):
                                        </strong>
                                        <p class="text-slate-700 leading-normal">
                                            @inter.ScientificExplanation
                                        </p>
                                    </div>

                                    <!-- Phác đồ phân tách Y khoa chuẩn AM/PM & Skin Cycling -->
                                    <div class="space-y-2 pt-1">
                                        <div class="text-xs font-bold text-slate-800 flex items-center gap-2">
                                            <i class="fa-solid fa-calendar-check text-emerald-600"></i>
                                            <span>Phác đồ tách phác đồ Y khoa khuyến nghị (Clinical Schedule Separation):</span>
                                        </div>

                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                                            <!-- Buổi Sáng -->
                                            <div class="p-2.5 rounded-xl bg-amber-50/80 border border-amber-200/90 space-y-1">
                                                <div class="font-bold text-amber-900 flex items-center gap-2">
                                                    <span class="w-6 h-6 rounded-full bg-amber-200/80 text-amber-800 flex items-center justify-center text-[11px]">☀️</span>
                                                    <span>Buổi Sáng (AM Routine):</span>
                                                </div>
                                                <p class="text-amber-900/90 text-[11px] leading-relaxed">
                                                    Sử dụng <strong>Dung dịch BHA 2%</strong> để làm sạch sâu nang lông, kiềm dầu bã nhờn ➔ Khóa ẩm mỏng nhẹ ➔ <strong>Bắt buộc thoa Kem chống nắng quang phổ rộng SPF 50+</strong>.
                                                </p>
                                            </div>

                                            <!-- Buổi Tối -->
                                            <div class="p-2.5 rounded-xl bg-purple-50/80 border border-purple-200/90 space-y-1">
                                                <div class="font-bold text-purple-900 flex items-center gap-2">
                                                    <span class="w-6 h-6 rounded-full bg-purple-200/80 text-purple-800 flex items-center justify-center text-[11px]">🌙</span>
                                                    <span>Buổi Tối (PM Routine):</span>
                                                </div>
                                                <p class="text-purple-900/90 text-[11px] leading-relaxed">
                                                    Sử dụng <strong>Tinh Chất Retinol Vi Nang 1.0%</strong> kích thích tăng sinh collagen ban đêm ➔ Áp dụng <em>Kỹ thuật Sandwich Kẹp bánh mì</em> với Kem Ceramide/Vitamin B5.
                                                </p>
                                            </div>
                                        </div>

                                        <!-- Skin Cycling banner -->
                                        <div class="p-2 rounded-xl bg-blue-50/70 border border-blue-200 text-[11px] text-blue-900 flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2">
                                                <i class="fa-solid fa-rotate text-blue-600 text-sm shrink-0"></i>
                                                <span class="text-[11px]"><strong>Lịch Dùng Cách Ngày (Skin Cycling):</strong> Đêm chẵn thoa BHA, Đêm lẻ thoa Retinol; Chủ Nhật dưỡng ẩm phục hồi (Tuyệt đối không thoa chồng cùng buổi).</span>
                                            </div>
                                            <span class="hidden sm:inline-block px-2.5 py-1 rounded-lg bg-blue-100 text-blue-800 font-bold text-[10px] uppercase font-mono shrink-0">
                                                An Toàn 100%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- 1. DANH SÁCH SẢN PHẨM TRONG GIỎ HÀNG (DETAILED CART ITEMS) -->
                    <div class="bg-white rounded-3xl border border-soft-border shadow-xs overflow-hidden">
                        <div class="p-4 sm:p-5 bg-slate-50/70 border-b border-slate-100 flex items-center justify-between text-xs font-bold text-slate-500 uppercase tracking-wider">
                            <span>Sản phẩm & Thông tin Lô FEFO</span>
                            <span class="hidden sm:inline-block">Đơn giá / Thành tiền</span>
                        </div>

                        <div class="divide-y divide-slate-100" id="cartItemsList">
                            @foreach (var item in vm.Items)
                            {
                                var imgUrl = ProductImageResolver.GetThumbnailImageUrl(
                                    item.ProductImageUrl, item.ProductSku, null, item.ProductName);
                                var webpUrl = ProductImageResolver.GetWebpImageUrl(
                                    imgUrl, item.ProductSku, null, item.ProductName);
                                var altText = ProductImageResolver.GetAltText(
                                    item.ProductName, null, null, item.ProductSku, null);

                                <div class="p-3 sm:p-3.5 flex flex-col sm:flex-row items-start sm:items-center gap-3.5 transition hover:bg-slate-50/40 relative group" 
                                     id="cart-row-@item.ProductId"
                                     data-product-id="@item.ProductId">
                                    
                                    <!-- Thumbnail -->
                                    <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border border-slate-200 shrink-0 bg-white p-1 shadow-2xs">
                                        <picture class="block w-full h-full">
                                            <source srcset="@webpUrl" type="image/webp" />
                                            <img src="@imgUrl" alt="@altText" width="80" height="80" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';" class="w-full h-full object-contain transition-transform group-hover:scale-105 duration-300" />
                                        </picture>
                                    </div>

                                    <!-- Name, Variant & FEFO Expiry -->
                                    <div class="flex-1 min-w-0 space-y-1.5">
                                        <a href="/san-pham/@item.ProductId" class="font-serif font-bold text-sm sm:text-base text-charcoal hover:text-magenta-accent transition line-clamp-2 leading-snug">
                                            @item.ProductName
                                        </a>

                                        <!-- Biến thể màu sắc / size / dung tích & Nhãn Hoạt chất Y khoa -->
                                        <div class="flex flex-wrap items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.VariantName))
                                            {
                                                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-700 text-[11px] font-medium border border-slate-200/60">
                                                    <i class="fa-solid fa-swatchbook text-rose-gold text-[10px]"></i>
                                                    <span>@item.VariantName</span>
                                                </div>
                                            }

                                            @if (item.ProductName.Contains("BHA") || item.ProductId == 8)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-amber-100/90 text-amber-900 border border-amber-300 text-[10px] font-bold font-mono">
                                                    <i class="fa-solid fa-flask text-amber-700 text-[9px]"></i> Hoạt chất: BHA 2% (Salicylic Acid)
                                                </span>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-red-100 text-red-700 border border-red-200 text-[9px] font-bold">
                                                    ⚠️ Kỵ với Retinol (Cần tách AM)
                                                </span>
                                            }
                                            else if (item.ProductName.Contains("Retinol") || item.ProductId == 99)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-rose-100/90 text-rose-900 border border-rose-300 text-[10px] font-bold font-mono">
                                                    <i class="fa-solid fa-dna text-rose-700 text-[9px]"></i> Hoạt chất: Retinol Vi Nang 1.0%
                                                </span>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-red-100 text-red-700 border border-red-200 text-[9px] font-bold">
                                                    ⚠️ Kỵ với BHA 2% (Cần tách PM)
                                                </span>
                                            }
                                        </div>

                                        <!-- Thông tin Lô & Hạn dùng FEFO -->
                                        <div>
                                            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg text-[10px] font-semibold border @(item.IsNearExpiration ? "bg-amber-50 text-amber-800 border-amber-200" : "bg-emerald-50 text-emerald-800 border-emerald-200")">
                                                <i class="fa-solid fa-barcode text-[9px]"></i>
                                                <span>@(string.IsNullOrEmpty(item.BatchStatusText) ? $"Lô: LOT-2028 • HSD: {item.NearestExpDateStr} (Date mới 100%)" : item.BatchStatusText)</span>
                                            </div>
                                        </div>

                                        <!-- Đơn giá trên Mobile -->
                                        <div class="text-xs text-slate-500 sm:hidden pt-1">
                                            Đơn giá: <strong class="font-mono text-charcoal">@item.UnitPrice.ToString("N0") ₫</strong>
                                        </div>
                                    </div>

                                    <!-- Đơn giá trên Desktop -->
                                    <div class="hidden sm:block text-right shrink-0">
                                        <span class="font-mono-numeric font-bold text-xs text-slate-600 block">@item.UnitPrice.ToString("N0") ₫</span>
                                        <span class="text-[10px] text-slate-400">Đơn giá</span>
                                    </div>

                                    <!-- Bộ điều khiển số lượng (Stepper) -->
                                    <div class="flex items-center rounded-full border border-slate-200 bg-white p-1 shrink-0 shadow-2xs">
                                        <button type="button" 
                                                @@click="updateQty('@item.ProductId', -1)" 
                                                class="w-7 h-7 rounded-full bg-slate-50 hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-500 transition active:scale-90"
                                                aria-label="Giảm số lượng">
                                            <i class="fa-solid fa-minus text-[9px]"></i>
                                        </button>
                                        <span class="w-10 text-center font-mono-numeric font-bold text-xs text-charcoal" id="qty-@item.ProductId">
                                            @item.Quantity
                                        </span>
                                        <button type="button" 
                                                @@click="updateQty('@item.ProductId', 1)" 
                                                class="w-7 h-7 rounded-full bg-slate-50 hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-500 transition active:scale-90"
                                                aria-label="Tăng số lượng">
                                            <i class="fa-solid fa-plus text-[9px]"></i>
                                        </button>
                                    </div>

                                    <!-- Thành tiền dòng sản phẩm -->
                                    <div class="text-right min-w-[100px] shrink-0">
                                        <span class="font-mono-numeric font-bold text-sm sm:text-base text-magenta-accent block" id="line-total-@item.ProductId">
                                            @item.LineTotal.ToString("N0") ₫
                                        </span>
                                    </div>

                                    <!-- Nút xóa sản phẩm -->
                                    <button type="button" 
                                            @@click="removeItem('@item.ProductId')" 
                                            class="text-slate-300 hover:text-rose-500 transition p-2 rounded-full hover:bg-rose-50"
                                            title="Xóa sản phẩm">
                                        <i class="fa-regular fa-trash-can text-sm"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. DỊCH VỤ HỘP QUÀ TẶNG THƯỢNG LƯU (LUXURY GIFT PACKAGING) -->
                    <div class="p-6 rounded-3xl bg-gradient-to-br from-pink-50/60 via-white to-pastel-rose/40 border border-magenta-accent/25 shadow-xs space-y-4">
                        <div class="flex items-start gap-3.5">
                            <div class="pt-0.5">
                                <input type="checkbox" 
                                       id="chkGiftWrap" 
                                       x-model="isGiftWrapped" 
                                       @@change="toggleGiftWrap()"
                                       class="w-5 h-5 rounded-md text-magenta-accent focus:ring-magenta-accent border-slate-300 cursor-pointer accent-magenta-accent" />
                            </div>
                            <div class="flex-1">
                                <label for="chkGiftWrap" class="font-serif font-bold text-charcoal text-sm sm:text-base cursor-pointer flex flex-wrap items-center gap-2">
                                    <span>Đóng gói làm quà tặng thượng lưu</span>
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-magenta-accent text-white shadow-2xs">
                                        +50.000 ₫
                                    </span>
                                </label>
                                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                                    Món quà hoàn hảo trao gửi trọn vẹn tình cảm đến người thương trong từng chi tiết thủ công:
                                </p>

                                <!-- 3 Đặc quyền của hộp quà thượng lưu -->
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3 text-xs">
                                    <div class="p-2.5 rounded-2xl bg-white/80 border border-pink-100 flex items-center gap-2 text-slate-700">
                                        <span class="text-base">🎁</span>
                                        <span><strong>Hộp cứng phủ nhung</strong> hồng Pastel Rose ép kim logo</span>
                                    </div>
                                    <div class="p-2.5 rounded-2xl bg-white/80 border border-pink-100 flex items-center gap-2 text-slate-700">
                                        <span class="text-base">🎀</span>
                                        <span><strong>Dải ruy băng lụa</strong> Rose Gold thắt nơ thủ công</span>
                                    </div>
                                    <div class="p-2.5 rounded-2xl bg-white/80 border border-pink-100 flex items-center gap-2 text-slate-700">
                                        <span class="text-base">✉️</span>
                                        <span><strong>Thiệp chúc mừng</strong> viết tay nắn nót theo yêu cầu</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ô nhập lời chúc viết tay (khi tick chọn quà tặng) -->
                        <div x-show="isGiftWrapped" 
                             x-transition:enter="transition ease-out duration-300"
                             x-transition:enter-start="opacity-0 -translate-y-2"
                             x-transition:enter-end="opacity-100 translate-y-0"
                             class="pt-3 border-t border-pink-100/80 space-y-2">
                            
                            <div class="flex items-center justify-between text-xs font-semibold text-slate-700">
                                <label for="txtGiftMessage" class="flex items-center gap-1.5 text-magenta-accent">
                                    <i class="fa-solid fa-pen-fancy text-xs"></i>
                                    <span>Nội dung thiệp chúc mừng viết tay:</span>
                                </label>
                                <span class="text-slate-400 font-mono text-[11px]" x-text="giftMessage.length + '/200 ký tự'"></span>
                            </div>

                            <textarea id="txtGiftMessage" 
                                      x-model="giftMessage" 
                                      @@input="updateGiftMessageDebounced()"
                                      maxlength="200"
                                      rows="3" 
                                      placeholder="Ví dụ: Chúc em luôn xinh đẹp, rạng rỡ và ngập tràn hạnh phúc mỗi ngày! Yêu em nhiều..." 
                                      class="w-full px-4 py-3 rounded-2xl border border-pink-200 focus:border-magenta-accent focus:ring-1 focus:ring-magenta-accent focus:outline-none text-xs text-charcoal bg-white leading-relaxed resize-none"></textarea>

                            <!-- Gợi ý lời chúc nhanh dạng Pill -->
                            <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px]">
                                <span class="text-slate-400">Gợi ý nhanh:</span>
                                <button type="button" 
                                        @@click="setQuickWish('Chúc mừng sinh nhật rạng rỡ và luôn ngập tràn hạnh phúc! ✨')" 
                                        class="px-2.5 py-1 rounded-full bg-white hover:bg-magenta-accent hover:text-white text-slate-600 border border-slate-200 transition text-[11px]">
                                    🎂 Sinh nhật
                                </button>
                                <button type="button" 
                                        @@click="setQuickWish('Gửi người phụ nữ tuyệt vời nhất, luôn xinh đẹp và tự tin nhé! 🌸')" 
                                        class="px-2.5 py-1 rounded-full bg-white hover:bg-magenta-accent hover:text-white text-slate-600 border border-slate-200 transition text-[11px]">
                                    💖 Tặng nàng
                                </button>
                                <button type="button" 
                                        @@click="setQuickWish('Món quà nhỏ gửi tặng bạn yêu, chúc bạn luôn tỏa sáng rạng ngời! 💕')" 
                                        class="px-2.5 py-1 rounded-full bg-white hover:bg-magenta-accent hover:text-white text-slate-600 border border-slate-200 transition text-[11px]">
                                    🎁 Bạn thân
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 4. KHỐI GỢI Ý MUA KÈM ƯU ĐÃI (CROSS-SELL CAROUSEL - FLASH +29K) -->
                    <div class="bg-white rounded-3xl border border-soft-border p-6 shadow-xs space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3">
                            <div>
                                <h3 class="font-serif font-bold text-base text-charcoal flex items-center gap-2">
                                    <i class="fa-solid fa-fire text-amber-500 text-sm"></i>
                                    <span>Gợi Ý Mua Kèm Ưu Đãi Độc Quyền</span>
                                </h3>
                                <p class="text-xs text-slate-400 mt-0.5">
                                    Ưu đãi flash deal đặc quyền chỉ áp dụng mua kèm giỏ hàng hiện tại với giá <strong>29.000₫</strong>
                                </p>
                            </div>
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-bold border border-amber-200/80 self-start sm:self-auto">
                                Đồng giá 29.000₫
                            </span>
                        </div>

                        <!-- Cross-sell Carousel Grid (3 items) -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            @foreach (var cs in vm.CrossSellItems)
                            {
                                var csImg = ProductImageResolver.GetPrimaryImageUrl(cs.ImageUrl, null, null, cs.ProductName);
                                var csWebp = ProductImageResolver.GetWebpImageUrl(csImg, null, null, cs.ProductName);
                                var csAlt = ProductImageResolver.GetAltText(cs.ProductName);
                                <div class="p-4 rounded-2xl border border-slate-200/90 hover:border-magenta-accent/60 bg-gradient-to-b from-white to-slate-50/50 hover:shadow-md transition-all flex flex-col justify-between space-y-3 group">
                                    <div>
                                        <div class="relative aspect-square rounded-xl overflow-hidden bg-slate-100 mb-2.5">
                                            <picture class="block w-full h-full">
                                                <source srcset="@csWebp" type="image/webp" />
                                                <img src="@csImg" alt="@csAlt" width="240" height="240" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='@ProductImageResolver.PlaceholderUrl';" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                                            </picture>
                                            <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-magenta-accent text-white text-[10px] font-bold shadow-2xs">
                                                @cs.BadgeText
                                            </span>
                                        </div>

                                        <h4 class="font-bold text-xs text-charcoal line-clamp-2 leading-snug group-hover:text-magenta-accent transition">
                                            @cs.ProductName
                                        </h4>
                                        <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">
                                            @cs.Description
                                        </p>
                                    </div>

                                    <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
                                        <div>
                                            <span class="font-mono font-bold text-magenta-accent text-sm block">@cs.SpecialPrice.ToString("N0") ₫</span>
                                            <span class="font-mono text-slate-400 text-[10px] line-through block">@cs.OriginalPrice.ToString("N0") ₫</span>
                                        </div>

                                        <button type="button" 
                                                @@click="addCrossSell(@cs.ProductId)" 
                                                class="px-3 py-1.5 rounded-full bg-charcoal hover:bg-magenta-accent text-white text-xs font-bold transition flex items-center gap-1.5 shadow-2xs shrink-0">
                                            <i class="fa-solid fa-plus text-[10px]"></i>
                                            <span>Thêm +29K</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Cam kết chất lượng chính ngạch -->
                    <div class="p-4 rounded-2xl bg-white border border-slate-200 flex items-center gap-3 text-xs text-slate-600">
                        <i class="fa-solid fa-shield-halved text-emerald-600 text-xl shrink-0"></i>
                        <span>Cam kết 100% mỹ phẩm nhập khẩu chính ngạch có tem vỡ Bộ Công An. Hoàn tiền 200% nếu phát hiện hàng giả hoặc cận date không đúng thông báo FEFO.</span>
                    </div>

                </div>

                <!-- =========================================================================
                     RIGHT COLUMN (4 COLS): VOUCHER & TỔNG TIỀN THANH TOÁN
                     ========================================================================= -->
                <div class="lg:col-span-4 space-y-3.5">

                    <!-- Coupon Code Card -->
                    <div class="bg-white p-6 rounded-3xl border border-soft-border shadow-xs space-y-3">
                        <h4 class="font-bold text-charcoal text-xs uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-ticket text-magenta-accent"></i> Mã Giảm Giá / Voucher
                        </h4>
                        
                        <div class="flex gap-2">
                            <input type="text" 
                                   x-model="couponCode" 
                                   placeholder="Nhập mã ưu đãi..." 
                                   class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-mono uppercase focus:border-magenta-accent focus:outline-none" />
                            <button type="button" 
                                    @@click="applyCoupon()" 
                                    class="px-5 py-2.5 rounded-xl bg-charcoal text-white font-bold text-xs hover:bg-magenta-accent transition shrink-0">
                                Áp Dụng
                            </button>
                        </div>

                        <!-- Feedback Message -->
                        <div x-show="couponMessage" 
                             :class="couponSuccess ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-red-700 bg-red-50 border-red-200'"
                             class="p-2.5 rounded-xl border text-[11px] leading-snug" 
                             style="display: none;" 
                             x-text="couponMessage">
                        </div>

                        <div class="text-[10px] text-slate-400">
                            Gợi ý mã hot: <button type="button" @@click="couponCode = 'BEAUTY10'; applyCoupon()" class="text-magenta-accent font-bold hover:underline font-mono">BEAUTY10</button> (Giảm 10% đơn từ 200K)
                        </div>
                    </div>

                    <!-- Summary Card (Sticky) -->
                    <div class="bg-white p-6 sm:p-7 rounded-3xl border border-soft-border shadow-xs space-y-4 sticky top-24">
                        <h4 class="font-serif font-bold text-charcoal text-base border-b border-soft-border pb-3 flex items-center justify-between">
                            <span>Tóm Tắt Đơn Hàng</span>
                            <span class="text-xs font-sans text-slate-400 font-normal">Tạm tính</span>
                        </h4>

                        <div class="space-y-3 text-xs">
                            <div class="flex items-center justify-between text-slate-600">
                                <span>Tiền hàng (<span x-text="totalItems">@vm.TotalItems</span> món):</span>
                                <span class="font-mono-numeric font-bold text-charcoal" x-text="subTotal">@vm.SubTotal.ToString("N0") ₫</span>
                            </div>

                            <div class="flex items-center justify-between text-slate-600" x-show="discountAmount !== '0 ₫'">
                                <span>Giảm giá voucher:</span>
                                <span class="font-mono-numeric font-bold text-emerald-600" x-text="'-' + discountAmount">-@vm.DiscountAmount.ToString("N0") ₫</span>
                            </div>

                            <!-- Dòng phí hộp quà tặng nếu có -->
                            <div class="flex items-center justify-between text-slate-600" x-show="isGiftWrapped">
                                <span class="flex items-center gap-1.5 text-magenta-accent font-medium">
                                    <span>🎁 Hộp quà thượng lưu:</span>
                                </span>
                                <span class="font-mono-numeric font-bold text-magenta-accent">+50.000 ₫</span>
                            </div>

                            <!-- Phí vận chuyển -->
                            <div class="flex items-center justify-between text-slate-600">
                                <span>Phí vận chuyển:</span>
                                <span class="font-mono-numeric font-bold" 
                                      :class="shippingFee === 'Miễn phí' ? 'text-emerald-600 font-bold' : 'text-charcoal'" 
                                      x-text="shippingFee">
                                    @(vm.ShippingFee == 0 ? "Miễn phí" : vm.ShippingFee.ToString("N0") + " ₫")
                                </span>
                            </div>
                        </div>

                        <!-- Tổng thanh toán cuối cùng -->
                        <div class="border-t border-soft-border pt-4 flex items-baseline justify-between">
                            <div>
                                <span class="font-bold text-charcoal text-sm block">Tổng thanh toán:</span>
                                <span class="text-[10px] text-slate-400">Đã bao gồm VAT</span>
                            </div>
                            <span class="font-mono-numeric font-bold text-2xl text-magenta-accent" x-text="finalTotal">
                                @vm.FinalTotal.ToString("N0") ₫
                            </span>
                        </div>

                        <!-- CTA Button -->
                        <a href="/Checkout" class="w-full py-4 rounded-full bg-magenta-accent text-white font-bold text-xs uppercase tracking-wider text-center block hover:bg-[#b0276a] shadow-lg shadow-magenta-accent/25 hover:shadow-xl hover:shadow-magenta-accent/35 transition-all duration-300 flex items-center justify-center gap-2">
                            <span>Tiến Hành Đặt Hàng</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>

                        <!-- Security Badges -->
                        <div class="pt-3 border-t border-slate-100 flex items-center justify-center gap-4 text-slate-400 text-xs">
                            <span class="flex items-center gap-1 text-[11px]"><i class="fa-solid fa-lock text-emerald-600"></i> Thanh toán an toàn</span>
                            <span>•</span>
                            <span class="flex items-center gap-1 text-[11px]"><i class="fa-solid fa-clock text-amber-500"></i> Giữ tồn kho FEFO 15p</span>
                        </div>
                    </div>

                </div>

            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        function cartPage() {
            return {
                couponCode: '',
                couponMessage: '',
                couponSuccess: false,
                totalItems: @vm.TotalItems,
                subTotal: '@vm.SubTotal.ToString("N0") ₫',
                discountAmount: '@vm.DiscountAmount.ToString("N0") ₫',
                shippingFee: @Html.Raw(vm.ShippingFee == 0 ? "'Miễn phí'" : $"'{vm.ShippingFee:N0} ₫'"),
                finalTotal: '@vm.FinalTotal.ToString("N0") ₫',
                isGiftWrapped: @(vm.IsGiftWrapped ? "true" : "false"),
                giftMessage: '@Html.Raw(JavaScriptEncoder.Default.Encode(vm.GiftMessage ?? ""))',
                freeShippingRemaining: @remaining,
                freeShippingRemainingFormatted: '@remaining.ToString("N0") ₫',
                freeShippingProgress: @Math.Round(progress, 1),
                isFreeShipping: @(vm.IsFreeShipping ? "true" : "false"),
                giftMessageTimer: null,

                setQuickWish(text) {
                    this.giftMessage = text;
                    this.updateGiftMessageDebounced();
                },

                updateGiftMessageDebounced() {
                    clearTimeout(this.giftMessageTimer);
                    this.giftMessageTimer = setTimeout(() => {
                        this.saveGiftPackagingToServer();
                    }, 500);
                },

                async toggleGiftWrap() {
                    await this.saveGiftPackagingToServer();
                },

                async saveGiftPackagingToServer() {
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const res = await fetch('/Cart/UpdateGiftPackaging', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({
                                isGiftWrapped: this.isGiftWrapped,
                                giftMessage: this.giftMessage
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.finalTotal = data.finalTotalFormatted;
                            if (typeof showStorefrontToast === 'function') {
                                showStorefrontToast(data.message, this.isGiftWrapped ? 'success' : 'info');
                            }
                        }
                    } catch (e) {
                        console.error('Lỗi lưu hộp quà tặng:', e);
                    }
                },

                async updateQty(productId, delta) {
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const res = await fetch('/Cart/UpdateQuantity', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ productId: productId.toString(), delta: delta })
                        });
                        const data = await res.json();
                        if (data.success) {
                            if (data.itemQuantity <= 0) {
                                document.getElementById('cart-row-' + productId)?.remove();
                            } else {
                                const qtyEl = document.getElementById('qty-' + productId);
                                const lineEl = document.getElementById('line-total-' + productId);
                                if (qtyEl) qtyEl.innerText = data.itemQuantity;
                                if (lineEl) lineEl.innerText = data.itemLineTotal;
                            }

                            this.totalItems = data.totalItems;
                            this.subTotal = data.subTotal;
                            this.discountAmount = data.discountAmount;
                            this.shippingFee = data.shippingFee;
                            this.finalTotal = data.finalTotal;
                            this.freeShippingRemaining = data.freeShippingRemaining;
                            this.freeShippingRemainingFormatted = data.freeShippingRemainingFormatted;
                            this.freeShippingProgress = data.freeShippingProgress;
                            this.isFreeShipping = data.isFreeShipping;

                            // Update MiniCart sync badge on header
                            const badge = document.getElementById('miniCartCountBadge');
                            if (badge) badge.innerText = data.totalItems;
                            const totalHeader = document.getElementById('miniCartHeaderTotal');
                            if (totalHeader) totalHeader.innerText = data.subTotal;

                            if (data.totalItems === 0) {
                                window.location.reload();
                            }
                        }
                    } catch (e) {
                        console.error('Lỗi cập nhật giỏ hàng:', e);
                    }
                },

                async removeItem(productId) {
                    Swal.fire({
                        title: 'Xóa sản phẩm?',
                        text: 'Bạn có chắc chắn muốn bỏ sản phẩm này khỏi giỏ hàng?',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#c2185b',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Đồng ý xóa',
                        cancelButtonText: 'Hủy'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            try {
                                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                                const res = await fetch('/Cart/RemoveItem', {
                                    method: 'POST',
                                    headers: { 
                                        'Content-Type': 'application/json',
                                        'RequestVerificationToken': token
                                    },
                                    body: JSON.stringify({ productId: productId.toString() })
                                });
                                const data = await res.json();
                                if (data.success) {
                                    document.getElementById('cart-row-' + productId)?.remove();
                                    this.totalItems = data.totalItems;
                                    this.subTotal = data.subTotalFormatted;
                                    this.shippingFee = data.shippingFee;
                                    this.finalTotal = data.finalTotal;
                                    this.freeShippingRemaining = data.freeShippingRemaining;
                                    this.freeShippingRemainingFormatted = data.freeShippingRemainingFormatted;
                                    this.freeShippingProgress = data.freeShippingProgress;
                                    this.isFreeShipping = data.isFreeShipping;

                                    if (typeof showStorefrontToast === 'function') {
                                        showStorefrontToast('Đã xóa sản phẩm khỏi giỏ hàng.', 'info');
                                    }
                                    if (data.totalItems === 0) {
                                        setTimeout(() => window.location.reload(), 400);
                                    }
                                }
                            } catch (e) {
                                console.error('Lỗi xóa sản phẩm:', e);
                            }
                        }
                    });
                },

                async addCrossSell(crossSellId) {
                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const res = await fetch('/Cart/AddCrossSell', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ crossSellId: crossSellId })
                        });
                        const data = await res.json();
                        if (data.success) {
                            if (typeof showStorefrontToast === 'function') {
                                showStorefrontToast(data.message, 'success');
                            }
                            // Reload softly to show the new item in table with full variant and batch details
                            setTimeout(() => {
                                window.location.reload();
                            }, 500);
                        } else {
                            if (typeof showStorefrontToast === 'function') {
                                showStorefrontToast(data.message || 'Không thể thêm sản phẩm', 'error');
                            }
                        }
                    } catch (e) {
                        console.error('Lỗi thêm mua kèm:', e);
                    }
                },

                async applyCoupon() {
                    if (!this.couponCode.trim()) {
                        this.couponMessage = 'Vui lòng nhập mã giảm giá.';
                        this.couponSuccess = false;
                        return;
                    }

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        const res = await fetch('/Cart/ApplyCoupon', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({ couponCode: this.couponCode.trim() })
                        });
                        const data = await res.json();
                        this.couponMessage = data.message;
                        this.couponSuccess = data.success;
                        if (data.success) {
                            this.discountAmount = data.discountFormatted;
                            this.shippingFee = data.shippingFeeFormatted;
                            this.finalTotal = data.finalTotalFormatted;
                            if (typeof showStorefrontToast === 'function') {
                                showStorefrontToast(data.message, 'success');
                            }
                        }
                    } catch (e) {
                        this.couponMessage = 'Lỗi kết nối máy chủ.';
                        this.couponSuccess = false;
                    }
                }
            };
        }

        function recentlyViewedInCart() {
            return {
                products: [],
                loading: false,

                async init() {
                    try {
                        const stored = localStorage.getItem('omni_recently_viewed_ids');
                        if (!stored) return;
                        const ids = JSON.parse(stored);
                        if (!Array.isArray(ids) || ids.length === 0) return;

                        this.loading = true;
                        const res = await fetch('/api/products/by-ids?ids=' + ids.slice(0, 4).join(','));
                        if (res.ok) {
                            this.products = await res.json();
                        }
                    } catch (e) { }
                    finally {
                        this.loading = false;
                    }
                },

                async quickAddToCart(item) {
                    try {
                        const res = await fetch('/api/cart/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ productId: item.id, quantity: 1 })
                        });
                        const data = await res.json();
                        if (data && data.success) {
                            window.dispatchEvent(new CustomEvent('cart-updated', { detail: data }));
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Đã thêm ' + item.name + ' vào giỏ!',
                                    showConfirmButton: false,
                                    timer: 2000
                                });
                            }
                            // Tải lại trang giỏ hàng để cập nhật trạng thái
                            setTimeout(() => { window.location.reload(); }, 600);
                        }
                    } catch (e) { }
                },

                formatPrice(val) {
                    if (!val) return '0 ₫';
                    return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
                }
            };
        }
    </script>
}