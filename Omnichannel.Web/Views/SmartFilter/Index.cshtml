                                <div class="p-4 space-y-2">
                                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block" x-text="p.categoryName"></span>
                                    <a :href="'/Product/Detail/' + (p.slug || p.id)" class="font-bold text-xs text-charcoal line-clamp-2 hover:text-magenta-accent transition" x-text="p.name"></a>
                                    
