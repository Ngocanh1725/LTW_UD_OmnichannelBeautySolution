                    </template>
                </div>

                <!-- Nút Chẩn Đoán Lại & In Kết Quả -->
                <div class="pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center gap-4">
                    <button type="button" 
                            x-on:click="resetWizard()" 
                            class="px-6 py-3 rounded-full border border-slate-300 text-slate-700 hover:bg-slate-50 text-xs font-bold transition flex items-center gap-2">
                        <i class="fa-solid fa-rotate-left"></i> Chẩn Đoán Lại Cho Người Khác
                    </button>
                    
                    <a href="/Product" class="px-8 py-3 rounded-full bg-charcoal text-white hover:bg-magenta-accent text-xs font-bold uppercase tracking-wider transition shadow-md flex items-center gap-2">
                        <i class="fa-solid fa-bag-shopping"></i> Khám Phá Toàn Bộ Cửa Hàng
                    </a>
                </div>

            </div>

            <!-- CÔNG CỤ TRA CỨU TƯƠNG KỴ & HIỆP ĐỒNG HOẠT CHẤT DA LIỄU ĐỘC LẬP (INTERACTIVE INGREDIENT CONFLICT CHECKER) -->
            <div class="bg-gradient-to-br from-white via-pink-50/20 to-purple-50/20 rounded-3xl border border-soft-border p-6 sm:p-10 shadow-xl shadow-pink-500/5 space-y-6">
                <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-pink-100">
                    <div>
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pastel-rose text-magenta-accent text-xs font-bold mb-1">
                            <i class="fa-solid fa-atom"></i>
                            <span>PHÒNG LAB DA LIỄU AI</span>
                        </div>
                        <h3 class="font-serif text-2xl font-bold text-charcoal">
                            Tra Cứu Tương Kỵ & Hiệp Đồng Hoạt Chất Độc Lập
                        </h3>
                        <p class="text-xs text-slate-500">
                            Thử nghiệm kết hợp bất kỳ hoạt chất nào để kiểm tra cảnh báo xung đột (Conflict) hoặc phát hiện hiệp đồng vàng (Synergy) theo chuẩn Y khoa Quốc tế.
                        </p>
                    </div>

                    <button type="button" 
                            x-on:click="checkInteractiveConflicts()" 
                            :disabled="selectedIngredients.length < 2 || isCheckingConflicts"
                            class="px-6 py-3 rounded-full bg-charcoal text-white hover:bg-magenta-accent disabled:opacity-50 disabled:cursor-not-allowed text-xs font-bold transition-all shadow-md flex items-center gap-2">
                        <template x-if="isCheckingConflicts">
                            <i class="fa-solid fa-spinner fa-spin"></i>
                        </template>
                        <template x-if="!isCheckingConflicts">
                            <i class="fa-solid fa-vial-circle-check"></i>
                        </template>
                        <span>Phân Tích Ma Trận (<span x-text="selectedIngredients.length"></span>)</span>
                    </button>
                </div>

                <!-- Danh sách 12 Hoạt chất chọn lựa (Pill selection) -->
                <div class="space-y-2">
                    <span class="text-xs font-bold text-slate-700 block">Chọn từ 2 hoạt chất trở lên để kiểm tra:</span>
                    <div class="flex flex-wrap gap-2.5">
                        <template x-for="ing in commonIngredients" :key="ing.key">
                            <button type="button"
                                    x-on:click="toggleIngredient(ing.key)"
                                    class="px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5"
                                    :class="selectedIngredients.includes(ing.key) 
                                        ? 'bg-gradient-to-r from-pink-500 to-rose-600 text-white border-transparent shadow-xs scale-102' 
                                        : 'bg-white text-slate-700 border-slate-200 hover:border-slate-300 hover:bg-slate-50'">
                                <i class="fa-solid" :class="selectedIngredients.includes(ing.key) ? 'fa-circle-check text-white' : 'fa-circle-plus text-slate-400'"></i>
                                <span x-text="ing.name"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <!-- Kết Quả Phân Tích Ma Trận Tương Tác Trực Quan -->
                <template x-if="conflictResults">
                    <div class="pt-4 border-t border-slate-100 space-y-4" x-transition>
                        
                        <!-- Header Kết Quả -->
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-charcoal flex items-center gap-2">
                                <i class="fa-solid fa-microscope text-magenta-accent"></i>
                                <span>Kết Quả Đối Soát Ma Trận Hóa Sinh:</span>
                            </span>

                            <span class="text-[11px] font-bold px-3 py-1 rounded-full"
                                  :class="conflictResults.hasCriticalConflicts ? 'bg-red-100 text-red-700 border border-red-200' : 'bg-emerald-100 text-emerald-800 border border-emerald-200'"
                                  x-text="conflictResults.hasCriticalConflicts ? '⚠️ CẢNH BÁO: CÓ XUNG ĐỘT KỴ NHAU' : '✨ AN TOÀN / HIỆP ĐỒNG HOÀN HẢO'"></span>
                        </div>

                        <!-- Nếu không có tương tác nào phát sinh -->
                        <template x-if="conflictResults.interactions.length === 0">
                            <div class="p-4 rounded-2xl bg-emerald-50/60 border border-emerald-200 text-xs text-emerald-900 flex items-center gap-3">
                                <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
                                <div>
                                    <strong class="block">Các hoạt chất này an toàn để kết hợp!</strong>
                                    <span class="text-[11px] text-emerald-700">Không ghi nhận phản ứng hóa học tiêu cực hay tương kỵ nồng độ nào giữa các hoạt chất bạn đã chọn.</span>
                                </div>
                            </div>
                        </template>

                        <!-- Danh sách các tương tác tìm thấy -->
                        <div class="space-y-3">
                            <template x-for="(inter, cIdx) in conflictResults.interactions" :key="cIdx">
                                <div class="p-4 rounded-2xl border text-xs space-y-2 shadow-xs transition"
                                     :class="{
                                         'bg-red-50/70 border-red-200': inter.severityBadge === 'DANGER',
                                         'bg-amber-50/70 border-amber-200': inter.severityBadge === 'WARNING',
                                         'bg-emerald-50/70 border-emerald-200': inter.severityBadge === 'SUCCESS_SYNERGY'
                                     }">
                                    
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="font-bold text-sm text-charcoal flex items-center gap-2">
                                            <i class="fa-solid text-sm"
                                               :class="{
                                                   'fa-triangle-exclamation text-red-600': inter.severityBadge === 'DANGER',
                                                   'fa-circle-exclamation text-amber-600': inter.severityBadge === 'WARNING',
                                                   'fa-wand-magic-sparkles text-emerald-600': inter.severityBadge === 'SUCCESS_SYNERGY'
                                               }"></i>
                                            <span x-text="inter.ingredientA + ' ⚡ ' + inter.ingredientB"></span>
                                        </div>

                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold"
                                              :class="{
                                                  'bg-red-600 text-white': inter.severityBadge === 'DANGER',
                                                  'bg-amber-500 text-white': inter.severityBadge === 'WARNING',
                                                  'bg-emerald-600 text-white': inter.severityBadge === 'SUCCESS_SYNERGY'
                                              }"
                                              x-text="inter.severityBadge === 'DANGER' ? 'TƯƠNG KỴ NGUY HIỂM' : (inter.severityBadge === 'WARNING' ? 'CẢNH BÁO QUÁ TẢI' : 'HIỆP ĐỒNG VÀNG')"></span>
                                    </div>

                                    <div class="p-2.5 rounded-xl bg-white/80 border border-slate-100 text-[11px] text-slate-700 leading-relaxed">
                                        <strong class="text-slate-900 block mb-0.5"><i class="fa-solid fa-flask text-indigo-500"></i> Cơ chế:</strong>
                                        <span x-text="inter.scientificExplanation"></span>
                                    </div>

                                    <div class="p-2.5 rounded-xl border text-[11px] leading-relaxed"
                                         :class="{
                                             'bg-rose-100/60 border-rose-200 text-rose-900': inter.severityBadge === 'DANGER',
                                             'bg-amber-100/60 border-amber-200 text-amber-900': inter.severityBadge === 'WARNING',
                                             'bg-emerald-100/60 border-emerald-200 text-emerald-900': inter.severityBadge === 'SUCCESS_SYNERGY'
                                         }">
                                        <strong class="block mb-0.5"><i class="fa-solid fa-lightbulb"></i> Khuyến nghị da liễu:</strong>
                                        <span x-text="inter.recommendedResolution"></span>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </template>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function skinDiagnosticWizard() {
            return {
                currentStep: 1,
                isAnalyzing: false,
                result: null,

                answers: {
                    noonFeeling: 'tzone_oily',
                    primaryConcern: 'acne_pore',
                    ageGroup: '20_29',
                    environment: 'office_ac',
                    budgetBracket: '300k_500k',
                    isPregnantOrNursing: false
                },

                // Interactive Conflict Checker State
                commonIngredients: [],
                selectedIngredients: ['retinol', 'bha'],
                conflictResults: null,
                isCheckingConflicts: false,

                async init() {
                    try {
                        const res = await fetch('/SmartFilter/GetCommonIngredients');
                        const json = await res.json();
                        if (json.success) {
                            this.commonIngredients = json.data;
                        }
                    } catch (e) {
                        console.error('Không thể tải danh sách hoạt chất:', e);
                    }
                },

                toggleIngredient(key) {
                    const idx = this.selectedIngredients.indexOf(key);
                    if (idx > -1) {
                        this.selectedIngredients.splice(idx, 1);
                    } else {
                        this.selectedIngredients.push(key);
                    }
                    this.conflictResults = null;
                },

                async checkInteractiveConflicts() {
                    if (this.selectedIngredients.length < 2) return;
                    this.isCheckingConflicts = true;

                    try {
                        const res = await fetch('/SmartFilter/CheckConflicts', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ ingredientNames: this.selectedIngredients })
                        });
                        const json = await res.json();
                        if (json.success) {
                            this.conflictResults = json.data;
                        } else {
                            alert(json.message || 'Lỗi kiểm tra tương kỵ.');
                        }
                    } catch (e) {
                        console.error(e);
                        alert('Lỗi kết nối kiểm tra xung đột hoạt chất.');
                    } finally {
                        this.isCheckingConflicts = false;
                    }
                },

                // Tính toán tọa độ ngũ giác cho biểu đồ SVG Radar
                get radarCoordinates() {
                    if (!this.result || !this.result.radarScores) return [];
                    const scores = this.result.radarScores;
                    const center = 150;
                    const maxRadius = 120; // từ r=0 đến r=120

                    // 5 góc ngũ giác (Top, Top-Right, Bottom-Right, Bottom-Left, Top-Left)
                    const angles = [
                        -Math.PI / 2,
                        -Math.PI / 2 + (2 * Math.PI / 5),
                        -Math.PI / 2 + (4 * Math.PI / 5),
                        -Math.PI / 2 + (6 * Math.PI / 5),
                        -Math.PI / 2 + (8 * Math.PI / 5)
                    ];

                    const vals = [
                        scores.hydration || 50,
                        scores.sebumBalance || 50,
                        scores.firmness || 50,
                        scores.barrierStrength || 50,
                        scores.radiance || 50
                    ];

                    return vals.map((v, i) => {
                        const r = (v / 100) * maxRadius;
                        return {
                            x: Math.round(center + r * Math.cos(angles[i])),
                            y: Math.round(center + r * Math.sin(angles[i]))
                        };
                    });
                },

                get radarPoints() {
                    const coords = this.radarCoordinates;
                    if (!coords.length) return '';
                    return coords.map(p => `${p.x},${p.y}`).join(' ');
                },

                async submitDiagnosis() {
                    this.isAnalyzing = true;
                    this.result = null;

                    try {
                        const res = await fetch('/SmartFilter/Diagnose', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.answers)
                        });

                        const json = await res.json();
                        
                        // Mô phỏng AI Deep Learning scan trong 900ms để tạo hiệu ứng công nghệ cao
                        setTimeout(() => {
                            this.isAnalyzing = false;
                            if (json.success) {
                                this.result = json.data;
                                window.scrollTo({ top: 300, behavior: 'smooth' });
                            } else {
                                alert(json.message || 'Lỗi xử lý chẩn đoán.');
                            }
                        }, 900);
                    } catch (e) {
                        this.isAnalyzing = false;
                        alert('Lỗi kết nối máy chủ AI.');
                        console.error(e);
                    }
                },

                resetWizard() {
                    this.currentStep = 1;
                    this.result = null;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                },

                async addToCart(productId) {
                    try {
                        const res = await fetch('/Cart/AddToCart', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `productId=${productId}&quantity=1`
                        });

                        if (res.ok) {
                            if (typeof showStorefrontToast === 'function') {
                                showStorefrontToast('Đã thêm sản phẩm tương thích vào giỏ hàng!', 'success');
                            } else {
                                alert('Đã thêm sản phẩm vào giỏ hàng thành công!');
                            }
                        } else {
                            alert('Không thể thêm vào giỏ hàng lúc này.');
                        }
                    } catch (e) {
                        console.error(e);
                        alert('Lỗi kết nối khi thêm giỏ hàng.');
                    }
                }
            }
        }
    </script>
}
