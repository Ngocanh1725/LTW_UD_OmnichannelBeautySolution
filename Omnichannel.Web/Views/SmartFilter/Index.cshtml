                                    </div>

                                    <!-- Match Reason -->
                                    <p class="text-[11px] text-emerald-700 bg-emerald-50/70 p-2 rounded-xl border border-emerald-100 line-clamp-2" x-text="p.matchReasons?.[0] || 'Tối ưu cho tình trạng biểu bì hiện tại'"></p>
                                </div>
                            </div>

                            <!-- Footer Price & CTA -->
                            <div class="p-4 pt-0 border-t border-slate-50 flex items-center justify-between gap-2 mt-2">
                                <div>
                                    <span class="font-mono text-sm font-bold text-magenta-accent" x-text="p.price.toLocaleString('vi-VN') + ' ₫'"></span>
                                    <template x-if="p.originalPrice">
                                        <span class="text-[10px] line-through text-slate-400 block font-mono" x-text="p.originalPrice.toLocaleString('vi-VN') + ' ₫'"></span>
                                    </template>
                                </div>

                                <button type="button" 
                                        x-on:click="addToCart(p.id)" 
                                        class="px-3.5 py-2 rounded-xl bg-charcoal text-white hover:bg-magenta-accent text-xs font-bold transition flex items-center gap-1.5 shadow-xs">
