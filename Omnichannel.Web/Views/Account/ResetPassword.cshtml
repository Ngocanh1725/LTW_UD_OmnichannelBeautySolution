@model Omnichannel.Application.DTOs.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu - Omni Beauty";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Omni Beauty</title>
    <!-- Brand Identity & Multi-Resolution Favicons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/branding/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/branding/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/images/branding/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/branding/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --rose-gold: #B76E79;
            --rose-gold-light: #F5D6DA;
            --magenta-accent: #D63384;
            --champagne-gold: #D4AF37;
            --pastel-rose: #FDF2F4;
            --bg-gradient: linear-gradient(135deg, #FFF7F8 0%, #FDF2F4 50%, #F8E9EC 100%);
            --card-shadow: 0 25px 50px -12px rgba(183, 110, 121, 0.22);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 30px 20px;
        }

        .auth-card {
            background: #FFFFFF;
            border-radius: 28px;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(183, 110, 121, 0.18);
            max-width: 480px;
            width: 100%;
            padding: 40px 36px;
            position: relative;
            overflow: hidden;
        }

        .auth-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #B76E79 0%, #D4AF37 50%, #D63384 100%);
        }

        .brand-avatar {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            padding: 2.5px;
            background: linear-gradient(135deg, #B76E79 0%, #D4AF37 50%, #D63384 100%);
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 24px -4px rgba(214, 51, 132, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            animation: brandPulseGlow 3s infinite alternate ease-in-out;
        }

        .brand-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background: #FFFFFF;
        }

        @@keyframes brandPulseGlow {
            0% {
                box-shadow: 0 0 12px rgba(214, 51, 132, 0.25), 0 0 20px rgba(183, 110, 121, 0.15);
            }
            50% {
                box-shadow: 0 0 24px rgba(214, 51, 132, 0.5), 0 0 35px rgba(212, 175, 55, 0.35);
            }
            100% {
                box-shadow: 0 0 14px rgba(214, 51, 132, 0.3), 0 0 22px rgba(183, 110, 121, 0.2);
            }
        }

        .instruction-box {
            background: linear-gradient(135deg, #FFF5F7 0%, #FFF9FA 100%);
            border: 1px solid rgba(214, 51, 132, 0.2);
            border-radius: 16px;
            padding: 16px;
            font-size: 13px;
            color: #4A5568;
            margin-bottom: 20px;
        }

        .otp-input-field {
            font-family: monospace;
            font-size: 20px;
            letter-spacing: 0.3em;
            text-align: center;
            font-weight: 700;
            color: var(--magenta-accent);
        }

        .form-control {
            border-radius: 14px;
            padding: 11px 16px;
            border: 1.5px solid #F3E4E8;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: var(--magenta-accent);
            box-shadow: 0 0 0 4px rgba(214, 51, 132, 0.12);
        }

        .input-group-text {
            background: #FFF5F7;
            border: 1.5px solid #F3E4E8;
            border-right: none;
            border-radius: 14px 0 0 14px;
            color: var(--rose-gold);
            font-size: 14px;
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 14px 14px 0;
        }

        .btn-toggle-pwd {
            background: #FFF5F7;
            border: 1.5px solid #F3E4E8;
            border-left: none;
            border-radius: 0 14px 14px 0;
            color: #94A3B8;
            cursor: pointer;
        }

        .btn-toggle-pwd:hover {
            color: var(--magenta-accent);
        }

        .btn-gradient {
            background: linear-gradient(135deg, #D63384 0%, #B76E79 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 13px;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            box-shadow: 0 8px 20px -4px rgba(214, 51, 132, 0.35);
            transition: all 0.3s ease;
        }

        .btn-gradient:hover {
            opacity: 0.96;
            transform: translateY(-1px);
            color: #FFFFFF;
            box-shadow: 0 12px 24px -4px rgba(214, 51, 132, 0.45);
        }

        /* Password Strength Bar */
        .strength-bar-bg {
            height: 5px;
            background: #F1E5E8;
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            gap: 3px;
            margin-top: 6px;
        }

        .strength-segment {
            flex: 1;
            height: 100%;
            background: #E2E8F0;
            border-radius: 3px;
            transition: background 0.3s ease;
        }

        .validation-hint {
            font-size: 11px;
            color: #94A3B8;
            margin-top: 3px;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Logo trung tâm Omni Beauty -->
        <div class="text-center mb-3">
            <div class="brand-avatar">
                <img src="~/images/branding/logo-circle.png" alt="Omni Beauty Logo" />
            </div>
            <h3 class="fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif; letter-spacing: 0.12em;">OMNI BEAUTY</h3>
            <p class="small text-uppercase fw-semibold mb-0" style="color: var(--magenta-accent); letter-spacing: 0.22em; font-size: 10px;">Haute Parfumerie & Cosmetics</p>
            <p class="text-muted small mt-1 mb-0" style="font-size: 12px;">Thiết Lập Mật Khẩu Mới</p>
        </div>

        <!-- Hộp hướng dẫn kiểm tra hòm thư -->
        <div class="instruction-box">
            <div class="d-flex items-center gap-2 mb-1">
                <i class="fa-solid fa-circle-info text-info"></i>
                <strong class="text-dark">Kiểm tra hòm thư của bạn:</strong>
            </div>
            <p class="mb-1" style="font-size: 12px;">
                Mã xác thực OTP 6 số đã được gửi đến email của bạn. Vui lòng kiểm tra hộp thư đến (Inbox) hoặc Thư rác (Spam).
            </p>
            @if (TempData["DemoOtp"] != null)
            {
                <div class="alert alert-warning py-1.5 px-2.5 rounded-3 small mb-0 mt-2 border-0 bg-warning-subtle text-dark d-flex align-items-center justify-content-between" style="font-size: 11.5px;">
                    <div>
                        <i class="fa-solid fa-flask-vial text-warning me-1"></i>
                        <span>Mã OTP thử nghiệm nhanh: <strong>@TempData["DemoOtp"]</strong></span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-dark py-0 px-2 rounded-pill" style="font-size: 10px;" onclick="document.getElementById('TokenInput').value='@TempData["DemoOtp"]'">
                        Điền ngay
                    </button>
                </div>
            }
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 rounded-3 small mb-3 border-0 bg-success-subtle text-success d-flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i>
                <span style="font-size: 12px;">@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger-subtle text-danger">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="ResetPassword" method="post" id="resetPwdForm">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email nhận mã</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" id="EmailInput" class="form-control bg-light" readonly />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Mã xác thực OTP -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Token" class="form-label small fw-semibold text-secondary mb-0"></label>
                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 10px;">Hiệu lực 15 phút</span>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                    <input asp-for="Token" id="TokenInput" class="form-control otp-input-field" placeholder="••••••" maxlength="6" required autofocus />
                </div>
                <span asp-validation-for="Token" class="text-danger small"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="NewPassword" id="NewPasswordInput" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự" required />
                    <button type="button" class="btn btn-toggle-pwd px-3" onclick="togglePasswordVisibility('NewPasswordInput', this)" tabindex="-1">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <!-- Strength bar -->
                <div class="strength-bar-bg">
                    <div class="strength-segment" id="sSeg1"></div>
                    <div class="strength-segment" id="sSeg2"></div>
                    <div class="strength-segment" id="sSeg3"></div>
                    <div class="strength-segment" id="sSeg4"></div>
                </div>
                <div class="d-flex justify-content-between text-muted" style="font-size: 10px; margin-top: 3px;">
                    <span id="newStrengthText">Độ mạnh mật khẩu</span>
                    <span>Tối thiểu 8 ký tự, hoa, thường & số</span>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-shield-check"></i></span>
                    <input asp-for="ConfirmPassword" id="ConfirmNewPasswordInput" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                    <button type="button" class="btn btn-toggle-pwd px-3" onclick="togglePasswordVisibility('ConfirmNewPasswordInput', this)" tabindex="-1">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <div id="newConfirmFeedback" class="validation-hint"></div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient mb-3">
                <i class="fa-solid fa-check-double me-2"></i>Lưu mật khẩu mới & Đăng nhập
            </button>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-1">
                <a asp-action="ForgotPassword" class="text-decoration-none small text-muted">
                    <i class="fa-solid fa-rotate me-1"></i>Gửi lại mã OTP
                </a>
                <a asp-action="Login" class="text-decoration-none small fw-semibold" style="color: var(--magenta-accent);">
                    <i class="fa-solid fa-arrow-left me-1"></i>Đăng nhập
                </a>
            </div>
        </form>
    </div>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        const newPwd = document.getElementById('NewPasswordInput');
        const confirmNewPwd = document.getElementById('ConfirmNewPasswordInput');
        const newConfirmFeedback = document.getElementById('newConfirmFeedback');
        const segs = [
            document.getElementById('sSeg1'),
            document.getElementById('sSeg2'),
            document.getElementById('sSeg3'),
            document.getElementById('sSeg4')
        ];
        const newStrengthText = document.getElementById('newStrengthText');

        newPwd.addEventListener('input', function () {
            const val = this.value;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
            if (/\d/.test(val)) score++;
            if (/[^a-zA-Z0-9]/.test(val)) score++;

            segs.forEach(s => s.style.background = '#E2E8F0');
            const colors = ['#EF4444', '#F59E0B', '#3B82F6', '#10B981'];
            const labels = ['Rất yếu', 'Trung bình', 'Khá mạnh', 'Rất an toàn'];

            if (score > 0) {
                for (let i = 0; i < score; i++) {
                    segs[i].style.background = colors[score - 1];
                }
                newStrengthText.innerText = 'Độ mạnh: ' + labels[score - 1];
                newStrengthText.style.color = colors[score - 1];
            } else {
                newStrengthText.innerText = 'Độ mạnh mật khẩu';
                newStrengthText.style.color = '#64748B';
            }

            checkMatch();
        });

        function checkMatch() {
            if (!confirmNewPwd.value) {
                newConfirmFeedback.innerHTML = '';
                return;
            }
            if (newPwd.value === confirmNewPwd.value) {
                newConfirmFeedback.innerHTML = '<i class="fa-solid fa-circle-check text-success me-1"></i>Mật khẩu xác nhận trùng khớp';
                newConfirmFeedback.style.color = '#16a34a';
            } else {
                newConfirmFeedback.innerHTML = '<i class="fa-solid fa-circle-xmark text-danger me-1"></i>Mật khẩu xác nhận không khớp';
                newConfirmFeedback.style.color = '#dc2626';
            }
        }

        confirmNewPwd.addEventListener('input', checkMatch);

        // Client-side Form Submit Validation
        document.getElementById('resetPwdForm').addEventListener('submit', function (e) {
            const token = document.getElementById('TokenInput').value.trim();
            const p1 = newPwd.value;
            const p2 = confirmNewPwd.value;

            if (!token || token.length < 6) {
                e.preventDefault();
                alert('Vui lòng nhập đủ 6 chữ số của mã xác thực OTP.');
                document.getElementById('TokenInput').focus();
                return;
            }
            if (p1.length < 8) {
                e.preventDefault();
                alert('Mật khẩu mới cần có độ dài tối thiểu 8 ký tự.');
                newPwd.focus();
                return;
            }
            if (p1 !== p2) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không trùng khớp.');
                confirmNewPwd.focus();
                return;
            }
        });
    </script>
</body>
</html>
