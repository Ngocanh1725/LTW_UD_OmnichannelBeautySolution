@model Omnichannel.Application.DTOs.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.TitleSuffix</title>
    <!-- Brand Identity & Multi-Resolution Favicons -->
    <link rel="icon" type="image/svg+xml" href="~/images/branding/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/branding/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/branding/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/images/branding/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/branding/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --rose-gold: #E8618C;
            --rose-gold-light: #F7C6D4;
            --magenta-accent: #B8336A;
            --champagne-gold: #E8618C;
            --pastel-rose: #FFF4F7;
            --ink-dark: #2B1B24;
            --bg-gradient: linear-gradient(135deg, #FFF4F7 0%, #FDE8EF 50%, #F7C6D4 100%);
            --card-shadow: 0 25px 50px -12px rgba(232, 97, 140, 0.24);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            color: var(--ink-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            background: #FFFFFF;
            border-radius: 28px;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(232, 97, 140, 0.2);
            max-width: 450px;
            width: 100%;
            padding: 36px 36px;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #E8618C 0%, #F7C6D4 50%, #B8336A 100%);
        }

        .brand-login-avatar {
            width: 148px;
            height: auto;
            margin: 0 auto 8px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            filter: drop-shadow(0 8px 18px rgba(232, 97, 140, 0.22));
        }

        .brand-login-avatar img {
            width: 100%;
            height: auto;
            object-fit: contain;
            background: transparent;
        }

        .brand-login-avatar:hover {
            transform: scale(1.04);
        }

        .form-control {
            border-radius: 14px;
            padding: 12px 16px;
            border: 1.5px solid #F7C6D4;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: var(--rose-gold);
                box-shadow: 0 0 0 4px rgba(232, 97, 140, 0.15);
            }

        .input-group-text {
            background: #FFF4F7;
            border: 1.5px solid #F7C6D4;
            border-right: none;
            border-radius: 14px 0 0 14px;
            color: var(--magenta-accent);
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 14px 14px 0;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #E8618C 0%, #B8336A 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 13px;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            box-shadow: 0 8px 20px -4px rgba(184, 51, 106, 0.35);
            transition: all 0.3s ease;
        }

            .btn-gradient:hover {
                opacity: 0.96;
                transform: translateY(-1px);
                color: #FFFFFF;
                box-shadow: 0 12px 24px -4px rgba(184, 51, 106, 0.45);
            }

        .demo-credential-box {
            background: #FFF4F7;
            border-radius: 14px;
            padding: 14px;
            border: 1.5px dashed #F7C6D4;
            font-size: 13px;
            color: #5C3A4D;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-login-avatar">
                <img src="@Brand.LogoStackedUrl" alt="Canmake Beauty Logo" />
            </div>
            <span class="visually-hidden">@Brand.Name</span>
            <p class="small text-uppercase fw-semibold mb-0" style="color: var(--magenta-accent); letter-spacing: 0.16em; font-size: 10.5px;">@Brand.Slogan</p>
            <p class="text-muted small mt-1 mb-0" style="font-size: 12px;">Đăng Nhập Tài Khoản Thành Viên & Tích Điểm Loyalty</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 rounded-3 small mb-3 border-0 bg-success-subtle text-success d-flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger-subtle text-danger">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                    <input asp-for="Username" id="UsernameInput" class="form-control" placeholder="Tên đăng nhập hoặc Email" autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" id="PasswordInput" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" checked />
                    <label class="form-check-label small text-secondary" for="rememberMeCheck">Ghi nhớ phiên</label>
                </div>
                <a asp-action="ForgotPassword" class="text-decoration-none small fw-semibold" style="color: var(--magenta-accent);">
                    <i class="fa-solid fa-key me-1"></i>Quên mật khẩu?
                </a>
            </div>

            <button type="submit" class="btn btn-gradient mb-3">
                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Đăng nhập ngay
            </button>

            <!-- Liên kết Đăng ký tài khoản mới -->
            <div class="p-3 mb-3 rounded-4 text-center" style="background: linear-gradient(135deg, rgba(232, 97, 140, 0.06) 0%, rgba(184, 51, 106, 0.09) 100%); border: 1px dashed rgba(232, 97, 140, 0.35);">
                <span class="small text-secondary">Bạn là khách hàng mới?</span>
                <div class="mt-1">
                    <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="fw-bold small text-decoration-none" style="color: var(--magenta-accent); font-size: 13px;">
                        <i class="fa-solid fa-gift me-1 text-warning"></i>Đăng ký nhận ngay 50 Điểm & Voucher 10% <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="text-center mb-3">
                <a href="/" class="text-decoration-none small text-muted">
                    <i class="fa-solid fa-house me-1"></i>Trở về trang chủ
                </a>
            </div>
            <div class="demo-credential-box mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="text-dark small"><i class="fa-solid fa-vial-circle-check me-1" style="color: var(--rose-gold);"></i>Tài khoản kiểm thử nhanh (1-Click Fill):</strong>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">QA Ready</span>
                </div>

                <!-- Nhóm 1: Khách hàng theo Hạng Thẻ VIP (Loyalty Tiers) -->
                <div class="small fw-bold text-secondary mb-1.5 d-flex align-items-center justify-content-between" style="font-size: 11px;">
                    <span><i class="fa-solid fa-crown text-warning me-1"></i>Khách hàng VIP Loyalty:</span>
                    <span class="text-muted fw-normal" style="font-size: 10px;">Tích điểm & Giảm giá VIP</span>
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2.5">
                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 rounded-pill fw-semibold shadow-sm" style="font-size: 11px;" onclick="fillCreds('customer_diamond', 'Admin@123')" title="Kim Cương (>30tr chi tiêu, 1.500 điểm, chiết khấu 15%)">
                        💎 Diamond (-15%)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 rounded-pill fw-semibold shadow-sm" style="font-size: 11px;" onclick="fillCreds('customer_platinum', 'Admin@123')" title="Bạch Kim (>15tr chi tiêu, 800 điểm, chiết khấu 12%)">
                        💠 Platinum (-12%)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 rounded-pill fw-semibold text-dark shadow-sm" style="font-size: 11px; background-color: #FFFBEB;" onclick="fillCreds('customer_gold', 'Admin@123')" title="Vàng (>5tr chi tiêu, 350 điểm, chiết khấu 10%)">
                        🥇 Gold (-10%)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-pill fw-semibold shadow-sm" style="font-size: 11px;" onclick="fillCreds('customer_silver', 'Admin@123')" title="Bạc (>2tr chi tiêu, 120 điểm, chiết khấu 5%)">
                        🥈 Silver (-5%)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2 rounded-pill fw-semibold shadow-sm" style="font-size: 11px;" onclick="fillCreds('customer_bronze', 'Admin@123')" title="Thành viên mới (50 điểm chào mừng)">
                        🥉 Bronze (Mới)
                    </button>
                </div>

                <!-- Nhóm 2: Vận hành & Quản trị Hệ thống Showroom -->
                <div class="small fw-bold text-secondary mb-1.5 d-flex align-items-center justify-content-between" style="font-size: 11px;">
                    <span><i class="fa-solid fa-user-shield text-info me-1"></i>Vận hành & Quản trị:</span>
                    <span class="text-muted fw-normal" style="font-size: 10px;">Quản lý kho & POS</span>
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-primary py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillCreds('superadmin', 'Admin@123')" title="Quản trị viên toàn quyền hệ thống">
                        <i class="fa-solid fa-crown me-1 text-warning"></i>SuperAdmin
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillCreds('manager_hq', 'Admin@123')" title="Quản lý chi nhánh HQ">
                        <i class="fa-solid fa-store me-1"></i>Quản lý HQ
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info py-0.5 px-2 rounded-pill" style="font-size: 11px;" onclick="fillCreds('cashier01', 'Admin@123')" title="Thu ngân POS bán lẻ">
                        <i class="fa-solid fa-cash-register me-1"></i>Thu ngân POS
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning py-0.5 px-2 rounded-pill text-dark" style="font-size: 11px;" onclick="fillCreds('warehouse01', 'Admin@123')" title="Thủ kho kiểm soát FEFO">
                        <i class="fa-solid fa-boxes-stacked me-1"></i>Thủ kho FEFO
                    </button>
                </div>

                <div class="text-muted pt-2 border-top d-flex align-items-center justify-content-between" style="font-size: 11px;">
                    <span>Mật khẩu chuẩn tất cả: <code class="fw-bold text-danger">Admin@123</code></span>
                    <span class="text-secondary">Click để điền ngay</span>
                </div>
            </div>
        </form>
    </div>

    <script>
        function fillCreds(u, p) {
            document.getElementById('UsernameInput').value = u;
            document.getElementById('PasswordInput').value = p;
        }
    </script>
</body>
</html>
