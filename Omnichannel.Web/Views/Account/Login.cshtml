@model Omnichannel.Application.DTOs.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Omnichannel Beauty</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-purple: #7C3AED;
            --accent-pink: #EC4899;
            --bg-gradient: linear-gradient(135deg, #FAF5FF 0%, #FDF2F8 50%, #F5F3FF 100%);
            --card-shadow: 0 20px 40px -15px rgba(124, 58, 237, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .login-card {
            background: #FFFFFF;
            border-radius: 24px;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(236, 72, 153, 0.15);
            max-width: 450px;
            width: 100%;
            padding: 38px 34px;
        }

        .brand-badge {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin: 0 auto 16px auto;
            box-shadow: 0 10px 20px -5px rgba(236, 72, 153, 0.4);
        }

        .form-control {
            border-radius: 14px;
            padding: 12px 16px;
            border: 1.5px solid #F1E8F8;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: var(--primary-purple);
                box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
            }

        .input-group-text {
            background: #FDF4FF;
            border: 1.5px solid #F1E8F8;
            border-right: none;
            border-radius: 14px 0 0 14px;
            color: var(--primary-purple);
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 14px 14px 0;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 13px;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            box-shadow: 0 8px 20px -4px rgba(236, 72, 153, 0.35);
            transition: all 0.3s ease;
        }

            .btn-gradient:hover {
                opacity: 0.95;
                transform: translateY(-1px);
                color: #FFFFFF;
                box-shadow: 0 12px 24px -4px rgba(236, 72, 153, 0.45);
            }

        .demo-credential-box {
            background: #FAF5FF;
            border-radius: 14px;
            padding: 14px;
            border: 1.5px dashed #D8B4FE;
            font-size: 13px;
            color: #6B21A8;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <div class="brand-badge">
                <i class="fa-solid fa-sparkles"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">Omnichannel Beauty</h4>
            <p class="text-muted small mb-4">Cổng quản trị & bán lẻ mỹ phẩm đa kênh</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger-subtle text-danger">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                    <input asp-for="Username" id="UsernameInput" class="form-control" placeholder="Tên đăng nhập hoặc Email" autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Password" id="PasswordInput" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" checked />
                    <label class="form-check-label small text-secondary" for="rememberMeCheck">Ghi nhớ phiên</label>
                </div>
                <a href="/" class="text-decoration-none small text-muted">
                    <i class="fa-solid fa-house me-1"></i>Về trang chủ
                </a>
            </div>

            <button type="submit" class="btn btn-gradient mb-3">
                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Đăng nhập ngay
            </button>

            <!-- Hộp tài khoản Admin mẫu kèm nút tự động điền -->
            <div class="demo-credential-box mt-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong class="text-dark"><i class="fa-solid fa-shield-halved text-primary me-1"></i>Tài khoản SuperAdmin:</strong>
                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAdminCredentials()">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Điền nhanh
                    </button>
                </div>
                <div>Tài khoản: <code class="fw-bold">admin</code></div>
                <div>Mật khẩu: <code class="fw-bold">Admin@123456</code></div>
            </div>
        </form>
    </div>

    <script>
        function fillAdminCredentials() {
            document.getElementById('UsernameInput').value = 'admin';
            document.getElementById('PasswordInput').value = 'Admin@123456';
        }
    </script>
</body>
</html>