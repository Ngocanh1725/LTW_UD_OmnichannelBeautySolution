@model Omnichannel.Application.DTOs.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu Bảo Mật";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Brand.TitleSuffix</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-purple: #7C3AED;
            --accent-pink: #EC4899;
            --bg-gradient: linear-gradient(135deg, #FAF5FF 0%, #FDF2F8 50%, #F5F3FF 100%);
            --card-shadow: 0 20px 40px -15px rgba(124, 58, 237, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 24px;
        }

        .auth-card {
            background: #FFFFFF;
            border-radius: 28px;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(236, 72, 153, 0.15);
            max-width: 480px;
            width: 100%;
            padding: 40px 36px;
        }

        .brand-badge {
            width: 68px;
            height: 68px;
            border-radius: 22px;
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 16px auto;
            box-shadow: 0 10px 24px -5px rgba(236, 72, 153, 0.45);
        }

        .form-control {
            border-radius: 14px;
            padding: 12px 16px;
            border: 1.5px solid #F1E8F8;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
        }

        .input-group-text {
            background: #FDF4FF;
            border: 1.5px solid #F1E8F8;
            border-right: none;
            border-radius: 14px 0 0 14px;
            color: var(--primary-purple);
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 14px 14px 0;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 14px;
            font-weight: 700;
            font-size: 15px;
            width: 100%;
            box-shadow: 0 8px 20px -4px rgba(236, 72, 153, 0.35);
            transition: all 0.3s ease;
        }

        .btn-gradient:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px -4px rgba(236, 72, 153, 0.45);
            color: #fff;
        }

        .rule-item {
            font-size: 12px;
            color: #64748B;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

        .rule-item.valid {
            color: #059669;
            font-weight: 600;
        }

        .rule-item.valid i {
            color: #10B981;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Logo & Title -->
        <div class="text-center mb-4">
            <div class="brand-badge">
                <i class="fa-solid fa-key"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">Đổi Mật Khẩu Bảo Mật</h3>
            <p class="text-muted small">Cập nhật mật khẩu định kỳ để bảo vệ tài khoản quản trị</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>@Html.ValidationSummary(true, "", new { @class = "mb-0" })</div>
            </div>
        }

        <form asp-action="ChangePassword" asp-controller="Account" method="post" id="changePasswordForm">
            @Html.AntiForgeryToken()

            <!-- Current Password -->
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-lock-open"></i></span>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" required autofocus />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-shield-halved"></i></span>
                    <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control" placeholder="Nhập mật khẩu mới" required />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password Policy Checklist -->
            <div class="bg-light p-3 rounded-3 mb-3 border">
                <div class="small fw-bold text-dark mb-2">Chính sách mật khẩu mạnh:</div>
                <div class="d-flex flex-column gap-1">
                    <div id="rule-len" class="rule-item"><i class="fa-regular fa-circle"></i> Tối thiểu 8 ký tự</div>
                    <div id="rule-upper" class="rule-item"><i class="fa-regular fa-circle"></i> Ít nhất 1 chữ cái in hoa (A-Z)</div>
                    <div id="rule-lower" class="rule-item"><i class="fa-regular fa-circle"></i> Ít nhất 1 chữ cái in thường (a-z)</div>
                    <div id="rule-digit" class="rule-item"><i class="fa-regular fa-circle"></i> Ít nhất 1 chữ số (0-9)</div>
                    <div id="rule-special" class="rule-item"><i class="fa-regular fa-circle"></i> Ít nhất 1 ký tự đặc biệt (!@@#$%^&*...)</div>
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-check-double"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-gradient mb-3">
                <i class="fa-solid fa-floppy-disk me-2"></i> Lưu & Buộc Đăng Nhập Lại
            </button>

            <div class="text-center">
                <a href="/Admin/Dashboard" class="text-decoration-none small text-muted hover-underline">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại Trang Quản Trị
                </a>
            </div>
        </form>
    </div>

    <script>
        const input = document.getElementById('newPasswordInput');
        const ruleLen = document.getElementById('rule-len');
        const ruleUpper = document.getElementById('rule-upper');
        const ruleLower = document.getElementById('rule-lower');
        const ruleDigit = document.getElementById('rule-digit');
        const ruleSpecial = document.getElementById('rule-special');

        function updateRule(element, isValid) {
            if (isValid) {
                element.classList.add('valid');
                element.querySelector('i').className = 'fa-solid fa-circle-check';
            } else {
                element.classList.remove('valid');
                element.querySelector('i').className = 'fa-regular fa-circle';
            }
        }

        input.addEventListener('input', function() {
            const val = this.value || '';
            updateRule(ruleLen, val.length >= 8);
            updateRule(ruleUpper, /[A-Z]/.test(val));
            updateRule(ruleLower, /[a-z]/.test(val));
            updateRule(ruleDigit, /[0-9]/.test(val));
            updateRule(ruleSpecial, /[^A-Za-z0-9]/.test(val));
        });
    </script>
</body>
</html>
