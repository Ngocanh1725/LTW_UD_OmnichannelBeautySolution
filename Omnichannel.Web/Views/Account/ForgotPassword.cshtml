@model Omnichannel.Application.DTOs.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu - Canmake Beauty";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Brand Identity & Multi-Resolution Favicons -->
    <link rel="icon" type="image/svg+xml" href="~/images/branding/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/branding/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/branding/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/images/branding/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/branding/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --rose-gold: #E8618C;
            --rose-gold-light: #F7C6D4;
            --magenta-accent: #B8336A;
            --champagne-gold: #E8618C;
            --pastel-rose: #FFF4F7;
            --bg-gradient: linear-gradient(135deg, #FFF4F7 0%, #FDE8EF 50%, #F7C6D4 100%);
            --card-shadow: 0 25px 50px -12px rgba(232, 97, 140, 0.22);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .auth-card {
            background: #FFFFFF;
            border-radius: 28px;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(183, 110, 121, 0.18);
            max-width: 460px;
            width: 100%;
            padding: 40px 36px;
            position: relative;
            overflow: hidden;
        }

        .auth-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #B76E79 0%, #D4AF37 50%, #D63384 100%);
        }

        .brand-avatar {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            padding: 2.5px;
            background: linear-gradient(135deg, #B76E79 0%, #D4AF37 50%, #D63384 100%);
            margin: 0 auto 16px auto;
            box-shadow: 0 8px 24px -4px rgba(214, 51, 132, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            animation: brandPulseGlow 3s infinite alternate ease-in-out;
        }

        .brand-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            background: #FFFFFF;
        }

        @@keyframes brandPulseGlow {
            0% {
                box-shadow: 0 0 12px rgba(214, 51, 132, 0.25), 0 0 20px rgba(183, 110, 121, 0.15);
            }
            50% {
                box-shadow: 0 0 24px rgba(214, 51, 132, 0.5), 0 0 35px rgba(212, 175, 55, 0.35);
            }
            100% {
                box-shadow: 0 0 14px rgba(214, 51, 132, 0.3), 0 0 22px rgba(183, 110, 121, 0.2);
            }
        }

        .form-control {
            border-radius: 14px;
            padding: 12px 16px;
            border: 1.5px solid #F3E4E8;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: var(--magenta-accent);
            box-shadow: 0 0 0 4px rgba(214, 51, 132, 0.12);
        }

        .input-group-text {
            background: #FFF5F7;
            border: 1.5px solid #F3E4E8;
            border-right: none;
            border-radius: 14px 0 0 14px;
            color: var(--rose-gold);
            font-size: 14px;
        }

        .input-group .form-control {
            border-left: none;
            border-radius: 0 14px 14px 0;
        }

        .btn-gradient {
            background: linear-gradient(135deg, #D63384 0%, #B76E79 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 14px;
            padding: 13px;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            box-shadow: 0 8px 20px -4px rgba(214, 51, 132, 0.35);
            transition: all 0.3s ease;
        }

        .btn-gradient:hover {
            opacity: 0.96;
            transform: translateY(-1px);
            color: #FFFFFF;
            box-shadow: 0 12px 24px -4px rgba(214, 51, 132, 0.45);
        }

        .instruction-box {
            background: #FFF9FA;
            border-radius: 16px;
            padding: 14px;
            border: 1px dashed rgba(214, 51, 132, 0.25);
            font-size: 12.5px;
            color: #64748B;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Logo CANMAKE BEAUTY trung tâm -->
        <div class="text-center mb-3">
            <div class="mb-2">
                <img src="@Brand.LogoStackedUrl" alt="Canmake Beauty Logo" style="height: 110px; width: auto; display: block; margin: 0 auto;" />
            </div>
            <span class="visually-hidden">@Brand.Name</span>
            <p class="small text-uppercase fw-semibold mb-0" style="color: var(--magenta-accent); letter-spacing: 0.16em; font-size: 10.5px;">@Brand.Slogan</p>
            <p class="text-muted small mt-1 mb-0" style="font-size: 12px;">Khôi Phục Quyền Truy Cập Tài Khoản</p>
        </div>

        <div class="instruction-box mb-4">
            <div class="d-flex items-center gap-2 mb-1">
                <i class="fa-solid fa-envelope-open-text text-danger"></i>
                <strong class="text-dark">Nhận mã xác thực qua Email</strong>
            </div>
            Nhập địa chỉ email đăng ký tài khoản của bạn. Hệ thống sẽ cấp mã xác thực OTP 6 số để bạn thiết lập lại mật khẩu an toàn.
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 border-0 bg-danger-subtle text-danger">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" id="EmailInput" type="email" class="form-control" placeholder="nhap-email@example.com" required autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gradient mb-3">
                <i class="fa-solid fa-paper-plane me-2"></i>Gửi mã xác thực OTP
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none small fw-semibold" style="color: var(--magenta-accent);">
                    <i class="fa-solid fa-arrow-left me-1"></i>Quay lại trang Đăng nhập
                </a>
            </div>

            <div class="text-center mt-2">
                <a href="/" class="text-decoration-none small text-muted">
                    <i class="fa-solid fa-house me-1"></i>Về trang chủ @Brand.DisplayName
                </a>
            </div>
        </form>
    </div>
</body>
</html>
