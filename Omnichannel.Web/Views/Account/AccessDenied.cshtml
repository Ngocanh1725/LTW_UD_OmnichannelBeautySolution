@model Omnichannel.Application.DTOs.Account.AccessDeniedViewModel
@{
    ViewData["Title"] = "Từ chối Truy cập (403)";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Omnichannel Beauty</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #FAF5FF 0%, #FDF2F8 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-card {
            background: #FFFFFF;
            border-radius: 24px;
            box-shadow: 0 20px 40px -15px rgba(236, 72, 153, 0.15);
            border: 1px solid #FBCFE8;
            max-width: 520px;
            width: 100%;
            padding: 45px 35px;
            text-align: center;
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: #FEE2E2;
            color: #EF4444;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin: 0 auto 20px;
        }

        .btn-back {
            background: linear-gradient(135deg, #7C3AED 0%, #EC4899 100%);
            color: #FFFFFF;
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }

            .btn-back:hover {
                color: #FFFFFF;
                opacity: 0.92;
                transform: translateY(-1px);
            }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="icon-circle">
            <i class="fa-solid fa-shield-xmark"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Quyền truy cập bị từ chối</h3>
        <p class="text-secondary small mb-4">
            @Model.Message
        </p>

        @if (!string.IsNullOrEmpty(Model.AttemptedPath))
        {
            <div class="bg-light p-2 rounded-3 text-muted small mb-4 text-truncate">
                Đường dẫn yêu cầu: <code>@Model.AttemptedPath</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-3 px-3 py-2">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
            </a>
            <a href="/" class="btn-back">
                <i class="fa-solid fa-house me-1"></i>Trang chủ
            </a>
        </div>
    </div>
</body>
</html>