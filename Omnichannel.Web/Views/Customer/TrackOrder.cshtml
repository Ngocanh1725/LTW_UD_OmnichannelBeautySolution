@model Omnichannel.Application.DTOs.Customer.GuestOrderLookupViewModel
@{
    ViewData["Title"] = "Tra Cứu Hành Trình Đơn Hàng & Vận Đơn - Omni Beauty";
    Layout = "_Layout";
}

<div class="min-h-screen bg-slate-50/70 pb-20 pt-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Header & Search Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm mb-8">
            <div class="text-center max-w-2xl mx-auto mb-8">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-magenta-accent/10 text-magenta-accent text-xs font-bold mb-3">
                    <i class="fa-solid fa-magnifying-glass-location"></i> Tra Cứu Vận Đơn Online 24/7
                </span>
                <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal">
                    Theo Dõi Hành Trình Đơn Hàng & Lô FEFO
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-2">
                    Nhập <strong>Mã đơn hàng</strong> và <strong>Số điện thoại nhận hàng</strong> để kiểm tra trực tiếp tiến độ đóng gói chuẩn FEFO và mã vận đơn GHN Express (không cần đăng nhập).
                </p>
            </div>

            <form method="post" action="/tra-cuu-don-hang" class="max-w-3xl mx-auto">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
                    <div class="sm:col-span-5">
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Mã đơn hàng <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-receipt absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text"
                                   name="orderCode"
                                   value="@Model.OrderCode"
                                   required
                                   placeholder="VD: ORD-20261104-..."
                                   class="w-full pl-9 pr-4 py-3 rounded-2xl border border-slate-200 focus:border-magenta-accent focus:ring-2 focus:ring-magenta-accent/20 text-xs sm:text-sm font-mono uppercase text-charcoal outline-none transition" />
                        </div>
                    </div>

                    <div class="sm:col-span-4">
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Số điện thoại nhận hàng <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <i class="fa-solid fa-phone absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="tel"
                                   name="phoneNumber"
                                   value="@Model.PhoneNumber"
                                   required
                                   placeholder="VD: 0901234567"
                                   class="w-full pl-9 pr-4 py-3 rounded-2xl border border-slate-200 focus:border-magenta-accent focus:ring-2 focus:ring-magenta-accent/20 text-xs sm:text-sm font-mono text-charcoal outline-none transition" />
                        </div>
                    </div>

                    <div class="sm:col-span-3 flex items-end">
                        <button type="submit"
                                class="w-full py-3 px-5 rounded-2xl bg-gradient-to-r from-magenta-accent to-pink-600 hover:from-pink-600 hover:to-magenta-accent text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <span>Tra Cứu Ngay</span>
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.HasSearched && !string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="max-w-3xl mx-auto mt-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs sm:text-sm flex items-center gap-3">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-base shrink-0"></i>
                    <div>
                        <div class="font-bold">Không tìm thấy thông tin đơn hàng</div>
                        <div class="text-xs text-rose-600 mt-0.5">@Model.ErrorMessage</div>
                    </div>
                </div>
            }
        </div>

        <!-- Kết Quả Tra Cứu (Chỉ hiển thị khi khớp cả Mã đơn + Số điện thoại) -->
        @if (Model.OrderDetail != null)
        {
            var ord = Model.OrderDetail;
            <div class="space-y-6">
                <!-- Tóm tắt trạng thái & Mã vận đơn -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                        <div>
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <span class="text-xs font-bold text-slate-400 uppercase">Đơn hàng:</span>
                                <span class="text-xl font-mono font-bold text-magenta-accent">#@ord.OrderCode</span>
                                <span class="text-xs font-bold px-3 py-1 rounded-full border @ord.OrderStatusBadgeClass">
                                    @ord.OrderStatusDisplayName
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-1">
                                Ngày đặt: <strong>@ord.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong> • Người nhận: <strong>@ord.RecipientName</strong> (@ord.RecipientPhone)
                            </p>
                        </div>

                        <div class="bg-slate-50 px-4 py-2.5 rounded-2xl border border-slate-200 text-xs">
                            <div class="text-slate-500">@ord.CarrierName</div>
                            <div class="font-mono font-bold text-charcoal mt-0.5">Mã vận đơn: @ord.TrackingCode</div>
                        </div>
                    </div>

                    <!-- Timeline Dọc 6 Bước -->
                    <div class="mt-6 relative pl-4 sm:pl-6 space-y-5 before:content-[''] before:absolute before:top-3 before:bottom-3 before:left-[27px] sm:before:left-[35px] before:w-0.5 before:bg-slate-200">
                        @foreach (var ev in ord.TimelineEvents)
                        {
                            bool isPassed = ev.IsCompleted && !ev.IsCurrent;
                            bool isCurrent = ev.IsCurrent;
                            string circleClass = ev.IsAlertStep
                                ? "bg-rose-600 text-white"
                                : (isCurrent ? "bg-magenta-accent text-white ring-4 ring-magenta-accent/20" : (isPassed ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-400 border border-slate-200"));

                            <div class="relative flex items-start gap-4">
                                <div class="w-9 h-9 rounded-2xl flex items-center justify-center shrink-0 text-xs font-bold z-10 @circleClass">
                                    @ev.StepIndex
                                </div>
                                <div class="flex-1 rounded-2xl p-4 border @(isCurrent ? "bg-pink-50/40 border-magenta-accent/30" : (isPassed ? "bg-white border-slate-200/80" : "bg-slate-50/60 border-slate-200/50 opacity-75"))">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                                        <h3 class="text-sm font-bold @(isCurrent ? "text-magenta-accent" : "text-charcoal")">
                                            @ev.Title
                                        </h3>
                                        @if (!string.IsNullOrEmpty(ev.FormattedTime))
                                        {
                                            <span class="text-xs font-mono text-slate-500">@ev.FormattedTime</span>
                                        }
                                        else
                                        {
                                            <span class="text-[11px] text-slate-400 italic">Đang chờ xử lý</span>
                                        }
                                    </div>
                                    <p class="text-xs text-slate-600 mt-1">@ev.Description</p>

                                    @if (ev.FefoBatchesSummary != null && ev.FefoBatchesSummary.Any() && (ev.IsCompleted || ev.IsCurrent))
                                    {
                                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                                            @foreach (var bInfo in ev.FefoBatchesSummary)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50 border border-amber-200 text-[11px] font-mono text-amber-900">
                                                    <i class="fa-solid fa-barcode text-amber-600"></i> @bInfo
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Danh sách sản phẩm trong đơn -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
                    <h3 class="text-sm font-serif font-bold text-charcoal mb-4">
                        Kiện Hàng & Lô FEFO Xuất Kho (@ord.Items.Count sản phẩm)
                    </h3>
                    <div class="divide-y divide-slate-100">
                        @foreach (var item in ord.Items)
                        {
                            <div class="py-3.5 flex items-center justify-between gap-4">
                                <div>
                                    <div class="text-xs sm:text-sm font-bold text-charcoal">@item.ProductName</div>
                                    <div class="text-[11px] font-mono text-amber-800 mt-1">
                                        Lô FEFO: <strong>@item.FefoBatchNumber</strong> • HSD: <strong>@(item.FefoExpiryDate?.ToString("dd/MM/yyyy") ?? "Hạn xa")</strong> • SL: x@item.Quantity
                                    </div>
                                </div>
                                <div class="text-xs sm:text-sm font-mono font-bold text-charcoal shrink-0">
                                    @item.LineTotal.ToString("N0") ₫
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs text-slate-500">Địa chỉ nhận (đã ẩn bảo mật): <strong>@ord.ShippingAddress</strong></span>
                        <span class="text-base font-mono font-bold text-magenta-accent">Tổng: @ord.TotalAmount.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

