<!-- Copy toast notification -->
<div id="copyToast" class="fixed bottom-6 right-6 z-50 bg-charcoal text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-lg flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <i class="fa-solid fa-circle-check text-emerald-400"></i>
    <span id="toastMessage">Đã sao chép thành công!</span>
</div>

<script>
    function openQrModal() {
        document.getElementById('qrModal').classList.remove('hidden');
    }

    function closeQrModal() {
        document.getElementById('qrModal').classList.add('hidden');
    }

    function copyVoucherCode(code) {
        navigator.clipboard.writeText(code).then(() => {
            showToast('Đã sao chép mã voucher: ' + code);
        }).catch(() => {
            showToast('Mã voucher: ' + code);
        });
    }

    function showToast(msg) {
        const toast = document.getElementById('copyToast');
        const text = document.getElementById('toastMessage');
        text.innerText = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
            toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
    }

    function getAntiForgeryToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function fireConfettiCelebration() {
        const colors = ['#d81b60', '#f59e0b', '#10b981', '#8b5cf6', '#ec4899'];
        const container = document.createElement('div');
        container.style.position = 'fixed';
        container.style.inset = '0';
        container.style.pointerEvents = 'none';
        container.style.zIndex = '9999';
        document.body.appendChild(container);

        for (let i = 0; i < 65; i++) {
            const p = document.createElement('div');
            p.style.position = 'absolute';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.top = '-12px';
            p.style.width = (Math.random() * 8 + 6) + 'px';
            p.style.height = (Math.random() * 12 + 6) + 'px';
            p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
            p.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
            p.style.opacity = '0.95';
            p.style.transition = `transform ${1.4 + Math.random() * 1.2}s cubic-bezier(0.22, 1, 0.36, 1), opacity 2.2s ease`;
            container.appendChild(p);

            requestAnimationFrame(() => {
                const driftX = (Math.random() - 0.5) * 260;
                const fallY = window.innerHeight * (0.65 + Math.random() * 0.35);
                const rot = Math.random() * 720 - 360;
                p.style.transform = `translate(${driftX}px, ${fallY}px) rotate(${rot}deg)`;
                p.style.opacity = '0';
            });
        }
        setTimeout(() => container.remove(), 2600);
    }

    function updatePointsUi(newBalance, availableVnd, recentTxs) {
        const fmt = new Intl.NumberFormat('vi-VN');
        const cardPts = document.getElementById('cardPointsBalance');
        if (cardPts) cardPts.innerText = fmt.format(newBalance);

        const bazaarPts = document.getElementById('bazaarPointsBalance');
        if (bazaarPts) bazaarPts.innerText = fmt.format(newBalance);

        const statVnd = document.getElementById('statDiscountVnd');
        if (statVnd) statVnd.innerText = fmt.format(availableVnd) + '₫';

        // Nhích nhẹ thanh tiến độ hạng khi nhận điểm mới
        const bar = document.getElementById('tierProgressBar');
        const pct = document.getElementById('tierProgressPercent');
        if (bar && pct) {
            const cur = parseInt(pct.innerText.replace('%', ''), 10) || 85;
            const nextPct = Math.min(100, cur + 1);
            pct.innerText = nextPct + '%';
            bar.style.width = nextPct + '%';
        }

        // Cập nhật trạng thái nút đổi điểm Bazaar
        document.querySelectorAll('.btn-redeem-bazaar').forEach(btn => {
            const cost = parseInt(btn.getAttribute('data-points-cost') || '0', 10);
            if (newBalance >= cost) {
                btn.disabled = false;
                btn.className = 'btn-redeem-bazaar px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs cursor-pointer bg-charcoal text-white hover:bg-magenta-accent';
            } else {
                btn.disabled = true;
                btn.className = 'btn-redeem-bazaar px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs bg-slate-200 text-slate-400 cursor-not-allowed';
            }
        });

        // Cập nhật danh sách lịch sử biến động điểm (Sổ cái)
        if (Array.isArray(recentTxs) && recentTxs.length > 0) {
            const listEl = document.getElementById('recentPointsList');
            if (listEl) {
                listEl.innerHTML = recentTxs.map(tx => {
                    const isPositive = tx.points >= 0;
                    const sign = isPositive ? '+' : '';
                    const colorCls = isPositive ? 'text-emerald-600' : 'text-rose-600';
                    const badgeCls = isPositive ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700';
                    const iconCls = isPositive ? 'fa-plus' : 'fa-ticket';
                    const dt = new Date(tx.createdAt);
                    const dateStr = dt.toLocaleDateString('vi-VN') + ' ' + dt.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                    return `
                        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-sm shadow-2xs ${badgeCls}">
                                    <i class="fa-solid ${iconCls}"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-charcoal line-clamp-1">${tx.description}</p>
                                    <span class="text-[10px] text-slate-400">${dateStr}</span>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <span class="text-sm font-bold font-mono ${colorCls}">${sign}${tx.points}</span>
                                <span class="text-[10px] text-slate-400 block font-mono">Dư: ${tx.balanceAfter}</span>
                            </div>
                        </div>`;
                }).join('');
            }
        }
    }

    async function handleDailyCheckIn() {
        const btn = document.getElementById('btnDailyCheckIn');
        if (!btn || btn.disabled) return;
        btn.disabled = true;

        try {
            const formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', getAntiForgeryToken());

            const resp = await fetch('/Customer/CheckInDaily', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });
            const data = await resp.json();

            if (data.success) {
                fireConfettiCelebration();
                showToast(data.message);
                btn.className = 'inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-100 text-emerald-700 font-bold text-sm cursor-not-allowed border border-emerald-200';
                btn.innerHTML = `<i class="fa-solid fa-circle-check"></i><span>Đã điểm danh hôm nay (+${data.pointsAwarded} điểm)</span>`;

                const streakEl = document.getElementById('streakCountBadge');
                if (streakEl) streakEl.innerText = data.currentStreak;

                // Cập nhật ô ngày vừa điểm danh
                const slotEl = document.querySelector(`.checkin-slot[data-slot-day="${data.currentStreak}"]`);
                if (slotEl) {
                    slotEl.className = 'checkin-slot rounded-2xl p-3.5 border text-center flex flex-col items-center justify-between transition-all bg-emerald-50/90 border-emerald-300 text-emerald-800 shadow-xs';
                }

                updatePointsUi(data.newBalance, data.availableDiscountVnd, data.recentTransactions);
            } else {
                showToast(data.message || 'Bạn đã điểm danh hôm nay rồi!');
            }
        } catch (err) {
            showToast('Lỗi kết nối khi điểm danh.');
            btn.disabled = false;
        }
    }

    async function handleRedeemReward(points, title) {
        try {
            const formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', getAntiForgeryToken());
            formData.append('points', points);
            formData.append('rewardTitle', title);

            const resp = await fetch('/Customer/RedeemReward', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });
            const data = await resp.json();

            if (data.success) {
                fireConfettiCelebration();
                showToast(data.message);

                const banner = document.getElementById('redeemSuccessBanner');
                const codeEl = document.getElementById('redeemBannerCode');
                const linkEl = document.getElementById('redeemUseNowLink');
                if (banner && codeEl && linkEl) {
                    codeEl.innerText = data.voucherCode;
                    linkEl.href = '/Checkout?couponCode=' + encodeURIComponent(data.voucherCode);
                    banner.classList.remove('hidden');
                }

                // Thêm voucher mới vào đầu danh sách Kho Voucher Của Tôi
                const vList = document.getElementById('myVouchersList');
                if (vList && data.voucherCode) {
                    const fmt = new Intl.NumberFormat('vi-VN');
                    const cardHtml = `
                        <div class="p-4 rounded-2xl border-2 border-emerald-300 bg-emerald-50/40 flex items-center justify-between gap-3 transition">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="font-mono font-bold text-xs px-2.5 py-1 rounded-lg bg-white border border-emerald-400 text-emerald-700 shadow-2xs">
                                        ${data.voucherCode}
                                    </span>
                                    <span class="text-[10px] text-emerald-700 font-bold bg-emerald-100 px-2 py-0.5 rounded-full">Vừa đổi • Sẵn sàng dùng</span>
                                </div>
                                <p class="text-xs font-medium text-slate-700 mt-1.5">Giảm trực tiếp ${fmt.format(data.discountAmountVnd)}₫ (Canmake Rewards Bazaar)</p>
                            </div>
                            <div class="flex items-center gap-1.5 flex-shrink-0">
                                <button type="button" onclick="copyVoucherCode('${data.voucherCode}')" class="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-magenta-accent hover:text-white text-xs font-bold transition">
                                    Sao Chép
                                </button>
                                <a href="/Checkout?couponCode=${encodeURIComponent(data.voucherCode)}" class="px-3 py-1.5 rounded-xl bg-magenta-accent text-white hover:opacity-90 text-xs font-bold transition">
                                    Dùng ngay
                                </a>
                            </div>
                        </div>`;
                    vList.insertAdjacentHTML('afterbegin', cardHtml);
                }

                const vCount = document.getElementById('statVoucherCount');
                if (vCount && data.vouchersCount !== undefined) {
                    vCount.innerText = data.vouchersCount + ' mã';
                }

                updatePointsUi(data.newBalance, data.availableDiscountVnd, data.recentTransactions);
            } else {
                showToast(data.message || 'Không thể đổi điểm.');
            }
        } catch (err) {
            showToast('Lỗi kết nối khi đổi điểm.');
        }
    }

    function copyRedeemedCode() {
        const codeEl = document.getElementById('redeemBannerCode');
        if (codeEl) copyVoucherCode(codeEl.innerText.trim());
    }

    async function handleClaimMission(missionCode) {
        const btn = document.getElementById('btn-mission-' + missionCode);
        if (btn) btn.disabled = true;

        try {
            const formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', getAntiForgeryToken());
            formData.append('missionCode', missionCode);

            const resp = await fetch('/Customer/ClaimMission', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });
            const data = await resp.json();

            if (data.success) {
                fireConfettiCelebration();
                showToast(data.message);
                if (btn) {
                    btn.outerHTML = `<span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-emerald-100 text-emerald-700 text-xs font-bold"><i class="fa-solid fa-check"></i> Đã nhận</span>`;
                }
                updatePointsUi(data.newBalance, data.availableDiscountVnd, data.recentTransactions);
            } else {
                showToast(data.message || 'Không thể nhận thưởng nhiệm vụ.');
                if (btn) btn.disabled = false;
            }
        } catch (err) {
            showToast('Lỗi kết nối khi nhận thưởng nhiệm vụ.');
            if (btn) btn.disabled = false;
        }
    }

    async function handleApplyReferralCode() {
        const input = document.getElementById('inputReferralCode');
        const msgEl = document.getElementById('referralFeedbackMsg');
        if (!input || !input.value.trim()) {
            showToast('Vui lòng nhập mã giới thiệu!');
            return;
        }

        try {
            const formData = new URLSearchParams();
            formData.append('__RequestVerificationToken', getAntiForgeryToken());
            formData.append('referralCode', input.value.trim());

            const resp = await fetch('/Customer/ApplyReferralCode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            });
            const data = await resp.json();

            if (msgEl) {
                msgEl.classList.remove('hidden');
                msgEl.className = 'text-[11px] mt-1.5 font-semibold ' + (data.success ? 'text-emerald-600' : 'text-rose-600');
                msgEl.innerText = data.message;
            }

            if (data.success) {
                fireConfettiCelebration();
                showToast(data.message);
                if (data.newBalance !== undefined) {
                    updatePointsUi(data.newBalance, data.availableDiscountVnd, data.recentTransactions);
                }
            } else {
                showToast(data.message);
            }
        } catch (err) {
            showToast('Lỗi kết nối khi kiểm tra mã giới thiệu.');
        }
    }
</script>
