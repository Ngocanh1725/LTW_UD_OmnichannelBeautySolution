@functions {
    private static bool isCompletedOrCurrent(Omnichannel.Application.DTOs.Customer.OrderTimelineEventDto ev)
    {
        return ev.IsCompleted || ev.IsCurrent;
    }
}

<script>
    function orderDetailManager() {
        return {
            orderId: @Model.Id,
            orderCode: '@Model.OrderCode',
            currentStatus: '@Model.OrderStatus',
            currentReturnStatus: '@(Model.ActiveReturnRequest?.Status ?? "")',
            copied: false,
            vatModalOpen: false,
            submittingVat: false,
            cancelModalOpen: false,
            submittingCancel: false,
            cancelError: '',
            returnModalOpen: false,
            submittingReturn: false,
            returnError: '',
            realtimeBannerVisible: false,
            realtimeBannerMessage: '',

            cancelForm: {
                orderId: @Model.Id,
                reason: '',
                note: ''
            },

            returnForm: {
                orderId: @Model.Id,
                reason: '',
                description: ''
            },

            vatForm: {
                orderId: @Model.Id,
                taxCode: '',
                companyName: '',
                companyAddress: '',
                invoiceEmail: ''
            },

            init() {
                // Polling nhẹ mỗi 5 giây để tự động phát hiện khi Admin chuyển trạng thái hoặc duyệt Đổi/Trả
                setInterval(() => {
                    this.checkOrderRealtimeUpdate();
                }, 5000);
            },

            async checkOrderRealtimeUpdate() {
                if (this.cancelModalOpen || this.returnModalOpen || this.vatModalOpen) return;
                try {
                    const resp = await fetch(`/Customer/GetOrderStatusJson/${this.orderId}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!resp.ok) return;
                    const data = await resp.json();
                    if (!data || !data.success) return;

                    const newReturnStatus = data.activeReturnRequest ? data.activeReturnRequest.status : '';
                    if (data.orderStatus !== this.currentStatus || newReturnStatus !== this.currentReturnStatus) {
                        this.realtimeBannerMessage = `Đơn hàng #${this.orderCode} vừa cập nhật trạng thái mới: ${data.orderStatusDisplayName}! Đang đồng bộ Timeline...`;
                        this.realtimeBannerVisible = true;
                        setTimeout(() => {
                            window.location.reload();
                        }, 1200);
                    }
                } catch (e) {
                    // Ignore transient network errors during background polling
                }
            },

            copyTrackingCode(code) {
                if (!code) return;
                navigator.clipboard.writeText(code).then(() => {
                    this.copied = true;
                    setTimeout(() => { this.copied = false; }, 2500);
                });
            },

            async submitCancelOrder() {
                this.cancelError = '';
                if (!this.cancelForm.reason) {
                    this.cancelError = 'Vui lòng chọn lý do hủy đơn hàng.';
                    return;
                }

                this.submittingCancel = true;
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch('/Customer/CancelOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(this.cancelForm)
                    });

                    const result = await response.json();
                    if (result.success) {
                        this.cancelModalOpen = false;
                        window.location.reload();
                    } else {
                        this.cancelError = result.message || 'Không thể hủy đơn hàng.';
                    }
                } catch (err) {
                    this.cancelError = 'Lỗi kết nối máy chủ. Vui lòng thử lại.';
                } finally {
                    this.submittingCancel = false;
                }
            },

            async submitReturnRequest() {
                this.returnError = '';
                if (!this.returnForm.reason) {
                    this.returnError = 'Vui lòng chọn lý do yêu cầu đổi/trả.';
                    return;
                }

                this.submittingReturn = true;
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const formData = new FormData();
                    formData.append('orderId', this.returnForm.orderId);
                    formData.append('reason', this.returnForm.reason);
                    formData.append('description', this.returnForm.description || '');

                    const fileInput = document.getElementById('returnPhotosInput');
                    if (fileInput && fileInput.files) {
                        if (fileInput.files.length > 3) {
                            this.returnError = 'Chỉ được chọn tối đa 3 ảnh minh chứng.';
                            this.submittingReturn = false;
                            return;
                        }
                        for (let i = 0; i < fileInput.files.length; i++) {
                            formData.append('photos', fileInput.files[i]);
                        }
                    }

                    const response = await fetch('/Customer/SubmitReturnRequest', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    const result = await response.json();
                    if (result.success) {
                        this.returnModalOpen = false;
                        window.location.reload();
                    } else {
                        this.returnError = result.message || 'Không thể gửi yêu cầu đổi/trả.';
                    }
                } catch (err) {
                    this.returnError = 'Lỗi kết nối máy chủ. Vui lòng thử lại.';
                } finally {
                    this.submittingReturn = false;
                }
            },

            async submitVatRequest() {
                if (!this.vatForm.taxCode || !this.vatForm.companyName || !this.vatForm.invoiceEmail) {
                    alert("Vui lòng điền đầy đủ Mã số thuế, Tên doanh nghiệp và Email nhận hóa đơn.");
                    return;
                }

                this.submittingVat = true;
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch('/Customer/RequestVatInvoice', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(this.vatForm)
                    });

                    const result = await response.json();
                    if (result.success) {
                        this.vatModalOpen = false;
                        window.location.reload();
                    } else {
                        alert(result.message || "Đã xảy ra lỗi khi gửi yêu cầu.");
                    }
                } catch (err) {
                    alert("Không thể kết nối đến máy chủ.");
                } finally {
                    this.submittingVat = false;
                }
            }
        };
    }
</script>
