@model Omnichannel.Application.DTOs.Customer.CustomerOrderDetailViewModel
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng #{Model.OrderCode} - Omni Beauty";
    Layout = "_Layout";
}

<div class="min-h-screen bg-slate-50/70 pb-20 pt-6" x-data="orderDetailManager()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Realtime Update Banner -->
        <div x-show="realtimeBannerVisible"
             x-cloak
             x-transition
             class="mb-5 p-4 rounded-2xl bg-emerald-600 text-white shadow-lg flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 text-xs sm:text-sm font-bold">
                <i class="fa-solid fa-bolt-lightning text-amber-300 text-base animate-bounce"></i>
                <span x-text="realtimeBannerMessage">Trạng thái đơn hàng vừa được cập nhật trực tiếp từ hệ thống!</span>
            </div>
            <button type="button" @@click="window.location.reload()" class="px-3.5 py-1.5 rounded-xl bg-white text-emerald-700 text-xs font-extrabold hover:bg-emerald-50 transition shrink-0">
                Làm mới ngay
            </button>
        </div>

        <!-- Breadcrumb & Top Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
            <div>
                <nav class="flex items-center gap-2 text-xs text-slate-400 mb-1.5">
                    <a href="/" class="hover:text-magenta-accent transition">Trang Chủ</a>
                    <span>/</span>
                    <a href="/Customer/Orders" class="hover:text-magenta-accent transition">Đơn Hàng Của Tôi</a>
                    <span>/</span>
                    <span class="text-charcoal font-semibold font-mono">#@Model.OrderCode</span>
                </nav>
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal">
                        Chi Tiết Đơn Hàng <span class="font-mono text-magenta-accent">#@Model.OrderCode</span>
                    </h1>
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full border shadow-2xs @Model.OrderStatusBadgeClass">
                        <span class="w-2 h-2 rounded-full bg-current animate-pulse"></span>
                        <span>@Model.OrderStatusDisplayName</span>
                    </span>
                </div>
                <p class="text-xs text-slate-500 mt-1">
                    Ngày đặt hàng: <strong class="text-slate-700">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</strong> • Phương thức: <strong class="text-slate-700">@Model.PaymentMethod</strong>
                    (@(Model.PaymentStatus == "PAID" ? "Đã thanh toán" : (Model.PaymentStatus == "REFUNDED" ? "Đã hoàn tiền" : "Chưa thanh toán")))
                </p>
            </div>

            <!-- Action Navigation Buttons -->
            <div class="flex flex-wrap items-center gap-2.5">
                <a href="/tra-cuu-don-hang?orderCode=@Model.OrderCode" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-white text-slate-600 hover:text-magenta-accent border border-slate-200 text-xs font-bold transition shadow-2xs">
                    <i class="fa-solid fa-magnifying-glass-location"></i> Tra Cứu Vận Đơn
                </a>
                <a href="/Customer/Orders" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-slate-700 hover:text-magenta-accent border border-slate-200 text-xs font-bold transition shadow-sm">
                    <i class="fa-solid fa-arrow-left"></i> Danh Sách Đơn Hàng
                </a>
            </div>
        </div>

        <!-- ===================================================
             THẺ TRẠNG THÁI YÊU CẦU ĐỔI / TRẢ HÀNG (NẾU CÓ)
             =================================================== -->
        @if (Model.ActiveReturnRequest != null)
        {
            var ret = Model.ActiveReturnRequest;
            <div class="bg-white rounded-3xl p-6 border-2 @(ret.Status == "APPROVED" ? "border-emerald-300 bg-emerald-50/20" : (ret.Status == "REJECTED" ? "border-rose-300 bg-rose-50/20" : "border-amber-300 bg-amber-50/20")) shadow-sm mb-8">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200/80">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-lg shrink-0 @(ret.Status == "APPROVED" ? "bg-emerald-500 text-white" : (ret.Status == "REJECTED" ? "bg-rose-500 text-white" : "bg-amber-500 text-white"))">
                            <i class="fa-solid fa-rotate-left"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="text-sm sm:text-base font-serif font-bold text-charcoal">
                                    Yêu Cầu Đổi / Trả Hàng <span class="font-mono text-magenta-accent">#@ret.RequestCode</span>
                                </h3>
                                <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border @ret.StatusBadgeClass">
                                    @ret.StatusDisplayName
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Gửi lúc: <strong class="font-mono">@ret.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                                @if (ret.ProcessedAt.HasValue)
                                {
                                    <span> • Phản hồi lúc: <strong class="font-mono">@ret.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 text-xs">
                    <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80">
                        <div class="font-bold text-slate-500 uppercase tracking-wider text-[10px] mb-1">Lý do khách hàng gửi:</div>
                        <div class="font-bold text-charcoal text-sm">@ret.Reason</div>
                        @if (!string.IsNullOrWhiteSpace(ret.Description))
                        {
                            <p class="text-slate-600 mt-1 leading-relaxed">@ret.Description</p>
                        }
                        @if (ret.EvidenceUrls != null && ret.EvidenceUrls.Any())
                        {
                            <div class="flex items-center gap-2 mt-3">
                                @foreach (var imgUrl in ret.EvidenceUrls)
                                {
                                    <a href="@imgUrl" target="_blank" class="w-14 h-14 rounded-xl overflow-hidden border border-slate-200 block hover:opacity-80 transition">
                                        <img src="@imgUrl" alt="Ảnh minh chứng đổi trả" class="w-full h-full object-cover" onerror="this.src='/images/branding/default-product.png'" />
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <div class="p-3.5 rounded-2xl bg-white border border-slate-200/80">
                        <div class="font-bold text-slate-500 uppercase tracking-wider text-[10px] mb-1">Phản hồi từ Quản trị viên Omni Beauty:</div>
                        @if (!string.IsNullOrWhiteSpace(ret.AdminNote))
                        {
                            <div class="font-semibold text-charcoal leading-relaxed">@ret.AdminNote</div>
                        }
                        else
                        {
                            <div class="text-slate-500 italic">Yêu cầu của bạn đang được bộ phận CSKH & Kiểm soát chất lượng FEFO xem xét. Kết quả sẽ được thông báo trực tiếp qua chuông thông báo.</div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- ===================================================
             1. TIMELINE DỌC 6 BƯỚC MINH BẠCH HẬU MUA HÀNG
             [1. Đặt hàng] -> [2. Xác nhận] -> [3. Đóng gói (lô FEFO đã cấp phát)] -> [4. Bàn giao vận chuyển] -> [5. Đang giao] -> [6. Giao thành công]
             =================================================== -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
                <div>
                    <h2 class="text-base sm:text-lg font-serif font-bold text-charcoal flex items-center gap-2">
                        <i class="fa-solid fa-route text-magenta-accent"></i>
                        <span>Timeline Theo Dõi Đơn Hàng & Cấp Phát Lô FEFO (6 Bước)</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Cập nhật thời gian thực từng công đoạn xử lý kho chuẩn GSP & hành trình vận đơn GHN
                    </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <div class="bg-slate-50 px-3.5 py-2 rounded-2xl border border-slate-200 flex items-center gap-2">
                        <i class="fa-solid fa-truck-fast text-purple-600 text-xs"></i>
                        <span class="text-xs text-slate-500">@Model.CarrierName:</span>
                        <strong class="font-mono text-xs text-charcoal">@Model.TrackingCode</strong>
                        <button type="button"
                                @@click="copyTrackingCode('@Model.TrackingCode')"
                                class="ml-1 text-[11px] font-bold text-magenta-accent hover:underline">
                            <i class="fa-regular fa-copy"></i>
                            <span x-text="copied ? 'Đã chép' : 'Sao chép'"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- VERTICAL 6-STEP TIMELINE (Chuẩn Hasaki / Shopee / Watsons) -->
            <div class="relative pl-4 sm:pl-6 space-y-6 before:content-[''] before:absolute before:top-3 before:bottom-3 before:left-[27px] sm:before:left-[35px] before:w-0.5 before:bg-slate-200">
                @for (int i = 0; i < Model.TimelineEvents.Count; i++)
                {
                    var ev = Model.TimelineEvents[i];
                    bool isPassed = ev.IsCompleted && !ev.IsCurrent;
                    bool isCurrent = ev.IsCurrent;
                    bool isPending = !ev.IsCompleted && !ev.IsCurrent;

                    string circleClass = ev.IsAlertStep
                        ? "bg-rose-600 text-white ring-4 ring-rose-100"
                        : (isCurrent
                            ? "bg-magenta-accent text-white ring-4 ring-magenta-accent/20 animate-pulse"
                            : (isPassed
                                ? "bg-emerald-500 text-white"
                                : "bg-slate-100 text-slate-400 border border-slate-200"));

                    string iconClass = ev.StepIndex switch
                    {
                        1 => "fa-solid fa-clipboard-check",
                        2 => ev.IsAlertStep ? "fa-solid fa-ban" : "fa-solid fa-user-check",
                        3 => "fa-solid fa-boxes-packing",
                        4 => "fa-solid fa-warehouse",
                        5 => "fa-solid fa-truck-fast",
                        6 => "fa-solid fa-house-chimney-check",
                        _ => "fa-solid fa-circle-check"
                    };

                    <div class="relative flex items-start gap-4 sm:gap-5">
                        <!-- Step Node Circle -->
                        <div class="w-9 h-9 rounded-2xl flex items-center justify-center shrink-0 text-sm font-bold shadow-xs z-10 transition-all duration-300 @circleClass">
                            <i class="@iconClass"></i>
                        </div>

                        <!-- Step Content Card -->
                        <div class="flex-1 rounded-2xl p-4 border transition-all @(isCurrent ? (ev.IsAlertStep ? "bg-rose-50/60 border-rose-200" : "bg-pink-50/40 border-magenta-accent/30 shadow-xs") : (isPassed ? "bg-white border-slate-200/80" : "bg-slate-50/60 border-slate-200/50 opacity-75"))">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-[10px] font-mono font-extrabold px-2 py-0.5 rounded-md @(isCompletedOrCurrent(ev) ? "bg-slate-900 text-white" : "bg-slate-200 text-slate-600")">
                                        BƯỚC @ev.StepIndex
                                    </span>
                                    <h3 class="text-sm font-bold @(isCurrent ? (ev.IsAlertStep ? "text-rose-700" : "text-magenta-accent") : (isPassed ? "text-charcoal" : "text-slate-400"))">
                                        @ev.Title
                                    </h3>
                                    @if (isCurrent)
                                    {
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full @(ev.IsAlertStep ? "bg-rose-100 text-rose-700" : "bg-magenta-accent/10 text-magenta-accent")">
                                            Hiện tại
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(ev.FormattedTime))
                                {
                                    <div class="text-xs font-mono font-semibold text-slate-500 flex items-center gap-1.5">
                                        <i class="fa-regular fa-clock text-[10px] text-slate-400"></i>
                                        <span>@ev.FormattedTime</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[11px] text-slate-400 italic">Đang chờ xử lý</span>
                                }
                            </div>

                            <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">
                                @ev.Description
                            </p>

                            <!-- Hiển thị chi tiết Lô FEFO đã cấp phát tại Bước 3 (Đóng gói) -->
                            @if (ev.FefoBatchesSummary != null && ev.FefoBatchesSummary.Any() && (ev.IsCompleted || ev.IsCurrent))
                            {
                                <div class="mt-3 pt-2.5 border-t border-slate-200/60">
                                    <div class="text-[11px] font-bold text-amber-800 mb-1.5 flex items-center gap-1.5">
                                        <i class="fa-solid fa-barcode text-amber-600"></i>
                                        <span>Chi tiết lô FEFO đã cấp phát cho kiện hàng:</span>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var batchInfo in ev.FefoBatchesSummary)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-50 border border-amber-200/80 text-[11px] font-mono text-amber-900">
                                                <i class="fa-solid fa-shield-check text-emerald-600 text-[10px]"></i>
                                                @batchInfo
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Hiển thị mã vận đơn tại Bước 4 & Bước 5 -->
                            @if (!string.IsNullOrWhiteSpace(ev.TrackingCode) && (ev.IsCompleted || ev.IsCurrent))
                            {
                                <div class="mt-2.5 inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-purple-50 border border-purple-200 text-[11px] text-purple-900">
                                    <i class="fa-solid fa-truck-fast text-purple-600"></i>
                                    <span>Mã vận đơn GHN: <strong class="font-mono">@ev.TrackingCode</strong></span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ===================================================
             2. NỘI DUNG CHÍNH (2 CỘT: SẢN PHẨM & TỔNG KẾT TÀI CHÍNH + HÀNH ĐỘNG)
             =================================================== -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- Left Col (8 Cols): Sản phẩm chi tiết & Thông tin giao hàng -->
            <div class="lg:col-span-8 space-y-6">

                <!-- Bảng danh sách sản phẩm & Thông tin FEFO -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm overflow-hidden">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                        <h3 class="text-base font-serif font-bold text-charcoal flex items-center gap-2">
                            <i class="fa-solid fa-basket-shopping text-rose-gold"></i>
                            <span>Kiện Hàng & Danh Sách Sản Phẩm (@Model.Items.Count món)</span>
                        </h3>
                        <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 flex items-center gap-1">
                            <i class="fa-solid fa-shield-halved text-[10px]"></i> Đảm bảo chuẩn FEFO hạn xa
                        </span>
                    </div>

                    <div class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            <div class="py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                <div class="flex items-start gap-4">
                                    <a href="/Product/Detail/@item.ProductId" class="w-20 h-20 rounded-2xl bg-slate-100 border border-slate-100 overflow-hidden shrink-0 shadow-xs block">
                                        <img src="@item.ThumbnailUrl"
                                             alt="@item.ProductName"
                                             class="w-full h-full object-cover"
                                             onerror="this.src='/images/branding/default-product.png'" />
                                    </a>
                                    <div>
                                        <a href="/Product/Detail/@item.ProductId" class="text-sm font-bold text-charcoal hover:text-magenta-accent transition">
                                            @item.ProductName
                                        </a>
                                        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 mt-1">
                                            <span class="font-mono text-[11px] text-slate-400">SKU: @item.Sku</span>
                                            @if (!string.IsNullOrEmpty(item.VariantName))
                                            {
                                                <span class="text-slate-300">•</span>
                                                <span class="text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md text-[11px]">@item.VariantName</span>
                                            }
                                        </div>

                                        <!-- FEFO Batch & Expiry Tag -->
                                        <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-50/80 border border-amber-200/80 text-[11px] text-amber-900">
                                            <i class="fa-solid fa-barcode text-amber-700"></i>
                                            <span>Lô FEFO: <strong class="font-mono">@item.FefoBatchNumber</strong></span>
                                            <span class="text-amber-300">|</span>
                                            <i class="fa-regular fa-calendar-check text-amber-700"></i>
                                            <span>HSD: <strong class="font-mono">@(item.FefoExpiryDate?.ToString("dd/MM/yyyy") ?? "Hạn xa 36 tháng")</strong></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-left sm:text-right shrink-0">
                                    <div class="text-sm font-bold text-charcoal font-mono">
                                        @item.LineTotal.ToString("N0") ₫
                                    </div>
                                    <div class="text-xs text-slate-400 mt-0.5">
                                        @item.UnitPrice.ToString("N0") ₫ × @item.Quantity
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Thông tin giao hàng & Ghi chú -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
                    <h3 class="text-base font-serif font-bold text-charcoal mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-location-dot text-magenta-accent"></i>
                        <span>Địa Chỉ & Thông Tin Nhận Hàng</span>
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-slate-50/80 p-4 rounded-2xl border border-slate-100">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Người Nhận</div>
                            <div class="text-sm font-bold text-charcoal flex items-center gap-2">
                                <i class="fa-regular fa-user text-slate-400"></i>
                                <span>@Model.RecipientName</span>
                            </div>
                            <div class="text-xs font-mono text-slate-600 mt-1 flex items-center gap-2">
                                <i class="fa-solid fa-phone text-slate-400"></i>
                                <span>@Model.RecipientPhone</span>
                            </div>
                        </div>

                        <div class="bg-slate-50/80 p-4 rounded-2xl border border-slate-100">
                            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Địa Chỉ Nhận Hàng</div>
                            <div class="text-xs text-slate-700 leading-relaxed flex items-start gap-2">
                                <i class="fa-solid fa-map-pin text-slate-400 mt-0.5"></i>
                                <span>@Model.ShippingAddress</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.OrderNote))
                    {
                        <div class="mt-4 p-3.5 rounded-2xl bg-amber-50/60 border border-amber-200/60 text-xs text-amber-900 flex items-start gap-2.5">
                            <i class="fa-regular fa-note-sticky text-amber-600 mt-0.5"></i>
                            <div>
                                <strong class="font-bold">Ghi chú đơn hàng:</strong> @Model.OrderNote
                            </div>
                        </div>
                    }
                </div>

            </div>

            <!-- Right Col (4 Cols): Tóm tắt tài chính, Hủy đơn, Đổi trả 7 ngày, Mua Lại & Xuất VAT -->
            <div class="lg:col-span-4 space-y-6">

                <!-- Bảng tổng kết tài chính & Điểm thưởng -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
                    <h3 class="text-base font-serif font-bold text-charcoal mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-receipt text-slate-400"></i>
                        <span>Chi Tiết Thanh Toán</span>
                    </h3>

                    <div class="space-y-3 text-xs">
                        <div class="flex items-center justify-between text-slate-600">
                            <span>Tạm tính tiền hàng:</span>
                            <span class="font-mono font-semibold text-charcoal">@Model.SubTotal.ToString("N0") ₫</span>
                        </div>

                        <div class="flex items-center justify-between text-slate-600">
                            <span>Phí vận chuyển:</span>
                            @if (Model.ShippingFee == 0)
                            {
                                <span class="text-emerald-600 font-bold">Miễn phí (Freeship)</span>
                            }
                            else
                            {
                                <span class="font-mono font-semibold text-charcoal">@Model.ShippingFee.ToString("N0") ₫</span>
                            }
                        </div>

                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="flex items-center justify-between text-magenta-accent">
                                <span class="flex items-center gap-1">
                                    <i class="fa-solid fa-ticket"></i> Ưu đãi giảm giá:
                                </span>
                                <span class="font-mono font-bold">-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }

                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-sm font-bold text-charcoal">Tổng thanh toán:</span>
                            <span class="text-xl font-bold font-mono text-magenta-accent">
                                @Model.TotalAmount.ToString("N0") ₫
                            </span>
                        </div>
                    </div>

                    <div class="mt-5 p-3.5 rounded-2xl bg-amber-50/70 border border-amber-200/80 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-lg shrink-0 shadow-xs">
                            <i class="fa-solid fa-crown"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-amber-950">
                                +@Model.LoyaltyPointsEarned Điểm Thưởng Omni Club
                            </div>
                            <div class="text-[11px] text-amber-800">
                                Điểm tự động cộng vào Ví VIP sau khi đơn hàng giao thành công.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thẻ Hành Động: Hủy đơn (khi PENDING), Yêu cầu Đổi/Trả (trong 7 ngày), Mua lại & Xuất VAT -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-3">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Thao Tác Đơn Hàng</h3>

                    <!-- 1. NÚT HỦY ĐƠN HÀNG (Chỉ hiển thị khi đơn ở trạng thái PENDING - Chờ xác nhận) -->
                    @if (Model.CanCancel)
                    {
                        <button type="button"
                                @@click="cancelModalOpen = true"
                                class="w-full py-3.5 px-4 rounded-2xl border-2 border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-ban"></i>
                            <span>Hủy Đơn Hàng (Hoàn Tồn Lô FEFO)</span>
                        </button>
                    }
                    else if (Model.OrderStatus != "CANCELLED" && Model.OrderStatus != "COMPLETED")
                    {
                        <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 text-[11px] text-slate-500 flex items-start gap-2">
                            <i class="fa-solid fa-lock text-slate-400 mt-0.5"></i>
                            <span>Đơn hàng đã được xác nhận & điều phối kho FEFO nên không thể tự hủy online.</span>
                        </div>
                    }

                    <!-- 2. NÚT YÊU CẦU ĐỔI / TRẢ HÀNG (Chỉ hiển thị khi COMPLETED trong vòng 7 ngày) -->
                    @if (Model.CanRequestReturn)
                    {
                        <button type="button"
                                @@click="returnModalOpen = true"
                                class="w-full py-3.5 px-4 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rotate-left text-amber-600"></i>
                            <span>Yêu Cầu Đổi / Trả Hàng (Còn @Model.ReturnDaysRemaining ngày)</span>
                        </button>
                    }

                    <!-- 3. NÚT "MUA LẠI ĐƠN NÀY" (Re-order in 1-click) -->
                    <form method="post" asp-action="Reorder" asp-controller="Customer">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit"
                                class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-magenta-accent to-pink-600 hover:from-pink-600 hover:to-magenta-accent text-white font-bold text-xs shadow-md hover:shadow-lg hover:shadow-magenta-accent/25 transition flex items-center justify-center gap-2 group">
                            <i class="fa-solid fa-arrows-rotate group-hover:rotate-180 transition-transform duration-500"></i>
                            <span>Mua Lại Đơn Này (1-Click)</span>
                        </button>
                    </form>

                    <!-- 4. NÚT "YÊU CẦU XUẤT HÓA ĐƠN VAT" -->
                    @if (Model.HasVatRequested)
                    {
                        <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2.5">
                            <i class="fa-solid fa-circle-check text-emerald-600 text-sm shrink-0"></i>
                            <div>
                                <div class="font-bold">Đã gửi yêu cầu xuất hóa đơn VAT</div>
                                <div class="text-[11px] text-emerald-700">MST: @(Model.VatInfo?.TaxCode ?? "Đã ghi nhận") • Đang phát hành</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                @@click="vatModalOpen = true"
                                class="w-full py-3 px-4 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs transition flex items-center justify-center gap-2 shadow-2xs">
                            <i class="fa-solid fa-file-invoice-dollar text-slate-400"></i>
                            <span>Yêu Cầu Xuất Hóa Đơn VAT</span>
                        </button>
                    }

                    <div class="pt-2 text-center">
                        <a href="tel:19008899" class="text-xs text-slate-500 hover:text-magenta-accent font-medium inline-flex items-center gap-1.5 transition">
                            <i class="fa-solid fa-headset text-slate-400"></i> Cần hỗ trợ đơn hàng? Gọi 1900 8899
                        </a>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================
         MODAL 1: KHÁCH HÀNG HỦY ĐƠN (CHỌN LÝ DO & HOÀN TỒN FEFO)
         =================================================== -->
    <div x-show="cancelModalOpen"
         x-cloak
         class="fixed inset-0 z-50 overflow-y-auto"
         role="dialog"
         aria-modal="true">
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"
             @@click="cancelModalOpen = false"></div>

        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:w-full sm:max-w-lg border border-slate-100">
                <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-rose-50/60">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-ban"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-serif font-bold text-charcoal">Xác Nhận Hủy Đơn Hàng #@Model.OrderCode</h3>
