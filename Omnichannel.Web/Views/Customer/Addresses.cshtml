    // Dữ liệu danh sách địa chỉ từ Server
    const SERVER_ADDRESSES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Addresses));

    function addressManager() {
        return {
            modalOpen: false,
            isEditMode: false,
            provinceList: VIETNAM_LOCATIONS,
            availableDistricts: [],
            availableWards: [],
            formData: {
                id: 0,
                fullName: '',
                phoneNumber: '',
                province: '',
                district: '',
                ward: '',
                detailedAddress: '',
                label: 'NHÀ RIÊNG',
                isDefault: false
            },

            openCreateModal() {
                this.isEditMode = false;
                this.formData = {
                    id: 0,
                    fullName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerName ?? "")),
                    phoneNumber: '',
                    province: '',
                    district: '',
                    ward: '',
                    detailedAddress: '',
                    label: 'NHÀ RIÊNG',
                    isDefault: @(Model.Addresses == null || !Model.Addresses.Any() ? "true" : "false")
                };
                this.availableDistricts = [];
                this.availableWards = [];
                this.modalOpen = true;
            },

            editAddressById(addressId) {
                const addr = SERVER_ADDRESSES.find(a => (a.Id || a.id) === addressId);
                if (!addr) return;

                this.isEditMode = true;
                this.formData = {
                    id: addr.Id || addr.id,
                    fullName: addr.FullName || addr.fullName || '',
                    phoneNumber: addr.PhoneNumber || addr.phoneNumber || '',
                    province: addr.Province || addr.province || '',
                    district: addr.District || addr.district || '',
                    ward: addr.Ward || addr.ward || '',
                    detailedAddress: addr.DetailedAddress || addr.detailedAddress || '',
                    label: addr.Label || addr.label || 'NHÀ RIÊNG',
                    isDefault: addr.IsDefault || addr.isDefault || false
                };

                // Cập nhật dropdown động
                this.updateDistrictsForProvince(this.formData.province);
                this.updateWardsForDistrict(this.formData.province, this.formData.district);

                this.modalOpen = true;
            },

            onProvinceChange() {
                this.formData.district = '';
                this.formData.ward = '';
                this.availableWards = [];
                this.updateDistrictsForProvince(this.formData.province);
            },

            onDistrictChange() {
                this.formData.ward = '';
                this.updateWardsForDistrict(this.formData.province, this.formData.district);
            },

            updateDistrictsForProvince(provinceName) {
                const foundProvince = this.provinceList.find(p => p.name === provinceName);
                if (foundProvince) {
                    this.availableDistricts = foundProvince.districts;
                } else {
                    this.availableDistricts = [];
                }
            },

            updateWardsForDistrict(provinceName, districtName) {
                const foundProvince = this.provinceList.find(p => p.name === provinceName);
                if (foundProvince) {
                    const foundDistrict = foundProvince.districts.find(d => d.name === districtName);
                    if (foundDistrict) {
                        this.availableWards = foundDistrict.wards;
                        return;
                    }
                }
                this.availableWards = [];
            },

            validateForm(e) {
                if (!this.formData.province || !this.formData.district || !this.formData.ward) {
                    if (e) e.preventDefault();
                    alert("Vui lòng chọn đầy đủ Tỉnh/Thành phố, Quận/Huyện và Phường/Xã!");
                    return false;
                }
                return true;
            }
        };
    }
