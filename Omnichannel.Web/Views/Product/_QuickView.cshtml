@model Omnichannel.Domain.Entities.Product
@{
    var p = Model;
    var gallery3 = ProductImageResolver.GetGalleryImageUrls(p.ThumbnailUrl, p.ImagesJson, p.Sku, p.Slug, p.Name).Take(3).ToList();
    var firstImg = gallery3.FirstOrDefault() ?? ProductImageResolver.PlaceholderUrl;
    var altText = ProductImageResolver.GetAltText(p.Name, p.Brand?.Name, p.Category?.Name, p.Sku, p.Slug);
    var originalPrice = p.SellingPrice * 1.25m;
    var isColorVariant = p.Variants != null && p.Variants.Any(v => !string.IsNullOrEmpty(v.SwatchColorHex) || !string.IsNullOrEmpty(v.ColorHex));
    var bestBatch = p.Batches?.Where(b => b.CurrentQuantity > 0).OrderBy(b => b.ExpDate).FirstOrDefault();
    var clearancePrice = Math.Round(p.SellingPrice * 0.55m / 1000m) * 1000m;
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-6 p-6 sm:p-8" x-data="quickViewItemComponent({
    productId: @p.Id,
    firstImg: '@firstImg',
    freshPrice: @(p.Variants != null && p.Variants.Any() ? p.Variants.First().SellingPrice : p.SellingPrice),
    clearancePrice: @clearancePrice,
    variantName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Variants != null && p.Variants.Any() ? p.Variants.First().VariantName : p.Name))'
})">
    <!-- CỘT TRÁI: GALLERY 3 ẢNH -->
    <div class="md:col-span-5 space-y-3">
        <!-- Ảnh Chính Lớn -->
        <div class="relative aspect-square rounded-2xl overflow-hidden bg-slate-50 border border-slate-200/80 shadow-xs" style="aspect-ratio: 1/1;">
            <img :src="activeImg" 
                 width="400"
                 height="400"
                 decoding="async"
                 alt="@p.Name" 
                 class="w-full h-full object-cover transition-all duration-300 will-change-transform" />
            
            <div class="absolute top-3 left-3 z-10">
                <span class="badge-fefo-fresh text-[10px] px-2.5 py-0.5 shadow-sm">
                    <i class="fa-solid fa-shield-check mr-1"></i> Chính Hãng 100%
                </span>
            </div>
        </div>

        <!-- Băng Chuyền 3 Thumbnails Nhỏ Dưới -->
        <div class="grid grid-cols-3 gap-2.5">
            @for (int i = 0; i < gallery3.Count; i++)
            {
                var thumb = gallery3[i];
                <button type="button" 
                        @@click="activeImg = '@thumb'"
                        :class="activeImg === '@thumb' ? 'border-magenta-accent ring-2 ring-magenta-accent/20 scale-102' : 'border-slate-200 hover:border-slate-300'"
                        class="aspect-square rounded-xl overflow-hidden border-2 p-0.5 bg-white transition-all shadow-2xs">
                    <img src="@thumb" class="w-full h-full object-cover rounded-lg" alt="Thumbnail @(i+1)" />
                </button>
            }
        </div>
    </div>

    <!-- CỘT PHẢI: THÔNG TIN CHI TIẾT & CHỌN BIẾN THỂ -->
    <div class="md:col-span-7 flex flex-col justify-between space-y-4">
        
        <!-- Header Info: Brand, Category, Name, Rating -->
        <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px] text-slate-500">
                <span class="font-bold text-rose-gold uppercase tracking-wider">
                    @(p.Brand?.Name ?? p.ManufacturerName ?? "CANMAKE BEAUTY")
                </span>
                <span class="font-mono text-slate-400">SKU: @p.Sku</span>
            </div>

            <h3 class="font-serif font-bold text-lg sm:text-xl text-charcoal leading-snug">
                @p.Name
            </h3>

            <!-- Rating Bar -->
            <div class="flex items-center gap-2 text-xs">
                <div class="flex text-amber-400 text-xs gap-0.5">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <span class="font-bold text-charcoal text-[11px]">4.9 / 5</span>
                <span class="text-slate-300">|</span>
                <span class="text-slate-500 text-[11px]">128 đánh giá kiểm định</span>
            </div>
        </div>

        <!-- Price Box -->
        <div class="p-3.5 rounded-xl bg-pastel-rose/50 border border-soft-border flex items-baseline gap-3">
            <span class="font-mono-numeric font-bold text-2xl text-charcoal" x-text="new Intl.NumberFormat('vi-VN').format(selectedPrice) + ' ₫'">
                @p.SellingPrice.ToString("N0") ₫
            </span>
            <span class="font-mono-numeric text-xs text-slate-400 line-through">
                @originalPrice.ToString("N0") ₫
            </span>
            <span class="px-2 py-0.5 rounded-full text-white font-bold text-[10px]"
                  :class="selectedBatchType === 'clearance' ? 'bg-gradient-to-r from-amber-500 to-rose-600' : 'bg-magenta-accent'"
                  x-text="selectedBatchType === 'clearance' ? 'Tiết kiệm 45%' : 'Giá chuẩn'">
                Giá chuẩn
            </span>
        </div>

        <!-- 1. BỘ CHỌN BIẾN THỂ (Swatch Màu Hoặc Dung Tích) -->
        @if (p.Variants != null && p.Variants.Any())
        {
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-bold text-charcoal">
                        @(isColorVariant ? "Chọn Tone Màu:" : "Chọn Dung Tích:")
                    </span>
                    <span class="font-bold text-magenta-accent text-[11px]" x-text="selectedVariantName"></span>
                </div>

                @if (isColorVariant)
                {
                    <!-- Swatch màu son tròn -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        @foreach (var v in p.Variants)
                        {
                            var hex = !string.IsNullOrEmpty(v.SwatchColorHex) ? v.SwatchColorHex : (!string.IsNullOrEmpty(v.ColorHex) ? v.ColorHex : "#B76E79");
                            var vImg = !string.IsNullOrEmpty(v.SwatchImageUrl) ? v.SwatchImageUrl : p.ThumbnailUrl;
                            <button type="button" 
                                    @@click="selectVariant('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))', @v.SellingPrice, '@vImg')"
                                    :class="selectedVariantName.includes('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))') ? 'ring-2 ring-magenta-accent ring-offset-2 scale-110' : 'border border-slate-200 hover:scale-105'"
                                    class="w-8 h-8 rounded-full transition-all flex items-center justify-center shadow-xs"
                                    style="background-color: @hex;"
                                    title="@v.VariantName">
                            </button>
                        }
                    </div>
                }
                else
                {
                    <!-- Dung tích pill -->
                    <div class="flex items-center gap-2 flex-wrap">
                        @foreach (var v in p.Variants)
                        {
                            var vImg = !string.IsNullOrEmpty(v.SwatchImageUrl) ? v.SwatchImageUrl : p.ThumbnailUrl;
                            <button type="button" 
                                    @@click="selectVariant('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))', @v.SellingPrice, '@vImg')"
                                    :class="selectedVariantName.includes('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))') ? 'bg-charcoal text-white border-charcoal shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-magenta-accent'"
                                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition-all">
                                @(!string.IsNullOrEmpty(v.Volume) ? v.Volume : v.VariantName)
                            </button>
                        }
                    </div>
                }
            </div>
        }

        <!-- 2. BỘ CHỌN LÔ FEFO MINH BẠCH -->
        <div class="space-y-1.5">
            <span class="text-xs font-bold text-charcoal block">Chọn Lô Hàng FEFO:</span>
            <div class="grid grid-cols-2 gap-2 text-xs">
                <div @@click="selectBatch('fresh')"
                     :class="selectedBatchType === 'fresh' ? 'border-emerald-500 bg-emerald-50/50 ring-1 ring-emerald-500' : 'border-slate-200 bg-white'"
                     class="p-2.5 rounded-xl border cursor-pointer transition flex items-center justify-between">
                    <div>
                        <div class="font-bold text-[11px] text-charcoal">Lô Mới Nhất</div>
                        <div class="text-[10px] text-slate-400">HSD: 08/2028 (Chuẩn 100%)</div>
                    </div>
                    <i class="fa-solid fa-circle-check text-xs" :class="selectedBatchType === 'fresh' ? 'text-emerald-600' : 'text-slate-200'"></i>
                </div>

                <div @@click="selectBatch('clearance')"
                     :class="selectedBatchType === 'clearance' ? 'border-amber-500 bg-amber-50/50 ring-1 ring-amber-500' : 'border-slate-200 bg-white'"
                     class="p-2.5 rounded-xl border cursor-pointer transition flex items-center justify-between">
                    <div>
                        <div class="font-bold text-[11px] text-charcoal">Lô Cận Date 6 Tháng</div>
                        <div class="text-[10px] text-rose-600 font-bold">HSD: 10/2026 (Giảm 45%)</div>
                    </div>
                    <i class="fa-solid fa-circle-check text-xs" :class="selectedBatchType === 'clearance' ? 'text-amber-600' : 'text-slate-200'"></i>
                </div>
            </div>
        </div>

        <!-- 3. SỐ LƯỢNG & NÚT HÀNH ĐỘNG -->
        <div class="pt-2 space-y-3">
            <div class="flex items-center gap-4">
                <span class="text-xs font-bold text-slate-700">Số Lượng:</span>
                <div class="flex items-center rounded-full border border-slate-200 bg-slate-50 p-0.5">
                    <button type="button" @@click="if(quantity > 1) quantity--" class="w-7 h-7 rounded-full bg-white hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-600 shadow-2xs transition">
                        <i class="fa-solid fa-minus text-[10px]"></i>
                    </button>
                    <span class="w-10 text-center font-mono-numeric font-bold text-xs text-charcoal" x-text="quantity">1</span>
                    <button type="button" @@click="quantity++" class="w-7 h-7 rounded-full bg-white hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-600 shadow-2xs transition">
                        <i class="fa-solid fa-plus text-[10px]"></i>
                    </button>
                </div>
                <span class="text-[11px] text-emerald-600 font-medium">
                    <i class="fa-solid fa-check"></i> Sẵn hàng giao 2H
                </span>
            </div>

            <div class="flex gap-2.5">
                <!-- Nút Thêm Vào Giỏ (Không Reload Trang) -->
                <button type="button" 
                        @@click="addToCartFromQuickView()"
                        class="flex-1 py-3 px-4 rounded-full bg-magenta-accent text-white font-bold text-xs uppercase tracking-wider hover:bg-[#b0276a] shadow-lg shadow-magenta-accent/25 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-bag-shopping text-sm"></i>
                    <span>Thêm Vào Giỏ Hàng</span>
                </button>

                <!-- Nút Xem Chi Tiết -->
                <a href="/Product/Detail/@p.Slug" class="py-3 px-4 rounded-full border border-slate-200 hover:border-charcoal text-charcoal font-bold text-xs uppercase tracking-wider transition flex items-center justify-center" title="Xem đầy đủ thông tin chuyên sâu">
                    <span>Xem Chi Tiết</span>
                </a>
            </div>
        </div>

    </div>
</div>
