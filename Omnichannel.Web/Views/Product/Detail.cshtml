            </div>
        }

        <!-- 5. SECTION: RECENTLY VIEWED PRODUCTS (Sản phẩm bạn đã xem gần đây) - PHIÊN C2 -->
        <div class="mt-16 pt-10 border-t border-soft-border"
             x-data="recentlyViewedCarousel(@Model.Product.Id)"
             x-init="init()"
             x-show="products && products.length > 0"
             style="display: none;">
            
            <div class="flex items-center justify-between mb-8">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-rose-gold">Dành Riêng Cho Bạn</span>
                    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal mt-1">Sản Phẩm Bạn Đã Xem Gần Đây</h2>
                </div>
                <button type="button" @@click="clearHistory()" class="text-xs font-bold text-slate-400 hover:text-rose-600 transition flex items-center gap-1 cursor-pointer">
                    <i class="fa-solid fa-trash-can text-[10px]"></i>
                    <span>Xóa lịch sử xem</span>
                </button>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
                <template x-for="item in products" :key="item.id">
                    <div class="product-card-luxury group bg-white rounded-2xl border border-slate-200/80 p-3 hover:border-magenta-accent/40 hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-slate-50 mb-2.5">
                                <img :src="item.imageUrl" :alt="item.name" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
                            </div>
                            <span class="text-[9px] uppercase font-bold tracking-wider text-rose-gold truncate block" x-text="item.brandName"></span>
                            <a :href="'/san-pham/' + item.slug" class="block mt-0.5">
                                <h4 class="font-serif font-bold text-charcoal text-xs leading-snug line-clamp-2 hover:text-magenta-accent transition" x-text="item.name"></h4>
                            </a>
                        </div>
                        <div class="mt-3 pt-2 border-t border-slate-100">
                            <div class="flex items-baseline justify-between gap-1">
                                <span class="font-mono-numeric font-bold text-xs text-charcoal" x-text="formatPrice(item.salePrice || item.price)"></span>
                                <button type="button" 
                                        @@click="quickAddToCart(item)"
                                        class="p-1.5 rounded-lg bg-pastel-rose text-magenta-accent hover:bg-magenta-accent hover:text-white transition text-xs shadow-2xs cursor-pointer"
                                        title="Thêm nhanh vào giỏ">
                                    <i class="fa-solid fa-cart-plus text-[11px]"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

    </div>
</div>

<script>
    // 1. Tự động lưu sản phẩm đang xem vào localStorage
    (function() {
        try {
            var curId = @p.Id;
            var key = 'omni_recently_viewed_ids';
            var ids = [];
            var stored = localStorage.getItem(key);
            if (stored) {
                try { ids = JSON.parse(stored); } catch (e) { ids = []; }
            }
            if (!Array.isArray(ids)) ids = [];
            ids = [curId].concat(ids.filter(function(id) { return id !== curId; })).slice(0, 12);
            localStorage.setItem(key, JSON.stringify(ids));
        } catch (e) { }
    })();

    // 2. Component Alpine cho gói Frequently Bought Together
    function fbtBundleComponent(initialData) {
        return {
            bundle: initialData,
            isSubmitting: false,
            selectedIds: [],
            totalSelectedPrice: 0,
            totalOriginalPrice: 0,
            selectedCount: 1,

            init() {
                if (!this.bundle) return;
                this.selectedIds = [this.bundle.currentProduct.id];
                if (this.bundle.bundleProducts) {
                    this.bundle.bundleProducts.forEach(p => {
                        p.isSelected = true;
                        this.selectedIds.push(p.id);
                    });
                }
                this.updateCalculations();
            },

            toggleItem(item) {
                item.isSelected = !item.isSelected;
                this.updateCalculations();
            },

            updateCalculations() {
                if (!this.bundle) return;
                const cur = this.bundle.currentProduct;
                let selTotal = cur.salePrice || cur.price;
                let origTotal = cur.price;
                let count = 1;
                const ids = [cur.id];

                if (this.bundle.bundleProducts) {
                    this.bundle.bundleProducts.forEach(p => {
                        if (p.isSelected) {
                            selTotal += (p.salePrice || p.price);
                            origTotal += p.price;
                            count++;
                            ids.push(p.id);
                        }
                    });
                }

                if (count >= 2 && selTotal === origTotal) {
                    selTotal = Math.round(origTotal * 0.95);
                }

                this.totalSelectedPrice = selTotal;
                this.totalOriginalPrice = origTotal;
                this.selectedCount = count;
                this.selectedIds = ids;
            },

            async addAllSelectedToCart() {
                if (this.isSubmitting || this.selectedIds.length === 0) return;
                this.isSubmitting = true;
                try {
                    const res = await fetch('/api/cart/add-bundle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ productIds: this.selectedIds })
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        window.dispatchEvent(new CustomEvent('cart-updated', { detail: data }));
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || 'Đã thêm combo vào giỏ hàng!',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                        window.dispatchEvent(new CustomEvent('open-cart-drawer'));
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'error', title: 'Thông báo', text: data.message || 'Không thể thêm combo vào giỏ.' });
                        }
                    }
                } catch (e) {
                    console.error('Lỗi thêm combo:', e);
                } finally {
                    this.isSubmitting = false;
                }
            },

            formatPrice(val) {
                if (!val) return '0 ₫';
                return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
            }
        };
    }

    // 3. Component Alpine cho danh sách Recently Viewed Products
    function recentlyViewedCarousel(currentProductId) {
        return {
            products: [],
            loading: false,

            async init() {
                try {
                    const stored = localStorage.getItem('omni_recently_viewed_ids');
                    if (!stored) return;
                    const ids = JSON.parse(stored);
                    if (!Array.isArray(ids)) return;
                    const filtered = ids.filter(id => id !== currentProductId).slice(0, 8);
                    if (filtered.length === 0) return;

                    this.loading = true;
                    const res = await fetch('/api/products/by-ids?ids=' + filtered.join(','));
                    if (res.ok) {
                        this.products = await res.json();
                    }
                } catch (e) {
                    console.error('Lỗi tải sản phẩm đã xem:', e);
                } finally {
                    this.loading = false;
                }
            },

            async quickAddToCart(item) {
                try {
                    const res = await fetch('/api/cart/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: item.id, quantity: 1 })
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        window.dispatchEvent(new CustomEvent('cart-updated', { detail: data }));
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'Đã thêm ' + item.name + ' vào giỏ hàng!',
                                showConfirmButton: false,
                                timer: 2500
                            });
                        }
                        window.dispatchEvent(new CustomEvent('open-cart-drawer'));
                    }
                } catch (e) { }
            },

            clearHistory() {
                localStorage.removeItem('omni_recently_viewed_ids');
                this.products = [];
            },

            formatPrice(val) {
                if (!val) return '0 ₫';
                return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
            }
        };
    }
</script>
