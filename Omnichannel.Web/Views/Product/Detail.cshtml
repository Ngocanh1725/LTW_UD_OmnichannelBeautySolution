@model Omnichannel.Web.Models.ProductDetailViewModel
@{
    var p = Model.Product;
    ViewData["Title"] = $"{p.Name} | OMNI BEAUTY";
    ViewData["Description"] = p.ShortDescription ?? $"{p.Name} chính hãng chuẩn FEFO, giao hàng tốc hành 2H.";
    var mainImg = p.ThumbnailMediaId.HasValue 
        ? $"/media/{p.ThumbnailMediaId}" 
        : (Model.GalleryImages.FirstOrDefault() ?? (!string.IsNullOrEmpty(p.ThumbnailUrl) ? p.ThumbnailUrl : "/images/products/_placeholder.webp"));
    var hasDiscount = p.DiscountPrice.HasValue && p.DiscountPrice.Value > 0 && p.DiscountPrice.Value < p.SellingPrice;
    var originalPrice = p.SellingPrice;
    var isLipstickOrMakeup = p.Variants != null && p.Variants.Any(v => !string.IsNullOrEmpty(v.SwatchColorHex) || !string.IsNullOrEmpty(v.ColorHex));

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var productUrl = $"{baseUrl}/Product/Detail/{p.Slug}";
    var categoryUrl = p.Category != null ? $"{baseUrl}/category/{p.Category.Slug}" : $"{baseUrl}/category";
    ViewData["CanonicalUrl"] = productUrl;
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = mainImg;

    var productImages = new List<string>();
    if (!string.IsNullOrEmpty(mainImg)) productImages.Add(mainImg.StartsWith("http") ? mainImg : $"{baseUrl}{mainImg}");
    if (Model.GalleryImages != null)
    {
        foreach (var img in Model.GalleryImages.Take(5))
        {
            var fullImg = img.StartsWith("http") ? img : $"{baseUrl}{img}";
            if (!productImages.Contains(fullImg)) productImages.Add(fullImg);
        }
    }

    var finalPrice = (p.DiscountPrice.HasValue && p.DiscountPrice.Value > 0) ? p.DiscountPrice.Value : p.SellingPrice;
    var rawDesc = p.Description ?? p.ShortDescription ?? $"{p.Name} chính hãng cao cấp tại OMNI BEAUTY chuẩn hạn dùng FEFO.";
    var cleanDesc = System.Text.RegularExpressions.Regex.Replace(rawDesc, "<.*?>", string.Empty).Trim();
    if (cleanDesc.Length > 300) cleanDesc = cleanDesc.Substring(0, 300) + "...";

    var expDateStr = Model.NearestBatch?.ExpDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(18).ToString("yyyy-MM-dd");
    var batchNo = Model.NearestBatch?.BatchNumber ?? "FEFO-L01";

    var ratingVal = Model.AverageRating > 0 ? Math.Round(Model.AverageRating, 1) : 5.0;
    var reviewCnt = Model.TotalReviews > 0 ? Model.TotalReviews : (Model.Reviews?.Count > 0 ? Model.Reviews.Count : 15);

    var breadcrumbSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang Chủ", ["item"] = $"{baseUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = p.Category?.Name ?? "Mỹ Phẩm Cao Cấp", ["item"] = categoryUrl },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = p.Name, ["item"] = productUrl }
        }
    };

    var productSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["@id"] = $"{productUrl}#product",
        ["name"] = p.Name,
        ["image"] = productImages.ToArray(),
        ["description"] = cleanDesc,
        ["sku"] = !string.IsNullOrEmpty(p.Sku) ? p.Sku : $"SKU-{p.Id}",
        ["mpn"] = !string.IsNullOrEmpty(p.Barcode) ? p.Barcode : (!string.IsNullOrEmpty(p.Sku) ? p.Sku : $"MPN-{p.Id}"),
        ["category"] = p.Category?.Name ?? "Mỹ Phẩm & Chăm Sóc Da",
        ["brand"] = new Dictionary<string, object?>
        {
            ["@type"] = "Brand",
            ["name"] = p.Brand?.Name ?? "OMNI BEAUTY"
        },
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["url"] = productUrl,
            ["priceCurrency"] = "VND",
            ["price"] = finalPrice,
            ["priceValidUntil"] = DateTime.UtcNow.AddYears(1).ToString("yyyy-12-31"),
            ["itemCondition"] = "https://schema.org/NewCondition",
            ["availability"] = "https://schema.org/InStock",
            ["seller"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "OMNI BEAUTY",
                ["url"] = $"{baseUrl}/"
            }
        },
        ["additionalProperty"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Tiêu chuẩn kiểm soát hạn dùng", ["value"] = "FEFO (First Expired, First Out)" },
            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Mã lô sản xuất", ["value"] = batchNo },
            new Dictionary<string, object?> { ["@type"] = "PropertyValue", ["name"] = "Hạn sử dụng khuyến cáo", ["value"] = expDateStr }
        },
        ["aggregateRating"] = new Dictionary<string, object?>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = ratingVal,
            ["bestRating"] = 5,
            ["worstRating"] = 1,
            ["reviewCount"] = reviewCnt
        }
    };

    if (Model.Reviews != null && Model.Reviews.Any())
    {
        productSchema["review"] = Model.Reviews.Take(5).Select(r => new Dictionary<string, object?>
        {
            ["@type"] = "Review",
            ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = !string.IsNullOrEmpty(r.UserName) ? r.UserName : "Khách hàng OMNI BEAUTY" },
            ["datePublished"] = r.CreatedAt.ToString("yyyy-MM-dd"),
            ["reviewBody"] = !string.IsNullOrEmpty(r.Content) ? r.Content : (!string.IsNullOrEmpty(r.Title) ? r.Title : "Sản phẩm chính hãng chất lượng cao, date mới tinh."),
            ["reviewRating"] = new Dictionary<string, object?>
            {
                ["@type"] = "Rating",
                ["ratingValue"] = r.Rating > 0 ? r.Rating : 5,
                ["bestRating"] = 5,
                ["worstRating"] = 1
            }
        }).ToArray();
    }
}

<!-- Structured Data: BreadcrumbList Schema (Google Rich Results) -->
<script type="application/ld+json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(breadcrumbSchema, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }))
</script>

<!-- Structured Data: Product Schema with Offers, Rating & FEFO Expiry (Google Rich Results) -->
<script type="application/ld+json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(productSchema, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }))
</script>

<div class="bg-white min-h-screen py-6 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- 1. BREADCRUMB -->
        <nav aria-label="Đường dẫn trang" class="mb-6 text-xs text-slate-500 flex items-center flex-wrap gap-2">
            <a href="/" class="hover:text-magenta-accent transition flex items-center gap-1">
                <i class="fa-solid fa-house text-slate-400"></i> Trang Chủ
            </a>
            <span class="text-slate-300">/</span>
            @if (p.Category != null)
            {
                <a href="/category/@p.Category.Slug" class="hover:text-magenta-accent transition">
                    @p.Category.Name
                </a>
                <span class="text-slate-300">/</span>
            }
            <span class="text-charcoal font-semibold truncate max-w-xs sm:max-w-md">@p.Name</span>
        </nav>

        <!-- 2. MAIN PRODUCT HERO (Interactive Product Gallery + Buy Box) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14" x-data="{ 
            activeMedia: 'image', 
            activeImage: '@mainImg', 
            videoUrl: '@(Model.SwatchVideoUrl ?? "")',
            isZooming: false,
            zoomX: 50,
            zoomY: 50,
            quantity: 1,
            lightboxOpen: false,
            selectedBatchType: 'fresh',
            freshPrice: @(p.Variants != null && p.Variants.Any() ? p.Variants.First().SellingPrice : p.SellingPrice),
            clearancePrice: @Model.ClearancePrice,
            selectedPrice: @(p.Variants != null && p.Variants.Any() ? p.Variants.First().SellingPrice : p.SellingPrice),
            selectedVariantId: @(p.Variants != null && p.Variants.Any() ? p.Variants.First().Id : 0),
            selectedVariantName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Variants != null && p.Variants.Any() ? p.Variants.First().VariantName : p.Name))',
            selectedSku: '@(p.Variants != null && p.Variants.Any() ? p.Variants.First().Sku : p.Sku)',
            freshBatchId: @(Model.FreshBatch?.Id ?? (Model.NearestBatch?.Id ?? 0)),
            clearanceBatchId: @(Model.ClearanceBatch?.Id ?? 0),
            hasClearanceBatch: @(Model.ClearanceBatch != null && Model.ClearanceBatch.CurrentQuantity > 0 ? "true" : "false"),
            currentVariantStock: @(p.Variants != null && p.Variants.Any() && p.Variants.First().StockQuantity > 0 ? p.Variants.First().StockQuantity : (Model.FreshBatch?.CurrentQuantity ?? 120)),
            clearanceStock: @(Model.ClearanceBatch?.CurrentQuantity ?? 0),
            freshStock: @(Model.FreshBatch?.CurrentQuantity ?? 120),
            get availableStock() {
                return (this.selectedBatchType === 'clearance' && this.hasClearanceBatch) ? this.clearanceStock : (this.currentVariantStock || this.freshStock || 120);
            },
            
            handleMouseMove(e) {
                const rect = e.currentTarget.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                this.zoomX = Math.max(0, Math.min(100, x));
                this.zoomY = Math.max(0, Math.min(100, y));
            },
            
            selectBatch(type) {
                if (type === 'clearance' && (!this.hasClearanceBatch || this.clearanceBatchId <= 0)) {
                    return;
                }
                this.selectedBatchType = type;
                if (type === 'clearance') {
                    this.selectedPrice = this.clearancePrice;
                } else {
                    this.selectedPrice = this.freshPrice;
                }
                if (this.quantity > this.availableStock) {
                    this.quantity = Math.max(1, this.availableStock);
                }
            },

            selectVariant(id, name, price, sku, img, stock) {
                this.selectedVariantId = id;
                this.selectedVariantName = name;
                this.freshPrice = price;
                this.clearancePrice = Math.round(price * (1 - @Model.ClearanceDiscountPercent / 100) / 1000) * 1000;
                this.selectedSku = sku;
                this.currentVariantStock = (stock !== undefined && stock > 0) ? stock : this.freshStock;
                if (this.selectedBatchType === 'clearance') {
                    this.selectedPrice = this.clearancePrice;
                } else {
                    this.selectedPrice = this.freshPrice;
                }
                if (img) { 
                    this.activeImage = img; 
                    this.activeMedia = 'image';
                }
                if (this.quantity > this.availableStock) {
                    this.quantity = Math.max(1, this.availableStock);
                }
            },

            openLightbox(img) {
                if (img) this.activeImage = img;
                this.lightboxOpen = true;
            },

            closeLightbox() {
                this.lightboxOpen = false;
            },

            async addToCartHandler() {
                const qty = Math.max(1, parseInt(this.quantity) || 1);
                this.quantity = qty;
                const batchId = this.selectedBatchType === 'clearance' ? this.clearanceBatchId : (this.freshBatchId || null);
                const batchNote = this.selectedBatchType === 'clearance' 
                    ? ' [Lô Cận Date - Tiết kiệm @Model.ClearanceDiscountPercent%]' 
                    : ' [Lô Mới Nhất 100%]';
                const finalVariant = this.selectedVariantName + batchNote;
                
                return await addToCart({
                    productId: @p.Id,
                    title: finalVariant,
                    price: this.selectedPrice,
                    imageUrl: this.activeImage,
                    quantity: qty,
                    batchId: batchId,
                    variantId: this.selectedVariantId || null
                });
            },

            async buyNow() {
                await this.addToCartHandler();
                window.location.href = '/Checkout';
            }
        }">
            
            <!-- Left Column: Gallery Images & Lens Magnifier -->
            <div class="lg:col-span-6 space-y-4">
                
                <!-- Main Large Media Display Container with Magnifier Zoom -->
                <div class="relative aspect-square rounded-3xl overflow-hidden bg-slate-50 border border-soft-border shadow-md group select-none cursor-crosshair"
                     @@mouseenter="if (activeMedia === 'image') isZooming = true"
                     @@mouseleave="isZooming = false"
                     @@mousemove="handleMouseMove($event)">
                    
                    <!-- 1. IMAGE DISPLAY & MAGNIFIER LENS -->
                    <div x-show="activeMedia === 'image'" class="w-full h-full relative cursor-zoom-in" @@click="openLightbox(activeImage)">
                        <!-- Base Product Image -->
                        <img src="@mainImg"
                             :src="activeImage" 
                             alt="@p.Name" 
                             class="w-full h-full object-cover transition-opacity duration-300" 
                             id="mainProductImage" />
                        
                        <!-- High Precision Magnifier Zoom Texture Overlay (Phóng to 2.5x chi tiết chất kem/son/vỏ chai) -->
                        <div x-show="isZooming" 
                             style="display: none;"
                             class="absolute inset-0 pointer-events-none transition-opacity duration-200 z-10"
                             :style="`background-image: url('${activeImage}'); background-position: ${zoomX}% ${zoomY}%; background-size: 260%;`">
                        </div>

                        <!-- Magnifier Reticle Lens Box Indicator -->
                        <div x-show="isZooming" 
                             style="display: none;"
                             class="absolute w-32 h-32 rounded-full border-2 border-magenta-accent/80 shadow-2xl backdrop-blur-[1px] pointer-events-none -translate-x-1/2 -translate-y-1/2 flex items-center justify-center transition-all duration-75 z-20"
                             :style="`left: ${zoomX}%; top: ${zoomY}%; box-shadow: 0 0 25px rgba(224, 86, 136, 0.45);`">
                            <span class="w-2.5 h-2.5 rounded-full bg-magenta-accent"></span>
                            <span class="absolute text-[9px] font-mono font-bold text-white bg-charcoal/80 px-1.5 py-0.5 rounded-full bottom-2 shadow">2.5X</span>
                        </div>

                        <!-- Zoom Hint Tag -->
                        <div x-show="!isZooming" class="absolute bottom-4 right-4 z-20 px-3 py-1.5 rounded-full bg-charcoal/70 backdrop-blur text-white text-[11px] font-medium flex items-center gap-1.5 shadow-lg pointer-events-none">
                            <i class="fa-solid fa-magnifying-glass-plus text-rose-gold text-xs"></i>
                            <span>Rê chuột để soi chất kem 2.5x • Click phóng to</span>
                        </div>
                    </div>

                    <!-- 2. SHORT SWATCH VIDEO PLAYER (Hỗ trợ video ngắn swatch màu son thực tế) -->
                    <div x-show="activeMedia === 'video'" style="display: none;" class="w-full h-full relative bg-charcoal flex items-center justify-center">
                        <video :src="videoUrl" 
                               autoplay loop muted playsinline 
                               @@error="activeMedia = 'image'"
                               class="w-full h-full object-cover"></video>
                        <div class="absolute top-4 left-4 z-20 px-3 py-1.5 rounded-full bg-magenta-accent text-white text-xs font-bold flex items-center gap-1.5 shadow-lg">
                            <i class="fa-solid fa-circle-play animate-pulse text-white"></i>
                            <span>Video Swatch Son Trên Da Thật</span>
                        </div>
                        <button type="button" 
                                @@click="activeMedia = 'image'"
                                class="absolute bottom-4 right-4 z-20 px-3.5 py-1.5 rounded-full bg-white/90 backdrop-blur hover:bg-white text-charcoal font-bold text-xs shadow-md transition flex items-center gap-1.5">
                            <i class="fa-solid fa-image text-slate-500"></i> Xem lại ảnh
                        </button>
                    </div>

                    <!-- Top Left Dynamic Batch Badges -->
                    <div class="absolute top-4 left-4 z-20 flex flex-col gap-1.5 pointer-events-none">
                        <span x-show="selectedBatchType === 'fresh'" class="badge-fefo-fresh text-xs px-3 py-1 shadow-md">
                            <i class="fa-solid fa-shield-halved mr-1"></i> Lô Mới Nhất 100%
                        </span>
                        <span x-show="selectedBatchType === 'clearance'" style="display: none;" class="badge-fefo-clearance text-xs px-3 py-1 shadow-md animate-pulse">
                            <i class="fa-solid fa-fire mr-1"></i> Tiết Kiệm @Model.ClearanceDiscountPercent% Cận Date
                        </span>
                    </div>

                    <!-- Wishlist button -->
                    <!-- Nút So Sánh Sản Phẩm (GAP-03) -->
                    <button type="button" 
                            onclick="window.omniCompare && window.omniCompare.toggle(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', @p.CategoryId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Category?.Name ?? ""))')"
                            class="absolute top-4 right-16 z-20 h-10 w-10 rounded-full bg-white/90 backdrop-blur text-slate-500 hover:text-magenta-accent hover:bg-white shadow-md flex items-center justify-center transition active:scale-90 cursor-pointer"
                            title="Thêm vào khay so sánh mỹ phẩm"
                            aria-label="So sánh mỹ phẩm">
                        <i class="fa-solid fa-scale-balanced text-sm"></i>
                    </button>

                    <button type="button" 
                            class="absolute top-4 right-4 z-20 h-10 w-10 rounded-full bg-white/90 backdrop-blur text-slate-500 hover:text-magenta-accent hover:bg-white shadow-md flex items-center justify-center transition"
                            aria-label="Thêm vào yêu thích">
                        <i class="fa-regular fa-heart text-base"></i>
                    </button>
                </div>

                <!-- Gallery Thumbnails Carousel + Video Swatch Button -->
                <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-thin">
                    
                    <!-- SPECIAL THUMBNAIL: Short Video Swatch Button (Chỉ hiển thị khi có video thực tế) -->
                    @if (!string.IsNullOrEmpty(Model.SwatchVideoUrl))
                    {
                        <button type="button" 
                                @@click="activeMedia = 'video'" 
                                :class="activeMedia === 'video' ? 'border-magenta-accent ring-2 ring-magenta-accent/30 scale-105' : 'border-soft-border hover:border-slate-300'"
                                class="relative w-20 h-20 rounded-2xl overflow-hidden border-2 transition-all p-1 bg-gradient-to-br from-magenta-accent/15 via-pink-100 to-rose-gold/20 shrink-0 flex flex-col items-center justify-center group shadow-xs">
                            <div class="w-8 h-8 rounded-full bg-magenta-accent text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-play text-xs ml-0.5"></i>
                            </div>
                            <span class="text-[9px] font-bold text-magenta-accent mt-1 uppercase tracking-tight">Swatch Video</span>
                            <span class="absolute top-1.5 right-1.5 flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-magenta-accent opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-magenta-accent"></span>
                            </span>
                        </button>
                    }

                    <!-- Regular Image Thumbnails -->
                    @if (Model.GalleryImages != null)
                    {
                        @foreach (var img in Model.GalleryImages)
                        {
                            <button type="button" 
                                    @@click="activeImage = '@img'; activeMedia = 'image'" 
                                    :class="(activeMedia === 'image' && activeImage === '@img') ? 'border-magenta-accent ring-2 ring-magenta-accent/20 scale-105' : 'border-soft-border hover:border-slate-300'"
                                    class="gallery-thumb w-20 h-20 rounded-2xl overflow-hidden border-2 transition-all p-1 bg-white shrink-0 cursor-pointer">
                                <img src="@img" class="w-full h-full object-cover rounded-xl" alt="Thumbnail" />
                            </button>
                        }
                    }
                </div>

                <!-- Trust Highlights Below Gallery -->
                <div class="pt-3 grid grid-cols-3 gap-3 border-t border-slate-100 text-center text-xs text-slate-600">
                    <div class="p-3 rounded-2xl bg-pastel-rose/50">
                        <i class="fa-solid fa-certificate text-magenta-accent text-lg mb-1 block"></i>
                        <span class="font-bold text-charcoal block">100% Chính Ngạch</span>
                        <span class="text-[10px] text-slate-400">Tem BYT & QR Code</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-pastel-rose/50">
                        <i class="fa-solid fa-truck-fast text-magenta-accent text-lg mb-1 block"></i>
                        <span class="font-bold text-charcoal block">Giao Hỏa Tốc 2H</span>
                        <span class="text-[10px] text-slate-400">Nội thành HCM & HN</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-pastel-rose/50">
                        <i class="fa-solid fa-arrows-rotate text-magenta-accent text-lg mb-1 block"></i>
                        <span class="font-bold text-charcoal block">Đổi Trả 7 Ngày</span>
                        <span class="text-[10px] text-slate-400">Bảo hiểm kích ứng da</span>
                    </div>
                </div>

                
                <!-- MODAL 1: BACK-IN-STOCK ALERT (GAP-05) -->
                <div x-show="backInStockModalOpen" 
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0"
                     x-transition:enter-end="opacity-100"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/60 backdrop-blur-sm"
                     style="display: none;">
                    
                    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative border border-slate-100 transform transition-all"
                         @@click.away="backInStockModalOpen = false">
                        
                        <button type="button" 
                                @@click="backInStockModalOpen = false" 
                                class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">
                            <i class="fa-solid fa-xmark"></i>
                        </button>

                        <div class="text-center mb-5">
                            <div class="w-14 h-14 mx-auto rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-3 shadow-inner">
                                <i class="fa-solid fa-bell animate-bounce"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-charcoal">Báo Tôi Khi Có Hàng</h3>
                            <p class="text-xs text-slate-500 mt-1">
                                Nhận chuông thông báo Realtime & Email ngay khi sản phẩm này về đợt hàng mới tại Omni Beauty.
                            </p>
                        </div>

                        <!-- Product Mini Card -->
                        <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-2xl mb-5 border border-slate-200/60">
                            <img src="@mainImg" alt="@p.Name" class="w-14 h-14 object-cover rounded-xl bg-white border border-slate-200/60" />
                            <div class="min-w-0 flex-1">
                                <div class="text-xs font-serif font-bold text-charcoal line-clamp-1">@p.Name</div>
                                <div class="text-xs font-bold text-magenta-accent mt-0.5">@p.SellingPrice.ToString("N0") đ</div>
                                <div class="text-[10px] text-rose-500 font-semibold mt-0.5 flex items-center gap-1">
                                    <i class="fa-solid fa-circle text-[6px]"></i> Tạm thời hết hàng
                                </div>
                            </div>
                        </div>

                        <!-- Form -->
                        <form x-on:submit.prevent="submitBackInStock($refs.bisEmail.value, $refs.bisPhone.value, $refs.bisName.value)" class="space-y-3.5">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Họ và tên</label>
                                <input type="text" x-ref="bisName" 
                                       value="@(User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "") : "")" 
                                       placeholder="Ví dụ: Nguyễn Văn A" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Email nhận thông báo <span class="text-rose-500">*</span></label>
                                <input type="email" x-ref="bisEmail" required
                                       placeholder="example@gmail.com" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Số điện thoại (tùy chọn)</label>
                                <input type="tel" x-ref="bisPhone" 
                                       placeholder="0912 345 678" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <button type="submit" 
                                    :disabled="subLoading"
                                    class="w-full py-3.5 rounded-full bg-gradient-to-r from-amber-500 to-magenta-accent text-white font-bold text-xs uppercase tracking-wider hover:opacity-95 shadow-md transition flex items-center justify-center gap-2 mt-4 cursor-pointer disabled:opacity-50">
                                <template x-if="subLoading">
                                    <i class="fa-solid fa-spinner fa-spin text-sm"></i>
                                </template>
                                <template x-if="!subLoading">
                                    <i class="fa-solid fa-paper-plane text-xs"></i>
                                </template>
                                <span>Xác Nhận Đăng Ký Nhận Tin</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- MODAL 2: PRICE DROP ALERT (GAP-05) -->
                <div x-show="priceDropModalOpen" 
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0"
                     x-transition:enter-end="opacity-100"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/60 backdrop-blur-sm"
                     style="display: none;">
                    
                    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl relative border border-slate-100 transform transition-all"
                         @@click.away="priceDropModalOpen = false">
                        
                        <button type="button" 
                                @@click="priceDropModalOpen = false" 
                                class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">
                            <i class="fa-solid fa-xmark"></i>
                        </button>

                        <div class="text-center mb-5">
                            <div class="w-14 h-14 mx-auto rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mb-3 shadow-inner">
                                <i class="fa-solid fa-arrow-trend-down"></i>
                            </div>
                            <h3 class="text-xl font-serif font-bold text-charcoal">Theo Dõi Giảm Giá</h3>
                            <p class="text-xs text-slate-500 mt-1">
                                Đặt mức giá kỳ vọng. Hệ thống sẽ thông báo ngay khi sản phẩm giảm giá đến mục tiêu của bạn!
                            </p>
                        </div>

                        <!-- Current Price Box -->
                        <div class="p-3.5 bg-slate-50 rounded-2xl mb-4 border border-slate-200/60 flex items-center justify-between">
                            <span class="text-xs text-slate-500 font-medium">Giá bán hiện tại:</span>
                            <span class="text-base font-bold text-charcoal" x-text="new Intl.NumberFormat('vi-VN').format(selectedPrice || @p.SellingPrice) + ' đ'"></span>
                        </div>

                        <!-- Quick Discount Badges -->
                        <div class="mb-4">
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Chọn nhanh mức giảm:</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button" @@click="setTargetDiscount(5)" 
                                        class="py-2 px-3 rounded-xl border border-emerald-200 bg-emerald-50/60 hover:bg-emerald-100 text-emerald-800 text-xs font-bold text-center transition">
                                    -5%
                                </button>
                                <button type="button" @@click="setTargetDiscount(10)" 
                                        class="py-2 px-3 rounded-xl border border-emerald-300 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 text-xs font-bold text-center transition">
                                    -10%
                                </button>
                                <button type="button" @@click="setTargetDiscount(15)" 
                                        class="py-2 px-3 rounded-xl border border-emerald-400 bg-emerald-200/80 hover:bg-emerald-300 text-emerald-950 text-xs font-bold text-center transition">
                                    -15%
                                </button>
                            </div>
                        </div>

                        <!-- Form -->
                        <form x-on:submit.prevent="submitPriceDrop($refs.pdEmail.value, $refs.pdPhone.value, $refs.pdName.value)" class="space-y-3.5">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Mức giá bạn mong đợi (VNĐ) <span class="text-rose-500">*</span></label>
                                <div class="relative">
                                    <input type="number" step="1000" x-model="targetPriceInput" required min="1000"
                                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-emerald-700 focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none pr-10" />
                                    <span class="absolute right-3.5 top-2.5 text-xs text-slate-400 font-bold">đ</span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Họ và tên</label>
                                <input type="text" x-ref="pdName" 
                                       value="@(User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "") : "")" 
                                       placeholder="Ví dụ: Nguyễn Văn A" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Email nhận thông báo <span class="text-rose-500">*</span></label>
                                <input type="email" x-ref="pdEmail" required
                                       placeholder="example@gmail.com" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">Số điện thoại (tùy chọn)</label>
                                <input type="tel" x-ref="pdPhone" 
                                       placeholder="0912 345 678" 
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-magenta-accent/20 focus:border-magenta-accent outline-none" />
                            </div>

                            <button type="submit" 
                                    :disabled="subLoading"
                                    class="w-full py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider shadow-md transition flex items-center justify-center gap-2 mt-4 cursor-pointer disabled:opacity-50">
                                <template x-if="subLoading">
                                    <i class="fa-solid fa-spinner fa-spin text-sm"></i>
                                </template>
                                <template x-if="!subLoading">
                                    <i class="fa-solid fa-bell text-xs"></i>
                                </template>
                                <span>Kích Hoạt Theo Dõi Giá</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Image & Swatch Lightbox Modal (Phóng To Chi Tiết Thực Tế) -->
                <div x-show="lightboxOpen" 
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0"
                     x-transition:enter-end="opacity-100"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     @@keydown.escape.window="closeLightbox()"
                     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/90 backdrop-blur-md"
                     style="display: none;">
                    
                    <!-- Backdrop click to close -->
                    <div class="absolute inset-0" @@click="closeLightbox()"></div>

                    <!-- Modal Content Container -->
                    <div class="relative max-w-4xl max-h-[90vh] bg-white rounded-3xl overflow-hidden shadow-2xl flex flex-col z-10 border border-white/20"
                         @@click.stop>
                        <!-- Header bar -->
                        <div class="p-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-magenta-accent"></span>
                                <h4 class="font-serif font-bold text-sm text-slate-100 line-clamp-1">@p.Name - Soi Chi Tiết Chất Kem & Texture Thực Tế</h4>
                            </div>
                            <button type="button" 
                                    @@click="closeLightbox()"
                                    class="w-9 h-9 rounded-full bg-white/10 hover:bg-magenta-accent text-white flex items-center justify-center transition cursor-pointer"
                                    aria-label="Đóng phóng to">
                                <i class="fa-solid fa-xmark text-base"></i>
                            </button>
                        </div>

                        <!-- Image Preview Area -->
                        <div class="p-4 bg-slate-950 flex items-center justify-center overflow-auto max-h-[70vh]">
                            <img :src="activeImage" 
                                 alt="@p.Name Zoom" 
                                 class="max-w-full max-h-[65vh] object-contain rounded-xl shadow-lg transition-transform duration-300 select-none hover:scale-105" />
                        </div>

                        <!-- Footer Thumbnails Strip -->
                        <div class="p-3 bg-slate-900 border-t border-slate-800 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2 overflow-x-auto py-1 scrollbar-thin">
                                @if (Model.GalleryImages != null)
                                {
                                    @foreach (var img in Model.GalleryImages)
                                    {
                                        <button type="button"
                                                @@click="activeImage = '@img'"
                                                :class="activeImage === '@img' ? 'ring-2 ring-magenta-accent' : 'opacity-60 hover:opacity-100'"
                                                class="w-12 h-12 rounded-lg overflow-hidden border border-slate-700 shrink-0 transition cursor-pointer">
                                            <img src="@img" class="w-full h-full object-cover" alt="Thumb" />
                                        </button>
                                    }
                                }
                            </div>
                            <span class="text-xs text-slate-400 shrink-0 hidden sm:inline">Phím ESC hoặc click bên ngoài để đóng</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Product Info & Buy Box -->
            <div class="lg:col-span-6 space-y-5">
                
                <!-- Brand & Sku Bar -->
                <div class="flex items-center justify-between text-xs text-slate-500">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-rose-gold uppercase tracking-wider">
                            @(p.ManufacturerName ?? "OMNICHANNEL BEAUTY")
                        </span>
                        <span>•</span>
                        <span>Xuất xứ: <strong class="text-charcoal">@(p.CountryOfOrigin ?? "Chính Ngạch")</strong></span>
                    </div>
                    <span class="font-mono text-slate-400" id="variantSku" x-text="'SKU: ' + selectedSku">SKU: @p.Sku</span>
                </div>

                <!-- Product Name Title -->
                <h1 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal leading-snug">
                    @p.Name
                </h1>

                <!-- Rating & Reviews Bar -->
                <div class="flex items-center gap-3 text-xs">
                    <div class="flex text-amber-400 gap-0.5">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <span class="font-bold text-charcoal">@Model.AverageRating.ToString("0.1") / 5</span>
                    <span class="text-slate-300">|</span>
                    <a href="#deepDetailsTabs" class="text-magenta-accent hover:underline font-semibold">
                        @Model.TotalReviews đánh giá kiểm định từ khách hàng
                    </a>
                </div>

                <!-- Dynamic Realtime Price Box -->
                <div class="p-5 rounded-2xl bg-gradient-to-r from-pastel-rose/60 via-pink-50/50 to-white border border-soft-border flex items-baseline gap-4 flex-wrap">
                    <span id="productDisplayPrice" class="font-mono-numeric font-bold text-3xl sm:text-4xl text-charcoal" x-text="new Intl.NumberFormat('vi-VN').format(selectedPrice) + ' ₫'">
                        @p.SellingPrice.ToString("N0") ₫
                    </span>
                    @if (hasDiscount)
                    {
                        <span class="font-mono-numeric text-base text-slate-400 line-through">
                            @originalPrice.ToString("N0") ₫
                        </span>
                    }
                    <span class="px-2.5 py-1 rounded-full text-white font-bold text-xs shadow-xs"
                          :class="selectedBatchType === 'clearance' ? 'bg-gradient-to-r from-amber-500 to-rose-600' : 'bg-magenta-accent'"
                          x-text="selectedBatchType === 'clearance' ? 'Tiết kiệm @Model.ClearanceDiscountPercent% (FEFO Deal)' : 'Giá niêm yết chuẩn'">
                        Giá niêm yết chuẩn
                    </span>
                </div>

                <!-- KHỐI CHỨNG NHẬN AN TOÀN LÀN DA (CLEAN BEAUTY VERIFICATION) -->
                <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-50/60 via-pink-50/40 to-slate-50 border border-emerald-200/60 space-y-2.5">
                    <div class="flex items-center justify-between text-xs font-bold text-charcoal">
                        <span class="flex items-center gap-1.5 text-emerald-800 uppercase tracking-wider text-[11px]">
                            <i class="fa-solid fa-shield-heart text-emerald-600"></i>
                            Chứng Nhận An Toàn Làn Da (Clean Beauty Standards)
                        </span>
                        <span class="text-[10px] text-slate-500 font-medium">Chuẩn Y Khoa 2026</span>
                    </div>

                    <div class="flex items-center gap-2 flex-wrap text-xs">
                        @if (p.IsAlcoholFree)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-emerald-300 text-emerald-800 font-semibold shadow-2xs hover:shadow-xs transition group cursor-help"
                                  title="Không cồn khô (Alcohol-Free), chống khô rát màng ẩm">
                                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                                <span>Alcohol-Free</span>
                                <span class="text-[9px] px-1 py-0.2 rounded bg-emerald-100 text-emerald-700 font-bold">0% Cồn Khô</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-medium text-[11px]">
                                <i class="fa-solid fa-circle-info text-slate-400"></i>
                                <span>Dẫn xuất cồn bay hơi nhẹ</span>
                            </span>
                        }

                        @if (p.IsFragranceFree)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-pink-300 text-pink-800 font-semibold shadow-2xs hover:shadow-xs transition group cursor-help"
                                  title="Không hương liệu nhân tạo (Fragrance-Free), an toàn tuyệt đối cho da nhạy cảm">
                                <i class="fa-solid fa-feather text-pink-500"></i>
                                <span>Fragrance-Free</span>
                                <span class="text-[9px] px-1 py-0.2 rounded bg-pink-100 text-pink-700 font-bold">0% Hương Liệu</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 border border-slate-200 text-slate-500 font-medium text-[11px]">
                                <i class="fa-solid fa-wand-magic text-slate-400"></i>
                                <span>Hương thơm tự nhiên</span>
                            </span>
                        }

                        @if (p.IsPregnancySafe)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-purple-300 text-purple-800 font-semibold shadow-2xs hover:shadow-xs transition group cursor-help"
                                  title="Không Retinol, BHA liều cao hay Hydroquinone. Tuyệt đối an toàn cho phụ nữ mang thai và cho con bú">
                                <i class="fa-solid fa-baby text-purple-500"></i>
                                <span>Pregnancy-Safe</span>
                                <span class="text-[9px] px-1 py-0.2 rounded bg-purple-100 text-purple-700 font-bold">An Toàn Mẹ Bầu</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 font-medium text-[11px]"
                                  title="Chứa hoạt chất đặc trị nồng độ cao (Retinol/BHA). Khuyến cáo tham khảo ý kiến bác sĩ khi mang thai">
                                <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
                                <span>Cân nhắc khi mang thai</span>
                            </span>
                        }

                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-teal-200 text-teal-800 font-semibold shadow-2xs text-[11px]">
                            <i class="fa-solid fa-check-double text-teal-600"></i>
                            <span>Non-Comedogenic (Không bít tắc)</span>
                        </span>
                    </div>
                </div>

                <!-- 1. BỘ CHỌN BIẾN THỂ (Swatch Màu Son Hoặc Dung Tích) -->
                @if (p.Variants != null && p.Variants.Any())
                {
                    <div class="p-4 rounded-2xl bg-white border border-soft-border space-y-3.5 shadow-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-charcoal uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid @(isLipstickOrMakeup ? "fa-palette text-magenta-accent" : "fa-flask text-rose-gold")"></i>
                                @(isLipstickOrMakeup ? "Bảng Màu Son (Color Swatches):" : "Dung Tích & Kích Cỡ (Volume Sizes):")
                            </span>
                            <div class="flex items-center gap-2 flex-wrap"><span id="selectedVariantName" class="text-xs font-bold text-magenta-accent" x-text="selectedVariantName"></span>@if (isLipstickOrMakeup) { <button type="button" id="btnOpenVirtualTryOn" onclick="window.OmniVirtualTryOn && window.OmniVirtualTryOn.openModal()" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 text-white text-[11px] font-bold shadow-xs hover:shadow transition cursor-pointer"><i class="fa-solid fa-wand-magic-sparkles"></i><span>Thử màu ngay (Virtual Try-On)</span></button> }</div>
                        </div>

                        @if (isLipstickOrMakeup)
                        {
                            <!-- Swatch Màu Son: Các ô tròn mã màu thực tế kèm tên tone màu -->
                            <div class="flex items-center gap-3.5 flex-wrap">
                                @foreach (var v in p.Variants)
                                {
                                    var hex = !string.IsNullOrEmpty(v.SwatchColorHex) ? v.SwatchColorHex : (!string.IsNullOrEmpty(v.ColorHex) ? v.ColorHex : "#B76E79");
                                    var vImg = !string.IsNullOrEmpty(v.SwatchImageUrl) ? v.SwatchImageUrl : p.ThumbnailUrl;
                                    <button type="button"
                                            data-variant-id="@v.Id"
                                            @@click="selectVariant(@v.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))', @v.SellingPrice, '@v.Sku', '@vImg', @v.StockQuantity)"
                                            :class="selectedVariantId === @v.Id ? 'ring-2 ring-magenta-accent ring-offset-2 scale-110 shadow-md' : 'border border-slate-200 hover:scale-105'"
                                            class="group relative flex items-center justify-center w-11 h-11 rounded-full transition-all duration-300 focus:outline-none cursor-pointer"
                                            style="background-color: @hex;"
                                            title="@v.VariantName">
                                        <span x-show="selectedVariantId === @v.Id" class="text-white drop-shadow-md text-xs">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                        <!-- Tooltip Hover -->
                                        <span class="absolute bottom-full mb-2 hidden group-hover:block px-2.5 py-1 text-[11px] font-semibold text-white bg-charcoal rounded-lg shadow-lg whitespace-nowrap z-30 pointer-events-none">
                                            @v.ColorName (@v.SellingPrice.ToString("N0") ₫@(v.StockQuantity > 0 ? $" • Còn {v.StockQuantity}" : ""))
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Dung tích: Các nút pill thể tích (30ml, 50ml, 100ml) -->
                            <div class="flex items-center gap-2.5 flex-wrap">
                                @foreach (var v in p.Variants)
                                {
                                    var vImg = !string.IsNullOrEmpty(v.SwatchImageUrl) ? v.SwatchImageUrl : p.ThumbnailUrl;
                                    <button type="button"
                                            data-variant-id="@v.Id"
                                            @@click="selectVariant(@v.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(v.VariantName))', @v.SellingPrice, '@v.Sku', '@vImg', @v.StockQuantity)"
                                            :class="selectedVariantId === @v.Id ? 'bg-charcoal text-white border-charcoal shadow-md ring-2 ring-charcoal/20' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-magenta-accent hover:text-magenta-accent'"
                                            class="px-4 py-2.5 rounded-xl text-xs font-bold border transition-all duration-200 flex items-center gap-2 cursor-pointer">
                                        <span>@(!string.IsNullOrEmpty(v.Volume) ? v.Volume : v.VariantName)</span>
                                        @if (v.PriceAdjustment > 0)
                                        {
                                            <span class="text-[10px] px-1.5 py-0.5 rounded bg-magenta-accent/20 text-magenta-accent font-semibold">
                                                +@v.PriceAdjustment.ToString("N0") ₫
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-slate-400 font-normal">
                                                (@v.SellingPrice.ToString("N0") ₫)
                                            </span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- 2. BỘ CHỌN LÔ HÀNG FEFO THÔNG MINH (DUAL INTERACTIVE BATCH SELECTOR) -->
                <div class="space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-charcoal uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-magenta-accent"></i>
                            Chọn Lô Hàng FEFO Thông Minh:
                        </span>
                        <span class="text-[11px] text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                            <i class="fa-solid fa-circle-check text-emerald-500 mr-0.5"></i> Chuẩn Dược Điển FEFO
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        
                        <!-- TÙY CHỌN 1: Lô Mới Nhất - Giá chuẩn 100% -->
                        <div id="batchFreshOption"
                             @@click="selectBatch('fresh')" 
                             :class="selectedBatchType === 'fresh' ? 'border-emerald-500 ring-2 ring-emerald-500/20 bg-emerald-50/40 shadow-sm' : 'border-slate-200 bg-white hover:border-slate-300'"
                             class="relative p-3.5 rounded-2xl border-2 cursor-pointer transition-all duration-200 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-1 mb-1.5">
                                    <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold text-[10px] tracking-wide uppercase flex items-center gap-1">
                                        <i class="fa-solid fa-shield-check text-emerald-600"></i> Lô Mới Nhất
                                    </span>
                                    <span class="text-[10px] font-mono font-semibold text-slate-500">
                                        @(Model.FreshBatch?.BatchNumber ?? $"LOT-2028-{p.Id:D3}")
                                    </span>
                                </div>
                                <h4 class="font-bold text-xs text-charcoal flex items-center gap-1">
                                    <span>HSD: @(Model.FreshBatch?.ExpDate.ToString("MM/yyyy") ?? DateTime.UtcNow.AddMonths(22).ToString("MM/yyyy"))</span>
                                    <span class="text-[10px] font-normal text-slate-500">(Còn @(Model.FreshBatch?.CurrentQuantity ?? 120) sp)</span>
                                </h4>
                                <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">Hàng mới về, bảo quản kho lạnh GSP 18-22°C.</p>
                            </div>
                            <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] text-slate-400 block">Giá chuẩn 100%:</span>
                                    <span class="font-mono-numeric font-bold text-sm text-charcoal" x-text="new Intl.NumberFormat('vi-VN').format(freshPrice) + ' ₫'">
                                        @p.SellingPrice.ToString("N0") ₫
                                    </span>
                                </div>
                                <div class="w-5 h-5 rounded-full flex items-center justify-center transition-colors"
                                     :class="selectedBatchType === 'fresh' ? 'bg-emerald-600 text-white' : 'border border-slate-300 text-transparent'">
                                    <i class="fa-solid fa-check text-[10px]"></i>
                                </div>
                            </div>
                        </div>

                        <!-- TÙY CHỌN 2: Lô Cận Date (Hiển thị trung thực theo tồn kho thực tế trong CSDL) -->
                        @if (Model.ClearanceBatch != null && Model.ClearanceBatch.CurrentQuantity > 0)
                        {
                            <div id="batchClearanceOption"
                                 @@click="selectBatch('clearance')" 
                                 :class="selectedBatchType === 'clearance' ? 'border-amber-500 ring-2 ring-amber-500/20 bg-amber-50/50 shadow-sm' : 'border-slate-200 bg-white hover:border-slate-300'"
                                 class="relative p-3.5 rounded-2xl border-2 cursor-pointer transition-all duration-200 flex flex-col justify-between">
                                <div class="absolute -top-2.5 right-3 px-2 py-0.5 rounded-full bg-gradient-to-r from-amber-500 to-rose-500 text-white text-[9px] font-extrabold uppercase shadow-sm flex items-center gap-1">
                                    <i class="fa-solid fa-fire text-[9px]"></i> Tiết Kiệm @Model.ClearanceDiscountPercent%
                                </div>
                                <div>
                                    <div class="flex items-center justify-between gap-1 mb-1.5">
                                        <span class="px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 font-bold text-[10px] tracking-wide uppercase flex items-center gap-1">
                                            <i class="fa-solid fa-tag text-amber-600"></i> Lô Cận Date Xả Kho
                                        </span>
                                        <span class="text-[10px] font-mono font-semibold text-slate-500">
                                            @Model.ClearanceBatch.BatchNumber
                                        </span>
                                    </div>
                                    <h4 class="font-bold text-xs text-charcoal flex items-center gap-1">
                                        <span>HSD: @Model.ClearanceBatch.ExpDate.ToString("MM/yyyy")</span>
                                        <span class="text-[10px] font-bold text-rose-600">(Chỉ còn @Model.ClearanceBatch.CurrentQuantity sp)</span>
                                    </h4>
                                    <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">Nguyên seal tem màng co, cam kết chuẩn hãng.</p>
                                </div>
                                <div class="mt-3 pt-2 border-t border-amber-100 flex items-center justify-between">
                                    <div>
                                        <span class="text-[10px] text-slate-400 block line-through" x-text="new Intl.NumberFormat('vi-VN').format(freshPrice) + ' ₫'"></span>
                                        <span class="font-mono-numeric font-bold text-sm text-magenta-accent" x-text="new Intl.NumberFormat('vi-VN').format(clearancePrice) + ' ₫'">
                                            @Model.ClearancePrice.ToString("N0") ₫
                                        </span>
                                    </div>
                                    <div class="w-5 h-5 rounded-full flex items-center justify-center transition-colors"
                                         :class="selectedBatchType === 'clearance' ? 'bg-amber-600 text-white' : 'border border-slate-300 text-transparent'">
                                        <i class="fa-solid fa-check text-[10px]"></i>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div id="batchClearanceSoldOut"
                                 class="relative p-3.5 rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/70 opacity-75 select-none flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center justify-between gap-1 mb-1.5">
                                        <span class="px-2 py-0.5 rounded-md bg-slate-200 text-slate-600 font-bold text-[10px] tracking-wide uppercase flex items-center gap-1">
                                            <i class="fa-solid fa-box-open text-slate-500"></i> Lô Xả Kho Cận Date
                                        </span>
                                        <span class="text-[10px] font-semibold text-slate-400">Hết hàng xả kho</span>
                                    </div>
                                    <h4 class="font-bold text-xs text-slate-600">
                                        Lô xả kho đã bán hết
                                    </h4>
                                    <p class="text-[11px] text-slate-500 mt-1">100% tồn kho hiện tại là Lô Mới Nhất Date Xa.</p>
                                </div>
                                <div class="mt-3 pt-2 border-t border-slate-200/70 flex items-center justify-between text-[11px] text-emerald-700 font-semibold">
                                    <span><i class="fa-solid fa-circle-check mr-1"></i>Đang áp dụng Lô Mới Nhất</span>
                                </div>
                            </div>
                        }

                    </div>
                </div>

                <!-- 3. TÌNH TRẠNG CÒN HÀNG THEO TỪNG SHOWROOM GẦN NHẤT (O2O) -->
                @await Html.PartialAsync("_ShowroomStockAvailability", Model.ShowroomAvailability)

                <!-- Attributes: Unit, Skin Type, Ingredients -->
                <div class="space-y-2.5 pt-1 text-xs">
                    <div class="flex items-center gap-3">
                        <span class="text-slate-400 w-28 shrink-0 font-medium">Quy Cách / Đóng Gói:</span>
                        <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 font-bold border border-slate-200">
                            @p.Unit
                        </span>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="text-slate-400 w-28 shrink-0 font-medium pt-1">Loại Da Phù Hợp:</span>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var skin in Model.SuitableSkinTypes)
                            {
                                <span class="px-2.5 py-1 rounded-full bg-pastel-rose text-magenta-accent font-semibold border border-soft-border">
                                    @skin
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Quantity Stepper & Call to Actions -->
                <div class="pt-2 space-y-4">
                    <div class="flex items-center gap-4 flex-wrap">
                        <span class="text-xs font-bold text-slate-700">Số Lượng:</span>
                        <div class="flex items-center rounded-full border border-slate-200 bg-slate-50 p-1 shadow-inner">
                            <button type="button" 
                                    id="btnQtyMinus"
                                    @@click="if(quantity > 1) quantity--" 
                                    class="w-8 h-8 rounded-full bg-white hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-600 shadow-xs transition active:scale-90 cursor-pointer"
                                    aria-label="Giảm số lượng">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <input type="number" 
                                   min="1" 
                                   :max="availableStock" 
                                   x-model.number="quantity"
                                   @@input="if(quantity < 1 || isNaN(quantity)) quantity = 1; if(quantity > availableStock) quantity = availableStock;"
                                   id="quantityInput"
                                   class="w-14 text-center font-mono-numeric font-bold text-sm text-charcoal bg-transparent border-0 focus:outline-none focus:ring-0 p-0 selection:bg-magenta-accent selection:text-white" />
                            <button type="button" 
                                    id="btnQtyPlus"
                                    @@click="if(quantity < availableStock) quantity++" 
                                    class="w-8 h-8 rounded-full bg-white hover:bg-magenta-accent hover:text-white flex items-center justify-center text-slate-600 shadow-xs transition active:scale-90 cursor-pointer"
                                    aria-label="Tăng số lượng">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                        <span class="text-xs text-slate-500 font-medium flex items-center gap-1.5">
                            <i class="fa-solid fa-boxes-stacked text-slate-400"></i>
                            <span id="currentStockDisplay" x-text="'Còn ' + availableStock + ' sản phẩm khả dụng'"></span>
                        </span>
                    </div>

                    <!-- Action Buttons (GAP-05: Back-In-Stock & Price Drop Integration) -->
                    <template x-if="availableStock > 0">
                        <div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                                <!-- Add to Cart -->
                                <button type="button" 
                                        id="btnAddToCart"
                                        @@click="addToCartHandler()"
                                        class="w-full py-4 rounded-full bg-charcoal text-white font-bold text-xs uppercase tracking-wider hover:bg-magenta-accent shadow-md transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                                    <i class="fa-solid fa-cart-shopping text-sm text-rose-gold"></i>
                                    <span>Thêm Giỏ Hàng</span>
                                </button>

                                <!-- Buy Now -->
                                <button type="button" 
                                        id="btnBuyNow"
                                        @@click="buyNow()"
                                        class="w-full py-4 rounded-full bg-magenta-accent text-white font-bold text-xs uppercase tracking-wider hover:bg-[#b0276a] shadow-lg shadow-magenta-accent/25 transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                                    <i class="fa-solid fa-bolt text-sm"></i>
                                    <span>Mua Ngay Lô Đã Chọn</span>
                                </button>
                            </div>

                            <!-- Nút Theo Dõi Giảm Giá (GAP-05) -->
                            <div class="pt-2">
                                <button type="button" 
                                        id="btnTrackPriceDrop"
                                        @@click="openPriceDropModal()"
                                        class="w-full py-2.5 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-xs uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                                    <i class="fa-solid fa-arrow-trend-down text-emerald-600"></i>
                                    <span>Theo Dõi Giảm Giá (Báo Khi Giá Rẻ Hơn)</span>
                                </button>
                            </div>
                        </div>
                    </template>

                    <!-- Hết Hàng: Nút Báo Tôi Khi Có Hàng (GAP-05) -->
                    <template x-if="availableStock <= 0">
                        <div class="space-y-3 pt-1">
                            <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200 text-amber-900 text-xs flex items-center gap-2.5">
                                <i class="fa-solid fa-circle-exclamation text-amber-600 text-sm shrink-0"></i>
                                <span>Mỹ phẩm này tạm thời hết hàng tại mọi chi nhánh. Đăng ký để nhận tin ngay khi đợt hàng mới về kho!</span>
                            </div>

                            <button type="button" 
                                    id="btnNotifyInStock"
                                    @@click="openBackInStockModal()"
                                    class="w-full py-4 rounded-full bg-gradient-to-r from-amber-500 via-rose-500 to-magenta-accent text-white font-bold text-xs uppercase tracking-wider hover:opacity-95 shadow-lg shadow-pink-500/25 transition-all duration-300 flex items-center justify-center gap-2.5 cursor-pointer active:scale-95">
                                <i class="fa-solid fa-bell text-base text-amber-200 animate-bounce"></i>
                                <span>Báo Tôi Khi Có Hàng Trở Lại</span>
                            </button>
                        </div>
                    </template>

                    <!-- Nút So Sánh Mỹ Phẩm Chuyên Sâu (GAP-03: Phiên C3) -->
                    <div class="pt-2">
                        <button type="button" 
                                onclick="window.omniCompare && window.omniCompare.toggle(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', @p.CategoryId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Category?.Name ?? ""))')"
                                class="w-full py-3 rounded-full bg-pink-50 hover:bg-pink-100 text-magenta-accent border border-pink-200 font-bold text-xs uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                            <i class="fa-solid fa-scale-balanced text-sm"></i>
                            <span>So Sánh Sản Phẩm Này (Giá/ml, EWG, FEFO)</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- 2.5 SECTION: FREQUENTLY BOUGHT TOGETHER (THƯỜNG ĐƯỢC MUA CÙNG) - PHIÊN C2 -->
        @if (Model.FrequentlyBoughtTogether != null && Model.FrequentlyBoughtTogether.BundleProducts.Any())
        {
            var fbt = Model.FrequentlyBoughtTogether;
            <div id="frequentlyBoughtTogetherSection" 
                 class="mt-14 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-white via-pink-50/25 to-pastel-rose/30 border border-rose-200/80 shadow-md"
                 x-data="fbtBundleComponent(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(fbt, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })))">
                
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-4 border-b border-rose-100">
                    <div>
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-magenta-accent text-white text-[10px] font-bold uppercase tracking-wider shadow-2xs">
                            <i class="fa-solid fa-gift"></i>
                            <span>Combo Tiết Kiệm & Đạt Hiệu Quả Tối Đa</span>
                        </div>
                        <h3 class="font-serif text-xl sm:text-2xl font-bold text-charcoal mt-2 flex items-center gap-2">
                            <span>Thường Được Mua Cùng Nhau</span>
                            @if (fbt.IsAlgorithmic)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-sans font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                                    <i class="fa-solid fa-chart-line text-[9px] mr-1"></i>Hot Combo
                                </span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-sans font-bold bg-blue-100 text-blue-800 border border-blue-200">
                                    <i class="fa-solid fa-wand-magic-sparkles text-[9px] mr-1"></i>Chu trình chuẩn
                                </span>
                            }
                        </h3>
                    </div>
                    <div class="text-xs text-slate-500 flex items-center gap-1.5 sm:text-right">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i>
                        <span>@fbt.Explanation</span>
                    </div>
                </div>

                <!-- Bundle Grid & Math Equation -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                    
                    <!-- Left: Bundle Items Linked by Plus Signs -->
                    <div class="lg:col-span-8 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 overflow-x-auto pb-2">
                        
                        <!-- Item 1: Current Product (Locked checked) -->
                        <div class="fbt-card flex-1 min-w-[200px] w-full bg-white p-4 rounded-2xl border-2 border-magenta-accent shadow-xs relative">
                            <span class="absolute -top-2.5 left-4 px-2 py-0.5 rounded-full bg-charcoal text-white text-[9px] font-bold uppercase tracking-wider shadow-2xs">
                                Đang xem
                            </span>
                            <div class="flex items-center gap-3">
                                <img src="@fbt.CurrentProduct.ImageUrl" alt="@fbt.CurrentProduct.Name" class="w-16 h-16 rounded-xl object-cover border border-slate-200 shrink-0" />
                                <div class="min-w-0 flex-1">
                                    <div class="text-[9px] font-bold uppercase tracking-wider text-rose-gold truncate">@fbt.CurrentProduct.BrandName</div>
                                    <h4 class="text-xs font-bold text-charcoal line-clamp-2 leading-tight">@fbt.CurrentProduct.Name</h4>
                                    <div class="flex items-baseline gap-1.5 mt-1">
                                        <span class="text-xs font-bold text-magenta-accent font-mono-numeric">
                                            @((fbt.CurrentProduct.SalePrice ?? fbt.CurrentProduct.Price).ToString("N0")) ₫
                                        </span>
                                        @if (fbt.CurrentProduct.SalePrice.HasValue && fbt.CurrentProduct.SalePrice.Value < fbt.CurrentProduct.Price)
                                        {
                                            <span class="text-[10px] text-slate-400 line-through font-mono-numeric">
                                                @fbt.CurrentProduct.Price.ToString("N0") ₫
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center gap-1.5 text-[10px] text-slate-400">
                                <i class="fa-solid fa-lock text-[9px] text-slate-400"></i>
                                <span>Bắt buộc trong combo</span>
                            </div>
                        </div>

                        <!-- Plus Sign -->
                        <div class="h-8 w-8 rounded-full bg-pastel-rose text-magenta-accent font-bold flex items-center justify-center shrink-0 shadow-2xs">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </div>

                        <!-- Loop suggested items -->
                        <template x-for="(item, idx) in bundle.bundleProducts" :key="item.id">
                            <div class="contents">
                                <template x-if="idx > 0">
                                    <div class="h-8 w-8 rounded-full bg-pastel-rose text-magenta-accent font-bold flex items-center justify-center shrink-0 shadow-2xs">
                                        <i class="fa-solid fa-plus text-xs"></i>
                                    </div>
                                </template>

                                <div class="fbt-card flex-1 min-w-[200px] w-full bg-white p-4 rounded-2xl border transition-all shadow-xs relative cursor-pointer"
                                     :class="item.isSelected ? 'border-pink-300 ring-1 ring-magenta-accent/20' : 'border-slate-200 opacity-60'"
                                     @@click="toggleItem(item)">
                                    
                                    <div class="flex items-center gap-3">
                                        <img :src="item.imageUrl" :alt="item.name" class="w-16 h-16 rounded-xl object-cover border border-slate-200 shrink-0" />
                                        <div class="min-w-0 flex-1">
                                            <div class="text-[9px] font-bold uppercase tracking-wider text-rose-gold truncate" x-text="item.brandName"></div>
                                            <a :href="'/san-pham/' + item.slug" @@click.stop class="block">
                                                <h4 class="text-xs font-bold text-charcoal line-clamp-2 leading-tight hover:text-magenta-accent transition" x-text="item.name"></h4>
                                            </a>
                                            <div class="flex items-baseline gap-1.5 mt-1">
                                                <span class="text-xs font-bold text-magenta-accent font-mono-numeric" x-text="formatPrice(item.salePrice || item.price)"></span>
                                                <template x-if="item.salePrice && item.salePrice < item.price">
                                                    <span class="text-[10px] text-slate-400 line-through font-mono-numeric" x-text="formatPrice(item.price)"></span>
                                                </template>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between">
                                        <label class="inline-flex items-center gap-1.5 text-xs text-charcoal font-semibold cursor-pointer" @@click.stop>
                                            <input type="checkbox" 
                                                   class="rounded text-magenta-accent focus:ring-magenta-accent/30 h-4 w-4"
                                                   x-model="item.isSelected"
                                                   @@change="updateCalculations()" />
                                            <span class="text-[11px]" x-text="item.isSelected ? 'Đã chọn' : 'Bỏ chọn'"></span>
                                        </label>
                                        <span class="text-[9.5px] font-bold text-slate-500 truncate max-w-[120px]" x-text="item.recommendationReason"></span>
                                    </div>
                                </div>
                            </div>
                        </template>

                    </div>

                    <!-- Right: Equals Sign & Summary Buy Box -->
                    <div class="lg:col-span-4 bg-white p-5 sm:p-6 rounded-2xl border border-rose-200 shadow-sm flex flex-col justify-between">
                        <div>
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Giá combo trọn bộ:</span>
                            <div class="flex items-baseline gap-2 mt-1">
                                <span class="font-serif text-2xl font-bold text-magenta-accent font-mono-numeric" x-text="formatPrice(totalSelectedPrice)"></span>
                                <template x-if="totalOriginalPrice > totalSelectedPrice">
                                    <span class="text-xs text-slate-400 line-through font-mono-numeric" x-text="formatPrice(totalOriginalPrice)"></span>
                                </template>
                            </div>

                            <template x-if="totalOriginalPrice > totalSelectedPrice">
                                <div class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-bold">
                                    <i class="fa-solid fa-tag text-[10px]"></i>
                                    <span>Tiết kiệm <strong x-text="formatPrice(totalOriginalPrice - totalSelectedPrice)"></strong> khi mua kèm</span>
                                </div>
                            </template>

                            <div class="text-[11px] text-slate-500 mt-3 flex items-center gap-1.5">
                                <i class="fa-solid fa-truck-fast text-emerald-600"></i>
                                <span>Miễn phí vận chuyển toàn quốc cho combo này</span>
                            </div>
                        </div>

                        <div class="mt-5">
                            <button type="button" 
                                    @@click="addAllSelectedToCart()"
                                    :disabled="isSubmitting"
                                    class="w-full py-3.5 px-6 rounded-full bg-magenta-accent text-white font-bold text-xs uppercase tracking-wider hover:bg-[#b0276a] shadow-lg shadow-magenta-accent/25 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95 disabled:opacity-50">
                                <i class="fa-solid" :class="isSubmitting ? 'fa-spinner fa-spin' : 'fa-cart-plus'"></i>
                                <span x-text="isSubmitting ? 'Đang thêm combo...' : 'Thêm Cả ' + selectedCount + ' Sản Phẩm Vào Giỏ'"></span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        }

        <!-- 3. ACCORDION TAB THÔNG TIN CHUYÊN SÂU (5 TABS CHUẨN DƯỢC MỸ PHẨM) -->
        <div class="mt-16 pt-10 border-t border-soft-border" 
             x-data="{ activeTab: 'features', selectedAiTest: 'bha' }" 
             @@switch-tab.window="activeTab = $event.detail"
             id="deepDetailsTabs">
            
            <!-- Tab Headers Bar (5 Tabs Chuyên Sâu + Tab Đánh Giá) -->
            <div class="flex items-center justify-center gap-1 sm:gap-4 border-b border-soft-border mb-8 overflow-x-auto pb-2 scrollbar-none">
                
                <!-- Tab 1: Mô Tả & Công Dụng -->
                <button type="button" 
                        id="tab-btn-features"
                        @@click="activeTab = 'features'" 
