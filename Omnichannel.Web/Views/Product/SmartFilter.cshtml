                    <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-magenta-accent transition-all duration-500 -z-1"
                         :style="'width: ' + ((finderStep - 1) / 2 * 100) + '%'"></div>

                    <button type="button" @@click="goToFinderStep(1)" class="flex flex-col items-center group focus:outline-none">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md"
                             :class="finderStep === 1 ? 'bg-magenta-accent text-white ring-4 ring-pink-100 scale-110' : (finderStep > 1 ? 'bg-emerald-500 text-white' : 'bg-white text-slate-400 border border-slate-300')">
                            <span x-text="finderStep > 1 ? '✓' : '1'"></span>
                        </div>
                        <span class="text-[11px] font-semibold mt-1.5" :class="finderStep === 1 ? 'text-magenta-accent' : 'text-slate-500'">Loại Da</span>
                    </button>

                    <button type="button" @@click="goToFinderStep(2)" class="flex flex-col items-center group focus:outline-none">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md"
                             :class="finderStep === 2 ? 'bg-magenta-accent text-white ring-4 ring-pink-100 scale-110' : (finderStep > 2 ? 'bg-emerald-500 text-white' : 'bg-white text-slate-400 border border-slate-300')">
                            <span x-text="finderStep > 2 ? '✓' : '2'"></span>
                        </div>
                        <span class="text-[11px] font-semibold mt-1.5" :class="finderStep === 2 ? 'text-magenta-accent' : 'text-slate-500'">Mối Quan Tâm</span>
                    </button>

                    <button type="button" @@click="goToFinderStep(3)" class="flex flex-col items-center group focus:outline-none">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs transition-all shadow-md"
                             :class="finderStep === 3 ? 'bg-magenta-accent text-white ring-4 ring-pink-100 scale-110' : 'bg-white text-slate-400 border border-slate-300'">
                            <span>3</span>
                        </div>
                        <span class="text-[11px] font-semibold mt-1.5" :class="finderStep === 3 ? 'text-magenta-accent' : 'text-slate-500'">Ngân Sách</span>
                    </button>
                </div>
            </div>

            <!-- CONTAINER FINDER -->
            <div class="bg-white rounded-3xl shadow-xl border border-soft-border/70 p-6 sm:p-10 transition-all">
                
                <!-- BƯỚC 1 -->
                <div x-show="finderStep === 1" class="space-y-6 routine-fade-enter">
                    <div class="text-center max-w-xl mx-auto mb-6">
                        <h2 class="text-xl font-bold text-charcoal font-serif">Chọn loại da cần tìm sản phẩm</h2>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 max-w-4xl mx-auto">
                        <template x-for="st in availableSkinTypes" :key="st.key">
                            <div @@click="finderSkinType = st.key"
                                 :class="finderSkinType === st.key ? 'border-magenta-accent bg-pastel-rose text-magenta-accent font-bold ring-2 ring-magenta-accent/20' : 'border-slate-200 text-slate-600 hover:bg-slate-50'"
                                 class="p-4 rounded-2xl border-2 text-center text-xs cursor-pointer transition">
                                <i :class="st.icon" class="text-lg block mb-2"></i>
                                <span x-text="st.name"></span>
                            </div>
                        </template>
                    </div>
                    <div class="pt-6 border-t border-slate-100 flex justify-end">
                        <button type="button" @@click="goToFinderStep(2)" :disabled="!finderSkinType" class="px-7 py-2.5 rounded-xl bg-magenta-accent text-white font-bold text-xs">
                            Tiếp tục
                        </button>
                    </div>
                </div>

                <!-- BƯỚC 2 -->
                <div x-show="finderStep === 2" class="space-y-6 routine-fade-enter">
                    <div class="text-center max-w-xl mx-auto mb-6">
                        <h2 class="text-xl font-bold text-charcoal font-serif">Chọn một hoặc nhiều mối quan tâm</h2>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-3xl mx-auto">
                        <template x-for="c in availableConcerns" :key="c.key">
                            <div @@click="toggleFinderConcern(c.key)"
                                 :class="finderConcerns.includes(c.key) ? 'border-magenta-accent bg-pastel-rose text-magenta-accent font-bold ring-2 ring-magenta-accent/20' : 'border-slate-200 text-slate-600 hover:bg-slate-50'"
                                 class="p-4 rounded-2xl border-2 text-center text-xs cursor-pointer transition">
                                <i :class="c.icon" class="text-lg block mb-1.5"></i>
                                <span x-text="c.name"></span>
                            </div>
                        </template>
                    </div>
                    <div class="pt-6 border-t border-slate-100 flex justify-between">
                        <button type="button" @@click="goToFinderStep(1)" class="px-5 py-2 rounded-xl border border-slate-200 text-xs">Quay lại</button>
                        <button type="button" @@click="goToFinderStep(3)" :disabled="finderConcerns.length === 0" class="px-7 py-2.5 rounded-xl bg-magenta-accent text-white font-bold text-xs">Tiếp tục</button>
                    </div>
                </div>

                <!-- BƯỚC 3 -->
                <div x-show="finderStep === 3" class="space-y-6 routine-fade-enter">
                    <div class="text-center max-w-xl mx-auto mb-6">
                        <h2 class="text-xl font-bold text-charcoal font-serif">Khoảng ngân sách cho một sản phẩm</h2>
                    </div>
                    <div class="max-w-md mx-auto bg-pastel-rose/40 rounded-3xl p-6 text-center space-y-3 border border-pink-200">
                        <div class="text-2xl font-black font-mono text-magenta-accent" x-text="formatCurrency(finderBudget)"></div>
                        <input type="range" min="150000" max="3000000" step="50000" x-model.number="finderBudget" class="beauty-slider" />
                        <div class="flex justify-between text-[11px] text-slate-400 font-mono">
                            <span>150K</span>
                            <span>1.5M</span>
                            <span>3M+</span>
                        </div>
                    </div>
                    <div class="pt-6 border-t border-slate-100 flex justify-between">
                        <button type="button" @@click="goToFinderStep(2)" class="px-5 py-2 rounded-xl border border-slate-200 text-xs">Quay lại</button>
                        <button type="button" @@click="executeFinderFilter()" class="px-8 py-3 rounded-2xl bg-magenta-accent text-white font-bold text-xs shadow-md">
                            Tìm Kiếm Ngay
                        </button>
                    </div>
                </div>

                <!-- BƯỚC 4: KẾT QUẢ FINDER -->
                <div x-show="finderStep === 4" class="space-y-6 routine-fade-enter">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <h3 class="font-bold text-base text-charcoal" x-text="finderResults.length + ' Sản phẩm phù hợp nhất'"></h3>
                        <button type="button" @@click="goToFinderStep(1)" class="text-xs text-magenta-accent font-bold hover:underline">
                            Thiết lập lại bộ lọc
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                        <template x-for="p in finderResults" :key="p.id">
                            <div class="rounded-2xl border border-slate-200 p-3 bg-white hover:shadow-md transition flex flex-col justify-between">
                                <div>
                                    <div class="h-44 rounded-xl overflow-hidden bg-slate-50 mb-2">
                                        <img :src="p.thumbnailUrl" :alt="p.name" class="w-full h-full object-cover" onerror="this.src='/images/default-product.png'">
                                    </div>
                                    <div class="text-[10px] text-slate-400 font-bold uppercase" x-text="p.categoryName"></div>
                                    <a :href="'/Product/Detail/' + p.id" class="text-xs font-bold text-charcoal hover:text-magenta-accent line-clamp-2 mt-0.5" x-text="p.name"></a>
                                </div>
                                <div class="pt-3 border-t border-slate-100 mt-2 flex items-center justify-between">
                                    <span class="text-xs font-bold text-magenta-accent font-mono" x-text="formatCurrency(p.price)"></span>
                                    <button type="button" @@click="addSingleProductToCart(p.id)" class="px-3 py-1.5 rounded-lg bg-magenta-accent text-white text-[11px] font-bold">
                                        Chọn Mua
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    function personalizedRoutineApp() {
        return {
            activeMode: 'routine', // 'routine' | 'finder'
            
            // Routine Builder State
            routineSkinType: 'da-dau',
            routineConcern: 'acne_pore',
            routineBudgetTier: 'standard', // economy | standard | luxury
            isGeneratingRoutine: false,
            hasRoutineResult: false,
            routineResult: null,
            isAddingToCart: false,

            // Quick Finder State
            finderStep: 1,
            finderSkinType: 'da-dau',
            finderConcerns: ['acne', 'hydration'],
            finderBudget: 800000,
            finderResults: [],

            availableSkinTypes: [
                { key: 'da-dau', name: 'Da Dầu', icon: 'fa-solid fa-droplet' },
                { key: 'da-kho', name: 'Da Khô', icon: 'fa-solid fa-snowflake' },
                { key: 'da-hon-hop', name: 'Da Hỗn Hợp', icon: 'fa-solid fa-scale-balanced' },
                { key: 'da-nhay-cam', name: 'Da Nhạy Cảm', icon: 'fa-solid fa-shield-heart' },
                { key: 'da-thuong', name: 'Da Thường', icon: 'fa-solid fa-certificate' }
            ],

            availableConcerns: [
                { key: 'acne', name: 'Trị Mụn & Kháng Viêm', icon: 'fa-solid fa-shield-virus' },
                { key: 'hydration', name: 'Dưỡng Ẩm Đa Tầng', icon: 'fa-solid fa-water' },
                { key: 'brightening', name: 'Làm Sáng & Mờ Thâm', icon: 'fa-solid fa-wand-magic-sparkles' },
                { key: 'anti_aging', name: 'Chống Lão Hóa', icon: 'fa-solid fa-clock-rotate-left' },
                { key: 'pore_minimizing', name: 'Se Khít Lỗ Chân Lông', icon: 'fa-solid fa-circle-dot' },
                { key: 'sun_protection', name: 'Chống Nắng Phổ Rộng', icon: 'fa-solid fa-sun' }
            ],

            init() {
                // Kiểm tra xem có Routine đã lưu trong localStorage không
                const saved = localStorage.getItem('omni_saved_routine');
                if (saved) {
                    try {
                        const parsed = JSON.parse(saved);
                        if (parsed && parsed.skinType) {
                            this.routineSkinType = parsed.skinType;
                            this.routineConcern = parsed.concern || 'acne_pore';
                            this.routineBudgetTier = parsed.budgetTier || 'standard';
                        }
                    } catch (e) { }
                }
            },

            // --- ROUTINE ACTIONS ---
            async generateRoutine() {
                this.isGeneratingRoutine = true;
                const startTime = Date.now();

                try {
                    const res = await fetch('/Product/BuildRoutine', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            skinType: this.routineSkinType,
                            concern: this.routineConcern,
                            budgetTier: this.routineBudgetTier
                        })
                    });

                    const data = await res.json();

                    // Delay giả lập AI tính toán tinh tế tối thiểu 700ms
                    const elapsed = Date.now() - startTime;
                    if (elapsed < 700) {
                        await new Promise(r => setTimeout(r, 700 - elapsed));
                    }

                    if (data && data.success) {
                        this.routineResult = data;
                        this.hasRoutineResult = true;
                        window.scrollTo({ top: 180, behavior: 'smooth' });
                    }
                } catch (e) {
                    console.error('Lỗi khi thiết kế Routine:', e);
                    Swal.fire({
                        icon: 'error',
                        title: 'Không thể tạo Routine',
                        text: 'Vui lòng kiểm tra lại kết nối và thử lại.'
                    });
                } finally {
                    this.isGeneratingRoutine = false;
                }
            },

            resetRoutineBuilder() {
                this.hasRoutineResult = false;
                this.routineResult = null;
                window.scrollTo({ top: 120, behavior: 'smooth' });
            },

            // LƯU ROUTINE VÀO HỒ SƠ CÁ NHÂN
            async saveRoutineToProfile() {
                if (!this.routineResult) return;

                const routineData = {
                    routineName: `Routine ${this.routineResult.skinTypeName} - ${this.routineResult.budgetTierName}`,
                    skinType: this.routineSkinType,
                    concern: this.routineConcern,
                    budgetTier: this.routineBudgetTier,
                    savedAt: new Date().toISOString(),
                    products: this.routineResult.distinctProducts.map(p => ({
                        id: p.id,
                        name: p.name,
                        price: p.price,
                        category: p.categoryName
                    }))
                };

                // 1. Lưu vào LocalStorage
                localStorage.setItem('omni_saved_routine', JSON.stringify(routineData));

                // 2. Gửi request tới backend lưu vào profile
                try {
                    await fetch('/Product/SaveRoutineToProfile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            routineName: routineData.routineName,
                            skinType: this.routineSkinType,
                            concern: this.routineConcern,
                            budgetTier: this.routineBudgetTier,
                            productIds: this.routineResult.distinctProducts.map(p => p.id)
                        })
                    });
                } catch (e) { }

                Swal.fire({
                    icon: 'success',
                    title: 'Đã Lưu Routine Vào Hồ Sơ Cá Nhân!',
                    html: `
                        <p class="text-xs text-slate-600 mb-2">Phác đồ chăm sóc <strong>${this.routineResult.skinTypeName}</strong> đã được lưu thành công vào hồ sơ sắc đẹp của bạn.</p>
                        <div class="p-3 bg-pink-50 rounded-xl text-left text-xs text-charcoal border border-pink-200">
                            <div>• Gói lựa chọn: <strong>${this.routineResult.budgetTierName}</strong></div>
                            <div>• Số bước: <strong>3 bước sáng + 4 bước tối</strong></div>
                            <div>• Ưu đãi Combo: <strong>Giảm 10% khi đặt mua trọn bộ</strong></div>
                        </div>
                    `,
                    confirmButtonColor: '#d63384',
                    confirmButtonText: 'Tuyệt vời!'
                });
            },

            // ĐẶT MUA TOÀN BỘ ROUTINE TIẾT KIỆM THÊM 10%
            async addFullRoutineToCart() {
                if (!this.routineResult || !this.routineResult.distinctProducts || this.routineResult.distinctProducts.length === 0) return;

                this.isAddingToCart = true;
                const productIds = this.routineResult.distinctProducts.map(p => p.id);

                try {
                    const res = await fetch('/Product/AddRoutineToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            productIds: productIds,
                            discountPercent: 10
                        })
                    });

                    const data = await res.json();

                    if (data && data.success) {
                        // Kích hoạt cập nhật MiniCart header
                        document.body.dispatchEvent(new CustomEvent('reloadMiniCart'));

                        Swal.fire({
                            icon: 'success',
                            title: 'Đã Thêm Trọn Bộ Routine Vào Giỏ Hàng!',
                            html: `
                                <div class="text-xs text-slate-600 space-y-2 mb-3">
                                    <p>Đã thêm toàn bộ <strong>${data.addedCount} sản phẩm</strong> của chu trình Sáng & Tối vào giỏ hàng.</p>
                                    <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-800 text-left">
                                        <div class="flex justify-between">
                                            <span>Tiết kiệm ưu đãi Combo 10%:</span>
                                            <strong class="font-mono text-magenta-accent">-${this.formatCurrency(this.routineResult.discountComboAmount)}</strong>
                                        </div>
                                        <div class="flex justify-between mt-1 text-charcoal font-bold">
                                            <span>Tổng thanh toán Combo:</span>
                                            <span class="font-mono text-magenta-accent text-sm">${this.formatCurrency(this.routineResult.comboFinalPrice)}</span>
                                        </div>
                                    </div>
                                </div>
                            `,
                            showCancelButton: true,
                            confirmButtonColor: '#d63384',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: '<i class="fa-solid fa-credit-card mr-1"></i> Đến Trang Thanh Toán',
                            cancelButtonText: 'Tiếp tục xem'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/Cart';
                            }
                        });
                    }
                } catch (e) {
                    console.error('Lỗi khi thêm Combo vào giỏ:', e);
                    Swal.fire({
                        icon: 'error',
                        title: 'Không thể thêm vào giỏ',
                        text: 'Vui lòng thử lại sau.'
                    });
                } finally {
                    this.isAddingToCart = false;
                }
            },

            // --- QUICK FINDER ACTIONS ---
            goToFinderStep(step) {
                this.finderStep = step;
            },

            toggleFinderConcern(cKey) {
                const idx = this.finderConcerns.indexOf(cKey);
                if (idx > -1) this.finderConcerns.splice(idx, 1);
                else this.finderConcerns.push(cKey);
            },

            async executeFinderFilter() {
                try {
                    const url = `/api/products/smart-filter?skinType=${encodeURIComponent(this.finderSkinType)}&concerns=${encodeURIComponent(this.finderConcerns.join(','))}&budget=${this.finderBudget}`;
                    const res = await fetch(url);
                    const data = await res.json();
                    if (data && data.success) {
                        this.finderResults = data.products || [];
                        this.finderStep = 4;
                    }
                } catch (e) { }
            },

            async addSingleProductToCart(pId) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const res = await fetch('/Cart/AddToCart', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token || ''
                        },
                        body: `productId=${pId}&quantity=1`
                    });
                    if (res.ok) {
                        document.body.dispatchEvent(new CustomEvent('reloadMiniCart'));
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Đã thêm sản phẩm vào giỏ!',
                            showConfirmButton: false,
                            timer: 2000
                        });
                    }
                } catch (e) {
                    window.location.href = `/Product/Detail/${pId}`;
                }
            },

            formatCurrency(val) {
                if (!val) return '0 ₫';
                return new Intl.NumberFormat('vi-VN').format(val) + ' ₫';
            }
        };
    }
</script>
