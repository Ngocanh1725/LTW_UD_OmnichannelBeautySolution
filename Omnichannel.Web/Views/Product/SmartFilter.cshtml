@{
    Layout = "_Layout";
    ViewData["Title"] = "Tạo Routine Chăm Sóc Da Riêng Bạn & AI Beauty Advisor";
    ViewData["Description"] = "Hệ thống chuyên gia da liễu thiết kế chu trình Skincare sáng - tối riêng biệt phù hợp theo loại da, vấn đề da và phân khúc ngân sách (Tiết Kiệm, Tiêu Chuẩn, Thượng Lưu).";
}

<style>
    /* Wizard transitions */
    .routine-fade-enter {
        animation: fadeInRoutine 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @@keyframes fadeInRoutine {
        from {
            opacity: 0;
            transform: translateY(12px) scale(0.99);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Custom range slider */
    .beauty-slider {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 8px;
        background: #fdf2f4;
        border-radius: 9999px;
        outline: none;
        border: 1px solid #f1d8dd;
    }
    .beauty-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #d63384;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(214, 51, 132, 0.35);
        border: 2px solid #ffffff;
        transition: transform 0.15s ease;
    }
    .beauty-slider::-webkit-slider-thumb:hover {
        transform: scale(1.15);
    }
</style>

<div x-data="personalizedRoutineApp()" x-init="init()" class="py-10 bg-[#fffdfd] min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header Hero Section -->
        <div class="text-center max-w-3xl mx-auto mb-8">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pastel-rose text-magenta-accent text-xs font-bold uppercase tracking-wider mb-3 shadow-xs">
                <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
                <span>Dermatology Algorithm 4.0</span>
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-charcoal mb-3 tracking-tight">
                Tạo Routine Chăm Sóc Da Riêng Bạn
            </h1>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                Được cá nhân hóa dựa trên Loại da, Vấn đề cần điều trị và Phân khúc ngân sách của bạn với 2 chu trình Sáng - Tối chuẩn y khoa.
            </p>

            <!-- Mode Switcher Pill Tabs -->
            <div class="inline-flex p-1.5 bg-slate-100/80 rounded-2xl border border-slate-200 mt-6 shadow-xs">
                <button type="button" 
                        @@click="activeMode = 'routine'" 
                        :class="activeMode === 'routine' ? 'bg-white text-magenta-accent shadow-sm font-bold' : 'text-slate-600 hover:text-charcoal font-medium'"
                        class="px-5 py-2 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Thiết Kế Routine Cá Nhân Hóa</span>
                </button>

                <button type="button" 
                        @@click="activeMode = 'finder'" 
                        :class="activeMode === 'finder' ? 'bg-white text-magenta-accent shadow-sm font-bold' : 'text-slate-600 hover:text-charcoal font-medium'"
                        class="px-5 py-2 rounded-xl text-xs sm:text-sm flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Bộ Lọc Sản Phẩm Nhanh AI</span>
                </button>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- MODE 1: THIẾT KẾ ROUTINE CHĂM SÓC DA RIÊNG BẠN (HERO MODE) -->
        <!-- ========================================================================= -->
        <div x-show="activeMode === 'routine'" class="space-y-8">
            
            <!-- BUILDER INPUT CARD (Ẩn khi đang hiển thị kết quả routine) -->
            <div x-show="!hasRoutineResult && !isGeneratingRoutine" class="bg-white rounded-3xl shadow-xl border border-soft-border/70 p-6 sm:p-10 transition-all">
                
                <!-- Section 1: Chọn Loại Da -->
                <div class="mb-10">
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class="w-7 h-7 rounded-xl bg-pastel-rose text-magenta-accent flex items-center justify-center font-bold text-xs">1</span>
                        <h2 class="text-xl font-bold text-charcoal font-serif">Bước 1: Chọn Loại Da Của Bạn</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500 mb-5 ml-9.5">
                        Mỗi loại da đòi hỏi kết cấu và cơ chế cân bằng ẩm khác nhau.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
                        <!-- Da Dầu -->
                        <div @@click="routineSkinType = 'da-dau'"
                             :class="routineSkinType === 'da-dau' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-4 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-2">
                                <span class="h-10 w-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-base">
                                    <i class="fa-solid fa-droplet text-amber-500"></i>
                                </span>
                                <div class="h-4 w-4 rounded-full border-2 flex items-center justify-center"
                                     :class="routineSkinType === 'da-dau' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineSkinType === 'da-dau'" class="fa-solid fa-check text-[9px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-xs text-charcoal mb-0.5">Da Dầu (Oily)</h3>
                                <p class="text-[11px] text-slate-500 leading-tight">Đổ dầu bóng nhờn toàn mặt, lỗ chân lông to.</p>
                            </div>
                        </div>

                        <!-- Da Khô -->
                        <div @@click="routineSkinType = 'da-kho'"
                             :class="routineSkinType === 'da-kho' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-4 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-2">
                                <span class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-base">
                                    <i class="fa-solid fa-snowflake text-blue-500"></i>
                                </span>
                                <div class="h-4 w-4 rounded-full border-2 flex items-center justify-center"
                                     :class="routineSkinType === 'da-kho' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineSkinType === 'da-kho'" class="fa-solid fa-check text-[9px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-xs text-charcoal mb-0.5">Da Khô (Dry)</h3>
                                <p class="text-[11px] text-slate-500 leading-tight">Thiếu ẩm, thô ráp, căng rát sau khi rửa mặt.</p>
                            </div>
                        </div>

                        <!-- Da Hỗn Hợp -->
                        <div @@click="routineSkinType = 'da-hon-hop'"
                             :class="routineSkinType === 'da-hon-hop' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-4 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-2">
                                <span class="h-10 w-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-base">
                                    <i class="fa-solid fa-scale-balanced text-purple-500"></i>
                                </span>
                                <div class="h-4 w-4 rounded-full border-2 flex items-center justify-center"
                                     :class="routineSkinType === 'da-hon-hop' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineSkinType === 'da-hon-hop'" class="fa-solid fa-check text-[9px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-xs text-charcoal mb-0.5">Da Hỗn Hợp</h3>
                                <p class="text-[11px] text-slate-500 leading-tight">Đổ dầu vùng chữ T, 2 má khô hoặc bình thường.</p>
                            </div>
                        </div>

                        <!-- Da Nhạy Cảm -->
                        <div @@click="routineSkinType = 'da-nhay-cam'"
                             :class="routineSkinType === 'da-nhay-cam' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-4 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-2">
                                <span class="h-10 w-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-base">
                                    <i class="fa-solid fa-shield-heart text-rose-500"></i>
                                </span>
                                <div class="h-4 w-4 rounded-full border-2 flex items-center justify-center"
                                     :class="routineSkinType === 'da-nhay-cam' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineSkinType === 'da-nhay-cam'" class="fa-solid fa-check text-[9px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-xs text-charcoal mb-0.5">Da Nhạy Cảm</h3>
                                <p class="text-[11px] text-slate-500 leading-tight">Mỏng manh, dễ đỏ rát ngứa ngáy khi thời tiết đổi.</p>
                            </div>
                        </div>

                        <!-- Da Thường -->
                        <div @@click="routineSkinType = 'da-thuong'"
                             :class="routineSkinType === 'da-thuong' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-4 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-2">
                                <span class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-base">
                                    <i class="fa-solid fa-certificate text-emerald-500"></i>
                                </span>
                                <div class="h-4 w-4 rounded-full border-2 flex items-center justify-center"
                                     :class="routineSkinType === 'da-thuong' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineSkinType === 'da-thuong'" class="fa-solid fa-check text-[9px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-xs text-charcoal mb-0.5">Da Thường</h3>
                                <p class="text-[11px] text-slate-500 leading-tight">Cân bằng hoàn hảo giữa độ dầu và độ ẩm.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Chọn Vấn Đề Da Ưu Tiên -->
                <div class="mb-10">
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class="w-7 h-7 rounded-xl bg-pastel-rose text-magenta-accent flex items-center justify-center font-bold text-xs">2</span>
                        <h2 class="text-xl font-bold text-charcoal font-serif">Bước 2: Vấn Đề Da Bạn Muốn Cải Thiện Nhất?</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500 mb-5 ml-9.5">
                        Xác định hoạt chất đặc trị vàng trong bước Serum ban đêm.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- Mụn & Lỗ chân lông -->
                        <div @@click="routineConcern = 'acne_pore'"
                             :class="routineConcern === 'acne_pore' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-5 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-3">
                                <span class="h-11 w-11 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-shield-virus"></i>
                                </span>
                                <div class="h-5 w-5 rounded-full border-2 flex items-center justify-center"
                                     :class="routineConcern === 'acne_pore' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineConcern === 'acne_pore'" class="fa-solid fa-check text-[10px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm text-charcoal mb-1">Mụn & Lỗ Chân Lông</h3>
                                <p class="text-xs text-slate-500">Mụn viêm, mụn ẩn, bã nhờn tích tụ, lỗ chân lông to thô ráp.</p>
                                <div class="mt-2 text-[10px] text-magenta-accent font-semibold">Hoạt chất: BHA, Niacinamide, Tràm trà</div>
                            </div>
                        </div>

                        <!-- Sạm Nám & Thâm Mụn -->
                        <div @@click="routineConcern = 'pigmentation'"
                             :class="routineConcern === 'pigmentation' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-5 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-3">
                                <span class="h-11 w-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </span>
                                <div class="h-5 w-5 rounded-full border-2 flex items-center justify-center"
                                     :class="routineConcern === 'pigmentation' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineConcern === 'pigmentation'" class="fa-solid fa-check text-[10px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm text-charcoal mb-1">Sạm Nám & Tàn Nhang</h3>
                                <p class="text-xs text-slate-500">Đốm nâu, sạm nắng, thâm mụn kéo dài, da xỉn màu thiếu sức sống.</p>
                                <div class="mt-2 text-[10px] text-magenta-accent font-semibold">Hoạt chất: Vitamin C, Alpha Arbutin</div>
                            </div>
                        </div>

                        <!-- Lão Hóa & Nếp Nhăn -->
                        <div @@click="routineConcern = 'aging'"
                             :class="routineConcern === 'aging' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-5 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-3">
                                <span class="h-11 w-11 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </span>
                                <div class="h-5 w-5 rounded-full border-2 flex items-center justify-center"
                                     :class="routineConcern === 'aging' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineConcern === 'aging'" class="fa-solid fa-check text-[10px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm text-charcoal mb-1">Lão Hóa Sớm & Nếp Nhăn</h3>
                                <p class="text-xs text-slate-500">Vết chân chim, rãnh cười sâu, da chùng nhão suy giảm đàn hồi.</p>
                                <div class="mt-2 text-[10px] text-magenta-accent font-semibold">Hoạt chất: Retinol, Peptide, Men vi sinh</div>
                            </div>
                        </div>

                        <!-- Phục Hồi & Nhạy Cảm -->
                        <div @@click="routineConcern = 'recovery'"
                             :class="routineConcern === 'recovery' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-md' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-2xl border-2 p-5 transition-all duration-200 flex flex-col justify-between group">
                            <div class="flex items-start justify-between mb-3">
                                <span class="h-11 w-11 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg">
                                    <i class="fa-solid fa-heart-pulse"></i>
                                </span>
                                <div class="h-5 w-5 rounded-full border-2 flex items-center justify-center"
                                     :class="routineConcern === 'recovery' ? 'border-magenta-accent bg-magenta-accent text-white' : 'border-slate-300'">
                                    <i x-show="routineConcern === 'recovery'" class="fa-solid fa-check text-[10px]"></i>
                                </div>
                            </div>
                            <div>
                                <h3 class="font-bold text-sm text-charcoal mb-1">Phục Hồi Màng Ẩm Yếu</h3>
                                <p class="text-xs text-slate-500">Da nhiễm corticoid, tổn thương sau peel/laser, kích ứng mẩn đỏ.</p>
                                <div class="mt-2 text-[10px] text-magenta-accent font-semibold">Hoạt chất: Panthenol B5, HA, Ceramide</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Chọn Phân Khúc Ngân Sách -->
                <div class="mb-10">
                    <div class="flex items-center gap-2.5 mb-2">
                        <span class="w-7 h-7 rounded-xl bg-pastel-rose text-magenta-accent flex items-center justify-center font-bold text-xs">3</span>
                        <h2 class="text-xl font-bold text-charcoal font-serif">Bước 3: Ngân Sách Mong Muốn Của Bạn?</h2>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-500 mb-5 ml-9.5">
                        Chúng mình chọn lọc các thương hiệu danh tiếng nhất trong phân khúc phù hợp.
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        
                        <!-- GÓI TIẾT KIỆM -->
                        <div @@click="routineBudgetTier = 'economy'"
                             :class="routineBudgetTier === 'economy' ? 'border-emerald-500 bg-emerald-50/50 ring-2 ring-emerald-500/30 shadow-lg scale-[1.02]' : 'border-slate-200 hover:border-emerald-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-3xl border-2 p-6 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
                            
                            <div class="flex items-start justify-between mb-4">
                                <div>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-bold">
                                        <i class="fa-solid fa-seedling"></i>
                                        <span>Gói Tiết Kiệm</span>
                                    </span>
                                    <div class="text-xl font-black text-charcoal mt-2 font-mono">Dưới 1.000.000 ₫</div>
                                    <div class="text-xs text-slate-500 mt-0.5">Hiệu năng cao - Bảng thành phần tối giản</div>
                                </div>
                                <div class="h-6 w-6 rounded-full border-2 flex items-center justify-center transition-colors"
                                     :class="routineBudgetTier === 'economy' ? 'border-emerald-500 bg-emerald-500 text-white' : 'border-slate-300'">
                                    <i x-show="routineBudgetTier === 'economy'" class="fa-solid fa-check text-xs"></i>
                                </div>
                            </div>

                            <div class="space-y-2 border-t border-slate-200/80 pt-4 text-xs text-slate-600">
                                <div class="flex items-center gap-2 font-medium text-slate-700">
                                    <i class="fa-solid fa-star text-emerald-500 text-[11px]"></i>
                                    <span>Thương hiệu tiêu biểu:</span>
                                </div>
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-[11px] text-slate-700">CeraVe</span>
                                    <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-[11px] text-slate-700">The Ordinary</span>
                                    <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-[11px] text-slate-700">Klairs</span>
                                    <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-[11px] text-slate-700">Torriden</span>
                                </div>
                                <p class="text-[11px] text-slate-500 pt-1 leading-relaxed">
                                    Tối ưu hóa chi phí học sinh - sinh viên & văn phòng, công thức tập trung hoạt chất vàng không phụ phí thương hiệu.
                                </p>
                            </div>
                        </div>

                        <!-- GÓI TIÊU CHUẨN (RECOMMENDED) -->
                        <div @@click="routineBudgetTier = 'standard'"
                             :class="routineBudgetTier === 'standard' ? 'border-magenta-accent bg-pastel-rose/80 ring-2 ring-magenta-accent/30 shadow-lg scale-[1.02]' : 'border-slate-200 hover:border-pink-300 hover:bg-slate-50/60'"
                             class="cursor-pointer rounded-3xl border-2 p-6 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
                            
                            <div class="absolute top-0 right-0 bg-magenta-accent text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-bl-xl shadow-xs">
                                Được Chọn Nhiều Nhất
                            </div>

                            <div class="flex items-start justify-between mb-4">
                                <div>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100 text-magenta-accent text-[11px] font-bold">
                                        <i class="fa-solid fa-gem"></i>
