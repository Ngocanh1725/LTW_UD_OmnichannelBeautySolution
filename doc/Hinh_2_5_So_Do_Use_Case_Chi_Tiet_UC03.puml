@startuml Hinh2_5_So_Do_Use_Case_Chi_Tiet_UC03
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam shadowing false
skinparam ArrowColor #1B4F72
skinparam ArrowThickness 1.2
skinparam ActorBorderColor #1B4F72
skinparam ActorBackgroundColor #EBF5FB
skinparam packageStyle rectangle

skinparam usecaseBackgroundColor #F4F6F7
skinparam usecaseBorderColor #2C3E50
skinparam usecaseFontSize 11
skinparam usecaseBorderThickness 1

' ========================================================
' ĐỊNH NGHĨA CÁC TÁC NHÂN (CHÍNH, QUẢN LÝ & THIẾT BỊ)
' ========================================================
actor "Thu ngân điểm bán lẻ\n(Cashier)" as Cashier
actor "Quản lý chi nhánh\n(StoreManager)" as StoreManager

actor "Máy in nhiệt hóa đơn K80\n(Receipt Printer)" as Printer <<Device>>
actor "Sổ cái Kế toán & CSDL\n(SQL Server: PosShifts & Ledgers)" as DBService <<System>>

' ========================================================
' KHUNG RANH GIỚI CA SỬ DỤNG CHI TIẾT UC-03
' ========================================================
rectangle "PHÂN HỆ QUẢN LÝ CA BÁN HÀNG POS & ĐỐI SOÁT KÉT TIỀN MẶT" {

    usecase "UC-03: Vòng đời ca làm việc thu ngân & Kiểm toán két tiền\n(POS Shift Lifecycle & Blind Cash Drawer Audit)" as UC03 #EBF5FB
    
    ' --- GIAI ĐOẠN 1: MỞ CA LÀM VIỆC ---
    package "1. GIAI ĐOẠN MỞ CA (OPENING SHIFT)" #FEF9E7 {
        usecase "UC-03.1: Khai báo số dư tiền mặt đầu ca\n(OpeningBalance: Tiền lẻ thối có sẵn trong két)" as UC03_1 #FDEBD0
        usecase "UC-03.2: Khởi tạo bản ghi ca bán hàng mới\n(Mã ca SHIFT-yyyyMMdd-XXX, Status = OPEN)" as UC03_2 #FAD7A0
    }
    
    ' --- GIAI ĐOẠN 2: TRONG CA LÀM VIỆC ---
    package "2. GIAI ĐOẠN TRONG CA (ACTIVE SHIFT)" #E8F8F5 {
        usecase "UC-03.3: Quét mã EAN-13 & Thanh toán quầy\n(Tiền mặt / VietQR / Quẹt thẻ máy POS)" as UC03_3 #D1F2EB
        usecase "UC-03.4: Nộp thêm tiền mặt vào két giữa ca\n(Cash IN: Tiếp thêm tiền lẻ thối)" as UC03_4 #A3E4D7
        usecase "UC-03.5: Rút bớt tiền về két sắt an toàn\n(Cash OUT: Giảm thiểu rủi ro cất giữ tiền mặt)" as UC03_5 #76D7C4
    }
    
    ' --- GIAI ĐOẠN 3: ĐÓNG CA & ĐỐI SOÁT KÉT MÙ ---
    package "3. GIAI ĐOẠN ĐÓNG CA & KẾT SỔ (CLOSING & BLIND AUDIT)" #FDEDEC {
        usecase "UC-03.6: Kiểm đếm tiền mặt thực tế trong két\n(ActualCash: Kiểm đếm mù, ẩn số lý thuyết)" as UC03_6 #FADBD8
        usecase "UC-03.7: Tự động tính tiền lý thuyết & Chênh lệch\n(Difference = Actual - Expected)" as UC03_7 #F5B7B1
        usecase "UC-03.8: Giải trình chênh lệch & In biên bản Z-Report\n(Xác nhận bàn giao ca giữa hai nhân viên)" as UC03_8 #F1948A
        usecase "UC-03.9: Hạch toán doanh thu & Lệch két vào Sổ cái\n(Ghi nhận bút toán Nợ/Có FinancialLedgers)" as UC03_9 #E74C3C
    }
}

' ========================================================
' CÁC MỐI QUAN HỆ VÀ LIÊN KẾT CA SỬ DỤNG
' ========================================================

' Thu ngân vận hành toàn bộ ca
Cashier --> UC03
Cashier --> UC03_1
Cashier --> UC03_3
Cashier --> UC03_6

' Luồng quan hệ Mở ca
UC03 ..> UC03_1 : <<include>>
UC03_1 ..> UC03_2 : <<include>>

' Luồng giao dịch phát sinh trong ca
UC03 ..> UC03_3 : <<include>>
UC03 <.. UC03_4 : <<extend>>\n[Khi cần thêm tiền lẻ]
UC03 <.. UC03_5 : <<extend>>\n[Khi két vượt ngưỡng]

' Luồng Đóng ca & Kiểm toán két
UC03 ..> UC03_6 : <<include>>
UC03_6 ..> UC03_7 : <<include>>
UC03_7 ..> UC03_8 : <<include>>
UC03_8 ..> UC03_9 : <<include>>

' Tác nhân Quản lý phê duyệt chênh lệch & Ký biên bản
StoreManager --> UC03_8 : Phê duyệt biên bản & Lệch két

' In báo cáo Z-Report
UC03_8 --> Printer : Xuất lệnh in phiếu Z-Report K80

' Ghi nhận CSDL & Sổ cái
UC03_2 --> DBService : 1. Tạo PosShifts (OPEN)
UC03_4 --> DBService : 2. Ghi PosDrawerTransactions (IN)
UC03_5 --> DBService : 3. Ghi PosDrawerTransactions (OUT)
UC03_9 --> DBService : 4. Chốt PosShifts (CLOSED) & Ghi FinancialLedgers

@enduml
